@namespace Blazeo
@inherits BzComponentBase
@*
    The slider rail (the groove the Range fills). Mirrors the cascaded SliderContext's
    data-orientation / data-disabled; otherwise purely presentational. Marked data-bz-slider-track so
    ts/slider.ts can measure its rect to map a pointer position to a value.
*@

<BasePrimitive As="span" Attributes="@BuildAttributes()" ChildContent="@ChildContent" AsChild="@AsChild" />

@code {
    /// <summary>Inner content - typically a single <see cref="BaseSliderRange"/>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render onto your own element instead of a <c>&lt;span&gt;</c>.</summary>
    [Parameter] public RenderFragment<BzRenderProps>? AsChild { get; set; }

    [CascadingParameter] private SliderContext? Slider { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder()
            .Data("bz-slider-track", "")
            .Data("orientation", (Slider?.Orientation ?? Orientation.Horizontal).ToAttribute());

        if (Slider?.Disabled == true) props.Data("disabled", "");

        return props.Merge(Attributes, Class, Style);
    }
}
