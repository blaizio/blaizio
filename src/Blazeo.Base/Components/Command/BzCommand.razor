@namespace Blazeo
@inherits BzComponentBase
@*
    The command-palette root (the WAI-ARIA combobox + listbox filtering pattern). Renders the box and
    owns the search text and the filtering: it keeps a registry of the items + groups inside it and
    cascades a CommandContext telling each child whether it currently matches. Focus stays in the
    input - the highlighted option is virtual (aria-activedescendant), driven DOM-side by
    ts/command.js. Search is controllable via Search/DefaultSearch/SearchChanged (use @bind-Search).

    Items and groups stay MOUNTED while filtered out (they just get a `hidden` attribute), so their
    registrations survive a search that empties a whole group - unmounting them would drop them from
    the registry and the list could never come back. Set ShouldFilter="false" to own the visible set
    yourself (async / server search): the registry still tracks items but none are auto-hidden.
*@

<CascadingValue Value="@BuildContext()" IsFixed="false">
    <div @attributes="BuildAttributes()">
        @ChildContent
    </div>
</CascadingValue>

@code {
    /// <summary>Controlled search text. Bind with <c>@bind-Search</c>.</summary>
    [Parameter] public string? Search { get; set; }

    /// <summary>Initial search text when uncontrolled.</summary>
    [Parameter] public string DefaultSearch { get; set; } = "";

    /// <summary>Raised with the new search text on every keystroke. Enables <c>@bind-Search</c>.</summary>
    [Parameter] public EventCallback<string?> SearchChanged { get; set; }

    /// <summary>
    /// Whether typing filters the list. Defaults to <see langword="true"/>; set <see langword="false"/>
    /// to drive the visible items yourself (e.g. async / server search) - items are never auto-hidden.
    /// </summary>
    [Parameter] public bool ShouldFilter { get; set; } = true;

    /// <summary>
    /// Custom match: <c>(search, value, keywords) =&gt; matched</c>. Defaults to
    /// <see cref="CommandFilter.Matches"/> (substring or fuzzy subsequence).
    /// </summary>
    [Parameter] public Func<string, string, IReadOnlyList<string>?, bool>? Filter { get; set; }

    /// <summary>Accessible label applied to the input and listbox (use when there is no visible label).</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Arrow navigation wraps past the ends. Defaults to <see langword="false"/>.</summary>
    [Parameter] public bool Loop { get; set; }

    /// <summary>The input, list, groups, and items.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string _baseId = default!;
    private readonly ControllableState<string?> _search = new();
    private readonly Dictionary<string, CommandItemRegistration> _items = new(StringComparer.Ordinal);

    // Visibility memo, recomputed only when an item (un)registers (_version) or the search changes.
    private int _version;
    private int _computedVersion = -1;
    private string? _computedSearch;
    private bool _filtering;
    private readonly HashSet<string> _visibleItems = new(StringComparer.Ordinal);
    private readonly HashSet<string> _visibleGroups = new(StringComparer.Ordinal);
    private int _count;

    protected override void OnInitialized() => _baseId = Identifier.Create("command");

    protected override void OnParametersSet() =>
        _search.Sync(SearchChanged.HasDelegate, Search, DefaultSearch);

    private CommandContext BuildContext() => new(
        _search.Value ?? "",
        ShouldFilter && !string.IsNullOrWhiteSpace(_search.Value),
        Loop,
        Label,
        $"{_baseId}-list",
        $"{_baseId}-input",
        EventCallback.Factory.Create<string?>(this, SetSearchAsync),
        Register,
        Unregister,
        IsItemVisible,
        IsGroupVisible,
        ResultCount);

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder(this).Data("bz-command", "").Set("dir", DirAttribute).Merge(Attributes, Class, Style);

    private Task SetSearchAsync(string? value) => _search.SetAsync(value, SearchChanged);

    // Items register once (and on a Value/Keywords change) from OnParametersSet; re-render so the new
    // registration is reflected in the counts and group visibility.
    private void Register(CommandItemRegistration registration)
    {
        _items[registration.Id] = registration;
        _version++;
        InvokeAsync(StateHasChanged);
    }

    private void Unregister(string id)
    {
        if (_items.Remove(id))
        {
            _version++;
            InvokeAsync(StateHasChanged);
        }
    }

    private bool IsItemVisible(string id)
    {
        EnsureComputed();
        return _visibleItems.Contains(id);
    }

    // Not filtering: every group shows (and an item may not have registered yet on the first frame).
    // Filtering: only groups with at least one matching item.
    private bool IsGroupVisible(string id)
    {
        EnsureComputed();
        return !_filtering || _visibleGroups.Contains(id);
    }

    private int ResultCount()
    {
        EnsureComputed();
        return _count;
    }

    private void EnsureComputed()
    {
        var search = _search.Value ?? "";
        if (_computedVersion == _version && _computedSearch == search) return;
        _computedVersion = _version;
        _computedSearch = search;

        _visibleItems.Clear();
        _visibleGroups.Clear();
        _filtering = ShouldFilter && !string.IsNullOrWhiteSpace(search);

        if (!_filtering)
        {
            foreach (var (id, registration) in _items)
            {
                _visibleItems.Add(id);
                if (registration.GroupId is { } group) _visibleGroups.Add(group);
            }

            _count = _items.Count;
            return;
        }

        var match = Filter ?? CommandFilter.Matches;
        _count = 0;
        foreach (var (id, registration) in _items)
        {
            if (!match(search, registration.Value, registration.Keywords)) continue;
            _visibleItems.Add(id);
            _count++;
            if (registration.GroupId is { } group) _visibleGroups.Add(group);
        }
    }
}
