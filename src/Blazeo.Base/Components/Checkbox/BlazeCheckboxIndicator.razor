@namespace Blazeo
@inherits BlazeComponentBase
@*
    The tick/dash mark inside a BlazeCheckbox: a <span> that
    renders only while the checkbox is checked or indeterminate (the no-animation equivalent,
    rendered only while open/selected), mirroring the cascaded state via data-state ("checked"/"indeterminate")
    and data-disabled. pointer-events are disabled so clicks fall through to the checkbox button.
    The mark itself (a check / minus icon) is supplied by the styled layer as ChildContent.
*@

@if (_present)
{
    <BlazePrimitive As="span"
                    Attributes="@BuildAttributes()"
                    ChildContent="@ChildContent"
                    AsChild="@AsChild" />
}

@code {
    /// <summary>The checkbox state cascaded by the enclosing <see cref="BlazeCheckbox"/>.</summary>
    [CascadingParameter] private CheckboxContext? Checkbox { get; set; }

    /// <summary>The mark to display (typically an icon), shown when checked/indeterminate.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render onto your own element instead of a <c>&lt;span&gt;</c>.</summary>
    [Parameter] public RenderFragment<BlazeRenderProps>? AsChild { get; set; }

    private CheckedState State => Checkbox?.State ?? CheckedState.Unchecked;

    private bool _present => State is CheckedState.Checked or CheckedState.Indeterminate;

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder()
            .Data("state", State.ToAttribute())
            .Set("style", "pointer-events:none");

        if (Checkbox?.Disabled == true) props.Data("disabled", "");

        return props.Merge(Attributes, Class, Style);
    }
}
