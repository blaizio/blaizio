@namespace Blazeo
@inherits BlazeComponentBase
@*
    A two-state button (pressed / not-pressed). Ported from Radix Toggle:
      • renders a native <button type="button"> (so Space/Enter activation comes for free),
      • aria-pressed mirrors the state; data-state is "on"/"off" for the styled layer to target,
      • data-disabled is emitted when disabled,
      • clicking toggles the state unless disabled.
    Controllable via Pressed/DefaultPressed/PressedChanged, bridged by ControllableState — so it works
    with @bind-Pressed (controlled) or standalone with DefaultPressed (uncontrolled). Headless: no size
    or colour; the styled layer dresses data-[state=on].
*@

<BlazePrimitive As="button"
                Attributes="@BuildAttributes()"
                ChildContent="@ChildContent"
                AsChild="@AsChild" />

@code {
    /// <summary>Controlled pressed state. Leave <see langword="null"/> for uncontrolled (see <see cref="DefaultPressed"/>).</summary>
    [Parameter] public bool? Pressed { get; set; }

    /// <summary>Initial pressed state when uncontrolled. Defaults to <see langword="false"/>.</summary>
    [Parameter] public bool DefaultPressed { get; set; }

    /// <summary>Raised with the new state whenever it changes. Enables <c>@bind-Pressed</c>.</summary>
    [Parameter] public EventCallback<bool> PressedChanged { get; set; }

    /// <summary>Disables the toggle (blocks interaction; emits <c>data-disabled</c>).</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Toggle content (typically an icon).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the behaviour onto your own element instead of a <c>&lt;button&gt;</c>.</summary>
    [Parameter] public RenderFragment<BlazeRenderProps>? AsChild { get; set; }

    private readonly ControllableState<bool> _state = new();

    protected override void OnParametersSet() =>
        _state.Sync(Pressed.HasValue, Pressed ?? false, DefaultPressed);

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var pressed = _state.Value;
        var props = new PropBuilder(this)
            .Data("state", pressed ? "on" : "off")
            .Aria("pressed", pressed)
            .On("onclick", EventCallback.Factory.Create(this, OnClickAsync));

        if (AsChild is null)
        {
            // Native button: the `disabled` attribute already conveys + enforces the state.
            props.Set("type", "button").Flag("disabled", Disabled);
        }
        else if (Disabled)
        {
            // Arbitrary elements can't take `disabled`; convey it for AT instead.
            props.Aria("disabled", true);
        }

        if (Disabled) props.Data("disabled", "");

        return props.Merge(Attributes, Class, Style);
    }

    private Task OnClickAsync() =>
        Disabled ? Task.CompletedTask : _state.SetAsync(!_state.Value, PressedChanged);
}
