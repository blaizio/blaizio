@namespace Blazeo
@inherits BzComponentBase
@* A hairline divider between groups of options. Decorative - hidden from assistive tech. *@

<BzPrimitive As="div" Attributes="@BuildAttributes()" />

@code {
    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder(this)
            .Aria("hidden", true)
            .Merge(Attributes, Class, Style);
}
