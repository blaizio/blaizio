@namespace Blazeo
@inject IJSRuntime Js
@implements IAsyncDisposable
@*
    A value-picking listbox (the WAI-ARIA combobox/listbox pattern). Renders no element of its own: it
    owns the selected value and the open state and cascades SelectContext to BzSelectTrigger /
    BzSelectValue / BzSelectContent / the options. Controllable via Value/DefaultValue/ValueChanged
    (use @bind-Value) and Open/DefaultOpen/OpenChanged (use @bind-Open).

    Non-modal by design (the floating tier): the rest of the page stays interactive while open - no
    overlay, no scroll lock. Escape, an outside pointer-down, Tab, or picking an option dismisses it.
*@

<CascadingValue Value="@Context" IsFixed="false">
    @ChildContent
</CascadingValue>

@code {
    /// <summary>Controlled selected value. Leave <see langword="null"/> for uncontrolled; bind with <c>@bind-Value</c>.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Initial selected value when uncontrolled.</summary>
    [Parameter] public string? DefaultValue { get; set; }

    /// <summary>Raised with the new value when the selection changes. Enables <c>@bind-Value</c>.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Controlled open state. Use with <c>@bind-Open</c>.</summary>
    [Parameter] public bool? Open { get; set; }

    /// <summary>Initial open state when uncontrolled.</summary>
    [Parameter] public bool DefaultOpen { get; set; }

    /// <summary>Raised with the new open state. Enables <c>@bind-Open</c>.</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>The trigger and content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string _baseId = default!;
    private readonly ControllableState<string?> _value = new();
    private readonly ControllableState<bool> _open = new();
    private readonly Dictionary<string, RenderFragment> _items = [];
    private bool _preloaded;
    private IJSObjectReference? _menuModule;
    private IJSObjectReference? _triggerGuard;

    private SelectContext Context => new(
        _value.Value,
        _open.Value,
        $"{_baseId}-content",
        $"{_baseId}-trigger",
        _baseId,
        SelectedContent,
        EventCallback.Factory.Create(this, OpenAsync),
        EventCallback.Factory.Create(this, CloseAsync),
        EventCallback.Factory.Create<string>(this, SelectAsync),
        IsSelected,
        RegisterItem,
        UnregisterItem);

    private RenderFragment? SelectedContent =>
        _value.Value is { } value && _items.TryGetValue(value, out var fragment) ? fragment : null;

    protected override void OnInitialized() => _baseId = Identifier.Create("select");

    // @bind-Value (ValueChanged wired) means the consumer owns the value; a bare DefaultValue is
    // uncontrolled. Open follows the usual nullable-prop signal.
    protected override void OnParametersSet()
    {
        _value.Sync(ValueChanged.HasDelegate, Value, DefaultValue);
        _open.Sync(Open.HasValue, Open ?? false, DefaultOpen);
    }

    private bool IsSelected(string value) => _value.Value == value;

    private Task OpenAsync() => _open.SetAsync(true, OpenChanged);

    private Task CloseAsync() => _open.SetAsync(false, OpenChanged);

    private async Task SelectAsync(string value)
    {
        await _value.SetAsync(value, ValueChanged);
        await _open.SetAsync(false, OpenChanged);
    }

    // Options register their display content keyed by value, so BzSelectValue can show the chosen one
    // in the trigger - even for a value set before the listbox first opened (options render hidden
    // until then, but they still register). Re-render only on a NEW registration that matches the
    // current value: a re-registration on a later render (same value already mapped) must not loop.
    private void RegisterItem(string value, RenderFragment content)
    {
        var isNew = !_items.ContainsKey(value);
        _items[value] = content;
        if (isNew && value == _value.Value) InvokeAsync(StateHasChanged);
    }

    private void UnregisterItem(string value)
    {
        if (_items.Remove(value) && value == _value.Value) InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _preloaded) return;
        _preloaded = true;

        // Warm the floating modules so the FIRST open doesn't race a cold import (a flicker + a dead
        // first interaction). The browser caches them; the proxies we drop don't matter - a later
        // import resolves from cache. Keep the menu module: besides warming it, it guards the
        // trigger's ArrowDown/ArrowUp so opening doesn't first scroll the page (a splatted Blazor
        // onkeydown can't preventDefault the native scroll in time - it round-trips to .NET first).
        try
        {
            await using var _ = await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Blazeo.Base/dist/positioning.js");
            await using var __ = await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Blazeo.Base/dist/presence.js");
            await using var ___ = await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Blazeo.Base/dist/dismissableLayer.js");

            _menuModule = await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Blazeo.Base/dist/menu.js");
            _triggerGuard = await _menuModule.InvokeAsync<IJSObjectReference>(
                "guardTrigger", $"[data-bz-select-anchor='{_baseId}']");
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone before the warm-up landed.
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_triggerGuard is not null)
            {
                await _triggerGuard.InvokeVoidAsync("dispose");
                await _triggerGuard.DisposeAsync();
            }
            if (_menuModule is not null) await _menuModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone - nothing to clean up.
        }
        GC.SuppressFinalize(this);
    }
}
