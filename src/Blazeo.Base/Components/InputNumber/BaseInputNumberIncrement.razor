@namespace Blazeo
@inherits BzComponentBase
@*
    The step-up button. Pressing it steps once, then holds-to-repeat (the root runs the timer) until the
    pointer releases or leaves. preventDefault on pointerdown keeps focus in the input, so a press does not
    blur + reformat the field. Not in the tab order (tabindex=-1): keyboard users step with the input's
    arrow keys. Auto-disables at Max. Renders a button; pass the up-chevron (or any glyph) as its content.
*@

<button @onpointerdown="OnPressAsync"
        @onpointerdown:preventDefault="true"
        @onpointerup="OnReleaseAsync"
        @onpointerleave="OnReleaseAsync"
        @onpointercancel="OnReleaseAsync"
        @attributes="BuildAttributes()">
    @ChildContent
</button>

@code {
    /// <summary>The button content (typically an up chevron / plus icon).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private InputNumberContext? InputNumber { get; set; }

    private bool Enabled => InputNumber is { CanIncrement: true };

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder(this)
            .Set("type", "button")
            .Set("tabindex", "-1")
            .Aria("label", "Increase")
            .Data("bz-input-number-increment", "")
            .Set("dir", DirAttribute);

        if (!Enabled) props.Set("disabled", "disabled");

        return props.Merge(Attributes, Class, Style);
    }

    private Task OnPressAsync(PointerEventArgs e) =>
        e.Button == 0 && InputNumber is { } ctx ? ctx.PressStart.InvokeAsync(1) : Task.CompletedTask;

    private Task OnReleaseAsync(PointerEventArgs e) =>
        InputNumber?.PressEnd.InvokeAsync() ?? Task.CompletedTask;
}
