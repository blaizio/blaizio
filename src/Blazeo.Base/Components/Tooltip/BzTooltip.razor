@namespace Blazeo
@inject IJSRuntime Js
@implements IDisposable
@*
    A hover/focus tooltip: renders no element of its own - it owns the open state (delayed while
    pointing, immediate on focus) and cascades TooltipContext to BzTooltipTrigger / BzTooltipContent.
    Controllable via Open/DefaultOpen/OpenChanged (use @bind-Open). Inside a BzTooltipProvider it
    shares that group's delay and skip-delay window.
*@

<CascadingValue Value="@Context" IsFixed="false">
    @ChildContent
</CascadingValue>

@code {
    /// <summary>Controlled open state. Leave <see langword="null"/> for uncontrolled.</summary>
    [Parameter] public bool? Open { get; set; }

    /// <summary>Initial state when uncontrolled.</summary>
    [Parameter] public bool DefaultOpen { get; set; }

    /// <summary>Raised with the new state. Enables <c>@bind-Open</c>.</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>
    /// Milliseconds the pointer must rest on the trigger before opening. Keyboard focus opens it
    /// immediately regardless. <see langword="null"/> (the default) inherits the
    /// <see cref="BzTooltipProvider"/>'s delay, or 400 with no provider.
    /// </summary>
    [Parameter] public int? DelayDuration { get; set; }

    /// <summary>Disables the tooltip - it never opens.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>The trigger and content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private TooltipProviderContext? Provider { get; set; }

    private string _baseId = default!;
    private readonly ControllableState<bool> _state = new();
    private CancellationTokenSource? _delayCts;
    private bool _preloaded;

    private int EffectiveDelay => DelayDuration ?? Provider?.DelayDuration ?? 400;

    private TooltipContext Context => new(
        _state.Value,
        Disabled,
        $"{_baseId}-content",
        _baseId,
        EventCallback.Factory.Create(this, OpenDelayedAsync),
        EventCallback.Factory.Create(this, OpenImmediateAsync),
        EventCallback.Factory.Create(this, CloseAsync));

    protected override void OnInitialized() => _baseId = Identifier.Create("tooltip");

    protected override void OnParametersSet() => _state.Sync(Open.HasValue, Open ?? false, DefaultOpen);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _preloaded) return;
        _preloaded = true;

        // Warm the positioning + presence modules now so the FIRST open doesn't race a cold import
        // (which showed as a flicker + a dead first hover). The browser caches the modules; we drop
        // the proxies - a later import resolves from cache.
        try
        {
            await using var _ = await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Blazeo.Base/dist/positioning.js");
            await using var __ = await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Blazeo.Base/dist/presence.js");
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone before the warm-up landed.
        }
    }

    // Pointer entered: open after the delay - or immediately when the provider's skip window is live.
    private async Task OpenDelayedAsync()
    {
        if (Disabled || _state.Value) return;

        if (Provider?.ShouldSkipDelay == true)
        {
            await OpenNowAsync();
            return;
        }

        CancelPending();
        var cts = _delayCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(EffectiveDelay, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await OpenNowAsync();
    }

    // Focus: open at once (keyboard users get no hover delay).
    private Task OpenImmediateAsync()
    {
        CancelPending();
        return Disabled || _state.Value ? Task.CompletedTask : OpenNowAsync();
    }

    private async Task OpenNowAsync()
    {
        await SetOpenAsync(true);
        Provider?.NotifyOpen();
    }

    private async Task CloseAsync()
    {
        CancelPending();
        if (!_state.Value) return;
        await SetOpenAsync(false);
        Provider?.NotifyClose();
    }

    private Task SetOpenAsync(bool open) => _state.SetAsync(open, OpenChanged);

    private void CancelPending()
    {
        _delayCts?.Cancel();
        _delayCts?.Dispose();
        _delayCts = null;
    }

    public void Dispose() => CancelPending();
}
