@namespace Blazeo
@inherits BzComponentBase
@*
    The element a tooltip describes: opens on hover (after the delay) and focus, closes on
    leave / blur / Escape. A native <button> by default; AsChild puts the behaviour on your own
    element (e.g. a styled Button). Carries the data-bz-tooltip-anchor hook the content positions
    against, and aria-describedby pointing at the content while open.
*@

<BzPrimitive As="button"
                Attributes="@BuildAttributes()"
                ChildContent="@ChildContent"
                AsChild="@AsChild" />

@code {
    /// <summary>Trigger content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the behaviour onto your own element instead of a <c>&lt;button&gt;</c>.</summary>
    [Parameter] public RenderFragment<BzRenderProps>? AsChild { get; set; }

    [CascadingParameter] private TooltipContext? Tooltip { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var open = Tooltip?.Open ?? false;
        var props = new PropBuilder(this)
            .Data("bz-tooltip-anchor", Tooltip?.AnchorId)
            .Data("state", open ? "open" : "closed")
            .On("onpointerenter", EventCallback.Factory.Create(this, OnPointerEnter))
            .On("onpointerleave", EventCallback.Factory.Create(this, OnPointerLeave))
            .On("onfocusin", EventCallback.Factory.Create(this, OnFocusIn))
            .On("onfocusout", EventCallback.Factory.Create(this, OnFocusOut))
            .On("onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, OnKeyDown));

        // Only describe the trigger while the tooltip is actually showing.
        if (open) props.Aria("describedby", Tooltip?.ContentId);
        if (AsChild is null) props.Set("type", "button");

        return props.Merge(Attributes, Class, Style);
    }

    private Task OnPointerEnter() => Tooltip?.OpenDelayed.InvokeAsync() ?? Task.CompletedTask;
    private Task OnPointerLeave() => Tooltip?.Close.InvokeAsync() ?? Task.CompletedTask;
    private Task OnFocusIn() => Tooltip?.OpenImmediate.InvokeAsync() ?? Task.CompletedTask;
    private Task OnFocusOut() => Tooltip?.Close.InvokeAsync() ?? Task.CompletedTask;

    private Task OnKeyDown(KeyboardEventArgs e) =>
        e.Key == "Escape" ? (Tooltip?.Close.InvokeAsync() ?? Task.CompletedTask) : Task.CompletedTask;
}
