@namespace Blazeo
@implements IDisposable
@*
    Groups the tooltips inside it so they share a delay and a "skip delay" window: once one tooltip
    has opened, moving the pointer to another trigger in the group opens it immediately (no hover
    delay) until SkipDelayDuration ms after the last one closes. Renders no element of its own, and
    is optional - a BaseTooltip works without a provider (it just always waits its own delay).
*@

<CascadingValue Value="@_context" IsFixed="true">
    @ChildContent
</CascadingValue>

@code {
    /// <summary>Default hover delay (ms) for tooltips in this group. A tooltip's own DelayDuration overrides it. Defaults to 400.</summary>
    [Parameter] public int DelayDuration { get; set; } = 400;

    /// <summary>How long (ms) after the last tooltip closes that the next still opens instantly. Defaults to 300.</summary>
    [Parameter] public int SkipDelayDuration { get; set; } = 300;

    /// <summary>The tooltips.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private TooltipProviderContext _context = default!;

    protected override void OnInitialized() => _context = new TooltipProviderContext(DelayDuration, SkipDelayDuration);

    public void Dispose() => _context.Dispose();
}
