@namespace Blazeo
@inherits BlazeComponentBase
@*
    A set of layered panels, one visible at a time. Ported from Radix Tabs: a plain container that
    owns the selected value and cascades a TabsContext to BlazeTabsList / BlazeTabsTrigger /
    BlazeTabsContent. Keyboard navigation lives in the list (a BlazeRovingFocusGroup); with
    ActivationMode Automatic (the default) arrowing also activates - the ARIA tabs pattern.
    Controllable via Value/DefaultValue/ValueChanged (use @bind-Value). Headless: the styled layer
    dresses the triggers' data-state.
*@

<CascadingValue Value="@Context" IsFixed="false">
    <BlazePrimitive As="div" Attributes="@BuildAttributes()" ChildContent="@ChildContent" />
</CascadingValue>

@code {
    /// <summary>Controlled selected value. Use with <c>@bind-Value</c>.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Initial selection when uncontrolled.</summary>
    [Parameter] public string? DefaultValue { get; set; }

    /// <summary>Raised with the new value when the selection changes. Enables <c>@bind-Value</c>.</summary>
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Layout/navigation axis. Defaults to <see cref="Blazeo.Orientation.Horizontal"/>.</summary>
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Horizontal;

    /// <summary>Keyboard activation behaviour. Defaults to <see cref="TabsActivationMode.Automatic"/>.</summary>
    [Parameter] public TabsActivationMode ActivationMode { get; set; } = TabsActivationMode.Automatic;

    /// <summary>The tabs list and contents.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string _baseId = default!;
    private readonly ControllableState<string?> _state = new();

    private TabsContext Context =>
        new(_baseId, _state.Value, Orientation, ActivationMode,
            EventCallback.Factory.Create<string>(this, SelectAsync));

    protected override void OnInitialized() => _baseId = Identifier.Create("tabs");

    // Controlled when the consumer binds the value; otherwise uncontrolled, seeded from DefaultValue.
    protected override void OnParametersSet() =>
        _state.Sync(ValueChanged.HasDelegate, Value, DefaultValue);

    private Task SelectAsync(string tabValue) =>
        // Bridge the nullable internal state to the non-null public ValueChanged (tab values are never null).
        _state.SetAsync(tabValue, EventCallback.Factory.Create<string?>(this, v => ValueChanged.InvokeAsync(v!)));

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("orientation", Orientation.ToAttribute())
            .Merge(Attributes, Class, Style);
}
