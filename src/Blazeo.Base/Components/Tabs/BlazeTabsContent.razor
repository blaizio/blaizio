@namespace Blazeo
@inherits BlazeComponentBase
@*
    The panel for one tab: role="tabpanel" + aria-labelledby (its
    trigger's id) + tabindex="0" (so panel content is reachable right after the tablist), rendered
    only while its tab is selected (the no-animation equivalent, rendered only while open/selected).
*@

@if (Selected)
{
    <BlazePrimitive As="div" Attributes="@BuildAttributes()" ChildContent="@ChildContent" />
}

@code {
    /// <summary>The value identifying this panel (matches a <see cref="BlazeTabsTrigger"/>). Required.</summary>
    [Parameter] public string Value { get; set; } = default!;

    /// <summary>Panel content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private TabsContext? Tabs { get; set; }

    private bool Selected => Tabs?.IsSelected(Value) ?? false;

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Set("role", "tabpanel")
            .Set("id", Tabs?.ContentId(Value))
            .Aria("labelledby", Tabs?.TriggerId(Value))
            .Set("tabindex", "0")
            .Data("state", "active")
            .Data("orientation", (Tabs?.Orientation ?? Orientation.Horizontal).ToAttribute())
            .Merge(Attributes, Class, Style);
}
