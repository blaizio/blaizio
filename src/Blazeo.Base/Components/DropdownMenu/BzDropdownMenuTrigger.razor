@namespace Blazeo
@inherits BzComponentBase
@*
    The button that opens a BzDropdownMenu: a native <button type="button"> whose click TOGGLES the
    menu. Enter / Space activate it natively (a button click), opening with focus on the surface;
    ArrowDown / ArrowUp open with focus pre-placed on the first / last item. Carries
    aria-haspopup="menu"/-expanded/-controls + data-state, plus the data-bz-dropdown-menu-anchor hook
    the content positions and dismisses against. AsChild lets it wrap your own element.
*@

<BzPrimitive As="button"
                Attributes="@BuildAttributes()"
                ChildContent="@ChildContent"
                AsChild="@AsChild" />

@code {
    /// <summary>Trigger content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the behaviour onto your own element instead of a <c>&lt;button&gt;</c>.</summary>
    [Parameter] public RenderFragment<BzRenderProps>? AsChild { get; set; }

    [CascadingParameter] private DropdownMenuContext? Menu { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var open = Menu?.Open ?? false;
        var props = new PropBuilder(this)
            .Set("id", Menu?.TriggerId)
            .Data("bz-dropdown-menu-anchor", Menu?.AnchorId)
            .Aria("haspopup", "menu")
            .Aria("expanded", open)
            .Aria("controls", Menu?.ContentId)
            .Data("state", open ? "open" : "closed")
            .On("onclick", EventCallback.Factory.Create(this, OnClickAsync))
            .On("onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, OnKeyDownAsync));

        if (AsChild is null) props.Set("type", "button");

        return props.Merge(Attributes, Class, Style);
    }

    private Task OnClickAsync()
    {
        if (Menu is null) return Task.CompletedTask;
        // Enter / Space land here too (native button activation), opening with focus on the surface.
        return Menu.Open ? Menu.RequestClose.InvokeAsync() : Menu.RequestOpen.InvokeAsync(MenuFocusIntent.None);
    }

    // Arrow keys open with focus pre-placed on an item (the keyboard-open path). The page may scroll a
    // hair before focus lands (Blazor can't preventDefault a splatted keydown); navigation INSIDE the
    // open menu is owned by ts/menu.js, which does preventDefault.
    private Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (Menu is null || Menu.Open) return Task.CompletedTask;
        return e.Key switch
        {
            "ArrowDown" => Menu.RequestOpen.InvokeAsync(MenuFocusIntent.First),
            "ArrowUp" => Menu.RequestOpen.InvokeAsync(MenuFocusIntent.Last),
            _ => Task.CompletedTask,
        };
    }
}
