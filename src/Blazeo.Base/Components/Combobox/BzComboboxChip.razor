@namespace Blazeo
@inherits BzComponentBase
@*
    One token in a Multiple combobox, standing in for a selected value. Cascades its Value so a nested
    BzComboboxChipRemove knows what to drop. Its content is the label plus (optionally) the remove button.
*@

<CascadingValue Value="@(new ComboboxChipContext(Value))" IsFixed="true">
    <div @attributes="BuildAttributes()">@ChildContent</div>
</CascadingValue>

@code {
    /// <summary>The selected value this chip represents.</summary>
    [Parameter] public string Value { get; set; } = "";

    /// <summary>The chip content (the label, and usually a BzComboboxChipRemove).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private ComboboxContext? Combobox { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder(this)
            .Data("bz-combobox-chip", "")
            .Data("value", Value)
            .Set("dir", DirAttribute);

        if (Combobox?.Disabled == true) props.Data("disabled", "");

        return props.Merge(Attributes, Class, Style);
    }
}
