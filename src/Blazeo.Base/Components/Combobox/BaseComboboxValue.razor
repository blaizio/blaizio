@namespace Blazeo
@*
    The display of the current selection - usually placed inside a BaseComboboxTrigger (single) or a
    BaseComboboxChips (multiple). Renders no wrapper of its own so it composes cleanly. With a Selection
    render-prop it hands you the selected values to render however you like (the multi-select case maps
    them to chips); otherwise it shows the single selected value's text, falling back to Placeholder when
    nothing is selected.
*@

@if (Combobox is not null)
{
    if (Selection is not null)
    {
        @Selection(Combobox.Selected)
    }
    else if (Combobox.HasSelection)
    {
        if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            @(string.Join(", ", Combobox.Selected))
        }
    }
    else if (Placeholder is not null)
    {
        @Placeholder
    }
}

@code {
    /// <summary>
    /// Renders the selected values yourself - receives the selection (use it to map values to
    /// <see cref="BaseComboboxChip"/>s in Multiple mode). When omitted, the selected value's text is shown.
    /// </summary>
    [Parameter] public RenderFragment<IReadOnlyList<string>>? Selection { get; set; }

    /// <summary>Custom display for the current single selection (overrides the default value text).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Shown while nothing is selected.</summary>
    [Parameter] public RenderFragment? Placeholder { get; set; }

    [CascadingParameter] private ComboboxContext? Combobox { get; set; }
}
