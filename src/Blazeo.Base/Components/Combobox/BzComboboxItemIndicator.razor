@namespace Blazeo
@inherits BzComponentBase
@*
    The check shown on a chosen item. Reads the enclosing BzComboboxItem's cascaded state and renders its
    content only while that item is selected (set KeepMounted to keep it in the DOM and let the skin fade
    it via data-selected). Carries no own behaviour - just the selected-only gate.
*@

@if (Item is { Selected: true } || KeepMounted)
{
    <span @attributes="BuildAttributes()">
        @ChildContent
    </span>
}

@code {
    /// <summary>The indicator content (usually a check icon).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Keep the indicator mounted even when unselected (so a skin can animate it). Defaults to <see langword="false"/>.</summary>
    [Parameter] public bool KeepMounted { get; set; }

    [CascadingParameter] private ComboboxItemContext? Item { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder(this)
            .Set("aria-hidden", "true")
            .Data("bz-combobox-item-indicator", "");

        if (Item?.Selected == true) props.Data("selected", "");

        return props.Merge(Attributes, Class, Style);
    }
}
