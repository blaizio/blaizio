@namespace Blazeo
@inject IJSRuntime Js
@implements IAsyncDisposable
@*
    The combobox root (an autocomplete input over the WAI-ARIA combobox + listbox pattern). Renders no
    element of its own: it fuses a SELECT's selection + open state with a COMMAND's query + item filter,
    and cascades one ComboboxContext to the input, content, list, items, value, chips, trigger, and clear.
    Focus stays in the input - the highlighted option is virtual (aria-activedescendant), driven DOM-side
    by ts/combobox.js. Single-select is controllable via Value/DefaultValue/ValueChanged (use
    @bind-Value); set Multiple for chips, controllable via Values/DefaultValues/ValuesChanged
    (@bind-Values). Open and Query (the input text) are likewise controllable.

    Like the command palette, items stay MOUNTED while filtered out (they get a `hidden` attribute, NOT
    an unmount) so their registrations survive a query that empties a whole group. Unlike it, the items
    live in a popup that unmounts when closed - the registry is only consulted while open. Non-modal (the
    floating tier): no overlay, no scroll lock; Escape, Tab, an outside press, or a single-select pick
    dismisses it.
*@

<CascadingValue Value="@BuildContext()" IsFixed="false">
    @ChildContent
</CascadingValue>

@code {
    /// <summary>Controlled selected value (single-select). Leave <see langword="null"/> for uncontrolled; bind with <c>@bind-Value</c>.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Initial selected value when uncontrolled (single-select).</summary>
    [Parameter] public string? DefaultValue { get; set; }

    /// <summary>Raised with the new value when the selection changes (single-select). Enables <c>@bind-Value</c>.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Allow more than one value to be selected (chips). Drives the <c>Values</c> binding instead of <c>Value</c>.</summary>
    [Parameter] public bool Multiple { get; set; }

    /// <summary>Controlled selected values (when <see cref="Multiple"/>). Bind with <c>@bind-Values</c>.</summary>
    [Parameter] public IReadOnlyList<string>? Values { get; set; }

    /// <summary>Initial selected values when uncontrolled (when <see cref="Multiple"/>).</summary>
    [Parameter] public IReadOnlyList<string>? DefaultValues { get; set; }

    /// <summary>Raised with the new values when the selection changes (when <see cref="Multiple"/>). Enables <c>@bind-Values</c>.</summary>
    [Parameter] public EventCallback<IReadOnlyList<string>> ValuesChanged { get; set; }

    /// <summary>Controlled open state. Use with <c>@bind-Open</c>.</summary>
    [Parameter] public bool? Open { get; set; }

    /// <summary>Initial open state when uncontrolled.</summary>
    [Parameter] public bool DefaultOpen { get; set; }

    /// <summary>Raised with the new open state. Enables <c>@bind-Open</c>.</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Controlled query (the input text). Bind with <c>@bind-Query</c>.</summary>
    [Parameter] public string? Query { get; set; }

    /// <summary>Initial query when uncontrolled.</summary>
    [Parameter] public string DefaultQuery { get; set; } = "";

    /// <summary>Raised with the new query on every keystroke. Enables <c>@bind-Query</c>.</summary>
    [Parameter] public EventCallback<string?> QueryChanged { get; set; }

    /// <summary>
    /// Whether typing filters the list. Defaults to <see langword="true"/>; set <see langword="false"/>
    /// to drive the visible items yourself (async / server search) - items are never auto-hidden.
    /// </summary>
    [Parameter] public bool ShouldFilter { get; set; } = true;

    /// <summary>
    /// Custom match: <c>(query, value, keywords) =&gt; matched</c>. Defaults to
    /// <see cref="CommandFilter.Matches"/> (substring or fuzzy subsequence).
    /// </summary>
    [Parameter] public Func<string, string, IReadOnlyList<string>?, bool>? Filter { get; set; }

    /// <summary>
    /// Highlight the first match automatically as the list filters (so Enter selects it). Defaults to
    /// <see langword="false"/> - nothing is highlighted until the user presses an arrow key.
    /// </summary>
    [Parameter] public bool AutoHighlight { get; set; }

    /// <summary>Arrow navigation wraps past the ends. Defaults to <see langword="false"/>.</summary>
    [Parameter] public bool Loop { get; set; }

    /// <summary>Accessible label applied to the input and listbox (use when there is no visible label).</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Disable the whole combobox.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>The input (or chips), content, and the rest of the parts.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string _baseId = default!;
    private readonly ControllableState<string?> _value = new();
    private readonly ControllableState<IReadOnlyList<string>> _values = new();
    private readonly ControllableState<bool> _open = new();
    private readonly ControllableState<string?> _query = new();
    private readonly Dictionary<string, ComboboxItemRegistration> _items = new(StringComparer.Ordinal);

    // Whether the input text is an active SEARCH (the user has typed since the last open/select) versus an
    // echo of the chosen value. A controlled query is always a search (the parent owns the text). This is
    // what lets a single-select keep its value visible while open yet still list every item until you type.
    private bool _typed;
    private bool _selectOnOpen;
    private bool IsTyping => _typed || _query.IsControlled;

    // Visibility memo, recomputed only when an item (un)registers (_version) or the query changes.
    private int _version;
    private int _computedVersion = -1;
    private string? _computedQuery;
    private bool _computedTyping;
    private bool _filtering;
    private readonly HashSet<string> _visibleItems = new(StringComparer.Ordinal);
    private readonly HashSet<string> _visibleGroups = new(StringComparer.Ordinal);
    private int _count;

    private bool _preloaded;
    private IJSObjectReference? _comboboxModule;

    protected override void OnInitialized() => _baseId = Identifier.Create("combobox");

    // @bind drives controlled mode per facet: ValueChanged (single), ValuesChanged (multi), OpenChanged,
    // QueryChanged. A bare Default* is uncontrolled.
    protected override void OnParametersSet()
    {
        _value.Sync(ValueChanged.HasDelegate, Value, DefaultValue);
        _values.Sync(ValuesChanged.HasDelegate, Values ?? [], DefaultValues ?? []);
        _open.Sync(Open.HasValue, Open ?? false, DefaultOpen);
        _query.Sync(QueryChanged.HasDelegate, Query, DefaultQuery);
    }

    private ComboboxContext BuildContext() => new(
        Multiple ? null : _value.Value,
        Selected,
        Multiple,
        IsSelected,
        EventCallback.Factory.Create<string>(this, SelectAsync),
        EventCallback.Factory.Create<string>(this, DeselectAsync),
        EventCallback.Factory.Create(this, ClearSelectionAsync),
        EventCallback.Factory.Create(this, FocusInputAsync),
        _open.Value,
        EventCallback.Factory.Create(this, OpenAsync),
        EventCallback.Factory.Create(this, CloseAsync),
        EventCallback.Factory.Create<bool>(this, SetOpenAsync),
        _query.Value ?? "",
        IsTyping,
        ShouldFilter && IsTyping && !string.IsNullOrWhiteSpace(_query.Value),
        AutoHighlight,
        Loop,
        EventCallback.Factory.Create<string?>(this, OnUserTypeAsync),
        Register,
        Unregister,
        IsItemVisible,
        IsGroupVisible,
        ResultCount,
        $"{_baseId}-list",
        $"{_baseId}-input",
        _baseId,
        Label,
        Disabled);

    // Every selected value in selection order: the multi list, or the single value as a 0/1 list.
    private IReadOnlyList<string> Selected =>
        Multiple ? _values.Value : (_value.Value is { } v ? new[] { v } : []);

    private bool IsSelected(string value) =>
        Multiple ? _values.Value.Contains(value) : _value.Value == value;

    // The user typing: the input text becomes an active search (so the list filters and the input shows
    // the query instead of the chosen label). Opening the popup, picking, or clearing resets this.
    private async Task OnUserTypeAsync(string? value)
    {
        _typed = true;
        await SetQueryAsync(value);
    }

    // Single-select commits the value and closes - the input then echoes the value's label on its own (a
    // search is no longer in progress). Multi-select toggles it, ends the search + clears the query (ready
    // for the next one), and stays open so several can be chosen in one visit.
    private async Task SelectAsync(string value)
    {
        if (Multiple)
        {
            await _values.SetAsync(Toggle(_values.Value, value), ValuesChanged);
            _typed = false;
            await SetQueryAsync("");
            return;
        }

        await _value.SetAsync(value, ValueChanged);
        await CloseAsync();
    }

    // Remove a value (a chip's remove, or clearing the single value).
    private async Task DeselectAsync(string value)
    {
        if (Multiple)
        {
            if (_values.Value.Contains(value)) await _values.SetAsync(Without(_values.Value, value), ValuesChanged);
            return;
        }

        if (_value.Value == value) await _value.SetAsync(null, ValueChanged);
    }

    // The clear button: drop the whole selection and the query, end any search, then hand focus back.
    private async Task ClearSelectionAsync()
    {
        if (Multiple) await _values.SetAsync([], ValuesChanged);
        else await _value.SetAsync(null, ValueChanged);
        _typed = false;
        await SetQueryAsync("");
        await FocusInputAsync();
    }

    private static IReadOnlyList<string> Toggle(IReadOnlyList<string> values, string value) =>
        values.Contains(value) ? Without(values, value) : [.. values, value];

    private static IReadOnlyList<string> Without(IReadOnlyList<string> values, string value) =>
        values.Where(v => v != value).ToList();

    // Opening ends any in-progress search: the list shows every item again, and a single-select keeps its
    // chosen value visible in the input (selected, so the first keystroke replaces it). The leftover query
    // is cleared too (uncontrolled only - a controlled query is the parent's to manage).
    private async Task OpenAsync()
    {
        if (_open.Value) return;
        _typed = false;
        _selectOnOpen = true;
        if (!_query.IsControlled) await SetQueryAsync("");
        await _open.SetAsync(true, OpenChanged);
    }

    // Closing also ends the search and drops the abandoned query, so the input reverts to the chosen
    // label. Close FIRST, then drop the query: once closed the visibility memo is frozen (see
    // EnsureComputed), so clearing the query can't visibly un-filter the still-mounted list as the popup
    // animates away after a pick (otherwise the whole unfiltered list flashes for a frame on select).
    private async Task CloseAsync()
    {
        if (!_open.Value) return;
        _typed = false;
        await _open.SetAsync(false, OpenChanged);
        if (!_query.IsControlled) await SetQueryAsync("");
    }

    private Task SetOpenAsync(bool open) => open ? OpenAsync() : CloseAsync();

    private Task SetQueryAsync(string? value) => _query.SetAsync(value, QueryChanged);

    [System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage] // JS-interop seam: verified in-browser.
    private async Task FocusInputAsync()
    {
        try
        {
            _comboboxModule ??= await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Blazeo.Base/dist/combobox.js");
            await _comboboxModule.InvokeVoidAsync("focusInput", $"{_baseId}-input");
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone - nothing to focus.
        }
    }

    // Items register once (and on a Value/Keywords change) from OnParametersSet; re-render so the new
    // registration is reflected in the counts and group visibility.
    private void Register(ComboboxItemRegistration registration)
    {
        _items[registration.Id] = registration;
        _version++;
        InvokeAsync(StateHasChanged);
    }

    private void Unregister(string id)
    {
        if (_items.Remove(id))
        {
            _version++;
            InvokeAsync(StateHasChanged);
        }
    }

    private bool IsItemVisible(string id)
    {
        EnsureComputed();
        return _visibleItems.Contains(id);
    }

    // Not filtering: every group shows (and an item may not have registered yet on the first frame).
    // Filtering: only groups with at least one matching item.
    private bool IsGroupVisible(string id)
    {
        EnsureComputed();
        return !_filtering || _visibleGroups.Contains(id);
    }

    private int ResultCount()
    {
        EnsureComputed();
        return _count;
    }

    private void EnsureComputed()
    {
        // While closed (including the exit animation) freeze the visible set at its last open-state value:
        // dropping the query/typing on close must not visibly un-filter the still-mounted list as the
        // popup animates away. The next open recomputes. (_computedVersion < 0 = never computed yet.)
        if (!_open.Value && _computedVersion >= 0) return;

        var query = _query.Value ?? "";
        var typing = IsTyping;
        if (_computedVersion == _version && _computedQuery == query && _computedTyping == typing) return;
        _computedVersion = _version;
        _computedQuery = query;
        _computedTyping = typing;

        _visibleItems.Clear();
        _visibleGroups.Clear();
        _filtering = ShouldFilter && typing && !string.IsNullOrWhiteSpace(query);

        if (!_filtering)
        {
            foreach (var (id, registration) in _items)
            {
                _visibleItems.Add(id);
                if (registration.GroupId is { } group) _visibleGroups.Add(group);
            }

            _count = _items.Count;
            return;
        }

        var match = Filter ?? CommandFilter.Matches;
        _count = 0;
        foreach (var (id, registration) in _items)
        {
            if (!match(query, registration.Value, registration.Keywords)) continue;
            _visibleItems.Add(id);
            _count++;
            if (registration.GroupId is { } group) _visibleGroups.Add(group);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_preloaded)
        {
            _preloaded = true;

            // Warm the floating + combobox modules so the FIRST open doesn't race a cold import (a flicker
            // + a dead first interaction). The browser caches them; we keep the combobox proxy for focus.
            try
            {
                await using var _ = await Js.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/Blazeo.Base/dist/positioning.js");
                await using var __ = await Js.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/Blazeo.Base/dist/presence.js");
                await using var ___ = await Js.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/Blazeo.Base/dist/dismissableLayer.js");

                _comboboxModule ??= await Js.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/Blazeo.Base/dist/combobox.js");
            }
            catch (JSDisconnectedException)
            {
                // Circuit gone before the warm-up landed.
            }
        }

        // On each open, focus the input and select its text so the echoed label is replaced as soon as
        // the user types. Skipped while a search is already in progress (the input holds a live query that
        // must survive) - so opening via typing into a closed field doesn't select the just-typed text.
        if (_selectOnOpen && _open.Value)
        {
            _selectOnOpen = false;
            if (!IsTyping) await FocusInputAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_comboboxModule is not null) await _comboboxModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone.
        }
        GC.SuppressFinalize(this);
    }
}
