@namespace Blazeo
@inherits BzComponentBase
@inject IJSRuntime Js
@implements IAsyncDisposable
@using System.Diagnostics.CodeAnalysis
@*
    The scrolling listbox surface inside the popup. Holds the groups, items, and empty state, and
    attaches ts/combobox.js, which owns the keyboard navigation and the virtual highlight (focus stays in
    the input). Pure DOM-driven, no .NET callbacks: C# owns the query and which items render, JS owns the
    highlight, the scrolling, and - when AutoHighlight is on - snapping the active option to the first
    match after each refilter. Mounts with the popup and tears the module down when the popup closes.
*@

<div @ref="_element" @attributes="BuildAttributes()">
    @ChildContent
</div>

@code {
    /// <summary>Groups, items, and an optional empty state.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private ComboboxContext? Combobox { get; set; }

    private ElementReference _element;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;
    private bool _attached;

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder(this)
            .Set("id", Combobox?.ListId)
            .Set("role", "listbox")
            .Aria("label", Combobox?.Label)
            .Data("bz-combobox-list", "")
            .Set("dir", DirAttribute)
            .Merge(Attributes, Class, Style);

    [ExcludeFromCodeCoverage] // JS-interop seam: a no-op under bUnit's loose interop, verified in-browser.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _attached || Combobox is null) return;
        _attached = true;

        try
        {
            _module = await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Blazeo.Base/dist/combobox.js");
            _handle = await _module.InvokeAsync<IJSObjectReference>(
                "createCombobox",
                _element,
                new { inputId = Combobox.InputId, loop = Combobox.Loop, autoHighlight = Combobox.AutoHighlight });
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone before the module landed.
        }
    }

    [ExcludeFromCodeCoverage]
    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_handle is not null)
            {
                await _handle.InvokeVoidAsync("dispose");
                await _handle.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone - nothing to clean up.
        }

        GC.SuppressFinalize(this);
    }
}
