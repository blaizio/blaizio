@namespace Blazeo
@inherits BlazeComponentBase
@*
    The accessible description of a BlazeDialog - a <p> the content's aria-describedby points at.
    Ported from Radix DialogDescription.
*@

<BlazePrimitive As="p" Attributes="@BuildAttributes()" ChildContent="@ChildContent" />

@code {
    /// <summary>Description text.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private DialogContext? Dialog { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Set("id", Dialog?.DescriptionId)
            .Merge(Attributes, Class, Style);
}
