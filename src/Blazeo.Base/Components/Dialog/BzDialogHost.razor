@namespace Blazeo
@implements IDisposable
@inject IDialogStore Store
@*
    The headless host for imperatively shown dialogs (see IDialogStore). Renders each open instance via
    ChildContent - the styled layer supplies the skin (Dialog / AlertDialog). Deliberately dumb: it knows
    nothing about animations or z-index.

    It is "presence-aware" only in that it DEFERS removal: a closed instance (IsOpen=false) stays in the
    list, animating out, until the skin reports the exit animation finished by invoking
    DialogHostContext.OnExitComplete (which is wired to DialogInstance.NotifyExited). Removing it any
    earlier would hard-unmount the dialog and cut off the close animation.

    Each instance subtree is @key'd by the instance: without the key, Blazor's positional diff would reuse
    a BzDialogContent for a different logical dialog when one is removed mid-stack, carrying over its
    presence/JS state.
*@

@for (var i = 0; i < Store.Instances.Count; i++)
{
    var instance = Store.Instances[i];
    var context = new DialogHostContext(instance, i, EventCallback.Factory.Create(this, instance.NotifyExited));

    <CascadingValue Value="instance" IsFixed="false" @key="instance">
        @ChildContent(context)
    </CascadingValue>
}

@code {
    /// <summary>Renders one open dialog. Supply the skin and wire <see cref="DialogHostContext.OnExitComplete"/> to the content.</summary>
    [Parameter] public RenderFragment<DialogHostContext> ChildContent { get; set; } = default!;

    protected override void OnInitialized() => Store.Changed += OnStoreChanged;

    private void OnStoreChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Store.Changed -= OnStoreChanged;
}
