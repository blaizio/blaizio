@namespace Blazeo
@inherits BzComponentBase
@implements IDisposable
@*
    The accessible description of a BzDialog - a <p> the content's aria-describedby points at.
    Optional; the content wires aria-describedby only while this
    is rendered (it registers its presence below) so the reference never dangles.
*@

<BzPrimitive As="p" Attributes="@BuildAttributes()" ChildContent="@ChildContent" />

@code {
    /// <summary>Description text.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private DialogContext? Dialog { get; set; }
    [CascadingParameter] private DialogAriaRegistry? Aria { get; set; }

    // Tell the content a description is present, so aria-describedby points at an element that exists.
    protected override void OnInitialized() => Aria?.SetDescription(true);

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Set("id", Dialog?.DescriptionId)
            .Merge(Attributes, Class, Style);

    public void Dispose() => Aria?.SetDescription(false);
}
