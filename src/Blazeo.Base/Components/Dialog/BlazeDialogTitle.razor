@namespace Blazeo
@inherits BlazeComponentBase
@implements IDisposable
@*
    The accessible name of a BlazeDialog - an <h2> the content's aria-labelledby points at.
    Ported from Radix DialogTitle. Every dialog should have one (visually hidden if necessary); the
    content wires aria-labelledby only while this is rendered (it registers its presence below).
*@

<BlazePrimitive As="h2" Attributes="@BuildAttributes()" ChildContent="@ChildContent" />

@code {
    /// <summary>Title text.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private DialogContext? Dialog { get; set; }
    [CascadingParameter] private DialogAriaRegistry? Aria { get; set; }

    // Tell the content a title is present, so it wires aria-labelledby to an element that exists.
    protected override void OnInitialized() => Aria?.SetTitle(true);

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Set("id", Dialog?.TitleId)
            .Merge(Attributes, Class, Style);

    public void Dispose() => Aria?.SetTitle(false);
}
