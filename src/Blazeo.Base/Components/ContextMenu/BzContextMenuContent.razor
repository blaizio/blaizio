@namespace Blazeo
@inherits MenuContentBase
@*
    The floating surface of a BzContextMenu: a role="menu" panel anchored to the click point (the
    root's 0x0 marker) via ts/positioning.js, navigated by ts/menu.js, presence-managed, and dismissed
    by Escape, Tab, an outside pointer-down, or selecting an item. Identical machinery to
    BzDropdownMenuContent (it reuses MenuContentBase + the shared DropdownMenuContext, so every
    BzDropdownMenu* item / submenu drops straight in); it differs only in the anchor (a point, not a
    trigger edge), so it opens with its top-start corner at the cursor and carries no aria-labelledby
    (there is no trigger to name it).
*@

@if (Present)
{
    <BzFocusScope Trapped="false"
                     Loop="false"
                     OnMountAutoFocus="SuppressAutoFocus"
                     OnUnmountAutoFocus="SuppressAutoFocus"
                     Attributes="@BuildAttributes()"
                     ElementRefCaptured="@CaptureElement">
        @ChildContent
    </BzFocusScope>
}

@code {
    /// <summary>Menu content (items, labels, separators, groups, submenus).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Gap in pixels between the click point and the content. Defaults to 0 (at the cursor).</summary>
    [Parameter] public double SideOffset { get; set; }

    /// <summary>
    /// Arrow navigation wraps at the ends (past the last item returns to the first). Defaults to
    /// <see langword="true"/>; set <see langword="false"/> to stop at the first/last item instead.
    /// </summary>
    [Parameter] public bool Loop { get; set; } = true;

    /// <summary>Raised after the exit animation finishes and the content has unmounted.</summary>
    [Parameter] public EventCallback OnExitComplete { get; set; }

    [CascadingParameter] private DropdownMenuContext? Menu { get; set; }

    protected override bool IsOpen => Menu?.Open ?? false;
    // Right-click is a pointer gesture: open onto the surface (first Arrow steps onto an item).
    protected override MenuFocusIntent FocusIntent => MenuFocusIntent.None;
    protected override string AnchorSelector => $"[data-bz-context-menu-anchor='{Menu?.AnchorId}']";
    protected override bool Dismissable => true;
    protected override bool MenuLoop => Loop;
    // Top-start corner at the cursor; flips to stay on screen.
    protected override Side PreferredSide => Side.Bottom;
    protected override Align PreferredAlign => Align.Start;
    protected override double PreferredSideOffset => SideOffset;

    protected override Task RequestCloseAsync() =>
        Menu is null ? Task.CompletedTask : Menu.RequestClose.InvokeAsync();

    protected override async ValueTask OnClosedAsync() => await OnExitComplete.InvokeAsync();

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder(this)
            .Set("role", "menu")
            .Set("id", Menu?.ContentId)
            .Aria("orientation", "vertical")
            .Data("bz-menu-content", "")
            .Data("state", Closing ? "closed" : "open")
            .Data("side", ResolvedSide)
            .Data("align", ResolvedAlign)
            .Set("dir", DirAttribute)
            .On("onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, OnKeyDownAsync))
            .Merge(Attributes, Class, Style);

    private Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (Menu is null) return Task.CompletedTask;
        return e.Key is "Escape" or "Tab" ? Menu.RequestClose.InvokeAsync() : Task.CompletedTask;
    }
}
