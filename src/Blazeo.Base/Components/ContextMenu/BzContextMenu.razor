@namespace Blazeo
@inject IJSRuntime Js
@using System.Globalization
@*
    A right-click menu: renders no element of its own beyond a tiny invisible anchor marker. It owns
    the open state and the point that was right-clicked, and cascades TWO contexts - a
    ContextMenuContext so BzContextMenuTrigger can open the menu at the pointer, and the shared
    DropdownMenuContext so every BzDropdownMenu* item / checkbox / radio / submenu works inside it
    unchanged (selecting an item, Escape, an outside press, or Tab all close it).

    Positioning: the menu opens at the click point, not anchored to a trigger edge. A 0x0
    position:fixed marker is parked at the captured coordinates; the content anchors to it through the
    same @floating-ui path the dropdown uses (no point-anchor support needed in the JS). The marker is
    always rendered (pointer-events:none, invisible) so the close animation never loses its anchor.
    Non-modal, like the rest of the floating tier.
*@

<CascadingValue Value="@MenuContext" IsFixed="false">
    <CascadingValue Value="@CtxContext" IsFixed="false">
        @ChildContent
        <div data-bz-context-menu-anchor="@_baseId" aria-hidden="true" style="@MarkerStyle"></div>
    </CascadingValue>
</CascadingValue>

@code {
    /// <summary>Controlled open state. Leave <see langword="null"/> for uncontrolled (use <c>@bind-Open</c>).</summary>
    [Parameter] public bool? Open { get; set; }

    /// <summary>Initial state when uncontrolled.</summary>
    [Parameter] public bool DefaultOpen { get; set; }

    /// <summary>Raised with the new state. Enables <c>@bind-Open</c>.</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>The trigger and content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string _baseId = default!;
    private readonly ControllableState<bool> _state = new();
    private double _x;
    private double _y;
    private bool _preloaded;

    // The shared menu context the reused BzDropdownMenu* items + submenus read. RequestOpen is unused
    // (the trigger opens at a point via CtxContext); only RequestClose and Open/ids matter here.
    private DropdownMenuContext MenuContext => new(
        _state.Value,
        MenuFocusIntent.None,
        $"{_baseId}-content",
        $"{_baseId}-trigger",
        _baseId,
        default,
        EventCallback.Factory.Create(this, CloseAsync));

    private ContextMenuContext CtxContext => new(
        EventCallback.Factory.Create<MenuPoint>(this, OpenAtPointAsync));

    // A 0x0 fixed, click-through marker at the captured point - the content's @floating-ui anchor.
    private string MarkerStyle => string.Create(
        CultureInfo.InvariantCulture,
        $"position:fixed;left:{_x}px;top:{_y}px;width:0;height:0;pointer-events:none");

    protected override void OnInitialized() => _baseId = Identifier.Create("context-menu");

    protected override void OnParametersSet() => _state.Sync(Open.HasValue, Open ?? false, DefaultOpen);

    private Task OpenAtPointAsync(MenuPoint point)
    {
        _x = point.X;
        _y = point.Y;
        return _state.SetAsync(true, OpenChanged);
    }

    private Task CloseAsync() => _state.SetAsync(false, OpenChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _preloaded) return;
        _preloaded = true;

        // Warm the floating modules so the first right-click doesn't race a cold import (a flicker +
        // dead first open). The browser caches them; we drop the proxies. focusScope.js is included
        // because the content always wraps one and a cold focus scope would lose the import race with
        // the (warm) menu module, mis-placing the opening focus.
        try
        {
            await using var _ = await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Blazeo.Base/dist/positioning.js");
            await using var __ = await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Blazeo.Base/dist/presence.js");
            await using var ___ = await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Blazeo.Base/dist/dismissableLayer.js");
            await using var ____ = await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Blazeo.Base/dist/menu.js");
            await using var _____ = await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Blazeo.Base/dist/focusScope.js");
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone before the warm-up landed.
        }
    }
}
