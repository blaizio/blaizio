@namespace Blazeo
@inherits BlazeComponentBase
@implements IDisposable
@*
    Avatar image. Always present in the DOM (so it can load), but hidden until its native load
    event fires; reports success/failure to the ancestor BlazeAvatar so the fallback can react.
*@

<img src="@Src" alt="@Alt" data-slot="avatar-image"
     class="@Class" style="@CurrentStyle"
     @onload="OnLoad" @onerror="OnError"
     @attributes="Attributes" />

@code {
    [CascadingParameter] private BlazeAvatar? Avatar { get; set; }

    /// <summary>Image URL.</summary>
    [Parameter] public string? Src { get; set; }

    /// <summary>Alt text.</summary>
    [Parameter] public string? Alt { get; set; }

    private string CurrentStyle =>
        Avatar?.Status == AvatarStatus.Loaded ? (Style ?? string.Empty) : $"display:none;{Style}";

    protected override void OnInitialized()
    {
        if (Avatar is not null) Avatar.StatusChanged += Refresh;
    }

    private void OnLoad() => Avatar?.Report(AvatarStatus.Loaded);
    private void OnError() => Avatar?.Report(AvatarStatus.Error);
    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (Avatar is not null) Avatar.StatusChanged -= Refresh;
    }
}
