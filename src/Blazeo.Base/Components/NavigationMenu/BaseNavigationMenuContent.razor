@namespace Blazeo
@inherits BzComponentBase
@*
    The panel for an item. In viewport mode it registers itself with the root, which relays it into the
    shared viewport (so nothing renders here); with viewport off it drops inline under its item when open.
*@

@if (Inline && Open)
{
    @ContentFragment
}

@code {
    /// <summary>The panel content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private BaseNavigationMenu? Root { get; set; }
    [CascadingParameter] private NavigationMenuItemContext? Item { get; set; }

    private string Id => Item?.Id ?? "";
    private bool Open => Root?.IsOpen(Id) ?? false;
    private bool Inline => Root?.Viewport == false;

    protected override void OnInitialized()
    {
        // Viewport mode: hand our markup to the root to render inside the shared viewport.
        if (Root?.Viewport == true && Id != "") Root.RegisterContent(Id, ContentFragment);
    }

    private RenderFragment ContentFragment => @<div @attributes="@BuildAttributes()">@ChildContent</div>;

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder(this)
            .Data("slot", "navigation-menu-content")
            .Data("state", "open")
            .Merge(Attributes, Class, Style);
}
