@namespace Blazeo
@inherits BzComponentBase
@inject IToastStore Store
@inject IJSRuntime Js
@implements IDisposable
@implements IAsyncDisposable
@*
    Headless toast host (see IToastStore). Renders the aria-live <section> and one fixed <ol> per
    occupied corner, with a <li data-bz-toast> per toast carrying the STATIC data contract; the styled
    layer fills each toast's content via ChildContent. Everything that moves - stacking, the enter/exit
    and hover-to-expand animations, swipe-to-dismiss and the auto-close timers - is owned by
    ts/toast.ts, which this component drives by calling `sync()` after every render and which calls
    back `Remove` (the only path that drops a toast) once a toast has finished animating out.

    The <li> deliberately does NOT render `style` or the engine-owned data-attributes (data-mounted,
    data-removed, data-expanded, data-front, …): those are written by the engine, and Blazor only
    patches attributes it set itself, so the two never fight over the same node.
*@

<section data-bz-toaster-root
         aria-label="@AriaLabel"
         tabindex="-1"
         aria-live="polite"
         aria-relevant="additions text"
         aria-atomic="false"
         class="@Class"
         style="@Style"
         @ref="_root">
    @foreach (var position in Positions())
    {
        var toasts = ToastsAt(position);
        if (toasts.Count == 0) continue;

        <ol class="@ListClass"
            data-bz-toaster
            dir="@ResolvedDirection.ToAttribute()"
            data-y-position="@position.Y()"
            data-x-position="@position.X()"
            data-bz-visible-toasts="@VisibleToasts"
            @key="position">
            @foreach (var instance in toasts)
            {
                var data = instance.Data;
                var richColors = data.RichColors ?? DefaultRichColors;
                var closeButton = (data.CloseButton ?? DefaultCloseButton) && data.Type != ToastType.Loading;

                <li class="@ToastClass"
                    data-bz-toast
                    data-bz-toast-id="@instance.Id"
                    data-bz-toast-type="@TypeAttribute(data.Type)"
                    data-bz-toast-duration="@DurationAttribute(data)"
                    data-y-position="@position.Y()"
                    data-x-position="@position.X()"
                    data-dismissible="@(data.Dismissible ? "true" : "false")"
                    data-styled="true"
                    data-rich-colors="@(richColors ? "true" : "false")"
                    data-bz-toast-dismiss="@(instance.DismissRequested ? "true" : null)"
                    tabindex="0"
                    @key="instance.Id">
                    @ChildContent(new ToastRenderContext(instance, closeButton, richColors))
                </li>
            }
        </ol>
    }
</section>

@code {
    /// <summary>The default corner for toasts that don't set their own position. Defaults to <see cref="ToastPosition.BottomRight"/>.</summary>
    [Parameter] public ToastPosition Position { get; set; } = ToastPosition.BottomRight;

    /// <summary>How many toasts are fully visible before the rest collapse behind the stack. Defaults to <c>3</c>.</summary>
    [Parameter] public int VisibleToasts { get; set; } = 3;

    /// <summary>The default auto-close duration for toasts that don't set their own. Defaults to 4 seconds.</summary>
    [Parameter] public TimeSpan DefaultDuration { get; set; } = TimeSpan.FromSeconds(4);

    /// <summary>Whether toasts show a corner close button by default (toasts can override). Defaults to <see langword="false"/>.</summary>
    [Parameter] public bool DefaultCloseButton { get; set; }

    /// <summary>Whether toasts are filled with their type colour by default (toasts can override). Defaults to <see langword="false"/>.</summary>
    [Parameter] public bool DefaultRichColors { get; set; }

    /// <summary>Accessible label for the live region. Defaults to "Notifications".</summary>
    [Parameter] public string AriaLabel { get; set; } = "Notifications";

    /// <summary>Class for each <c>&lt;ol&gt;</c> stack (the styled layer's toaster skin).</summary>
    [Parameter] public string? ListClass { get; set; }

    /// <summary>Class for each <c>&lt;li&gt;</c> toast (the styled layer's toast skin).</summary>
    [Parameter] public string? ToastClass { get; set; }

    /// <summary>Renders the inner content of each toast (icon, title, description, buttons, close).</summary>
    [Parameter] public RenderFragment<ToastRenderContext> ChildContent { get; set; } = default!;

    private ElementReference _root;
    private IJSObjectReference? _module;
    private IJSObjectReference? _instance;
    private DotNetObjectReference<BzToaster>? _selfRef;

    protected override void OnInitialized() => Store.Changed += OnStoreChanged;

    private void OnStoreChanged() => InvokeAsync(StateHasChanged);

    // Effective position of a toast: its own override, else the toaster default.
    private ToastPosition EffectivePosition(ToastInstance instance) => instance.Data.Position ?? Position;

    // The corners that currently hold at least one toast, in a stable order (default corner first).
    private IEnumerable<ToastPosition> Positions() =>
        Store.Toasts.Select(EffectivePosition).Distinct().OrderByDescending(p => p == Position);

    // Newest-first within a corner, so child index 0 is the front toast (matches the engine's layout).
    private List<ToastInstance> ToastsAt(ToastPosition position)
    {
        var list = Store.Toasts.Where(t => EffectivePosition(t) == position).ToList();
        list.Reverse();
        return list;
    }

    private static string TypeAttribute(ToastType type) => type switch
    {
        ToastType.Success => "success",
        ToastType.Info => "info",
        ToastType.Warning => "warning",
        ToastType.Error => "error",
        ToastType.Loading => "loading",
        _ => "normal",
    };

    // Loading toasts (and explicitly-persistent ones) never auto-close; otherwise emit the duration in ms.
    private string DurationAttribute(ToastData data)
    {
        var persistent = data.Persistent
            || (data.Type == ToastType.Loading && data.Duration is null)
            || data.Duration == TimeSpan.MaxValue;
        if (persistent) return "infinity";
        var duration = data.Duration ?? DefaultDuration;
        return ((int)duration.TotalMilliseconds).ToString(System.Globalization.CultureInfo.InvariantCulture);
    }

    /// <summary>Called by ts/toast.ts once a toast has finished animating out - the sole removal path.</summary>
    [JSInvokable]
    public void Remove(string id, bool autoClose) => Store.NotifyRemoved(id, autoClose);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            _module = await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Blazeo.Base/dist/toast.js");
            _instance = await _module.InvokeAsync<IJSObjectReference>("createToaster", _root, _selfRef);
        }

        // Every render reconciles the engine with the toasts Blazor just rendered (adds run their
        // enter animation, C#-requested dismissals start their exit, content/duration changes apply).
        if (_instance is not null) await _instance.InvokeVoidAsync("sync");
    }

    public void Dispose() => Store.Changed -= OnStoreChanged;

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_instance is not null)
            {
                await _instance.InvokeVoidAsync("dispose");
                await _instance.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone (navigation / refresh) - nothing to clean up.
        }

        _selfRef?.Dispose();
    }
}
