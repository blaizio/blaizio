@namespace Blazeo
@inherits BzComponentBase
@*
    The button that flips a BaseCollapsible: a native
    <button type="button"> with aria-expanded + aria-controls + data-state. AsChild lets it wrap
    your own element (e.g. a styled Button).
*@

<BasePrimitive As="button"
                Attributes="@BuildAttributes()"
                ChildContent="@ChildContent"
                AsChild="@AsChild" />

@code {
    /// <summary>Trigger content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the behaviour onto your own element instead of a <c>&lt;button&gt;</c>.</summary>
    [Parameter] public RenderFragment<BzRenderProps>? AsChild { get; set; }

    [CascadingParameter] private CollapsibleContext? Collapsible { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var open = Collapsible?.Open ?? false;
        var disabled = Collapsible?.Disabled ?? false;
        var props = new PropBuilder(this)
            .Aria("expanded", open)
            .Aria("controls", Collapsible?.ContentId)
            .Data("state", open ? "open" : "closed")
            .On("onclick", EventCallback.Factory.Create(this, OnClickAsync));

        if (AsChild is null) props.Set("type", "button").Flag("disabled", disabled);
        else if (disabled) props.Aria("disabled", true);
        if (disabled) props.Data("disabled", "");

        return props.Merge(Attributes, Class, Style);
    }

    private Task OnClickAsync() =>
        Collapsible is null || Collapsible.Disabled ? Task.CompletedTask : Collapsible.Toggle.InvokeAsync();
}
