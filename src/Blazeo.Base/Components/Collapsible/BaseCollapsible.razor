@namespace Blazeo
@inherits BzComponentBase
@*
    An expandable section: a container owning the open state,
    cascaded to BaseCollapsibleTrigger / BaseCollapsibleContent. Controllable via
    Open/DefaultOpen/OpenChanged (use @bind-Open). data-state "open"/"closed" is the styling hook.
*@

<CascadingValue Value="@Context" IsFixed="false">
    <BasePrimitive As="div" Attributes="@BuildAttributes()" ChildContent="@ChildContent" />
</CascadingValue>

@code {
    /// <summary>Controlled open state. Leave <see langword="null"/> for uncontrolled.</summary>
    [Parameter] public bool? Open { get; set; }

    /// <summary>Initial state when uncontrolled.</summary>
    [Parameter] public bool DefaultOpen { get; set; }

    /// <summary>Raised with the new state. Enables <c>@bind-Open</c>.</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Blocks toggling (and conveys the state on the trigger).</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>The trigger and content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string _contentId = default!;
    private readonly ControllableState<bool> _state = new();

    private CollapsibleContext Context =>
        new(_state.Value, Disabled, _contentId, EventCallback.Factory.Create(this, ToggleAsync));

    protected override void OnInitialized() => _contentId = $"{Identifier.Create("collapsible")}-content";

    protected override void OnParametersSet() =>
        _state.Sync(Open.HasValue, Open ?? false, DefaultOpen);

    private Task ToggleAsync() =>
        Disabled ? Task.CompletedTask : _state.SetAsync(!_state.Value, OpenChanged);

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder().Data("state", _state.Value ? "open" : "closed");
        if (Disabled) props.Data("disabled", "");
        return props.Merge(Attributes, Class, Style);
    }
}
