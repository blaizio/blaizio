<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>Blazeo</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Blazeo.Base</PackageId>
    <Title>Blazeo.Base</Title>
    <Description>Headless, unstyled Blazor UI primitives - behavior, accessibility (ARIA) and a data-state contract only. The unopinionated foundation for the Blazeo component framework (the headless primitives layer).</Description>
    <Version>0.1.0-alpha.1</Version>
    <PackageTags>blazor;components;headless;primitives;accessibility</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.2" />
  </ItemGroup>

  <!-- The test project reaches internal mechanism members (e.g. DialogInstance.NotifyExited). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Blazeo.Base.Tests" />
  </ItemGroup>

  <!-- Keep the JS toolchain (lib/) out of compilation AND publish: its package.json etc. otherwise
       collide with the docs' own lib/ files in the publish output (NETSDK1152). The build targets
       below read lib/ via direct paths / custom items, so excluding it from None/Content is safe. -->
  <ItemGroup>
    <Compile Remove="lib\**" />
    <Content Remove="lib\**" />
    <None Remove="lib\**" />
  </ItemGroup>

  <!--
    Bundle lib/ts/ -> wwwroot/dist before static web assets are collected, so the .js modules are
    packaged and resolvable at _content/Blazeo.Base/dist/*.js. Incremental via Inputs/Outputs.
    Skipped (with a warning) when lib/node_modules is absent so a no-Node build still works off the
    committed wwwroot/dist.
  -->
  <ItemGroup>
    <BlazeoTypeScript Include="lib\ts\**\*.ts" />
  </ItemGroup>

  <Target Name="BuildBlazeoScripts"
          BeforeTargets="BeforeBuild;ResolveStaticWebAssetsInputs"
          Condition="Exists('$(MSBuildProjectDirectory)\lib\node_modules')"
          Inputs="@(BlazeoTypeScript);lib\build.mjs"
          Outputs="$(MSBuildProjectDirectory)\wwwroot\dist\.stamp">
    <Exec Command="node build.mjs" WorkingDirectory="$(MSBuildProjectDirectory)\lib" />
    <Touch Files="$(MSBuildProjectDirectory)\wwwroot\dist\.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="WarnMissingBlazeoNodeModules"
          BeforeTargets="BeforeBuild"
          Condition="!Exists('$(MSBuildProjectDirectory)\lib\node_modules') AND Exists('$(MSBuildProjectDirectory)\lib\package.json')">
    <Warning Text="Blazeo.Base: lib/node_modules missing - run 'pnpm install' then 'pnpm build' in the lib folder to regenerate wwwroot/dist (using committed dist if present)." />
  </Target>

</Project>
