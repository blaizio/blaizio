@namespace Blazeo
@inject IJSRuntime Js
@implements IAsyncDisposable
@*
    A renderless global hotkey: invokes OnTrigger when the combo is pressed anywhere on the page.
    Combo syntax: "+"-joined parts, e.g. "mod+k" - modifiers (mod | ctrl | meta | alt | shift) plus
    one key; "mod" is the platform primary modifier (⌘ on mac, Ctrl elsewhere). Behaviour lives in
    ts/hotkeys.ts (callback interop, like FocusScope).
*@

@code {
    /// <summary>The key combo, e.g. <c>"mod+k"</c> or <c>"shift+/"</c>. Registered once, on first render.</summary>
    [Parameter] public string Combo { get; set; } = default!;

    /// <summary>Raised when the combo is pressed.</summary>
    [Parameter] public EventCallback OnTrigger { get; set; }

    /// <summary>Swallow the browser's default for the combo. Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool PreventDefault { get; set; } = true;

    /// <summary>Temporarily ignore presses without unregistering.</summary>
    [Parameter] public bool Disabled { get; set; }

    private IJSObjectReference? _module;
    private IJSObjectReference? _instance;
    private DotNetObjectReference<BzHotkey>? _selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || string.IsNullOrEmpty(Combo)) return;

        _selfRef = DotNetObjectReference.Create(this);
        _module = await Js.InvokeAsync<IJSObjectReference>(
            "import", "./_content/Blazeo.Base/dist/hotkeys.js");
        _instance = await _module.InvokeAsync<IJSObjectReference>(
            "createHotkey", Combo, _selfRef, PreventDefault);
    }

    [JSInvokable]
    public Task OnHotkey() => Disabled ? Task.CompletedTask : OnTrigger.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_instance is not null)
            {
                await _instance.InvokeVoidAsync("dispose");
                await _instance.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone - nothing to clean up.
        }

        _selfRef?.Dispose();
    }
}
