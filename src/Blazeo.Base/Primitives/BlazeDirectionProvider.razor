@namespace Blazeo
@*
    Cascades a reading direction (LTR/RTL) to every Blazeo primitive beneath it.
    Primitives read it via BlazeComponentBase.CascadedDirection / ResolvedDirection.
    Mirrors Radix's DirectionProvider.
*@

<CascadingValue Value="@Direction" Name="@CascadeName" IsFixed="false">
    @ChildContent
</CascadingValue>

@code {
    /// <summary>The well-known cascade name primitives subscribe to. Internal contract — not user-facing.</summary>
    public const string CascadeName = "BlazeDirection";

    /// <summary>The reading direction to apply to the subtree. Defaults to <see cref="Blazeo.Direction.Ltr"/>.</summary>
    [Parameter] public Direction Direction { get; set; } = Direction.Ltr;

    /// <summary>The subtree that inherits this direction.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
