@namespace Blazeo
@inherits BlazeComponentBase
@inject IJSRuntime Js
@implements IAsyncDisposable
@*
    Traps and/or loops keyboard focus within its container — the focus-management half of every
    overlay (Dialog, Popover, Menu). Pairs with DismissableLayer (Esc / outside-click), which is a
    separate primitive. Behaviour lives in ts/focusScope.ts; this is the thin Blazor wrapper.
*@

<BlazePrimitive As="div"
                Attributes="@BuildAttributes()"
                ElementRefCaptured="@OnRefCaptured">
    @ChildContent
</BlazePrimitive>

@code {
    /// <summary>Content whose focus is managed.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Forwards the container's element reference (e.g. for presence tracking on the same element).</summary>
    [Parameter] public Action<ElementReference>? ElementRefCaptured { get; set; }

    /// <summary>Tab past the last tabbable wraps to the first (and vice-versa). Defaults to <see langword="false"/>.</summary>
    [Parameter] public bool Loop { get; set; }

    /// <summary>Focus cannot leave the container by keyboard, pointer, or script. Defaults to <see langword="false"/>.</summary>
    [Parameter] public bool Trapped { get; set; }

    /// <summary>Raised before auto-focusing on mount. <see cref="FocusScopeEvent.PreventDefault"/> to handle focus yourself.</summary>
    [Parameter] public EventCallback<FocusScopeEvent> OnMountAutoFocus { get; set; }

    /// <summary>Raised before restoring focus on unmount. <see cref="FocusScopeEvent.PreventDefault"/> to handle focus yourself.</summary>
    [Parameter] public EventCallback<FocusScopeEvent> OnUnmountAutoFocus { get; set; }

    private ElementReference _container;
    private IJSObjectReference? _module;
    private IJSObjectReference? _scope;
    private DotNetObjectReference<BlazeFocusScope>? _selfRef;

    // tabindex="-1" lets the container itself hold focus when nothing inside is tabbable.
    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder().Set("tabindex", "-1").Merge(Attributes, Class, Style);

    private void OnRefCaptured(ElementReference reference)
    {
        _container = reference;
        ElementRefCaptured?.Invoke(reference);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _module = await Js.InvokeAsync<IJSObjectReference>(
            "import", "./_content/Blazeo.Base/dist/focusScope.js");
        _selfRef = DotNetObjectReference.Create(this);
        _scope = await _module.InvokeAsync<IJSObjectReference>("createFocusScope", _container, _selfRef, new
        {
            loop = Loop,
            trapped = Trapped,
            hasMountAutoFocus = OnMountAutoFocus.HasDelegate,
            hasUnmountAutoFocus = OnUnmountAutoFocus.HasDelegate,
        });
    }

    [JSInvokable]
    public async Task<bool> HandleMountAutoFocus()
    {
        var args = new FocusScopeEvent();
        await OnMountAutoFocus.InvokeAsync(args);
        return args.DefaultPrevented;
    }

    [JSInvokable]
    public async Task<bool> HandleUnmountAutoFocus()
    {
        var args = new FocusScopeEvent();
        await OnUnmountAutoFocus.InvokeAsync(args);
        return args.DefaultPrevented;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_scope is not null)
            {
                await _scope.InvokeVoidAsync("dispose");
                await _scope.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone (navigation / refresh) — nothing to clean up.
        }
        _selfRef?.Dispose();
    }
}
