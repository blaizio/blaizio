@namespace Blazeo
@*
    Renders a Tabler icon. `Icon` is an `Icon` value from the generated `Icons` class (e.g.
    `Icons.Outline.Plus`); it carries its family (outline → stroked, filled → filled) so a single
    value is self-describing. Size it with a CSS class (e.g. Tailwind `size-4`); it inherits colour
    via `currentColor`.

    Enhanced over ArcBlazor's ArcIcon: self-contained (no Tailwind/base dependency), dropped the
    icon-font branch, Tabler's true default stroke width (2), and aria-hidden only when untitled.
*@

<svg xmlns="http://www.w3.org/2000/svg"
     width="24" height="24" viewBox="@ViewBox"
     fill="@_fill" stroke="@_stroke"
     stroke-width="@_strokeWidth" stroke-linecap="@_lineCap" stroke-linejoin="@_lineCap"
     focusable="false" role="img" aria-hidden="@(Title is null ? "true" : null)"
     class="@Class" style="@Style" @attributes="Attributes">
    @if (Title is not null)
    {
        <title>@Title</title>
    }
    @_content
</svg>

@code {
    /// <summary>The icon to render, e.g. <c>Icons.Outline.Plus</c>. The <see langword="default"/> value renders nothing.</summary>
    [Parameter] public Icon Icon { get; set; }

    /// <summary>CSS classes (size it here, e.g. <c>size-5</c>).</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Inline styles.</summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>Accessible title. When set, renders a <c>&lt;title&gt;</c> and drops <c>aria-hidden</c>.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Stroke width for outline icons. Tabler's default is <c>2</c>.</summary>
    [Parameter] public float StrokeWidth { get; set; } = 2f;

    /// <summary>SVG view box. Tabler icons are <c>0 0 24 24</c>.</summary>
    [Parameter] public string ViewBox { get; set; } = "0 0 24 24";

    /// <summary>Any other attributes, splatted onto the <c>&lt;svg&gt;</c>.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private MarkupString _content;
    private string _fill = "none";
    private string? _stroke = "currentColor";
    private string? _strokeWidth;
    private string? _lineCap;

    protected override void OnParametersSet()
    {
        // Local copy disambiguates the property from the same-named Icon type and reads it once.
        var icon = Icon;
        if (string.IsNullOrEmpty(icon.Body))
        {
            _content = default;
            return;
        }

        if (icon.Kind == IconKind.Outline)
        {
            _fill = "none";
            _stroke = "currentColor";
            _strokeWidth = StrokeWidth.ToString(System.Globalization.CultureInfo.InvariantCulture);
            _lineCap = "round";
        }
        else
        {
            _fill = "currentColor";
            _stroke = null;
            _strokeWidth = null;
            _lineCap = null;
        }

        _content = (MarkupString)icon.Body;
    }
}
