<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>Blazeo</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Blazeo.Icons</PackageId>
    <Title>Blazeo.Icons</Title>
    <Description>Tabler icons for Blazeo as a tiny, tree-shakeable Blazor SVG component. Path data is generated by scripts/Update-BlazeIcons.ps1.</Description>
    <Version>0.1.0-alpha.1</Version>
    <PackageTags>blazor;icons;tabler;svg</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.2" />
  </ItemGroup>

</Project>
