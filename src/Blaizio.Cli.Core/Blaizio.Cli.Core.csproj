<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Blaizio.Cli.Core</RootNamespace>
    <!-- Shared engine: registry client, resolver, rewriter, config. Reused by the CLI and
         by IDE plugins that can reference .NET directly (Visual Studio VSIX). -->
    <IsPackable>true</IsPackable>
    <PackageId>Blaizio.Cli.Core</PackageId>
    <Title>Blaizio.Cli.Core</Title>
    <Description>Core engine for the Blaizio CLI: registry client, dependency resolver, namespace rewriter and project configuration. Consumed by the blaizio dotnet tool and IDE integrations.</Description>
    <Version>0.1.0-alpha.10</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- The test project reaches internal test seams (e.g. StandalonePipeline's hermetic ctor). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Blaizio.Cli.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The v3 inliner merges shared+skin @apply lists with the same semantics the components
         use at runtime (Tw.Merge), so the baked class strings resolve conflicts identically. -->
    <PackageReference Include="TailwindMerge.NET" Version="1.4.0" />
  </ItemGroup>

</Project>
