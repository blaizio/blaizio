@namespace Blaizio.Ui
@*
    Styled PopoverDescription - muted helper text under the title. Wraps the headless
    BasePopoverDescription, so the content's aria-describedby points here automatically while
    this is rendered.
*@

<BasePopoverDescription Class="@Tw.Merge(BaseClasses, Class)" Attributes="ForwardedAttributes()">
    @ChildContent
</BasePopoverDescription>

@code {
    private const string BaseClasses = "bz-popover-description text-muted-foreground text-sm";

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Description text.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder()
            .Data("slot", "popover-description")
            .Merge(Attributes);
}
