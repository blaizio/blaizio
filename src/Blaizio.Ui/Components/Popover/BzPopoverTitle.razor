@namespace Blaizio.Ui
@*
    Styled PopoverTitle - the panel's accessible name. Wraps the headless BasePopoverTitle, so the
    content's aria-labelledby points here automatically while this is rendered.
*@

<BasePopoverTitle Element="h4" Class="@Tw.Merge(BaseClasses, Class)" Attributes="ForwardedAttributes()">
    @ChildContent
</BasePopoverTitle>

@code {
    private const string BaseClasses = "bz-popover-title bz-font-heading text-sm leading-none font-medium";

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Title text.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder()
            .Data("slot", "popover-title")
            .Merge(Attributes);
}
