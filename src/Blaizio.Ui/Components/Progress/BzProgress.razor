@namespace Blaizio.Ui
@*
    Styled Progress - wraps the headless BaseProgress (the track) and BaseProgressIndicator (the fill)
    and applies the new-york v4 design's Tailwind classes verbatim. The fill is translated left by the
    remaining percentage (transform: translateX(-(100 - value)%)), so it reveals exactly Value/Max of the
    track and animates via transition-all. data-slot is injected here (a styling-layer concern).
*@

<BaseProgress Value="@(Indeterminate ? null : Value)"
               Max="@Max"
               Class="@Tw.Merge(TrackClasses, Class)"
               Attributes="@ForwardedAttributes()">
    <BaseProgressIndicator Class="@(Indeterminate ? IndeterminateIndicatorClasses : IndicatorClasses)"
                            Style="@IndicatorStyle()"
                            Attributes="@_indicatorAttributes" />
</BaseProgress>

@code {
    /// <summary>The current value. <see langword="null"/> renders an empty track.</summary>
    [Parameter] public double? Value { get; set; }

    /// <summary>The maximum value (the 100% point). Defaults to <c>100</c>.</summary>
    [Parameter] public double Max { get; set; } = 100;

    /// <summary>
    /// Work of unknown length: the fill becomes an endless sweeping band (mirrored under RTL) and
    /// <see cref="Value"/> is ignored until you switch back.
    /// </summary>
    [Parameter] public bool Indeterminate { get; set; }

    /// <summary>Semantic fill color. Defaults to <see cref="StatusColor.Default"/> (primary).</summary>
    [Parameter] public StatusColor Color { get; set; } = StatusColor.Default;

    /// <summary>Extra classes, merged over the track defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the track element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private static readonly IReadOnlyDictionary<string, object> _indicatorAttributes =
        new PropBuilder().Data("slot", "progress-indicator").Merge(null);

    private IReadOnlyDictionary<string, object> ForwardedAttributes()
    {
        var props = new PropBuilder().Data("slot", "progress");
        if (Indeterminate) props.Data("indeterminate", "");
        if (Color != StatusColor.Default) props.Data("color", Color.GetDescription());
        return props.Merge(Attributes);
    }

    private double EffectiveMax => Max > 0 ? Max : 100;
    private double Percent => Value is null ? 0 : Math.Clamp(Value.Value, 0, EffectiveMax) / EffectiveMax * 100;

    private string? IndicatorStyle() => Indeterminate
        ? null
        : $"transform:translateX(-{(100 - Percent).ToString(System.Globalization.CultureInfo.InvariantCulture)}%)";

    private const string TrackClasses =
        "bz-progress relative flex w-full items-center overflow-x-hidden";

    private const string IndicatorClasses =
        "bz-progress-indicator size-full flex-1 transition-all";

    // A 40%-wide band sweeping the track (keyframes in blaizio.css); RTL runs the sweep backwards.
    private const string IndeterminateIndicatorClasses =
        "bz-progress-indicator h-full w-2/5 animate-progress-indeterminate rtl:[animation-direction:reverse]";
}
