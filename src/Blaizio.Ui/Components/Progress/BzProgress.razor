@namespace Blaizio.Ui
@*
    Styled Progress - wraps the headless BaseProgress (the track) and BaseProgressIndicator (the fill)
    and applies the new-york v4 design's Tailwind classes verbatim. The fill is translated along the
    main axis by the remaining percentage, published as the --bz-progress-remaining custom property so
    the direction stays a CSS concern: LTR pulls the fill left, RTL pushes it right (the ltr:/rtl:
    variants flip the sign), and vertical pushes it down (bottom-up fill). The overflow-hidden track
    clips whatever is translated out; transition-all animates between values. data-slot is injected
    here (a styling-layer concern). ChildContent overlays the track - the place for an inline label.
*@

<BaseProgress Value="@(Indeterminate ? null : Value)"
               Max="@Max"
               Orientation="@Orientation"
               Class="@Tw.Merge(TrackClasses, Class)"
               Attributes="ForwardedAttributes()">
    @* Parent-owned fill: same markup a BaseProgressIndicator renders (data-state/value/max for the
       skins), minus the cascade and the extra component instance. Rendered before ChildContent so
       an overlay label sits above it. *@
    <Indicator Context="ctx">
        <div data-slot="progress-indicator"
             data-state="@(ctx.Value is null ? "indeterminate" : ctx.Value.Value >= ctx.Max ? "complete" : "loading")"
             data-max="@Fmt(ctx.Max)"
             data-value="@(ctx.Value is null ? null : Fmt(ctx.Value.Value))"
             class="@IndicatorClasses"
             style="@IndicatorStyle()"></div>
    </Indicator>
    <ChildContent>
        @ChildContent
    </ChildContent>
</BaseProgress>

@code {
    /// <summary>The current value. <see langword="null"/> renders an empty track.</summary>
    [Parameter] public double? Value { get; set; }

    /// <summary>The maximum value (the 100% point). Defaults to <c>100</c>.</summary>
    [Parameter] public double Max { get; set; } = 100;

    /// <summary>
    /// Work of unknown length: the fill becomes an endless sweeping band (mirrored under RTL,
    /// top-to-bottom when vertical) and <see cref="Value"/> is ignored until you switch back.
    /// </summary>
    [Parameter] public bool Indeterminate { get; set; }

    /// <summary>Layout axis. Vertical bars fill bottom-up. Defaults to <see cref="Blaizio.Orientation.Horizontal"/>.</summary>
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Horizontal;

    /// <summary>Semantic fill color. Defaults to <see cref="StatusColor.Default"/> (primary).</summary>
    [Parameter] public StatusColor Color { get; set; } = StatusColor.Default;

    /// <summary>
    /// Overlay content rendered on the track above the fill - position it against the relative
    /// track (e.g. <c>absolute inset-0</c>) for an inline value label.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Extra classes, merged over the track defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the track element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private static string Fmt(double d) => d.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private IReadOnlyDictionary<string, object> ForwardedAttributes()
    {
        var props = new PropBuilder().Data("slot", "progress");
        if (Indeterminate) props.Data("indeterminate", "");
        if (Color != StatusColor.Default) props.Data("color", Color.GetDescription());
        return props.Merge(Attributes);
    }

    private bool Vertical => Orientation == Orientation.Vertical;

    private double EffectiveMax => Max > 0 ? Max : 100;
    private double Percent => Value is null ? 0 : Math.Clamp(Value.Value, 0, EffectiveMax) / EffectiveMax * 100;

    private string? IndicatorStyle() => Indeterminate
        ? null
        : $"--bz-progress-remaining:{(100 - Percent).ToString(System.Globalization.CultureInfo.InvariantCulture)}%";

    private string TrackClasses => Vertical
        ? "bz-progress relative flex h-full min-h-40 flex-col justify-center overflow-hidden"
        : "bz-progress relative flex w-full items-center overflow-hidden";

    private string IndicatorClasses => (Indeterminate, Vertical) switch
    {
        // A 40%-long fill band sweeping the track (keyframes in blaizio.css); RTL runs the sweep backwards.
        (true, false) => "bz-progress-indicator h-full w-2/5 animate-progress-indeterminate rtl:[animation-direction:reverse]",
        (true, true) => "bz-progress-indicator w-full h-2/5 animate-progress-indeterminate-vertical",
        // Determinate: slide the full-size fill out by the remaining percentage, direction-aware.
        (false, true) => "bz-progress-indicator size-full flex-1 transition-all translate-y-(--bz-progress-remaining)",
        (false, false) => "bz-progress-indicator size-full flex-1 transition-all ltr:-translate-x-(--bz-progress-remaining) rtl:translate-x-(--bz-progress-remaining)",
    };
}
