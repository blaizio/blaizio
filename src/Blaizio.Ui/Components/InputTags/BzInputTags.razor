@namespace Blaizio.Ui
@inject ICore Core
@*
    Styled tags input - free-text tokens in one bordered field, no suggestion list (want suggestions?
    that is a Multiple BzCombobox). One convenient control like BzInputText: type and press Enter (or a
    delimiter - comma by default) to commit a chip, Backspace on empty text to remove the newest, click a
    chip's X to drop it; pasted "a, b, c" splits into three. Bind the tags with @bind-Values. The border /
    focus ring is the skin's `.bz-input-tags`. Validation-agnostic: pair with Field / FieldControl for
    forms (forwarded attributes - id, aria-* - land on the inner input).
*@

<BaseInputTags Values="@Values"
               ValuesChanged="@ValuesChanged"
               DefaultValues="@DefaultValues"
               Search="@Search"
               DefaultSearch="@DefaultSearch"
               SearchChanged="@SearchChanged"
               Delimiters="@Delimiters"
               AllowDuplicates="@AllowDuplicates"
               MaxTags="@MaxTags"
               Disabled="@Disabled"
               ReadOnly="@ReadOnly"
               Label="@Label"
               Class="@Tw.Merge(BoxClasses, Class)"
               Attributes="RootAttributes()">
    <BzInputTagsChips ChipContent="@ChipContent"
                      ShowRemove="@ShowRemove"
                      Placeholder="@Placeholder"
                      InputAttributes="@Attributes" />
</BaseInputTags>

@code {
    /// <summary>The committed tags. Use with <c>@bind-Values</c>.</summary>
    [Parameter] public IReadOnlyList<string>? Values { get; set; }

    /// <summary>Raised with the new tags whenever one is added or removed. Enables <c>@bind-Values</c>.</summary>
    [Parameter] public EventCallback<IReadOnlyList<string>> ValuesChanged { get; set; }

    /// <summary>Initial tags when uncontrolled.</summary>
    [Parameter] public IReadOnlyList<string>? DefaultValues { get; set; }

    /// <summary>Controlled in-progress text (the tag being typed). Bind with <c>@bind-Search</c>.</summary>
    [Parameter] public string? Search { get; set; }

    /// <summary>Initial in-progress text when uncontrolled.</summary>
    [Parameter] public string DefaultSearch { get; set; } = "";

    /// <summary>Raised with the new text on every keystroke. Enables <c>@bind-Search</c>.</summary>
    [Parameter] public EventCallback<string?> SearchChanged { get; set; }

    /// <summary>Keys that commit the typed text in addition to Enter (also split pasted text). Defaults to comma.</summary>
    [Parameter] public IReadOnlyList<string>? Delimiters { get; set; }

    /// <summary>Allow the same tag twice. Defaults to <see langword="false"/>.</summary>
    [Parameter] public bool AllowDuplicates { get; set; }

    /// <summary>Most tags the field accepts. Omit for unlimited.</summary>
    [Parameter] public int? MaxTags { get; set; }

    /// <summary>Disables the field.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Show the tags but block adding and removing.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Accessible label for the input (use when there is no visible label).</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Placeholder shown in the free-typing area.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Show each chip's remove button. Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool ShowRemove { get; set; } = true;

    /// <summary>Custom chip label content, given the tag's text. Omit to render the text itself.</summary>
    [Parameter] public RenderFragment<string>? ChipContent { get; set; }

    /// <summary>Extra classes, merged over the field defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Focus the field (its text entry, after the chips) when it appears - works for Blazor-rendered and late-mounted markup, unlike native <c>autofocus</c>. See <see cref="BzInputText.AutoFocus"/>.</summary>
    [Parameter] public bool AutoFocus { get; set; }

    /// <summary>Any other attributes (id, name, aria-*, …), forwarded to the inner input.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    // The autofocus guard descends from the field to its text entry (chip remove buttons are
    // plain <button>s, which the guard's descent skips).
    private IReadOnlyDictionary<string, object> RootAttributes()
    {
        var props = new PropBuilder().Data("slot", "input-tags");
        if (AutoFocus) props.Data("bz-autofocus", "");
        return props.Merge(null);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !AutoFocus) return;
        try
        {
            await Core.EnsureGuardsAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit went away mid-render - nothing left to focus.
        }
    }

    private const string BoxClasses =
        "bz-input-tags w-full data-disabled:pointer-events-none data-disabled:cursor-not-allowed data-disabled:opacity-50";
}
