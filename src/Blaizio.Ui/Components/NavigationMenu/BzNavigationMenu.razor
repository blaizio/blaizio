@namespace Blaizio.Ui
@*
    Styled navigation menu root - wraps the headless BaseNavigationMenu and supplies the morphing
    viewport's look. Compose a BzNavigationMenuList with items inside. With Viewport off (the default is
    on) each content drops inline under its item instead of into the shared viewport.
*@

<BaseNavigationMenu Value="@Value"
                    ValueChanged="@ValueChanged"
                    DefaultValue="@DefaultValue"
                    Viewport="@Viewport"
                    OpenDelay="@OpenDelay"
                    CloseDelay="@CloseDelay"
                    Class="@Tw.Merge("bz-navigation-menu group/navigation-menu relative flex max-w-max flex-1 items-center justify-center self-start", Class)"
                    ViewportWrapperClass="absolute top-full left-0 isolate z-50 flex justify-center"
                    ViewportClass="@ViewportClasses"
                    Attributes="@Attributes">
    @ChildContent
</BaseNavigationMenu>

@code {
    /// <summary>Controlled open item id ("" = none). Use with <c>@bind-Value</c>.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Raised with the new open item id. Enables <c>@bind-Value</c>.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Initial open item id when uncontrolled.</summary>
    [Parameter] public string? DefaultValue { get; set; }

    /// <summary>Use the shared morphing viewport (the default). Off drops content inline under each item.</summary>
    [Parameter] public bool Viewport { get; set; } = true;

    /// <summary>Milliseconds the pointer must rest on a trigger before the first open. Unset inherits <c>BlaizioOptions.NavigationMenu</c> (200 out of the box).</summary>
    [Parameter] public int? OpenDelay { get; set; }

    /// <summary>Milliseconds after leaving the menu before it closes. Unset inherits <c>BlaizioOptions.NavigationMenu</c> (150 out of the box).</summary>
    [Parameter] public int? CloseDelay { get; set; }

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The list.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the root.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private const string ViewportClasses =
        "bz-navigation-menu-viewport origin-top relative mt-1.5 h-[var(--bz-nav-vh)] w-full overflow-hidden rounded-md " +
        "border bg-popover text-popover-foreground shadow transition-[width,height] duration-200 ease-out md:w-[var(--bz-nav-vw)] " +
        "data-[state=open]:animate-in data-[state=open]:zoom-in-90 data-[state=closed]:animate-out data-[state=closed]:zoom-out-95";
}
