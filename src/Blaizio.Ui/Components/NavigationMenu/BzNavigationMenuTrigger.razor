@namespace Blaizio.Ui
@* The button that opens its item's content; adds the chevron that flips when open. *@

<BaseNavigationMenuTrigger Class="@Tw.Merge(NavigationMenuTriggerStyle.Classes, Class)"
                           RenderAs="@RenderAs"
                           Attributes="Attributes">
    @ChildContent
    <BzIcon Icon="@Icons.Outline.ChevronDown"
            Class="relative top-px ms-1 size-3 transition duration-300 group-data-[state=open]:rotate-180" />
</BaseNavigationMenuTrigger>

@code {
    /// <summary>Trigger label.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the trigger onto your own element instead of a <c>&lt;button&gt;</c>.</summary>
    [Parameter] public RenderFragment<BzRenderProps>? RenderAs { get; set; }

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }
}
