@namespace Blaizio.Ui
@* The row of menu items. Renders a <ul>. *@

<BasePrimitive Element="ul" Attributes="BuildAttributes()" ChildContent="@ChildContent" />

@code {
    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The items (and an optional indicator).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "navigation-menu-list")
            .Merge(Attributes, Tw.Merge("bz-navigation-menu-list group flex flex-1 list-none items-center justify-center gap-1", Class));
}
