@namespace Blaizio.Ui
@*
    Styled Alert - a callout for important messages. Renders role="alert". Structural utilities +
    bz-alert hooks; the active style sheet lays out the optional leading icon, title, description,
    and <BzAlertAction>. Compose with <BzAlertTitle>, <BzAlertDescription>, and optionally <BzAlertAction>.
*@

<BasePrimitive As="div" Attributes="BuildAttributes()" ChildContent="@ChildContent" />

@code {
    /// <summary>Visual style. Defaults to <see cref="AlertVariant.Default"/>.</summary>
    [Parameter] public AlertVariant Variant { get; set; } = AlertVariant.Default;

    /// <summary>Extra classes, merged over the variant defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Alert content - typically an icon, <c>AlertTitle</c>, and <c>AlertDescription</c>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Set("role", "alert")
            .Data("slot", "alert")
            .Merge(Attributes, Tw.Merge("bz-alert group/alert relative w-full", VariantClasses(Variant), Class));

    // One literal per value - the registry inliner substitutes each token with the skin's
    // utilities, which an interpolated class string would defeat.
    private static string VariantClasses(AlertVariant variant) => variant switch
    {
        AlertVariant.Accent => "bz-alert-variant-accent",
        AlertVariant.Destructive => "bz-alert-variant-destructive",
        AlertVariant.Success => "bz-alert-variant-success",
        AlertVariant.Warning => "bz-alert-variant-warning",
        AlertVariant.Info => "bz-alert-variant-info",
        _ => "bz-alert-variant-default",
    };
}
