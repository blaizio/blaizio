@namespace Blaizio.Ui
@*
    Styled CollapsibleTrigger. Use RenderAs to put the behaviour on a styled <BzButton>:

        <BzCollapsibleTrigger>
            <RenderAs Context="p"><BzButton Variant="ButtonVariant.Ghost" @attributes="p.Attributes">Toggle</BzButton></RenderAs>
        </BzCollapsibleTrigger>
*@

<BaseCollapsibleTrigger Class="@Class"
                         Attributes="@ForwardedAttributes()"
                         RenderAs="@RenderAs">
    @ChildContent
</BaseCollapsibleTrigger>

@code {
    /// <summary>Extra classes.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Trigger content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the behaviour onto your own element instead of a <c>&lt;button&gt;</c>.</summary>
    [Parameter] public RenderFragment<BzRenderProps>? RenderAs { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "collapsible-trigger").Merge(Attributes);
}
