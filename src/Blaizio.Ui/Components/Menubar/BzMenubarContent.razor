@namespace Blaizio.Ui
@*
    Styled MenubarContent - the floating menu surface over the headless BaseMenubarContent (which positions
    it via @floating-ui and manages focus, navigation, presence, and dismissal). Structural + animation
    utilities live here; the look (bg-popover, border, radius, padding, shadow, min-width) is the skin's
    `.bz-menubar-content` (which shares `.bz-dropdown-menu-content`).
*@

<BaseMenubarContent Class="@Tw.Merge(BaseClasses, Class)"
                     Side="@Side"
                     Align="@Align"
                     SideOffset="@SideOffset"
                     AlignOffset="@AlignOffset"
                     Inline="@Inline"
                     Attributes="ForwardedAttributes()">
    @ChildContent
</BaseMenubarContent>

@code {
    /// <summary>Preferred side of the trigger. Flips to stay in view. Defaults to <see cref="Blaizio.Side.Bottom"/>.</summary>
    [Parameter] public Side Side { get; set; } = Side.Bottom;

    /// <summary>Alignment along the trigger's edge. Defaults to <see cref="Blaizio.Align.Start"/>.</summary>
    [Parameter] public Align Align { get; set; } = Align.Start;

    /// <summary>Gap in pixels between the trigger and the content. Defaults to 8.</summary>
    [Parameter] public double SideOffset { get; set; } = 8;

    /// <summary>Offset in pixels along the alignment axis. Defaults to 0 (the menu lines up directly under its trigger).</summary>
    [Parameter] public double AlignOffset { get; set; }

    /// <summary>
    /// Render in place instead of portaling to the document body while open. Defaults to
    /// <see langword="false"/>: the surface moves to the body so no ancestor stacking context or
    /// overflow clip can cover it. Submenus always stay inside their parent surface and follow it.
    /// </summary>
    [Parameter] public bool Inline { get; set; }

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Menu content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    // Set by the surrounding modal surface (dialog/sheet/drawer) so this popup, which portals to
    // the body and is therefore a stacking SIBLING of that surface, paints above it instead of behind.
    [CascadingParameter(Name = OverlayLayer.CascadeName)] private OverlayLayer? Layer { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "menubar-content")
            .Set("style", OverlayLayer.PopupStyle(Layer))
            .Merge(Attributes);

    private const string BaseClasses =
        "bz-menubar-content fixed z-50 max-h-[var(--bz-available-height)] overflow-x-hidden overflow-y-auto " +
        "scrollbar-thin outline-none " +
        "data-open:animate-in data-closed:animate-out data-open:fade-in-0 data-closed:fade-out-0 " +
        "data-open:zoom-in-95 data-closed:zoom-out-95 " +
        "data-[side=top]:slide-in-from-bottom-2 data-[side=bottom]:slide-in-from-top-2 " +
        "data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2";
}
