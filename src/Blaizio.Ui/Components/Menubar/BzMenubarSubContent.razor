@namespace Blaizio.Ui
@*
    Styled MenubarSubContent - a submenu's floating panel. Same look as MenubarContent (the
    shared `.bz-menubar-content` skin); the headless layer anchors it to the inline-end of its
    trigger and flips it when it would overflow. Reuses the headless BaseDropdownMenuSubContent.
*@

<BaseDropdownMenuSubContent Class="@Tw.Merge(BaseClasses, Class)" Attributes="ForwardedAttributes()">
    @ChildContent
</BaseDropdownMenuSubContent>

@code {
    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Submenu content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    // Set by the surrounding modal surface (dialog/sheet/drawer) so this popup, which portals to
    // the body and is therefore a stacking SIBLING of that surface, paints above it instead of behind.
    [CascadingParameter(Name = OverlayLayer.CascadeName)] private OverlayLayer? Layer { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "menubar-sub-content")
            .Set("style", OverlayLayer.PopupStyle(Layer))
            .Merge(Attributes);

    private const string BaseClasses =
        "bz-menubar-content fixed z-50 max-h-[var(--bz-available-height)] overflow-x-hidden overflow-y-auto " +
        "scrollbar-thin outline-none " +
        "data-open:animate-in data-closed:animate-out data-open:fade-in-0 data-closed:fade-out-0 " +
        "data-open:zoom-in-95 data-closed:zoom-out-95 " +
        "data-[side=top]:slide-in-from-bottom-2 data-[side=bottom]:slide-in-from-top-2 " +
        "data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2";
}
