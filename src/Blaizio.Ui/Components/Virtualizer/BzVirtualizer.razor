@namespace Blaizio.Ui
@typeparam TItem
@using System.Globalization
@*
    BzVirtualizer<TItem> - mounts only the items whose vertical span intersects the viewport, so a list of
    thousands stays light in the DOM. It is the styled, item-aware face of the headless
    BaseWindowVirtualizer: hand it Items + an item template and it renders the two spacers and the visible
    slice for you. By default it virtualizes against the PAGE (no height cap); set MaxHeight to scroll
    inside a fixed-height box, or point Viewport at your own scroll container. Fixed-height items are
    placed by pure index math (fastest, scales to huge lists); set Dynamic to measure each item for
    variable heights. The item template's context is a VirtualItem<TItem> - render context.Item and
    spread context.Attributes on the item's root element (they carry the index marker + fixed-mode height).
    It is what BzDataTable<TItem> uses under the hood to virtualize its rows.
*@

@if (Scrollable)
{
    <div id="@_scrollId" data-slot="virtualizer-viewport" style="@ContainerStyle()">
        @RenderContent
    </div>
}
else
{
    @RenderContent
}

@code {
    /// <summary>The full list of items to virtualize.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<TItem> Items { get; set; } = [];

    /// <summary>
    /// The template for one item. Its context is a <see cref="VirtualItem{TItem}"/>: render
    /// <c>context.Item</c> and spread <c>context.Attributes</c> on the item's root element.
    /// </summary>
    [Parameter, EditorRequired] public RenderFragment<VirtualItem<TItem>>? ChildContent { get; set; }

    /// <summary>
    /// The spacer standing in for the off-screen items above and below the window; its context is the
    /// spacer height in pixels. Defaults to a plain <c>div</c> of that height - override it when the items
    /// live somewhere a <c>div</c> can't (e.g. a table body needs a <c>tr</c>/<c>td</c> spacer).
    /// </summary>
    [Parameter] public RenderFragment<double>? Spacer { get; set; }

    /// <summary>What to render when <see cref="Items"/> is empty. Optional.</summary>
    [Parameter] public RenderFragment? EmptyContent { get; set; }

    /// <summary>The element the items + spacers live in. Defaults to <c>div</c>; a table body passes <c>tbody</c>.</summary>
    [Parameter] public string As { get; set; } = "div";

    /// <summary>
    /// Item height in pixels: the exact uniform height in fixed mode (the default), or the estimate used
    /// until an item is measured in <see cref="Dynamic"/> mode. Defaults to <c>40</c>.
    /// </summary>
    [Parameter] public double ItemSize { get; set; } = 40;

    /// <summary>Measure each rendered item instead of assuming <see cref="ItemSize"/> - for variable-height items.</summary>
    [Parameter] public bool Dynamic { get; set; }

    /// <summary>Extra items to mount above and below the viewport, to cover fast scrolls. Defaults to <c>4</c>.</summary>
    [Parameter] public int Overscan { get; set; } = 4;

    /// <summary>
    /// CSS selector for an existing scroll container to track. Leave unset to virtualize against the
    /// window (no height restriction), or set <see cref="MaxHeight"/> to wrap the items in a scroll box.
    /// </summary>
    [Parameter] public string? Viewport { get; set; }

    /// <summary>
    /// Wrap the items in a scroll box of this CSS height (e.g. <c>"24rem"</c>) with its own scrollbar,
    /// instead of flowing in the page. For flow content only - a table body can't sit in a <c>div</c>, so
    /// point <see cref="Viewport"/> at the table's own scroll container there instead.
    /// </summary>
    [Parameter] public string? MaxHeight { get; set; }

    /// <summary>Extra classes for the element holding the items.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Inline style for the element holding the items.</summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>Any other attributes, forwarded to the element holding the items.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private readonly string _scrollId = "bz-virtualizer-" + Guid.NewGuid().ToString("N")[..8];

    // A MaxHeight turns the items into a self-contained scroll box (its own viewport); otherwise they
    // flow in the page (window viewport) or track the caller's Viewport selector.
    private bool Scrollable => !string.IsNullOrEmpty(MaxHeight);

    private string? ResolveViewport() => Scrollable ? "#" + _scrollId : Viewport;

    private string ContainerStyle() => $"max-height:{MaxHeight};overflow:auto";

    private RenderFragment RenderContent => @<BaseWindowVirtualizer As="@As" Class="@Class" Style="@Style"
            Count="@Items.Count" RowHeight="@ItemSize" Dynamic="@Dynamic" Overscan="@Overscan"
            Viewport="@ResolveViewport()" Attributes="Attributes" Context="slice">
        @if (Items.Count == 0)
        {
            @EmptyContent
        }
        else
        {
            @RenderSpacer(slice.PaddingTop)
            @foreach (var index in slice.Indices)
            {
                @(ChildContent?.Invoke(new VirtualItem<TItem>(Items[index], index, ItemAttributes(index))))
            }
            @RenderSpacer(slice.PaddingBottom)
        }
    </BaseWindowVirtualizer>;

    // The spacer for the unrendered items: the caller's Spacer (e.g. a table tr/td) or a plain div.
    private RenderFragment RenderSpacer(double height) => Spacer is not null
        ? Spacer(height)
        : builder =>
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "aria-hidden", "true");
            builder.AddAttribute(2, "style", $"height:{Px(height)}");
            builder.CloseElement();
        };

    // The marker dynamic measurement reads, plus (fixed mode only) the exact height that keeps every
    // item == ItemSize so the index-math spacers line up.
    private IReadOnlyDictionary<string, object> ItemAttributes(int index)
    {
        var props = new PropBuilder().Data("bz-virtual-index", index.ToString(CultureInfo.InvariantCulture));
        if (!Dynamic) props.Set("style", $"height:{Px(ItemSize)}");
        return props.Merge(null);
    }

    private static string Px(double value) => value.ToString("0.###", CultureInfo.InvariantCulture) + "px";
}
