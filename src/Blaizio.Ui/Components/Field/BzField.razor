@namespace Blaizio.Ui
@using System.Linq.Expressions
@implements IDisposable
@*
    One form field - a composable Field layout (layout + bz-field hooks) fused with Blaizio's validation
    bridge. Validity resolves from one of two sources:

      • Inside an EditForm: set For to the model property (For="@(() => model.Email)"), or Name
        to its name. Messages come from the ambient EditContext (e.g. populated by
        <DataAnnotationsValidator/>), and the field re-renders whenever validation state changes.
        With For the field also tells the EditContext when the property's value changes, so the
        messages follow the edit instead of waiting for a submit. The control needs nothing for
        that: the field watches the value itself.
      • Standalone (no EditForm): set Error to a message string you compute yourself.
        Non-empty = invalid.

    Either way it cascades a FieldContext that FieldLabel/FieldControl/FieldDescription/FieldError
    consume, so accessibility wiring (id, for, aria-invalid, aria-describedby) and the error display
    are consistent across both modes. data-invalid is emitted when invalid (the style sheets turn
    the field destructive off it); data-orientation drives the layout variants.
*@

<CascadingValue Value="@_context" IsFixed="false">
    <div role="group"
         data-slot="field"
         data-orientation="@Orientation.GetDescription()"
         data-invalid="@(_context.IsInvalid ? "true" : null)"
         data-disabled="@(Disabled ? "true" : null)"
         class="@Tw.Merge(BaseClasses, OrientationClasses(Orientation), Class)"
         @attributes="Attributes">
        @ChildContent
    </div>
</CascadingValue>

@code {
    /// <summary>The ambient EditContext (supplied by an enclosing <c>EditForm</c>), if any.</summary>
    [CascadingParameter] private EditContext? EditContext { get; set; }

    /// <summary>
    /// The model property name this field validates - used to read messages from the EditContext.
    /// Names a property of the form's own model only; prefer <see cref="For"/>, which also reaches
    /// nested objects and keeps the messages in step with edits.
    /// </summary>
    [Parameter] public string? Name { get; set; }

    /// <summary>
    /// The model property this field validates, as an expression: <c>For="@(() =&gt; model.Email)"</c>,
    /// or <c>() =&gt; model.Address.City</c> for a nested object. Inside an <c>EditForm</c> the field
    /// reads its messages for that property and notifies the form's <c>EditContext</c> whenever the
    /// property's value changes, whichever control changed it, so validation runs as the user edits
    /// (with <see cref="Name"/> alone, messages refresh on submit). Wins over <see cref="Name"/>.
    /// </summary>
    [Parameter] public Expression<Func<object?>>? For { get; set; }

    /// <summary>Explicit error message for standalone use (no EditForm). Non-empty marks the field invalid.</summary>
    [Parameter] public string? Error { get; set; }

    /// <summary>Layout axis. Defaults to <see cref="FieldOrientation.Vertical"/>.</summary>
    [Parameter] public FieldOrientation Orientation { get; set; } = FieldOrientation.Vertical;

    /// <summary>Dims the field's label/title (emits <c>data-disabled</c>; disable the control itself too).</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Extra classes, merged over the layout defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The field's label, control, description, and error.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private string _itemId = default!, _descriptionId = default!, _errorId = default!;
    private EditContext? _subscribed;
    private FieldContext _context = default!;

    // The field For (or Name) resolves to in the current EditContext, if any.
    private FieldIdentifier? _field;

    // The value For last read, and for which field of which form: a change is measured against it.
    private bool _watching;
    private EditContext? _watchedContext;
    private FieldIdentifier _watchedField;
    private object? _watchedValue;
    private bool _notifyPending;

    private const string BaseClasses = "bz-field group/field flex w-full";

    private static string OrientationClasses(FieldOrientation orientation) => orientation switch
    {
        FieldOrientation.Horizontal =>
            "bz-field-orientation-horizontal flex-row items-center has-[>[data-slot=field-content]]:items-start " +
            "*:data-[slot=field-label]:flex-auto has-[>[data-slot=field-content]]:[&>[role=checkbox],[role=radio]]:mt-px",
        FieldOrientation.Responsive =>
            "bz-field-orientation-responsive flex-col *:w-full @md/field-group:flex-row @md/field-group:items-center " +
            "@md/field-group:*:w-auto @md/field-group:has-[>[data-slot=field-content]]:items-start " +
            "@md/field-group:*:data-[slot=field-label]:flex-auto [&>.sr-only]:w-auto [&>.fixed]:w-auto " +
            "@md/field-group:has-[>[data-slot=field-content]]:[&>[role=checkbox],[role=radio]]:mt-px",
        // A floating popup (Select/Popover/etc. content) renders in place as a child here; it is
        // position:fixed, so *:w-full would blow it out to the viewport width - keep it at its anchor width.
        _ => "bz-field-orientation-vertical flex-col *:w-full [&>.sr-only]:w-auto [&>.fixed]:w-auto",
    };

    protected override void OnInitialized()
    {
        // Stable ids for the lifetime of the field (don't churn per render).
        var baseId = Identifier.Create("field");
        _itemId = $"{baseId}-item";
        _descriptionId = $"{baseId}-description";
        _errorId = $"{baseId}-error";
    }

    protected override void OnParametersSet()
    {
        // Track the EditContext so we re-render when its validation state changes.
        if (!ReferenceEquals(_subscribed, EditContext))
        {
            Unsubscribe();
            _subscribed = EditContext;
            if (_subscribed is not null)
            {
                _subscribed.OnValidationStateChanged += OnValidationStateChanged;
                _subscribed.OnFieldChanged += OnFieldChanged;
            }
        }

        ResolveField();
        _context = BuildContext();
    }

    // Works out which field this is and, with For, whether its value moved since the last look.
    // Every edit that goes through a binding re-renders the form's owner, which sets parameters
    // here again: that is the moment the new value is seen, whatever control wrote it.
    private void ResolveField()
    {
        if (EditContext is null)
        {
            _field = null;
            _watching = false;
            return;
        }

        if (For is null)
        {
            _field = string.IsNullOrEmpty(Name) ? null : new FieldIdentifier(EditContext.Model, Name);
            _watching = false;
            return;
        }

        if (!FieldExpression.TryRead(For, out var model, out var name, out var value))
        {
            // Not a plain property path the field can read (or an object on the way is null): keep
            // the identity the framework derives from it when it can, and watch nothing.
            _field = TryCreate(For);
            _watching = false;
            return;
        }

        var field = new FieldIdentifier(model, name);
        _field = field;

        // First look, another form, or another object behind the same markup: start from here.
        if (!_watching || !ReferenceEquals(_watchedContext, EditContext) || !field.Equals(_watchedField))
        {
            _watching = true;
            _watchedContext = EditContext;
            _watchedField = field;
            _watchedValue = value;
            _notifyPending = false;
            return;
        }

        if (Equals(_watchedValue, value)) return;
        _watchedValue = value;
        _notifyPending = true;
    }

    private static FieldIdentifier? TryCreate(Expression<Func<object?>> accessor)
    {
        try { return FieldIdentifier.Create(accessor); }
        catch (ArgumentException) { return null; }
    }

    // After the render, not during it: the notification runs the form's validators and its
    // OnFieldChanged handlers, which are free to change state.
    protected override void OnAfterRender(bool firstRender)
    {
        if (!_notifyPending) return;
        _notifyPending = false;
        if (_field is { } field && ReferenceEquals(_watchedContext, EditContext))
            EditContext?.NotifyFieldChanged(field);
    }

    // Something else announced this field (an input that notifies by itself, or the app): take
    // the value as seen, so the same edit is not announced twice.
    private void OnFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        if (!_watching || For is null || !e.FieldIdentifier.Equals(_watchedField)) return;
        if (FieldExpression.TryRead(For, out _, out _, out var value)) _watchedValue = value;
        _notifyPending = false;
    }

    private FieldContext BuildContext()
    {
        IReadOnlyList<string> messages;

        if (EditContext is not null && _field is { } field)
        {
            messages = EditContext.GetValidationMessages(field).ToList();
        }
        else if (!string.IsNullOrEmpty(Error))
        {
            messages = new[] { Error };
        }
        else
        {
            messages = Array.Empty<string>();
        }

        return new FieldContext(_itemId, _descriptionId, _errorId, messages.Count > 0, messages);
    }

    private void OnValidationStateChanged(object? sender, ValidationStateChangedEventArgs e)
    {
        _context = BuildContext();
        StateHasChanged();
    }

    private void Unsubscribe()
    {
        if (_subscribed is null) return;
        _subscribed.OnValidationStateChanged -= OnValidationStateChanged;
        _subscribed.OnFieldChanged -= OnFieldChanged;
    }

    public void Dispose() => Unsubscribe();
}
