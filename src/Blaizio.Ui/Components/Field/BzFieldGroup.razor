@namespace Blaizio.Ui
@*
    Stacks multiple Fields with consistent spacing. Also the container query scope the responsive
    field orientation responds to (@md/field-group).
*@

<BasePrimitive As="div" Attributes="BuildAttributes()" ChildContent="@ChildContent" />

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "field-group")
            .Merge(Attributes, Tw.Merge("bz-field-group group/field-group @container/field-group flex w-full flex-col", Class));
}
