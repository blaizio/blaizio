@namespace Blaizio.Ui
@*
    The slides' scroll viewport: a flex + scroll-snap container with its native scrollbar hidden. Picks
    the flex axis, overflow and snap direction from the carousel's orientation. A vertical carousel needs
    a height - set it here via Class (e.g. h-64).
*@

<BaseCarouselContent Class="@Classes" Attributes="@Attributes">
    @ChildContent
</BaseCarouselContent>

@code {
    [CascadingParameter] private BaseCarousel? Carousel { get; set; }

    /// <summary>Extra classes, merged over the defaults (set a height here for vertical carousels).</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The slides.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the viewport element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private bool Horizontal => Carousel?.IsHorizontal ?? true;

    private string Classes => Tw.Merge(
        "bz-carousel-content flex snap-mandatory scroll-smooth scrollbar-none " +
        (Horizontal
            ? "snap-x overflow-x-auto overflow-y-hidden"
            : "snap-y flex-col overflow-y-auto overflow-x-hidden"),
        Class);
}
