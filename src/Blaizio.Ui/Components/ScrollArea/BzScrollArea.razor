@namespace Blaizio.Ui
@*
    Styled scroll area - a viewport with custom overlay scrollbars (the native bar is hidden). Drop in
    any content and give the root a size via Class (e.g. h-72 w-48). Orientation picks which scrollbars
    show; Behavior sets when they appear. Built on the headless BaseScrollArea engine (ts/scrollArea.ts).
*@

<BaseScrollArea Behavior="@Behavior" Class="@Tw.Merge("bz-scroll-area relative overflow-hidden", Class)" Attributes="Attributes">
    <div data-slot="scroll-area-viewport" class="@ViewportClasses">
        @* A single measurable wrapper the engine observes; display:table + min-width keeps text
           wrapping for vertical content while letting wide content grow for horizontal scrolling. *@
        <div data-scroll-area-content style="display:table;min-width:100%">
            @ChildContent
        </div>
    </div>

    @* Logical insets (end/start) so the vertical bar sits on the right in LTR and flips to the left in
       RTL, with the corner following to the bottom-end. *@
    @if (ShowVertical)
    {
        <div data-slot="scroll-area-scrollbar" data-orientation="vertical" data-state="hidden"
             class="@($"bz-scroll-area-scrollbar absolute top-0 end-0 z-20 {(ShowHorizontal ? "bottom-2.5" : "bottom-0")}")">
            <div data-slot="scroll-area-thumb" class="bz-scroll-area-thumb"></div>
        </div>
    }
    @if (ShowHorizontal)
    {
        <div data-slot="scroll-area-scrollbar" data-orientation="horizontal" data-state="hidden"
             class="@($"bz-scroll-area-scrollbar absolute bottom-0 start-0 z-20 {(ShowVertical ? "end-2.5" : "end-0")}")">
            <div data-slot="scroll-area-thumb" class="bz-scroll-area-thumb"></div>
        </div>
    }
    @if (ShowVertical && ShowHorizontal)
    {
        <div data-slot="scroll-area-corner" class="bg-border/30 absolute bottom-0 end-0 z-20 size-2.5"></div>
    }
</BaseScrollArea>

@code {
    /// <summary>Which scrollbars to render. Defaults to <see cref="ScrollAreaOrientation.Vertical"/>.</summary>
    [Parameter] public ScrollAreaOrientation Orientation { get; set; } = ScrollAreaOrientation.Vertical;

    /// <summary>When the scrollbars are shown. Defaults to <see cref="ScrollAreaType.Auto"/>.</summary>
    [Parameter] public ScrollAreaType Behavior { get; set; } = ScrollAreaType.Auto;

    /// <summary>Extra classes for the root - set the size here (e.g. <c>h-72 w-48 rounded-md border</c>).</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Extra classes for the inner scrolling viewport.</summary>
    [Parameter] public string? ViewportClass { get; set; }

    /// <summary>The scrollable content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private bool ShowVertical => Orientation is ScrollAreaOrientation.Vertical or ScrollAreaOrientation.Both;
    private bool ShowHorizontal => Orientation is ScrollAreaOrientation.Horizontal or ScrollAreaOrientation.Both;

    private string Overflow => Orientation switch
    {
        ScrollAreaOrientation.Horizontal => "overflow-x-auto overflow-y-hidden",
        ScrollAreaOrientation.Both => "overflow-auto",
        _ => "overflow-y-auto overflow-x-hidden",
    };

    private string ViewportClasses => Tw.Merge(
        "bz-scroll-area-viewport size-full rounded-[inherit] border border-transparent scrollbar-none outline-none transition-[color,box-shadow] " +
        "focus-visible:ring-ring/50 focus-visible:border-ring focus-visible:ring-2 " + Overflow,
        ViewportClass);
}
