@namespace Blaizio.Ui
@*
    Styled CommandSeparator - a thin rule between groups over the headless BaseCommandSeparator (which
    hides itself while a search is filtering).
*@

<BaseCommandSeparator Class="@Tw.Merge(BaseClasses, Class)" Attributes="@ForwardedAttributes()" />

@code {
    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "command-separator").Merge(Attributes);

    private const string BaseClasses = "bz-command-separator bg-border -mx-1 h-px";
}
