@namespace Blaizio.Ui
@*
    Styled Badge - a small status/label pill. Pure styling over a <span> (with RenderAs so it can
    become an <a>). Structural utilities + bz-badge hooks; the active style sheet supplies the look.
*@

<BasePrimitive Element="span"
                Attributes="BuildAttributes()"
                ChildContent="@ChildContent"
                RenderAs="@RenderAs" />

@code {
    /// <summary>Visual style. Defaults to <see cref="BadgeVariant.Default"/>.</summary>
    [Parameter] public BadgeVariant Variant { get; set; } = BadgeVariant.Default;

    /// <summary>Extra classes, merged over the variant defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Badge content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the badge styling onto your own element (e.g. a link) instead of a <c>&lt;span&gt;</c>.</summary>
    [Parameter] public RenderFragment<BzRenderProps>? RenderAs { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "badge")
            .Data("variant", Variant.GetDescription())
            .Merge(Attributes, Tw.Merge(BaseClasses, VariantClasses(Variant), Class));

    private const string BaseClasses =
        "bz-badge group/badge inline-flex w-fit shrink-0 items-center justify-center overflow-hidden " +
        // outline-none: the library ring replaces the UA focus outline - without it the browser
        // paints its own white outline on top (the ring never reads as ours).
        "whitespace-nowrap outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50 " +
        "aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 " +
        "[&>svg]:pointer-events-none";

    // One literal per value - the registry inliner substitutes each token with the skin's
    // utilities, which an interpolated class string would defeat.
    private static string VariantClasses(BadgeVariant variant) => variant switch
    {
        BadgeVariant.Secondary => "bz-badge-variant-secondary",
        BadgeVariant.Accent => "bz-badge-variant-accent",
        BadgeVariant.Destructive => "bz-badge-variant-destructive",
        BadgeVariant.Success => "bz-badge-variant-success",
        BadgeVariant.Warning => "bz-badge-variant-warning",
        BadgeVariant.Info => "bz-badge-variant-info",
        BadgeVariant.Outline => "bz-badge-variant-outline",
        BadgeVariant.Ghost => "bz-badge-variant-ghost",
        BadgeVariant.Link => "bz-badge-variant-link",
        _ => "bz-badge-variant-default",
    };
}
