@namespace Blaizio.Ui
@*
    Styled Avatar root. Compose with <BzAvatarImage> and <BzAvatarFallback>. Structural utilities +
    bz-avatar hooks (the after:* overlay draws a subtle inner border over the image); Size flows to
    the style sheet via data-size.
*@

<BaseAvatar Class="@Tw.Merge(BaseClasses, Class)"
             Attributes="ForwardedAttributes()">
    @ChildContent
</BaseAvatar>

@code {
    /// <summary>Size. Defaults to <see cref="AvatarSize.Default"/>.</summary>
    [Parameter] public AvatarSize Size { get; set; } = AvatarSize.Default;

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder()
            .Data("slot", "avatar")
            .Data("size", Size.GetDescription())
            .Merge(Attributes);

    private const string BaseClasses =
        "bz-avatar group/avatar relative flex shrink-0 select-none after:absolute after:inset-0 " +
        "after:border after:border-border after:mix-blend-darken dark:after:mix-blend-lighten";
}
