@namespace Blaizio.Ui
@* Styled avatar fallback (e.g. initials), shown until/unless the image loads. *@

<BaseAvatarFallback Class="@Tw.Merge("bz-avatar-fallback flex size-full items-center justify-center text-sm group-data-[size=sm]/avatar:text-xs", Class)"
                     Attributes="@ForwardedAttributes()">
    @ChildContent
</BaseAvatarFallback>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "avatar-fallback").Merge(Attributes);
}
