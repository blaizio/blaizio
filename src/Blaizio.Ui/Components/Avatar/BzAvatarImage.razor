@namespace Blaizio.Ui
@* Styled avatar image. Shown once it loads; otherwise the fallback stays. *@

<BaseAvatarImage Src="@Src" Alt="@Alt"
                  Class="@Tw.Merge("bz-avatar-image aspect-square size-full object-cover", Class)"
                  Attributes="ForwardedAttributes()" />

@code {
    /// <summary>Image URL.</summary>
    [Parameter] public string? Src { get; set; }
    /// <summary>Alt text.</summary>
    [Parameter] public string? Alt { get; set; }
    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "avatar-image").Merge(Attributes);
}
