@namespace Blaizio.Ui
@* Overlapping row of Avatars (optionally ending in an <BzAvatarGroupCount>). *@

<BasePrimitive As="div" Attributes="@BuildAttributes()" ChildContent="@ChildContent" />

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "avatar-group")
            .Merge(Attributes, Tw.Merge(
                "bz-avatar-group group/avatar-group flex -space-x-2 " +
                "*:data-[slot=avatar]:ring-2 *:data-[slot=avatar]:ring-background",
                Class));
}
