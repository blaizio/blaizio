@namespace Blaizio.Ui
@* An animated placeholder block. Shape it with classes (e.g. h-4 w-48, or size-10 rounded-full). *@

<BasePrimitive Element="div" Attributes="BuildAttributes()" ChildContent="@ChildContent" />

@code {
    /// <summary>Loading animation. Defaults to <see cref="SkeletonAnimation.Shimmer"/> (a left-to-right sweep).</summary>
    [Parameter] public SkeletonAnimation Animation { get; set; } = SkeletonAnimation.Shimmer;

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "skeleton")
            .Data("animation", Animation.GetDescription())
            .Merge(Attributes, Tw.Merge("bz-skeleton", AnimationClasses, Class));

    // The sweep is the shared `shimmer` utility in its surface mode - the same band, keyframe and
    // shimmer-duration-* / shimmer-color-* knobs the text mode uses, painted over the block's own
    // fill instead of clipped to glyphs. (It used to be a bespoke ::before overlay with a keyframe
    // of its own; one implementation now serves both.) Both animations sit out under reduced
    // motion: pulse via motion-safe, the sweep through the utility's own gate.
    private string AnimationClasses => Animation switch
    {
        SkeletonAnimation.Shimmer => "shimmer-block",
        SkeletonAnimation.Pulse => "motion-safe:animate-pulse",
        _ => "",
    };
}
