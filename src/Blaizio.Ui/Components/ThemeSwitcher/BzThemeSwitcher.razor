@namespace Blaizio.Ui
@inherits ThemeSwitcherBase
@*
    Segmented theme switcher - a ButtonGroup of icon options (system / light / dark) reflecting the
    persisted PREFERENCE (so "system" shows as active even while it resolves to dark). Radiogroup
    semantics; the active option carries aria-checked + data-state="on" for styling. Hide the
    system option with ShowSystem="false".
*@

<BzButtonGroup Class="@Tw.Merge("bz-theme-switcher", Class)"
               Attributes="ForwardedAttributes()">
    @if (ShowSystem)
    {
        @Option("system", Tabler.Outline.DeviceDesktop, "System theme")
    }
    @Option("light", Tabler.Outline.Sun, "Light theme")
    @Option("dark", Tabler.Outline.Moon, "Dark theme")
</BzButtonGroup>

@code {
    /// <summary>Show the "system" (follow the OS) option. Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool ShowSystem { get; set; } = true;

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the radiogroup element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    // role/aria go through the dictionary - loose attributes on BzButtonGroup would collide with
    // its explicit Attributes parameter (Blazor forbids mixing the two).
    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder()
            .Set("role", "radiogroup")
            .Aria("label", "Theme")
            .Data("slot", "theme-switcher")
            .Merge(Attributes);

    private RenderFragment Option(string value, Icon icon, string label) => @<BzButton Variant="ButtonVariant.Outline"
              Size="ButtonSize.IconSm"
              role="radio"
              aria-checked="@(Theme == value ? "true" : "false")"
              aria-label="@label"
              data-state="@(Theme == value ? "on" : "off")"
              Class="@ItemClasses"
              @onclick="@(() => SetThemeAsync(value))">
        <BzIcon Icon="@icon" />
    </BzButton>;

    private const string ItemClasses =
        "bz-theme-switcher-item text-muted-foreground hover:text-foreground " +
        "aria-checked:bg-accent aria-checked:text-accent-foreground";
}
