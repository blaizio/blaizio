@namespace Blaizio.Ui
@*
    Styled Switch - wraps the headless BaseSwitch (the track) and BaseSwitchThumb (the knob).
    Structural utilities + bz-switch hooks; the style sheet moves the thumb off the data-state the
    primitives emit, and the after:* inset enlarges the touch target. Size flows via data-size.
*@

<BaseSwitch Checked="@Checked"
             DefaultChecked="@DefaultChecked"
             CheckedChanged="@CheckedChanged"
             Disabled="@Disabled"
             Class="@Tw.Merge(TrackClasses, Class)"
             Attributes="ForwardedAttributes()">
    <BaseSwitchThumb Class="@ThumbClasses" Attributes="_thumbAttributes" />
</BaseSwitch>

@code {
    /// <summary>Controlled checked state. Leave <see langword="null"/> for uncontrolled.</summary>
    [Parameter] public bool? Checked { get; set; }

    /// <summary>Initial checked state when uncontrolled.</summary>
    [Parameter] public bool DefaultChecked { get; set; }

    /// <summary>Raised with the new state. Enables <c>@bind-Checked</c>.</summary>
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }

    /// <summary>Disables the switch.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Size. Defaults to <see cref="SwitchSize.Default"/>.</summary>
    [Parameter] public SwitchSize Size { get; set; } = SwitchSize.Default;

    /// <summary>Semantic checked-track color. Defaults to <see cref="StatusColor.Default"/> (primary).</summary>
    [Parameter] public StatusColor Color { get; set; } = StatusColor.Default;

    /// <summary>Extra classes, merged over the track defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the track element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private static readonly IReadOnlyDictionary<string, object> _thumbAttributes =
        new PropBuilder().Data("slot", "switch-thumb").Merge(null);

    private IReadOnlyDictionary<string, object> ForwardedAttributes()
    {
        var props = new PropBuilder()
            .Data("slot", "switch")
            .Data("size", Size.GetDescription());
        if (Color != StatusColor.Default) props.Data("color", Color.GetDescription());
        return props.Merge(Attributes);
    }

    private const string TrackClasses =
        "bz-switch peer group/switch relative inline-flex items-center transition-all outline-none " +
        "after:absolute after:-inset-x-3 after:-inset-y-2 data-disabled:cursor-not-allowed data-disabled:opacity-50";

    private const string ThumbClasses =
        "bz-switch-thumb pointer-events-none block ring-0 transition-transform";
}
