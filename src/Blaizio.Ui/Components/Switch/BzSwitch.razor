@namespace Blaizio.Ui
@*
    Styled Switch - wraps the headless BaseSwitch (the track) and BaseSwitchThumb (the knob).
    Structural utilities + bz-switch hooks; the style sheet moves the thumb off the data-state the
    primitives emit, and the after:* inset enlarges the touch target. Size flows via data-size.

    Optional state icons, all cross-fading smoothly (opacity + scale, the thumb pair also rotates):
      • CheckedIcon / UncheckedIcon sit ON THE TRACK - the checked one at the inline-start (revealed
        when the thumb slides away), the unchecked one at the inline-end.
      • ThumbCheckedIcon / ThumbUncheckedIcon live INSIDE the knob and swap with the state.

        <BzSwitch Size="SwitchSize.Lg">
            <CheckedIcon><BzIcon Icon="@Icons.Outline.Sun" /></CheckedIcon>
            <UncheckedIcon><BzIcon Icon="@Icons.Outline.Moon" /></UncheckedIcon>
        </BzSwitch>
*@

<BaseSwitch Checked="@Checked"
             DefaultChecked="@DefaultChecked"
             CheckedChanged="@CheckedChanged"
             Disabled="@Disabled"
             AriaLabel="@AriaLabel"
             AriaLabelledBy="@AriaLabelledBy"
             Class="@Tw.Merge(TrackClasses, Class)"
             Attributes="ForwardedAttributes()">
    <ChildContent>
        @if (CheckedIcon is not null)
        {
            <span aria-hidden="true" data-slot="switch-checked-icon"
                  class="@TrackIconClasses start-0.5 text-primary-foreground group-data-[state=checked]/switch:scale-100 group-data-[state=checked]/switch:opacity-100">@CheckedIcon</span>
        }
        @if (UncheckedIcon is not null)
        {
            <span aria-hidden="true" data-slot="switch-unchecked-icon"
                  class="@TrackIconClasses end-0.5 text-muted-foreground group-data-[state=unchecked]/switch:scale-100 group-data-[state=unchecked]/switch:opacity-100">@UncheckedIcon</span>
        }
    </ChildContent>
    @* Parent-owned knob: same markup a BaseSwitchThumb renders, minus the cascade and the extra
       component instance. Rendered after the track icons so it covers whichever it parks over. *@
    <Thumb Context="ctx">
        <span data-slot="switch-thumb"
              data-state="@(ctx.Checked ? "checked" : "unchecked")"
              data-disabled="@(ctx.Disabled ? "" : null)"
              class="@ThumbClasses">
            @if (ThumbCheckedIcon is not null)
            {
                <span aria-hidden="true" data-slot="switch-thumb-checked-icon"
                      class="@ThumbIconClasses -rotate-90 group-data-[state=checked]/thumb:rotate-0 group-data-[state=checked]/thumb:scale-100 group-data-[state=checked]/thumb:opacity-100">@ThumbCheckedIcon</span>
            }
            @if (ThumbUncheckedIcon is not null)
            {
                <span aria-hidden="true" data-slot="switch-thumb-unchecked-icon"
                      class="@ThumbIconClasses rotate-90 group-data-[state=unchecked]/thumb:rotate-0 group-data-[state=unchecked]/thumb:scale-100 group-data-[state=unchecked]/thumb:opacity-100">@ThumbUncheckedIcon</span>
            }
        </span>
    </Thumb>
</BaseSwitch>

@code {
    /// <summary>Controlled checked state. Leave <see langword="null"/> for uncontrolled.</summary>
    [Parameter] public bool? Checked { get; set; }

    /// <summary>Initial checked state when uncontrolled.</summary>
    [Parameter] public bool DefaultChecked { get; set; }

    /// <summary>Raised with the new state. Enables <c>@bind-Checked</c>.</summary>
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }

    /// <summary>Disables the switch.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Accessible name for the switch (what it turns on/off, e.g. "Airplane mode"). Prefer a
    /// visible label wired via <see cref="AriaLabelledBy"/> or a <c>label for</c>; use this when the
    /// switch stands alone.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Id of the element that names the switch (takes precedence over <see cref="AriaLabel"/>, per ARIA).</summary>
    [Parameter] public string? AriaLabelledBy { get; set; }

    /// <summary>Size. Defaults to <see cref="SwitchSize.Default"/>.</summary>
    [Parameter] public SwitchSize Size { get; set; } = SwitchSize.Default;

    /// <summary>Semantic checked-track color. Defaults to <see cref="StatusColor.Default"/> (primary).</summary>
    [Parameter] public StatusColor Color { get; set; } = StatusColor.Default;

    /// <summary>Track icon at the inline-start, revealed while checked (e.g. a sun).</summary>
    [Parameter] public RenderFragment? CheckedIcon { get; set; }

    /// <summary>Track icon at the inline-end, revealed while unchecked (e.g. a moon).</summary>
    [Parameter] public RenderFragment? UncheckedIcon { get; set; }

    /// <summary>Icon inside the knob while checked - cross-fades with <see cref="ThumbUncheckedIcon"/>.</summary>
    [Parameter] public RenderFragment? ThumbCheckedIcon { get; set; }

    /// <summary>Icon inside the knob while unchecked - cross-fades with <see cref="ThumbCheckedIcon"/>.</summary>
    [Parameter] public RenderFragment? ThumbUncheckedIcon { get; set; }

    /// <summary>Extra classes, merged over the track defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the track element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes()
    {
        var props = new PropBuilder()
            .Data("slot", "switch")
            .Data("size", Size.GetDescription());
        if (Color != StatusColor.Default) props.Data("color", Color.GetDescription());
        return props.Merge(Attributes);
    }

    private const string TrackClasses =
        "bz-switch peer group/switch relative inline-flex items-center transition-all outline-none " +
        "after:absolute after:-inset-x-3 after:-inset-y-2 data-disabled:cursor-not-allowed data-disabled:opacity-50";

    // The knob is a one-cell grid so the two thumb icons stack and cross-fade in place. It renders
    // AFTER the track icons, so it naturally covers whichever one it is parked over.
    private const string ThumbClasses =
        "bz-switch-thumb group/thumb pointer-events-none grid place-items-center ring-0 transition-transform " +
        "*:[grid-area:1/1]";

    // Track icons: pinned to their edge, hidden (faded + shrunk) until their state is active.
    private const string TrackIconClasses =
        "bz-switch-icon pointer-events-none absolute inline-flex items-center justify-center " +
        "scale-50 opacity-0 transition-[opacity,scale] duration-200";

    // Thumb icons: cross-fade with a quarter-turn - each waits shrunk and rotated until its state.
    private const string ThumbIconClasses =
        "bz-switch-thumb-icon pointer-events-none inline-flex items-center justify-center " +
        "scale-50 opacity-0 transition-[opacity,scale,rotate] duration-200";
}
