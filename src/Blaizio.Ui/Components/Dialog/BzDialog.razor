@namespace Blaizio.Ui
@*
    Styled Dialog root - the headless BaseDialog (which renders no element of its own).
    Compose: Dialog > DialogTrigger + DialogContent > DialogHeader/DialogFooter/DialogTitle/….
*@

<BaseDialog Open="@Open"
             DefaultOpen="@DefaultOpen"
             OpenChanged="@OpenChanged"
             Modal="@Modal"
             PreventDismiss="@Locked">
    @ChildContent
</BaseDialog>

@code {
    /// <summary>Controlled open state. Leave <see langword="null"/> for uncontrolled.</summary>
    [Parameter] public bool? Open { get; set; }

    /// <summary>Initial state when uncontrolled.</summary>
    [Parameter] public bool DefaultOpen { get; set; }

    /// <summary>Raised with the new state. Enables <c>@bind-Open</c>.</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Modal (the default): traps focus, locks page scroll, renders the overlay.</summary>
    [Parameter] public bool Modal { get; set; } = true;

    /// <summary>
    /// Locks the dialog: Escape and outside-click no longer close it and the corner close button is
    /// hidden; an explicit <c>DialogClose</c> still closes. Defaults to <see langword="false"/>. To
    /// stop only the backdrop, set <c>DismissOnOutsideClick</c> on <c>BzDialogContent</c> instead.
    /// </summary>
    [Parameter] public bool PreventDismiss { get; set; }

    /// <summary>
    /// The earlier name of <see cref="PreventDismiss"/>, with the opposite meaning: <see langword="false"/>
    /// locks the dialog. When both are set, the dialog is locked if either one asks for it.
    /// </summary>
    [Obsolete("Use PreventDismiss (true locks). DismissOnOutsideClick on the content part is the backdrop only.")]
    [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
    [Parameter] public bool DismissOnOutsideClick { get => _dismissOnOutsideClick; set => _dismissOnOutsideClick = value; }

    private bool _dismissOnOutsideClick = true;
    private bool Locked => PreventDismiss || !_dismissOnOutsideClick;

    /// <summary>The trigger and content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
