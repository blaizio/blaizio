@namespace Blaizio.Ui
@*
    Styled Toggle - wraps the headless BaseToggle. Structural utilities + bz-toggle hooks; the
    active style sheet dresses the data-state BaseToggle emits. data-slot is injected here.
*@

<BaseToggle Pressed="@Pressed"
             DefaultPressed="@DefaultPressed"
             PressedChanged="@PressedChanged"
             Disabled="@Disabled"
             Class="@Tw.Merge(BaseClasses, VariantClasses(Variant), SizeClasses(Size), Class)"
             Attributes="ForwardedAttributes()"
             RenderAs="@RenderAs">
    @ChildContent
</BaseToggle>

@code {
    /// <summary>Controlled pressed state. Leave <see langword="null"/> for uncontrolled.</summary>
    [Parameter] public bool? Pressed { get; set; }

    /// <summary>Initial pressed state when uncontrolled.</summary>
    [Parameter] public bool DefaultPressed { get; set; }

    /// <summary>Raised with the new state. Enables <c>@bind-Pressed</c>.</summary>
    [Parameter] public EventCallback<bool> PressedChanged { get; set; }

    /// <summary>Disables the toggle.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Visual style. Defaults to <see cref="ToggleVariant.Default"/>.</summary>
    [Parameter] public ToggleVariant Variant { get; set; } = ToggleVariant.Default;

    /// <summary>Size. Defaults to <see cref="ToggleSize.Default"/>.</summary>
    [Parameter] public ToggleSize Size { get; set; } = ToggleSize.Default;

    /// <summary>Extra classes, merged over the variant/size defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Toggle content (typically an icon).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the toggle onto your own element instead of a <c>&lt;button&gt;</c>.</summary>
    [Parameter] public RenderFragment<BzRenderProps>? RenderAs { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "toggle").Merge(Attributes);

    internal const string BaseClasses =
        "bz-toggle group/toggle inline-flex items-center justify-center whitespace-nowrap outline-none " +
        "hover:bg-muted focus-visible:ring-2 disabled:pointer-events-none disabled:opacity-50 " +
        "[&_svg]:pointer-events-none [&_svg]:shrink-0";

    // One literal per value - the registry inliner substitutes each token with the skin's
    // utilities, which an interpolated class string would defeat. Internal: BzToggleGroupItem
    // dresses with the same tokens.
    internal static string VariantClasses(ToggleVariant variant) => variant switch
    {
        ToggleVariant.Outline => "bz-toggle-variant-outline",
        _ => "bz-toggle-variant-default",
    };

    internal static string SizeClasses(ToggleSize size) => size switch
    {
        ToggleSize.Sm => "bz-toggle-size-sm",
        ToggleSize.Lg => "bz-toggle-size-lg",
        _ => "bz-toggle-size-default",
    };
}
