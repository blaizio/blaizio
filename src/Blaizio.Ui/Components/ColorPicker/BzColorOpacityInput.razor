@namespace Blaizio.Ui
@*
    The opacity percentage field - a compact BzInputNumber (0-100, arrow keys step, "%" suffix)
    showing the current alpha. Sits beside the alpha slider in the default layout, so the
    transparency controls live together.
*@

<BzInputNumber TValue="double?"
               Value="@Math.Round(Context!.EffectiveA * 100)"
               ValueChanged="OnChange"
               Min="0"
               Max="100"
               Step="1"
               LargeStep="10"
               Format="0'%'"
               Culture="System.Globalization.CultureInfo.InvariantCulture"
               Buttons="false"
               Disabled="@Context.Disabled"
               Label="@AriaLabel"
               Class="@Tw.Merge("w-13 h-7 shrink-0", Class)"
               FieldClass="px-1 text-center font-mono text-xs"
               Attributes="OpacityAttributes()" />

@code {
    /// <summary>Accessible name for the field. Defaults to <c>"Opacity percentage"</c>.</summary>
    [Parameter] public string AriaLabel { get; set; } = "Opacity percentage";

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the input element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    [CascadingParameter] private ColorPickerContext? Context { get; set; }

    protected override void OnParametersSet()
    {
        if (Context is null)
            throw new InvalidOperationException($"{nameof(BzColorOpacityInput)} must be placed inside a {nameof(BzColorPicker)}.");
    }

    private IReadOnlyDictionary<string, object> OpacityAttributes() =>
        new PropBuilder().Data("slot", "color-opacity").Merge(Attributes);

    private async Task OnChange(double? value)
    {
        if (value is not double percent) return;
        await Context!.Root.SetAsync(Context.H, Context.S, Context.V, Math.Clamp(percent, 0, 100) / 100.0);
        await Context.Root.CommitAsync();
    }
}
