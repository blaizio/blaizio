@namespace Blaizio.Ui
@*
    Styled hue slider - a BaseSlider over the 0-360 wheel with the rainbow painted on the track and
    the thumb filled with the pure hue. Pinned LTR: the spectrum is a fixed physical gradient, so
    the pointer mapping must not mirror under RTL.
*@

<BaseSlider Value="@(new[] { Context!.H })"
             ValueChanged="OnChange"
             OnValueCommit="_ => Context.Root.CommitAsync()"
             Min="0"
             Max="360"
             Step="1"
             Disabled="@Context.Disabled"
             Dir="Direction.Ltr"
             Class="@Tw.Merge(RootClasses, Class)"
             Attributes="ForwardedAttributes()">
    <BaseSliderTrack Class="@TrackClasses" Style="@HueGradient" Attributes="_trackAttributes" />
    <BaseSliderThumb Index="0" Class="@ThumbClasses" Style="@ThumbStyle()" Attributes="ThumbAttributes()" />
</BaseSlider>

@code {
    /// <summary>Accessible name for the slider. Defaults to <c>"Hue"</c>.</summary>
    [Parameter] public string AriaLabel { get; set; } = "Hue";

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    [CascadingParameter] private ColorPickerContext? Context { get; set; }

    private static readonly IReadOnlyDictionary<string, object> _trackAttributes =
        new PropBuilder().Data("slot", "color-slider-track").Merge(null);

    protected override void OnParametersSet()
    {
        if (Context is null)
            throw new InvalidOperationException($"{nameof(BzColorHueSlider)} must be placed inside a {nameof(BzColorPicker)}.");
    }

    private Task OnChange(IReadOnlyList<double> values) =>
        Context!.Root.SetAsync(values[0], Context.S, Context.V, Context.A);

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "color-slider").Data("color-slider", "hue").Merge(Attributes);

    private IReadOnlyDictionary<string, object> ThumbAttributes() =>
        new PropBuilder().Data("slot", "color-slider-thumb").Aria("label", AriaLabel).Merge(null);

    private const string HueGradient =
        "background:linear-gradient(to right, #f00, #ff0 17%, #0f0 33%, #0ff 50%, #00f 67%, #f0f 83%, #f00)";

    private const string Sz = "var(--bz-color-slider-thumb-size, 1rem)";

    // Same in-bounds placement as BzSlider: the thumb's start edge at fraction * (100% - size)
    // keeps the handle inside the rounded track at both extremes. Physical left - the slider is LTR.
    private string ThumbStyle() =>
        $"position:absolute;top:50%;left:calc(var(--bz-slider-thumb-fraction) * (100% - {Sz}));" +
        $"transform:translateY(-50%);background:{ColorMath.Format(Context!.H, 1, 1, 1, ColorFormat.Hex)}";

    private const string RootClasses =
        "bz-color-slider relative flex w-full touch-none items-center select-none data-disabled:pointer-events-none";

    private const string TrackClasses = "bz-color-slider-track relative w-full grow overflow-hidden";

    private const string ThumbClasses =
        "bz-color-slider-thumb block shrink-0 focus-visible:outline-hidden focus-visible:ring-[3px] " +
        "focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background";
}
