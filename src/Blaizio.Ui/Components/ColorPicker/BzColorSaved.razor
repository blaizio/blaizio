@namespace Blaizio.Ui
@*
    The saved panel - a header row ("Saved" on the left, "+ Add" on the right) over the saved
    swatches. Add banks the current color; clicking a saved swatch applies it (the matching one
    marks itself selected); the corner x removes it. Bind the picker's SavedColors to persist the
    list wherever you like.
*@

<div role="group" aria-label="@AriaLabel" data-slot="color-saved"
     class="@Tw.Merge("flex flex-col gap-2", Class)" @attributes="Attributes">
    <div class="flex items-center justify-between">
        <span class="text-sm font-medium">@Label</span>
        <button type="button"
                @onclick="() => Context!.Root.SaveCurrentAsync()"
                disabled="@Context!.Disabled"
                aria-label="@SaveAriaLabel"
                data-slot="color-saved-add"
                class="hover:text-muted-foreground flex cursor-pointer items-center gap-1 rounded-sm text-sm font-medium outline-none transition-colors focus-visible:ring-[3px] focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:pointer-events-none">
            <BzIcon Icon="@Tabler.Outline.Plus" Class="size-4" /> @AddLabel
        </button>
    </div>
    @if (Context.Root.Saved.Count > 0)
    {
        <div class="flex flex-wrap items-center gap-1.5">
            @foreach (var color in Context.Root.Saved)
            {
                <span class="group/saved relative inline-flex">
                    <BzColorSwatch Color="@color" />
                    <button type="button"
                            @onclick="() => Context.Root.RemoveSavedAsync(color)"
                            disabled="@Context.Disabled"
                            aria-label="@($"Remove {color}")"
                            data-slot="color-saved-remove"
                            class="bg-foreground text-background absolute -end-1 -top-1 hidden size-3.5 cursor-pointer items-center justify-center rounded-full text-[9px] leading-none group-hover/saved:flex group-focus-within/saved:flex">
                        &#215;
                    </button>
                </span>
            }
        </div>
    }
</div>

@code {
    /// <summary>The panel's heading. Defaults to <c>"Saved"</c>.</summary>
    [Parameter] public string Label { get; set; } = "Saved";

    /// <summary>The add button's text. Defaults to <c>"Add"</c> (rendered as "+ Add").</summary>
    [Parameter] public string AddLabel { get; set; } = "Add";

    /// <summary>Accessible name for the group. Defaults to <c>"Saved colors"</c>.</summary>
    [Parameter] public string AriaLabel { get; set; } = "Saved colors";

    /// <summary>Accessible name for the add button. Defaults to <c>"Save current color"</c>.</summary>
    [Parameter] public string SaveAriaLabel { get; set; } = "Save current color";

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the group element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    [CascadingParameter] private ColorPickerContext? Context { get; set; }

    protected override void OnParametersSet()
    {
        if (Context is null)
            throw new InvalidOperationException($"{nameof(BzColorSaved)} must be placed inside a {nameof(BzColorPicker)}.");
    }
}
