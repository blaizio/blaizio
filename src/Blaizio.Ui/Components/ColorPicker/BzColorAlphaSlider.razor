@namespace Blaizio.Ui
@*
    Styled alpha slider - transparent-to-solid over a checkerboard so transparency reads at a
    glance. Pinned LTR like the hue slider: the gradient is a fixed physical direction.
*@

<BaseSlider Value="@(new[] { Context!.A })"
             ValueChanged="OnChange"
             OnValueCommit="_ => Context.Root.CommitAsync()"
             Min="0"
             Max="1"
             Step="0.01"
             Disabled="@Context.Disabled"
             Dir="Direction.Ltr"
             Class="@Tw.Merge(RootClasses, Class)"
             Attributes="ForwardedAttributes()">
    <BaseSliderTrack Class="@TrackClasses" Style="@TrackStyle" Attributes="_trackAttributes" />
    <BaseSliderThumb Index="0" Class="@ThumbClasses" Style="@ThumbStyle()" Attributes="ThumbAttributes()" />
</BaseSlider>

@code {
    /// <summary>Accessible name for the slider. Defaults to <c>"Opacity"</c>.</summary>
    [Parameter] public string AriaLabel { get; set; } = "Opacity";

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    [CascadingParameter] private ColorPickerContext? Context { get; set; }

    private static readonly IReadOnlyDictionary<string, object> _trackAttributes =
        new PropBuilder().Data("slot", "color-slider-track").Merge(null);

    protected override void OnParametersSet()
    {
        if (Context is null)
            throw new InvalidOperationException($"{nameof(BzColorAlphaSlider)} must be placed inside a {nameof(BzColorPicker)}.");
    }

    private Task OnChange(IReadOnlyList<double> values) =>
        Context!.Root.SetAsync(Context.H, Context.S, Context.V, values[0]);

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "color-slider").Data("color-slider", "alpha").Merge(Attributes);

    private IReadOnlyDictionary<string, object> ThumbAttributes() =>
        new PropBuilder().Data("slot", "color-slider-thumb").Aria("label", AriaLabel).Merge(null);

    /// <summary>The classic transparency checkerboard, shared with the preview well.</summary>
    internal const string Checkerboard =
        "repeating-conic-gradient(rgba(0, 0, 0, 0.15) 0% 25%, transparent 0% 50%)";

    private string TrackStyle =>
        $"background-image:linear-gradient(to right, transparent, {Context!.SolidHex}), {Checkerboard};" +
        "background-size:auto, 8px 8px;background-color:#fff";

    private const string Sz = "var(--bz-color-slider-thumb-size, 1rem)";

    private string ThumbStyle() =>
        $"position:absolute;top:50%;left:calc(var(--bz-slider-thumb-fraction) * (100% - {Sz}));" +
        $"transform:translateY(-50%);background:{Context!.SolidHex}";

    private const string RootClasses =
        "bz-color-slider relative flex w-full touch-none items-center select-none data-disabled:pointer-events-none";

    private const string TrackClasses = "bz-color-slider-track relative w-full grow overflow-hidden";

    private const string ThumbClasses =
        // Cursors come off the picker root (the Cursor / GrabbingCursor parameters); the OS
        // grab/grabbing hands are the default.
        "bz-color-slider-thumb block shrink-0 cursor-[var(--bz-color-cursor-stop,grab)] " +
        "active:cursor-[var(--bz-color-cursor-grab,grabbing)] focus-visible:outline-hidden " +
        "focus-visible:ring-[3px] focus-visible:ring-ring focus-visible:ring-offset-2 " +
        "focus-visible:ring-offset-background";
}
