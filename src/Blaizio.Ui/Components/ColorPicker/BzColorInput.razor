@namespace Blaizio.Ui
@*
    Styled color input group - one bordered container holding an optional swatch dot, the text
    field and an optional opacity percentage field, separated by hairlines. The text field shows
    the serialized value and accepts ANY parseable color on change (blur / Enter): every supported
    format, hex without the #, even a bare "r g b" list - the format is auto-detected and
    converted. Invalid text is dropped and the field re-renders the current color on the next
    change.
*@

<div data-slot="color-input-group"
     class="@Tw.Merge(GroupClasses, Class)"
     @attributes="Attributes">
    @if (ShowSwatch)
    {
        <span class="flex items-center ps-2.5" aria-hidden="true">
            <span class="size-4 shrink-0 rounded-full border border-black/10" style="@DotStyle"></span>
        </span>
    }
    <input value="@Display"
           @onchange="OnChange"
           type="text"
           spellcheck="false"
           autocomplete="off"
           autocorrect="off"
           autocapitalize="off"
           disabled="@Context!.Disabled"
           aria-label="@AriaLabel"
           data-slot="color-input"
           class="@TextClasses" />
    @if (ShowOpacity)
    {
        <input value="@OpacityDisplay"
               @onchange="OnOpacityChange"
               type="text"
               inputmode="numeric"
               spellcheck="false"
               autocomplete="off"
               disabled="@Context.Disabled"
               aria-label="@OpacityAriaLabel"
               data-slot="color-opacity"
               class="@OpacityClasses" />
    }
</div>

@code {
    /// <summary>Show the value in this format instead of the picker's. Defaults to the picker's format.</summary>
    [Parameter] public ColorFormat? Format { get; set; }

    /// <summary>Show the current-color dot at the start of the group. Defaults to <c>false</c>.</summary>
    [Parameter] public bool ShowSwatch { get; set; }

    /// <summary>Add the opacity percentage field at the end of the group. Defaults to <c>false</c>.</summary>
    [Parameter] public bool ShowOpacity { get; set; }

    /// <summary>Accessible name for the text field. Defaults to <c>"Color value"</c>.</summary>
    [Parameter] public string AriaLabel { get; set; } = "Color value";

    /// <summary>Accessible name for the opacity field. Defaults to <c>"Opacity percentage"</c>.</summary>
    [Parameter] public string OpacityAriaLabel { get; set; } = "Opacity percentage";

    /// <summary>Extra classes, merged over the group's defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the group element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    [CascadingParameter] private ColorPickerContext? Context { get; set; }

    protected override void OnParametersSet()
    {
        if (Context is null)
            throw new InvalidOperationException($"{nameof(BzColorInput)} must be placed inside a {nameof(BzColorPicker)}.");
    }

    private ColorFormat EffectiveFormat => Format ?? Context!.Format;

    private string Display =>
        ColorMath.Format(Context!.H, Context.S, Context.V, Context.EffectiveA, EffectiveFormat);

    private string OpacityDisplay => $"{Math.Round(Context!.EffectiveA * 100)}%";

    private string DotStyle =>
        $"background-image:linear-gradient({Context!.Css}, {Context.Css}), {BzColorAlphaSlider.Checkerboard};" +
        "background-size:auto, 6px 6px;background-color:#fff";

    private async Task OnChange(ChangeEventArgs args)
    {
        if (!ColorMath.TryParse(args.Value as string, out var h, out var s, out var v, out var a))
            return;
        await Context!.Root.SetAsync(h, s, v, Context.ShowAlpha ? a : Context.A);
        await Context.Root.CommitAsync();
    }

    private async Task OnOpacityChange(ChangeEventArgs args)
    {
        var digits = new string((args.Value as string ?? "").Where(char.IsAsciiDigit).ToArray());
        if (digits.Length == 0 || !int.TryParse(digits, out var percent))
            return;
        await Context!.Root.SetAsync(Context.H, Context.S, Context.V, Math.Clamp(percent, 0, 100) / 100.0);
        await Context.Root.CommitAsync();
    }

    // Focus lives on the GROUP (focus-within): the inner fields are chromeless segments.
    private const string GroupClasses =
        "bz-color-input-group divide-input flex min-w-0 items-stretch divide-x overflow-hidden " +
        "transition-[color,box-shadow] focus-within:border-ring focus-within:ring-2 focus-within:ring-ring/50 " +
        "has-disabled:pointer-events-none has-disabled:opacity-50";

    // Hex reads uppercase by convention; the transform is display-only, parsing is case-blind.
    private string TextClasses =>
        "bz-color-input h-full w-full min-w-0 grow bg-transparent font-mono outline-none " +
        "placeholder:text-muted-foreground" +
        (EffectiveFormat == ColorFormat.Hex ? " uppercase" : "");

    private const string OpacityClasses =
        "bz-color-input h-full w-14 shrink-0 bg-transparent text-center font-mono outline-none";
}
