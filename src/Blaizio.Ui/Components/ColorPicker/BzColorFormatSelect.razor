@namespace Blaizio.Ui
@*
    The format dropdown - a BzSelect over every supported format (HEX, RGB, RGBA, HSL, HSLA, HSB,
    HWB, CMYK, OKLCH, OKLab). Switching it re-serializes the picker's Value into the chosen format
    and re-emits it. The trigger carries an explicit accessible name: visible content never names
    a role=combobox, so the format text alone would leave it unnamed.
*@

<span data-slot="color-format" class="@Tw.Merge("inline-flex shrink-0", Class)" @attributes="Attributes">
    <BzSelect Value="@Context!.Format.ToString()" ValueChanged="OnChange" Disabled="@Context.Disabled">
        <BzSelectTrigger Size="SelectTriggerSize.Sm" Class="h-9" AriaLabel="@AriaLabel">
            <BzSelectValue />
        </BzSelectTrigger>
        <BzSelectContent Position="SelectPosition.ItemAligned">
            @foreach (var format in Enum.GetValues<ColorFormat>())
            {
                <BzSelectItem Value="@format.ToString()">@format.GetDescription()</BzSelectItem>
            }
        </BzSelectContent>
    </BzSelect>
</span>

@code {
    /// <summary>Accessible name for the format dropdown. Defaults to "Color format".</summary>
    [Parameter] public string AriaLabel { get; set; } = "Color format";

    /// <summary>Extra classes, merged over the wrapper's defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the wrapper element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    [CascadingParameter] private ColorPickerContext? Context { get; set; }

    protected override void OnParametersSet()
    {
        if (Context is null)
            throw new InvalidOperationException($"{nameof(BzColorFormatSelect)} must be placed inside a {nameof(BzColorPicker)}.");
    }

    private Task OnChange(string? value) =>
        Enum.TryParse<ColorFormat>(value, out var format)
            ? Context!.Root.SetFormatAsync(format)
            : Task.CompletedTask;
}
