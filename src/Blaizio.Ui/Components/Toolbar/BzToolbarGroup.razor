@namespace Blaizio.Ui
@*
    Styled ToolbarGroup - wraps the headless BaseToolbarGroup: a role="group" cluster of related
    controls laid out along the toolbar's axis. Disabling the group disables exactly its controls;
    the rest of the bar keeps working. Name a meaningful grouping with aria-label through the
    attribute splat.
*@

<BaseToolbarGroup Disabled="@Disabled"
                   Class="@Tw.Merge(GroupClasses, RevealClasses(), Class)"
                   Attributes="ForwardedAttributes()">
    @ChildContent
</BaseToolbarGroup>

@code {
    /// <summary>Disables every control in this group.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// What this control does when it would sit on a clipped row of an Expand bar - see
    /// <see cref="ToolbarReveal"/>. Defaults to <see cref="ToolbarReveal.None"/>.
    /// </summary>
    [Parameter] public ToolbarReveal Reveal { get; set; } = ToolbarReveal.None;

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The grouped controls.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes (e.g. <c>aria-label</c>), forwarded to the group element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    // No group-level dimming on data-disabled: the controls dim themselves via the cascaded
    // context, and a group opacity on top would double-dim any that were already disabled.
    private const string GroupClasses =
        "bz-toolbar-group flex items-center gap-1 " +
        "data-vertical:flex-col data-vertical:items-stretch";

    // Pin is pure CSS: order-first lands the control on the visible row of a wrapped bar.
    private string? RevealClasses() => Reveal == ToolbarReveal.Pin ? "order-first" : null;

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("reveal", Reveal == ToolbarReveal.None ? null : Reveal.GetDescription()).Data("slot", "toolbar-group").Merge(Attributes);
}
