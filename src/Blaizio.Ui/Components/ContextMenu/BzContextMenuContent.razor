@namespace Blaizio.Ui
@*
    Styled ContextMenuContent - the floating menu surface over the headless BaseContextMenuContent (which
    anchors it to the click point via @floating-ui and manages focus, navigation, presence, and
    dismissal). Structural + animation utilities live here; the look (bg-popover, border, radius,
    padding, shadow, min-width) is the skin's `.bz-context-menu-content`, shared with the sub-content.
*@

<BaseContextMenuContent Class="@Tw.Merge(BaseClasses, Class)"
                         SideOffset="@SideOffset"
                         Loop="@Loop"
                         Inline="@Inline"
                         Attributes="ForwardedAttributes()">
    @ChildContent
</BaseContextMenuContent>

@code {
    /// <summary>Gap in pixels between the click point and the content. Defaults to 0 (at the cursor).</summary>
    [Parameter] public double SideOffset { get; set; }

    /// <summary>
    /// Arrow navigation wraps at the ends (past the last item returns to the first). Defaults to
    /// <see langword="true"/>; set <see langword="false"/> to stop at the first/last item.
    /// </summary>
    [Parameter] public bool Loop { get; set; } = true;

    /// <summary>
    /// Render in place instead of portaling to the document body while open. Defaults to
    /// <see langword="false"/>: the surface moves to the body so no ancestor stacking context or
    /// overflow clip can cover it. Submenus always stay inside their parent surface and follow it.
    /// </summary>
    [Parameter] public bool Inline { get; set; }

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Menu content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    // Set by the surrounding modal surface (dialog/sheet/drawer) so this popup, which portals to
    // the body and is therefore a stacking SIBLING of that surface, paints above it instead of behind.
    [CascadingParameter(Name = OverlayLayer.CascadeName)] private OverlayLayer? Layer { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "context-menu-content")
            .Set("style", OverlayLayer.PopupStyle(Layer))
            .Merge(Attributes);

    private const string BaseClasses =
        "bz-context-menu-content fixed z-50 max-h-[var(--bz-available-height)] overflow-x-hidden overflow-y-auto " +
        "scrollbar-thin outline-none " +
        "data-open:animate-in data-closed:animate-out data-open:fade-in-0 data-closed:fade-out-0 " +
        "data-open:zoom-in-95 data-closed:zoom-out-95 " +
        "data-[side=top]:slide-in-from-bottom-2 data-[side=bottom]:slide-in-from-top-2 " +
        "data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2";
}
