@namespace Blaizio.Ui
@*
    Styled ContextMenu root - wraps the headless BaseContextMenu. Renders only a tiny anchor marker;
    drop a ContextMenuTrigger (the right-clickable region) and a ContextMenuContent inside. Non-modal:
    the page stays interactive while open, and Escape / outside-click / Tab / picking an item dismiss
    it.
*@

<BaseContextMenu Open="@Open" DefaultOpen="@DefaultOpen" OpenChanged="@OpenChanged">
    @ChildContent
</BaseContextMenu>

@code {
    /// <summary>Controlled open state. Use with <c>@bind-Open</c>.</summary>
    [Parameter] public bool? Open { get; set; }

    /// <summary>Initial state when uncontrolled.</summary>
    [Parameter] public bool DefaultOpen { get; set; }

    /// <summary>Raised with the new state. Enables <c>@bind-Open</c>.</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>The trigger and content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
