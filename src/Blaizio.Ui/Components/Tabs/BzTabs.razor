@namespace Blaizio.Ui
@*
    Styled Tabs root - wraps the headless BaseTabs. Structural utilities + the bz-tabs hook;
    horizontal tabs stack list-over-content (flex-col), vertical tabs sit side by side.
*@

<BaseTabs Value="@Value"
           DefaultValue="@DefaultValue"
           ValueChanged="@ValueChanged"
           Orientation="@Orientation"
           ActivationMode="@ActivationMode"
           PanelFocusable="@PanelFocusable"
           Class="@Tw.Merge("bz-tabs group/tabs flex data-horizontal:flex-col", Class)"
           Attributes="ForwardedAttributes()">
    @ChildContent
</BaseTabs>

@code {
    /// <summary>Controlled selected value. Use with <c>@bind-Value</c>.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Initial selection when uncontrolled.</summary>
    [Parameter] public string? DefaultValue { get; set; }

    /// <summary>Raised with the new value. Enables <c>@bind-Value</c>.</summary>
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Layout/navigation axis. Defaults to <see cref="Blaizio.Orientation.Horizontal"/>.</summary>
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Horizontal;

    /// <summary>Keyboard activation behaviour. Defaults to <see cref="TabsActivationMode.Manual"/>
    /// (arrows move focus; Enter/Space activates).</summary>
    [Parameter] public TabsActivationMode ActivationMode { get; set; } = TabsActivationMode.Manual;

    /// <summary>Whether each panel carries <c>tabindex="0"</c> (reachable right after the tablist).
    /// Defaults to <see langword="true"/> per the APG tabs pattern; disable only when a panel's
    /// first element is itself focusable and the extra stop is a nuisance.</summary>
    [Parameter] public bool PanelFocusable { get; set; } = true;

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The tabs list and contents.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "tabs").Merge(Attributes);
}
