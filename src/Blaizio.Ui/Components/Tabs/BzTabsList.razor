@namespace Blaizio.Ui
@*
    Styled TabsList - wraps the headless BaseTabsList. Structural utilities + bz-tabs-list hooks;
    the Default variant is a filled pill strip, Line a transparent strip whose active tab gets an
    underline (the triggers' after:* element).
*@

<BaseTabsList Loop="@Loop"
               AriaLabel="@AriaLabel"
               AriaLabelledBy="@AriaLabelledBy"
               Class="@Tw.Merge(BaseClasses, VariantClasses(Variant), Class)"
               Attributes="ForwardedAttributes()">
    @ChildContent
</BaseTabsList>

@code {
    /// <summary>Visual style. Defaults to <see cref="TabsListVariant.Default"/>.</summary>
    [Parameter] public TabsListVariant Variant { get; set; } = TabsListVariant.Default;

    /// <summary>Wrap navigation at the ends. Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool Loop { get; set; } = true;

    /// <summary>Accessible name for the tab strip (what the tabs switch between, e.g. "Account settings").</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Id of the element that names the strip (takes precedence over <see cref="AriaLabel"/>, per ARIA).</summary>
    [Parameter] public string? AriaLabelledBy { get; set; }

    /// <summary>Extra classes, merged over the variant defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The tab triggers.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder()
            .Data("slot", "tabs-list")
            .Data("variant", Variant.GetDescription())
            .Merge(Attributes);

    private const string BaseClasses =
        "bz-tabs-list group/tabs-list inline-flex w-fit items-center justify-center text-muted-foreground " +
        "group-data-vertical/tabs:h-fit group-data-vertical/tabs:flex-col";

    // One literal per value (token first) - the registry inliner substitutes each token with the
    // skin's utilities, which an interpolated class string would defeat.
    private static string VariantClasses(TabsListVariant variant) => variant switch
    {
        TabsListVariant.Line => "bz-tabs-list-variant-line gap-1 bg-transparent",
        _ => "bz-tabs-list-variant-default bg-muted",
    };
}
