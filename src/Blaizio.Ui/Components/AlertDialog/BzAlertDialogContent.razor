@namespace Blaizio.Ui
@*
    Styled AlertDialogContent - the non-dismissable overlay plus the centered alert surface. No
    close button and the backdrop ignores clicks (DismissOnClick=false); the user must choose an
    action. role="alertdialog" comes from the headless layer. Compose AlertDialogHeader /
    AlertDialogFooter inside.

    ZIndex / OnExitComplete are set by DialogProvider for imperatively shown (stacked) dialogs; ignore
    them for ordinary declarative use.
*@

<BaseDialogOverlay DismissOnClick="false"
                    data-slot="alert-dialog-overlay"
                    Inline="@Inline"
                    Style="@OverlayStyle"
                    Class="bz-alert-dialog-overlay fixed inset-0 z-50" />
<BaseDialogContent Role="alertdialog"
                    Class="@Tw.Merge(BaseClasses, Class)"
                    Style="@ContentStyle"
                    Inline="@Inline"
                    OnExitComplete="@OnExitComplete"
                    Attributes="ForwardedAttributes()">
    @ChildContent
</BaseDialogContent>

@code {
    /// <summary>Max-width preset. Defaults to <see cref="AlertDialogSize.Default"/>.</summary>
    [Parameter] public AlertDialogSize Size { get; set; } = AlertDialogSize.Default;

    /// <summary>Overlay z-index for stacked dialogs (the content sits one above). Null uses the default layer.</summary>
    [Parameter] public int? ZIndex { get; set; }

    /// <summary>Raised after the exit animation finishes; <c>DialogProvider</c> uses it to drop a closed instance.</summary>
    [Parameter] public EventCallback OnExitComplete { get; set; }

    /// <summary>
    /// Render the overlay and surface in place instead of portaling them to the document body while
    /// open. Defaults to <see langword="false"/>: both move to the body so no ancestor stacking
    /// context or overflow clip can cover them.
    /// </summary>
    [Parameter] public bool Inline { get; set; }

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Content (header, footer).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the content element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private string? OverlayStyle => ZIndex is { } z ? $"z-index:{z}" : null;
    private string? ContentStyle => ZIndex is { } z ? $"z-index:{z + 1}" : null;

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder()
            .Data("slot", "alert-dialog-content")
            .Data("size", Size.GetDescription())
            .Merge(Attributes);

    // Centered via inset-0 + m-auto, NOT a persistent translate (see BzDialogContent) - so an alert
    // nested inside another dialog still backdrops the whole viewport.
    private const string BaseClasses =
        "bz-alert-dialog-content group/alert-dialog-content fixed inset-0 z-50 m-auto grid h-fit w-full outline-none";
}
