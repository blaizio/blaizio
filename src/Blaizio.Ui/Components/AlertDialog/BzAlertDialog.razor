@namespace Blaizio.Ui
@*
    Styled AlertDialog root - a modal confirmation built on the Dialog machinery (BaseDialog),
    always modal. Unlike Dialog, it cannot be dismissed by clicking the backdrop; the user must
    choose AlertDialogAction or AlertDialogCancel (Escape still closes).

    Compose: AlertDialog > AlertDialogTrigger + AlertDialogContent >
             AlertDialogHeader (Title + Description) + AlertDialogFooter (Cancel + Action).
*@

<BaseDialog Open="@Open"
             DefaultOpen="@DefaultOpen"
             OpenChanged="@OpenChanged"
             Modal="true"
             PreventDismiss="@Locked">
    @ChildContent
</BaseDialog>

@code {
    /// <summary>Controlled open state. Leave <see langword="null"/> for uncontrolled.</summary>
    [Parameter] public bool? Open { get; set; }

    /// <summary>
    /// Locks the alert: Escape no longer closes it (the backdrop already ignores clicks). Set it
    /// while an action is in flight. Defaults to <see langword="false"/>.
    /// </summary>
    [Parameter] public bool PreventDismiss { get; set; }

    /// <summary>
    /// The earlier name of <see cref="PreventDismiss"/>, with the opposite meaning: <see langword="false"/>
    /// locks the alert. When both are set, the alert is locked if either one asks for it.
    /// </summary>
    [Obsolete("Use PreventDismiss (true locks). DismissOnOutsideClick on the content part is the backdrop only.")]
    [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
    [Parameter] public bool DismissOnOutsideClick { get => !_lockedByEarlierName; set => _lockedByEarlierName = !value; }

    private bool _lockedByEarlierName;
    private bool Locked => PreventDismiss || _lockedByEarlierName;

    /// <summary>Initial state when uncontrolled.</summary>
    [Parameter] public bool DefaultOpen { get; set; }

    /// <summary>Raised with the new state. Enables <c>@bind-Open</c>.</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>The trigger and content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
