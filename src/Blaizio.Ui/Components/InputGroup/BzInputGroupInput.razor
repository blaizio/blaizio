@namespace Blaizio.Ui
@*
    The text control of an InputGroup - an InputText with its own border / background stripped (the
    surrounding InputGroup owns the box). Like InputText it covers both modes: single-line by default,
    multi-line the moment a Rows count is given. Carries data-slot="input-group-control" so the
    group's skin can react to its focus / aria-invalid state. Use with @bind-Value.
*@

<BzInputText Value="@Value"
           ValueChanged="@ValueChanged"
           DebounceDelay="@DebounceDelay"
           Type="@Type"
           Rows="@Rows"
           Placeholder="@Placeholder"
           MaxLength="@MaxLength"
           Disabled="@Disabled"
           ReadOnly="@ReadOnly"
           Required="@Required"
           OnFocus="@OnFocus"
           OnBlur="@OnBlur"
           OnKeyDown="@OnKeyDown"
           Class="@Tw.Merge(Rows is > 0 ? TextareaClasses : InputClasses, Class)"
           Attributes="ControlAttributes()" />

@code {
    /// <summary>The current text. Use with <c>@bind-Value</c> (updates on input).</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Raised with the new text on every input (or after the <see cref="DebounceDelay"/> pause). Enables <c>@bind-Value</c>.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Milliseconds of typing pause before <see cref="ValueChanged"/> fires. <c>0</c> (the default) fires on every input.</summary>
    [Parameter] public int DebounceDelay { get; set; }

    /// <summary>The <c>type</c> attribute. Browser default: text. Single-line only - ignored once <see cref="Rows"/> turns the control into a textarea.</summary>
    [Parameter] public string? Type { get; set; }

    /// <summary>
    /// Number of visible text rows. Setting it (to a positive value) makes the control multi-line - it
    /// renders a <c>&lt;textarea&gt;</c> that still grows with its content above this height. Omit for a
    /// single-line input.
    /// </summary>
    [Parameter] public int? Rows { get; set; }

    /// <summary>Hint text shown while the control is empty.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Maximum number of characters the control accepts.</summary>
    [Parameter] public int? MaxLength { get; set; }

    /// <summary>Disables the control.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Makes the control read-only: focusable and selectable, but not editable.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Marks the control as required (native form validation and AT).</summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>Raised when the control gains focus.</summary>
    [Parameter] public EventCallback<FocusEventArgs> OnFocus { get; set; }

    /// <summary>Raised when the control loses focus - the classic validate-on-leave hook.</summary>
    [Parameter] public EventCallback<FocusEventArgs> OnBlur { get; set; }

    /// <summary>Raised on every key press - e.g. submit-on-Enter.</summary>
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes (placeholder, id, aria-*, …), forwarded to the input.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    // data-slot="input-group-control" overrides Input's own data-slot (its splat is applied last), so
    // the .bz-input-group :has() rules can key off this control's focus / invalid state.
    private IReadOnlyDictionary<string, object> ControlAttributes() =>
        new PropBuilder().Data("slot", "input-group-control").Merge(Attributes);

    private const string InputClasses = "bz-input-group-input flex-1";

    // min-h-0 lets the Rows attribute govern the starting height (InputText's own textarea floor is
    // ~3 rows) - a Rows="1" chat composer really starts one line tall and grows with its content.
    private const string TextareaClasses = "bz-input-group-textarea flex-1 min-h-0 resize-none";
}
