@namespace Blaizio.Ui
@*
    A button sized to sit inside an InputGroupAddon. Wraps the styled Button (ghost by default) and
    layers the per-preset `.bz-input-group-button` look on top; its compact Size maps to the matching
    Button size for the base dimensions.
*@

<BzButton Variant="@Variant"
        Type="ButtonType.Button"
        Size="@MappedSize"
        Disabled="@Disabled"
        OnClick="@OnClick"
        Class="@Tw.Merge(BaseClasses, SizeClass, Class)"
        Attributes="Attributes">
    @ChildContent
</BzButton>

@code {
    /// <summary>Visual style. Defaults to <see cref="ButtonVariant.Ghost"/>.</summary>
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Ghost;

    /// <summary>Compact size. Defaults to <see cref="InputGroupButtonSize.Xs"/>.</summary>
    [Parameter] public InputGroupButtonSize Size { get; set; } = InputGroupButtonSize.Xs;

    /// <summary>Disables the button.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Raised on click. A splatted <c>@onclick</c> binds to this same parameter (component
    /// attribute matching is case-insensitive), so use one or the other. Not raised while
    /// <see cref="Disabled"/>.
    /// </summary>
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>Button content (label, icons).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes (aria-label, id, …), forwarded to the button.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private const string BaseClasses = "bz-input-group-button flex items-center shadow-none";

    // One literal per value - the registry inliner substitutes each token with the skin's
    // utilities, which an interpolated class string would defeat.
    private string SizeClass => Size switch
    {
        InputGroupButtonSize.Sm => "bz-input-group-button-size-sm",
        InputGroupButtonSize.IconXs => "bz-input-group-button-size-icon-xs",
        InputGroupButtonSize.IconSm => "bz-input-group-button-size-icon-sm",
        _ => "bz-input-group-button-size-xs",
    };

    // The base dimensions come from the matching Button size; the .bz-input-group-button-size-* skin
    // (ordered after the button skin) refines the radius / gap / icon size for the in-group look.
    private ButtonSize MappedSize => Size switch
    {
        InputGroupButtonSize.Xs => ButtonSize.Xs,
        InputGroupButtonSize.Sm => ButtonSize.Sm,
        InputGroupButtonSize.IconXs => ButtonSize.IconXs,
        InputGroupButtonSize.IconSm => ButtonSize.IconSm,
        _ => ButtonSize.Xs,
    };
}
