@namespace Blaizio.Ui
@*
    The multi-line control of an InputGroup - a multi-line InputText (Rows set) with its own border /
    background stripped (the InputGroup owns the box). Pair with block-start / block-end addons for a
    toolbar above or below the text. Use with @bind-Value.
*@

<BzInputText Rows="3"
           Value="@Value"
           ValueChanged="@ValueChanged"
           DebounceDelay="@DebounceDelay"
           Placeholder="@Placeholder"
           MaxLength="@MaxLength"
           Disabled="@Disabled"
           ReadOnly="@ReadOnly"
           Required="@Required"
           Focus="@Focus"
           Blur="@Blur"
           KeyDown="@KeyDown"
           Class="@Tw.Merge(BaseClasses, Class)"
           Attributes="ControlAttributes()" />

@code {
    /// <summary>The current text. Use with <c>@bind-Value</c> (updates on input).</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Raised with the new text on every input (or after the <see cref="DebounceDelay"/> pause). Enables <c>@bind-Value</c>.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Milliseconds of typing pause before <see cref="ValueChanged"/> fires. <c>0</c> (the default) fires on every input.</summary>
    [Parameter] public int DebounceDelay { get; set; }

    /// <summary>Hint text shown while the control is empty.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Maximum number of characters the control accepts.</summary>
    [Parameter] public int? MaxLength { get; set; }

    /// <summary>Disables the control.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Makes the control read-only: focusable and selectable, but not editable.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Marks the control as required (native form validation and AT).</summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>Raised when the control gains focus.</summary>
    [Parameter] public EventCallback<FocusEventArgs> Focus { get; set; }

    /// <summary>Raised when the control loses focus - the classic validate-on-leave hook.</summary>
    [Parameter] public EventCallback<FocusEventArgs> Blur { get; set; }

    /// <summary>Raised on every key press - e.g. submit-on-Enter.</summary>
    [Parameter] public EventCallback<KeyboardEventArgs> KeyDown { get; set; }

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes (placeholder, rows, id, aria-*, …), forwarded to the textarea.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ControlAttributes() =>
        new PropBuilder().Data("slot", "input-group-control").Merge(Attributes);

    private const string BaseClasses = "bz-input-group-textarea flex-1 resize-none";
}
