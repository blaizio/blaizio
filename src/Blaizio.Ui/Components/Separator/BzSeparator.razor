@namespace Blaizio.Ui
@*
    Styled Separator - wraps the headless BaseSeparator and applies the new-york v4 design's
    Tailwind classes verbatim. The data-[orientation=…] variants target the data-orientation
    attribute that BaseSeparator emits, so sizing follows orientation with zero JS.
*@

<BaseSeparator Orientation="@Orientation"
                Decorative="@Decorative"
                Class="@Tw.Merge(BaseClasses, Class)"
                Attributes="@Attributes" />

@code {
    /// <summary>Axis of the separator. Defaults to <see cref="Blaizio.Orientation.Horizontal"/>.</summary>
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Horizontal;

    /// <summary>Decorative (hidden from assistive tech) vs. semantic. Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool Decorative { get; set; } = true;

    /// <summary>Extra classes, merged over the defaults via <see cref="Tw.Merge"/>.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the rendered element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private const string BaseClasses =
        "shrink-0 bg-border data-horizontal:h-px data-horizontal:w-full data-vertical:w-px data-vertical:self-stretch";
}
