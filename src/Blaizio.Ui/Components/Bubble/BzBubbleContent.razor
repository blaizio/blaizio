@namespace Blaizio.Ui
@*
    The content surface of a <BzBubble> - padding, radius, and the variant's fill all land here.
    Plain messages render as a <div>; make a bubble interactive by rendering your own button or
    anchor via RenderAs, which picks up hover and the focus ring:

        <BzBubbleContent>
            <RenderAs Context="p"><button @attributes="p.Attributes" @onclick="Open">...</button></RenderAs>
        </BzBubbleContent>
*@

<BasePrimitive As="div" Attributes="BuildAttributes()" ChildContent="@ChildContent" RenderAs="@RenderAs" />

@code {
    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The message content - text, media, anything.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the content styling onto your own element instead of a <c>&lt;div&gt;</c> - e.g. a button or anchor.</summary>
    [Parameter] public RenderFragment<BzRenderProps>? RenderAs { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "bubble-content")
            .Merge(Attributes, Tw.Merge(BaseClasses, Class));

    // The tail squares off the corner it grows from (utilities, so they beat the skin's radius).
    private const string BaseClasses =
        "bz-bubble-content relative w-fit min-w-0 max-w-full overflow-hidden border break-words " +
        "group-data-[align=end]/bubble:self-end [button]:text-start " +
        "group-data-[tail=true]/bubble:group-data-[align=start]/bubble:rounded-es-none " +
        "group-data-[tail=true]/bubble:group-data-[align=end]/bubble:rounded-ee-none";
}
