@namespace Blaizio.Ui
@*
    A pill of emoji reactions overlapping a <BzBubble>'s edge. Anchors to the bottom (or top) and
    to the start or end corner. Give the row role="img" and an aria-label so assistive technology
    announces the reactions once, not emoji by emoji:

        <BzBubbleReactions role="img" aria-label="2 reactions: thumbs up, rocket">
            <span>&#128077;</span><span>&#128640;</span>
        </BzBubbleReactions>
*@

<BasePrimitive Element="div" Attributes="BuildAttributes()" ChildContent="@ChildContent" />

@code {
    /// <summary>Edge the pill overlaps. Defaults to <see cref="BubbleReactionsSide.Bottom"/>.</summary>
    [Parameter] public BubbleReactionsSide Side { get; set; } = BubbleReactionsSide.Bottom;

    /// <summary>Corner the pill hugs. Defaults to <see cref="BubbleAlign.End"/>.</summary>
    [Parameter] public BubbleAlign Align { get; set; } = BubbleAlign.End;

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The reactions - emoji spans, a "+2" count, or small buttons.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "bubble-reactions")
            .Data("side", Side.GetDescription())
            .Data("align", Align.GetDescription())
            .Merge(Attributes, Tw.Merge(BaseClasses, Class));

    private const string BaseClasses =
        "bz-bubble-reactions absolute z-10 flex w-fit shrink-0 items-center justify-center gap-1 " +
        "data-[side=bottom]:bottom-0 data-[side=bottom]:translate-y-3/4 " +
        "data-[side=top]:top-0 data-[side=top]:-translate-y-3/4 " +
        "data-[align=start]:start-3 data-[align=end]:end-3";
}
