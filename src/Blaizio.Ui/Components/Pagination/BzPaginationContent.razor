@namespace Blaizio.Ui
@* Unordered list holding the pager - lays out the items inline. *@

<BasePrimitive Element="ul" Attributes="BuildAttributes()" ChildContent="@ChildContent" />

@code {
    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The pager items - <c>PaginationItem</c>s.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the <c>ul</c>.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "pagination-content")
            .Merge(Attributes, Tw.Merge("bz-pagination-content", Class));
}
