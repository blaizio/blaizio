@namespace Blaizio.Ui
@* Stands in for the skipped page range. The glyph is announced through its sr-only label. *@

<BasePrimitive Element="span" Attributes="BuildAttributes()">
    <BzIcon Icon="@BzGlyphs.Dots" />
    <span class="sr-only">@AriaLabel</span>
</BasePrimitive>

@code {
    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Screen-reader label for the skipped pages. Defaults to "More pages".</summary>
    [Parameter] public string AriaLabel { get; set; } = "More pages";

    /// <summary>Any other attributes, forwarded to the <c>span</c>.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "pagination-ellipsis")
            .Merge(Attributes, Tw.Merge("bz-pagination-ellipsis", Class));
}
