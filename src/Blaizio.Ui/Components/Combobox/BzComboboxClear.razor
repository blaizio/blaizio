@namespace Blaizio.Ui
@*
    Styled ComboboxClear - the X that clears the whole selection, over the headless BaseComboboxClear (which
    renders only while something is selected, then clears it and refocuses the input). A ghost icon button
    sized to sit in the input's trailing addon, swapping in for the trigger chevron.
*@

<BaseComboboxClear Class="@Tw.Merge(BaseClasses, Class)" Attributes="ForwardedAttributes()">
    <BzIcon Icon="@Tabler.Outline.X" Class="bz-combobox-clear-icon pointer-events-none size-4" />
</BaseComboboxClear>

@code {
    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the button.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "combobox-clear").Merge(Attributes);

    private const string BaseClasses =
        "bz-combobox-clear inline-flex size-6 shrink-0 items-center justify-center rounded-md " +
        "text-muted-foreground outline-none transition-colors hover:bg-accent hover:text-accent-foreground " +
        "disabled:pointer-events-none disabled:opacity-50";
}
