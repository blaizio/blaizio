@namespace Blaizio.Ui
@*
    Styled ComboboxSeparator - a thin rule between groups, over the headless BaseComboboxSeparator (which
    hides while the query is filtering). The look is the skin's `.bz-combobox-separator`.
*@

<BaseComboboxSeparator Class="@Tw.Merge("bz-combobox-separator", Class)" Attributes="ForwardedAttributes()" />

@code {
    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "combobox-separator").Merge(Attributes);
}
