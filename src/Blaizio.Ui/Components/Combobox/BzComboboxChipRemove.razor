@namespace Blaizio.Ui
@*
    Styled ComboboxChipRemove - the X on a chip, over the headless BaseComboboxChipRemove (which drops the
    chip's value and refocuses the input). A faint icon that brightens on hover; the look is the skin's
    `.bz-combobox-chip-remove`.
*@

<BaseComboboxChipRemove Class="@Tw.Merge(BaseClasses, Class)" Attributes="ForwardedAttributes()">
    <BzIcon Icon="@Tabler.Outline.X" Class="size-3.5" />
</BaseComboboxChipRemove>

@code {
    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the button.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "combobox-chip-remove").Merge(Attributes);

    private const string BaseClasses =
        "bz-combobox-chip-remove inline-flex items-center justify-center rounded-sm outline-none " +
        "[&_svg]:pointer-events-none [&_svg]:shrink-0";
}
