@namespace Blaizio.Ui
@typeparam TItem
@*
    Styled ComboboxList - the scrolling listbox, over the headless BaseComboboxList (which attaches the
    keyboard navigation + virtual highlight). A render-prop list: it iterates the root's Items and calls
    your template for each, so you write one ComboboxItem template and it maps across the data. The engine
    hides the items that do not match the query, so the template runs for every item, not just the matches.
*@

<BaseComboboxList Class="@Tw.Merge(BaseClasses, Class)" Attributes="@ForwardedAttributes()">
    @if (ChildContent is not null && Data is not null)
    {
        @foreach (var item in Data.Items)
        {
            @ChildContent(item)
        }
    }
</BaseComboboxList>

@code {
    /// <summary>The template for one item (the render-prop). Its context is the item from the root's Items.</summary>
    [Parameter] public RenderFragment<TItem>? ChildContent { get; set; }

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    [CascadingParameter] private ComboboxData<TItem>? Data { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "combobox-list").Merge(Attributes);

    // The scroll cap (--bz-available-height), padding and scrollbar all live in the `.bz-combobox-list` skin.
    private const string BaseClasses = "bz-combobox-list";
}
