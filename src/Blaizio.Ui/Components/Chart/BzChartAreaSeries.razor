@namespace Blaizio.Ui
@typeparam TItem
@implements IDisposable
@*
    Declares an area series on the enclosing <BzChart>. Registration-only - the root draws it.
    With Stacked on the chart, area series stack on each other; Curved layers curve their base
    along the layer below, so stacks stay seamless.
*@

@code {
    [CascadingParameter] private IChartSeriesHost<TItem>? Chart { get; set; }

    /// <summary>Series name - shown in the legend and tooltips.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>Selects the value this series plots for an item.</summary>
    [Parameter, EditorRequired] public Func<TItem, double>? Value { get; set; }

    /// <summary>Series paint - any CSS color. Defaults to the next <c>--chart-1..5</c> token.</summary>
    [Parameter] public string? Color { get; set; }

    /// <summary>Draw a smooth monotone curve through the points instead of straight segments.</summary>
    [Parameter] public bool Curved { get; set; }

    protected override void OnParametersSet() =>
        Chart?.RegisterSeries(this, new ChartSeries<TItem>
        {
            Name = Name,
            Value = Value ?? (_ => 0),
            Color = Color,
            Kind = ChartSeriesKind.Area,
            Curved = Curved,
        });

    public void Dispose() => Chart?.UnregisterSeries(this);
}
