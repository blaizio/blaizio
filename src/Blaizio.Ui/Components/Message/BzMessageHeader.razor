@namespace Blaizio.Ui
@* A full-width band above the bubbles - sender name, timestamp, badges. Indents to match the
   bubble padding, and drops the indent when the message holds a ghost bubble. *@

<BasePrimitive As="div" Attributes="BuildAttributes()" ChildContent="@ChildContent" />

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "message-header")
            .Merge(Attributes, Tw.Merge(
                "bz-message-header flex max-w-full min-w-0 items-center gap-2 px-3 " +
                "group-has-data-[variant=ghost]/message:px-0", Class));
}
