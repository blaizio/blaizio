@namespace Blaizio.Ui
@* A full-width band below the bubbles - delivery state, timestamps, quick actions. Follows the
   message's side: it right-aligns under an end-aligned message. *@

<BasePrimitive As="div" Attributes="BuildAttributes()" ChildContent="@ChildContent" />

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "message-footer")
            .Merge(Attributes, Tw.Merge(
                "bz-message-footer flex max-w-full min-w-0 items-center gap-2 px-3 " +
                "group-has-data-[variant=ghost]/message:px-0 group-data-[align=end]/message:justify-end", Class));
}
