@namespace Blaizio.Ui
@*
    Card title. bz-font-heading is the heading-font hook: it renders with var(--font-heading),
    which apps override to pair a display face with the body font (defaults to the sans stack).
*@

<BasePrimitive As="div" Attributes="@BuildAttributes()" ChildContent="@ChildContent" />

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "card-title")
            .Merge(Attributes, Tw.Merge("bz-card-title bz-font-heading", Class));
}
