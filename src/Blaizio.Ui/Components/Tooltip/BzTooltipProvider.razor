@namespace Blaizio.Ui
@*
    Styled TooltipProvider - thin pass-through to the headless BaseTooltipProvider. Wrap a region (or
    the app root) so its tooltips share a delay and the skip-delay window: after one opens, hovering
    an adjacent trigger opens instantly until SkipDelayDuration ms after the last closes.
*@

<BaseTooltipProvider DelayDuration="@DelayDuration" SkipDelayDuration="@SkipDelayDuration">
    @ChildContent
</BaseTooltipProvider>

@code {
    /// <summary>Default hover delay (ms) for tooltips inside. A Tooltip's own DelayDuration overrides it. Unset inherits <c>BlaizioOptions.Tooltip</c> (400 out of the box).</summary>
    [Parameter] public int? DelayDuration { get; set; }

    /// <summary>How long (ms) after the last tooltip closes that the next still opens instantly. Unset inherits <c>BlaizioOptions.Tooltip</c> (300 out of the box).</summary>
    [Parameter] public int? SkipDelayDuration { get; set; }

    /// <summary>The tooltips.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
