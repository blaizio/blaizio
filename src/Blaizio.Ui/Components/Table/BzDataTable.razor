@namespace Blaizio.Ui
@typeparam TItem
@attribute [CascadingTypeParameter(nameof(TItem))]
@inject IJSRuntime Js
@implements IAsyncDisposable
@using System.Globalization
@*
    BzDataTable<TItem> - the headless data-grid surface built on the styled Table primitives, the way a
    headless table engine drives a plain HTML table. Define columns either as child
    <BzPropertyColumn>/<BzTemplateColumn> (they
    cascade TItem and register in document order) or via the Columns list. Gives single-column sorting
    (header click cycles asc → desc → off), a search filter across the searchable columns, a
    column-visibility menu, optional row selection, and - the headline - optional WINDOW virtualization
    with no height restriction: set Virtualize and the body renders only the rows in view (ItemSize =
    fixed estimate, DynamicRowHeight to measure variable rows) while the page itself scrolls.

    Editing: mark a BzPropertyColumn Editable and the table becomes a keyboard grid (role=grid). EditMode
    picks Cell (spreadsheet-style, one cell at a time), Row (every editor in the row at once), Dialog
    (the row as a form in a dialog) or Drawer (the same form in a sheet at the inline-end edge).
    ts/dataTable.ts owns the cursor and how an edit starts - moving costs no .NET call and no render -
    and .NET owns the data: one editor exists at a time (one row of them in Row mode), a commit
    parses, validates, writes through the property setter and raises OnEdit once per user action.

    Columns: Width / MinWidth / MaxWidth / Fill size them, Pinned keeps them in place while the rows
    scroll sideways, and ResizableColumns / ReorderableColumns let users resize and move them
    (LiveReorder moves the dragged column itself). The script (ts/dataTable.ts) lays the widths out
    and runs every drag and key without calling .NET; it reports a finished resize or move once, and
    .NET keeps the result in ColumnWidths / ColumnOrder.

    Text: everything the table says on its own has a parameter, so a right-to-left or non-English
    app words it all: plain labels (SelectAllAriaLabel, the Pagination* and EditForm* sets, ...),
    SelectionSummaryContent for the counts, and the EditParseErrorMessage and ColumnAnnouncement
    builders for messages that carry a column's name or a number.
*@

@* Columns register through this cascade; the fragment itself renders nothing visible. *@
<CascadingValue Value="this" IsFixed="true">
    @ChildContent
</CascadingValue>

@{
    // A render a column asked for (ColumnChanged) counts toward the cap; any other starts it over.
    _columnRenders = _columnRenderQueued ? _columnRenders + 1 : 0;
    _columnRenderQueued = false;
    if (_columnRowsStale)
    {
        _columnRowsStale = false;
        Recompute();
        SyncEditSession();
    }
    // The display order, settled per render from the columns as they stand: one whose parameters
    // change after this asks for another render.
    ArrangeColumns();
    var columns = VisibleColumns;
    var colSpan = columns.Count + (Selectable ? 1 : 0);
    // Sizing, pinning and moving, settled per render (null for a table that uses none of them,
    // which then renders exactly as before).
    var frame = _frame = BuildColumnFrame(columns);
    // Per-column cell classes resolve ONCE per render: Tw.Merge per cell was a measurable share
    // of the 10k-row hotspot (see docs/benchmarks.md), and the result is identical down a column.
    // Whether any column edits, settled per render: a column's editor exists only once its own
    // parameters have been set, which is after it registers.
    var editing = _editing = _effectiveColumns.Exists(c => c.Editor is not null);
    // An editable table's cells name their group, so a template (or the pick mark) can follow the
    // cell's cursor and state in CSS.
    var cellGroup = editing ? "group/table-cell" : null;
    var cellClasses = new string[columns.Count];
    for (var c = 0; c < columns.Count; c++)
    {
        // A pick list's or date's cells frame the mark that opens the editor with its popup: the
        // cell's hover and cursor show it.
        var pick = editing && HasPickMark(columns[c].Editor) ? "bz-table-cell-pick" : null;
        var edge = columns[c].EdgeToEdge ? "bz-table-cell-edge" : null;
        cellClasses[c] = Tw.Merge("bz-table-cell", frame is { Sized: true } ? "bz-table-cell-fixed" : null, cellGroup, pick, edge,
            ColumnClass(columns[c], header: false));
    }
    // Cell mode: the hovered cell takes the row's hover tint too. One class on the body, not one
    // per cell (a per-cell class lengthened every cell's markup).
    var bodyHover = editing && EditMode == DataTableEditMode.Cell ? "bz-table-body-hover" : null;
}

<div @ref="_root" @attributes="RootAttributes()">
    @if (ShowToolbar)
    {
        <div class="bz-data-table-toolbar">
            @if (Searchable)
            {
                <BzInputText Type="search" Value="@_filter.Value" ValueChanged="@OnSearchChanged"
                           Placeholder="@SearchPlaceholder" Class="bz-data-table-search" aria-label="@SearchPlaceholder" />
            }
            <div class="bz-data-table-toolbar-end">
                @Toolbar
                @if (ColumnToggle)
                {
                    @RenderColumnToggle
                }
            </div>
        </div>
    }

    @* An editable table is a keyboard grid: its cells are the tab stop (ts/dataTable.ts roves it), so
       the scroll container stops being one. *@
    <BzTable ContainerClass="@ResolveContainerClass()" ContainerId="@(Scrollable ? _scrollId : null)" ContainerStyle="@ResolveContainerStyle()"
             ContainerFocusable="@((Scrollable || Virtualize) && !editing)" ContainerAriaLabel="@ContainerAriaLabel"
             Attributes="@(editing ? GridAttributes() : null)">
        @if (Caption is not null)
        {
            <BzTableCaption>@Caption</BzTableCaption>
        }
        @if (frame is { Sized: true })
        {
            @* One col per column: the script writes the widths here, so rows the virtualizer adds
               later take them with no work of their own. *@
            @RenderColumnGroup(columns)
        }
        <BzTableHeader Class="@(StickyHeader ? "bz-table-sticky" : null)">
            <BzTableRow>
                @if (Selectable)
                {
                    <BzTableHead Class="bz-table-select-cell" @attributes="SelectHeadAttributes(editing, frame)">
                        <BzCheckbox Checked="@SelectAllState" CheckedChanged="@(_ => ToggleAll())" aria-label="@SelectAllAriaLabel" />
                    </BzTableHead>
                }
                @for (var c = 0; c < columns.Count; c++)
                {
                    var col = columns[c];
                    // The header's content renders later, after the loop has moved on: it reads its own copy.
                    var resizable = frame is not null && frame.Resizable[c];
                    <BzTableHead Class="@HeadClass(col, frame)" @attributes="HeadAttributes(col, c, editing, frame)">
                        @if (frame is { Sized: true })
                        {
                            @* A laid-out column can be narrower than its header: the title truncates
                               inside this row, and the sort icon keeps its place. *@
                            <div class="bz-table-head-content" data-align="@(col.Align is "center" or "end" ? col.Align : null)">
                                @RenderHeader(col)
                            </div>
                        }
                        else
                        {
                            @RenderHeader(col)
                        }
                        @if (resizable)
                        {
                            @* The drag handle on the end edge; the keys live on the header itself. *@
                            <span class="bz-table-resizer" data-bz-resizer aria-hidden="true"></span>
                        }
                    </BzTableHead>
                }
            </BzTableRow>
        </BzTableHeader>

        @if (Virtualize && !Paged)
        {
            @* The row virtualizer is the standalone BzVirtualizer<TItem>; here it drives the table body
               (Element="tbody") with tr/td spacers. RenderBodyRow still tags each row with its virtual index
               + fixed-mode height, so the body row keeps its existing click / selection wiring.
               Paging and virtualizing are alternatives, so a paged table takes the plain-body path. *@
            <BzVirtualizer @ref="_virtualizer" TItem="TItem" Element="tbody" Class="@(bodyHover is null ? "bz-table-body" : "bz-table-body bz-table-body-hover")"
                         Items="_view" ItemSize="@ItemSize" Dynamic="@DynamicRowHeight"
                         Overscan="@Overscan" Viewport="@(Scrollable ? "#" + _scrollId : null)">
                <ChildContent Context="row">
                    @RenderBodyRow(row.Item, row.Index, columns, cellClasses)
                </ChildContent>
                <Spacer Context="height">
                    <tr aria-hidden="true" class="bz-table-spacer" style="height:@Px(height)">
                        <td colspan="@colSpan"></td>
                    </tr>
                </Spacer>
                <EmptyContent>
                    @EmptyRow(colSpan)
                </EmptyContent>
            </BzVirtualizer>
        }
        else
        {
            @* _rendered is the full view, or - when PageSize is set - just the current page's slice. *@
            <BzTableBody Class="@bodyHover">
                @if (_rendered.Count == 0)
                {
                    @EmptyRow(colSpan)
                }
                else
                {
                    @for (var i = 0; i < _rendered.Count; i++)
                    {
                        @RenderBodyRow(_rendered[i], i, columns, cellClasses)
                    }
                }
            </BzTableBody>
        }

        @if (FooterContent is not null)
        {
            <BzTableFooter>@FooterContent</BzTableFooter>
        }
    </BzTable>

    @if (Paged && PageCount > 1)
    {
        <div class="bz-data-table-pagination flex justify-end pt-4">
            @RenderPagination
        </div>
    }

    @if (Selectable && ShowSelectionSummary)
    {
        var selection = new DataTableSelection(SelectedInViewCount, _rendered.Count);
        <div class="bz-data-table-status" aria-live="polite">
            @if (SelectionSummaryContent is not null)
            {
                @SelectionSummaryContent(selection)
            }
            else
            {
                @:@selection.Selected of @selection.Total row(s) selected.
            }
        </div>
    }

    @if (editing)
    {
        @* Edit outcomes for screen readers: a rejected value, a failed save. Always rendered, so the
           region exists before its text changes. *@
        <div class="bz-data-table-live" role="status" aria-live="polite">@_liveMessage</div>
    }

    @if (editing && EditMode == DataTableEditMode.Dialog)
    {
        @RenderEditDialog
    }
    else if (editing && EditMode == DataTableEditMode.Drawer)
    {
        @RenderEditDrawer
    }
</div>

@code {
    /// <summary>The rows to display (in-memory). Ignored when <see cref="ItemsProvider"/> is set.</summary>
    [Parameter] public IEnumerable<TItem>? Items { get; set; }

    /// <summary>
    /// An async data source for server-side / on-demand rows. When set, it drives the grid instead of
    /// <see cref="Items"/>: sorting, the search filter and paging are delegated to the provider, which
    /// receives the current window + sort + filter and returns that page plus the total count. Pair with
    /// <see cref="PageSize"/> for server-side paging.
    /// </summary>
    [Parameter] public DataTableItemsProvider<TItem>? ItemsProvider { get; set; }

    /// <summary>Columns defined as data. Combine with, or use instead of, the child column components.</summary>
    [Parameter] public IReadOnlyList<DataTableColumn<TItem>>? Columns { get; set; }

    /// <summary>Child column components - <c>BzPropertyColumn</c> / <c>BzTemplateColumn</c>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Controlled sort. Use with <c>@bind-Sort</c>; <see langword="null"/> means natural order.</summary>
    [Parameter] public SortState? Sort { get; set; }

    /// <summary>Initial sort when uncontrolled.</summary>
    [Parameter] public SortState? DefaultSort { get; set; }

    /// <summary>Raised with the new sort. Enables <c>@bind-Sort</c>.</summary>
    [Parameter] public EventCallback<SortState?> SortChanged { get; set; }

    /// <summary>Show a search box that filters across the searchable columns.</summary>
    [Parameter] public bool Searchable { get; set; }

    /// <summary>Placeholder for the search box. Defaults to "Search...".</summary>
    [Parameter] public string SearchPlaceholder { get; set; } = "Search...";

    /// <summary>Restrict the search to a single column (by its <c>Key</c>); when unset every searchable column is matched.</summary>
    [Parameter] public string? SearchColumn { get; set; }

    /// <summary>Controlled search text. Use with <c>@bind-Search</c>.</summary>
    [Parameter] public string? Search { get; set; }

    /// <summary>Initial search text when uncontrolled.</summary>
    [Parameter] public string? DefaultSearch { get; set; }

    /// <summary>Raised with the new search text. Enables <c>@bind-Search</c>.</summary>
    [Parameter] public EventCallback<string?> SearchChanged { get; set; }

    /// <summary>Show a "Columns" menu to toggle column visibility.</summary>
    [Parameter] public bool ColumnToggle { get; set; }

    /// <summary>Label for the column-visibility trigger. Defaults to "Columns".</summary>
    [Parameter] public string ColumnToggleLabel { get; set; } = "Columns";

    /// <summary>
    /// Let users resize columns: drag the end edge of a header, double-click it to fit the content,
    /// or press Alt+Shift+Left / Right on a focused header (Alt+Shift+Enter fits). A column's
    /// <c>MinWidth</c> and <c>MaxWidth</c> still hold, and <c>Resizable</c> opts one out. Bind
    /// <see cref="ColumnWidths"/> to keep what users choose.
    /// </summary>
    [Parameter] public bool ResizableColumns { get; set; }

    /// <summary>
    /// Let users move columns: drag a header to a new place, or press Ctrl+Shift+Left / Right on a
    /// focused header. Pinned columns move among their own group, and a column whose
    /// <c>Reorderable</c> is off stays put. Bind <see cref="ColumnOrder"/> to keep the order, and
    /// set <see cref="LiveReorder"/> to move the column itself while it is dragged.
    /// </summary>
    [Parameter] public bool ReorderableColumns { get; set; }

    /// <summary>
    /// How a dragged header shows where its column will go (with <see cref="ReorderableColumns"/>).
    /// Off (the default): a label with the column's title follows the pointer and a line marks the
    /// gap it will drop into. On: the whole column follows the pointer and the columns it passes
    /// slide out of its way; on release it slides into its place. Either way the order is reported
    /// once, on release, and Escape puts everything back. The slides are instant when the user
    /// asks for reduced motion.
    /// </summary>
    [Parameter] public bool LiveReorder { get; set; }

    /// <summary>
    /// Controlled column widths in pixels, by column key: the columns a user resized. A width here
    /// replaces the column's own <c>Width</c> (kept within its <c>MinWidth</c> and <c>MaxWidth</c>).
    /// Use with <c>@bind-ColumnWidths</c> to save them; set it to <see langword="null"/> to go back
    /// to the columns' own widths.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<string, double>? ColumnWidths { get; set; }

    /// <summary>Initial column widths when uncontrolled (see <see cref="ColumnWidths"/>).</summary>
    [Parameter] public IReadOnlyDictionary<string, double>? DefaultColumnWidths { get; set; }

    /// <summary>Raised when a user finishes resizing a column, with every width set so far. Enables <c>@bind-ColumnWidths</c>.</summary>
    [Parameter] public EventCallback<IReadOnlyDictionary<string, double>?> ColumnWidthsChanged { get; set; }

    /// <summary>
    /// Controlled column order: column keys, first to last. Use with <c>@bind-ColumnOrder</c> to save
    /// it; set it to <see langword="null"/> to go back to the declared order. Keys that name no
    /// column are ignored, and a column the list leaves out keeps its declared place. Pinned
    /// columns still sit at their edge.
    /// </summary>
    [Parameter] public IReadOnlyList<string>? ColumnOrder { get; set; }

    /// <summary>Initial column order when uncontrolled (see <see cref="ColumnOrder"/>).</summary>
    [Parameter] public IReadOnlyList<string>? DefaultColumnOrder { get; set; }

    /// <summary>Raised when a user moves a column, with every column key in the new order (hidden columns included). Enables <c>@bind-ColumnOrder</c>.</summary>
    [Parameter] public EventCallback<IReadOnlyList<string>?> ColumnOrderChanged { get; set; }

    /// <summary>
    /// Words what screen readers hear after a key resizes or moves a column: a new width, a new
    /// place, or no room to move. The context names the change (<c>Kind</c>), the column
    /// (<c>Column</c>, its title), its new <c>Width</c> in pixels or its <c>Position</c> among
    /// <c>Count</c> columns, and the English announcement (<c>Message</c>), used while this is
    /// unset. While it is set, the column script asks .NET for each announcement's words: only
    /// after a key press, one call at a time.
    /// </summary>
    [Parameter] public Func<DataTableColumnAnnouncement, string>? ColumnAnnouncement { get; set; }

    /// <summary>Add a leading checkbox column for row selection. Clicking a row (outside an interactive cell control) also toggles it.</summary>
    [Parameter] public bool Selectable { get; set; }

    /// <summary>The selected rows. Setting a new collection replaces the selection; changes raise <see cref="SelectedItemsChanged"/>.</summary>
    [Parameter] public IReadOnlyCollection<TItem>? SelectedItems { get; set; }

    /// <summary>Raised whenever the selection changes. Enables <c>@bind-SelectedItems</c>.</summary>
    [Parameter] public EventCallback<IReadOnlyCollection<TItem>> SelectedItemsChanged { get; set; }

    /// <summary>Identity key for a row, used to match selection across data reloads. Defaults to reference/Equals.</summary>
    [Parameter] public Func<TItem, object>? RowKey { get; set; }

    /// <summary>
    /// Show the selection status line under the table: "N of M row(s) selected.", or your
    /// <see cref="SelectionSummaryContent"/>. Defaults to <see langword="true"/> when <see cref="Selectable"/>.
    /// </summary>
    [Parameter] public bool ShowSelectionSummary { get; set; } = true;

    /// <summary>
    /// Your own selection status line, in place of "N of M row(s) selected.". The context carries how
    /// many of the rows in view are selected (<c>context.Selected</c>) and how many rows are in view
    /// (<c>context.Total</c>), so the words, the plural forms and any markup are yours. It renders
    /// inside the polite live region under the table.
    /// </summary>
    [Parameter] public RenderFragment<DataTableSelection>? SelectionSummaryContent { get; set; }

    /// <summary>The name of the header checkbox that selects every row in view, for screen readers. Defaults to "Select all rows".</summary>
    [Parameter] public string SelectAllAriaLabel { get; set; } = "Select all rows";

    /// <summary>The name of each row's selection checkbox, for screen readers. Defaults to "Select row".</summary>
    [Parameter] public string SelectRowAriaLabel { get; set; } = "Select row";

    /// <summary>Render only the rows in view, with NO height restriction (the page scrolls). See <see cref="ItemSize"/> / <see cref="DynamicRowHeight"/>.</summary>
    [Parameter] public bool Virtualize { get; set; }

    /// <summary>Row height in pixels: the exact uniform height in fixed mode, or the estimate in <see cref="DynamicRowHeight"/> mode. Defaults to <c>48</c>.</summary>
    [Parameter] public double ItemSize { get; set; } = 48;

    /// <summary>Measure each rendered row instead of assuming <see cref="ItemSize"/> - for variable-height rows.</summary>
    [Parameter] public bool DynamicRowHeight { get; set; }

    /// <summary>Extra rows to render above/below the viewport when virtualizing. Defaults to <c>6</c>.</summary>
    [Parameter] public int Overscan { get; set; } = 6;

    /// <summary>Keep the header visible while scrolling (sticky to the top of the scroll viewport).</summary>
    [Parameter] public bool StickyHeader { get; set; }

    /// <summary>
    /// Constrain the table to a scroll box of this CSS height (e.g. <c>"24rem"</c>, <c>"400px"</c>) with its
    /// own scrollbar, instead of growing with the page. When virtualizing, the rows are measured against this
    /// box. Leave unset to virtualize against the window (no height restriction). Pair with <see cref="StickyHeader"/>.
    /// </summary>
    [Parameter] public string? MaxHeight { get; set; }

    /// <summary>
    /// The name of the table's scroll box, for screen readers. With <see cref="MaxHeight"/> or
    /// <see cref="Virtualize"/> (and no editable column) the box is a keyboard stop of its own, a
    /// named region. Defaults to "Table".
    /// </summary>
    [Parameter] public string ContainerAriaLabel { get; set; } = "Table";

    /// <summary>Rows per page. Set above <c>0</c> to paginate (renders a pager below the table); <c>0</c> (the default) shows every row. An alternative to <see cref="Virtualize"/>, not combined with it.</summary>
    [Parameter] public int PageSize { get; set; }

    /// <summary>Controlled current page (1-based). Use with <c>@bind-Page</c>.</summary>
    [Parameter] public int Page { get; set; }

    /// <summary>Initial page when uncontrolled (1-based). Defaults to <c>1</c>.</summary>
    [Parameter] public int DefaultPage { get; set; } = 1;

    /// <summary>Raised with the new page. Enables <c>@bind-Page</c>.</summary>
    [Parameter] public EventCallback<int> PageChanged { get; set; }

    /// <summary>The pager's name for screen readers (its navigation landmark). Defaults to "pagination".</summary>
    [Parameter] public string PaginationAriaLabel { get; set; } = "pagination";

    /// <summary>The text of the pager's previous-page button. Defaults to "Previous".</summary>
    [Parameter] public string PaginationPreviousLabel { get; set; } = "Previous";

    /// <summary>
    /// The previous-page button's name for screen readers. Keep the button's text in it, as the
    /// default keeps "Previous", so speech users can say what they see. Defaults to "Go to previous page".
    /// </summary>
    [Parameter] public string PaginationPreviousAriaLabel { get; set; } = "Go to previous page";

    /// <summary>The text of the pager's next-page button. Defaults to "Next".</summary>
    [Parameter] public string PaginationNextLabel { get; set; } = "Next";

    /// <summary>
    /// The next-page button's name for screen readers. Keep the button's text in it, as the default
    /// keeps "Next". Defaults to "Go to next page".
    /// </summary>
    [Parameter] public string PaginationNextAriaLabel { get; set; } = "Go to next page";

    /// <summary>What screen readers hear for the pager's ellipsis, which stands in for the pages it skips. Defaults to "More pages".</summary>
    [Parameter] public string PaginationEllipsisAriaLabel { get; set; } = "More pages";

    /// <summary>The name of each page number's link for screen readers, given its page (from 1). Defaults to "Go to page N".</summary>
    [Parameter] public Func<int, string>? PaginationPageAriaLabel { get; set; }

    /// <summary>Extra toolbar content, placed beside the search box / column menu.</summary>
    [Parameter] public RenderFragment? Toolbar { get; set; }

    /// <summary>Footer rows (<c>tfoot</c>), e.g. a totals row.</summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }

    /// <summary>A caption rendered below the table.</summary>
    [Parameter] public RenderFragment? Caption { get; set; }

    /// <summary>What to show when there are no rows (after filtering). Defaults to "No results.".</summary>
    [Parameter] public RenderFragment? EmptyContent { get; set; }

    /// <summary>
    /// What to show while an <see cref="ItemsProvider"/> is loading and no rows are on screen.
    /// Defaults to skeleton rows shaped like the table (one per visible column, a page's worth
    /// when <see cref="PageSize"/> is set). A custom fragment renders in a single cell spanning
    /// every column.
    /// </summary>
    [Parameter] public RenderFragment? LoadingContent { get; set; }

    /// <summary>Raised when a body row is clicked (anywhere outside an interactive cell control).</summary>
    [Parameter] public EventCallback<TItem> OnRowClick { get; set; }

    /// <summary>Returns an extra CSS class for a row based on its data, applied to that row's <c>tr</c>. Return <see langword="null"/> for none.</summary>
    [Parameter] public Func<TItem, string?>? RowClass { get; set; }

    /// <summary>
    /// How <c>Editable</c> columns edit: one cell at a time, spreadsheet-style (the default), the
    /// whole row in place, or the row as a form in a dialog or a drawer. Any editable column turns
    /// the table into a keyboard grid: arrows, Home / End, PageUp / PageDown and Tab move between
    /// cells, and in Cell mode so does Enter (the other modes open the row with it).
    /// </summary>
    [Parameter] public DataTableEditMode EditMode { get; set; } = DataTableEditMode.Cell;

    /// <summary>
    /// A single click (or tap) on an editable cell edits it in place with the control ready, as a
    /// double-click does: the caret where you clicked, a list or calendar open, the time part under
    /// the pointer. In Row mode it opens the row's editors, in Dialog and Drawer modes the form. Off
    /// (the default), a click selects the cell, so Delete, paste and the arrow keys act on it. The
    /// keyboard is the same either way, and a click on a checkbox or switch flips it.
    /// </summary>
    [Parameter] public bool EditOnClick { get; set; }

    /// <summary>
    /// What the built-in date and time editors say to screen readers (their segments, the calendar
    /// button and popup, the AM/PM toggle) and the time editor's AM and PM text, worded in the
    /// reader's language. Set only the ones you need:
    /// <c>EditorLabels="@(new DataTableEditorLabels { Day = "...", Hour = "..." })"</c>; the rest,
    /// and every one while this is unset, stay English.
    /// </summary>
    [Parameter] public DataTableEditorLabels? EditorLabels { get; set; }

    /// <summary>
    /// Raised once per user action that changed cells: a committed cell, row or form, a toggled
    /// checkbox, a paste or a clear. Properties with a setter already hold the new values; call
    /// <c>Reject</c> on the arguments to put the old ones back. Required when an editable property
    /// has no setter (a record or an <c>init</c> property): apply the change there.
    /// </summary>
    [Parameter] public EventCallback<DataTableEditEventArgs<TItem>> OnEdit { get; set; }

    /// <summary>The form editor's title (Dialog and Drawer modes). Defaults to "Edit row".</summary>
    [Parameter] public string EditFormTitle { get; set; } = "Edit row";

    /// <summary>An optional line under the form editor's title.</summary>
    [Parameter] public string? EditFormDescription { get; set; }

    /// <summary>The form editor's save button. Defaults to "Save".</summary>
    [Parameter] public string EditFormSaveLabel { get; set; } = "Save";

    /// <summary>The form editor's cancel button. Defaults to "Cancel".</summary>
    [Parameter] public string EditFormCancelLabel { get; set; } = "Cancel";

    /// <summary>The question the form's footer asks when a form with changes is closed. Defaults to "Discard your changes?".</summary>
    [Parameter] public string EditFormDiscardQuestion { get; set; } = "Discard your changes?";

    /// <summary>The answer that closes a form with changes without saving. Defaults to "Discard".</summary>
    [Parameter] public string EditFormDiscardLabel { get; set; } = "Discard";

    /// <summary>The answer that keeps a form with changes open. Defaults to "Keep editing".</summary>
    [Parameter] public string EditFormKeepEditingLabel { get; set; } = "Keep editing";

    /// <summary>The drawer's button that saves and opens the row before (Drawer mode). Defaults to "Previous row".</summary>
    [Parameter] public string EditFormPreviousLabel { get; set; } = "Previous row";

    /// <summary>The drawer's button that saves and opens the row after (Drawer mode). Defaults to "Next row".</summary>
    [Parameter] public string EditFormNextLabel { get; set; } = "Next row";

    /// <summary>The name of the form editor's close button, in the dialog's corner or the drawer's header, for screen readers. Defaults to "Close".</summary>
    [Parameter] public string EditFormCloseLabel { get; set; } = "Close";

    /// <summary>
    /// The message for a save refused without one of its own: <c>Reject()</c> called with no
    /// message, or an <c>OnEdit</c> that threw. Defaults to "The change was not saved.".
    /// </summary>
    [Parameter] public string EditRejectedMessage { get; set; } = "The change was not saved.";

    /// <summary>
    /// What screen readers hear after a refused value's message when the focus leaves the table
    /// and the edit is dropped. Defaults to "The edit was discarded.".
    /// </summary>
    [Parameter] public string EditDiscardedMessage { get; set; } = "The edit was discarded.";

    /// <summary>
    /// Words the message for a value the table refuses before saving it: text that is not a number,
    /// a date, a time, true or false, or one of a pick list's options, and a required value left
    /// empty. The context names the problem (<c>Kind</c>), the column (<c>Field</c>, its title), a
    /// pick list's options (<c>Options</c>) and the English message (<c>Message</c>), used while
    /// this is unset. The property's DataAnnotations word their own messages (localize them
    /// through the attributes), and a column's <c>Validate</c> returns its own.
    /// </summary>
    [Parameter] public Func<CellParseError, string>? EditParseErrorMessage { get; set; }

    /// <summary>
    /// Your own editor for Dialog mode, in place of the built-in dialog, laid out as you like. The
    /// context carries the row, a draft per editable column, the validation messages, and Save /
    /// Cancel. Bind your surface's <c>Open</c> and <c>OpenChanged</c> to <c>context.Open</c> and
    /// <c>context.OpenChanged</c>, render any field you keep as built with <c>context.Field(key)</c>,
    /// and while <c>context.ConfirmingDiscard</c> is true ask Discard or Keep editing.
    /// </summary>
    [Parameter] public RenderFragment<DataTableEditForm<TItem>>? EditDialogContent { get; set; }

    /// <summary>
    /// Your own editor for Drawer mode, in place of the built-in drawer: a sheet or drawer of your
    /// own. It receives the same context as <see cref="EditDialogContent"/>, with
    /// <c>context.PreviousAsync</c> and <c>context.NextAsync</c> to save and move between rows.
    /// </summary>
    [Parameter] public RenderFragment<DataTableEditForm<TItem>>? EditDrawerContent { get; set; }

    /// <summary>Extra classes for the data-table wrapper.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the wrapper.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private readonly List<IGridColumn<TItem>> _registered = [];
    private List<IGridColumn<TItem>> _declared = [];
    private List<IGridColumn<TItem>> _effectiveColumns = [];
    private readonly HashSet<string> _hidden = [];
    private readonly HashSet<string> _seenColumns = [];
    private readonly ControllableState<SortState?> _sort = new();
    private readonly ControllableState<string?> _filter = new();
    private readonly ControllableState<int> _page = new();
    private readonly ControllableState<IReadOnlyDictionary<string, double>?> _widths = new();
    private readonly ControllableState<IReadOnlyList<string>?> _order = new();
    private HashSet<TItem> _selected = [];
    private readonly string _scrollId = "bz-dt-scroll-" + Guid.NewGuid().ToString("N")[..8];
    private IEqualityComparer<TItem> _rowComparer = EqualityComparer<TItem>.Default;
    private Func<TItem, object>? _lastRowKey;
    private IReadOnlyCollection<TItem>? _lastSelectedParam;
    private List<TItem> _view = [];
    private IReadOnlyList<TItem> _rendered = [];
    private int _totalCount;
    private bool _loading;
    private string? _lastLoadKey;
    private CancellationTokenSource? _loadCts;

    // ---- registration (called by the child column components) ----

    internal void Register(IGridColumn<TItem> column)
    {
        _registered.Add(column);
        if (ServerDriven) RebuildColumns(); else Recompute();
        StateHasChanged();
    }

    internal void Unregister(IGridColumn<TItem> column)
    {
        if (_registered.Remove(column))
        {
            if (ServerDriven) RebuildColumns(); else Recompute();
            StateHasChanged();
        }
    }

    // A child column gets each render's parameters after this table has arranged it (the columns
    // are its child content), so one that changed asks for one more render, and one whose key, sort
    // or search text changed has the rows filtered and sorted again first. Capped at two renders in
    // a row: a column handed a new value on every render (a random width, a ticking title) would
    // otherwise ask forever.
    private const int MaxColumnRenders = 2;
    private int _columnRenders;
    private bool _columnRenderQueued;
    private bool _columnRowsStale;

    internal void ColumnChanged(bool rows, bool registering)
    {
        // While an edit's answer comes in, the rows keep their order (see OnParametersSet).
        if (rows && !ServerDriven && _editEcho == 0) _columnRowsStale = true;
        // A column that is registering has the render Register asked for on its way.
        if (registering || _columnRenderQueued || _columnRenders >= MaxColumnRenders) return;
        _columnRenderQueued = true;
        StateHasChanged();
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(RowKey, _lastRowKey))
        {
            _lastRowKey = RowKey;
            _rowComparer = RowKey is null ? EqualityComparer<TItem>.Default : new KeyComparer(RowKey);
            _selected = new HashSet<TItem>(_selected, _rowComparer);
        }

        if (!ReferenceEquals(SelectedItems, _lastSelectedParam))
        {
            _lastSelectedParam = SelectedItems;
            if (SelectedItems is not null) _selected = new HashSet<TItem>(SelectedItems, _rowComparer);
        }

        _sort.Sync(SortChanged.HasDelegate, Sort, DefaultSort);
        _filter.Sync(SearchChanged.HasDelegate, Search, DefaultSearch);
        _page.Sync(PageChanged.HasDelegate, Page, DefaultPage);
        _widths.Sync(ColumnWidthsChanged.HasDelegate, ColumnWidths, DefaultColumnWidths);
        _order.Sync(ColumnOrderChanged.HasDelegate, ColumnOrder, DefaultColumnOrder);

        // In-memory: run the filter/sort/page pipeline now. Server-driven: just refresh the column set;
        // the data is fetched asynchronously in OnParametersSetAsync (and on sort/filter/page changes).
        // The parent re-rendering in answer to OnEdit keeps the current row order instead: an edit
        // never moves the row under the cursor (the next sort or search orders it again).
        if (ServerDriven) RebuildColumns();
        else if (_editEcho > 0 || _editEchoPending)
        {
            _editEchoPending = false;
            RefreshAfterEdit();
        }
        else Recompute();

        SyncEditSession();
    }

    protected override Task OnParametersSetAsync() => ServerDriven ? LoadAsync() : Task.CompletedTask;

    // ---- the processing pipeline: filter, then sort, materialised once per change ----

    private void Recompute()
    {
        RebuildColumns();

        IEnumerable<TItem> rows = Items ?? [];

        var query = _filter.Value;
        if (!string.IsNullOrWhiteSpace(query))
        {
            var targets = (string.IsNullOrEmpty(SearchColumn)
                ? _effectiveColumns.Where(c => c.Searchable)
                : _effectiveColumns.Where(c => c.Key == SearchColumn)).ToList();

            if (targets.Count > 0)
            {
                rows = rows.Where(item =>
                    targets.Any(c => (c.GetText(item) ?? string.Empty).Contains(query, StringComparison.OrdinalIgnoreCase)));
            }
        }

        if (_sort.Value is { } sort)
        {
            var col = _effectiveColumns.FirstOrDefault(c => c.Key == sort.ColumnKey && c.Sortable);
            if (col is not null)
            {
                var comparer = Comparer<TItem>.Create((a, b) => col.Compare(a, b));
                rows = sort.Direction == SortDirection.Ascending
                    ? rows.OrderBy(x => x, comparer)
                    : rows.OrderByDescending(x => x, comparer);
            }
        }

        _view = rows.ToList();
        _lastItems = Items;
        _lastItemsCount = Items is IReadOnlyCollection<TItem> counted ? counted.Count : -1;
        ApplyPage();
    }

    // Slice the filtered+sorted view down to the current page (or pass it through when not paging).
    private void ApplyPage()
    {
        if (!Paged)
        {
            _rendered = _view;
            return;
        }

        var start = (CurrentPage - 1) * PageSize;
        _rendered = start >= _view.Count ? [] : _view.GetRange(start, Math.Min(PageSize, _view.Count - start));
    }

    private bool Paged => PageSize > 0;

    private bool ServerDriven => ItemsProvider is not null;

    // Total pages: the provider's total when server-driven, else the in-memory view size. At least 1 so
    // an empty paged table still reads as "page 1 of 1".
    private int PageCount
    {
        get
        {
            var total = ServerDriven ? _totalCount : _view.Count;
            return Paged && total > 0 ? (int)Math.Ceiling((double)total / PageSize) : 1;
        }
    }

    // The effective page. In-memory we clamp to the known page count (so a stale page after a shrink
    // still resolves); server-driven we trust the requested page until the total comes back.
    private int CurrentPage
    {
        get
        {
            var page = _page.Value < 1 ? 1 : _page.Value;
            return ServerDriven ? page : Math.Min(page, PageCount);
        }
    }

    // Fetch the current window from the provider: de-duplicates identical requests, cancels any in-flight
    // one (so a stale response can't overwrite a newer page), and tracks a loading flag for the empty row.
    private async Task LoadAsync()
    {
        if (ItemsProvider is null) return;

        var start = Paged ? (CurrentPage - 1) * PageSize : 0;
        var count = Paged ? PageSize : int.MaxValue;
        var key = string.Join('', start, count, _sort.Value?.ColumnKey, _sort.Value?.Direction, _filter.Value);
        if (key == _lastLoadKey) return;
        _lastLoadKey = key;

        _loadCts?.Cancel();
        var cts = _loadCts = new CancellationTokenSource();

        _loading = true;
        StateHasChanged();

        try
        {
            var result = await ItemsProvider(new DataTableRequest<TItem>(start, count, _sort.Value, _filter.Value, cts.Token));
            // Read the source, not cts.Token: disposal disposes the source, after which Token throws.
            if (cts.IsCancellationRequested) return;
            _rendered = result.Items;
            // A virtualized table renders, navigates and row-clicks from _view, not _rendered
            // (paging and virtualizing are alternatives). Without this a provider-fed virtualized
            // table had rows loaded and showed "No results.".
            if (!Paged) _view = result.Items as List<TItem> ?? [.. result.Items];
            _totalCount = result.TotalCount;
            _loading = false;
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer request - a later load owns the loading flag + result.
        }
        catch when (ReferenceEquals(_loadCts, cts) && !cts.IsCancellationRequested)
        {
            // The provider failed. Forget the request key so the same request can run again
            // (otherwise it is deduplicated forever) and drop the loading state, then let the
            // exception reach the app's error handling.
            _lastLoadKey = null;
            _loading = false;
            throw;
        }
    }

    // The declared columns = data columns (Columns) then registered child columns, in declaration
    // order; ArrangeColumns turns them into the display order.
    private void RebuildColumns()
    {
        _declared = [];
        if (Columns is { Count: > 0 })
        {
            for (var i = 0; i < Columns.Count; i++) _declared.Add(new DataTableColumnAdapter<TItem>(Columns[i], i));
        }
        _declared.AddRange(_registered);
        ArrangeColumns();
    }

    // The display order, always worked out from the declared one (so it never drifts render to
    // render). The order (ColumnOrder) reshuffles the columns it names among the places those
    // columns hold, so a column it leaves out (one added after the order was saved) keeps its
    // declared place. Then the pins: start columns first, end columns last, each group in its own
    // order. Default-hidden columns are folded into the hidden set the first time they appear.
    // Also run at each render: a child column's key (its property's name) is only known once its
    // own parameters are set, which is after it registers.
    private void ArrangeColumns()
    {
        var columns = _declared;
        if (_order.Value is { Count: > 0 } order)
        {
            var rank = new Dictionary<string, int>(order.Count, StringComparer.Ordinal);
            for (var i = 0; i < order.Count; i++) rank.TryAdd(order[i], i);
            var listed = columns.Where(c => rank.ContainsKey(c.Key)).OrderBy(c => rank[c.Key]).ToList();
            columns = [.. columns];
            var next = 0;
            for (var i = 0; i < columns.Count && next < listed.Count; i++)
            {
                if (rank.ContainsKey(columns[i].Key)) columns[i] = listed[next++];
            }
        }

        if (columns.Exists(c => c.Pinned is DataTablePin.Start or DataTablePin.End))
        {
            columns =
            [
                .. columns.Where(c => c.Pinned == DataTablePin.Start),
                .. columns.Where(c => c.Pinned is not (DataTablePin.Start or DataTablePin.End)),
                .. columns.Where(c => c.Pinned == DataTablePin.End),
            ];
        }
        _effectiveColumns = columns;

        foreach (var col in columns)
        {
            if (_seenColumns.Add(col.Key) && col.DefaultHidden) _hidden.Add(col.Key);
        }
    }

    private List<IGridColumn<TItem>> VisibleColumns
    {
        get
        {
            var rowEdits = RowEditsShown;
            return _effectiveColumns.Where(c => !_hidden.Contains(c.Key) && (rowEdits || !c.RowEditsOnly)).ToList();
        }
    }

    // An edit actions column (BzEditActionsColumn) shows while rows edit as a whole: Row, Dialog and
    // Drawer modes, with something to edit.
    private bool RowEditsShown =>
        EditMode != DataTableEditMode.Cell && _effectiveColumns.Exists(c => c.Editor is not null);

    private bool ShowToolbar => Searchable || ColumnToggle || Toolbar is not null;

    // A constrained scroll box (MaxHeight) gets its own scrollbar and becomes the virtualization viewport;
    // otherwise a virtualized table flows in the page (window viewport, no height restriction).
    private bool Scrollable => !string.IsNullOrEmpty(MaxHeight);

    private string? ResolveContainerClass() =>
        Scrollable ? "bz-table-container-scroll" : Virtualize ? "bz-table-container-virtual" : null;

    private string? ResolveContainerStyle() => Scrollable ? $"max-height:{MaxHeight}" : null;

    private IReadOnlyDictionary<string, object> RootAttributes() =>
        new PropBuilder().Data("slot", "data-table").Merge(Attributes, Tw.Merge("bz-data-table", Class));

    // ---- sorting ----

    private async Task ToggleSort(IGridColumn<TItem> col)
    {
        if (!col.Sortable) return;

        var current = _sort.Value;
        SortState? next =
            current is null || current.ColumnKey != col.Key ? new SortState(col.Key, SortDirection.Ascending)
            : current.Direction == SortDirection.Ascending ? current with { Direction = SortDirection.Descending }
            : null; // descending → clear

        await _sort.SetAsync(next, SortChanged);
        if (ServerDriven) await LoadAsync();
        else if (!_sort.IsControlled) Recompute();
        StateHasChanged();
    }

    private string? AriaSort(IGridColumn<TItem> col)
    {
        if (!col.Sortable || _sort.Value is not { } s || s.ColumnKey != col.Key) return col.Sortable ? "none" : null;
        return s.Direction == SortDirection.Ascending ? "ascending" : "descending";
    }

    private Icon SortIcon(IGridColumn<TItem> col)
    {
        if (_sort.Value is { } s && s.ColumnKey == col.Key)
            return s.Direction == SortDirection.Ascending ? BzGlyphs.ArrowUp : BzGlyphs.ArrowDown;
        return BzGlyphs.Selector;
    }

    // ---- searching ----

    private async Task OnSearchChanged(string? value)
    {
        await _filter.SetAsync(value, SearchChanged);
        await _page.SetAsync(1, PageChanged); // a new filter resets to the first page
        if (ServerDriven) await LoadAsync();
        else if (!_filter.IsControlled) Recompute();
        StateHasChanged();
    }

    // ---- paging ----

    private async Task GoToPage(int page)
    {
        var clamped = Math.Clamp(page, 1, PageCount);
        if (clamped == CurrentPage) return;
        await _page.SetAsync(clamped, PageChanged);
        if (ServerDriven) await LoadAsync();
        else if (!_page.IsControlled) ApplyPage();
        StateHasChanged();
    }

    // 1, the last page, and a sliding window around the current page; 0 stands in for an ellipsis.
    private IEnumerable<int> PageTokens()
    {
        var total = PageCount;
        var current = CurrentPage;
        var pages = new List<int> { 1 };
        var start = Math.Max(2, current - 1);
        var end = Math.Min(total - 1, current + 1);

        if (start > 2) pages.Add(0);
        for (var p = start; p <= end; p++) pages.Add(p);
        if (end < total - 1) pages.Add(0);
        if (total > 1) pages.Add(total);

        return pages;
    }

    private string PageAriaLabel(int page) =>
        PaginationPageAriaLabel?.Invoke(page) is { Length: > 0 } label ? label : $"Go to page {page}";

    private RenderFragment RenderPagination => @<BzPagination Class="mx-0 w-auto" AriaLabel="@PaginationAriaLabel">
        <BzPaginationContent>
            <BzPaginationItem>
                <BzPaginationPrevious Disabled="@(CurrentPage == 1)" OnClick="@(() => GoToPage(CurrentPage - 1))"
                                      Label="@PaginationPreviousLabel" AriaLabel="@PaginationPreviousAriaLabel" />
            </BzPaginationItem>
            @foreach (var token in PageTokens())
            {
                var n = token;
                <BzPaginationItem>
                    @if (n == 0)
                    {
                        <BzPaginationEllipsis AriaLabel="@PaginationEllipsisAriaLabel" />
                    }
                    else
                    {
                        <BzPaginationLink Active="@(n == CurrentPage)" OnClick="@(() => GoToPage(n))"
                                        AriaLabel="@PageAriaLabel(n)">@n</BzPaginationLink>
                    }
                </BzPaginationItem>
            }
            <BzPaginationItem>
                <BzPaginationNext Disabled="@(CurrentPage == PageCount)" OnClick="@(() => GoToPage(CurrentPage + 1))"
                                  Label="@PaginationNextLabel" AriaLabel="@PaginationNextAriaLabel" />
            </BzPaginationItem>
        </BzPaginationContent>
    </BzPagination>;

    // ---- column visibility ----

    private void SetColumnVisible(string key, bool visible)
    {
        if (visible) _hidden.Remove(key);
        else _hidden.Add(key);
        StateHasChanged();
    }

    // ---- columns: sizing, pinning and moving ----
    //
    // ts/dataTable.ts (createColumns) owns the layout: it measures the content, works out every
    // width, writes them into the colgroup, keeps pinned columns' offsets current and runs each
    // resize and move. .NET owns the state - the widths users chose, the order, the pins - and hears
    // about a finished resize or move once.

    // The narrowest any column gets when it names no MinWidth (the script uses the same floor).
    private const double ColumnFloor = 32;

    private const string SelectPinInset = "inset-inline-start:0px";

    private static readonly IReadOnlyDictionary<string, double> NoWidths = new Dictionary<string, double>();

    private ColumnFrame? _frame;
    private readonly JsInstance _columns = new();
    private string? _columnsSignature;
    private bool _columnsCreating;

    // What one render knows about the column features. Null when the table uses none of them.
    private sealed class ColumnFrame
    {
        // The script lays the widths out (a colgroup is rendered, the cells clip).
        public bool Sized { get; init; }

        // The selection column stays at the start edge, before the start columns.
        public bool PinSelect { get; init; }

        // Per visible column: "start" or "end", the inset that keeps it there, and the group's
        // inner edge ("start" on the last start column, "end" on the first end column).
        public required string?[] Pin { get; init; }

        public required string?[] PinInset { get; init; }

        public required string?[] Edge { get; init; }

        public required bool[] Resizable { get; init; }

        public required bool[] Reorderable { get; init; }

        // Reorderable with somewhere to go: a neighbour in its pin group that moves too (the
        // script's range() walks the same run). Shows the grab cursor.
        public required bool[] Movable { get; init; }
    }

    // Whether the script lays out the widths: any sizing parameter, a width a user chose, or resizing.
    private bool ColumnsSized =>
        ResizableColumns || _widths.Value is { Count: > 0 } ||
        _effectiveColumns.Exists(c => c.Width is not null || c.MinWidth is not null || c.MaxWidth is not null || c.Fill);

    private ColumnFrame? BuildColumnFrame(List<IGridColumn<TItem>> columns)
    {
        var sized = ColumnsSized;
        var pinned = columns.Exists(c => c.Pinned is DataTablePin.Start or DataTablePin.End);
        if (!sized && !pinned && !ReorderableColumns) return null;

        var count = columns.Count;
        var pin = new string?[count];
        var inset = new string?[count];
        var edge = new string?[count];
        var resizable = new bool[count];
        var reorderable = new bool[count];
        var pinSelect = Selectable && columns.Exists(c => c.Pinned == DataTablePin.Start);

        // The columns arrive grouped (ApplyColumnOrder): start ones first, end ones last. Offsets
        // count from each edge: the first start column (or the selection column) sits at 0.
        var fromStart = pinSelect ? 1 : 0;
        var lastStart = -1;
        for (var c = 0; c < count; c++)
        {
            resizable[c] = ResizableColumns && columns[c].Resizable;
            reorderable[c] = ReorderableColumns && columns[c].Reorderable;
            if (columns[c].Pinned != DataTablePin.Start) continue;
            pin[c] = "start";
            inset[c] = PinInset("start", fromStart++);
            lastStart = c;
        }
        var fromEnd = 0;
        var firstEnd = -1;
        for (var c = count - 1; c >= 0; c--)
        {
            if (columns[c].Pinned != DataTablePin.End) continue;
            pin[c] = "end";
            inset[c] = PinInset("end", fromEnd++);
            firstEnd = c;
        }
        if (lastStart >= 0) edge[lastStart] = "start";
        if (firstEnd >= 0) edge[firstEnd] = "end";

        var movable = new bool[count];
        for (var c = 0; c < count; c++)
        {
            movable[c] = reorderable[c] &&
                ((c > 0 && reorderable[c - 1] && pin[c - 1] == pin[c]) ||
                 (c + 1 < count && reorderable[c + 1] && pin[c + 1] == pin[c]));
        }

        return new ColumnFrame
        {
            Sized = sized,
            PinSelect = pinSelect,
            Pin = pin,
            PinInset = inset,
            Edge = edge,
            Resizable = resizable,
            Reorderable = reorderable,
            Movable = movable,
        };
    }

    // The k-th pinned cell from an edge sits past the widths of the ones before it, which the script
    // measures and writes onto the table as --bz-pin-s<k> / --bz-pin-e<k>.
    private static string PinInset(string side, int k) => k == 0
        ? $"inset-inline-{side}:0px"
        : $"inset-inline-{side}:var(--bz-pin-{side[0]}{k.ToString(CultureInfo.InvariantCulture)},0px)";

    private static string HeadClass(IGridColumn<TItem> col, ColumnFrame? frame) =>
        frame is { Sized: true } ? Tw.Merge("bz-table-head-fixed", ColumnClass(col, header: true)) : ColumnClass(col, header: true);

    private IReadOnlyDictionary<string, object> HeadAttributes(IGridColumn<TItem> col, int index, bool editing, ColumnFrame? frame)
    {
        var attributes = new Dictionary<string, object>();
        if (AriaSort(col) is { } sort) attributes["aria-sort"] = sort;
        if (HeadTabStop(editing, index + (Selectable ? 1 : 0)) is { } stop) attributes["tabindex"] = stop;
        if (frame is null) return attributes;

        attributes["data-bz-column"] = col.Key;
        if (frame.Pin[index] is { } pin)
        {
            attributes["data-pinned"] = pin;
            attributes["style"] = frame.PinInset[index]!;
            // A header that is not sticky has no fill of its own to cover the rows scrolling under it.
            if (!StickyHeader) attributes["data-pin-backdrop"] = "";
            if (frame.Edge[index] is { } edge) attributes["data-pinned-edge"] = edge;
        }
        if (frame.Resizable[index]) attributes["data-resizable"] = "";
        if (frame.Reorderable[index]) attributes["data-reorderable"] = "";
        if (frame.Movable[index]) attributes["data-movable"] = "";
        // The keys act on a focused header: one with no sort button gets a tab stop of its own (an
        // editable table's cursor reaches every header already).
        if (!editing && col.Header is null && !col.Sortable && (frame.Resizable[index] || frame.Reorderable[index]))
            attributes["tabindex"] = "0";
        return attributes;
    }

    private IReadOnlyDictionary<string, object> SelectHeadAttributes(bool editing, ColumnFrame? frame)
    {
        var attributes = new Dictionary<string, object>();
        if (HeadTabStop(editing, 0) is { } stop) attributes["tabindex"] = stop;
        if (frame is { PinSelect: true })
        {
            attributes["data-pinned"] = "start";
            attributes["style"] = SelectPinInset;
            if (!StickyHeader) attributes["data-pin-backdrop"] = "";
        }
        return attributes;
    }

    private RenderFragment RenderColumnGroup(List<IGridColumn<TItem>> columns) => builder =>
    {
        builder.OpenElement(0, "colgroup");
        if (Selectable)
        {
            builder.OpenElement(1, "col");
            builder.AddAttribute(2, "class", "bz-table-col");
            builder.CloseElement();
        }
        for (var c = 0; c < columns.Count; c++)
        {
            builder.OpenElement(3, "col");
            builder.AddAttribute(4, "class", "bz-table-col");
            // A known width is written before the script attaches, so the first paint is close.
            if (EffectiveWidth(columns[c]) is { } width) builder.AddAttribute(5, "style", $"width:{Px(width)}");
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    // The width a column starts at: the one a user chose, else its own Width, within its bounds.
    private double? EffectiveWidth(IGridColumn<TItem> column)
    {
        double? width = _widths.Value is { } chosen && chosen.TryGetValue(column.Key, out var user) ? user : column.Width;
        return width is { } w ? ClampWidth(column, w) : null;
    }

    // MaxWidth wins over a MinWidth above it.
    private static double ClampWidth(IGridColumn<TItem> column, double width)
    {
        var min = column.MinWidth ?? ColumnFloor;
        if (width < min) width = min;
        if (column.MaxWidth is { } max && width > max) width = max;
        return width;
    }

    /// <summary>
    /// Called by the column script when a user finishes resizing a column (a drag, a double-click
    /// fit, or a run of Alt+Shift+arrow presses): stores the width and raises
    /// <see cref="ColumnWidthsChanged"/>.
    /// </summary>
    [JSInvokable]
    public async Task ColumnResized(string key, double width)
    {
        // The script follows whatever this answers with, even a controlled parent keeping the old width.
        _columnsSignature = null;
        var column = _effectiveColumns.Find(c => c.Key == key);
        if (column is null || !double.IsFinite(width))
        {
            StateHasChanged();
            return;
        }
        var next = new Dictionary<string, double>(_widths.Value ?? NoWidths, StringComparer.Ordinal)
        {
            [key] = ClampWidth(column, Math.Round(width)),
        };
        await _widths.SetAsync(next, ColumnWidthsChanged);
        StateHasChanged();
    }

    /// <summary>
    /// Called by the column script when a user moves a column (a drop, or a Ctrl+Shift+arrow press)
    /// with the visible columns' keys in their new order: stores the order, hidden columns keeping
    /// their places, and raises <see cref="ColumnOrderChanged"/>.
    /// </summary>
    [JSInvokable]
    public async Task ColumnsReordered(string[] visibleOrder)
    {
        _columnsSignature = null;
        var visible = VisibleColumns;
        var known = visible.Select(c => c.Key).Order(StringComparer.Ordinal);
        if (visibleOrder.Length != visible.Count || !known.SequenceEqual(visibleOrder.Order(StringComparer.Ordinal), StringComparer.Ordinal))
        {
            // Out of step with this render (a column came or went mid-drag): the script re-syncs.
            StateHasChanged();
            return;
        }

        // Columns that are not on screen keep their slot; the visible ones take the new order.
        // "Not on screen" is VisibleColumns' rule, which is more than _hidden: an edit actions
        // column is also left out while rows are not edited as a whole. Testing _hidden alone
        // consumed a slot for it and ran past the end of visibleOrder.
        var onScreen = visible.Select(c => c.Key).ToHashSet(StringComparer.Ordinal);
        var next = new List<string>(_effectiveColumns.Count);
        var v = 0;
        foreach (var column in _effectiveColumns)
            next.Add(onScreen.Contains(column.Key) ? visibleOrder[v++] : column.Key);
        await _order.SetAsync(next, ColumnOrderChanged);
        if (!_order.IsControlled) RebuildColumns();
        StateHasChanged();
    }

    // The column script: created on the first render that uses a column feature, then told only when
    // its inputs change - the visible columns and their widths, bounds, pins and switches.
    private async Task SyncColumnsAsync()
    {
        if (_frame is null && !_columns.IsCreated) return;
        // The frame belongs to the last render: a column shown or hidden since then waits for the next one.
        if (_frame is not null && _frame.Pin.Length != VisibleColumns.Count) return;
        var options = ColumnsOptions(out var signature);
        if (_columns.IsCreated)
        {
            if (signature == _columnsSignature) return;
            _columnsSignature = signature;
            try
            {
                await _columns.InvokeVoidAsync("update", options);
            }
            catch (JSDisconnectedException)
            {
                // Circuit gone.
            }
            return;
        }
        if (_columnsCreating) return;
        _columnsCreating = true;
        try
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            _rowClicksModule ??= await JsModules.ImportAsync(Js, "./_content/blaizio.base/dist/dataTable.js");
            _columnsSignature = signature;
            await _columns.CreateAsync(_rowClicksModule, "createColumns", _root, _selfRef, options);
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone before the wiring landed.
        }
        finally
        {
            _columnsCreating = false;
        }
    }

    private object ColumnsOptions(out string signature)
    {
        var columns = VisibleColumns;
        var frame = _frame;
        var hasRows = NavRows.Count > 0;
        var list = new object[columns.Count];
        var announce = ColumnAnnouncement is not null;
        var key = new System.Text.StringBuilder()
            .Append(frame?.Sized == true).Append('|').Append(Selectable).Append('|').Append(hasRows).Append('|').Append(LiveReorder)
            .Append('|').Append(announce);
        for (var i = 0; i < columns.Count; i++)
        {
            var col = columns[i];
            var width = frame is null ? null : EffectiveWidth(col);
            var pin = frame?.Pin[i];
            var resizable = frame?.Resizable[i] == true;
            var reorderable = frame?.Reorderable[i] == true;
            var title = col.Title ?? col.Key;
            list[i] = new { key = col.Key, title, width, min = col.MinWidth, max = col.MaxWidth, fill = col.Fill, pin, resizable, reorderable };
            key.Append('|').Append(col.Key).Append(':').Append(title).Append(':').Append(width).Append(':')
                .Append(col.MinWidth).Append(':').Append(col.MaxWidth).Append(':').Append(col.Fill).Append(':')
                .Append(pin).Append(':').Append(resizable).Append(':').Append(reorderable);
        }
        signature = key.ToString();
        return new { sized = frame?.Sized == true, selectable = Selectable, hasRows, live = LiveReorder, announce, columns = list };
    }

    /// <summary>
    /// Called by the column script, while <see cref="ColumnAnnouncement"/> is set, for what screen
    /// readers hear after a key press: <paramref name="change"/> is <c>resized</c> (with the new
    /// width in <paramref name="value"/>), <c>moved</c> (the new place from 1 in
    /// <paramref name="value"/>, of <paramref name="count"/>) or <c>blocked</c>.
    /// </summary>
    [JSInvokable]
    public string ColumnAnnouncementText(string change, string key, int value, int count)
    {
        var title = _effectiveColumns.Find(c => c.Key == key) is { } column && !string.IsNullOrEmpty(column.Title) ? column.Title : key;
        var announcement = change switch
        {
            "moved" => new DataTableColumnAnnouncement(DataTableColumnAnnouncementKind.Moved, title, 0, value, count),
            "blocked" => new DataTableColumnAnnouncement(DataTableColumnAnnouncementKind.CannotMove, title, 0, 0, 0),
            _ => new DataTableColumnAnnouncement(DataTableColumnAnnouncementKind.Resized, title, value, 0, 0),
        };
        return ColumnAnnouncement?.Invoke(announcement) is { Length: > 0 } text ? text : announcement.Message;
    }

    // ---- selection ----

    private bool IsSelected(TItem item) => _selected.Contains(item);

    private int SelectedInViewCount => _rendered.Count(IsSelected);

    private bool AllSelected => _rendered.Count > 0 && _rendered.All(IsSelected);

    private bool SomeSelected => !AllSelected && _rendered.Any(IsSelected);

    private CheckedState SelectAllState =>
        AllSelected ? CheckedState.Checked : SomeSelected ? CheckedState.Indeterminate : CheckedState.Unchecked;

    private async Task ToggleRow(TItem item)
    {
        if (!_selected.Add(item)) _selected.Remove(item);
        await SelectedItemsChanged.InvokeAsync(_selected.ToList());
        StateHasChanged();
    }

    private async Task ToggleAll()
    {
        if (AllSelected)
        {
            foreach (var item in _rendered) _selected.Remove(item);
        }
        else
        {
            foreach (var item in _rendered) _selected.Add(item);
        }
        await SelectedItemsChanged.InvokeAsync(_selected.ToList());
        StateHasChanged();
    }

    // ---- per-row / per-column rendering ----

    private RenderFragment RenderHeader(IGridColumn<TItem> col) => @<text>
        @if (col.Header is { } custom)
        {
            @custom
        }
        else if (col.Sortable)
        {
            <button type="button" class="bz-table-sort-button" data-bz-sort @onclick="@(() => ToggleSort(col))">
                @* Truncates in a column narrowed below its title (bz-table-head-content). *@
                <span class="truncate">@col.Title</span>
                <BzIcon Icon="@SortIcon(col)" Class="bz-table-sort-icon" />
            </button>
        }
        else
        {
            <span class="truncate">@col.Title</span>
        }
    </text>;

    // Body rows emit raw tr/td markup instead of BzTableRow/BzTableCell: the wrappers cost two
    // component instances plus an attribute dictionary and a Tw.Merge PER CELL, which dominated
    // the 10k-row render (245 MB allocated, superlinear wall-clock from GC pressure - see
    // docs/benchmarks.md). Attribute output is kept identical to the wrappers', so styles and the
    // row-click delegation see the same DOM. The selection checkbox stays a real component.
    private RenderFragment RenderBodyRow(TItem item, int index, List<IGridColumn<TItem>> columns, string[] cellClasses) => builder =>
    {
        var editing = _editing;
        var session = editing ? _edit : null;
        // The open edit's row. Its cells hold editors in Cell and Row modes; a form (Dialog, Drawer)
        // edits it elsewhere, and the row is only marked.
        var sessionRow = session is not null && SameRow(item, session.Item);
        var rowEditing = sessionRow && !session!.InForm;
        var indexText = Virtualize || RowsClickable || editing ? index.ToString(CultureInfo.InvariantCulture) : null;

        builder.OpenElement(0, "tr");

        // Key virtualized rows by their absolute index. Without a key the diff is positional, so a
        // scroll re-points the SAME <tr> at a different row and mutates it in place - visible as
        // cell values morphing through their transitions (a status badge animating from one variant
        // colour to another). Keyed, the rows carried over by a scroll keep their own DOM and only
        // the entering rows are built. The index is unique by construction; keying by the item
        // would throw on any list holding the same value twice.
        if (Virtualize) builder.SetKey(index);

        builder.AddAttribute(1, "data-slot", "table-row");
        if (Selectable && IsSelected(item))
            builder.AddAttribute(2, "data-state", "selected");
        if (Virtualize)
        {
            builder.AddAttribute(3, "data-bz-virtual-index", indexText);
            if (!DynamicRowHeight)
                builder.AddAttribute(4, "style", $"height:{Px(ItemSize)}");
        }
        // The row index is also the keyboard grid's row address (ts/dataTable.ts).
        if (RowsClickable || editing)
            builder.AddAttribute(5, "data-bz-row-index", indexText);
        if (editing && (Virtualize || Paged))
            builder.AddAttribute(6, "aria-rowindex", AriaRowIndex(index));
        if (sessionRow && session!.Mode != DataTableEditMode.Cell)
            builder.AddAttribute(7, "data-editing", "");
        builder.AddAttribute(8, "class", RowClass is null ? "bz-table-row" : Tw.Merge("bz-table-row", RowClass(item)));

        var frame = _frame;
        if (Selectable)
        {
            builder.OpenElement(9, "td");
            builder.AddAttribute(10, "data-slot", "table-cell");
            builder.AddAttribute(11, "class", SelectCellClasses);
            if (frame is { PinSelect: true })
            {
                builder.AddAttribute(12, "data-pinned", "start");
                builder.AddAttribute(13, "style", SelectPinInset);
            }
            builder.OpenComponent<BzCheckbox>(14);
            builder.AddComponentParameter(15, nameof(BzCheckbox.Checked),
                IsSelected(item) ? CheckedState.Checked : CheckedState.Unchecked);
            builder.AddComponentParameter(16, nameof(BzCheckbox.CheckedChanged),
                EventCallback.Factory.Create<CheckedState>(this, _ => ToggleRow(item)));
            builder.AddAttribute(17, "aria-label", SelectRowAriaLabel);
            builder.CloseComponent();
            builder.CloseElement();
        }

        for (var c = 0; c < columns.Count; c++)
        {
            var column = columns[c];
            builder.OpenElement(18, "td");
            builder.AddAttribute(19, "data-slot", "table-cell");
            builder.AddAttribute(20, "class", cellClasses[c]);
            // A pinned cell: where it stays (the script measures the offsets) and, on the group's
            // inner edge, the divider.
            if (frame?.Pin[c] is { } pin)
            {
                builder.AddAttribute(21, "data-pinned", pin);
                builder.AddAttribute(22, "style", frame.PinInset[c]);
                if (frame.Edge[c] is { } edge) builder.AddAttribute(23, "data-pinned-edge", edge);
            }

            if (!editing)
            {
                // The read-only path: frames identical to a table without editing.
                if (column.EdgeToEdge)
                {
                    // The content spans the cell (bz-table-cell-fill).
                    builder.OpenElement(24, "div");
                    builder.AddAttribute(25, "class", "bz-table-cell-fill");
                    builder.AddContent(26, column.RenderCell(item, default));
                    builder.CloseElement();
                }
                else builder.AddContent(27, column.RenderCell(item, default));
                builder.CloseElement();
                continue;
            }

            var editor = column.Editor;
            var key = column.Key;
            var editingCell = rowEditing && editor is not null &&
                (session!.Mode == DataTableEditMode.Row || session.FocusKey == key);
            var error = editingCell ? session!.Errors.GetValueOrDefault(key) : null;
            var mark = _cellMarks.Count > 0 ? MarkOf(item, key) : default;
            var pending = mark.Pending > 0 || (editingCell && session!.Busy);
            var state = new DataTableCellState(sessionRow, error ?? mark.Error, pending);

            // The grid's first tab stop, rendered here so Tab reaches the table before its script
            // has attached; from then on the script roves it (and drops copies a re-render adds).
            if (index == 0 && c == 0) builder.AddAttribute(28, "tabindex", "0");
            if (editingCell) builder.AddAttribute(29, "data-editing", "");
            if (pending) builder.AddAttribute(30, "data-pending", "");
            if (error is not null || mark.Error is not null)
            {
                builder.AddAttribute(31, "data-invalid", "");
                builder.AddAttribute(32, "aria-invalid", "true");
            }
            if (!editingCell && mark.Error is not null) builder.AddAttribute(33, "title", mark.Error);
            // Save, Cancel or a consumer's own action: the grid script keeps them inside the row's edit.
            if (column.EditActions) builder.AddAttribute(34, "data-bz-edit-actions", "");

            builder.AddContent(35, editingCell
                ? RenderCellEditor(item, column, editor!, key, c, session!, error, state)
                : RenderDisplay(item, column, editor, state));
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private static readonly string SelectCellClasses = Tw.Merge("bz-table-cell", "bz-table-select-cell");

    // ---- editing: ts/dataTable.ts drives the keyboard, this side owns the data ----

    private bool _editing;
    private DataTableEditSession<TItem>? _edit;
    // The form's session outlives _edit by the dialog's or drawer's exit animation, so its fields
    // stay drawn.
    private DataTableEditSession<TItem>? _dialogSession;
    // Previous / Next: the form saves one row and opens the next without closing in between.
    private bool _moving;
    private string? _liveMessage;
    // OnEdit re-renders the parent, which sets this table's parameters again: while one runs (or
    // until that render lands) the rows keep their order instead of re-sorting under the cursor.
    private int _editEcho;
    private bool _editEchoPending;
    private IEnumerable<TItem>? _lastItems;
    private int _lastItemsCount = -1;
    private readonly Dictionary<(object? Row, string Column), CellMark> _cellMarks = [];
    private BzVirtualizer<TItem>? _virtualizer;

    private readonly record struct CellMark(int Pending, string? Error);

    private readonly record struct CellWrite(TItem Item, IGridColumn<TItem> Column, object? Value);

    private readonly record struct PendingWrite(TItem Item, IGridColumn<TItem> Column, string Key, object? Old, object? New);

    private readonly record struct CommitOutcome(bool Ok, string? FocusKey = null, string? Message = null);

    /// <summary>
    /// Opens the editor on <paramref name="item"/>: in Cell mode the cell in
    /// <paramref name="columnKey"/> (by default the first editable column), in the other modes the
    /// row, focusing that column's field. For a row action ("Edit"), or right after adding a row.
    /// </summary>
    public async Task BeginEditAsync(TItem item, string? columnKey = null)
    {
        var column = columnKey is null ? null : _effectiveColumns.Find(c => c.Key == columnKey);
        if (EditMode == DataTableEditMode.Cell)
            column ??= VisibleColumns.Find(c => c.Editor is { } e && !FlipsInPlace(e));
        // Row mode: the editor of the column asked for takes the focus (else the grid script picks
        // the cursor's column or the row's first).
        Action<DataTableEditSession<TItem>>? prepare = EditMode == DataTableEditMode.Row && column?.Editor is not null
            ? session => session.FocusRequested = true
            : null;
        if (!await OpenEditAsync(item, column, new(DataTableEditStart.Code, null, false), prepare)) return;

        // A virtualized row outside the window: scroll it in, so its editor renders (the grid script
        // then focuses it).
        if (EditMode is DataTableEditMode.Cell or DataTableEditMode.Row && Virtualize && !Paged && _virtualizer is not null)
        {
            var index = _view.FindIndex(row => SameRow(row, item));
            if (index >= 0) await _virtualizer.ScrollToIndexAsync(index);
        }
    }

    /// <summary>
    /// Commits the open edit, as Enter (or the form's Save) would. Returns <see langword="false"/>
    /// when nothing is open or a value is invalid; the editor then stays open, showing why.
    /// </summary>
    public async Task<bool> CommitEditAsync()
    {
        if (_edit is not { } session) return false;
        Dictionary<string, string?>? values = null;
        if (!session.InForm && _grid.IsCreated)
        {
            try
            {
                // The built-in editors hold their text in the browser until a commit sends it.
                values = await _grid.InvokeAsync<Dictionary<string, string?>>("values");
            }
            catch (JSDisconnectedException)
            {
                return false;
            }
        }
        return (await CommitSessionAsync(session, values)).Ok;
    }

    /// <summary>Closes the open edit without saving it (a form too, without asking).</summary>
    public Task CancelEditAsync()
    {
        if (_edit is not { } session) return Task.CompletedTask;
        CloseEdit(session);
        return Task.CompletedTask;
    }

    /// <summary>Whether <paramref name="item"/>'s row (or one of its cells) has an editor open.</summary>
    public bool IsEditing(TItem item) => _edit is { } session && SameRow(item, session.Item);

    // The row's save is running (OnEdit has not returned): its edit actions wait.
    internal bool IsBusy(TItem item) => _edit is { Busy: true } session && SameRow(item, session.Item);

    // ---- interop: called by ts/dataTable.ts ----

    /// <summary>
    /// Called by the keyboard grid to open an editor on a cell (<paramref name="col"/> is its cell
    /// index). <paramref name="start"/> says how: <c>pointer</c>, <c>key</c> or <c>typing</c>
    /// (<paramref name="seed"/> then holds the typed text); <paramref name="popup"/> asks for the
    /// editor's list or calendar open. Returns whether one opened.
    /// </summary>
    [JSInvokable]
    public Task<bool> BeginEdit(int row, int col, string? seed, string? start, bool popup)
    {
        if (!TryCell(row, col, out var item, out var column)) return Task.FromResult(false);
        var how = start switch
        {
            "pointer" => DataTableEditStart.Pointer,
            "typing" => DataTableEditStart.Typing,
            _ => DataTableEditStart.Key,
        };
        return OpenEditAsync(item, column, new(how, how == DataTableEditStart.Typing ? seed ?? "" : null, popup));
    }

    /// <summary>
    /// Called by the keyboard grid to commit (<paramref name="commit"/>) or cancel the open edit;
    /// <paramref name="values"/> carries the built-in editors' text by column key. The result's
    /// <c>ok</c> is false when a value is invalid: the editor stays open and <c>focus</c> names the
    /// first invalid column. With <paramref name="discardOnError"/> (focus left the table) an
    /// invalid edit is dropped instead.
    /// </summary>
    [JSInvokable]
    public async Task<object> EndEdit(bool commit, Dictionary<string, string?>? values, bool discardOnError)
    {
        if (_edit is not { } session) return EditAccepted;
        if (!commit)
        {
            CloseEdit(session);
            return EditAccepted;
        }

        var outcome = await CommitSessionAsync(session, values);
        if (outcome.Ok) return EditAccepted;
        if (discardOnError && ReferenceEquals(_edit, session) && !session.Busy)
        {
            _liveMessage = $"{outcome.Message} {EditDiscardedMessage}";
            _edit = null;
            StateHasChanged();
            return EditAccepted;
        }
        return new { ok = false, focus = outcome.FocusKey };
    }

    private static readonly object EditAccepted = new { ok = true, focus = (string?)null };

    /// <summary>Called by the keyboard grid when Space flips a bool cell.</summary>
    [JSInvokable]
    public Task Toggle(int row, int col) =>
        TryCell(row, col, out var item, out var column) && column?.Editor is { Kind: DataTableEditor.Checkbox or DataTableEditor.Switch }
            ? ToggleCellAsync(item, column, DataTableEditStart.Key)
            : Task.CompletedTask;

    /// <summary>Called by the keyboard grid when Delete clears a cell (Cell mode).</summary>
    [JSInvokable]
    public Task Clear(int row, int col)
    {
        if (EditMode != DataTableEditMode.Cell || !TryCell(row, col, out var item, out var column) ||
            column?.Editor is not { } editor || !editor.TryGetClearValue(out var cleared))
            return Task.CompletedTask;
        ApplyCells(DataTableEditReason.Clear, [new CellWrite(item, column, cleared)], leadError: null);
        return Task.CompletedTask;
    }

    /// <summary>
    /// Called by the keyboard grid with pasted text (Cell mode): one value, or a tab-separated block
    /// copied from a spreadsheet, filled rightwards and down from the cell at
    /// (<paramref name="row"/>, <paramref name="col"/>). Cells past the table's edges, read-only
    /// columns and values that do not parse are skipped; the rest commit as one OnEdit.
    /// </summary>
    [JSInvokable]
    public Task Paste(int row, int col, string text)
    {
        if (EditMode != DataTableEditMode.Cell || !_editing) return Task.CompletedTask;
        var rows = NavRows;
        var columns = VisibleColumns;
        var first = col - (Selectable ? 1 : 0);
        if (row < 0 || row >= rows.Count || first < 0 || first >= columns.Count) return Task.CompletedTask;

        var block = TabSeparatedText.Parse(text);
        var writes = new List<CellWrite>();
        string? firstError = null;
        for (var r = 0; r < block.Count && row + r < rows.Count; r++)
        {
            var item = rows[row + r];
            for (var c = 0; c < block[r].Count && first + c < columns.Count; c++)
            {
                var column = columns[first + c];
                if (column.Editor is not { } editor) continue;
                if (editor.TryParse(block[r][c], column.Title ?? column.Key, EditParseErrorMessage, out var value, out var error))
                    writes.Add(new CellWrite(item, column, value));
                else
                    firstError ??= error;
            }
        }
        ApplyCells(DataTableEditReason.Paste, writes, firstError);
        return Task.CompletedTask;
    }

    // ---- the edit pipeline ----

    private async Task<bool> OpenEditAsync(TItem item, IGridColumn<TItem>? column, DataTableEditActivation activation,
        Action<DataTableEditSession<TItem>>? prepare = null)
    {
        if (!_editing) return false;
        if (_edit is { } open)
        {
            if (open.Busy) return false;
            // A leftover edit (its editor scrolled away uncommitted): settle it first.
            if (!(await CommitSessionAsync(open, values: null)).Ok) _edit = null;
        }

        var editor = column?.Editor;
        // Typing over a pick list opens its list (the script types the keys into it, so the
        // highlight jumps to the first option they begin). A form never opens a popup by itself, and
        // typing never opens a form.
        var form = EditMode is DataTableEditMode.Dialog or DataTableEditMode.Drawer;
        var pickList = editor is { HasTemplate: false, Kind: DataTableEditor.Select };
        var hasPopup = pickList || editor is { HasTemplate: true } or { Kind: DataTableEditor.Date };
        activation = activation with
        {
            TypedText = form || editor is null ? null : activation.TypedText,
            OpenPopup = !form && hasPopup && (activation.OpenPopup || (pickList && activation.Start == DataTableEditStart.Typing)),
        };

        DataTableEditSession<TItem> session;
        if (EditMode == DataTableEditMode.Cell)
        {
            // A bool cell flips in place (Toggle) instead of opening an editor.
            if (column is null || editor is null || FlipsInPlace(editor)) return false;
            session = new(item, EditMode, column.Key, activation);
        }
        else
        {
            var focus = editor is not null ? column!.Key : EditColumns(EditMode).FirstOrDefault()?.Key;
            if (focus is null) return false;
            session = new(item, EditMode, focus, activation);
            if (form) _dialogSession = session;
        }

        prepare?.Invoke(session);
        _edit = session;
        StateHasChanged();
        return true;
    }

    // Parse, validate and write every changed field of the session, then raise OnEdit: in the
    // background for Cell mode (the cursor moves on), awaited for the other modes (a rejected
    // save keeps the editor open with its drafts).
    private async Task<CommitOutcome> CommitSessionAsync(DataTableEditSession<TItem> session, IReadOnlyDictionary<string, string?>? values)
    {
        if (session.Busy) return new(false);
        var item = session.Item;
        session.Errors.Clear();
        session.Message = null;

        var writes = new List<PendingWrite>();
        foreach (var column in SessionColumns(session))
        {
            var editor = column.Editor!;
            var key = column.Key;
            var title = column.Title ?? key;
            object? next;
            string? error = null;
            if (values is not null && values.TryGetValue(key, out var text) && text is not null)
            {
                if (editor.Kind == DataTableEditor.Number) text = TypedNumber(text);
                if (!editor.TryParse(text, title, EditParseErrorMessage, out next, out error)) { session.Errors[key] = error; continue; }
            }
            else if (session.Drafts.TryGetValue(key, out var draft))
            {
                // A date or time field left half typed holds no value: a column that needs one refuses it.
                if (draft is null && !editor.AllowsNull)
                {
                    var kind = editor.Kind switch
                    {
                        DataTableEditor.Date => CellParseErrorKind.Date,
                        DataTableEditor.Time => CellParseErrorKind.Time,
                        _ => CellParseErrorKind.Required,
                    };
                    session.Errors[key] = new CellParseError(kind, title, []).Describe(EditParseErrorMessage);
                    continue;
                }
                next = draft;
            }
            else if (session.Texts.TryGetValue(key, out var draftText))
            {
                if (!editor.TryParse(draftText, title, EditParseErrorMessage, out next, out error)) { session.Errors[key] = error; continue; }
            }
            else
                continue; // untouched

            var old = editor.Read(item);
            if (editor.ValuesEqual(old, next)) continue;
            if (editor.Validate(item, next, title) is { } invalid)
            {
                session.Errors[key] = invalid;
                continue;
            }
            writes.Add(new PendingWrite(item, column, key, old, next));
        }

        if (session.Errors.Count > 0)
        {
            var (firstKey, firstMessage) = session.Errors.First();
            _liveMessage = firstMessage;
            StateHasChanged();
            return new(false, firstKey, firstMessage);
        }

        if (writes.Count == 0)
        {
            CloseEdit(session);
            return new(true);
        }

        Write(writes);
        var args = new DataTableEditEventArgs<TItem>(DataTableEditReason.Edit, ToChanges(writes));

        if (session.Mode == DataTableEditMode.Cell || !OnEdit.HasDelegate)
        {
            CloseEdit(session);
            if (OnEdit.HasDelegate) RaiseEditInBackground(args, writes);
            return new(true);
        }

        session.Busy = true;
        StateHasChanged();
        _editEcho++;
        _editEchoPending = true;
        try
        {
            await OnEdit.InvokeAsync(args);
        }
        catch
        {
            Rollback(writes);
            session.Busy = false;
            StateHasChanged();
            throw;
        }
        finally
        {
            _editEcho--;
        }
        session.Busy = false;

        if (args.Rejected)
        {
            Rollback(writes);
            foreach (var change in args.Changes)
            {
                if (args.MessageFor(change) is { } pinned) session.Errors[change.ColumnKey] = pinned;
            }
            session.Message = args.Message ?? EditRejectedMessage;
            _liveMessage = session.Message;
            StateHasChanged();
            return new(false, session.Errors.Keys.FirstOrDefault(), session.Message);
        }

        CloseEdit(session);
        return new(true);
    }

    private void CloseEdit(DataTableEditSession<TItem> session)
    {
        if (ReferenceEquals(_edit, session))
        {
            _edit = null;
            // A form closing for good (not moving to the next row): the focus goes back to the row's
            // cell once the surface has gone.
            if (session.InForm && !_moving) _ = FormClosedAsync(session);
        }
        StateHasChanged();
    }

    // Changes that never open an editor: a toggled bool, a paste, a clear.
    private void ApplyCells(DataTableEditReason reason, IReadOnlyList<CellWrite> cells, string? leadError)
    {
        var writes = new List<PendingWrite>();
        var firstError = leadError;
        foreach (var (item, column, value) in cells)
        {
            var editor = column.Editor!;
            var key = column.Key;
            var old = editor.Read(item);
            if (editor.ValuesEqual(old, value)) continue;
            if (editor.Validate(item, value, column.Title ?? key) is { } invalid)
            {
                firstError ??= invalid;
                SetMarkError(item, key, invalid);
                continue;
            }
            writes.Add(new PendingWrite(item, column, key, old, value));
        }

        Write(writes);
        if (firstError is not null) _liveMessage = firstError;
        StateHasChanged();
        if (writes.Count > 0 && OnEdit.HasDelegate) RaiseEditInBackground(new(reason, ToChanges(writes)), writes);
    }

    private async Task ToggleCellAsync(TItem item, IGridColumn<TItem> column, DataTableEditStart start)
    {
        if (column.Editor is not { } editor) return;
        var flipped = editor.Read(item) is not true;
        if (EditMode == DataTableEditMode.Cell)
        {
            ApplyCells(DataTableEditReason.Edit, [new CellWrite(item, column, flipped)], leadError: null);
            return;
        }
        // The other modes: the press opens the mode's editor with the box already flipped.
        await OpenEditAsync(item, column, new(start, null, false), session => session.Drafts[column.Key] = flipped);
    }

    // Cell-mode saves run in the background: the cursor moves on while OnEdit works (a server round
    // trip, say), the cells carry data-pending meanwhile, and a Reject puts the old values back.
    private void RaiseEditInBackground(DataTableEditEventArgs<TItem> args, List<PendingWrite> writes)
    {
        foreach (var write in writes) AddPending(write.Item, write.Key, +1);
        _ = RunAsync();

        async Task RunAsync()
        {
            Exception? failure = null;
            _editEcho++;
            _editEchoPending = true;
            try
            {
                await OnEdit.InvokeAsync(args);
            }
            catch (Exception ex)
            {
                failure = ex;
            }
            finally
            {
                _editEcho--;
            }

            foreach (var write in writes) AddPending(write.Item, write.Key, -1);
            if (failure is not null || args.Rejected)
            {
                Rollback(writes);
                var message = failure is null ? args.Message ?? EditRejectedMessage : EditRejectedMessage;
                for (var i = 0; i < writes.Count; i++)
                    SetMarkError(writes[i].Item, writes[i].Key, args.MessageFor(args.Changes[i]) ?? message);
                _liveMessage = message;
            }
            StateHasChanged();
            if (failure is not null) await DispatchExceptionAsync(failure);
        }
    }

    private void Write(List<PendingWrite> writes)
    {
        foreach (var write in writes)
        {
            if (write.Column.Editor is { CanWrite: true } editor) editor.Write(write.Item, write.New);
            SetMarkError(write.Item, write.Key, null);
        }
    }

    // Put back what Write assigned, unless a later edit has changed the cell again since.
    private static void Rollback(List<PendingWrite> writes)
    {
        foreach (var write in writes)
        {
            if (write.Column.Editor is { CanWrite: true } editor && editor.ValuesEqual(editor.Read(write.Item), write.New))
                editor.Write(write.Item, write.Old);
        }
    }

    private static List<DataTableCellChange<TItem>> ToChanges(List<PendingWrite> writes) =>
        writes.ConvertAll(w => new DataTableCellChange<TItem>(w.Item, w.Key, w.Old, w.New));

    // The columns an edit spans. Row mode: the visible editable ones. A form (Dialog, Drawer): every
    // editable one, since a column hidden from the table is still part of the record.
    private IEnumerable<IGridColumn<TItem>> EditColumns(DataTableEditMode mode) =>
        (mode is DataTableEditMode.Dialog or DataTableEditMode.Drawer ? _effectiveColumns : VisibleColumns).Where(c => c.Editor is not null);

    private IEnumerable<IGridColumn<TItem>> SessionColumns(DataTableEditSession<TItem> session) =>
        session.Mode == DataTableEditMode.Cell
            ? _effectiveColumns.Where(c => c.Key == session.FocusKey && c.Editor is not null)
            : EditColumns(session.Mode);

    // Keep the open edit on its row's live instance (RowKey matches a replaced record), and drop it
    // once the row has left the view (filtered out, another page).
    private void SyncEditSession()
    {
        if (_edit is not { } session || session.Busy) return;
        foreach (var row in NavRows)
        {
            if (!SameRow(row, session.Item)) continue;
            session.Item = row;
            return;
        }
        _edit = null;
    }

    // The parent's answer to OnEdit, taken without re-sorting: replaced records slot in by RowKey.
    // A list that grew, shrank or (without a RowKey) was swapped runs the full pipeline instead.
    private void RefreshAfterEdit()
    {
        RebuildColumns();
        var items = Items as IReadOnlyCollection<TItem> ?? Items?.ToList() ?? [];
        if (items.Count != _lastItemsCount)
        {
            Recompute();
            return;
        }
        if (RowKey is null)
        {
            if (ReferenceEquals(Items, _lastItems)) ApplyPage();
            else Recompute();
            return;
        }

        var live = new Dictionary<object, TItem>();
        foreach (var item in items) live.TryAdd(RowKey(item), item);
        var kept = new List<TItem>(_view.Count);
        foreach (var row in _view)
        {
            if (live.TryGetValue(RowKey(row), out var current)) kept.Add(current);
        }
        if (kept.Count != _view.Count)
        {
            Recompute();
            return;
        }
        _view = kept;
        _lastItems = Items;
        ApplyPage();
    }

    private IReadOnlyList<TItem> NavRows => Virtualize && !Paged ? _view : _rendered;

    private bool TryCell(int row, int col, out TItem item, out IGridColumn<TItem>? column)
    {
        var rows = NavRows;
        if (row < 0 || row >= rows.Count)
        {
            item = default!;
            column = null;
            return false;
        }
        item = rows[row];
        var index = col - (Selectable ? 1 : 0);
        var columns = VisibleColumns;
        column = index >= 0 && index < columns.Count ? columns[index] : null;
        return true;
    }

    private bool SameRow(TItem a, TItem b) => _rowComparer.Equals(a, b);

    private object? RowIdentity(TItem item) => RowKey is { } key ? key(item) : item;

    private CellMark MarkOf(TItem item, string key) => _cellMarks.GetValueOrDefault((RowIdentity(item), key));

    private void AddPending(TItem item, string key, int delta)
    {
        var id = (RowIdentity(item), key);
        var mark = _cellMarks.GetValueOrDefault(id);
        StoreMark(id, mark with { Pending = Math.Max(0, mark.Pending + delta) });
    }

    private void SetMarkError(TItem item, string key, string? error)
    {
        var id = (RowIdentity(item), key);
        StoreMark(id, _cellMarks.GetValueOrDefault(id) with { Error = error });
    }

    private void StoreMark((object? Row, string Column) id, CellMark mark)
    {
        if (mark is { Pending: 0, Error: null }) _cellMarks.Remove(id);
        else _cellMarks[id] = mark;
    }

    private string AriaRowIndex(int index) =>
        ((Paged ? (CurrentPage - 1) * PageSize : 0) + index + 2).ToString(CultureInfo.InvariantCulture);

    private IReadOnlyDictionary<string, object> GridAttributes()
    {
        var attributes = new Dictionary<string, object> { ["role"] = "grid" };
        // Only part of the rows is in the page (virtualized or paged): say how many there are.
        if (Virtualize || Paged)
            attributes["aria-rowcount"] = ((ServerDriven ? _totalCount : _view.Count) + 1).ToString(CultureInfo.InvariantCulture);
        return attributes;
    }

    private static CheckedState ToChecked(object? value) =>
        value is true ? CheckedState.Checked : value is false ? CheckedState.Unchecked : CheckedState.Indeterminate;

    // A bool column without an editor template: its cells hold a checkbox or a switch that flips in
    // place in Cell mode (the other modes open their editor with it flipped).
    private static bool FlipsInPlace(IGridEditor<TItem> editor) =>
        editor is { HasTemplate: false, Kind: DataTableEditor.Checkbox or DataTableEditor.Switch };

    private static object? DraftValue(DataTableEditSession<TItem> session, IGridEditor<TItem> editor, string key) =>
        session.Drafts.TryGetValue(key, out var draft) ? draft : editor.Read(session.Item);

    private static string? DraftText(DataTableEditSession<TItem> session, IGridEditor<TItem> editor, string key) =>
        session.Texts.TryGetValue(key, out var text) ? text
        : editor.Format(session.Drafts.TryGetValue(key, out var draft) ? draft : editor.Read(session.Item));

    // Typing into a text box supersedes a draft code set for the same column.
    private static void WriteDraftText(DataTableEditSession<TItem> session, string key, string? text)
    {
        session.Texts[key] = text;
        session.Drafts.Remove(key);
    }

    // What a cell or row text box starts from, captured on its first render and kept for the session,
    // so a commit's write and a Reject's rollback never reset the text under the user's caret.
    private static string SeedText(DataTableEditSession<TItem> session, IGridEditor<TItem> editor, string key)
    {
        if (!session.Seeds.TryGetValue(key, out var seed))
            session.Seeds[key] = seed = editor.Format(editor.Read(session.Item));
        return seed;
    }

    // A template's binding stores its draft; the page that owns the template re-renders by itself.
    private static void SetDraft(DataTableEditSession<TItem> session, string key, object? value) =>
        session.Drafts[key] = value;

    // A template's context.Commit, or a pick from a cell's list, ends a cell edit (a row or dialog
    // commits as a whole elsewhere). Through the grid script, as Enter would: the focus goes back to
    // the cell before the editor, and the list that held the focus, are rendered away.
    private async Task CommitFromTemplateAsync()
    {
        if (_edit is not { Mode: DataTableEditMode.Cell }) return;
        if (!_grid.IsCreated)
        {
            await CommitEditAsync();
            return;
        }
        try
        {
            await _grid.InvokeVoidAsync("commit");
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone.
        }
    }

    // The editor kind the grid script works with: how keys act on the column's idle cells, and how it
    // reads an open editor (a text or number field's text travels with the commit; every other
    // control keeps its draft here).
    private static string JsKind(IGridEditor<TItem>? editor) => editor switch
    {
        null => "none",
        { HasTemplate: true } => "custom",
        { Kind: DataTableEditor.Text } => "text",
        { Kind: DataTableEditor.Number } => "number",
        { Kind: DataTableEditor.Select } => "select",
        { Kind: DataTableEditor.Checkbox } => "checkbox",
        { Kind: DataTableEditor.Switch } => "switch",
        { Kind: DataTableEditor.Date } => "date",
        { Kind: DataTableEditor.Time } => "time",
        _ => "none",
    };

    private string ErrorId(int columnIndex) => $"{_scrollId}-error-{columnIndex.ToString(CultureInfo.InvariantCulture)}";

    private string? HeadTabStop(bool editing, int cellIndex) =>
        editing && cellIndex == 0 && NavRows.Count == 0 ? "0" : null;

    // ---- cells and editors ----

    // An idle cell: a bool column's checkbox or switch, or the column's own content (with a pick
    // list's or a date's mark at its end).
    private RenderFragment RenderDisplay(TItem item, IGridColumn<TItem> column, IGridEditor<TItem>? editor, DataTableCellState state)
    {
        var content = editor is { HasDisplayTemplate: false } && FlipsInPlace(editor)
            ? RenderToggle(item, column, editor)
            : HasPickMark(editor) ? RenderWithPickMark(item, column, editor!, state) : column.RenderCell(item, state);
        return column.EdgeToEdge ? RenderFill(content) : content;
    }

    // EdgeToEdge: the content spans the cell, its root stretched to the cell's height.
    private static RenderFragment RenderFill(RenderFragment content) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "bz-table-cell-fill");
        builder.AddContent(2, content);
        builder.CloseElement();
    };

    // Cell and Row modes: a pick list's or a date's cells carry a chevron or calendar mark at their
    // end, shown on hover and on the active cell (CSS alone). A press on it opens the editor with its
    // list or calendar open (ts/dataTable.ts).
    private bool HasPickMark(IGridEditor<TItem>? editor) =>
        EditMode is DataTableEditMode.Cell or DataTableEditMode.Row &&
        editor is { HasTemplate: false, Kind: DataTableEditor.Select or DataTableEditor.Date };

    private RenderFragment RenderWithPickMark(TItem item, IGridColumn<TItem> column, IGridEditor<TItem> editor, DataTableCellState state) => builder =>
    {
        builder.AddContent(0, column.RenderCell(item, state));
        builder.OpenElement(1, "span");
        builder.AddAttribute(2, "class", "bz-table-cell-pick-mark");
        builder.AddAttribute(3, "data-bz-pick", editor.Kind == DataTableEditor.Date ? "date" : "select");
        builder.AddAttribute(4, "aria-hidden", "true");
        builder.OpenComponent<BzIcon>(5);
        builder.AddComponentParameter(6, nameof(BzIcon.Icon), editor.Kind == DataTableEditor.Date ? BzGlyphs.Calendar : BzGlyphs.ChevronDown);
        builder.AddComponentParameter(7, nameof(BzIcon.Class), "size-4");
        builder.CloseComponent();
        builder.CloseElement();
    };

    // The editing cell: its idle display kept underneath, invisible and inert (so the cell keeps its
    // width and the row its height), the editor laid over it, and the validation message below.
    private RenderFragment RenderCellEditor(TItem item, IGridColumn<TItem> column, IGridEditor<TItem> editor, string key,
        int columnIndex, DataTableEditSession<TItem> session, string? error, DataTableCellState state) => builder =>
    {
        var title = column.Title ?? key;
        var errorId = error is null ? null : ErrorId(columnIndex);
        var attributes = new Dictionary<string, object> { ["aria-label"] = title };
        if (errorId is not null)
        {
            attributes["aria-invalid"] = "true";
            attributes["aria-describedby"] = errorId;
        }
        var activation = session.ActivationFor(key);

        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "bz-table-cell-ghost");
        builder.AddAttribute(2, "aria-hidden", "true");
        builder.AddAttribute(3, "inert", true);
        builder.AddContent(4, RenderDisplay(item, column, editor, state));
        builder.CloseElement();

        // Keyed by the edit, so a new edit of the same cell starts a fresh control.
        builder.OpenElement(5, "div");
        builder.SetKey(session);
        builder.AddAttribute(6, "class", "bz-table-cell-editor");
        builder.AddAttribute(7, "data-bz-cell-editor", JsKind(editor));
        if (column.Align is "center" or "end") builder.AddAttribute(8, "data-align", column.Align);
        if (session.FocusRequested && key == session.FocusKey) builder.AddAttribute(9, "data-bz-focus", "");
        builder.AddContent(10, editor.HasTemplate
            ? editor.RenderTemplate(item, key, title, error, inDialog: false, activation, attributes,
                () => DraftValue(session, editor, key), value => SetDraft(session, key, value),
                CommitFromTemplateAsync, CancelEditAsync)
            : editor.RenderControl(new DataTableEditorRequest
            {
                Session = session,
                Title = title,
                Placement = session.Mode == DataTableEditMode.Row ? DataTableEditorPlacement.Row : DataTableEditorPlacement.Cell,
                Attributes = attributes,
                Align = column.Align,
                Activation = activation,
                Labels = EditorLabels,
                ReadValue = () => DraftValue(session, editor, key),
                WriteValue = value => session.Drafts[key] = value,
                ReadText = () => key == session.FocusKey && session.Seed is not null ? session.Seed : SeedText(session, editor, key),
                WriteText = text => WriteDraftText(session, key, text),
                Commit = CommitFromTemplateAsync,
            }));
        builder.CloseElement();

        if (error is not null)
        {
            builder.OpenElement(11, "span");
            builder.AddAttribute(12, "id", errorId);
            builder.AddAttribute(13, "class", "bz-table-cell-error");
            builder.AddContent(14, error);
            builder.CloseElement();
        }
    };

    // A bool cell that is not being edited: a checkbox or a switch. Cell mode flips it in place; the
    // other modes open their editor with it flipped.
    private RenderFragment RenderToggle(TItem item, IGridColumn<TItem> column, IGridEditor<TItem> editor) => builder =>
    {
        var value = editor.Read(item);
        var label = column.Title ?? column.Key;
        if (editor.Kind == DataTableEditor.Switch)
        {
            builder.OpenComponent<BzSwitch>(0);
            builder.AddComponentParameter(1, nameof(BzSwitch.Checked), value is true);
            builder.AddComponentParameter(2, nameof(BzSwitch.CheckedChanged),
                EventCallback.Factory.Create<bool>(this, _ => ToggleCellAsync(item, column, DataTableEditStart.Pointer)));
            builder.AddAttribute(3, "aria-label", label);
            builder.AddAttribute(4, "tabindex", "-1");
            builder.CloseComponent();
            return;
        }
        builder.OpenComponent<BzCheckbox>(5);
        builder.AddComponentParameter(6, nameof(BzCheckbox.Checked), ToChecked(value));
        builder.AddComponentParameter(7, nameof(BzCheckbox.CheckedChanged),
            EventCallback.Factory.Create<CheckedState>(this, _ => ToggleCellAsync(item, column, DataTableEditStart.Pointer)));
        builder.AddAttribute(8, "aria-label", label);
        builder.AddAttribute(9, "tabindex", "-1");
        builder.CloseComponent();
    };

    // ---- the form editor (Dialog and Drawer modes) ----

    // Open while a form edit is: also between two rows while Previous / Next moves on.
    private bool FormOpen => _edit is { InForm: true } || _moving;

    // Escape, the close button or a press outside: drop the draft, asking first when it changed.
    private Task OnFormOpenChanged(bool open) =>
        open || _edit is not { InForm: true } session ? Task.CompletedTask : CloseFormAsync(session, ask: true);

    private void OnFormExited()
    {
        if (_edit is not { InForm: true } && !_moving) _dialogSession = null;
    }

    private async Task SubmitFormAsync(DataTableEditSession<TItem> session)
    {
        if (ReferenceEquals(_edit, session)) await CommitSessionAsync(session, values: null);
    }

    private DataTableEditForm<TItem> FormContext(DataTableEditSession<TItem> session) => new(
        this,
        session,
        open: ReferenceEquals(_edit, session),
        EditColumns(session.Mode).Select(c => c.Key).ToList(),
        EventCallback.Factory.Create<bool>(this, OnFormOpenChanged));

    private IGridColumn<TItem> FormColumn(DataTableEditSession<TItem> session, string columnKey) =>
        EditColumns(session.Mode).FirstOrDefault(c => c.Key == columnKey)
        ?? throw new ArgumentException($"No editable column has the key {columnKey}.", nameof(columnKey));

    internal TValue GetFormValue<TValue>(DataTableEditSession<TItem> session, string columnKey)
    {
        var editor = FormColumn(session, columnKey).Editor!;
        if (session.Drafts.TryGetValue(columnKey, out var draft)) return draft is TValue typed ? typed : default!;
        if (session.Texts.TryGetValue(columnKey, out var text))
        {
            if (text is TValue same) return same;
            if (editor.TryParse(text, columnKey, null, out var parsed, out _) && parsed is TValue fromText) return fromText;
        }
        return editor.Read(session.Item) is TValue current ? current : default!;
    }

    internal void SetFormValue<TValue>(DataTableEditSession<TItem> session, string columnKey, TValue value)
    {
        var editor = FormColumn(session, columnKey).Editor!;
        var type = Nullable.GetUnderlyingType(editor.ValueType) ?? editor.ValueType;
        if (value is not null && !type.IsInstanceOfType(value))
            throw new ArgumentException(
                $"The {columnKey} column holds {editor.ValueType.Name} values, not {value.GetType().Name}.", nameof(value));
        session.Drafts[columnKey] = value;
        session.Texts.Remove(columnKey);
        session.Versions[columnKey] = session.Versions.GetValueOrDefault(columnKey) + 1;
    }

    internal RenderFragment FormField(DataTableEditSession<TItem> session, string columnKey) =>
        RenderFormField(session, FormColumn(session, columnKey));

    internal RenderFragment FormActions(DataTableEditSession<TItem> session) => RenderFormActions(session);

    internal async Task<bool> SaveFormAsync(DataTableEditSession<TItem> session) =>
        ReferenceEquals(_edit, session) && (await CommitSessionAsync(session, values: null)).Ok;

    // Whether any field of the form holds a value other than the row's: what the close guard asks about.
    internal bool HasChanges(DataTableEditSession<TItem> session)
    {
        foreach (var column in EditColumns(session.Mode))
        {
            var editor = column.Editor!;
            var key = column.Key;
            object? next;
            if (session.Drafts.TryGetValue(key, out var draft)) next = draft;
            else if (session.Texts.TryGetValue(key, out var text))
            {
                // Text that does not parse is still something the user typed.
                if (!editor.TryParse(text, key, null, out next, out _)) return true;
            }
            else continue;
            if (!editor.ValuesEqual(editor.Read(session.Item), next)) return true;
        }
        return false;
    }

    // Closes the form: at once when it holds nothing new (or ask is false); otherwise its footer
    // asks Discard or Keep editing, and a second close request answers Keep editing.
    internal Task CloseFormAsync(DataTableEditSession<TItem> session, bool ask)
    {
        if (!ReferenceEquals(_edit, session) || session.Busy) return Task.CompletedTask;
        if (ask && session.ConfirmingDiscard)
        {
            KeepEditing(session);
            return Task.CompletedTask;
        }
        if (ask && HasChanges(session))
        {
            session.ConfirmingDiscard = true;
            _liveMessage = EditFormDiscardQuestion;
            _ = InvokeGridAsync("rememberFocus");
            StateHasChanged();
            return Task.CompletedTask;
        }
        CloseEdit(session);
        return Task.CompletedTask;
    }

    internal void KeepEditing(DataTableEditSession<TItem> session)
    {
        if (!session.ConfirmingDiscard) return;
        session.ConfirmingDiscard = false;
        StateHasChanged();
        // Back to the field the user was in, or the footer's Cancel.
        _ = InvokeGridAsync("restoreFocus");
    }

    // The row before or after the form's, in the table's current order among the loaded rows.
    internal bool HasNeighbour(DataTableEditSession<TItem> session, int step) => TryNeighbour(session, step, out _);

    private bool TryNeighbour(DataTableEditSession<TItem> session, int step, out TItem neighbour)
    {
        var rows = NavRows;
        var index = IndexOfRow(session.Item);
        var next = index + step;
        if (index < 0 || next < 0 || next >= rows.Count)
        {
            neighbour = default!;
            return false;
        }
        neighbour = rows[next];
        return true;
    }

    private int IndexOfRow(TItem item)
    {
        var rows = NavRows;
        for (var i = 0; i < rows.Count; i++)
        {
            if (SameRow(rows[i], item)) return i;
        }
        return -1;
    }

    // Previous / Next: save this row (a refused save stays on it, showing why), then open the
    // neighbour in the same form, focused on the same field's column, without closing in between.
    internal async Task<bool> MoveFormAsync(DataTableEditSession<TItem> session, int step)
    {
        if (!ReferenceEquals(_edit, session) || session.Busy || !HasNeighbour(session, step)) return false;
        var column = session.FocusKey is { } key ? _effectiveColumns.Find(c => c.Key == key) : null;
        var start = session.Activation.Start;
        _moving = true;
        try
        {
            if (!(await CommitSessionAsync(session, values: null)).Ok) return false;
            // The rows may have been replaced in answer to OnEdit: find the neighbour again.
            if (!TryNeighbour(session, step, out var next))
            {
                _ = FormClosedAsync(session);
                return false;
            }
            return await OpenEditAsync(next, column, new(start, null, false), opened => opened.Moved = true);
        }
        finally
        {
            _moving = false;
            StateHasChanged();
        }
    }

    // The form closed for good: the grid puts its cursor on the row the form showed last and focuses
    // it once the surface has gone.
    private async Task FormClosedAsync(DataTableEditSession<TItem> session)
    {
        var index = IndexOfRow(session.Item);
        if (index >= 0) await InvokeGridAsync("formClosed", index);
    }

    private async Task InvokeGridAsync(string method, params object?[] args)
    {
        if (!_grid.IsCreated) return;
        try
        {
            await _grid.InvokeVoidAsync(method, args);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException or TaskCanceledException)
        {
            // Circuit gone, or the grid with it: focus is the browser's own business then.
        }
    }

    // The built-in dialog, or the consumer's EditDialogContent. The built-in one keeps its header and
    // footer in place while the fields scroll between them, however many columns there are.
    private RenderFragment RenderEditDialog => @<text>
        @if (EditDialogContent is not null)
        {
            if (_dialogSession is { } custom)
            {
                @EditDialogContent(FormContext(custom))
            }
        }
        else
        {
            <BzDialog Open="@FormOpen" OpenChanged="@OnFormOpenChanged">
                <BzDialogContent Class="bz-data-table-edit-dialog" OnExitComplete="@OnFormExited" CloseLabel="@EditFormCloseLabel">
                    <BzDialogHeader>
                        <BzDialogTitle>@EditFormTitle</BzDialogTitle>
                        @if (!string.IsNullOrEmpty(EditFormDescription))
                        {
                            <BzDialogDescription>@EditFormDescription</BzDialogDescription>
                        }
                    </BzDialogHeader>
                    @if (_dialogSession is { } session)
                    {
                        @* The form lays out as its two parts (display: contents): the field list, which
                           scrolls, and the footer, which stays put under it. *@
                        <form @key="session" class="bz-data-table-edit-form" novalidate
                              @onsubmit="@(() => SubmitFormAsync(session))" @onsubmit:preventDefault>
                            <div class="bz-data-table-edit-body scrollbar-thin">
                                @RenderFormFields(session)
                            </div>
                            <BzDialogFooter>
                                @RenderFormActions(session)
                            </BzDialogFooter>
                        </form>
                    }
                </BzDialogContent>
            </BzDialog>
        }
    </text>;

    // The built-in drawer, or the consumer's EditDrawerContent: the dialog's form in a sheet at the
    // inline-end edge, full width on narrow screens. Its header holds the title, Previous / Next and
    // the close button; the fields scroll between it and the footer.
    private RenderFragment RenderEditDrawer => @<text>
        @if (EditDrawerContent is not null)
        {
            if (_dialogSession is { } custom)
            {
                @EditDrawerContent(FormContext(custom))
            }
        }
        else
        {
            <BzSheet Open="@FormOpen" OpenChanged="@OnFormOpenChanged">
                <BzSheetContent Side="PanelSide.End" ShowCloseButton="false" OnExitComplete="@OnFormExited"
                                Class="bz-data-table-edit-drawer w-full gap-0 sm:max-w-md">
                    @if (_dialogSession is { } session)
                    {
                        var busy = session.Busy;
                        @* The sheet's own parts lay out with utilities (they beat the components layer). *@
                        <BzSheetHeader Class="bz-data-table-edit-drawer-header flex-row items-start">
                            <div class="bz-data-table-edit-drawer-heading">
                                <BzSheetTitle>@EditFormTitle</BzSheetTitle>
                                @if (!string.IsNullOrEmpty(EditFormDescription))
                                {
                                    <BzSheetDescription>@EditFormDescription</BzSheetDescription>
                                }
                            </div>
                            <div class="bz-data-table-edit-drawer-actions">
                                @RenderDrawerButton(EditFormPreviousLabel, BzGlyphs.ChevronUp, busy || !HasNeighbour(session, -1),
                                    () => MoveFormAsync(session, -1))
                                @RenderDrawerButton(EditFormNextLabel, BzGlyphs.ChevronDown, busy || !HasNeighbour(session, +1),
                                    () => MoveFormAsync(session, +1))
                                <BzSheetClose>
                                    <RenderAs Context="p">
                                        <BzButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" @attributes="p.Attributes">
                                            <BzIcon Icon="@BzGlyphs.X" />
                                            <span class="sr-only">@EditFormCloseLabel</span>
                                        </BzButton>
                                    </RenderAs>
                                </BzSheetClose>
                            </div>
                        </BzSheetHeader>
                        <form @key="session" class="bz-data-table-edit-form" novalidate
                              @onsubmit="@(() => SubmitFormAsync(session))" @onsubmit:preventDefault>
                            <div class="bz-data-table-edit-drawer-body scrollbar-thin">
                                @RenderFormFields(session)
                            </div>
                            <BzSheetFooter Class="bz-data-table-edit-drawer-footer flex-col-reverse sm:flex-row sm:justify-end">
                                @RenderFormActions(session)
                            </BzSheetFooter>
                        </form>
                    }
                </BzSheetContent>
            </BzSheet>
        }
    </text>;

    // Previous / Next in the drawer's header: an icon button named by its tooltip.
    private RenderFragment RenderDrawerButton(string label, Icon icon, bool disabled, Func<Task> move) => @<BzTooltip>
        <BzTooltipTrigger>
            <RenderAs Context="trigger">
                <BzButton Type="ButtonType.Button" Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" Disabled="@disabled"
                          aria-label="@label" OnClick="@move" @attributes="trigger.Attributes">
                    <BzIcon Icon="@icon" />
                </BzButton>
            </RenderAs>
        </BzTooltipTrigger>
        <BzTooltipContent>@label<BzTooltipArrow /></BzTooltipContent>
    </BzTooltip>;

    private RenderFragment RenderFormFields(DataTableEditSession<TItem> session) => @<text>
        @if (session.Message is not null)
        {
            <p class="bz-data-table-edit-message" role="alert">@session.Message</p>
        }
        <BzFieldGroup>
            @foreach (var column in EditColumns(session.Mode))
            {
                @RenderFormField(session, column)
            }
        </BzFieldGroup>
    </text>;

    // The footer's buttons: Cancel and Save, or, after a close was asked with changes in the form,
    // the question with Keep editing (which takes the focus) and Discard.
    private RenderFragment RenderFormActions(DataTableEditSession<TItem> session) => @<text>
        @if (session.ConfirmingDiscard)
        {
            <div class="bz-data-table-edit-confirm">
                <p class="bz-data-table-edit-confirm-text" role="alert">@EditFormDiscardQuestion</p>
                <div class="bz-data-table-edit-confirm-actions">
                    <BzButton Type="ButtonType.Button" Variant="ButtonVariant.Outline" data-bz-autofocus=""
                              OnClick="@(() => KeepEditing(session))">@EditFormKeepEditingLabel</BzButton>
                    <BzButton Type="ButtonType.Button" Variant="ButtonVariant.Destructive"
                              OnClick="@(() => CloseFormAsync(session, ask: false))">@EditFormDiscardLabel</BzButton>
                </div>
            </div>
        }
        else
        {
            <BzButton Type="ButtonType.Button" Variant="ButtonVariant.Outline" data-bz-edit-cancel=""
                      OnClick="@(() => CloseFormAsync(session, ask: true))">@EditFormCancelLabel</BzButton>
            <BzButton Type="ButtonType.Submit" Loading="@session.Busy">@EditFormSaveLabel</BzButton>
        }
    </text>;

    // One field of the form editor: label, control and message, wired by the Field family. A
    // checkbox or switch sits beside its label. The field of the column the edit started from takes
    // the focus (not after Previous / Next: the focus stays on the button).
    private RenderFragment RenderFormField(DataTableEditSession<TItem> session, IGridColumn<TItem> column) => @<text>
        @{
            var editor = column.Editor!;
            var key = column.Key;
            var title = column.Title ?? key;
            var error = session.Errors.GetValueOrDefault(key);
            var focus = key == session.FocusKey && !session.Moved;
            var inline = FlipsInPlace(editor);
        }
        <BzField Orientation="@(inline ? FieldOrientation.Horizontal : FieldOrientation.Vertical)" Error="@error">
            @if (!inline)
            {
                <BzFieldLabel>@title</BzFieldLabel>
            }
            <BzFieldControl Context="control">
                @if (editor.HasTemplate)
                {
                    <div class="bz-data-table-edit-field" data-bz-autofocus="@(focus ? "" : null)">
                        @(editor.RenderTemplate(session.Item, key, title, error, true, session.ActivationFor(key), control,
                            () => DraftValue(session, editor, key), value => SetDraft(session, key, value),
                            CommitFromTemplateAsync, () => CloseFormAsync(session, ask: true)))
                    </div>
                }
                else
                {
                    @(editor.RenderControl(new DataTableEditorRequest
                    {
                        Session = session,
                        Title = title,
                        Placement = DataTableEditorPlacement.Form,
                        Attributes = control,
                        Align = column.Align,
                        Focus = focus,
                        Activation = session.ActivationFor(key),
                        Version = session.Versions.GetValueOrDefault(key),
                        Labels = EditorLabels,
                        ReadValue = () => DraftValue(session, editor, key),
                        WriteValue = value => session.Drafts[key] = value,
                        ReadText = () => DraftText(session, editor, key),
                        WriteText = text => WriteDraftText(session, key, text),
                        Commit = () => Task.CompletedTask,
                    }))
                }
            </BzFieldControl>
            @if (inline)
            {
                <BzFieldLabel>@title</BzFieldLabel>
            }
            <BzFieldError />
        </BzField>
    </text>;

    // Above this row count an unpaged, non-virtualized table gets the one-time console warning.
    private const int LargeListWarnThreshold = 2000;
    private bool _largeListWarned;

    private RenderFragment EmptyRow(int colSpan) => ServerDriven && _loading
        ? LoadingRows(colSpan)
        : @<BzTableRow>
            <BzTableCell Class="bz-table-empty" Attributes="ColSpanAttributes(colSpan)">
                @(EmptyContent ?? DefaultEmpty)
            </BzTableCell>
        </BzTableRow>;

    // Custom LoadingContent keeps the single spanning cell; the default paints skeleton rows
    // shaped like the table (one bar per visible column, widths cycling), so the wait reads as
    // rows-on-their-way rather than a bare sentence.
    private RenderFragment LoadingRows(int colSpan) => LoadingContent is not null
        ? @<BzTableRow>
            <BzTableCell Class="bz-table-empty" Attributes="ColSpanAttributes(colSpan)">@LoadingContent</BzTableCell>
        </BzTableRow>
        : @<text>
            @{ var columnCount = colSpan - (Selectable ? 1 : 0); }
            @for (var r = 0; r < LoadingRowCount; r++)
            {
                <BzTableRow aria-hidden="true">
                    @if (Selectable)
                    {
                        <BzTableCell Class="@SelectCellClasses"><BzSkeleton Class="size-4 rounded-[4px]" /></BzTableCell>
                    }
                    @for (var c = 0; c < columnCount; c++)
                    {
                        <BzTableCell><BzSkeleton Class="@("h-4 " + SkeletonWidths[(r + c) % SkeletonWidths.Length])" /></BzTableCell>
                    }
                </BzTableRow>
            }
        </text>;

    // A paged table's skeleton matches the page it is about to show (capped so a 100-row page
    // doesn't paint a wall); unpaged loads suggest a handful of rows.
    private int LoadingRowCount => Paged ? Math.Min(PageSize, 8) : 5;

    private static readonly string[] SkeletonWidths = ["w-3/5", "w-4/5", "w-1/2", "w-2/3"];

    private static readonly RenderFragment DefaultEmpty = builder => builder.AddContent(0, "No results.");

    // ---- row-click delegation (ts/dataTable.ts) ----

    private ElementReference _root;
    private IJSObjectReference? _rowClicksModule;
    private readonly JsInstance _rowClicks = new();
    private readonly JsInstance _grid = new();
    private string? _gridSignature;
    private bool _gridCreating;
    private DotNetObjectReference<BzDataTable<TItem>>? _selfRef;
    private bool _rowClicksCreating;

    // The keyboard grid (ts/dataTable.ts createGrid): created on the first editable render, then told
    // only when its inputs change - the visible columns and their editor kinds, the mode, the
    // selection column and the row count. Never per keystroke or per move.
    private async Task SyncGridAsync()
    {
        var options = GridOptions(out var signature);
        if (_grid.IsCreated)
        {
            if (signature == _gridSignature) return;
            _gridSignature = signature;
            try
            {
                await _grid.InvokeVoidAsync("update", options);
            }
            catch (JSDisconnectedException)
            {
                // Circuit gone.
            }
            return;
        }
        if (_gridCreating) return;
        _gridCreating = true;
        try
        {
            RequireWritableOrOnEdit();
            _selfRef ??= DotNetObjectReference.Create(this);
            _rowClicksModule ??= await JsModules.ImportAsync(Js, "./_content/blaizio.base/dist/dataTable.js");
            _gridSignature = signature;
            await _grid.CreateAsync(_rowClicksModule, "createGrid", _root, _selfRef, options);
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone before the wiring landed.
        }
        finally
        {
            _gridCreating = false;
        }
    }

    private object GridOptions(out string signature)
    {
        var columns = VisibleColumns;
        var mode = EditMode switch
        {
            DataTableEditMode.Row => "row",
            DataTableEditMode.Dialog => "dialog",
            DataTableEditMode.Drawer => "drawer",
            _ => "cell",
        };
        var rowCount = NavRows.Count;
        // The characters that may start typing over a number cell in the current culture: digits,
        // the signs and the decimal separator.
        var format = CultureInfo.CurrentCulture.NumberFormat;
        var numberChars = "0123456789" + format.NegativeSign + format.PositiveSign + format.NumberDecimalSeparator;
        var list = new object[columns.Count];
        var key = new System.Text.StringBuilder().Append(mode).Append('|').Append(Selectable).Append('|').Append(rowCount)
            .Append('|').Append(numberChars).Append('|').Append(EditOnClick);
        for (var i = 0; i < columns.Count; i++)
        {
            var kind = JsKind(columns[i].Editor);
            list[i] = new { key = columns[i].Key, kind };
            key.Append('|').Append(columns[i].Key).Append(':').Append(kind);
        }
        signature = key.ToString();
        return new { mode, columns = list, selectable = Selectable, rowCount, numberChars, editOnClick = EditOnClick };
    }

    // The text of a number cell's field, as the cell parser must read it. The field is a
    // BzInputNumber: it never holds grouping, and it takes "." as the decimal point in every
    // culture, because numeric keypads send it. The cell parser also accepts grouping (pasted
    // "1.234,50" has to work), so where "." groups thousands a typed "1.5" would commit 15.
    // Same rule as the number field itself: a "." with no culture separator beside it is the
    // decimal point.
    private static string TypedNumber(string text)
    {
        var separator = CultureInfo.CurrentCulture.NumberFormat.NumberDecimalSeparator;
        return separator != "." && !text.Contains(separator, StringComparison.Ordinal)
            ? text.Replace(".", separator, StringComparison.Ordinal)
            : text;
    }

    // An editable column whose property has no setter (a record, an init or read-only property)
    // can only commit through OnEdit; without one every edit would silently snap back.
    private void RequireWritableOrOnEdit()
    {
        if (OnEdit.HasDelegate) return;
        var stuck = _effectiveColumns.Find(c => c.Editor is { CanWrite: false });
        if (stuck is not null)
            throw new InvalidOperationException(
                $"The {stuck.Title ?? stuck.Key} column is Editable, but its property has no setter the table can call (a record, an init or a read-only property). Handle the table's OnEdit and apply the change there.");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The batch is done: a column that changes from here on (one inside a component of your own
        // that renders by itself, say) gets its renders again.
        _columnRenders = 0;

        // Same dev-aid pattern as AriaDiagnostics: rendering every row of a large in-memory list
        // is superlinear in practice (GC pressure; docs/benchmarks.md) and both escape hatches
        // are one parameter away - warn once when the accidental default is hit.
        if (!_largeListWarned && !Virtualize && !Paged && _view.Count > LargeListWarnThreshold)
        {
            _largeListWarned = true;
            try
            {
                await Js.InvokeVoidAsync("console.warn",
                    $"Blaizio DataTable: rendering {_view.Count} rows without Virtualize or PageSize. " +
                    "Set Virtualize (windowed rows) or PageSize (paging) - a full render at this size is slow and allocation-heavy.");
            }
            catch (JSDisconnectedException)
            {
                // Circuit gone.
            }
        }

        // The column script first: it marks a table whose widths it lays out, which the editing grid
        // then leaves alone instead of pinning them for an edit.
        await SyncColumnsAsync();
        if (_editing) await SyncGridAsync();

        if (!RowsClickable || _rowClicks.IsCreated || _rowClicksCreating) return;
        _rowClicksCreating = true;

        try
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            _rowClicksModule ??= await JsModules.ImportAsync(Js, "./_content/blaizio.base/dist/dataTable.js");
            await _rowClicks.CreateAsync(_rowClicksModule, "createRowClicks", _root, _selfRef);
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone before the wiring landed.
        }
        finally
        {
            _rowClicksCreating = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();

        // The row-clicks and grid INSTANCES are ours; the module is the shared JsModules proxy.
        await _rowClicks.DisposeAsync();
        await _grid.DisposeAsync();
        await _columns.DisposeAsync();

        _selfRef?.Dispose();
    }

    private static string ColumnClass(IGridColumn<TItem> col, bool header)
    {
        var align = col.Align switch
        {
            "center" => "text-center",
            "end" => "text-end",
            _ => null,
        };
        return Tw.Merge(align, header ? col.HeaderClass : col.CellClass);
    }

    private bool RowsClickable => Selectable || OnRowClick.HasDelegate;

    /// <summary>Called by the row-click module with the clicked row's index. Toggles selection and raises <see cref="OnRowClick"/>.</summary>
    [JSInvokable]
    public async Task HandleRowClick(int index)
    {
        var rows = Virtualize && !Paged ? (IReadOnlyList<TItem>)_view : _rendered;
        if (index < 0 || index >= rows.Count) return;

        var item = rows[index];
        // In an editable table a click puts the cursor on a cell; selection stays with the
        // checkbox and Shift+Space, or every click on a cell would flip it.
        if (Selectable && !_editing) await ToggleRow(item);
        if (OnRowClick.HasDelegate) await OnRowClick.InvokeAsync(item);
    }

    private static IReadOnlyDictionary<string, object> ColSpanAttributes(int colSpan) =>
        new PropBuilder().Set("colspan", colSpan.ToString(CultureInfo.InvariantCulture)).Merge(null);

    private RenderFragment RenderColumnToggle => @<BzDropdownMenu>
        <BzDropdownMenuTrigger>
            <RenderAs Context="p">
                <BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes" Class="bz-data-table-columns-trigger">
                    <BzIcon Icon="@BzGlyphs.Adjustments" Class="size-4" />
                    <span>@ColumnToggleLabel</span>
                </BzButton>
            </RenderAs>
        </BzDropdownMenuTrigger>
        <BzDropdownMenuContent Class="w-44">
            @foreach (var col in _effectiveColumns.Where(c => !string.IsNullOrEmpty(c.Title) && (!c.RowEditsOnly || RowEditsShown)))
            {
                var key = col.Key;
                <BzDropdownMenuCheckboxItem Checked="@(!_hidden.Contains(key))"
                                          CheckedChanged="@(v => SetColumnVisible(key, v))"
                                          OnSelect="@(e => e.PreventDefault())">
                    @col.Title
                </BzDropdownMenuCheckboxItem>
            }
        </BzDropdownMenuContent>
    </BzDropdownMenu>;

    private static string Px(double value) => value.ToString("0.###", CultureInfo.InvariantCulture) + "px";

    private sealed class KeyComparer(Func<TItem, object> key) : IEqualityComparer<TItem>
    {
        public bool Equals(TItem? a, TItem? b) =>
            a is null || b is null ? ReferenceEquals(a, b) : Equals(key(a), key(b));

        public int GetHashCode(TItem obj) => key(obj)?.GetHashCode() ?? 0;
    }
}
