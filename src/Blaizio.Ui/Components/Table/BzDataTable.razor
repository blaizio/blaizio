@namespace Blaizio.Ui
@typeparam TItem
@attribute [CascadingTypeParameter(nameof(TItem))]
@inject IJSRuntime Js
@implements IAsyncDisposable
@using System.Globalization
@*
    BzDataTable<TItem> - the headless data-grid surface built on the styled Table primitives, the way a
    headless table engine drives a plain HTML table. Define columns either as child
    <BzPropertyColumn>/<BzTemplateColumn> (they
    cascade TItem and register in document order) or via the Columns list. Gives single-column sorting
    (header click cycles asc → desc → off), a search filter across the searchable columns, a
    column-visibility menu, optional row selection, and - the headline - optional WINDOW virtualization
    with no height restriction: set Virtualize and the body mounts only the rows in view (ItemSize =
    fixed estimate, DynamicRowHeight to measure variable rows) while the page itself scrolls.
*@

@* Columns register through this cascade; the fragment itself renders nothing visible. *@
<CascadingValue Value="this" IsFixed="true">
    @ChildContent
</CascadingValue>

@{
    var columns = VisibleColumns;
    var colSpan = columns.Count + (Selectable ? 1 : 0);
}

<div @ref="_root" @attributes="RootAttributes()">
    @if (ShowToolbar)
    {
        <div class="bz-data-table-toolbar">
            @if (Searchable)
            {
                <BzInputText Type="search" Value="@_filter.Value" ValueChanged="@OnSearchChanged"
                           placeholder="@SearchPlaceholder" Class="bz-data-table-search" aria-label="@SearchPlaceholder" />
            }
            <div class="bz-data-table-toolbar-end">
                @Toolbar
                @if (ColumnToggle)
                {
                    @RenderColumnToggle
                }
            </div>
        </div>
    }

    <BzTable ContainerClass="@ResolveContainerClass()" ContainerId="@(Scrollable ? _scrollId : null)" ContainerStyle="@ResolveContainerStyle()"
             ContainerFocusable="@(Scrollable || Virtualize)">
        @if (Caption is not null)
        {
            <BzTableCaption>@Caption</BzTableCaption>
        }
        <BzTableHeader Class="@(StickyHeader ? "bz-table-sticky" : null)">
            <BzTableRow>
                @if (Selectable)
                {
                    <BzTableHead Class="bz-table-select-cell">
                        <BzCheckbox Checked="@SelectAllState" CheckedChanged="@(_ => ToggleAll())" aria-label="Select all rows" />
                    </BzTableHead>
                }
                @foreach (var col in columns)
                {
                    <BzTableHead Class="@ColumnClass(col, header: true)" aria-sort="@AriaSort(col)">
                        @RenderHeader(col)
                    </BzTableHead>
                }
            </BzTableRow>
        </BzTableHeader>

        @if (Virtualize && !Paged)
        {
            @* The row virtualizer is the standalone BzVirtualizer<TItem>; here it drives the table body
               (Element="tbody") with tr/td spacers. RenderBodyRow still tags each row with its virtual index
               + fixed-mode height, so the body row keeps its existing click / selection wiring.
               Paging and virtualizing are alternatives, so a paged table takes the plain-body path. *@
            <BzVirtualizer TItem="TItem" Element="tbody" Class="bz-table-body"
                         Items="_view" ItemSize="@ItemSize" Dynamic="@DynamicRowHeight"
                         Overscan="@Overscan" Viewport="@(Scrollable ? "#" + _scrollId : null)">
                <ChildContent Context="row">
                    @RenderBodyRow(row.Item, row.Index, columns)
                </ChildContent>
                <Spacer Context="height">
                    <tr aria-hidden="true" class="bz-table-spacer" style="height:@Px(height)">
                        <td colspan="@colSpan"></td>
                    </tr>
                </Spacer>
                <EmptyContent>
                    @EmptyRow(colSpan)
                </EmptyContent>
            </BzVirtualizer>
        }
        else
        {
            @* _rendered is the full view, or - when PageSize is set - just the current page's slice. *@
            <BzTableBody>
                @if (_rendered.Count == 0)
                {
                    @EmptyRow(colSpan)
                }
                else
                {
                    @for (var i = 0; i < _rendered.Count; i++)
                    {
                        @RenderBodyRow(_rendered[i], i, columns)
                    }
                }
            </BzTableBody>
        }

        @if (FooterContent is not null)
        {
            <BzTableFooter>@FooterContent</BzTableFooter>
        }
    </BzTable>

    @if (Paged && PageCount > 1)
    {
        <div class="bz-data-table-pagination flex justify-end pt-4">
            @RenderPagination
        </div>
    }

    @if (Selectable && ShowSelectionSummary)
    {
        <div class="bz-data-table-status" aria-live="polite">
            @SelectedInViewCount of @_rendered.Count row(s) selected.
        </div>
    }
</div>

@code {
    /// <summary>The rows to display (in-memory). Ignored when <see cref="ItemsProvider"/> is set.</summary>
    [Parameter] public IEnumerable<TItem>? Items { get; set; }

    /// <summary>
    /// An async data source for server-side / on-demand rows. When set, it drives the grid instead of
    /// <see cref="Items"/>: sorting, the search filter and paging are delegated to the provider, which
    /// receives the current window + sort + filter and returns that page plus the total count. Pair with
    /// <see cref="PageSize"/> for server-side paging.
    /// </summary>
    [Parameter] public DataTableItemsProvider<TItem>? ItemsProvider { get; set; }

    /// <summary>Columns defined as data. Combine with, or use instead of, the child column components.</summary>
    [Parameter] public IReadOnlyList<DataTableColumn<TItem>>? Columns { get; set; }

    /// <summary>Child column components - <c>BzPropertyColumn</c> / <c>BzTemplateColumn</c>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Controlled sort. Use with <c>@bind-Sort</c>; <see langword="null"/> means natural order.</summary>
    [Parameter] public SortState? Sort { get; set; }

    /// <summary>Initial sort when uncontrolled.</summary>
    [Parameter] public SortState? DefaultSort { get; set; }

    /// <summary>Raised with the new sort. Enables <c>@bind-Sort</c>.</summary>
    [Parameter] public EventCallback<SortState?> SortChanged { get; set; }

    /// <summary>Show a search box that filters across the searchable columns.</summary>
    [Parameter] public bool Searchable { get; set; }

    /// <summary>Placeholder for the search box. Defaults to "Search...".</summary>
    [Parameter] public string SearchPlaceholder { get; set; } = "Search...";

    /// <summary>Restrict the search to a single column (by its <c>Key</c>); when unset every searchable column is matched.</summary>
    [Parameter] public string? SearchColumn { get; set; }

    /// <summary>Controlled search text. Use with <c>@bind-Search</c>.</summary>
    [Parameter] public string? Search { get; set; }

    /// <summary>Initial search text when uncontrolled.</summary>
    [Parameter] public string? DefaultSearch { get; set; }

    /// <summary>Raised with the new search text. Enables <c>@bind-Search</c>.</summary>
    [Parameter] public EventCallback<string?> SearchChanged { get; set; }

    /// <summary>Show a "Columns" menu to toggle column visibility.</summary>
    [Parameter] public bool ColumnToggle { get; set; }

    /// <summary>Label for the column-visibility trigger. Defaults to "Columns".</summary>
    [Parameter] public string ColumnToggleLabel { get; set; } = "Columns";

    /// <summary>Add a leading checkbox column for row selection. Clicking a row (outside an interactive cell control) also toggles it.</summary>
    [Parameter] public bool Selectable { get; set; }

    /// <summary>The selected rows. Setting a new collection replaces the selection; changes raise <see cref="SelectedItemsChanged"/>.</summary>
    [Parameter] public IReadOnlyCollection<TItem>? SelectedItems { get; set; }

    /// <summary>Raised whenever the selection changes. Enables <c>@bind-SelectedItems</c>.</summary>
    [Parameter] public EventCallback<IReadOnlyCollection<TItem>> SelectedItemsChanged { get; set; }

    /// <summary>Identity key for a row, used to match selection across data reloads. Defaults to reference/Equals.</summary>
    [Parameter] public Func<TItem, object>? RowKey { get; set; }

    /// <summary>Show the "N of M row(s) selected" status line under the table. Defaults to <see langword="true"/> when <see cref="Selectable"/>.</summary>
    [Parameter] public bool ShowSelectionSummary { get; set; } = true;

    /// <summary>Mount only the rows in view, with NO height restriction (the page scrolls). See <see cref="ItemSize"/> / <see cref="DynamicRowHeight"/>.</summary>
    [Parameter] public bool Virtualize { get; set; }

    /// <summary>Row height in pixels: the exact uniform height in fixed mode, or the estimate in <see cref="DynamicRowHeight"/> mode. Defaults to <c>48</c>.</summary>
    [Parameter] public double ItemSize { get; set; } = 48;

    /// <summary>Measure each rendered row instead of assuming <see cref="ItemSize"/> - for variable-height rows.</summary>
    [Parameter] public bool DynamicRowHeight { get; set; }

    /// <summary>Extra rows to mount above/below the viewport when virtualizing. Defaults to <c>6</c>.</summary>
    [Parameter] public int Overscan { get; set; } = 6;

    /// <summary>Keep the header visible while scrolling (sticky to the top of the scroll viewport).</summary>
    [Parameter] public bool StickyHeader { get; set; }

    /// <summary>
    /// Constrain the table to a scroll box of this CSS height (e.g. <c>"24rem"</c>, <c>"400px"</c>) with its
    /// own scrollbar, instead of growing with the page. When virtualizing, the rows are measured against this
    /// box. Leave unset to virtualize against the window (no height restriction). Pair with <see cref="StickyHeader"/>.
    /// </summary>
    [Parameter] public string? MaxHeight { get; set; }

    /// <summary>Rows per page. Set above <c>0</c> to paginate (renders a pager below the table); <c>0</c> (the default) shows every row. An alternative to <see cref="Virtualize"/>, not combined with it.</summary>
    [Parameter] public int PageSize { get; set; }

    /// <summary>Controlled current page (1-based). Use with <c>@bind-Page</c>.</summary>
    [Parameter] public int Page { get; set; }

    /// <summary>Initial page when uncontrolled (1-based). Defaults to <c>1</c>.</summary>
    [Parameter] public int DefaultPage { get; set; } = 1;

    /// <summary>Raised with the new page. Enables <c>@bind-Page</c>.</summary>
    [Parameter] public EventCallback<int> PageChanged { get; set; }

    /// <summary>Extra toolbar content, placed beside the search box / column menu.</summary>
    [Parameter] public RenderFragment? Toolbar { get; set; }

    /// <summary>Footer rows (<c>tfoot</c>), e.g. a totals row.</summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }

    /// <summary>A caption rendered below the table.</summary>
    [Parameter] public RenderFragment? Caption { get; set; }

    /// <summary>What to show when there are no rows (after filtering). Defaults to "No results.".</summary>
    [Parameter] public RenderFragment? EmptyContent { get; set; }

    /// <summary>What to show while an <see cref="ItemsProvider"/> is loading the first rows. Defaults to "Loading...".</summary>
    [Parameter] public RenderFragment? LoadingContent { get; set; }

    /// <summary>Raised when a body row is clicked (anywhere outside an interactive cell control).</summary>
    [Parameter] public EventCallback<TItem> OnRowClick { get; set; }

    /// <summary>Returns an extra CSS class for a row based on its data, applied to that row's <c>tr</c>. Return <see langword="null"/> for none.</summary>
    [Parameter] public Func<TItem, string?>? RowClass { get; set; }

    /// <summary>Extra classes for the data-table wrapper.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the wrapper.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private readonly List<IGridColumn<TItem>> _registered = [];
    private List<IGridColumn<TItem>> _effectiveColumns = [];
    private readonly HashSet<string> _hidden = [];
    private readonly HashSet<string> _seenColumns = [];
    private readonly ControllableState<SortState?> _sort = new();
    private readonly ControllableState<string?> _filter = new();
    private readonly ControllableState<int> _page = new();
    private HashSet<TItem> _selected = [];
    private readonly string _scrollId = "bz-dt-scroll-" + Guid.NewGuid().ToString("N")[..8];
    private IEqualityComparer<TItem> _rowComparer = EqualityComparer<TItem>.Default;
    private Func<TItem, object>? _lastRowKey;
    private IReadOnlyCollection<TItem>? _lastSelectedParam;
    private List<TItem> _view = [];
    private IReadOnlyList<TItem> _rendered = [];
    private int _totalCount;
    private bool _loading;
    private string? _lastLoadKey;
    private CancellationTokenSource? _loadCts;

    // ---- registration (called by the child column components) ----

    internal void Register(IGridColumn<TItem> column)
    {
        _registered.Add(column);
        if (ServerDriven) RebuildColumns(); else Recompute();
        StateHasChanged();
    }

    internal void Unregister(IGridColumn<TItem> column)
    {
        if (_registered.Remove(column))
        {
            if (ServerDriven) RebuildColumns(); else Recompute();
            StateHasChanged();
        }
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(RowKey, _lastRowKey))
        {
            _lastRowKey = RowKey;
            _rowComparer = RowKey is null ? EqualityComparer<TItem>.Default : new KeyComparer(RowKey);
            _selected = new HashSet<TItem>(_selected, _rowComparer);
        }

        if (!ReferenceEquals(SelectedItems, _lastSelectedParam))
        {
            _lastSelectedParam = SelectedItems;
            if (SelectedItems is not null) _selected = new HashSet<TItem>(SelectedItems, _rowComparer);
        }

        _sort.Sync(SortChanged.HasDelegate, Sort, DefaultSort);
        _filter.Sync(SearchChanged.HasDelegate, Search, DefaultSearch);
        _page.Sync(PageChanged.HasDelegate, Page, DefaultPage);

        // In-memory: run the filter/sort/page pipeline now. Server-driven: just refresh the column set;
        // the data is fetched asynchronously in OnParametersSetAsync (and on sort/filter/page changes).
        if (ServerDriven) RebuildColumns();
        else Recompute();
    }

    protected override Task OnParametersSetAsync() => ServerDriven ? LoadAsync() : Task.CompletedTask;

    // ---- the processing pipeline: filter, then sort, materialised once per change ----

    private void Recompute()
    {
        RebuildColumns();

        IEnumerable<TItem> rows = Items ?? [];

        var query = _filter.Value;
        if (!string.IsNullOrWhiteSpace(query))
        {
            var targets = (string.IsNullOrEmpty(SearchColumn)
                ? _effectiveColumns.Where(c => c.Searchable)
                : _effectiveColumns.Where(c => c.Key == SearchColumn)).ToList();

            if (targets.Count > 0)
            {
                rows = rows.Where(item =>
                    targets.Any(c => (c.GetText(item) ?? string.Empty).Contains(query, StringComparison.OrdinalIgnoreCase)));
            }
        }

        if (_sort.Value is { } sort)
        {
            var col = _effectiveColumns.FirstOrDefault(c => c.Key == sort.ColumnKey && c.Sortable);
            if (col is not null)
            {
                var comparer = Comparer<TItem>.Create((a, b) => col.Compare(a, b));
                rows = sort.Direction == SortDirection.Ascending
                    ? rows.OrderBy(x => x, comparer)
                    : rows.OrderByDescending(x => x, comparer);
            }
        }

        _view = rows.ToList();
        ApplyPage();
    }

    // Slice the filtered+sorted view down to the current page (or pass it through when not paging).
    private void ApplyPage()
    {
        if (!Paged)
        {
            _rendered = _view;
            return;
        }

        var start = (CurrentPage - 1) * PageSize;
        _rendered = start >= _view.Count ? [] : _view.GetRange(start, Math.Min(PageSize, _view.Count - start));
    }

    private bool Paged => PageSize > 0;

    private bool ServerDriven => ItemsProvider is not null;

    // Total pages: the provider's total when server-driven, else the in-memory view size. At least 1 so
    // an empty paged table still reads as "page 1 of 1".
    private int PageCount
    {
        get
        {
            var total = ServerDriven ? _totalCount : _view.Count;
            return Paged && total > 0 ? (int)Math.Ceiling((double)total / PageSize) : 1;
        }
    }

    // The effective page. In-memory we clamp to the known page count (so a stale page after a shrink
    // still resolves); server-driven we trust the requested page until the total comes back.
    private int CurrentPage
    {
        get
        {
            var page = _page.Value < 1 ? 1 : _page.Value;
            return ServerDriven ? page : Math.Min(page, PageCount);
        }
    }

    // Fetch the current window from the provider: de-duplicates identical requests, cancels any in-flight
    // one (so a stale response can't overwrite a newer page), and tracks a loading flag for the empty row.
    private async Task LoadAsync()
    {
        if (ItemsProvider is null) return;

        var start = Paged ? (CurrentPage - 1) * PageSize : 0;
        var count = Paged ? PageSize : int.MaxValue;
        var key = string.Join('', start, count, _sort.Value?.ColumnKey, _sort.Value?.Direction, _filter.Value);
        if (key == _lastLoadKey) return;
        _lastLoadKey = key;

        _loadCts?.Cancel();
        var cts = _loadCts = new CancellationTokenSource();

        _loading = true;
        StateHasChanged();

        try
        {
            var result = await ItemsProvider(new DataTableRequest<TItem>(start, count, _sort.Value, _filter.Value, cts.Token));
            if (cts.Token.IsCancellationRequested) return;
            _rendered = result.Items;
            _totalCount = result.TotalCount;
            _loading = false;
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer request - a later load owns the loading flag + result.
        }
    }

    // The effective column list = data columns (Columns) then registered child columns; default-hidden
    // columns are folded into the hidden set the first time they appear.
    private void RebuildColumns()
    {
        _effectiveColumns = [];
        if (Columns is { Count: > 0 })
        {
            for (var i = 0; i < Columns.Count; i++) _effectiveColumns.Add(new DataTableColumnAdapter<TItem>(Columns[i], i));
        }
        _effectiveColumns.AddRange(_registered);

        foreach (var col in _effectiveColumns)
        {
            if (_seenColumns.Add(col.Key) && col.DefaultHidden) _hidden.Add(col.Key);
        }
    }

    private List<IGridColumn<TItem>> VisibleColumns =>
        _effectiveColumns.Where(c => !_hidden.Contains(c.Key)).ToList();

    private bool ShowToolbar => Searchable || ColumnToggle || Toolbar is not null;

    // A constrained scroll box (MaxHeight) gets its own scrollbar and becomes the virtualization viewport;
    // otherwise a virtualized table flows in the page (window viewport, no height restriction).
    private bool Scrollable => !string.IsNullOrEmpty(MaxHeight);

    private string? ResolveContainerClass() =>
        Scrollable ? "bz-table-container-scroll" : Virtualize ? "bz-table-container-virtual" : null;

    private string? ResolveContainerStyle() => Scrollable ? $"max-height:{MaxHeight}" : null;

    private IReadOnlyDictionary<string, object> RootAttributes() =>
        new PropBuilder().Data("slot", "data-table").Merge(Attributes, Tw.Merge("bz-data-table", Class));

    // ---- sorting ----

    private async Task ToggleSort(IGridColumn<TItem> col)
    {
        if (!col.Sortable) return;

        var current = _sort.Value;
        SortState? next =
            current is null || current.ColumnKey != col.Key ? new SortState(col.Key, SortDirection.Ascending)
            : current.Direction == SortDirection.Ascending ? current with { Direction = SortDirection.Descending }
            : null; // descending → clear

        await _sort.SetAsync(next, SortChanged);
        if (ServerDriven) await LoadAsync();
        else if (!_sort.IsControlled) Recompute();
        StateHasChanged();
    }

    private string? AriaSort(IGridColumn<TItem> col)
    {
        if (!col.Sortable || _sort.Value is not { } s || s.ColumnKey != col.Key) return col.Sortable ? "none" : null;
        return s.Direction == SortDirection.Ascending ? "ascending" : "descending";
    }

    private Icon SortIcon(IGridColumn<TItem> col)
    {
        if (_sort.Value is { } s && s.ColumnKey == col.Key)
            return s.Direction == SortDirection.Ascending ? Icons.Outline.ArrowUp : Icons.Outline.ArrowDown;
        return Icons.Outline.Selector;
    }

    // ---- searching ----

    private async Task OnSearchChanged(string? value)
    {
        await _filter.SetAsync(value, SearchChanged);
        await _page.SetAsync(1, PageChanged); // a new filter resets to the first page
        if (ServerDriven) await LoadAsync();
        else if (!_filter.IsControlled) Recompute();
        StateHasChanged();
    }

    // ---- paging ----

    private async Task GoToPage(int page)
    {
        var clamped = Math.Clamp(page, 1, PageCount);
        if (clamped == CurrentPage) return;
        await _page.SetAsync(clamped, PageChanged);
        if (ServerDriven) await LoadAsync();
        else if (!_page.IsControlled) ApplyPage();
        StateHasChanged();
    }

    // 1, the last page, and a sliding window around the current page; 0 stands in for an ellipsis.
    private IEnumerable<int> PageTokens()
    {
        var total = PageCount;
        var current = CurrentPage;
        var pages = new List<int> { 1 };
        var start = Math.Max(2, current - 1);
        var end = Math.Min(total - 1, current + 1);

        if (start > 2) pages.Add(0);
        for (var p = start; p <= end; p++) pages.Add(p);
        if (end < total - 1) pages.Add(0);
        if (total > 1) pages.Add(total);

        return pages;
    }

    private static string PageAriaLabel(int page) => $"Go to page {page}";

    private RenderFragment RenderPagination => @<BzPagination Class="mx-0 w-auto">
        <BzPaginationContent>
            <BzPaginationItem>
                <BzPaginationPrevious Disabled="@(CurrentPage == 1)" OnClick="@(() => GoToPage(CurrentPage - 1))" />
            </BzPaginationItem>
            @foreach (var token in PageTokens())
            {
                var n = token;
                <BzPaginationItem>
                    @if (n == 0)
                    {
                        <BzPaginationEllipsis />
                    }
                    else
                    {
                        <BzPaginationLink Active="@(n == CurrentPage)" OnClick="@(() => GoToPage(n))"
                                        AriaLabel="@PageAriaLabel(n)">@n</BzPaginationLink>
                    }
                </BzPaginationItem>
            }
            <BzPaginationItem>
                <BzPaginationNext Disabled="@(CurrentPage == PageCount)" OnClick="@(() => GoToPage(CurrentPage + 1))" />
            </BzPaginationItem>
        </BzPaginationContent>
    </BzPagination>;

    // ---- column visibility ----

    private void SetColumnVisible(string key, bool visible)
    {
        if (visible) _hidden.Remove(key);
        else _hidden.Add(key);
        StateHasChanged();
    }

    // ---- selection ----

    private bool IsSelected(TItem item) => _selected.Contains(item);

    private int SelectedInViewCount => _rendered.Count(IsSelected);

    private bool AllSelected => _rendered.Count > 0 && _rendered.All(IsSelected);

    private bool SomeSelected => !AllSelected && _rendered.Any(IsSelected);

    private CheckedState SelectAllState =>
        AllSelected ? CheckedState.Checked : SomeSelected ? CheckedState.Indeterminate : CheckedState.Unchecked;

    private async Task ToggleRow(TItem item)
    {
        if (!_selected.Add(item)) _selected.Remove(item);
        await SelectedItemsChanged.InvokeAsync(_selected.ToList());
        StateHasChanged();
    }

    private async Task ToggleAll()
    {
        if (AllSelected)
        {
            foreach (var item in _rendered) _selected.Remove(item);
        }
        else
        {
            foreach (var item in _rendered) _selected.Add(item);
        }
        await SelectedItemsChanged.InvokeAsync(_selected.ToList());
        StateHasChanged();
    }

    // ---- per-row / per-column rendering ----

    private RenderFragment RenderHeader(IGridColumn<TItem> col) => @<text>
        @if (col.Header is { } custom)
        {
            @custom
        }
        else if (col.Sortable)
        {
            <button type="button" class="bz-table-sort-button" @onclick="@(() => ToggleSort(col))">
                <span>@col.Title</span>
                <BzIcon Icon="@SortIcon(col)" Class="bz-table-sort-icon" />
            </button>
        }
        else
        {
            @col.Title
        }
    </text>;

    private RenderFragment RenderBodyRow(TItem item, int index, List<IGridColumn<TItem>> columns) => @<BzTableRow
        Active="@(Selectable && IsSelected(item))"
        Class="@RowClass?.Invoke(item)"
        Attributes="RowAttributes(item, index)">
        @if (Selectable)
        {
            <BzTableCell Class="bz-table-select-cell">
                <BzCheckbox Checked="@(IsSelected(item) ? CheckedState.Checked : CheckedState.Unchecked)"
                          CheckedChanged="@(_ => ToggleRow(item))" aria-label="Select row" />
            </BzTableCell>
        }
        @foreach (var col in columns)
        {
            <BzTableCell Class="@ColumnClass(col, header: false)">@col.RenderCell(item)</BzTableCell>
        }
    </BzTableRow>;

    private RenderFragment EmptyRow(int colSpan) => @<BzTableRow>
        <BzTableCell Class="bz-table-empty" Attributes="ColSpanAttributes(colSpan)">
            @(ServerDriven && _loading ? (LoadingContent ?? DefaultLoading) : (EmptyContent ?? DefaultEmpty))
        </BzTableCell>
    </BzTableRow>;

    private static readonly RenderFragment DefaultEmpty = builder => builder.AddContent(0, "No results.");
    private static readonly RenderFragment DefaultLoading = builder => builder.AddContent(0, "Loading...");

    // ---- row-click delegation (ts/dataTable.ts) ----

    private ElementReference _root;
    private IJSObjectReference? _rowClicksModule;
    private IJSObjectReference? _rowClicks;
    private DotNetObjectReference<BzDataTable<TItem>>? _selfRef;
    private bool _rowClicksCreating;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!RowsClickable || _rowClicks is not null || _rowClicksCreating) return;
        _rowClicksCreating = true;

        try
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            _rowClicksModule ??= await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/blaizio.base/dist/dataTable.js");
            _rowClicks = await _rowClicksModule.InvokeAsync<IJSObjectReference>(
                "createRowClicks", _root, _selfRef);
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone before the wiring landed.
        }
        finally
        {
            _rowClicksCreating = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();

        try
        {
            if (_rowClicks is not null)
            {
                await _rowClicks.InvokeVoidAsync("dispose");
                await _rowClicks.DisposeAsync();
            }
            if (_rowClicksModule is not null) await _rowClicksModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone.
        }

        _selfRef?.Dispose();
    }

    private static string ColumnClass(IGridColumn<TItem> col, bool header)
    {
        var align = col.Align switch
        {
            "center" => "text-center",
            "end" => "text-end",
            _ => null,
        };
        return Tw.Merge(align, header ? col.HeaderClass : col.CellClass);
    }

    private IReadOnlyDictionary<string, object>? RowAttributes(TItem item, int index)
    {
        if (!Virtualize && !RowsClickable) return null;

        var props = new PropBuilder(this);
        if (Virtualize)
        {
            props.Data("bz-virtual-index", index.ToString(CultureInfo.InvariantCulture));
            if (!DynamicRowHeight) props.Set("style", $"height:{Px(ItemSize)}");
        }
        // Row clicks are delegated in JS (ts/dataTable.ts), not a Blazor @onclick: only JS can see
        // the event target, and a click inside an interactive cell control (the selection checkbox,
        // a row-actions trigger, a link) must stay that control's click.
        if (RowsClickable) props.Data("bz-row-index", index.ToString(CultureInfo.InvariantCulture));

        return props.Merge(null);
    }

    private bool RowsClickable => Selectable || OnRowClick.HasDelegate;

    /// <summary>Called by the row-click module with the clicked row's index. Toggles selection and raises <see cref="OnRowClick"/>.</summary>
    [JSInvokable]
    public async Task HandleRowClick(int index)
    {
        var rows = Virtualize && !Paged ? (IReadOnlyList<TItem>)_view : _rendered;
        if (index < 0 || index >= rows.Count) return;

        var item = rows[index];
        if (Selectable) await ToggleRow(item);
        if (OnRowClick.HasDelegate) await OnRowClick.InvokeAsync(item);
    }

    private static IReadOnlyDictionary<string, object> ColSpanAttributes(int colSpan) =>
        new PropBuilder().Set("colspan", colSpan.ToString(CultureInfo.InvariantCulture)).Merge(null);

    private RenderFragment RenderColumnToggle => @<BzDropdownMenu>
        <BzDropdownMenuTrigger>
            <RenderAs Context="p">
                <BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes" Class="bz-data-table-columns-trigger">
                    <BzIcon Icon="@Icons.Outline.Adjustments" Class="size-4" />
                    <span>@ColumnToggleLabel</span>
                </BzButton>
            </RenderAs>
        </BzDropdownMenuTrigger>
        <BzDropdownMenuContent Class="w-44">
            @foreach (var col in _effectiveColumns.Where(c => !string.IsNullOrEmpty(c.Title)))
            {
                var key = col.Key;
                <BzDropdownMenuCheckboxItem Checked="@(!_hidden.Contains(key))"
                                          CheckedChanged="@(v => SetColumnVisible(key, v))"
                                          OnSelect="@(e => e.PreventDefault())">
                    @col.Title
                </BzDropdownMenuCheckboxItem>
            }
        </BzDropdownMenuContent>
    </BzDropdownMenu>;

    private static string Px(double value) => value.ToString("0.###", CultureInfo.InvariantCulture) + "px";

    private sealed class KeyComparer(Func<TItem, object> key) : IEqualityComparer<TItem>
    {
        public bool Equals(TItem? a, TItem? b) =>
            a is null || b is null ? ReferenceEquals(a, b) : Equals(key(a), key(b));

        public int GetHashCode(TItem obj) => key(obj)?.GetHashCode() ?? 0;
    }
}
