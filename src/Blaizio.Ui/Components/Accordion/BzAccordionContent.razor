@namespace Blaizio.Ui
@*
    Styled AccordionContent - the presence-managed panel. The outer element clips and animates
    (the skins' animate-accordion-down/up keyframes target the measured
    --bz-accordion-content-height); the inner div holds it at the measured height. Class lands
    on the inner div, matching upstream.
*@

<BaseAccordionContent Class="bz-accordion-content overflow-hidden"
                       Attributes="ForwardedAttributes()">
    <div class="@Tw.Merge(InnerClasses, Class)">
        @ChildContent
    </div>
</BaseAccordionContent>

@code {
    /// <summary>Extra classes for the inner content wrapper.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Panel content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the outer panel element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "accordion-content").Merge(Attributes);

    // Child combinator on purpose: these are prose conveniences for the content's own top-level
    // paragraphs and links. A descendant selector here reached into everything nested in the
    // panel - a card, a form, another accordion - and restyled markup it does not own.
    private const string InnerClasses =
        "bz-accordion-content-inner h-(--bz-accordion-content-height) " +
        "[&>a]:underline [&>a]:underline-offset-3 [&>a]:hover:text-foreground [&>p:not(:last-child)]:mb-4";
}
