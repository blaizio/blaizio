@namespace Blaizio.Ui
@implements IDisposable
@inject ICore Core
@*
    Styled text field - one control covering both single- and multi-line input (Blaizio merges the
    usual separate Input + Textarea into one smaller surface). It is single-line by default and switches to a
    multi-line <textarea> the moment a Rows count is given - so the mode is inferred, no extra flag. Like
    Button it is pure styling over the native element (no headless behaviour to factor out): structural
    utilities + the bz-input / bz-textarea hook, the style sheets carry the look (incl. the aria-invalid
    treatment FieldControl wires up). @bind-Value updates live (oninput), or after a typing pause when
    DebounceDelay is set. Validation-agnostic by design - pair with Field/FieldControl for forms.
*@

@if (Multiline)
{
    <textarea @ref="_element"
              value="@Value"
              rows="@Rows"
              placeholder="@Placeholder"
              maxlength="@MaxLength"
              disabled="@Disabled"
              readonly="@ReadOnly"
              required="@Required"
              data-slot="textarea"
              data-bz-prevent-keys="@PreventKeys"
              data-bz-autofocus="@(AutoFocus ? "" : null)"
              data-bz-autoselect="@(AutoSelect ? "" : null)"
              class="@Tw.Merge(TextareaClasses, Class)"
              @oninput="OnInputAsync"
              @onfocus="OnFocus"
              @onblur="OnBlur"
              @onkeydown="OnKeyDown"
              @attributes="Attributes"></textarea>
}
else
{
    <input @ref="_element"
           type="@Type"
           value="@Value"
           placeholder="@Placeholder"
           maxlength="@MaxLength"
           disabled="@Disabled"
           readonly="@ReadOnly"
           required="@Required"
           data-slot="input"
           data-bz-prevent-keys="@PreventKeys"
           data-bz-autofocus="@(AutoFocus ? "" : null)"
           data-bz-autoselect="@(AutoSelect ? "" : null)"
           class="@Tw.Merge(InputClasses, Class)"
           @oninput="OnInputAsync"
           @onfocus="OnFocus"
           @onblur="OnBlur"
           @onkeydown="OnKeyDown"
           @attributes="Attributes" />
}

@code {
    /// <summary>The current text. Use with <c>@bind-Value</c> (updates on input).</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Raised with the new text on every input (or after the <see cref="DebounceDelay"/> pause). Enables <c>@bind-Value</c>.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>
    /// Milliseconds of typing pause before <see cref="ValueChanged"/> fires - each keystroke restarts
    /// the wait, so a burst of typing raises one change. <c>0</c> (the default) fires on every input.
    /// </summary>
    [Parameter] public int DebounceDelay { get; set; }

    /// <summary>
    /// The <c>type</c> attribute (e.g. <c>"email"</c>, <c>"password"</c>, <c>"file"</c>); browser default: text.
    /// Single-line only - ignored once <see cref="Rows"/> turns the field into a textarea.
    /// </summary>
    [Parameter] public string? Type { get; set; }

    /// <summary>
    /// Number of visible text rows. Setting it (to a positive value) makes the field multi-line - it
    /// renders a <c>&lt;textarea&gt;</c> that still grows with its content above this height. Omit for a
    /// single-line input.
    /// </summary>
    [Parameter] public int? Rows { get; set; }

    /// <summary>Hint text shown while the field is empty.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Maximum number of characters the field accepts (the <c>maxlength</c> attribute).</summary>
    [Parameter] public int? MaxLength { get; set; }

    /// <summary>Disables the field.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Makes the field read-only: focusable and selectable, but not editable.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Marks the field as required (the <c>required</c> attribute - native form validation and AT).</summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>Raised when the field gains focus (a splatted <c>@onfocus</c> binds to this same parameter).</summary>
    [Parameter] public EventCallback<FocusEventArgs> OnFocus { get; set; }

    /// <summary>Raised when the field loses focus - the classic validate-on-leave hook.</summary>
    [Parameter] public EventCallback<FocusEventArgs> OnBlur { get; set; }

    /// <summary>Raised on every key press - e.g. submit-on-Enter. Runs before the value updates.</summary>
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }

    /// <summary>
    /// Key combos whose browser default is suppressed, so the key reaches <see cref="OnKeyDown"/>
    /// without the browser also acting on it. One or more combos, comma-separated; each is
    /// modifiers joined to a single key with <c>+</c>.
    /// <para>
    /// Modifiers: <c>ctrl</c>, <c>alt</c>, <c>shift</c>, <c>meta</c>, and <c>mod</c> (the platform
    /// primary - Cmd on macOS, Ctrl everywhere else). Keys are the browser's own key names in
    /// lowercase (<c>a</c>, <c>enter</c>, <c>tab</c>, <c>arrowup</c>, <c>/</c>), plus the aliases
    /// <c>space</c> and <c>esc</c>. Matching is EXACT on modifiers: <c>"enter"</c> is Enter with
    /// nothing held and does not match Shift+Enter or Ctrl+Enter, each of which needs its own entry.
    /// </para>
    /// <list type="bullet">
    /// <item><c>"enter"</c> - send-on-Enter composer: Enter no longer inserts a newline, Shift+Enter still does.</item>
    /// <item><c>"mod+s"</c> - Cmd/Ctrl+S saves the draft instead of opening the browser's save-page dialog.</item>
    /// <item><c>"ctrl+enter, mod+enter"</c> - two combos in one value; both reach your handler without the browser acting.</item>
    /// <item><c>"alt+arrowup, alt+arrowdown"</c> - Alt+Arrow moves the current line instead of jumping the caret or scrolling.</item>
    /// <item><c>"tab"</c> - Tab indents inside the field instead of moving focus. Use sparingly: it traps keyboard users unless you leave them another way out.</item>
    /// <item><c>"mod+shift+z"</c> - claims redo before the browser's own undo stack sees it.</item>
    /// </list>
    /// <para>
    /// The suppression happens JS-side, before the event reaches <see cref="OnKeyDown"/>: a C#
    /// handler runs after the browser has already acted, which is why Blazor's own
    /// <c>@onkeydown:preventDefault</c> can only be all keys or none.
    /// </para>
    /// </summary>
    [Parameter] public string? PreventKeys { get; set; }

    /// <summary>
    /// Focus the field when it appears - reliably, unlike the native <c>autofocus</c> attribute,
    /// which browsers only honor during document load: this works for Blazor-rendered markup and
    /// for fields that mount later (inside a dialog, behind a condition), retrying across
    /// animation frames while the field is still unrendered mid-open-animation.
    /// </summary>
    [Parameter] public bool AutoFocus { get; set; }

    /// <summary>
    /// Select the whole value whenever the field gains focus - the replace-on-type pattern for
    /// fields holding a value the user usually overwrites (a rename box, an amount). Combines
    /// with <see cref="AutoFocus"/>: the focused field arrives selected.
    /// </summary>
    [Parameter] public bool AutoSelect { get; set; }

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes (placeholder, id, aria-*, …), forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    // Mode is inferred from Rows: a positive count means multi-line.
    private bool Multiline => Rows is > 0;

    private ElementReference _element;
    private CancellationTokenSource? _debounce;

    /// <summary>
    /// Focuses the field - hold the component with <c>@ref</c> and call this from an event handler
    /// or <c>OnAfterRenderAsync</c>. Reliable where the platform's focus is not: it retries across
    /// animation frames while the field is still unrendered (mid-open-animation), and
    /// <see cref="FocusOptions.Select"/> lands the value selected. Returns whether the field ended
    /// up focused.
    /// </summary>
    public ValueTask<bool> FocusAsync(FocusOptions? options = null) => Core.FocusAsync(_element, options);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || (PreventKeys is null && !AutoFocus && !AutoSelect)) return;
        try
        {
            await Core.EnsureGuardsAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit went away mid-render - nothing left to guard.
        }
    }

    // Debounced emit: each keystroke cancels the pending one and starts a fresh wait, so only the text
    // as it stands after the pause is raised. The DOM keeps the user's live text between emits - Blazor
    // only rewrites `value` when the rendered Value actually changes.
    private async Task OnInputAsync(ChangeEventArgs e)
    {
        var text = e.Value?.ToString();

        if (DebounceDelay <= 0)
        {
            await ValueChanged.InvokeAsync(text);
            return;
        }

        _debounce?.Cancel();
        _debounce?.Dispose();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        try
        {
            await Task.Delay(DebounceDelay, token);
            await ValueChanged.InvokeAsync(text);
        }
        catch (TaskCanceledException)
        {
            // Superseded by a newer keystroke - the newer wait owns the emit.
        }
    }

    public void Dispose()
    {
        _debounce?.Cancel();
        _debounce?.Dispose();
    }

    private const string InputClasses =
        "bz-input w-full min-w-0 outline-none file:inline-flex file:border-0 file:bg-transparent " +
        "file:text-foreground placeholder:text-muted-foreground disabled:pointer-events-none " +
        "disabled:cursor-not-allowed disabled:opacity-50";

    private const string TextareaClasses =
        "bz-textarea flex field-sizing-content min-h-16 w-full outline-none " +
        "placeholder:text-muted-foreground disabled:cursor-not-allowed disabled:opacity-50";
}
