@namespace Blaizio.Ui
@using System.Globalization
@using System.Text
@inject ICore Core
@*
    Inline date field binding a DateOnly - the date sibling of BzInputTime. Format drives the segment
    order and separators ("yyyy-MM-dd" by default; any mix of d/M/y runs with literal separators, e.g.
    "dd/MM/yyyy"). You edit the day / month / year segments in place: type digits (the focus hops to
    the next segment once the value is unambiguous) or step with the arrow keys. ShowCalendar adds a
    trailing button that opens a BzCalendar popup - picking a day fills the field and closes it.
    Bind CalendarOpen to open or close that popup from code, or to know when it opens. Everything
    it says to screen readers (the segments, the calendar button, the popup and its month buttons)
    has a parameter, English by default.

        <BzInputDate @bind-Value="_date" />
        <BzInputDate @bind-Value="_date" Format="dd/MM/yyyy" ShowCalendar />
        <BzInputDate @bind-Value="_date" ShowCalendar @bind-CalendarOpen="_calendarOpen" />
*@

<div data-slot="input-date" class="@Tw.Merge(RootClasses, Class)" data-disabled="@(Disabled ? "" : null)">
    @if (ShowIcon)
    {
        <span data-slot="input-date-icon" class="text-muted-foreground pointer-events-none flex shrink-0 items-center">
            @if (Icon is not null)
            {
                @Icon
            }
            else
            {
                <BzIcon Icon="@BzGlyphs.Calendar" Class="size-4" />
            }
        </span>
    }
    @if (Name is not null)
    {
        @* The segments are three inputs: the date itself is posted from here, as a native date input writes it. *@
        <BaseHiddenInput Name="@Name" Disabled="@Disabled"
                         Value="@(Current?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))" />
    }
    @* A date reads left-to-right even in RTL copy, so the segment row pins its direction. *@
    <div @ref="_root" dir="ltr" class="flex items-center" data-slot="input-date-input"
         data-bz-autofocus="@(AutoFocus ? "" : null)" @attributes="Attributes">
        @foreach (var token in _tokens)
        {
            if (token.Part is null)
            {
                <span class="text-muted-foreground select-none">@token.Literal</span>
            }
            else if (token.Part == Part.Day)
            {
                <input @ref="_dayRef" @key="Part.Day" inputmode="numeric" autocomplete="off" maxlength="2"
                       placeholder="--" @bind:get="FormatPart(Part.Day)" @bind:event="oninput" disabled="@Disabled" aria-label="@DayAriaLabel"
                       onfocus="this.select()" class="@SegmentClasses" @onblur="@(() => _typing = null)"
                       @bind:set="@(text => OnSegmentInput(Part.Day, text))"
                       @onkeydown="@(e => OnSegmentKeyDown(Part.Day, e))" />
            }
            else if (token.Part == Part.Month)
            {
                <input @ref="_monthRef" @key="Part.Month" inputmode="numeric" autocomplete="off" maxlength="2"
                       placeholder="--" @bind:get="FormatPart(Part.Month)" @bind:event="oninput" disabled="@Disabled" aria-label="@MonthAriaLabel"
                       onfocus="this.select()" class="@SegmentClasses" @onblur="@(() => _typing = null)"
                       @bind:set="@(text => OnSegmentInput(Part.Month, text))"
                       @onkeydown="@(e => OnSegmentKeyDown(Part.Month, e))" />
            }
            else
            {
                <input @ref="_yearRef" @key="Part.Year" inputmode="numeric" autocomplete="off" maxlength="4"
                       placeholder="----" @bind:get="FormatPart(Part.Year)" @bind:event="oninput" disabled="@Disabled" aria-label="@YearAriaLabel"
                       onfocus="this.select()" class="@YearSegmentClasses" @onblur="@(() => _typing = null)"
                       @bind:set="@(text => OnSegmentInput(Part.Year, text))"
                       @onkeydown="@(e => OnSegmentKeyDown(Part.Year, e))" />
            }
        }
    </div>
    @if (ShowCalendar)
    {
        <BzPopover Open="@_calendar.Value" OpenChanged="@SetCalendarOpenAsync">
            <BzPopoverTrigger>
                @* The trigger is a real BzButton wearing the popover's attributes - it gets the style's
                   radius, focus ring, disabled treatment and the aria-expanded fill for free. *@
                <RenderAs Context="p">
                    <BzButton Type="ButtonType.Button" Variant="ButtonVariant.Ghost" Size="ButtonSize.IconXs" Disabled="@Disabled"
                              aria-label="@CalendarButtonAriaLabel" Class="@CalendarButtonClasses" @attributes="p.Attributes">
                        <BzIcon Icon="@BzGlyphs.CalendarDown" Class="size-4" />
                    </BzButton>
                </RenderAs>
            </BzPopoverTrigger>
            <BzPopoverContent Class="w-auto p-0" aria-label="@CalendarAriaLabel">
                <BzCalendar Value="@Current" ValueChanged="OnCalendarPicked"
                            Min="@Min" Max="@Max" Culture="@Culture" Class="p-3"
                            PreviousMonthAriaLabel="@PreviousMonthAriaLabel" NextMonthAriaLabel="@NextMonthAriaLabel" />
            </BzPopoverContent>
        </BzPopover>
    }
</div>

@code {
    /// <summary>Controlled value. Use with <c>@bind-Value</c>.</summary>
    [Parameter] public DateOnly? Value { get; set; }

    /// <summary>Initial value when uncontrolled.</summary>
    [Parameter] public DateOnly? DefaultValue { get; set; }

    /// <summary>Raised with the new date. Enables <c>@bind-Value</c>.</summary>
    [Parameter] public EventCallback<DateOnly?> ValueChanged { get; set; }

    /// <summary>
    /// Segment layout: runs of <c>d</c>, <c>M</c> and <c>y</c> with literal separators between them
    /// (e.g. <c>"dd/MM/yyyy"</c>, <c>"MM-dd-yyyy"</c>). Defaults to <c>"yyyy-MM-dd"</c>.
    /// </summary>
    [Parameter] public string Format { get; set; } = "yyyy-MM-dd";

    /// <summary>Show a trailing button that opens a <see cref="BzCalendar"/> popup. Defaults to <c>false</c>.</summary>
    [Parameter] public bool ShowCalendar { get; set; }

    /// <summary>
    /// Controlled open state of the calendar popup (with <see cref="ShowCalendar"/>). Use with
    /// <c>@bind-CalendarOpen</c> to open it from code, for example when the field appears; it turns
    /// false when a day is picked, on Escape and on a press outside.
    /// </summary>
    [Parameter] public bool? CalendarOpen { get; set; }

    /// <summary>Initial open state of the calendar popup when uncontrolled.</summary>
    [Parameter] public bool DefaultCalendarOpen { get; set; }

    /// <summary>Raised with the calendar popup's new open state. Enables <c>@bind-CalendarOpen</c>.</summary>
    [Parameter] public EventCallback<bool> CalendarOpenChanged { get; set; }

    /// <summary>Earliest selectable day in the calendar popup.</summary>
    [Parameter] public DateOnly? Min { get; set; }

    /// <summary>Latest selectable day in the calendar popup.</summary>
    [Parameter] public DateOnly? Max { get; set; }

    /// <summary>Culture for the calendar popup's month/weekday names.</summary>
    [Parameter] public CultureInfo? Culture { get; set; }

    /// <summary>The day segment's name for screen readers. Defaults to "Day".</summary>
    [Parameter] public string DayAriaLabel { get; set; } = "Day";

    /// <summary>The month segment's name for screen readers. Defaults to "Month".</summary>
    [Parameter] public string MonthAriaLabel { get; set; } = "Month";

    /// <summary>The year segment's name for screen readers. Defaults to "Year".</summary>
    [Parameter] public string YearAriaLabel { get; set; } = "Year";

    /// <summary>The name of the button that opens the calendar popup (with <see cref="ShowCalendar"/>), for screen readers. Defaults to "Open calendar".</summary>
    [Parameter] public string CalendarButtonAriaLabel { get; set; } = "Open calendar";

    /// <summary>The calendar popup's name for screen readers. Defaults to "Calendar".</summary>
    [Parameter] public string CalendarAriaLabel { get; set; } = "Calendar";

    /// <summary>The name of the calendar popup's previous-month button, for screen readers. Defaults to "Go to the previous month".</summary>
    [Parameter] public string PreviousMonthAriaLabel { get; set; } = "Go to the previous month";

    /// <summary>The name of the calendar popup's next-month button, for screen readers. Defaults to "Go to the next month".</summary>
    [Parameter] public string NextMonthAriaLabel { get; set; } = "Go to the next month";

    /// <summary>Show a leading calendar icon. Defaults to <c>true</c>.</summary>
    [Parameter] public bool ShowIcon { get; set; } = true;

    /// <summary>Replace the default leading icon (only used when <see cref="ShowIcon"/> is set).</summary>
    [Parameter] public RenderFragment? Icon { get; set; }

    /// <summary>Disables the field.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// The form field name. When set, a hidden input posts the date the way a native date input writes it (<c>2026-11-19</c>, whatever the culture or <c>Format</c>). An empty field posts nothing,
    /// so the control takes part in a plain <c>&lt;form method="post"&gt;</c>. Unset (the default) renders
    /// nothing extra.
    /// </summary>
    [Parameter] public string? Name { get; set; }

    /// <summary>Focus the field (its first segment) when it appears - works for Blazor-rendered markup, including markup that appears later, unlike native <c>autofocus</c>. See <see cref="BzInputText.AutoFocus"/>. Each segment already selects itself on focus.</summary>
    [Parameter] public bool AutoFocus { get; set; }

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes (id, aria-*, …), forwarded to the segment row.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !AutoFocus) return;
        try
        {
            await Core.EnsureGuardsAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit went away mid-render - nothing left to focus.
        }
    }

    private ElementReference _root;

    /// <summary>
    /// Focuses the field's first segment (the focus descends from the segment row) - hold the
    /// component with <c>@ref</c> and call this from an event handler or
    /// <c>OnAfterRenderAsync</c>. See <see cref="BzInputText.FocusAsync"/>.
    /// </summary>
    public ValueTask<bool> FocusAsync(FocusOptions? options = null) => Core.FocusAsync(_root, options);

    private enum Part { Day, Month, Year }

    private readonly record struct Token(Part? Part, string? Literal);

    private readonly ControllableState<DateOnly?> _state = new();

    private IReadOnlyList<Token> _tokens = [];
    private string? _parsedFormat;

    // Segment buffers; resynced whenever the bound value changes from outside.
    private int? _day;
    private int? _month;
    private int? _year;
    private DateOnly? _synced;
    private readonly ControllableState<bool> _calendar = new();

    private ElementReference _dayRef;
    private ElementReference _monthRef;
    private ElementReference _yearRef;

    protected override void OnParametersSet()
    {
        _state.Sync(ValueChanged.HasDelegate, Value, DefaultValue);
        _calendar.Sync(CalendarOpen.HasValue, CalendarOpen ?? false, DefaultCalendarOpen);
        if (_parsedFormat != Format)
        {
            _parsedFormat = Format;
            _tokens = Tokenize(Format);
        }
        if (Current != _synced)
        {
            _synced = Current;
            _typing = null;
            _day = Current?.Day;
            _month = Current?.Month;
            _year = Current?.Year;
        }
    }

    private DateOnly? Current => _state.Value ?? DefaultValue;

    // Runs of d / M / y become segments; anything else is a literal separator.
    private static IReadOnlyList<Token> Tokenize(string format)
    {
        var tokens = new List<Token>();
        var literal = new StringBuilder();
        var seen = new HashSet<Part>();

        void FlushLiteral()
        {
            if (literal.Length == 0) return;
            tokens.Add(new Token(null, literal.ToString()));
            literal.Clear();
        }

        for (var i = 0; i < format.Length; i++)
        {
            Part? part = format[i] switch
            {
                'd' or 'D' => Part.Day,
                'M' => Part.Month,
                'y' or 'Y' => Part.Year,
                _ => null,
            };
            if (part is { } p && seen.Add(p))
            {
                FlushLiteral();
                tokens.Add(new Token(p, null));
            }
            else if (part is null)
            {
                literal.Append(format[i]);
            }
            // repeated pattern chars (the "dd" run) collapse into the one segment
        }
        FlushLiteral();

        // A degenerate format falls back to the default order rather than rendering nothing.
        return seen.Count == 3 ? tokens :
        [
            new Token(Part.Year, null), new Token(null, "-"),
            new Token(Part.Month, null), new Token(null, "-"),
            new Token(Part.Day, null),
        ];
    }

    // A segment still being typed shows its digits as typed. Padded ("1" shown as "01") it would
    // be full, and the field's length limit would refuse the next digit.
    private Part? _typing;
    private string? _typed;

    private string FormatPart(Part part) => _typing == part && _typed is not null ? _typed : part switch
    {
        Part.Day => _day?.ToString("00", CultureInfo.InvariantCulture) ?? "",
        Part.Month => _month?.ToString("00", CultureInfo.InvariantCulture) ?? "",
        _ => _year?.ToString("0000", CultureInfo.InvariantCulture) ?? "",
    };

    // The segments are bound (get / set on input), not written as value + @oninput. A plain value
    // is only patched when it differs from the last render, and the renderer never learns what was
    // typed: a letter typed into an empty segment left the model empty and the letter in the box.
    private async Task OnSegmentInput(Part part, string? text)
    {
        var keep = part == Part.Year ? 4 : 2;
        var digits = new string((text ?? "").Where(char.IsAsciiDigit).ToArray());
        if (digits.Length == 0)
        {
            _typing = null;
            SetPart(part, null);
            await EmitAsync();
            return;
        }

        if (digits.Length > keep) digits = digits[^keep..];
        var number = int.Parse(digits, CultureInfo.InvariantCulture);
        var max = MaxFor(part);
        if (number > max) number = number % 10;
        SetPart(part, number);

        // Hop once another digit could not fit (e.g. day "4" -> 40 > 31) or the segment is full;
        // until then the segment keeps showing what was typed.
        var done = digits.Length == keep || number * 10 > max;
        _typing = done ? null : part;
        _typed = done ? null : number.ToString(CultureInfo.InvariantCulture);
        await EmitAsync();
        if (done) await FocusNextAsync(part);
    }

    private async Task OnSegmentKeyDown(Part part, KeyboardEventArgs e)
    {
        var step = e.Key switch { "ArrowUp" => 1, "ArrowDown" => -1, _ => 0 };
        if (step == 0) return;
        _typing = null;

        var min = MinFor(part);
        var max = MaxFor(part);
        var span = max - min + 1;
        var current = ValueFor(part) ?? (step > 0 ? max : min); // first arrow lands on min/max
        var next = min + (((current - min + step) % span + span) % span);
        SetPart(part, next);
        await EmitAsync();
    }

    private static int MaxFor(Part part) => part switch
    {
        Part.Day => 31,
        Part.Month => 12,
        _ => 9999,
    };

    private static int MinFor(Part part) => 1;

    private int? ValueFor(Part part) => part switch
    {
        Part.Day => _day,
        Part.Month => _month,
        _ => _year,
    };

    private void SetPart(Part part, int? value)
    {
        switch (part)
        {
            case Part.Day: _day = value; break;
            case Part.Month: _month = value; break;
            case Part.Year: _year = value; break;
        }
    }

    private async Task FocusNextAsync(Part part)
    {
        var order = _tokens.Where(t => t.Part is not null).Select(t => t.Part!.Value).ToList();
        var index = order.IndexOf(part);
        if (index < 0 || index + 1 >= order.Count) return;
        var next = order[index + 1] switch
        {
            Part.Day => _dayRef,
            Part.Month => _monthRef,
            _ => _yearRef,
        };
        try { await next.FocusAsync(); }
        catch (Microsoft.JSInterop.JSException) { /* segment not in the DOM this frame */ }
    }

    // The value first, then the close: a listener on both sees the pick while the popup is still open.
    private async Task OnCalendarPicked(DateOnly? date)
    {
        // The calendar reports null when the selected day is pressed again (a lone calendar
        // toggles its date off). In a field that press means "this one": the date stays and the
        // popup closes. The segments are how a date is cleared.
        if (date is null)
        {
            await _calendar.SetAsync(false, CalendarOpenChanged);
            return;
        }

        _synced = date;
        _day = date?.Day;
        _month = date?.Month;
        _year = date?.Year;
        await _state.SetAsync(date, ValueChanged);
        await _calendar.SetAsync(false, CalendarOpenChanged);
    }

    private Task SetCalendarOpenAsync(bool open) => _calendar.SetAsync(open, CalendarOpenChanged);

    // A date exists once all three segments are set; the day clamps to the month's length.
    private Task EmitAsync()
    {
        DateOnly? next = null;
        // A lone "0" is a legal keystroke (the start of "05") but not a date part yet - treat the
        // value as incomplete until the segment holds a real day/month.
        if (_day is { } d and >= 1 && _month is { } m and >= 1 && _year is { } y and >= 1)
        {
            var day = Math.Min(d, DateTime.DaysInMonth(y, m));
            next = new DateOnly(y, m, day);
        }
        _synced = next; // our own edit - don't resync (and wipe) the buffers on the next render
        return _state.SetAsync(next, ValueChanged);
    }

    // The wrapper draws the bz-input field box; segments sit inside it chrome-stripped and the box
    // lights up on focus-within (same treatment as BzInputTime).
    private const string RootClasses =
        "bz-input-date bz-input inline-flex w-fit items-center gap-2 " +
        "focus-within:border-ring focus-within:ring-ring/50 focus-within:ring-2 " +
        "data-disabled:pointer-events-none data-disabled:opacity-50";

    private const string SegmentClasses =
        "w-[2.1ch] rounded-sm bg-transparent p-0 text-center text-base tabular-nums outline-none md:text-sm " +
        "placeholder:text-muted-foreground focus:bg-accent focus:text-accent-foreground " +
        "disabled:cursor-not-allowed selection:bg-transparent";

    private const string YearSegmentClasses =
        "w-[4.2ch] rounded-sm bg-transparent p-0 text-center text-base tabular-nums outline-none md:text-sm " +
        "placeholder:text-muted-foreground focus:bg-accent focus:text-accent-foreground " +
        "disabled:cursor-not-allowed selection:bg-transparent";

    // Only what the button doesn't already supply: the muted resting ink and the pull into the
    // field's end padding. Radius, focus ring, hover fill and the disabled state come from BzButton.
    private const string CalendarButtonClasses = "text-muted-foreground -me-1 shrink-0";
}
