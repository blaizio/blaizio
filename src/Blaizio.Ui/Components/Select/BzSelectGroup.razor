@namespace Blaizio.Ui
@* Styled SelectGroup - a labelled section of options (pair with a SelectLabel for the heading). *@

<BaseSelectGroup Class="@Class" Attributes="@ForwardedAttributes()">
    @ChildContent
</BaseSelectGroup>

@code {
    /// <summary>Extra classes.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The group's label and options.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "select-group").Merge(Attributes);
}
