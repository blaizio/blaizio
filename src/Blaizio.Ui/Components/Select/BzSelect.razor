@namespace Blaizio.Ui
@*
    Styled Select root - wraps the headless BaseSelect. Renders no element of its own; drop a
    SelectTrigger (with a SelectValue) and a SelectContent (with SelectItems) inside. Non-modal: the
    page stays interactive while open, and Escape / outside-click / Tab / picking an option dismiss it.
    Set Multiple for multi-select (bind the chosen values with @bind-Values); picking then toggles and
    keeps the listbox open.

        <BzSelect @bind-Value="fruit">
            <BzSelectTrigger class="w-48"><BzSelectValue Placeholder="Select a fruit" /></BzSelectTrigger>
            <BzSelectContent>
                <BzSelectItem Value="apple">Apple</BzSelectItem>
            </BzSelectContent>
        </BzSelect>
*@

<BaseSelect Value="@Value"
             DefaultValue="@DefaultValue"
             ValueChanged="@ValueChanged"
             Multiple="@Multiple"
             Values="@Values"
             DefaultValues="@DefaultValues"
             ValuesChanged="@ValuesChanged"
             Open="@Open"
             DefaultOpen="@DefaultOpen"
             OpenChanged="@OpenChanged"
             Disabled="@Disabled">
    @ChildContent
</BaseSelect>

@code {
    /// <summary>Controlled selected value (single-select). Use with <c>@bind-Value</c>.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Initial selected value when uncontrolled (single-select).</summary>
    [Parameter] public string? DefaultValue { get; set; }

    /// <summary>Raised with the new value when the selection changes (single-select). Enables <c>@bind-Value</c>.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Allow more than one value to be selected. Drives the <c>Values</c> binding instead of <c>Value</c>.</summary>
    [Parameter] public bool Multiple { get; set; }

    /// <summary>Controlled selected values (when <see cref="Multiple"/>). Bind with <c>@bind-Values</c>.</summary>
    [Parameter] public IReadOnlyList<string>? Values { get; set; }

    /// <summary>Initial selected values when uncontrolled (when <see cref="Multiple"/>).</summary>
    [Parameter] public IReadOnlyList<string>? DefaultValues { get; set; }

    /// <summary>Raised with the new values when the selection changes (when <see cref="Multiple"/>). Enables <c>@bind-Values</c>.</summary>
    [Parameter] public EventCallback<IReadOnlyList<string>> ValuesChanged { get; set; }

    /// <summary>Controlled open state. Use with <c>@bind-Open</c>.</summary>
    [Parameter] public bool? Open { get; set; }

    /// <summary>Initial open state when uncontrolled.</summary>
    [Parameter] public bool DefaultOpen { get; set; }

    /// <summary>Raised with the new open state. Enables <c>@bind-Open</c>.</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Disables the whole select: the trigger renders inert and the listbox cannot open.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>The trigger and content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
