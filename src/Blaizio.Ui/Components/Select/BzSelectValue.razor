@namespace Blaizio.Ui
@inject IJSRuntime Js
@implements IAsyncDisposable
@*
    Styled SelectValue - the trigger's display of the current selection.

    Single-select shows the chosen option's content, or the Placeholder while nothing is selected
    (greyed via the trigger's data-placeholder). Multi-select shows the selected options as removable
    badges; when they outgrow the trigger's width, Overflow decides between a trailing "+N" counter
    (Count - keeps the trigger one line tall, the default) and wrapping onto more lines (Wrap - grows
    the trigger). Pass a Tokens template (with a SelectTokens context) to render your own badges instead.

    The data-slot span is what the trigger's `*:data-[slot=select-value]` layout rules target.
*@

@if (Select?.Multiple == true)
{
    <span data-slot="select-value" @ref="_tokensEl" class="@Tw.Merge(MultiClasses, Class)">
        <BaseSelectValue>
            <Tokens Context="ctx">
                @if (Tokens is not null)
                {
                    @Tokens(ctx)
                }
                else
                {
                    @foreach (var option in ctx.Options)
                    {
                        <span data-bz-token class="bz-select-token inline-flex min-w-0 max-w-full shrink-0 items-center gap-1 rounded-sm bg-secondary py-0.5 ps-2 pe-1 text-xs leading-none text-secondary-foreground">
                            <span class="truncate">@option.Content</span>
                            <span role="button" tabindex="-1" aria-label="Remove"
                                  class="flex size-4 shrink-0 items-center justify-center rounded-xs opacity-60 transition-opacity hover:bg-foreground/10 hover:opacity-100"
                                  @onclick="@(() => ctx.Deselect.InvokeAsync(option.Value))"
                                  @onclick:stopPropagation="true"
                                  @onpointerdown:stopPropagation="true">
                                <BzIcon Icon="@Icons.Outline.X" Class="size-3" />
                            </span>
                        </span>
                    }
                    @if (Overflow == SelectTokenOverflow.Count)
                    {
                        <span data-bz-token-more hidden class="shrink-0 rounded-sm bg-secondary px-1.5 py-0.5 text-xs leading-none tabular-nums text-secondary-foreground"></span>
                    }
                }
            </Tokens>
            <Placeholder><span>@Placeholder</span></Placeholder>
        </BaseSelectValue>
    </span>
}
else
{
    <span data-slot="select-value" class="@Tw.Merge("line-clamp-1 flex items-center gap-2", Class)">
        <BaseSelectValue>
            <Placeholder>@Placeholder</Placeholder>
        </BaseSelectValue>
    </span>
}

@code {
    /// <summary>Shown while nothing is selected, e.g. "Select a fruit".</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Multi-select only: how tokens that don't fit one line are handled. Defaults to
    /// <see cref="SelectTokenOverflow.Count"/> (a "+N" counter; the trigger keeps a fixed height).
    /// </summary>
    [Parameter] public SelectTokenOverflow Overflow { get; set; } = SelectTokenOverflow.Count;

    /// <summary>
    /// Multi-select only: render your own tokens from the selected options instead of the default
    /// removable badges. Receives a <see cref="SelectTokens"/> (the selected options + a remove callback).
    /// </summary>
    [Parameter] public RenderFragment<SelectTokens>? Tokens { get; set; }

    [CascadingParameter] private SelectContext? Select { get; set; }

    private ElementReference _tokensEl;
    private IJSObjectReference? _overflowModule;
    private IJSObjectReference? _overflow;

    // The "+N" counter needs DOM measurement; only the Count mode with the default badges uses it. The
    // Wrap mode is pure CSS, and a custom Tokens template owns its own overflow.
    private bool UseOverflowJs => Select?.Multiple == true && Overflow == SelectTokenOverflow.Count && Tokens is null;

    private string MultiClasses => Overflow == SelectTokenOverflow.Wrap
        ? "flex min-w-0 flex-1 flex-wrap items-center gap-1"
        : "flex min-w-0 flex-1 flex-nowrap items-center gap-1 overflow-hidden";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!UseOverflowJs)
        {
            if (_overflow is not null) await DisposeOverflowAsync();
            return;
        }

        try
        {
            if (_overflow is null)
            {
                _overflowModule ??= await Js.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/Blaizio.Base/dist/tokenOverflow.js");
                _overflow = await _overflowModule.InvokeAsync<IJSObjectReference>("createTokenOverflow", _tokensEl);
            }
            else
            {
                // Selection (and so the token set) just re-rendered: re-measure which tokens fit.
                await _overflow.InvokeVoidAsync("update");
            }
        }
        catch (JSDisconnectedException) { }
    }

    private async Task DisposeOverflowAsync()
    {
        try
        {
            if (_overflow is not null)
            {
                await _overflow.InvokeVoidAsync("dispose");
                await _overflow.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        _overflow = null;
    }

    public async ValueTask DisposeAsync()
    {
        await DisposeOverflowAsync();
        try
        {
            if (_overflowModule is not null) await _overflowModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        GC.SuppressFinalize(this);
    }
}
