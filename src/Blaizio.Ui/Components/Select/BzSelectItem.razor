@namespace Blaizio.Ui
@*
    Styled SelectItem - one option, with a trailing check (inline-end) shown only while it is the
    selected value, leaving the inline-start free for an optional leading icon. Picking it sets the
    value and closes the listbox. ts/menu.js focuses items on hover + arrow, so `focus:bg-accent` is
    the highlight.
*@

<BaseSelectItem Value="@Value"
                 Class="@Tw.Merge(BaseClasses, Class)"
                 Disabled="@Disabled"
                 Attributes="ForwardedAttributes()">
    <ChildContent>@ChildContent</ChildContent>
    <Indicator>
        <span class="absolute end-2 flex size-3.5 items-center justify-center">
            <BzIcon Icon="@Icons.Outline.Check" Class="size-4" />
        </span>
    </Indicator>
</BaseSelectItem>

@code {
    /// <summary>The value this option represents. Required and unique within the select.</summary>
    [Parameter] public string Value { get; set; } = default!;

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Disables the option.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>The option's label.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "select-item").Merge(Attributes);

    private const string BaseClasses =
        "bz-select-item relative flex w-full cursor-default select-none items-center gap-2 rounded-sm " +
        "py-1.5 ps-2 pe-8 text-sm outline-none " +
        "focus:bg-accent focus:text-accent-foreground " +
        "data-disabled:pointer-events-none data-disabled:opacity-50 " +
        "[&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0";
}
