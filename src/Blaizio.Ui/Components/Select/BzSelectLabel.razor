@namespace Blaizio.Ui
@* Styled SelectLabel - a small muted caption for a group of options. *@

<BaseSelectLabel Class="@Tw.Merge(BaseClasses, Class)" Attributes="ForwardedAttributes()">
    @ChildContent
</BaseSelectLabel>

@code {
    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Label content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "select-label").Merge(Attributes);

    private const string BaseClasses = "bz-select-label px-2 py-1.5 text-xs text-muted-foreground";
}
