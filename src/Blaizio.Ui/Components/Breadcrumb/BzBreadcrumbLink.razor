@namespace Blaizio.Ui
@*
    A navigable step. Renders an <a> by default - pass Href for the destination - or use RenderAs to
    render the link styling onto your own routed element (e.g. a NavLink):

        <BzBreadcrumbLink>
            <RenderAs Context="p"><NavLink href="/docs" @attributes="p.Attributes">Docs</NavLink></RenderAs>
        </BzBreadcrumbLink>
*@

<BasePrimitive As="a" Attributes="BuildAttributes()" ChildContent="@ChildContent" RenderAs="@RenderAs" />

@code {
    /// <summary>Destination URL. Emitted as <c>href</c> on the default <c>&lt;a&gt;</c>; ignored in RenderAs mode.</summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Link label.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the link styling onto your own element instead of an <c>&lt;a&gt;</c>.</summary>
    [Parameter] public RenderFragment<BzRenderProps>? RenderAs { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder().Data("slot", "breadcrumb-link");
        if (RenderAs is null) props.Set("href", Href);
        return props.Merge(Attributes, Tw.Merge("bz-breadcrumb-link", Class));
    }
}
