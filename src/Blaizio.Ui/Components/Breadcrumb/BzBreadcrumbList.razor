@namespace Blaizio.Ui
@* Ordered list holding the trail - lays out the items and separators inline. *@

<BasePrimitive As="ol" Attributes="@BuildAttributes()" ChildContent="@ChildContent" />

@code {
    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The steps - <c>BreadcrumbItem</c>s with <c>BreadcrumbSeparator</c>s between them.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the <c>ol</c>.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "breadcrumb-list")
            .Merge(Attributes, Tw.Merge("bz-breadcrumb-list", Class));
}
