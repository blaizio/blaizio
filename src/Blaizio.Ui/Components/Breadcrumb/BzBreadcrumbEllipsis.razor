@namespace Blaizio.Ui
@*
    A collapsed-trail indicator. Decorative; typically wraps (or sits beside) a DropdownMenu/Popover
    trigger that reveals the hidden steps. Carries an sr-only label for assistive tech.
*@

<BasePrimitive As="span" Attributes="BuildAttributes()">
    <BzIcon Icon="@Icons.Outline.Dots" />
    <span class="sr-only">@MoreLabel</span>
</BasePrimitive>

@code {
    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Screen-reader label for the collapsed steps. Defaults to "More".</summary>
    [Parameter] public string MoreLabel { get; set; } = "More";

    /// <summary>Any other attributes, forwarded to the <c>span</c>.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Set("role", "presentation")
            .Aria("hidden", true)
            .Data("slot", "breadcrumb-ellipsis")
            .Merge(Attributes, Tw.Merge("bz-breadcrumb-ellipsis", Class));
}
