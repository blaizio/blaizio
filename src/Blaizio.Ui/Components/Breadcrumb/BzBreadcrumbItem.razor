@namespace Blaizio.Ui
@*
    A single step in the trail. Holds a <BzBreadcrumbLink>, or - when Current is set - renders its
    content as the current page: a non-interactive aria-current="page" label, NOT a link. Pass the
    label content directly in that case (no nested BreadcrumbLink/BreadcrumbPage needed).
*@

<BasePrimitive As="li" Attributes="@BuildAttributes()">
    @if (Current)
    {
        <BzBreadcrumbPage>@ChildContent</BzBreadcrumbPage>
    }
    else
    {
        @ChildContent
    }
</BasePrimitive>

@code {
    /// <summary>
    /// When <see langword="true"/>, this item is the current page: its content renders as a
    /// non-interactive label (<c>aria-current="page"</c>) instead of a link. Pass the label content
    /// directly - don't nest a <c>BreadcrumbLink</c>.
    /// </summary>
    [Parameter] public bool Current { get; set; }

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The step content - a link, or (when <see cref="Current"/> is set) the current page's label.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the <c>li</c>.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "breadcrumb-item")
            .Merge(Attributes, Tw.Merge("bz-breadcrumb-item", Class));
}
