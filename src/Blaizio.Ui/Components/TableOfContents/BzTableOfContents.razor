@namespace Blaizio.Ui
@*
    Styled TableOfContents - the "On This Page" panel: a muted link per heading, indented by
    level, with the section currently in view highlighted (data-active, set by the scrollspy in
    Blaizio.Base). Hidden automatically on pages without headings.

    Five looks (Variant): a plain List, a Rail whose single indicator slides between sections, that
    rail plus a scroll Progress track, Marks - a minimap of dashes that opens all its labels on
    hover or keyboard focus - and Peek, the same minimap with no panel at all, where hovering one
    dash pops just that heading's card (PeekContent makes it as rich as you like). The rail,
    progress and mark geometry all come from the custom properties ts/toc.ts publishes on the nav,
    so the motion is pure CSS.

    Position floats the panel against an edge of the viewport (logical, so Start is the left in LTR
    and the right in RTL) at the top, the middle or the bottom, with a slide-in on mount. Inline
    (the default) leaves it in the layout flow.

    Customizable: LinkClass restyles the links (merged over the defaults, so data-active: variants
    win), Sticky pins an inline panel under a header without hand-written CSS, and ItemContent
    replaces the link rendering wholesale.

        <BzTableOfContents ContentSelector="main" TopOffset="80" Sticky />
        <BzTableOfContents Variant="TocVariant.Marks" Position="TocPosition.StartCenter" />
        <BzTableOfContents Variant="TocVariant.Peek" Position="TocPosition.EndCenter" />
*@

<BaseTableOfContents ContentSelector="@ContentSelector"
                      HeadingSelector="@HeadingSelector"
                      TopOffset="@TopOffset"
                      RootSelector="@RootSelector"
                      UpdateHash="@UpdateHash"
                      Class="@RootClasses()"
                      Attributes="ForwardedAttributes()">
    <HeaderContent>
        @if (TitleContent is not null)
        {
            @TitleContent
        }
        else if (Title is not null)
        {
            <p data-slot="toc-title" class="@TitleClasses()">@Title</p>
        }
        @if (HasRail)
        {
            @* Absolutely positioned decorations, so they never take part in the link flow. Their
               geometry is measured by the spy and handed over as custom properties. *@
            <span data-slot="toc-track" aria-hidden="true" class="@TrackClasses()"></span>
            @if (Variant is TocVariant.Progress)
            {
                <span data-slot="toc-progress" aria-hidden="true" class="@ProgressClasses()"></span>
            }
            <span data-slot="toc-indicator" aria-hidden="true" class="@IndicatorClasses()"></span>
        }
    </HeaderContent>
    <ItemContent Context="heading">
        @if (ItemContent is not null)
        {
            @ItemContent(heading)
        }
        else if (Variant is TocVariant.Peek)
        {
            @* Per-heading reveal: the mark is the whole control, and only the hovered (or focused)
               one shows its label. The label is in the DOM at all times - opacity hides it from
               the eye, never from a screen reader or Tab. *@
            <a href="#@heading.Id"
               data-toc-id="@heading.Id"
               data-slot="toc-link"
               class="@LinkClasses(heading)">
                <span data-slot="toc-mark" aria-hidden="true" class="@MarkClasses()"></span>
                <span data-slot="toc-peek" class="@PeekClasses()">
                    @if (PeekContent is not null)
                    {
                        @PeekContent(heading)
                    }
                    else
                    {
                        <span class="block font-medium">@heading.Text</span>
                    }
                </span>
            </a>
        }
        else if (Variant is TocVariant.Marks)
        {
            @* The label stays in the DOM at every width (clipped, never hidden), so screen readers
               and Tab still reach every section while the panel is collapsed. *@
            <a href="#@heading.Id"
               data-toc-id="@heading.Id"
               data-slot="toc-link"
               class="@LinkClasses(heading)">
                <span data-slot="toc-mark" aria-hidden="true" class="@MarkClasses()"></span>
                <span data-slot="toc-label" class="@LabelClasses()">@heading.Text</span>
            </a>
        }
        else
        {
            <a href="#@heading.Id"
               data-toc-id="@heading.Id"
               data-slot="toc-link"
               class="@LinkClasses(heading)">@heading.Text</a>
        }
    </ItemContent>
</BaseTableOfContents>

@code {
    /// <summary>The panel's title. Defaults to "On This Page". Set <see langword="null"/> to omit it.</summary>
    [Parameter] public string? Title { get; set; } = "On This Page";

    /// <summary>How the headings are presented. Defaults to <see cref="TocVariant.List"/>.</summary>
    [Parameter] public TocVariant Variant { get; set; } = TocVariant.List;

    /// <summary>
    /// Where the panel sits. Defaults to <see cref="TocPosition.Inline"/> (the layout flow); every
    /// other value floats it against a viewport edge and takes precedence over <see cref="Sticky"/>.
    /// Pass <c>absolute</c> in <see cref="Class"/> to anchor a floating panel inside the nearest
    /// positioned ancestor instead of the viewport.
    /// </summary>
    [Parameter] public TocPosition Position { get; set; } = TocPosition.Inline;

    /// <summary>Selector of the element whose headings are listed. Defaults to <c>main</c>.</summary>
    [Parameter] public string ContentSelector { get; set; } = "main";

    /// <summary>Selector for the headings to list, scoped to the content. Defaults to <c>h2, h3</c>.</summary>
    [Parameter] public string HeadingSelector { get; set; } = "h2, h3";

    /// <summary>Pixels between the viewport top and the "active" line (e.g. a sticky header's height).</summary>
    [Parameter] public int TopOffset { get; set; }

    /// <summary>
    /// Selector of a scrollable container to track instead of the window. Leave <see langword="null"/>
    /// to track window scroll.
    /// </summary>
    [Parameter] public string? RootSelector { get; set; }

    /// <summary>
    /// When <see langword="true"/> (the default), clicking a link writes the section to the URL as
    /// <c>/page#section</c>. Set <see langword="false"/> to scroll without changing the address bar.
    /// </summary>
    [Parameter] public bool UpdateHash { get; set; } = true;

    /// <summary>
    /// Pins the panel with <c>position: sticky</c> below a header (<c>top-20 self-start</c>) so it
    /// stays in view while the page scrolls. Override the offset with a <c>top-*</c> class in
    /// <see cref="Class"/>. Ignored when <see cref="Position"/> floats the panel, which already
    /// keeps it in view.
    /// </summary>
    [Parameter] public bool Sticky { get; set; }

    /// <summary>Extra classes for each link, merged over the defaults (use <c>data-active:</c> variants for the active state).</summary>
    [Parameter] public string? LinkClass { get; set; }

    /// <summary>Extra classes for the title, merged over the defaults.</summary>
    [Parameter] public string? TitleClass { get; set; }

    /// <summary>Replaces the title entirely. Takes precedence over <see cref="Title"/>.</summary>
    [Parameter] public RenderFragment? TitleContent { get; set; }

    /// <summary>
    /// Replaces the link rendering for each heading. Keep <c>href="#id"</c> and <c>data-toc-id="id"</c>
    /// on the anchor so the scrollspy can target it.
    /// </summary>
    [Parameter] public RenderFragment<TocHeading>? ItemContent { get; set; }

    /// <summary>
    /// The card a <see cref="TocVariant.Peek"/> mark shows while hovered or focused. Defaults to the
    /// heading's text; supply your own for a richer card (a title with a line of description, a
    /// count, a thumbnail). Ignored by every other variant.
    /// </summary>
    [Parameter] public RenderFragment<TocHeading>? PeekContent { get; set; }

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the nav.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    /// <summary>The variants that draw a rail down the start edge of the links.</summary>
    private bool HasRail => Variant is TocVariant.Rail or TocVariant.Progress;

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder()
            .Data("slot", "toc")
            .Data("variant", Variant.GetDescription())
            .Data("position", Position.GetDescription())
            .Merge(Attributes);

    private string RootClasses() => Tw.Merge(
        "bz-toc text-sm",
        Variant is TocVariant.List ? null : "group/toc relative",
        // Collapsed, the marks sit close enough to read as one object (a minimap, not a list);
        // reaching for the panel opens the spacing back up on the same curve as the labels.
        Variant is TocVariant.Marks
            ? "flex w-fit flex-col gap-px rounded-lg p-2 transition-[background-color,box-shadow,gap] duration-300 " +
              "hover:gap-1 focus-within:gap-1 " +
              "hover:bg-popover hover:shadow-md focus-within:bg-popover focus-within:shadow-md"
            : null,
        // Peek never opens: it stays a bare column of ticks and lets one label out at a time.
        Variant is TocVariant.Peek ? "flex w-fit flex-col gap-1 py-1" : null,
        // A floating panel sits over the content, so everything except the minimap variants (bare
        // until you reach for them) carries its own surface.
        Position.IsFloating() && Variant is not (TocVariant.Marks or TocVariant.Peek)
            ? "bg-popover text-popover-foreground max-h-[min(24rem,80vh)] w-56 overflow-y-auto rounded-lg border p-3 shadow-md scrollbar-thin"
            : null,
        Position.IsFloating() ? Position.Classes() : Sticky ? "sticky top-20 self-start" : null,
        Class);

    private string TitleClasses() => Tw.Merge(
        "bz-toc-title text-foreground mb-2 font-medium",
        Variant is TocVariant.Marks or TocVariant.Peek ? "sr-only" : null,
        TitleClass);

    /// <summary>The hairline the indicator runs along, spanning the links only (never the title).</summary>
    /// <summary>
    /// Where the rail sits, measured from the nav's padding edge. A floating panel carries its own
    /// padding (below), so the rail has to clear it or it would draw on the border; an inline panel
    /// has none, and the links start at the edge.
    /// </summary>
    private string RailInset => Position.IsFloating() ? "start-3" : "start-0";

    private string TrackClasses() => Tw.Merge(
        "bg-border pointer-events-none absolute w-px rounded-full " +
        "top-[var(--bz-toc-links-top,0px)] h-[var(--bz-toc-links-h,0px)]",
        RailInset);

    /// <summary>The same line, filled from the top as the tracked region scrolls.</summary>
    private string ProgressClasses() => Tw.Merge(
        "bg-primary/40 pointer-events-none absolute w-px origin-top rounded-full " +
        "top-[var(--bz-toc-links-top,0px)] h-[var(--bz-toc-links-h,0px)] scale-y-[var(--bz-toc-progress,0)] " +
        "transition-transform duration-150 ease-out",
        RailInset);

    /// <summary>The bar that slides to the section in view (zero height until the spy measures it).</summary>
    private string IndicatorClasses() => Tw.Merge(
        "bg-primary pointer-events-none absolute top-0 w-0.5 rounded-full " +
        "h-[var(--bz-toc-indicator-h,0px)] translate-y-[var(--bz-toc-indicator-y,0px)] " +
        "transition-[translate,height] duration-300 ease-out",
        RailInset);

    private string MarkClasses() =>
        "bg-current h-[var(--bz-toc-mark-h,1px)] w-[var(--bz-toc-mark-w,1rem)] shrink-0 rounded-full " +
        "transition-[width,height] duration-300 ease-out";

    /// <summary>
    /// The label is clipped to zero width while the panel is closed, but its LINE BOX still holds
    /// the row open - which is what pushed the marks apart. Collapsing the leading with it takes
    /// each row down to the dash itself, and both re-open together on the same curve.
    /// </summary>
    private string LabelClasses() =>
        "overflow-hidden whitespace-nowrap opacity-0 leading-[0] " +
        "transition-[opacity,line-height] duration-200 ease-out " +
        "group-hover/toc:opacity-100 group-hover/toc:leading-5 " +
        "group-focus-within/toc:opacity-100 group-focus-within/toc:leading-5 " +
        "delay-[calc(var(--bz-toc-index,0)*25ms)]";

    /// <summary>
    /// The card one mark shows while it is hovered or focused. It opens away from the edge the
    /// panel is pinned to, so an end-anchored minimap opens inward instead of off-screen, and it
    /// fades rather than slides - a translate would fight the panel's own entrance animation.
    /// </summary>
    private string PeekClasses() => Tw.Merge(
        "bz-toc-peek bg-popover text-popover-foreground pointer-events-none absolute top-1/2 z-20 " +
        "w-max max-w-64 -translate-y-1/2 rounded-md border px-2.5 py-1.5 text-xs leading-snug shadow-md " +
        "opacity-0 scale-95 origin-[var(--bz-toc-peek-origin)] transition-[opacity,scale] duration-150 ease-out " +
        "group-hover/toc-item:opacity-100 group-hover/toc-item:scale-100 " +
        "group-focus-visible/toc-item:opacity-100 group-focus-visible/toc-item:scale-100",
        PeeksInward
            ? "end-full me-2 [--bz-toc-peek-origin:right_center]"
            : "start-full ms-2 [--bz-toc-peek-origin:left_center]");

    /// <summary>True when the panel hugs the end edge, so its labels must open back toward the page.</summary>
    private bool PeeksInward =>
        Position is TocPosition.EndTop or TocPosition.EndCenter or TocPosition.EndBottom;

    private string LinkClasses(TocHeading heading) => Variant switch
    {
        // The mark's size travels as a custom property so the anchor's data-active variant can set
        // it - the state lives on the link, the geometry on the dash inside it.
        // Collapsed rows are tight to the mark; the padding opens with the labels so the panel
        // grows in one motion instead of the text appearing inside a list that never moved.
        TocVariant.Marks => Tw.Merge(
            "bz-toc-link text-muted-foreground/70 hover:text-foreground data-active:text-foreground " +
            "grid grid-cols-[auto_0fr] items-center gap-0 py-0.5 " +
            "transition-[grid-template-columns,column-gap,padding,color] duration-300 ease-out " +
            "delay-[calc(var(--bz-toc-index,0)*25ms)] " +
            "group-hover/toc:grid-cols-[auto_1fr] group-hover/toc:gap-2 group-hover/toc:py-1 " +
            "group-focus-within/toc:grid-cols-[auto_1fr] group-focus-within/toc:gap-2 group-focus-within/toc:py-1 " +
            "data-active:[--bz-toc-mark-h:2px]",
            heading.Level switch
            {
                <= 2 => "[--bz-toc-mark-w:1.5rem] data-active:[--bz-toc-mark-w:2rem]",
                3 => "[--bz-toc-mark-w:1rem] data-active:[--bz-toc-mark-w:1.5rem]",
                _ => "[--bz-toc-mark-w:0.75rem] data-active:[--bz-toc-mark-w:1.25rem]",
            },
            LinkClass),

        // Peek: the row IS the mark, and it owns a group of its own so the label that opens is
        // this heading's and no other. Width still reads the level, so the column sketches the
        // page's shape - long ticks for sections, short ones for what sits under them.
        TocVariant.Peek => Tw.Merge(
            "bz-toc-link group/toc-item text-muted-foreground/50 hover:text-foreground data-active:text-foreground " +
            "relative flex items-center py-1 transition-colors duration-200 " +
            "data-active:[--bz-toc-mark-h:2px]",
            heading.Level switch
            {
                <= 2 => "[--bz-toc-mark-w:1.25rem] data-active:[--bz-toc-mark-w:1.75rem]",
                3 => "[--bz-toc-mark-w:0.875rem] data-active:[--bz-toc-mark-w:1.375rem]",
                _ => "[--bz-toc-mark-w:0.625rem] data-active:[--bz-toc-mark-w:1.125rem]",
            },
            LinkClass),

        // Rail and progress share the list's typography; the indent leaves room for the rail.
        TocVariant.Rail or TocVariant.Progress => Tw.Merge(
            "bz-toc-link text-muted-foreground hover:text-foreground data-active:text-foreground " +
            "block py-1 transition-colors data-active:font-medium",
            heading.Level switch { <= 2 => "ps-4", 3 => "ps-7", _ => "ps-10" },
            LinkClass),

        _ => Tw.Merge(
            "bz-toc-link text-muted-foreground hover:text-foreground data-active:text-foreground " +
            "block py-1 transition-colors data-active:font-medium",
            heading.Level switch { <= 2 => null, 3 => "ps-4", _ => "ps-8" },
            LinkClass),
    };
}
