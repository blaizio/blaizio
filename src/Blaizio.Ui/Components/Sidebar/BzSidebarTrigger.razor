@namespace Blaizio.Ui
@*
    Toggles the sidebar (the mobile sheet on mobile, the desktop expand/collapse otherwise). Renders a
    ghost icon button by default; pass ChildContent for your own glyph, or RenderAs to put the toggle
    behaviour on your own element. Place it anywhere under the BzSidebarProvider - the inset header
    or the sidebar header itself.
*@

<BzButton Variant="ButtonVariant.Ghost"
          Size="ButtonSize.IconSm"
          Type="ButtonType.Button"
          Class="@Tw.Merge("bz-sidebar-trigger size-7", Class)"
          Attributes="BuildAttributes()"
          RenderAs="@RenderAs">
    @(ChildContent ?? DefaultContent)
</BzButton>

@code {
    /// <summary>Extra classes, merged over the default ghost button.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The button content. Defaults to a panel icon plus a screen-reader label.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the toggle behaviour onto your own element instead of the default <c>&lt;BzButton&gt;</c>.</summary>
    [Parameter] public RenderFragment<BzRenderProps>? RenderAs { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    [CascadingParameter] private SidebarContext? Context { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "sidebar-trigger")
            .Data("sidebar", "trigger")
            .On("onclick", EventCallback.Factory.Create<MouseEventArgs>(this, Toggle))
            .Merge(Attributes);

    private Task Toggle() => Context?.Toggle.InvokeAsync() ?? Task.CompletedTask;

    @* The glyph draws its panel on the left; under RTL the sidebar sits right, so mirror it. *@
    private RenderFragment DefaultContent => @<text>
        <BzIcon Icon="@Icons.Outline.LayoutSidebar" Class="rtl:-scale-x-100" />
        <span class="sr-only">Toggle Sidebar</span>
    </text>;
}
