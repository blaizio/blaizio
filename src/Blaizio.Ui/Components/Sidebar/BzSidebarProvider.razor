@namespace Blaizio.Ui
@inject IJSRuntime Js
@implements IAsyncDisposable
@*
    The stateful root every sidebar lives under. It owns the open/collapsed state (controllable via
    @bind-Open, or self-managed and persisted to a cookie), detects the mobile breakpoint to swap the
    desktop panel for a Sheet, and binds Ctrl/Cmd+B to toggle. The resolved state is cascaded as a
    SidebarContext so the shell, trigger, rail and menu buttons can read it. Wrap your whole app layout
    (sidebar + inset) in one provider.
*@

<CascadingValue Value="@Context" IsFixed="false">
    <BzTooltipProvider DelayDuration="0">
        <BasePrimitive As="div" Attributes="@BuildAttributes()" ChildContent="@ChildContent" />
    </BzTooltipProvider>
</CascadingValue>

@code {
    /// <summary>Initial expanded state when uncontrolled. A persisted cookie, if present, wins over this. Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool DefaultOpen { get; set; } = true;

    /// <summary>Controlled expanded state. Leave <see langword="null"/> to let the provider manage (and persist) it.</summary>
    [Parameter] public bool? Open { get; set; }

    /// <summary>Raised with the new expanded state. Enables <c>@bind-Open</c>.</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Viewport width (px) below which the sidebar becomes a mobile sheet. Defaults to 768 (Tailwind's <c>md</c>).</summary>
    [Parameter] public int MobileBreakpoint { get; set; } = 768;

    /// <summary>Width of the expanded sidebar (the <c>--sidebar-width</c> custom property). Defaults to <c>16rem</c>.</summary>
    [Parameter] public string Width { get; set; } = "16rem";

    /// <summary>Width of the collapsed icon rail (the <c>--sidebar-width-icon</c> custom property). Defaults to <c>3rem</c>.</summary>
    [Parameter] public string WidthIcon { get; set; } = "3rem";

    /// <summary>Width of the mobile sheet (the <c>--sidebar-width</c> applied to the Sheet). Defaults to <c>18rem</c>.</summary>
    [Parameter] public string WidthMobile { get; set; } = "18rem";

    /// <summary>Persist the open state to a cookie so it survives reloads (uncontrolled only). Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool PersistState { get; set; } = true;

    /// <summary>Extra classes for the wrapper, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The sidebar and the inset/main content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the wrapper element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private const string CookieName = "sidebar_state";
    private const int CookieMaxAge = 60 * 60 * 24 * 7; // one week

    private bool _open = true;     // uncontrolled backing store
    private bool _openMobile;
    private bool _isMobile;
    private bool _cookieRead;

    private IJSObjectReference? _module;
    private IJSObjectReference? _hotkeyModule;
    private IJSObjectReference? _watcher;
    private IJSObjectReference? _hotkey;
    private DotNetObjectReference<BzSidebarProvider>? _selfRef;

    private bool OpenState => Open ?? _open;

    private SidebarContext Context => new(
        OpenState,
        _openMobile,
        _isMobile,
        EventCallback.Factory.Create<bool>(this, SetOpenAsync),
        EventCallback.Factory.Create<bool>(this, SetOpenMobile),
        EventCallback.Factory.Create(this, ToggleAsync));

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "sidebar-wrapper")
            .Merge(
                Attributes,
                Tw.Merge("group/sidebar-wrapper flex min-h-svh w-full has-data-[variant=inset]:bg-sidebar", Class),
                $"--sidebar-width:{Width};--sidebar-width-icon:{WidthIcon};--sidebar-width-mobile:{WidthMobile}");

    protected override void OnInitialized() => _open = DefaultOpen;

    /// <summary>Sets the desktop open state - through the bind when controlled, else self-managed + persisted.</summary>
    public async Task SetOpenAsync(bool value)
    {
        if (Open is null) _open = value;
        await OpenChanged.InvokeAsync(value);
        if (PersistState && _module is not null)
        {
            try { await _module.InvokeVoidAsync("setCookie", CookieName, value ? "true" : "false", CookieMaxAge); }
            catch (JSDisconnectedException) { }
        }
        StateHasChanged();
    }

    /// <summary>Sets the mobile sheet open state.</summary>
    public Task SetOpenMobile(bool value)
    {
        _openMobile = value;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>Toggles the sidebar: the mobile sheet on mobile, the desktop state otherwise.</summary>
    public Task ToggleAsync() => _isMobile ? SetOpenMobile(!_openMobile) : SetOpenAsync(!OpenState);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _module = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/Blaizio.Base/dist/sidebar.js");
            _selfRef = DotNetObjectReference.Create(this);

            // Seed the mobile state and subscribe to breakpoint crossings.
            _isMobile = await _module.InvokeAsync<bool>("matchesMobile", MobileBreakpoint);
            _watcher = await _module.InvokeAsync<IJSObjectReference>("observeMobile", _selfRef, MobileBreakpoint);

            // Restore the persisted open state (uncontrolled only).
            if (Open is null && PersistState && !_cookieRead)
            {
                _cookieRead = true;
                var cookie = await _module.InvokeAsync<string>("getCookie", CookieName);
                if (cookie is "true" or "false") _open = cookie == "true";
            }

            // Ctrl/Cmd+B toggles the sidebar.
            _hotkeyModule = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/Blaizio.Base/dist/hotkeys.js");
            _hotkey = await _hotkeyModule.InvokeAsync<IJSObjectReference>("createHotkey", "mod+b", _selfRef, true);

            StateHasChanged();
        }
        catch (JSDisconnectedException) { }
    }

    [JSInvokable]
    public Task OnMobileChanged(bool isMobile)
    {
        if (_isMobile == isMobile) return Task.CompletedTask;
        _isMobile = isMobile;
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnHotkey() => ToggleAsync();

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_watcher is not null) { await _watcher.InvokeVoidAsync("dispose"); await _watcher.DisposeAsync(); }
            if (_hotkey is not null) { await _hotkey.InvokeVoidAsync("dispose"); await _hotkey.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
            if (_hotkeyModule is not null) await _hotkeyModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        _selfRef?.Dispose();
    }
}
