@namespace Blaizio.Ui
@*
    A small count/label pinned to the trailing edge of a menu row (e.g. an unread count). Decorative
    (does not take the pointer) and hidden while collapsed to an icon rail.
*@

<BasePrimitive As="div" Attributes="@BuildAttributes()" ChildContent="@ChildContent" />

@code {
    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Badge content (a number or short label).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "sidebar-menu-badge")
            .Data("sidebar", "menu-badge")
            .Merge(Attributes, Tw.Merge(
                "bz-sidebar-menu-badge pointer-events-none absolute end-1 flex h-5 min-w-5 items-center justify-center px-1 " +
                "text-xs font-medium text-sidebar-foreground tabular-nums select-none " +
                "peer-hover/menu-button:text-sidebar-accent-foreground peer-data-[active=true]/menu-button:text-sidebar-accent-foreground " +
                "peer-data-[size=sm]/menu-button:top-1 peer-data-[size=default]/menu-button:top-1.5 peer-data-[size=lg]/menu-button:top-2.5 " +
                "group-data-[collapsible=icon]:hidden",
                Class));
}
