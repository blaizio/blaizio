@namespace Blaizio.Ui
@* A run of adjacent slots that share borders and round at the group's outer corners. *@

<BasePrimitive As="div" Attributes="BuildAttributes()" ChildContent="@ChildContent" />

@code {
    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The slots in this group.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "input-otp-group")
            .Merge(Attributes, Tw.Merge(
                "bz-input-otp-group flex items-center " +
                // Soft destructive halo around the whole group's outer edge when the field is invalid - the
                // same ring BzInputText uses (ring-destructive/20, /40 dark). The per-preset corner radius
                // lives on .bz-input-otp-group in each skin so the ring aligns with the rounded slots.
                "group-aria-invalid/input-otp:ring-[3px] group-aria-invalid/input-otp:ring-destructive/20 " +
                "dark:group-aria-invalid/input-otp:ring-destructive/40",
                Class));
}
