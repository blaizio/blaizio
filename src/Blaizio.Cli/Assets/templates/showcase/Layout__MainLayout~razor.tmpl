@inherits LayoutComponentBase

<div class="min-h-screen flex bg-background text-foreground">
    <aside class="w-60 shrink-0 border-e border-border p-4 hidden md:flex md:flex-col gap-4">
        <div class="bz-font-heading text-lg font-semibold">{{ProjectName}}</div>
        <nav class="flex flex-col gap-1 text-sm">
            <a href="" class="rounded-md px-3 py-2 bg-accent text-accent-foreground">Overview</a>
        </nav>
    </aside>

    <div class="flex-1 flex flex-col min-w-0">
        <header class="h-14 shrink-0 border-b border-border flex items-center justify-between px-6">
            <span class="text-sm text-muted-foreground">Blaizio showcase</span>
            <BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" @onclick="ToggleDarkAsync">
                @(_dark ? "Light" : "Dark") mode
            </BzButton>
        </header>
        <main class="flex-1 p-6 max-w-4xl w-full mx-auto">
            @Body
        </main>
    </div>
</div>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private bool _dark;

    private async Task ToggleDarkAsync()
    {
        _dark = !_dark;
        await JS.InvokeVoidAsync("blaizioToggleDark", _dark);
    }
}
