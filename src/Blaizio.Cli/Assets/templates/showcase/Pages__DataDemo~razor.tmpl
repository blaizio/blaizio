@page "/data"

<PageTitle>Data - {{ProjectName}}</PageTitle>

<h1 class="font-heading text-2xl font-semibold tracking-tight">Data display</h1>
<p class="text-muted-foreground mt-1">Accordions, collapsibles, trees and carousels for structuring content.</p>

<BzSeparator Class="my-6" />

<section class="space-y-3">
    <h2 class="text-sm font-medium text-muted-foreground">Accordion</h2>
    <BzAccordion DefaultValue="item-1" Collapsible Class="w-full max-w-md">
        <BzAccordionItem Value="item-1">
            <BzAccordionTrigger>Is it accessible?</BzAccordionTrigger>
            <BzAccordionContent>Yes. It follows the WAI-ARIA accordion pattern: a heading-wrapped button wired to its region.</BzAccordionContent>
        </BzAccordionItem>
        <BzAccordionItem Value="item-2">
            <BzAccordionTrigger>Is it styled?</BzAccordionTrigger>
            <BzAccordionContent>Yes. It ships as Tailwind-styled source you own and can restyle freely.</BzAccordionContent>
        </BzAccordionItem>
        <BzAccordionItem Value="item-3">
            <BzAccordionTrigger>Is it animated?</BzAccordionTrigger>
            <BzAccordionContent>Yes. The open and close animate to the panel's measured height.</BzAccordionContent>
        </BzAccordionItem>
    </BzAccordion>
</section>

<section class="space-y-3 mt-8">
    <h2 class="text-sm font-medium text-muted-foreground">Collapsible</h2>
    <BzCollapsible @bind-Open="_detailsOpen" Class="flex w-full max-w-sm flex-col gap-2">
        <BzCollapsibleTrigger>
            <RenderAs Context="p">
                <BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" @attributes="p.Attributes">
                    @(_detailsOpen ? "Hide details" : "Show details")
                </BzButton>
            </RenderAs>
        </BzCollapsibleTrigger>
        <BzCollapsibleContent Class="flex flex-col gap-2">
            <div class="rounded-md border border-border px-4 py-2 font-mono text-sm">src/Layout.razor</div>
            <div class="rounded-md border border-border px-4 py-2 font-mono text-sm">wwwroot/app.css</div>
        </BzCollapsibleContent>
    </BzCollapsible>
</section>

<section class="space-y-3 mt-8">
    <h2 class="text-sm font-medium text-muted-foreground">Tree</h2>
    <div class="w-full max-w-sm">
        <BzTree TItem="TreeItem"
                Items="_explorer"
                ValueSelector="@(n => n.Id)"
                TextSelector="@(n => n.Name)"
                ChildrenSelector="@(n => n.Children)"
                DefaultExpandedValues="@(new[] { "src" })" />
    </div>
</section>

<section class="space-y-3 mt-8">
    <h2 class="text-sm font-medium text-muted-foreground">Carousel</h2>
    <div class="mx-auto w-full max-w-xs">
        <BzCarousel>
            <BzCarouselContent>
                @foreach (var i in Enumerable.Range(1, 4))
                {
                    <BzCarouselItem>
                        <div class="flex aspect-square items-center justify-center rounded-xl border border-border bg-muted">
                            <span class="text-4xl font-semibold">@i</span>
                        </div>
                    </BzCarouselItem>
                }
            </BzCarouselContent>
            <BzCarouselPrevious />
            <BzCarouselNext />
            <BzCarouselDots />
        </BzCarousel>
    </div>
</section>

@code {
    private bool _detailsOpen;

    private sealed class TreeItem
    {
        public required string Id { get; init; }
        public required string Name { get; set; }
        public List<TreeItem>? Children { get; set; }
    }

    private static TreeItem File(string id, string name) =>
        new() { Id = id, Name = name };

    private static TreeItem Folder(string id, string name, params TreeItem[] children) =>
        new() { Id = id, Name = name, Children = [.. children] };

    private readonly List<TreeItem> _explorer =
    [
        Folder("src", "src",
            Folder("components", "components", File("button", "Button.razor"), File("tree", "Tree.razor")),
            File("app", "App.razor"),
            File("program", "Program.cs")),
        Folder("docs", "docs", File("readme", "README.md"), File("changelog", "CHANGELOG.md")),
        File("license", "LICENSE"),
    ];
}
