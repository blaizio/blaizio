<!DOCTYPE html>
<html lang="en" class="style-{{Skin}}">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ProjectName}}</title>
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
</head>
<body>
    <div id="app">
        <div style="display:flex;height:100vh;align-items:center;justify-content:center;font-family:system-ui">Loading…</div>
    </div>

    <div id="blazor-error-ui">
        An unhandled error has occurred. <a href="" class="reload">Reload</a>
    </div>

    <script>
        // Called by MainLayout's theme toggle. Kept tiny + inline so the template ships no JS files.
        window.blaizioToggleDark = (on) => document.documentElement.classList.toggle('dark', on);
    </script>
    <script src="_framework/blazor.webassembly.js"></script>
</body>
</html>
