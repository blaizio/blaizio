@page "/"

<h1 class="bz-font-heading text-2xl font-semibold tracking-tight">Welcome to {{ProjectName}}</h1>
<p class="text-muted-foreground mt-1">A starter built with Blaizio components — copied into your project as source.</p>

<BzSeparator Class="my-6" />

<section class="space-y-3">
    <h2 class="text-sm font-medium text-muted-foreground">Buttons</h2>
    <div class="flex flex-wrap gap-3">
        <BzButton>Default</BzButton>
        <BzButton Variant="ButtonVariant.Secondary">Secondary</BzButton>
        <BzButton Variant="ButtonVariant.Outline">Outline</BzButton>
        <BzButton Variant="ButtonVariant.Destructive">Destructive</BzButton>
        <BzButton Variant="ButtonVariant.Ghost">Ghost</BzButton>
    </div>
</section>

<section class="space-y-3 mt-8">
    <h2 class="text-sm font-medium text-muted-foreground">Badges</h2>
    <div class="flex flex-wrap gap-2">
        <BzBadge>Default</BzBadge>
        <BzBadge Variant="BadgeVariant.Secondary">Secondary</BzBadge>
        <BzBadge Variant="BadgeVariant.Outline">Outline</BzBadge>
        <BzBadge Variant="BadgeVariant.Destructive">Destructive</BzBadge>
    </div>
</section>

<div class="grid gap-4 md:grid-cols-2 mt-8">
    <BzCard>
        <BzCardHeader>
            <BzCardTitle>Card title</BzCardTitle>
            <BzCardDescription>Cards group related content and actions.</BzCardDescription>
        </BzCardHeader>
        <BzCardContent>
            <p class="text-sm">Everything here is Tailwind-styled source you own and can edit.</p>
        </BzCardContent>
        <BzCardFooter>
            <BzButton Size="ButtonSize.Sm">Get started</BzButton>
        </BzCardFooter>
    </BzCard>

    <BzAlert>
        <BzAlertTitle>Heads up</BzAlertTitle>
        <BzAlertDescription>
            Add more components any time with <code>blaizio add &lt;name&gt;</code>.
        </BzAlertDescription>
    </BzAlert>
</div>
