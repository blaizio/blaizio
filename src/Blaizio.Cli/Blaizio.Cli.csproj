<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Blaizio.Cli</RootNamespace>
    <AssemblyName>blaizio</AssemblyName>

    <!-- Ship as a dotnet tool: install globally as `blaizio`, or run one-shot via dnx. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>blaizio</ToolCommandName>
    <PackageId>Blaizio.Cli</PackageId>
    <Title>Blaizio CLI</Title>
    <Description>Command-line tool for the Blaizio component framework: initialize a project and add components from the registry into your Blazor app as source.</Description>
    <Version>0.1.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>blazor;components;cli;dotnet-tool;ui</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Console app, not a library: no XML doc file needed. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blaizio.Cli.Core\Blaizio.Cli.Core.csproj" />
  </ItemGroup>

  <!-- The package version this tool writes into a project comes from the build, not from a literal
       a release can forget to move: BlaizioVersionBase (Directory.Build.props) is what Blaizio.Base
       and Blaizio.Icons pack as, so init/upgrade can only ever name a version that exists. -->
  <Target Name="GenerateBlaizioBuildVersions" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <_BlaizioBuildVersionsFile>$(IntermediateOutputPath)BuildVersions.g.cs</_BlaizioBuildVersionsFile>
    </PropertyGroup>
    <ItemGroup>
      <_BlaizioBuildVersionsLine Include="// Generated by Blaizio.Cli.csproj. Do not edit." />
      <_BlaizioBuildVersionsLine Include="namespace Blaizio.Cli.Infrastructure%3B" />
      <_BlaizioBuildVersionsLine Include="internal static class BuildVersions" />
      <_BlaizioBuildVersionsLine Include="{" />
      <_BlaizioBuildVersionsLine Include="    public const string Blaizio = &quot;$(BlaizioVersionBase)&quot;%3B" />
      <_BlaizioBuildVersionsLine Include="}" />
    </ItemGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(_BlaizioBuildVersionsFile)"
                      Lines="@(_BlaizioBuildVersionsLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_BlaizioBuildVersionsFile)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Blaizio.Cli.Tests" />
  </ItemGroup>

  <!-- CSS assets embedded so `init` can wire Tailwind offline: the theme tokens plus Blaizio.Ui's
       base contract and every skin. Linked directly from Blaizio.Ui so they never drift. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\theme.css" LogicalName="theme.css" />
    <EmbeddedResource Include="Assets\animate.css" LogicalName="animate.css" />
    <!-- Link puts the cross-project files under Assets\styles in the IDE instead of the project root. -->
    <EmbeddedResource Include="..\Blaizio.Ui\Styles\blaizio.css" LogicalName="blaizio.css" Link="Assets\styles\blaizio.css" />
    <EmbeddedResource Include="..\Blaizio.Ui\Styles\shared.css" LogicalName="shared.css" Link="Assets\styles\shared.css" />
    <EmbeddedResource Include="..\Blaizio.Ui\Styles\style-*.css">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
      <Link>Assets\styles\%(Filename)%(Extension)</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Blaizio.Ui\Styles\preset-*.css">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
      <Link>Assets\styles\%(Filename)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Project templates scaffolded by `new <template>`. Flat file names encode the destination
       path with __ for directory separators; the resource name carries the template id. The default
       item globs are removed first so a name like Program.cs.tmpl isn't claimed as a Compile item. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\templates\showcase\*.tmpl">
      <LogicalName>tpl.showcase.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Core (not the hosting package): the CLI has no generic host, and the low-level
         McpServer.Create + a tool collection is all `blaizio mcp` needs. -->
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <PackageReference Include="Spectre.Console" Version="0.57.3-alpha.0.7" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.1-alpha.0.7" />
  </ItemGroup>

</Project>
