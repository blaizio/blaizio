<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Blaizio.Cli</RootNamespace>
    <AssemblyName>blaizio</AssemblyName>

    <!-- Ship as a dotnet tool: install globally as `blaizio`, or run one-shot via dnx. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>blaizio</ToolCommandName>
    <PackageId>Blaizio.Cli</PackageId>
    <Title>Blaizio CLI</Title>
    <Description>Command-line tool for the Blaizio component framework: initialize a project and add components from the registry into your Blazor app as source.</Description>
    <Version>0.1.0-alpha.4</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>blazor;components;cli;dotnet-tool;ui</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Console app, not a library: no XML doc file needed. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blaizio.Cli.Core\Blaizio.Cli.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Blaizio.Cli.Tests" />
  </ItemGroup>

  <!-- CSS assets embedded so `init` can wire Tailwind offline: the theme tokens plus Blaizio.Ui's
       base contract and every skin. Linked directly from Blaizio.Ui so they never drift. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\theme.css" LogicalName="theme.css" />
    <EmbeddedResource Include="Assets\animate.css" LogicalName="animate.css" />
    <!-- Link puts the cross-project files under Assets\styles in the IDE instead of the project root. -->
    <EmbeddedResource Include="..\Blaizio.Ui\Styles\blaizio.css" LogicalName="blaizio.css" Link="Assets\styles\blaizio.css" />
    <EmbeddedResource Include="..\Blaizio.Ui\Styles\shared.css" LogicalName="shared.css" Link="Assets\styles\shared.css" />
    <EmbeddedResource Include="..\Blaizio.Ui\Styles\style-*.css">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
      <Link>Assets\styles\%(Filename)%(Extension)</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Blaizio.Ui\Styles\preset-*.css">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
      <Link>Assets\styles\%(Filename)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Project templates scaffolded by `init -t <template>`. Flat file names encode the destination
       path with __ for directory separators; the resource name carries the template id. The default
       item globs are removed first so a name like Program.cs.tmpl isn't claimed as a Compile item. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\templates\showcase\*.tmpl">
      <LogicalName>tpl.showcase.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.51.1" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.51.1" />
  </ItemGroup>

</Project>
