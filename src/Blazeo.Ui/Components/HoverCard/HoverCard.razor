@namespace Blazeo.Ui
@*
    Styled HoverCard root - wraps the headless BzHoverCard. Renders no element of its own; drop a
    HoverCardTrigger and a HoverCardContent inside. Hover-driven and non-modal: the page stays
    interactive while it is open.
*@

<BzHoverCard Open="@Open"
                DefaultOpen="@DefaultOpen"
                OpenChanged="@OpenChanged"
                OpenDelay="@OpenDelay"
                CloseDelay="@CloseDelay">
    @ChildContent
</BzHoverCard>

@code {
    /// <summary>Controlled open state. Use with <c>@bind-Open</c>.</summary>
    [Parameter] public bool? Open { get; set; }

    /// <summary>Initial state when uncontrolled.</summary>
    [Parameter] public bool DefaultOpen { get; set; }

    /// <summary>Raised with the new state. Enables <c>@bind-Open</c>.</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Milliseconds the pointer/focus must rest on the trigger before opening. Defaults to 700.</summary>
    [Parameter] public int OpenDelay { get; set; } = 700;

    /// <summary>Milliseconds after leaving before closing - long enough to cross onto the content. Defaults to 300.</summary>
    [Parameter] public int CloseDelay { get; set; } = 300;

    /// <summary>The trigger and content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
