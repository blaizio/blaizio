@namespace Blazeo.Ui
@* Styled ContextMenuGroup - groups related items as role="group" for assistive tech. *@

<BzDropdownMenuGroup Attributes="@ForwardedAttributes()">
    @ChildContent
</BzDropdownMenuGroup>

@code {
    /// <summary>The grouped items (and an optional leading label).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "context-menu-group").Merge(Attributes);
}
