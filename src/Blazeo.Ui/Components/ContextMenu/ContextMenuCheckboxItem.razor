@namespace Blazeo.Ui
@*
    Styled ContextMenuCheckboxItem - a menu item with a trailing check (inline-end), the inline-start
    free for an optional leading icon. Selecting it toggles the state and, by default, closes the menu
    (pass an OnSelect that calls PreventDefault to keep it open). Reuses the headless
    BaseDropdownMenuCheckboxItem.
*@

<BaseDropdownMenuCheckboxItem Class="@Tw.Merge(BaseClasses, Class)"
                               Checked="@Checked"
                               DefaultChecked="@DefaultChecked"
                               CheckedChanged="@CheckedChanged"
                               Disabled="@Disabled"
                               OnSelect="@OnSelect"
                               Attributes="@ForwardedAttributes()">
    <ChildContent>@ChildContent</ChildContent>
    <Indicator>
        <span class="absolute end-2 flex size-3.5 items-center justify-center">
            <BzIcon Icon="@Icons.Outline.Check" Class="size-4" />
        </span>
    </Indicator>
</BaseDropdownMenuCheckboxItem>

@code {
    /// <summary>Controlled checked state. Use with <c>@bind-Checked</c>.</summary>
    [Parameter] public bool? Checked { get; set; }

    /// <summary>Initial state when uncontrolled.</summary>
    [Parameter] public bool DefaultChecked { get; set; }

    /// <summary>Raised with the new state. Enables <c>@bind-Checked</c>.</summary>
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }

    /// <summary>Disables the item.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Item content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Raised when the item is selected. <see cref="MenuSelectEventArgs.PreventDefault"/> keeps the menu open.</summary>
    [Parameter] public EventCallback<MenuSelectEventArgs> OnSelect { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "context-menu-checkbox-item").Merge(Attributes);

    private const string BaseClasses =
        "bz-context-menu-checkbox-item relative flex cursor-default select-none items-center gap-2 rounded-sm " +
        "py-1.5 ps-2 pe-8 text-sm outline-none " +
        "focus:bg-accent focus:text-accent-foreground " +
        "data-disabled:pointer-events-none data-disabled:opacity-50 " +
        "[&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0";
}
