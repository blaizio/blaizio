@namespace Blazeo.Ui
@*
    Styled SheetContent - a Dialog window anchored to an edge (Side) that slides in and out. Reuses
    the Dialog machinery (focus trap, scroll lock, exit-animation presence) through BaseDialogContent
    and the shared overlay; only the positioning and slide direction differ, switched on Side and
    exposed as data-side. A ghost close button sits in the corner unless ShowCloseButton="false".

    ZIndex / DismissOnOutsideClick / OnExitComplete are set by DialogProvider for imperatively shown
    (stacked) sheets; ignore them for ordinary declarative use.
*@

<BzDialogOverlay DismissOnClick="@DismissOnOutsideClick" Style="@OverlayStyle" Class="@OverlayClass" />
<BaseDialogContent Class="@Tw.Merge(BaseClasses, SideClasses, Class)"
                    Style="@ContentStyle"
                    OnExitComplete="@OnExitComplete"
                    Attributes="@ForwardedAttributes()">
    @ChildContent
    @if (ShowCloseButton && Dialog?.PreventDismiss != true)
    {
        <BaseDialogClose data-slot="sheet-close">
            <AsChild Context="p">
                <BzButton Variant="ButtonVariant.Ghost"
                        Size="ButtonSize.IconSm"
                        Class="bz-sheet-close"
                        @attributes="p.Attributes">
                    <BzIcon Icon="@Icons.Outline.X" />
                    <span class="sr-only">Close</span>
                </BzButton>
            </AsChild>
        </BaseDialogClose>
    }
</BaseDialogContent>

@code {
    /// <summary>Which edge the sheet slides in from. Defaults to <see cref="SheetSide.End"/> (the inline-end edge).</summary>
    [Parameter] public SheetSide Side { get; set; } = SheetSide.End;

    /// <summary>Renders the corner close button. Defaults to <see langword="true"/>; auto-hidden when the sheet is locked (PreventDismiss).</summary>
    [Parameter] public bool ShowCloseButton { get; set; } = true;

    [CascadingParameter] private DialogContext? Dialog { get; set; }

    /// <summary>Pressing the backdrop dismisses the sheet. Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool DismissOnOutsideClick { get; set; } = true;

    /// <summary>Overlay z-index for stacked sheets (the content sits one above). Null uses the default layer.</summary>
    [Parameter] public int? ZIndex { get; set; }

    /// <summary>Raised after the exit animation finishes; <c>DialogProvider</c> uses it to drop a closed instance.</summary>
    [Parameter] public EventCallback OnExitComplete { get; set; }

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Extra classes for the backdrop overlay (e.g. <c>bg-black/70</c>, a tint, or a blur). Utilities win over the skin.</summary>
    [Parameter] public string? OverlayClass { get; set; }

    /// <summary>Sheet content (header, body, footer).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private string? OverlayStyle => ZIndex is { } z ? $"z-index:{z}" : null;
    private string? ContentStyle => ZIndex is { } z ? $"z-index:{z + 1}" : null;

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "sheet-content").Data("side", Side.GetDescription()).Merge(Attributes);

    private const string BaseClasses =
        "bz-sheet-content fixed z-50 flex flex-col gap-4 outline-none transition ease-in-out " +
        "data-open:animate-in data-closed:animate-out data-open:duration-500 data-closed:duration-300";

    // Start/End are LOGICAL (inline edges): they anchor with logical insets + borders and mirror under
    // RTL. The slide keyframe is physical (translateX), so ltr:/rtl: pick the matching direction - one
    // applies per reading direction (:dir(ltr) matches the default), avoiding a specificity tie.
    private string SideClasses => Side switch
    {
        SheetSide.End => "inset-y-0 end-0 h-full w-3/4 border-s sm:max-w-sm " +
            "ltr:data-open:slide-in-from-right ltr:data-closed:slide-out-to-right " +
            "rtl:data-open:slide-in-from-left rtl:data-closed:slide-out-to-left",
        SheetSide.Start => "inset-y-0 start-0 h-full w-3/4 border-e sm:max-w-sm " +
            "ltr:data-open:slide-in-from-left ltr:data-closed:slide-out-to-left " +
            "rtl:data-open:slide-in-from-right rtl:data-closed:slide-out-to-right",
        SheetSide.Top => "inset-x-0 top-0 h-auto border-b data-open:slide-in-from-top data-closed:slide-out-to-top",
        SheetSide.Bottom => "inset-x-0 bottom-0 h-auto border-t data-open:slide-in-from-bottom data-closed:slide-out-to-bottom",
        _ => "",
    };
}
