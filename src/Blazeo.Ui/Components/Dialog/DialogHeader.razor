@namespace Blazeo.Ui
@* Styled DialogHeader - stacks the title and description at the top of the content. *@

<BzPrimitive As="div" Attributes="@BuildAttributes()" ChildContent="@ChildContent" />

@code {
    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Header content (DialogTitle, DialogDescription).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "dialog-header")
            .Merge(Attributes, Tw.Merge("bz-dialog-header flex flex-col", Class));
}
