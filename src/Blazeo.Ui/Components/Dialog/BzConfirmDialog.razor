@namespace Blazeo.Ui
@*
    The body IDialogService.ConfirmAsync renders inside the alert skin (DialogProvider wraps it in
    AlertDialog > AlertDialogContent). Reads its DialogInstance from the cascade to resolve directly -
    Action -> Ok(true), Cancel -> Cancel() - rather than the declarative AlertDialogAction/Cancel
    (which only close the dialog and would resolve every outcome as a cancel). Text and the confirm
    variant come from the instance's UiDialogOptions.
*@

<BzAlertDialogHeader>
    <BzAlertDialogTitle>@Title</BzAlertDialogTitle>
    @if (!string.IsNullOrEmpty(Description))
    {
        <BzAlertDialogDescription>@Description</BzAlertDialogDescription>
    }
</BzAlertDialogHeader>
<BzAlertDialogFooter>
    <BzButton Variant="ButtonVariant.Outline" Class="bz-alert-dialog-cancel" @onclick="Cancel">@Options.CancelText</BzButton>
    <BzButton Variant="@Options.ConfirmVariant" Class="bz-alert-dialog-action" @onclick="Confirm">@Options.ConfirmText</BzButton>
</BzAlertDialogFooter>

@code {
    /// <summary>The confirmation title.</summary>
    [Parameter] public string Title { get; set; } = "";

    /// <summary>Optional supporting text.</summary>
    [Parameter] public string? Description { get; set; }

    [CascadingParameter] private DialogInstance Dialog { get; set; } = default!;

    private UiDialogOptions Options => Dialog.Options as UiDialogOptions ?? new UiDialogOptions();

    private void Confirm() => Dialog.Close(DialogResult.Ok(true));

    private void Cancel() => Dialog.Cancel();
}
