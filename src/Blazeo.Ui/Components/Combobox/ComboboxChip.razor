@namespace Blazeo.Ui
@typeparam TItem
@*
    Styled ComboboxChip - one token standing in for a selected item, over the headless BzComboboxChip. Its
    strongly-typed Value is mapped to the engine's string key via the cascaded ComboboxData. Renders its
    label and (unless ShowRemove is off) a trailing remove button. The token look is `.bz-combobox-chip`.
*@

<BzComboboxChip Value="@StringValue" Class="@Tw.Merge(BaseClasses, Class)" Attributes="@ForwardedAttributes()">
    @ChildContent
    @if (ShowRemove)
    {
        <ComboboxChipRemove />
    }
</BzComboboxChip>

@code {
    /// <summary>The item this chip represents. Mapped to its string key via the root's ItemToStringValue.</summary>
    [Parameter] public TItem Value { get; set; } = default!;

    /// <summary>Show the trailing remove button. Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool ShowRemove { get; set; } = true;

    /// <summary>The chip's label.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    [CascadingParameter] private ComboboxData<TItem>? Data { get; set; }

    private string StringValue => Data is not null ? Data.ItemToStringValue(Value) : Value?.ToString() ?? "";

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "combobox-chip").Merge(Attributes);

    private const string BaseClasses =
        "bz-combobox-chip has-disabled:pointer-events-none has-disabled:cursor-not-allowed has-disabled:opacity-50";
}
