@namespace Blazeo.Ui
@*
    Styled Input — pure styling over a native <input> (like Button, there's no headless behaviour
    to factor out). Structural utilities + the cn-input hook; the style sheets carry the look,
    including the aria-invalid treatment FieldControl wires up. @bind-Value updates live (oninput).
    Validation-agnostic by design — pair with Field/FieldControl for forms.
*@

<input type="@Type"
       value="@Value"
       disabled="@Disabled"
       data-slot="input"
       class="@Tw.Merge(BaseClasses, Class)"
       @oninput="OnInputAsync"
       @attributes="Attributes" />

@code {
    /// <summary>The current text. Use with <c>@bind-Value</c> (updates on input).</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Raised with the new text on every input. Enables <c>@bind-Value</c>.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>The <c>type</c> attribute (e.g. <c>"email"</c>, <c>"password"</c>, <c>"file"</c>). Browser default: text.</summary>
    [Parameter] public string? Type { get; set; }

    /// <summary>Disables the input.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes (placeholder, id, aria-*, …), forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private Task OnInputAsync(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString());

    private const string BaseClasses =
        "cn-input w-full min-w-0 outline-none file:inline-flex file:border-0 file:bg-transparent " +
        "file:text-foreground placeholder:text-muted-foreground disabled:pointer-events-none " +
        "disabled:cursor-not-allowed disabled:opacity-50";
}
