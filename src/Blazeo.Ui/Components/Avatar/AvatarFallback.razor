@namespace Blazeo.Ui
@* Styled avatar fallback (e.g. initials), shown until/unless the image loads. *@

<BlazeAvatarFallback Class="@Tw.Merge("flex size-full items-center justify-center rounded-full bg-muted text-sm text-muted-foreground", Class)"
                     Attributes="@Attributes">
    @ChildContent
</BlazeAvatarFallback>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }
}
