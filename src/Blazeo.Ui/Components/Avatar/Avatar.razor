@namespace Blazeo.Ui
@* Styled Avatar root. Compose with <AvatarImage> and <AvatarFallback>. new-york v4 classes. *@

<BlazeAvatar Class="@Tw.Merge("relative flex size-8 shrink-0 overflow-hidden rounded-full", Class)"
             Attributes="@Attributes">
    @ChildContent
</BlazeAvatar>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }
}
