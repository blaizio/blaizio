@namespace Blazeo.Ui
@*
    Scales the app behind a drawer - the vaul-style "indent" effect. Wrap the content you want to
    recede (a page, a panel, the whole app) in a BzDrawerProvider; when a descendant drawer with
    ScaleBackground="true" opens, the wrapped content scales down and rounds while the drawer slides in.

    Because the panel is position:fixed, a transform on an ANCESTOR would scale and mis-position it - so
    the provider RELAYS each scaling drawer's surface out of the scaled wrapper and renders it here, as a
    sibling that stays full-size on top. Place the provider over a dark surface so the inset shows.
*@

<CascadingValue Value="this" IsFixed="true">
    @* h-full so the wrapped content fills its container (e.g. the viewport): otherwise it is only
       content-height and the surface behind it is exposed below the page instead of only as the inset.
       When a scaling drawer opens the page shrinks (scale) and slides down a touch (translate) from the
       top edge - the vaul indent - so the recede reads as the page settling back onto the surface
       behind it. That surface is whatever the wrapped content sits on; it is NOT painted here, so it
       takes your app's own background, not a forced colour. *@
    <div class="bz-drawer-scale-bg h-full origin-top transition-[transform,translate,border-radius,scale] duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] data-[scaled=on]:scale-[0.965] data-[scaled=on]:translate-y-3 data-[scaled=on]:overflow-hidden data-[scaled=on]:rounded-2xl"
         data-scaled="@(Scaled ? "on" : "off")">
        @ChildContent
    </div>
    @* Relayed drawer surfaces render OUTSIDE the scaled wrapper so they keep full size. *@
    @foreach (var entry in _surfaces)
    {
        <div @key="entry.Key">@entry.Value</div>
    }
</CascadingValue>

@code {
    /// <summary>The content that recedes behind an open scaling drawer.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private readonly List<KeyValuePair<object, RenderFragment>> _surfaces = new();
    private readonly HashSet<object> _scaling = new();

    private bool Scaled => _scaling.Count > 0;

    /// <summary>A scaling drawer registers (or refreshes) its surface to render outside the scaled wrapper.</summary>
    public void Relay(object key, RenderFragment surface)
    {
        var i = _surfaces.FindIndex(e => Equals(e.Key, key));
        if (i >= 0) _surfaces[i] = new(key, surface);
        else _surfaces.Add(new(key, surface));
        StateHasChanged();
    }

    /// <summary>Drops a closed drawer's surface and clears its scale contribution.</summary>
    public void Remove(object key)
    {
        _surfaces.RemoveAll(e => Equals(e.Key, key));
        if (_scaling.Remove(key)) { /* scale recomputed below */ }
        StateHasChanged();
    }

    /// <summary>Toggles whether a given drawer is currently scaling the background.</summary>
    public void SetScaled(object key, bool on)
    {
        var changed = on ? _scaling.Add(key) : _scaling.Remove(key);
        if (changed) StateHasChanged();
    }
}
