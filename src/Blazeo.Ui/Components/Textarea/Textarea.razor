@namespace Blazeo.Ui
@*
    Styled Textarea - pure styling over a native <textarea>. Structural utilities + the cn-textarea
    hook; field-sizing-content lets it grow with its text. @bind-Value updates live (oninput).
    Validation-agnostic by design - pair with Field/FieldControl for forms.
*@

<textarea value="@Value"
          disabled="@Disabled"
          data-slot="textarea"
          class="@Tw.Merge(BaseClasses, Class)"
          @oninput="OnInputAsync"
          @attributes="Attributes"></textarea>

@code {
    /// <summary>The current text. Use with <c>@bind-Value</c> (updates on input).</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Raised with the new text on every input. Enables <c>@bind-Value</c>.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Disables the textarea.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes (placeholder, rows, id, aria-*, …), forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private Task OnInputAsync(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString());

    private const string BaseClasses =
        "cn-textarea flex field-sizing-content min-h-16 w-full outline-none " +
        "placeholder:text-muted-foreground disabled:cursor-not-allowed disabled:opacity-50";
}
