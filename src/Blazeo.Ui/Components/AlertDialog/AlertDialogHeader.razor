@namespace Blazeo.Ui
@* Styled AlertDialogHeader - centers the title and description (left-aligned at the default size on sm:+). *@

<BlazePrimitive As="div" Attributes="@BuildAttributes()" ChildContent="@ChildContent" />

@code {
    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Header content (AlertDialogMedia, AlertDialogTitle, AlertDialogDescription).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "alert-dialog-header")
            .Merge(Attributes, Tw.Merge("bz-alert-dialog-header", Class));
}
