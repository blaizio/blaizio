@namespace Blazeo.Ui
@* Styled AlertDialogDescription - the headless <p> the alert is described by. *@

<BaseDialogDescription Class="@Tw.Merge("bz-alert-dialog-description", Class)"
                        Attributes="@ForwardedAttributes()">
    @ChildContent
</BaseDialogDescription>

@code {
    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Description text.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "alert-dialog-description").Merge(Attributes);
}
