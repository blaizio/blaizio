@namespace Blazeo.Ui
@*
    Styled AlertDialogTrigger. Use AsChild to put the behaviour on a styled <Button>:

        <AlertDialogTrigger>
            <AsChild Context="p"><Button Variant="ButtonVariant.Outline" @attributes="p.Attributes">Delete</Button></AsChild>
        </AlertDialogTrigger>
*@

<BlazeDialogTrigger Class="@Class"
                    Attributes="@ForwardedAttributes()"
                    AsChild="@AsChild">
    @ChildContent
</BlazeDialogTrigger>

@code {
    /// <summary>Extra classes.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Trigger content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the behaviour onto your own element instead of a <c>&lt;button&gt;</c>.</summary>
    [Parameter] public RenderFragment<BlazeRenderProps>? AsChild { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "alert-dialog-trigger").Merge(Attributes);
}
