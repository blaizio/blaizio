@namespace Blazeo.Ui
@*
    The accessibility-injection wrapper - a slot that injects accessibility attributes onto its child.
    It computes the control's id, aria-describedby, and aria-invalid from the cascaded FieldContext
    and hands them to its child as a dictionary, which the child splats with @attributes. This keeps
    the controls themselves validation-agnostic (they just react to aria-invalid via their styling):

        <BzFieldControl Context="control">
            <BzCheckbox @attributes="control" @bind-Checked="model.Accept" />
        </BzFieldControl>
*@

@if (ChildContent is not null)
{
    @ChildContent(BuildControlAttributes())
}

@code {
    [CascadingParameter] private FieldContext? Field { get; set; }

    /// <summary>Receives the id/aria attributes to splat onto your control via <c>@@attributes</c>.</summary>
    [Parameter] public RenderFragment<IReadOnlyDictionary<string, object>>? ChildContent { get; set; }

    private IReadOnlyDictionary<string, object> BuildControlAttributes()
    {
        var props = new PropBuilder();

        if (Field is not null)
        {
            props.Set("id", Field.ItemId).Set("aria-describedby", Field.DescribedBy);
            if (Field.IsInvalid) props.Aria("invalid", true);
        }

        return props.Merge(null);
    }
}
