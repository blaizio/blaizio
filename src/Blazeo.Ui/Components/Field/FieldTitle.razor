@namespace Blazeo.Ui
@*
    A non-<label> title for a field (e.g. inside FieldContent next to a description). Upstream
    deliberately reuses data-slot="field-label" so it shares the label's layout rules.
*@

<BlazePrimitive As="div" Attributes="@BuildAttributes()" ChildContent="@ChildContent" />

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "field-label")
            .Merge(Attributes, Tw.Merge("bz-field-title flex w-fit items-center", Class));
}
