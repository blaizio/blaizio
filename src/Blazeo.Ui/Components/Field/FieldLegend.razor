@namespace Blazeo.Ui
@* The caption of a <FieldSet>. *@

<BasePrimitive As="legend" Attributes="@BuildAttributes()" ChildContent="@ChildContent" />

@code {
    /// <summary>Type scale. Defaults to <see cref="FieldLegendVariant.Legend"/>.</summary>
    [Parameter] public FieldLegendVariant Variant { get; set; } = FieldLegendVariant.Legend;

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "field-legend")
            .Data("variant", Variant.GetDescription())
            .Merge(Attributes, Tw.Merge("bz-field-legend", Class));
}
