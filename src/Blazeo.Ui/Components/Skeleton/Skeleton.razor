@namespace Blazeo.Ui
@* A pulsing placeholder block. Shape it with classes (e.g. h-4 w-48, or size-10 rounded-full). *@

<BlazePrimitive As="div" Attributes="@BuildAttributes()" ChildContent="@ChildContent" />

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "skeleton")
            .Merge(Attributes, Tw.Merge("cn-skeleton animate-pulse", Class));
}
