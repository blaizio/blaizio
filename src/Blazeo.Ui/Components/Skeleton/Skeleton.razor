@namespace Blazeo.Ui
@* An animated placeholder block. Shape it with classes (e.g. h-4 w-48, or size-10 rounded-full). *@

<BasePrimitive As="div" Attributes="@BuildAttributes()" ChildContent="@ChildContent" />

@code {
    /// <summary>Loading animation. Defaults to <see cref="SkeletonAnimation.Shimmer"/> (a left-to-right sweep).</summary>
    [Parameter] public SkeletonAnimation Animation { get; set; } = SkeletonAnimation.Shimmer;

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "skeleton")
            .Data("animation", Animation.GetDescription())
            .Merge(Attributes, Tw.Merge("bz-skeleton", AnimationClasses, Class));

    // Both animations sit out when the user requests reduced motion (OS/browser setting):
    // pulse via motion-safe, shimmer by hiding the sweep overlay entirely.
    private string AnimationClasses => Animation switch
    {
        SkeletonAnimation.Shimmer =>
            "relative overflow-hidden before:absolute before:inset-0 " +
            "before:bg-linear-to-r before:from-transparent before:via-foreground/15 before:to-transparent " +
            "before:animate-shimmer motion-reduce:before:hidden",
        SkeletonAnimation.Pulse => "motion-safe:animate-pulse",
        _ => "",
    };
}
