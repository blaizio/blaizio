@namespace Blazeo.Ui
@*
    A thin hit-strip down the sidebar's outer edge that toggles it on click - the drag-handle-style rail
    you see on desktop dashboards. Desktop only (hidden below sm); place it as the last child inside
    BzSidebar. Logical start/end so it sits on the correct edge under RTL.
*@

<BasePrimitive As="button" Attributes="@BuildAttributes()" />

@code {
    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    [CascadingParameter] private SidebarContext? Context { get; set; }

    private Task Toggle() => Context?.Toggle.InvokeAsync() ?? Task.CompletedTask;

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "sidebar-rail")
            .Data("sidebar", "rail")
            .Aria("label", "Toggle Sidebar")
            .Set("title", "Toggle Sidebar")
            .Set("tabindex", "-1")
            .On("onclick", EventCallback.Factory.Create(this, Toggle))
            .Merge(Attributes, Tw.Merge(BaseClasses, Class));

    private const string BaseClasses =
        "bz-sidebar-rail absolute inset-y-0 z-20 hidden w-4 -translate-x-1/2 transition-all ease-linear sm:flex " +
        "after:absolute after:inset-y-0 after:start-1/2 after:w-[2px] hover:after:bg-sidebar-border " +
        "group-data-[side=start]:-end-4 group-data-[side=end]:start-0 " +
        "group-data-[side=start]:cursor-w-resize group-data-[side=end]:cursor-e-resize " +
        "[[data-side=start][data-state=collapsed]_&]:cursor-e-resize [[data-side=end][data-state=collapsed]_&]:cursor-w-resize " +
        "group-data-[collapsible=offcanvas]:translate-x-0 group-data-[collapsible=offcanvas]:after:start-full hover:group-data-[collapsible=offcanvas]:bg-sidebar " +
        "[[data-side=start][data-collapsible=offcanvas]_&]:-end-2 [[data-side=end][data-collapsible=offcanvas]_&]:-start-2";
}
