@namespace Blazeo.Ui
@*
    A clickable row inside a sub-menu. Renders an <a> by default (sub-items are usually links); use
    RenderAs to render your own element (e.g. a NavLink).
*@

<BasePrimitive As="a" Attributes="@BuildAttributes()" ChildContent="@ChildContent" RenderAs="@RenderAs" />

@code {
    /// <summary>Height/text size. Defaults to <see cref="SidebarMenuSubButtonSize.Md"/>.</summary>
    [Parameter] public SidebarMenuSubButtonSize Size { get; set; } = SidebarMenuSubButtonSize.Md;

    /// <summary>Marks the row as the current page. Sets <c>data-active</c>.</summary>
    [Parameter] public bool IsActive { get; set; }

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Row content (optional icon plus a label span - the last span truncates).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the row onto your own element instead of an <c>&lt;a&gt;</c>.</summary>
    [Parameter] public RenderFragment<BzRenderProps>? RenderAs { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "sidebar-menu-sub-button")
            .Data("sidebar", "menu-sub-button")
            .Data("size", Size.GetDescription())
            .Data("active", IsActive ? "true" : "false")
            .Merge(Attributes, Tw.Merge(BaseClasses, Size == SidebarMenuSubButtonSize.Sm ? "text-xs" : "text-sm", Class));

    private const string BaseClasses =
        "bz-sidebar-menu-sub-button flex h-7 min-w-0 -translate-x-px items-center gap-2 overflow-hidden px-2 " +
        "text-sidebar-foreground ring-sidebar-ring outline-hidden " +
        "hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:ring-2 " +
        "active:bg-sidebar-accent active:text-sidebar-accent-foreground disabled:pointer-events-none disabled:opacity-50 " +
        "aria-disabled:pointer-events-none aria-disabled:opacity-50 " +
        "[&>span:last-child]:truncate [&>svg]:size-4 [&>svg]:shrink-0 [&>svg]:text-sidebar-accent-foreground " +
        "data-[active=true]:bg-sidebar-accent data-[active=true]:text-sidebar-accent-foreground " +
        "group-data-[collapsible=icon]:hidden";
}
