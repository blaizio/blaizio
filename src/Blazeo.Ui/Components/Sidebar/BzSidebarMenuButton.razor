@namespace Blazeo.Ui
@*
    The primary clickable row in a sidebar menu. Renders a <button> by default; use RenderAs to render
    it as a link (e.g. a NavLink) for real navigation. When collapsed to an icon rail it shrinks to a
    square and - if Tooltip is set - reveals that text as a tooltip on the inline-end side (suppressed
    while expanded or on mobile, matching the rail state).
*@

@if (Tooltip is null)
{
    @RenderButton(null)
}
else
{
    <BzTooltip Disabled="@TooltipDisabled">
        <BzTooltipTrigger>
            <RenderAs Context="tp">@RenderButton(tp.Attributes)</RenderAs>
        </BzTooltipTrigger>
        <BzTooltipContent Side="Side.Right" Align="Align.Center">@Tooltip</BzTooltipContent>
    </BzTooltip>
}

@code {
    /// <summary>Visual style. Defaults to <see cref="SidebarMenuButtonVariant.Default"/>.</summary>
    [Parameter] public SidebarMenuButtonVariant Variant { get; set; } = SidebarMenuButtonVariant.Default;

    /// <summary>Height. Defaults to <see cref="SidebarMenuButtonSize.Default"/>.</summary>
    [Parameter] public SidebarMenuButtonSize Size { get; set; } = SidebarMenuButtonSize.Default;

    /// <summary>Marks the row as the current page (tinted + bolded). Sets <c>data-active</c>.</summary>
    [Parameter] public bool IsActive { get; set; }

    /// <summary>Disables the row.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Tooltip text shown only while collapsed to an icon rail (desktop). Omit for no tooltip.</summary>
    [Parameter] public string? Tooltip { get; set; }

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Row content (icon plus a label span - the last span truncates).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the row onto your own element (e.g. an anchor / NavLink) instead of a <c>&lt;button&gt;</c>.</summary>
    [Parameter] public RenderFragment<BzRenderProps>? RenderAs { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    [CascadingParameter] private SidebarContext? Context { get; set; }

    // Tooltip is desktop-collapsed-only: disabled while expanded or on mobile (or with no provider).
    private bool TooltipDisabled => Context is null || Context.Open || Context.IsMobile;

    private RenderFragment RenderButton(IReadOnlyDictionary<string, object>? triggerAttributes) =>
        @<BasePrimitive As="button" Attributes="@BuildAttributes(triggerAttributes)" ChildContent="@ChildContent" RenderAs="@RenderAs" />;

    private IReadOnlyDictionary<string, object> BuildAttributes(IReadOnlyDictionary<string, object>? triggerAttributes)
    {
        var props = new PropBuilder();

        // Fold in the tooltip trigger's behaviour (pointer/focus handlers) and the consumer's
        // attributes + classes first, THEN re-assert the button's own identity data-* so the trigger's
        // data-slot="tooltip-trigger" can't clobber data-slot="sidebar-menu-button".
        props.Merge(Combine(triggerAttributes, Attributes), Tw.Merge(MenuButtonClasses, Class));

        props.Data("slot", "sidebar-menu-button")
            .Data("sidebar", "menu-button")
            .Data("size", Size.GetDescription())
            .Data("active", IsActive ? "true" : "false");

        if (RenderAs is null) props.Flag("disabled", Disabled);
        else if (Disabled) props.Aria("disabled", true).Data("disabled", "");

        return props.Merge(null);
    }

    // Fold the tooltip-trigger's behaviour attributes and the consumer's together (consumer wins on
    // any clash); the keys don't overlap in practice (trigger = pointer/focus, consumer = onclick/href).
    private static IReadOnlyDictionary<string, object>? Combine(
        IReadOnlyDictionary<string, object>? a, IReadOnlyDictionary<string, object>? b)
    {
        if (a is null) return b;
        if (b is null) return a;
        var d = new Dictionary<string, object>(StringComparer.Ordinal);
        foreach (var (k, v) in a) d[k] = v;
        foreach (var (k, v) in b) d[k] = v;
        return d;
    }

    private string MenuButtonClasses => Tw.Merge(BaseMenuButton, VariantClass, SizeClass);

    private string VariantClass => Variant switch
    {
        SidebarMenuButtonVariant.Outline =>
            "bg-background shadow-[0_0_0_1px_var(--sidebar-border)] hover:bg-sidebar-accent hover:text-sidebar-accent-foreground hover:shadow-[0_0_0_1px_var(--sidebar-accent)]",
        _ => "hover:bg-sidebar-accent hover:text-sidebar-accent-foreground",
    };

    private string SizeClass => Size switch
    {
        SidebarMenuButtonSize.Sm => "h-7 text-xs",
        SidebarMenuButtonSize.Lg => "h-12 text-sm group-data-[collapsible=icon]:p-0!",
        _ => "h-8 text-sm",
    };

    private const string BaseMenuButton =
        "bz-sidebar-menu-button peer/menu-button flex w-full items-center gap-2 overflow-hidden p-2 text-start text-sm " +
        "ring-sidebar-ring outline-hidden transition-[width,height,padding] " +
        "group-has-data-[sidebar=menu-action]/menu-item:pe-8 group-data-[collapsible=icon]:size-8! group-data-[collapsible=icon]:p-2! " +
        "hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:ring-2 " +
        "active:bg-sidebar-accent active:text-sidebar-accent-foreground disabled:pointer-events-none disabled:opacity-50 " +
        "aria-disabled:pointer-events-none aria-disabled:opacity-50 " +
        "data-[active=true]:bg-sidebar-accent data-[active=true]:font-medium data-[active=true]:text-sidebar-accent-foreground " +
        "data-[state=open]:hover:bg-sidebar-accent data-[state=open]:hover:text-sidebar-accent-foreground " +
        "[&>span:last-child]:truncate [&>svg]:size-4 [&>svg]:shrink-0";
}
