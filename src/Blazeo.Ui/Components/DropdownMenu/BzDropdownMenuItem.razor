@namespace Blazeo.Ui
@*
    Styled DropdownMenuItem - a flex row that lays out an optional leading icon, the label, and an
    optional trailing DropdownMenuShortcut (it sits at the end via ms-auto). `Inset` indents the label
    so it lines up with sibling items that DO have a leading icon (the check / radio indicators sit on
    the trailing edge here, so they need no leading column); `Variant="Destructive"` tints it (and its
    icon) with the destructive color. RenderAs lets the item BE an <a> for navigation links.
*@

<BaseDropdownMenuItem Class="@Tw.Merge(BaseClasses, Class)"
                       Disabled="@Disabled"
                       OnSelect="@OnSelect"
                       Attributes="@ForwardedAttributes()"
                       RenderAs="@RenderAs">
    @ChildContent
</BaseDropdownMenuItem>

@code {
    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Item content (leading icon, label, trailing DropdownMenuShortcut).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the behaviour onto your own element instead of a <c>&lt;div&gt;</c> (e.g. an <c>&lt;a&gt;</c>).</summary>
    [Parameter] public RenderFragment<BzRenderProps>? RenderAs { get; set; }

    /// <summary>Disables the item.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Indents the label to line up with sibling items that have a leading icon.</summary>
    [Parameter] public bool Inset { get; set; }

    /// <summary>Visual intent. Defaults to <see cref="DropdownMenuItemVariant.Default"/>.</summary>
    [Parameter] public DropdownMenuItemVariant Variant { get; set; } = DropdownMenuItemVariant.Default;

    /// <summary>Raised when the item is selected. <see cref="MenuSelectEventArgs.PreventDefault"/> keeps the menu open.</summary>
    [Parameter] public EventCallback<MenuSelectEventArgs> OnSelect { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes()
    {
        var props = new PropBuilder().Data("slot", "dropdown-menu-item");
        if (Inset) props.Data("inset", "");
        if (Variant == DropdownMenuItemVariant.Destructive) props.Data("variant", "destructive");
        return props.Merge(Attributes);
    }

    private const string BaseClasses =
        "bz-dropdown-menu-item relative flex cursor-default select-none items-center gap-2 rounded-sm " +
        "px-2 py-1.5 text-sm outline-none " +
        "focus:bg-accent focus:text-accent-foreground " +
        "data-disabled:pointer-events-none data-disabled:opacity-50 data-[inset]:ps-8 " +
        "data-[variant=destructive]:text-destructive data-[variant=destructive]:focus:bg-destructive/10 " +
        "[&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 " +
        "data-[variant=destructive]:[&_svg]:text-destructive";
}
