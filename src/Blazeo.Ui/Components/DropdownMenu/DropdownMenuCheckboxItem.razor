@namespace Blazeo.Ui
@*
    Styled DropdownMenuCheckboxItem - a menu item with a leading check column. The check mark shows
    only while checked (the headless renders the Indicator slot just then). Selecting it toggles the
    state and, by default, closes the menu; pass an OnSelect that calls PreventDefault to keep it open.
*@

<BzDropdownMenuCheckboxItem Class="@Tw.Merge(BaseClasses, Class)"
                               Checked="@Checked"
                               DefaultChecked="@DefaultChecked"
                               CheckedChanged="@CheckedChanged"
                               Disabled="@Disabled"
                               OnSelect="@OnSelect"
                               Attributes="@ForwardedAttributes()">
    <ChildContent>@ChildContent</ChildContent>
    <Indicator>
        <span class="absolute start-2 flex size-3.5 items-center justify-center">
            <BzIcon Icon="@Icons.Outline.Check" Class="size-4" />
        </span>
    </Indicator>
</BzDropdownMenuCheckboxItem>

@code {
    /// <summary>Controlled checked state. Use with <c>@bind-Checked</c>.</summary>
    [Parameter] public bool? Checked { get; set; }

    /// <summary>Initial state when uncontrolled.</summary>
    [Parameter] public bool DefaultChecked { get; set; }

    /// <summary>Raised with the new state. Enables <c>@bind-Checked</c>.</summary>
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }

    /// <summary>Disables the item.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Item content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Raised when the item is selected. <see cref="MenuSelectEventArgs.PreventDefault"/> keeps the menu open.</summary>
    [Parameter] public EventCallback<MenuSelectEventArgs> OnSelect { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "dropdown-menu-checkbox-item").Merge(Attributes);

    private const string BaseClasses =
        "bz-dropdown-menu-checkbox-item relative flex cursor-default select-none items-center gap-2 rounded-sm " +
        "py-1.5 ps-8 pe-2 text-sm outline-none transition-colors " +
        "focus:bg-accent focus:text-accent-foreground " +
        "data-disabled:pointer-events-none data-disabled:opacity-50 " +
        "[&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0";
}
