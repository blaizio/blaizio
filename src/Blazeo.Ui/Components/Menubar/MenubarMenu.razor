@namespace Blazeo.Ui
@*
    Styled MenubarMenu - a thin pass-through to the headless BaseMenubarMenu. Renders no element of its
    own; drop a MenubarTrigger and a MenubarContent inside.
*@

<BaseMenubarMenu Value="@Value">
    @ChildContent
</BaseMenubarMenu>

@code {
    /// <summary>A stable id for this menu (e.g. <c>"file"</c>), used as the bar's open-menu value with <c>@bind-Value</c>. Optional.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>The trigger and content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
