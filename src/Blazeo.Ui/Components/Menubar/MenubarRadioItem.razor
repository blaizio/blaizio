@namespace Blazeo.Ui
@*
    Styled MenubarRadioItem - one option in a MenubarRadioGroup, with a trailing check
    (inline-end) shown only while selected. Selecting it becomes the group's value and, by default,
    closes the menu. Reuses the headless BaseDropdownMenuRadioItem.
*@

<BaseDropdownMenuRadioItem Value="@Value"
                            Class="@Tw.Merge(BaseClasses, Class)"
                            Disabled="@Disabled"
                            OnSelect="@OnSelect"
                            Attributes="@ForwardedAttributes()">
    <ChildContent>@ChildContent</ChildContent>
    <Indicator>
        <span class="absolute end-2 flex size-3.5 items-center justify-center">
            <BzIcon Icon="@Icons.Outline.Check" Class="size-4" />
        </span>
    </Indicator>
</BaseDropdownMenuRadioItem>

@code {
    /// <summary>The value this option contributes when selected. Required.</summary>
    [Parameter] public string Value { get; set; } = default!;

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Disables the item.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Item content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Raised when the item is selected. <see cref="MenuSelectEventArgs.PreventDefault"/> keeps the menu open.</summary>
    [Parameter] public EventCallback<MenuSelectEventArgs> OnSelect { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "menubar-radio-item").Merge(Attributes);

    private const string BaseClasses =
        "bz-menubar-radio-item relative flex cursor-default select-none items-center gap-2 rounded-sm " +
        "py-1.5 ps-2 pe-8 text-sm outline-none " +
        "focus:bg-accent focus:text-accent-foreground " +
        "data-disabled:pointer-events-none data-disabled:opacity-50 " +
        "[&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0";
}
