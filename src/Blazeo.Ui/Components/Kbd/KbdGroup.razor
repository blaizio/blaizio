@namespace Blazeo.Ui
@* A row of Kbd chips (upstream renders the group as a <kbd> too - kept verbatim). *@

<BlazePrimitive As="kbd" Attributes="@BuildAttributes()" ChildContent="@ChildContent" />

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "kbd-group")
            .Merge(Attributes, Tw.Merge("cn-kbd-group inline-flex items-center", Class));
}
