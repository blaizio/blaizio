@namespace Blazeo.Ui
@using System.Globalization
@*
    Time picker - hour / minute (and optional seconds) as BzSelect dropdowns binding a TimeOnly, with a
    24-hour layout by default or 12-hour plus an AM/PM picker. Pairs with BzCalendar to build a
    date-and-time picker. Pure composition over BzSelect; the value math (compose/decompose the
    TimeOnly, 12h<->24h) lives here.

        <BzTimePicker @bind-Value="_time" />                (24-hour H:M)
        <BzTimePicker @bind-Value="_time" Use12Hour ShowSeconds />
*@

<div data-slot="time-picker" class="@Tw.Merge(RootClasses, Class)"
     data-disabled="@(Disabled ? "" : null)" @attributes="Attributes">
    @Segment(HourValue, HourOptions, OnHourChanged, "Hour")
    <span class="text-muted-foreground select-none">:</span>
    @Segment(MinuteValue, MinuteOptions, OnMinuteChanged, "Minute")
    @if (ShowSeconds)
    {
        <span class="text-muted-foreground select-none">:</span>
        @Segment(SecondValue, SecondOptions, OnSecondChanged, "Second")
    }
    @if (Use12Hour)
    {
        @Segment(MeridiemValue, MeridiemOptions, OnMeridiemChanged, "AM/PM")
    }
</div>

@code {
    /// <summary>Controlled value. Use with <c>@bind-Value</c>.</summary>
    [Parameter] public TimeOnly? Value { get; set; }

    /// <summary>Initial value when uncontrolled. Defaults to midnight.</summary>
    [Parameter] public TimeOnly? DefaultValue { get; set; }

    /// <summary>Raised with the new time. Enables <c>@bind-Value</c>.</summary>
    [Parameter] public EventCallback<TimeOnly?> ValueChanged { get; set; }

    /// <summary>Use a 12-hour layout with an AM/PM picker instead of 24-hour. Defaults to <c>false</c>.</summary>
    [Parameter] public bool Use12Hour { get; set; }

    /// <summary>Show a seconds picker. Defaults to <c>false</c>.</summary>
    [Parameter] public bool ShowSeconds { get; set; }

    /// <summary>Granularity of the minute (and second) options. Defaults to <c>1</c>.</summary>
    [Parameter] public int MinuteStep { get; set; } = 1;

    /// <summary>Culture for the AM/PM designators. Defaults to the current culture.</summary>
    [Parameter] public CultureInfo? Culture { get; set; }

    /// <summary>Disables the whole picker.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private readonly ControllableState<TimeOnly?> _state = new();

    protected override void OnParametersSet() =>
        _state.Sync(ValueChanged.HasDelegate, Value, DefaultValue);

    private CultureInfo EffectiveCulture => Culture ?? CultureInfo.CurrentCulture;
    private int Step => Math.Clamp(MinuteStep, 1, 59);
    private TimeOnly Current => _state.Value ?? DefaultValue ?? new TimeOnly(0, 0);

    private int Hour24 => Current.Hour;
    private bool IsPm => Hour24 >= 12;
    private int DisplayHour => Use12Hour ? (Hour24 % 12 == 0 ? 12 : Hour24 % 12) : Hour24;
    private string AmText => string.IsNullOrEmpty(EffectiveCulture.DateTimeFormat.AMDesignator) ? "AM" : EffectiveCulture.DateTimeFormat.AMDesignator;
    private string PmText => string.IsNullOrEmpty(EffectiveCulture.DateTimeFormat.PMDesignator) ? "PM" : EffectiveCulture.DateTimeFormat.PMDesignator;

    private string HourValue => DisplayHour.ToString();
    private string MinuteValue => Current.Minute.ToString();
    private string SecondValue => Current.Second.ToString();
    private string MeridiemValue => IsPm ? "1" : "0";

    private IEnumerable<(int Value, string Label)> HourOptions =>
        Use12Hour
            ? Enumerable.Range(1, 12).Select(h => (h, h.ToString("D2")))
            : Enumerable.Range(0, 24).Select(h => (h, h.ToString("D2")));

    private IEnumerable<(int Value, string Label)> MinuteOptions =>
        Enumerable.Range(0, 60).Where(m => m % Step == 0).Select(m => (m, m.ToString("D2")));

    private IEnumerable<(int Value, string Label)> SecondOptions =>
        Enumerable.Range(0, 60).Where(s => s % Step == 0).Select(s => (s, s.ToString("D2")));

    // The meridiem picker carries am/pm as the value and the culture's designators as the labels.
    private IEnumerable<(int Value, string Label)> MeridiemOptions =>
        [(0, AmText), (1, PmText)];

    private int To24(int displayHour, bool pm) =>
        Use12Hour ? (pm ? (displayHour == 12 ? 12 : displayHour + 12) : (displayHour == 12 ? 0 : displayHour)) : displayHour;

    private Task Emit(TimeOnly time) => _state.SetAsync(time, ValueChanged);

    private Task OnHourChanged(string? value) =>
        int.TryParse(value, out var h) ? Emit(new TimeOnly(To24(h, IsPm), Current.Minute, Current.Second)) : Task.CompletedTask;

    private Task OnMinuteChanged(string? value) =>
        int.TryParse(value, out var m) ? Emit(new TimeOnly(Current.Hour, m, Current.Second)) : Task.CompletedTask;

    private Task OnSecondChanged(string? value) =>
        int.TryParse(value, out var s) ? Emit(new TimeOnly(Current.Hour, Current.Minute, s)) : Task.CompletedTask;

    private Task OnMeridiemChanged(string? value) =>
        Emit(new TimeOnly(To24(DisplayHour, value == "1"), Current.Minute, Current.Second));

    // The meridiem picker encodes am/pm as "0"/"1"; the others use the raw number as the value.
    private RenderFragment Segment(string current, IEnumerable<(int Value, string Label)> options, Func<string?, Task> onChanged, string ariaLabel) =>
        @<BzSelect Value="@current" ValueChanged="@(v => onChanged(v))">
            <BzSelectTrigger Class="@SegmentTrigger" aria-label="@ariaLabel"><BzSelectValue /></BzSelectTrigger>
            <BzSelectContent Class="min-w-0">
                @foreach (var (value, label) in options)
                {
                    <BzSelectItem Value="@value.ToString()">@label</BzSelectItem>
                }
            </BzSelectContent>
        </BzSelect>;

    private const string RootClasses =
        "bz-time-picker inline-flex items-center gap-1 data-disabled:pointer-events-none data-disabled:opacity-50";

    private const string SegmentTrigger = "w-auto min-w-14 justify-center tabular-nums";
}
