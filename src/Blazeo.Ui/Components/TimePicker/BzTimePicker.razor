@namespace Blazeo.Ui
@using System.Globalization
@*
    Time picker - a native <input type="time"> dressed as a field, binding a TimeOnly. The browser
    renders the inline hour / minute (/ second) spinner segments you type or step through, and picks
    12- vs 24-hour from its own locale (so an en-US browser shows AM/PM, a de-DE one a 24-hour clock).
    ShowSeconds switches the native step to seconds so the seconds segment appears; MinuteStep coarsens
    the increment otherwise. A leading clock icon shows by default (hide with ShowIcon, swap via Icon).
    Pairs with BzCalendar to build a date-and-time picker.

        <BzTimePicker @bind-Value="_time" />                (hour:minute)
        <BzTimePicker @bind-Value="_time" ShowSeconds />
*@

<div data-slot="time-picker" class="@Tw.Merge(RootClasses, Class)" data-disabled="@(Disabled ? "" : null)">
    @if (ShowIcon)
    {
        <span data-slot="time-picker-icon" class="text-muted-foreground pointer-events-none flex shrink-0 items-center">
            @if (Icon is not null)
            {
                @Icon
            }
            else
            {
                <BzIcon Icon="@Icons.Outline.Clock" Class="size-4" />
            }
        </span>
    }
    <input type="time" step="@StepSeconds" value="@ValueString" disabled="@Disabled"
           data-slot="time-picker-input" class="@InputClasses"
           @onchange="OnChanged" @attributes="Attributes" />
</div>

@code {
    /// <summary>Controlled value. Use with <c>@bind-Value</c>.</summary>
    [Parameter] public TimeOnly? Value { get; set; }

    /// <summary>Initial value when uncontrolled.</summary>
    [Parameter] public TimeOnly? DefaultValue { get; set; }

    /// <summary>Raised with the new time. Enables <c>@bind-Value</c>.</summary>
    [Parameter] public EventCallback<TimeOnly?> ValueChanged { get; set; }

    /// <summary>Show the seconds segment (sets the native step to one second). Defaults to <c>false</c>.</summary>
    [Parameter] public bool ShowSeconds { get; set; }

    /// <summary>Minute increment for the stepper when seconds are hidden. Defaults to <c>1</c>.</summary>
    [Parameter] public int MinuteStep { get; set; } = 1;

    /// <summary>Show a leading clock icon. Defaults to <c>true</c>.</summary>
    [Parameter] public bool ShowIcon { get; set; } = true;

    /// <summary>Replace the default clock icon (only used when <see cref="ShowIcon"/> is set).</summary>
    [Parameter] public RenderFragment? Icon { get; set; }

    /// <summary>Disables the picker.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes (id, aria-*, …), forwarded to the native input.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private readonly ControllableState<TimeOnly?> _state = new();

    protected override void OnParametersSet() =>
        _state.Sync(ValueChanged.HasDelegate, Value, DefaultValue);

    private TimeOnly? Current => _state.Value ?? DefaultValue;

    // The native step is in seconds: seconds-granular when ShowSeconds, else the minute step in seconds.
    private int StepSeconds => ShowSeconds ? 1 : Math.Clamp(MinuteStep, 1, 59) * 60;

    // <input type=time> always carries a 24-hour HH:mm[:ss] value, whatever the browser displays.
    private string? ValueString =>
        Current is { } t ? t.ToString(ShowSeconds ? "HH:mm:ss" : "HH:mm", CultureInfo.InvariantCulture) : null;

    private Task OnChanged(ChangeEventArgs e) =>
        _state.SetAsync(
            TimeOnly.TryParse(e.Value as string, CultureInfo.InvariantCulture, out var t) ? t : null,
            ValueChanged);

    // The wrapper draws the bz-input field box (it carries the border / height / radius / shadow); the
    // native input sits inside it chrome-stripped, and the box lights up on focus-within.
    private const string RootClasses =
        "bz-time-picker bz-input inline-flex w-fit items-center gap-2 " +
        "focus-within:border-ring focus-within:ring-ring/50 focus-within:ring-3 " +
        "data-disabled:pointer-events-none data-disabled:opacity-50";

    private const string InputClasses =
        "w-full min-w-0 appearance-none border-0 bg-transparent p-0 text-base shadow-none outline-none " +
        "tabular-nums md:text-sm disabled:cursor-not-allowed " +
        "[&::-webkit-calendar-picker-indicator]:hidden [&::-webkit-calendar-picker-indicator]:appearance-none";
}
