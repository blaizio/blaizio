@namespace Blazeo.Ui
@* Body text of an <Alert>. In the destructive variant it inherits a muted destructive colour. *@

<BasePrimitive As="div" Attributes="@BuildAttributes()" ChildContent="@ChildContent" />

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "alert-description")
            .Merge(Attributes, Tw.Merge("bz-alert-description [&_a]:underline [&_a]:underline-offset-3 [&_a]:hover:text-foreground", Class));
}
