@namespace Blazeo.Ui
@*
    Styled Alert - a callout for important messages. Renders role="alert". Structural utilities +
    bz-alert hooks; the active style sheet lays out the optional leading icon, title, description,
    and <AlertAction>. Compose with <AlertTitle>, <AlertDescription>, and optionally <AlertAction>.
*@

<BlazePrimitive As="div" Attributes="@BuildAttributes()" ChildContent="@ChildContent" />

@code {
    /// <summary>Visual style. Defaults to <see cref="AlertVariant.Default"/>.</summary>
    [Parameter] public AlertVariant Variant { get; set; } = AlertVariant.Default;

    /// <summary>Extra classes, merged over the variant defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Alert content - typically an icon, <c>AlertTitle</c>, and <c>AlertDescription</c>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Set("role", "alert")
            .Data("slot", "alert")
            .Merge(Attributes, Tw.Merge("bz-alert group/alert relative w-full", $"bz-alert-variant-{Variant.GetDescription()}", Class));
}
