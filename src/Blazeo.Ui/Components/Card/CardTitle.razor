@namespace Blazeo.Ui
@*
    Card title. Upstream also tags this cn-font-heading (a heading-font hook); Blazeo has no
    heading-font dimension yet, so that class is intentionally not emitted.
*@

<BlazePrimitive As="div" Attributes="@BuildAttributes()" ChildContent="@ChildContent" />

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "card-title")
            .Merge(Attributes, Tw.Merge("cn-card-title", Class));
}
