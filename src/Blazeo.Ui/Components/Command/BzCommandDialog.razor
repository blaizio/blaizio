@namespace Blazeo.Ui
@*
    Styled CommandDialog - the modal command palette: a Command mounted inside a Dialog. The dialog
    chrome is zeroed (no padding, no gap, no close button) so the palette fills it edge to edge, and a
    visually-hidden title/description satisfies the dialog's accessibility contract. Open it from a
    button or a global shortcut and bind with @bind-Open; the input autofocuses via the dialog's focus
    trap. The data-slot overrides enlarge the input and items to palette proportions.
*@

<BzDialog Open="@Open" DefaultOpen="@DefaultOpen" OpenChanged="@OpenChanged">
    <BzDialogContent ShowCloseButton="false" Class="overflow-hidden !gap-0 !p-0">
        <div class="sr-only">
            <BzDialogTitle>@Title</BzDialogTitle>
            @if (Description is not null)
            {
                <BzDialogDescription>@Description</BzDialogDescription>
            }
        </div>
        <BzCommand Label="@Title"
                 Search="@Search"
                 DefaultSearch="@DefaultSearch"
                 SearchChanged="@SearchChanged"
                 ShouldFilter="@ShouldFilter"
                 Filter="@Filter"
                 Loop="@Loop"
                 Class="@InnerCommandClasses">
            @ChildContent
        </BzCommand>
    </BzDialogContent>
</BzDialog>

@code {
    /// <summary>Controlled open state. Use with <c>@bind-Open</c>.</summary>
    [Parameter] public bool? Open { get; set; }

    /// <summary>Initial open state when uncontrolled.</summary>
    [Parameter] public bool DefaultOpen { get; set; }

    /// <summary>Raised with the new open state. Enables <c>@bind-Open</c>.</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Accessible dialog title (visually hidden). Also labels the palette. Defaults to "Command Palette".</summary>
    [Parameter] public string Title { get; set; } = "Command Palette";

    /// <summary>Optional accessible description (visually hidden).</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>Controlled search text. Bind with <c>@bind-Search</c>.</summary>
    [Parameter] public string? Search { get; set; }

    /// <summary>Initial search text when uncontrolled.</summary>
    [Parameter] public string DefaultSearch { get; set; } = "";

    /// <summary>Raised with the new search text on every keystroke. Enables <c>@bind-Search</c>.</summary>
    [Parameter] public EventCallback<string?> SearchChanged { get; set; }

    /// <summary>Whether typing filters the list. Set <see langword="false"/> to drive the items yourself.</summary>
    [Parameter] public bool ShouldFilter { get; set; } = true;

    /// <summary>Custom match: <c>(search, value, keywords) =&gt; matched</c>. Defaults to the built-in fuzzy filter.</summary>
    [Parameter] public Func<string, string, IReadOnlyList<string>?, bool>? Filter { get; set; }

    /// <summary>Arrow navigation wraps past the ends. Defaults to <see langword="false"/>.</summary>
    [Parameter] public bool Loop { get; set; }

    /// <summary>The CommandInput, CommandList, and items.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    // The dialog enlarges the input and lets the list grow, but it deliberately does NOT touch the item
    // height: per shadcn a command row is the same height inline or in a dialog - only its corner radius
    // bumps up there (the skin's `in-data-[slot=dialog-content]` variant on .bz-command-item).
    private const string InnerCommandClasses =
        "[&_[data-slot=command-input-wrapper]]:h-12 [&_[data-slot=command-input-wrapper]_svg]:size-5 " +
        "[&_[data-slot=command-input]]:h-12 [&_[data-slot=command-list]]:max-h-100 " +
        "[&_[data-slot=command-group]]:p-2";
}
