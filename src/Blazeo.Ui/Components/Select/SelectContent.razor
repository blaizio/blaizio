@namespace Blazeo.Ui
@inject IJSRuntime Js
@implements IAsyncDisposable
@*
    Styled SelectContent - the floating listbox over the headless BzSelectContent (which positions it
    via @floating-ui, navigates it, manages presence, and dismisses it). It matches the trigger's
    width (--bz-anchor-width) with an 8rem floor, caps its height to the room left to the viewport edge
    (--bz-available-height) and scrolls a long list. Structure + animation live here; the panel look
    (bg-popover, ring, shadow, radius, padding) is the skin's `.bz-select-content`.

    Scroll: by default a thin scrollbar; Scroll=Buttons instead caps the list to a scrolling viewport
    between an up and a down chevron (no scrollbar) that hide at the ends and auto-scroll on hover
    (ts/selectScroll.js).
*@

<BzSelectContent Class="@Tw.Merge(ContentClasses, Class)"
                    Side="@Side"
                    Align="@Align"
                    SideOffset="@SideOffset"
                    AlignOffset="@AlignOffset"
                    Position="@Position"
                    Loop="@Loop"
                    Attributes="@ForwardedAttributes()">
    @if (Scroll == SelectScrollMode.Buttons)
    {
        <div data-bz-select-scroll-up @ref="_up" style="display:none" class="@ScrollButtonClasses">
            <BzIcon Icon="@Icons.Outline.ChevronUp" Class="size-4" />
        </div>
        <div data-bz-select-viewport @ref="_viewport" class="flex-1 overflow-x-hidden overflow-y-auto scrollbar-none">
            @ChildContent
        </div>
        <div data-bz-select-scroll-down @ref="_down" style="display:none" class="@ScrollButtonClasses">
            <BzIcon Icon="@Icons.Outline.ChevronDown" Class="size-4" />
        </div>
    }
    else
    {
        @ChildContent
    }
</BzSelectContent>

@code {
    /// <summary>Preferred side of the trigger. Flips to stay in view. Defaults to <see cref="Blazeo.Side.Bottom"/>.</summary>
    [Parameter] public Side Side { get; set; } = Side.Bottom;

    /// <summary>Alignment along the trigger's edge. Defaults to <see cref="Blazeo.Align.Start"/>.</summary>
    [Parameter] public Align Align { get; set; } = Align.Start;

    /// <summary>Gap in pixels between the trigger and the content. Defaults to 4.</summary>
    [Parameter] public double SideOffset { get; set; } = 4;

    /// <summary>Offset in pixels along the alignment axis. Defaults to 0.</summary>
    [Parameter] public double AlignOffset { get; set; }

    /// <summary>How the listbox is placed relative to the trigger. Defaults to <see cref="SelectPosition.Popper"/>.</summary>
    [Parameter] public SelectPosition Position { get; set; } = SelectPosition.Popper;

    /// <summary>How a long list scrolls - a scrollbar (default) or up/down chevron buttons.</summary>
    [Parameter] public SelectScrollMode Scroll { get; set; } = SelectScrollMode.Scrollbar;

    /// <summary>
    /// Arrow navigation wraps at the ends (past the last option returns to the first). Defaults to
    /// <see langword="true"/>; set <see langword="false"/> to stop at the first/last option.
    /// </summary>
    [Parameter] public bool Loop { get; set; } = true;

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Listbox content (options, labels, separators, groups).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private ElementReference _viewport;
    private ElementReference _up;
    private ElementReference _down;
    private IJSObjectReference? _scrollModule;
    private IJSObjectReference? _scroll;
    private bool _scrollAttached;

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "select-content").Merge(Attributes);

    // Item-aligned overlays the listbox ON the trigger (the native select feel), so it appears and
    // closes INSTANTLY (no enter/exit animation - snappy); popper floats in below/above with the
    // fade/zoom/slide. Dropping the animate classes leaves animationName:none, so presence.ts reports
    // the close immediately (no wait).
    private string ContentClasses => Tw.Merge(
        BaseStructural,
        Scroll == SelectScrollMode.Buttons ? ButtonsStructural : ScrollbarStructural,
        Position == SelectPosition.ItemAligned ? null : AnimationClasses);

    // position:fixed + left/top come from the positioning module, which also publishes the trigger's
    // width (--bz-anchor-width) and the room left to the viewport edge (--bz-available-height). The look
    // is .bz-select-content.
    private const string BaseStructural =
        "bz-select-content fixed z-50 min-w-[var(--bz-anchor-width,8rem)] max-h-[var(--bz-available-height)] outline-none";

    // Scrollbar mode: the listbox itself scrolls with a thin bar.
    private const string ScrollbarStructural = "overflow-x-hidden overflow-y-auto scrollbar-thin";

    // Buttons mode: the listbox is a flex column [up button | scrolling viewport | down button]; it clips,
    // the viewport (flex-1) scrolls. The skin's p-1 still wraps all three.
    private const string ButtonsStructural = "flex flex-col overflow-hidden";

    private const string ScrollButtonClasses =
        "text-muted-foreground flex h-6 shrink-0 cursor-default items-center justify-center [&_svg]:pointer-events-none";

    // The enter slide keys off the resolved data-side (Blazor owns it). Popper only.
    private const string AnimationClasses =
        "data-open:animate-in data-closed:animate-out data-open:fade-in-0 data-closed:fade-out-0 " +
        "data-open:zoom-in-95 data-closed:zoom-out-95 " +
        "data-[side=top]:slide-in-from-bottom-2 data-[side=bottom]:slide-in-from-top-2 " +
        "data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2";

    // The buttons + viewport are always in the DOM (the listbox stays mounted); wire the scroll behaviour
    // once. Claim _scrollAttached synchronously before the await so a re-render can't attach twice.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Scroll != SelectScrollMode.Buttons || _scrollAttached) return;
        _scrollAttached = true;
        try
        {
            _scrollModule = await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Blazeo.Base/dist/selectScroll.js");
            _scroll = await _scrollModule.InvokeAsync<IJSObjectReference>(
                "createSelectScroll", _viewport, _up, _down);
        }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_scroll is not null)
            {
                await _scroll.InvokeVoidAsync("dispose");
                await _scroll.DisposeAsync();
            }
            if (_scrollModule is not null) await _scrollModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        GC.SuppressFinalize(this);
    }
}
