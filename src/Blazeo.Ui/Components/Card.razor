@namespace Blazeo.Ui
@*
    Styled Card — a surface for grouping content. Compose with CardHeader / CardTitle /
    CardDescription / CardAction / CardContent / CardFooter. new-york v4 classes verbatim.
*@

<BlazePrimitive As="div" Attributes="@BuildAttributes()" ChildContent="@ChildContent" />

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "card")
            .Merge(Attributes, Tw.Merge("flex flex-col gap-6 rounded-xl border bg-card py-6 text-card-foreground shadow-sm", Class));
}
