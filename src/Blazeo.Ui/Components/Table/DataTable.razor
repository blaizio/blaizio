@namespace Blazeo.Ui
@typeparam TItem
@attribute [CascadingTypeParameter(nameof(TItem))]
@using System.Globalization
@*
    DataTable<TItem> - the headless data-grid surface built on the styled Table primitives, the way a
    headless table engine drives a plain HTML table. Define columns either as child
    <PropertyColumn>/<TemplateColumn> (they
    cascade TItem and register in document order) or via the Columns list. Gives single-column sorting
    (header click cycles asc → desc → off), a search filter across the searchable columns, a
    column-visibility menu, optional row selection, and - the headline - optional WINDOW virtualization
    with no height restriction: set Virtualize and the body mounts only the rows in view (RowHeight =
    fixed estimate, DynamicRowHeight to measure variable rows) while the page itself scrolls.
*@

@* Columns register through this cascade; the fragment itself renders nothing visible. *@
<CascadingValue Value="this" IsFixed="true">
    @ChildContent
</CascadingValue>

@{
    var columns = VisibleColumns;
    var colSpan = columns.Count + (Selectable ? 1 : 0);
}

<div @attributes="RootAttributes()">
    @if (ShowToolbar)
    {
        <div class="bz-data-table-toolbar">
            @if (Searchable)
            {
                <Input Type="search" Value="@_filter.Value" ValueChanged="@OnSearchChanged"
                       placeholder="@SearchPlaceholder" Class="bz-data-table-search" aria-label="@SearchPlaceholder" />
            }
            <div class="bz-data-table-toolbar-end">
                @Toolbar
                @if (ColumnToggle)
                {
                    @RenderColumnToggle
                }
            </div>
        </div>
    }

    <Table ContainerClass="@ResolveContainerClass()" ContainerId="@(Scrollable ? _scrollId : null)" ContainerStyle="@ResolveContainerStyle()">
        @if (Caption is not null)
        {
            <TableCaption>@Caption</TableCaption>
        }
        <TableHeader Class="@(StickyHeader ? "bz-table-sticky" : null)">
            <TableRow>
                @if (Selectable)
                {
                    <TableHead Class="bz-table-select-cell">
                        <Checkbox Checked="@SelectAllState" CheckedChanged="@(_ => ToggleAll())" aria-label="Select all rows" />
                    </TableHead>
                }
                @foreach (var col in columns)
                {
                    <TableHead Class="@ColumnClass(col, header: true)" aria-sort="@AriaSort(col)">
                        @RenderHeader(col)
                    </TableHead>
                }
            </TableRow>
        </TableHeader>

        @if (Virtualize)
        {
            <BzWindowVirtualizer As="tbody" Class="bz-table-body"
                                 Count="@_view.Count" RowHeight="@RowHeight" Dynamic="@DynamicRowHeight"
                                 Overscan="@Overscan" Viewport="@(Scrollable ? "#" + _scrollId : null)" Context="slice">
                @if (_view.Count == 0)
                {
                    @EmptyRow(colSpan)
                }
                else
                {
                    <tr aria-hidden="true" class="bz-table-spacer" style="height:@Px(slice.PaddingTop)">
                        <td colspan="@colSpan"></td>
                    </tr>
                    @foreach (var i in slice.Indices)
                    {
                        @RenderBodyRow(_view[i], i, columns)
                    }
                    <tr aria-hidden="true" class="bz-table-spacer" style="height:@Px(slice.PaddingBottom)">
                        <td colspan="@colSpan"></td>
                    </tr>
                }
            </BzWindowVirtualizer>
        }
        else
        {
            <TableBody>
                @if (_view.Count == 0)
                {
                    @EmptyRow(colSpan)
                }
                else
                {
                    @for (var i = 0; i < _view.Count; i++)
                    {
                        @RenderBodyRow(_view[i], i, columns)
                    }
                }
            </TableBody>
        }

        @if (FooterContent is not null)
        {
            <TableFooter>@FooterContent</TableFooter>
        }
    </Table>

    @if (Selectable && ShowSelectionSummary)
    {
        <div class="bz-data-table-status" aria-live="polite">
            @SelectedInViewCount of @_view.Count row(s) selected.
        </div>
    }
</div>

@code {
    /// <summary>The rows to display.</summary>
    [Parameter] public IEnumerable<TItem>? Items { get; set; }

    /// <summary>Columns defined as data. Combine with, or use instead of, the child column components.</summary>
    [Parameter] public IReadOnlyList<ColumnDef<TItem>>? Columns { get; set; }

    /// <summary>Child column components - <c>PropertyColumn</c> / <c>TemplateColumn</c>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Controlled sort. Use with <c>@bind-Sort</c>; <see langword="null"/> means natural order.</summary>
    [Parameter] public SortState? Sort { get; set; }

    /// <summary>Initial sort when uncontrolled.</summary>
    [Parameter] public SortState? DefaultSort { get; set; }

    /// <summary>Raised with the new sort. Enables <c>@bind-Sort</c>.</summary>
    [Parameter] public EventCallback<SortState?> SortChanged { get; set; }

    /// <summary>Show a search box that filters across the searchable columns.</summary>
    [Parameter] public bool Searchable { get; set; }

    /// <summary>Placeholder for the search box. Defaults to "Search...".</summary>
    [Parameter] public string SearchPlaceholder { get; set; } = "Search...";

    /// <summary>Restrict the search to a single column (by its <c>Key</c>); when unset every searchable column is matched.</summary>
    [Parameter] public string? SearchColumn { get; set; }

    /// <summary>Controlled search text. Use with <c>@bind-Filter</c>.</summary>
    [Parameter] public string? Filter { get; set; }

    /// <summary>Initial search text when uncontrolled.</summary>
    [Parameter] public string? DefaultFilter { get; set; }

    /// <summary>Raised with the new search text. Enables <c>@bind-Filter</c>.</summary>
    [Parameter] public EventCallback<string?> FilterChanged { get; set; }

    /// <summary>Show a "Columns" menu to toggle column visibility.</summary>
    [Parameter] public bool ColumnToggle { get; set; }

    /// <summary>Label for the column-visibility trigger. Defaults to "Columns".</summary>
    [Parameter] public string ColumnToggleLabel { get; set; } = "Columns";

    /// <summary>Add a leading checkbox column for row selection.</summary>
    [Parameter] public bool Selectable { get; set; }

    /// <summary>The selected rows. Setting a new collection replaces the selection; changes raise <see cref="SelectedItemsChanged"/>.</summary>
    [Parameter] public IReadOnlyCollection<TItem>? SelectedItems { get; set; }

    /// <summary>Raised whenever the selection changes. Enables <c>@bind-SelectedItems</c>.</summary>
    [Parameter] public EventCallback<IReadOnlyCollection<TItem>> SelectedItemsChanged { get; set; }

    /// <summary>Identity key for a row, used to match selection across data reloads. Defaults to reference/Equals.</summary>
    [Parameter] public Func<TItem, object>? RowKey { get; set; }

    /// <summary>Show the "N of M row(s) selected" status line under the table. Defaults to <see langword="true"/> when <see cref="Selectable"/>.</summary>
    [Parameter] public bool ShowSelectionSummary { get; set; } = true;

    /// <summary>Mount only the rows in view, with NO height restriction (the page scrolls). See <see cref="RowHeight"/> / <see cref="DynamicRowHeight"/>.</summary>
    [Parameter] public bool Virtualize { get; set; }

    /// <summary>Row height in pixels: the exact uniform height in fixed mode, or the estimate in <see cref="DynamicRowHeight"/> mode. Defaults to <c>48</c>.</summary>
    [Parameter] public double RowHeight { get; set; } = 48;

    /// <summary>Measure each rendered row instead of assuming <see cref="RowHeight"/> - for variable-height rows.</summary>
    [Parameter] public bool DynamicRowHeight { get; set; }

    /// <summary>Extra rows to mount above/below the viewport when virtualizing. Defaults to <c>6</c>.</summary>
    [Parameter] public int Overscan { get; set; } = 6;

    /// <summary>Keep the header visible while scrolling (sticky to the top of the scroll viewport).</summary>
    [Parameter] public bool StickyHeader { get; set; }

    /// <summary>
    /// Constrain the table to a scroll box of this CSS height (e.g. <c>"24rem"</c>, <c>"400px"</c>) with its
    /// own scrollbar, instead of growing with the page. When virtualizing, the rows are measured against this
    /// box. Leave unset to virtualize against the window (no height restriction). Pair with <see cref="StickyHeader"/>.
    /// </summary>
    [Parameter] public string? MaxHeight { get; set; }

    /// <summary>Extra toolbar content, placed beside the search box / column menu.</summary>
    [Parameter] public RenderFragment? Toolbar { get; set; }

    /// <summary>Footer rows (<c>tfoot</c>), e.g. a totals row.</summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }

    /// <summary>A caption rendered below the table.</summary>
    [Parameter] public RenderFragment? Caption { get; set; }

    /// <summary>What to show when there are no rows (after filtering). Defaults to "No results.".</summary>
    [Parameter] public RenderFragment? EmptyContent { get; set; }

    /// <summary>Raised when a body row is clicked (anywhere outside an interactive cell control).</summary>
    [Parameter] public EventCallback<TItem> OnRowClick { get; set; }

    /// <summary>Extra classes for the data-table wrapper.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the wrapper.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private readonly List<IGridColumn<TItem>> _registered = [];
    private List<IGridColumn<TItem>> _effectiveColumns = [];
    private readonly HashSet<string> _hidden = [];
    private readonly HashSet<string> _seenColumns = [];
    private readonly ControllableState<SortState?> _sort = new();
    private readonly ControllableState<string?> _filter = new();
    private HashSet<TItem> _selected = [];
    private readonly string _scrollId = "bz-dt-scroll-" + Guid.NewGuid().ToString("N")[..8];
    private IEqualityComparer<TItem> _rowComparer = EqualityComparer<TItem>.Default;
    private Func<TItem, object>? _lastRowKey;
    private IReadOnlyCollection<TItem>? _lastSelectedParam;
    private List<TItem> _view = [];

    // ---- registration (called by the child column components) ----

    internal void Register(IGridColumn<TItem> column)
    {
        _registered.Add(column);
        Recompute();
        StateHasChanged();
    }

    internal void Unregister(IGridColumn<TItem> column)
    {
        if (_registered.Remove(column))
        {
            Recompute();
            StateHasChanged();
        }
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(RowKey, _lastRowKey))
        {
            _lastRowKey = RowKey;
            _rowComparer = RowKey is null ? EqualityComparer<TItem>.Default : new KeyComparer(RowKey);
            _selected = new HashSet<TItem>(_selected, _rowComparer);
        }

        if (!ReferenceEquals(SelectedItems, _lastSelectedParam))
        {
            _lastSelectedParam = SelectedItems;
            if (SelectedItems is not null) _selected = new HashSet<TItem>(SelectedItems, _rowComparer);
        }

        _sort.Sync(SortChanged.HasDelegate, Sort, DefaultSort);
        _filter.Sync(FilterChanged.HasDelegate, Filter, DefaultFilter);
        Recompute();
    }

    // ---- the processing pipeline: filter, then sort, materialised once per change ----

    private void Recompute()
    {
        RebuildColumns();

        IEnumerable<TItem> rows = Items ?? [];

        var query = _filter.Value;
        if (!string.IsNullOrWhiteSpace(query))
        {
            var targets = (string.IsNullOrEmpty(SearchColumn)
                ? _effectiveColumns.Where(c => c.Searchable)
                : _effectiveColumns.Where(c => c.Key == SearchColumn)).ToList();

            if (targets.Count > 0)
            {
                rows = rows.Where(item =>
                    targets.Any(c => (c.GetText(item) ?? string.Empty).Contains(query, StringComparison.OrdinalIgnoreCase)));
            }
        }

        if (_sort.Value is { } sort)
        {
            var col = _effectiveColumns.FirstOrDefault(c => c.Key == sort.ColumnKey && c.Sortable);
            if (col is not null)
            {
                var comparer = Comparer<TItem>.Create((a, b) => col.Compare(a, b));
                rows = sort.Direction == SortDirection.Ascending
                    ? rows.OrderBy(x => x, comparer)
                    : rows.OrderByDescending(x => x, comparer);
            }
        }

        _view = rows.ToList();
    }

    // The effective column list = data columns (Columns) then registered child columns; default-hidden
    // columns are folded into the hidden set the first time they appear.
    private void RebuildColumns()
    {
        _effectiveColumns = [];
        if (Columns is { Count: > 0 })
        {
            for (var i = 0; i < Columns.Count; i++) _effectiveColumns.Add(new ColumnDefAdapter<TItem>(Columns[i], i));
        }
        _effectiveColumns.AddRange(_registered);

        foreach (var col in _effectiveColumns)
        {
            if (_seenColumns.Add(col.Key) && col.DefaultHidden) _hidden.Add(col.Key);
        }
    }

    private List<IGridColumn<TItem>> VisibleColumns =>
        _effectiveColumns.Where(c => !_hidden.Contains(c.Key)).ToList();

    private bool ShowToolbar => Searchable || ColumnToggle || Toolbar is not null;

    // A constrained scroll box (MaxHeight) gets its own scrollbar and becomes the virtualization viewport;
    // otherwise a virtualized table flows in the page (window viewport, no height restriction).
    private bool Scrollable => !string.IsNullOrEmpty(MaxHeight);

    private string? ResolveContainerClass() =>
        Scrollable ? "bz-table-container-scroll" : Virtualize ? "bz-table-container-virtual" : null;

    private string? ResolveContainerStyle() => Scrollable ? $"max-height:{MaxHeight}" : null;

    private IReadOnlyDictionary<string, object> RootAttributes() =>
        new PropBuilder().Data("slot", "data-table").Merge(Attributes, Tw.Merge("bz-data-table", Class));

    // ---- sorting ----

    private async Task ToggleSort(IGridColumn<TItem> col)
    {
        if (!col.Sortable) return;

        var current = _sort.Value;
        SortState? next =
            current is null || current.ColumnKey != col.Key ? new SortState(col.Key, SortDirection.Ascending)
            : current.Direction == SortDirection.Ascending ? current with { Direction = SortDirection.Descending }
            : null; // descending → clear

        await _sort.SetAsync(next, SortChanged);
        if (!_sort.IsControlled) Recompute();
        StateHasChanged();
    }

    private string? AriaSort(IGridColumn<TItem> col)
    {
        if (!col.Sortable || _sort.Value is not { } s || s.ColumnKey != col.Key) return col.Sortable ? "none" : null;
        return s.Direction == SortDirection.Ascending ? "ascending" : "descending";
    }

    private Icon SortIcon(IGridColumn<TItem> col)
    {
        if (_sort.Value is { } s && s.ColumnKey == col.Key)
            return s.Direction == SortDirection.Ascending ? Icons.Outline.ArrowUp : Icons.Outline.ArrowDown;
        return Icons.Outline.Selector;
    }

    // ---- searching ----

    private async Task OnSearchChanged(string? value)
    {
        await _filter.SetAsync(value, FilterChanged);
        if (!_filter.IsControlled) Recompute();
        StateHasChanged();
    }

    // ---- column visibility ----

    private void SetColumnVisible(string key, bool visible)
    {
        if (visible) _hidden.Remove(key);
        else _hidden.Add(key);
        StateHasChanged();
    }

    // ---- selection ----

    private bool IsSelected(TItem item) => _selected.Contains(item);

    private int SelectedInViewCount => _view.Count(IsSelected);

    private bool AllSelected => _view.Count > 0 && _view.All(IsSelected);

    private bool SomeSelected => !AllSelected && _view.Any(IsSelected);

    private CheckedState SelectAllState =>
        AllSelected ? CheckedState.Checked : SomeSelected ? CheckedState.Indeterminate : CheckedState.Unchecked;

    private async Task ToggleRow(TItem item)
    {
        if (!_selected.Add(item)) _selected.Remove(item);
        await SelectedItemsChanged.InvokeAsync(_selected.ToList());
        StateHasChanged();
    }

    private async Task ToggleAll()
    {
        if (AllSelected)
        {
            foreach (var item in _view) _selected.Remove(item);
        }
        else
        {
            foreach (var item in _view) _selected.Add(item);
        }
        await SelectedItemsChanged.InvokeAsync(_selected.ToList());
        StateHasChanged();
    }

    // ---- per-row / per-column rendering ----

    private RenderFragment RenderHeader(IGridColumn<TItem> col) => @<text>
        @if (col.Header is { } custom)
        {
            @custom
        }
        else if (col.Sortable)
        {
            <button type="button" class="bz-table-sort-button" @onclick="@(() => ToggleSort(col))">
                <span>@col.Title</span>
                <BzIcon Icon="@SortIcon(col)" Class="bz-table-sort-icon" />
            </button>
        }
        else
        {
            @col.Title
        }
    </text>;

    private RenderFragment RenderBodyRow(TItem item, int index, List<IGridColumn<TItem>> columns) => @<TableRow
        Selected="@(Selectable && IsSelected(item))"
        Attributes="@RowAttributes(item, index)">
        @if (Selectable)
        {
            <TableCell Class="bz-table-select-cell">
                <Checkbox Checked="@(IsSelected(item) ? CheckedState.Checked : CheckedState.Unchecked)"
                          CheckedChanged="@(_ => ToggleRow(item))" aria-label="Select row" />
            </TableCell>
        }
        @foreach (var col in columns)
        {
            <TableCell Class="@ColumnClass(col, header: false)">@col.RenderCell(item)</TableCell>
        }
    </TableRow>;

    private RenderFragment EmptyRow(int colSpan) => @<TableRow>
        <TableCell Class="bz-table-empty" Attributes="@ColSpanAttributes(colSpan)">
            @(EmptyContent ?? DefaultEmpty)
        </TableCell>
    </TableRow>;

    private static readonly RenderFragment DefaultEmpty = builder => builder.AddContent(0, "No results.");

    private static string ColumnClass(IGridColumn<TItem> col, bool header)
    {
        var align = col.Align switch
        {
            "center" => "text-center",
            "end" => "text-end",
            _ => null,
        };
        return Tw.Merge(align, header ? col.HeaderClass : col.CellClass);
    }

    private IReadOnlyDictionary<string, object>? RowAttributes(TItem item, int index)
    {
        if (!Virtualize && !OnRowClick.HasDelegate) return null;

        var props = new PropBuilder(this);
        if (Virtualize)
        {
            props.Data("bz-virtual-index", index.ToString(CultureInfo.InvariantCulture));
            if (!DynamicRowHeight) props.Set("style", $"height:{Px(RowHeight)}");
        }
        if (OnRowClick.HasDelegate)
            props.On("onclick", EventCallback.Factory.Create(this, () => OnRowClick.InvokeAsync(item)));

        return props.Merge(null);
    }

    private static IReadOnlyDictionary<string, object> ColSpanAttributes(int colSpan) =>
        new PropBuilder().Set("colspan", colSpan.ToString(CultureInfo.InvariantCulture)).Merge(null);

    private RenderFragment RenderColumnToggle => @<DropdownMenu>
        <DropdownMenuTrigger>
            <AsChild Context="p">
                <Button Variant="ButtonVariant.Outline" @attributes="p.Attributes" Class="bz-data-table-columns-trigger">
                    <BzIcon Icon="@Icons.Outline.Adjustments" Class="size-4" />
                    <span>@ColumnToggleLabel</span>
                </Button>
            </AsChild>
        </DropdownMenuTrigger>
        <DropdownMenuContent Class="w-44">
            @foreach (var col in _effectiveColumns.Where(c => !string.IsNullOrEmpty(c.Title)))
            {
                var key = col.Key;
                <DropdownMenuCheckboxItem Checked="@(!_hidden.Contains(key))"
                                          CheckedChanged="@(v => SetColumnVisible(key, v))"
                                          OnSelect="@(e => e.PreventDefault())">
                    @col.Title
                </DropdownMenuCheckboxItem>
            }
        </DropdownMenuContent>
    </DropdownMenu>;

    private static string Px(double value) => value.ToString("0.###", CultureInfo.InvariantCulture) + "px";

    private sealed class KeyComparer(Func<TItem, object> key) : IEqualityComparer<TItem>
    {
        public bool Equals(TItem? a, TItem? b) =>
            a is null || b is null ? ReferenceEquals(a, b) : Equals(key(a), key(b));

        public int GetHashCode(TItem obj) => key(obj)?.GetHashCode() ?? 0;
    }
}
