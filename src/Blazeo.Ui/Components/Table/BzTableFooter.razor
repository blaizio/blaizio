@namespace Blazeo.Ui
@* The table's footer group (totals / summaries). Renders <tfoot>. *@

<BasePrimitive As="tfoot" Attributes="@BuildAttributes()" ChildContent="@ChildContent" />

@code {
    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The footer row(s).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the <c>tfoot</c>.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "table-footer")
            .Merge(Attributes, Tw.Merge("bz-table-footer", Class));
}
