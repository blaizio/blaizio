@namespace Blazeo.Ui
@* A data cell. Renders <td>. *@

<BzPrimitive As="td" Attributes="@BuildAttributes()" ChildContent="@ChildContent" />

@code {
    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The cell content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the <c>td</c>.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "table-cell")
            .Merge(Attributes, Tw.Merge("bz-table-cell", Class));
}
