@namespace Blazeo.Ui
@typeparam TItem
@typeparam TProp
@inherits ColumnBase<TItem>
@using System.Globalization
@using System.Linq.Expressions
@*
    A strongly-typed column bound to a property of the row. Sorting + search use the property's value
    directly; the cell renders the (optionally formatted) value, or your own ChildContent template.
    Title defaults to the property name. The grid cascades TItem, so usually only Property is needed:
        <PropertyColumn Property="@(p => p.Name)" Sortable />
*@

@code {
    /// <summary>The bound property, e.g. <c>@(p => p.Name)</c>. Drives the cell value, sorting and search.</summary>
    [Parameter, EditorRequired] public Expression<Func<TItem, TProp>>? Property { get; set; }

    /// <summary>A format string for <see cref="IFormattable"/> values (e.g. <c>"C"</c>, <c>"yyyy-MM-dd"</c>).</summary>
    [Parameter] public string? Format { get; set; }

    /// <summary>Custom cell content; when unset the formatted property value is rendered.</summary>
    [Parameter] public RenderFragment<TItem>? ChildContent { get; set; }

    private Func<TItem, TProp>? _compiled;
    private Expression<Func<TItem, TProp>>? _lastProperty;
    private string? _memberName;

    protected override void OnParametersSet()
    {
        if (Property is not null && !ReferenceEquals(Property, _lastProperty))
        {
            _lastProperty = Property;
            _compiled = Property.Compile();
            _memberName = MemberName(Property);
        }
    }

    protected override string? ResolveTitle() => Title ?? _memberName;

    protected override bool CanSort => _compiled is not null;

    protected override RenderFragment RenderCell(TItem item) =>
        ChildContent is not null ? ChildContent(item) : builder => builder.AddContent(0, FormatValue(item));

    protected override int CompareCore(TItem a, TItem b) =>
        _compiled is null ? 0 : Comparer<TProp>.Default.Compare(_compiled(a), _compiled(b));

    protected override string? GetTextCore(TItem item) => _compiled is null ? null : FormatValue(item);

    protected override bool HasText => _compiled is not null;

    private string FormatValue(TItem item)
    {
        if (_compiled is null) return string.Empty;
        var value = _compiled(item);
        if (value is null) return string.Empty;
        return !string.IsNullOrEmpty(Format) && value is IFormattable formattable
            ? formattable.ToString(Format, CultureInfo.CurrentCulture)
            : value.ToString() ?? string.Empty;
    }

    // The member name behind p => p.Name (or a boxing/convert cast around it), for the default Title.
    private static string? MemberName(Expression<Func<TItem, TProp>> expression) => expression.Body switch
    {
        MemberExpression member => member.Member.Name,
        UnaryExpression { Operand: MemberExpression member } => member.Member.Name,
        _ => null,
    };
}
