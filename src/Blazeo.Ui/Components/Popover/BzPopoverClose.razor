@namespace Blazeo.Ui
@*
    Styled PopoverClose - an opt-in button inside the content that closes the popover. Use AsChild to
    put the behaviour on a styled <BzButton>:

        <BzPopoverClose>
            <AsChild Context="p"><BzButton @attributes="p.Attributes">Done</BzButton></AsChild>
        </BzPopoverClose>
*@

<BasePopoverClose Class="@Class"
                   Attributes="@ForwardedAttributes()"
                   AsChild="@AsChild">
    @ChildContent
</BasePopoverClose>

@code {
    /// <summary>Extra classes.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Button content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the behaviour onto your own element instead of a <c>&lt;button&gt;</c>.</summary>
    [Parameter] public RenderFragment<BzRenderProps>? AsChild { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "popover-close").Merge(Attributes);
}
