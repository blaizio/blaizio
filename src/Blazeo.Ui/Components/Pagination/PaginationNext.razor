@namespace Blazeo.Ui
@* The "next page" control - a PaginationLink with a trailing chevron + label. The chevron mirrors under RTL. *@

<PaginationLink Href="@Href" Disabled="@Disabled" OnClick="@OnClick" AriaLabel="@AriaLabel"
                Class="@Tw.Merge("bz-pagination-next", Class)" Attributes="@Attributes">
    <span class="bz-pagination-label">@Label</span>
    <BzIcon Icon="@Icons.Outline.ChevronRight" />
</PaginationLink>

@code {
    /// <summary>Destination URL (link mode). Omit and use <see cref="OnClick"/> for in-place paging.</summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>Disable when already on the last page.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Raised on click - the in-place paging hook.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    /// <summary>Visible label. Defaults to "Next".</summary>
    [Parameter] public string Label { get; set; } = "Next";

    /// <summary>Accessible label. Defaults to "Go to next page".</summary>
    [Parameter] public string AriaLabel { get; set; } = "Go to next page";

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the control.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }
}
