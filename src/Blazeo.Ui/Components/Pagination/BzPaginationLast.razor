@namespace Blazeo.Ui
@* The "last page" control - a PaginationLink with a label + trailing double-chevron. The chevron mirrors under RTL. *@

<BzPaginationLink Href="@Href" Disabled="@Disabled" OnClick="@OnClick" AriaLabel="@AriaLabel"
                Class="@Tw.Merge("bz-pagination-last", Class)" Attributes="@Attributes">
    <span class="bz-pagination-label">@Label</span>
    <BzIcon Icon="@Icons.Outline.ChevronsRight" />
</BzPaginationLink>

@code {
    /// <summary>Destination URL (link mode). Omit and use <see cref="OnClick"/> for in-place paging.</summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>Disable when already on the last page.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Raised on click - the in-place paging hook.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    /// <summary>Visible label. Defaults to "Last".</summary>
    [Parameter] public string Label { get; set; } = "Last";

    /// <summary>Accessible label. Defaults to "Go to last page".</summary>
    [Parameter] public string AriaLabel { get; set; } = "Go to last page";

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the control.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }
}
