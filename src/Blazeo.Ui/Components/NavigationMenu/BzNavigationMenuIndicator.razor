@namespace Blazeo.Ui
@*
    The little arrow that slides under the open trigger. Place it as the last child of the list; it
    positions itself (and shows/hides) from the open state - JS measures the active trigger.
*@

<div @attributes="@BuildAttributes()">
    <div class="bg-border relative top-[60%] size-2 rotate-45 rounded-tl-sm shadow-md"></div>
</div>

@code {
    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    [CascadingParameter] private BaseNavigationMenu? Root { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "navigation-menu-indicator")
            .Data("state", Root?.IsAnyOpen == true ? "visible" : "hidden")
            .Merge(Attributes, Tw.Merge(BaseClasses, Class),
                "transform:translateX(var(--bz-nav-ind-left,0px));width:var(--bz-nav-ind-width,0px)");

    private const string BaseClasses =
        "bz-navigation-menu-indicator absolute top-full start-0 z-[1] flex h-1.5 items-end justify-center overflow-hidden " +
        "transition-[transform,width] duration-200 ease-out " +
        "data-[state=hidden]:animate-out data-[state=hidden]:fade-out data-[state=visible]:animate-in data-[state=visible]:fade-in";
}
