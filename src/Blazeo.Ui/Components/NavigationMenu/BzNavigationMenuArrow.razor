@namespace Blazeo.Ui
@*
    The little arrow that slides under the open trigger - the navigation menu's tail. Drawn like the
    Popover/Tooltip arrows (an SVG triangle filled with the panel surface plus a hairline ring on its two
    slanted faces) rather than a bare grey nub, so it matches the rest of the library. Place it as the last
    child of the list; the JS measures the open trigger and both positions it AND flips its data-state -
    it fades out (opacity, not an exit animation that snaps back) when no menu is open, so nothing lingers.
*@

<div @attributes="@BuildAttributes()">
    @* Same look as the panel - surface fill and the panel's own border colour on the two slanted faces -
       but no bottom edge, so the base merges seamlessly into the panel's top. It sits above the panel (z)
       so its base covers the panel's top border, tenting it up into the arrow. No own drop-shadow: a
       down-cast shadow on an UP-pointing triangle lands under the base and bleeds into the panel, and the
       panel's shadow is at its bottom/sides, not this top edge (same as the Popover/Tooltip up-arrows). *@
    <svg viewBox="0 0 12 12" class="block size-3">
        <path d="M0 7H12L6 0Z" class="fill-popover" />
        <path d="M0 7L6 0L12 7" class="fill-none stroke-border" stroke-width="1" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
    </svg>
</div>

@code {
    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Data("slot", "navigation-menu-arrow")
            .Data("state", "hidden") // the JS flips this to "visible" under the open trigger
            .Merge(Attributes, Tw.Merge(BaseClasses, Class),
                "transform:translateX(var(--bz-nav-ind-left,0px));width:var(--bz-nav-ind-width,0px)");

    // Visible by default, faded out only when the JS marks it hidden (no menu open) - a single data-state
    // rule, so it can't be out-cascaded by a competing base opacity. Plain opacity (not an animate-out
    // exit, which snaps back) so it truly hides and nothing lingers after close. The initial data-state is
    // "hidden" so it starts invisible until the JS positions + shows it. top-full + the JS-measured
    // left/width centre it under the open trigger; the transition slides it between triggers.
    // z above the viewport (z-50) so the base sits ON TOP of the panel's top border and tents it up.
    private const string BaseClasses =
        "bz-navigation-menu-arrow pointer-events-none absolute top-full start-0 z-[60] flex justify-center " +
        "transition-[opacity,transform,width] duration-200 ease-out data-[state=hidden]:opacity-0";
}
