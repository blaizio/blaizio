@namespace Blazeo.Ui
@* One section of an <Accordion>. *@

<BlazeAccordionItem Value="@Value"
                    Disabled="@Disabled"
                    Class="@Tw.Merge("bz-accordion-item", Class)"
                    Attributes="@ForwardedAttributes()">
    @ChildContent
</BlazeAccordionItem>

@code {
    /// <summary>The value identifying this item. Required.</summary>
    [Parameter] public string Value { get; set; } = default!;

    /// <summary>Disables just this item.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The item's trigger and content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "accordion-item").Merge(Attributes);
}
