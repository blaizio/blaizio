@namespace Blazeo.Ui
@*
    Styled RadioGroup - wraps the headless BlazeRadioGroup. Structural utilities + the cn-radio-group
    hook (the style sheet supplies the grid/gap). Pair each RadioGroupItem with a Label.
*@

<BlazeRadioGroup Value="@Value"
                 DefaultValue="@DefaultValue"
                 ValueChanged="@ValueChanged"
                 Disabled="@Disabled"
                 Required="@Required"
                 Orientation="@Orientation"
                 Loop="@Loop"
                 Class="@Tw.Merge("cn-radio-group w-full", Class)"
                 Attributes="@ForwardedAttributes()">
    @ChildContent
</BlazeRadioGroup>

@code {
    /// <summary>Controlled selected value. Use with <c>@bind-Value</c>.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Initial selection when uncontrolled.</summary>
    [Parameter] public string? DefaultValue { get; set; }

    /// <summary>Raised with the new value. Enables <c>@bind-Value</c>.</summary>
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Disables the whole group.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Marks the group required.</summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>Navigation axis. Defaults to <see cref="Blazeo.Orientation.Vertical"/>.</summary>
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Vertical;

    /// <summary>Wrap navigation at the ends. Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool Loop { get; set; } = true;

    /// <summary>Extra classes, merged over the layout defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The radio items.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes, forwarded to the group element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes() =>
        new PropBuilder().Data("slot", "radio-group").Merge(Attributes);
}
