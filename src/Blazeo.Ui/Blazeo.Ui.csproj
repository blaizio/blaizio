<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>Blazeo.Ui</RootNamespace>
    <!-- The registry: distributed as SOURCE (copied by the CLI), not shipped as a package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blazeo.Base\Blazeo.Base.csproj" />
    <ProjectReference Include="..\Blazeo.Icons\Blazeo.Icons.csproj" />
    <!-- The conventional cn() class helper = clsx + tailwind-merge. We only need the merge half. -->
    <PackageReference Include="TailwindMerge.NET" Version="1.4.0" />
  </ItemGroup>

</Project>
