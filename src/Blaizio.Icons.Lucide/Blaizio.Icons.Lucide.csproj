<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Blaizio</RootNamespace>
    <!-- Generated path data only (scripts/Update-BlaizioIcons.ps1 -Set Lucide); BzIcon and the
         Icon type come from Blaizio.Icons. Trimmable for the same reason as Blaizio.Icons: every
         icon is an expression-bodied property, so a WASM publish keeps only the referenced ones. -->
    <IsTrimmable>true</IsTrimmable>
    <IsPackable>true</IsPackable>
    <PackageId>Blaizio.Icons.Lucide</PackageId>
    <Title>Blaizio.Icons.Lucide</Title>
    <Description>Lucide icons for Blaizio: Lucide.Outline.* typed, tree-shakeable Icon values rendered by BzIcon (Blaizio.Icons). Icon data is ISC-licensed by the Lucide contributors.</Description>
    <!-- Set in Directory.Build.props, shared with Blaizio.Base / Blaizio.Icons: the family moves together. -->
    <Version>$(BlaizioPackageVersion)</Version>
    <PackageTags>blazor;icons;lucide;svg</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <ProjectReference Include="..\Blaizio.Icons\Blaizio.Icons.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="THIRD-PARTY-LICENSE.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
