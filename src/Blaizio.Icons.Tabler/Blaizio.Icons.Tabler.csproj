<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Blaizio</RootNamespace>
    <!-- Generated path data only (scripts/Update-BlaizioIcons.ps1 -Set Tabler); BzIcon and the
         Icon type come from Blaizio.Icons. Trimmable: every icon is an expression-bodied property,
         so a WASM publish keeps only the referenced ones. The styled components (Blaizio.Ui) draw
         from this set, so the CLI installs it with every project. -->
    <IsTrimmable>true</IsTrimmable>
    <IsPackable>true</IsPackable>
    <PackageId>Blaizio.Icons.Tabler</PackageId>
    <Title>Blaizio.Icons.Tabler</Title>
    <Description>Tabler icons for Blaizio: Tabler.Outline.* and Tabler.Filled.* typed, tree-shakeable Icon values rendered by BzIcon (Blaizio.Icons). The set the Blaizio components use. Icon data is MIT-licensed by Tabler.</Description>
    <!-- Set in Directory.Build.props, shared with Blaizio.Base / Blaizio.Icons: the family moves together. -->
    <Version>$(BlaizioPackageVersion)</Version>
    <PackageTags>blazor;icons;tabler;svg</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <ProjectReference Include="..\Blaizio.Icons\Blaizio.Icons.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="THIRD-PARTY-LICENSE.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
