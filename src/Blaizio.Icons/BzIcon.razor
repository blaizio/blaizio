@namespace Blaizio
@*
    Renders an icon. `Icon` is an `Icon` value from a generated set (e.g. `Tabler.Outline.Plus`
    from Tabler, `Lucide.Outline.House`, `Phosphor.Regular.House`); it carries its paint (outline →
    stroked, filled → filled), its grid and its stroke width, so a single value is self-describing
    and sets mix freely in one app. Size it with a CSS class (e.g. Tailwind `size-4`); it inherits
    colour via `currentColor`.

    Enhanced over ArcBlazor's ArcIcon: self-contained (no Tailwind/base dependency), dropped the
    icon-font branch, the set's true stroke width, and aria-hidden only when untitled.
*@

<svg xmlns="http://www.w3.org/2000/svg"
     width="24" height="24" viewBox="@_viewBox"
     fill="@_fill" stroke="@_stroke"
     stroke-width="@_strokeWidth" stroke-linecap="@_lineCap" stroke-linejoin="@_lineCap"
     focusable="false" role="img" aria-hidden="@(Title is null ? "true" : null)"
     class="@Class" style="@Style" @attributes="Attributes">
    @if (Title is not null)
    {
        <title>@Title</title>
    }
    @_content
</svg>

@code {
    /// <summary>The icon to render, e.g. <c>Tabler.Outline.Plus</c>. The <see langword="default"/> value renders nothing.</summary>
    [Parameter] public Icon Icon { get; set; }

    /// <summary>CSS classes (size it here, e.g. <c>size-5</c>).</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Inline styles.</summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>Accessible title. When set, renders a <c>&lt;title&gt;</c> and drops <c>aria-hidden</c>.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Stroke width for outline icons. Null (the default) uses the icon's own set width: 2 for Tabler and Lucide, 1.5 for HugeIcons.</summary>
    [Parameter] public float? StrokeWidth { get; set; }

    /// <summary>SVG view box. Null (the default) uses the icon's own grid: <c>0 0 24 24</c> for every set but Phosphor (<c>0 0 256 256</c>).</summary>
    [Parameter] public string? ViewBox { get; set; }

    /// <summary>Any other attributes, splatted onto the <c>&lt;svg&gt;</c>.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private MarkupString _content;
    private string _viewBox = "0 0 24 24";
    private string _fill = "none";
    private string? _stroke = "currentColor";
    private string? _strokeWidth;
    private string? _lineCap;

    protected override void OnParametersSet()
    {
        // Local copy disambiguates the property from the same-named Icon type and reads it once.
        var icon = Icon;
        if (string.IsNullOrEmpty(icon.Body))
        {
            _content = default;
            return;
        }

        _viewBox = ViewBox ?? icon.ViewBox ?? "0 0 24 24";
        if (icon.Kind == IconKind.Outline)
        {
            _fill = "none";
            _stroke = "currentColor";
            _strokeWidth = (StrokeWidth ?? icon.StrokeWidth).ToString(System.Globalization.CultureInfo.InvariantCulture);
            _lineCap = "round";
        }
        else
        {
            _fill = "currentColor";
            _stroke = null;
            _strokeWidth = null;
            _lineCap = null;
        }

        _content = (MarkupString)icon.Body;
    }
}
