<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>Blaizio</RootNamespace>
    <!-- Let the IL trimmer drop unused icons on a WASM publish: the icon `const`s are inlined at use
         sites, so unreferenced fields are removable. No-op for Blazor Server (loads the full DLL host
         side, where size is a non-issue). No reflection here, so it's trim-safe. -->
    <IsTrimmable>true</IsTrimmable>
    <IsPackable>true</IsPackable>
    <PackageId>Blaizio.Icons</PackageId>
    <Title>Blaizio.Icons</Title>
    <Description>BzIcon, the tree-shakeable Blazor SVG icon component, and the Icon value it renders. The sets ship on top: Blaizio.Icons.Tabler (the set the Blaizio components use), .Lucide, .Phosphor, .Remix, .HugeIcons. Path data is generated by scripts/Update-BlaizioIcons.ps1.</Description>
    <!-- Set in Directory.Build.props, shared with Blaizio.Base: the pair moves together. -->
    <Version>$(BlaizioPackageVersion)</Version>
    <PackageTags>blazor;icons;svg</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
