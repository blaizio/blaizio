<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>Blaizio</RootNamespace>
    <!-- Let the IL trimmer drop unused icons on a WASM publish: the icon `const`s are inlined at use
         sites, so unreferenced fields are removable. No-op for Blazor Server (loads the full DLL host
         side, where size is a non-issue). No reflection here, so it's trim-safe. -->
    <IsTrimmable>true</IsTrimmable>
    <IsPackable>true</IsPackable>
    <PackageId>Blaizio.Icons</PackageId>
    <Title>Blaizio.Icons</Title>
    <Description>Tabler icons for Blaizio as a tiny, tree-shakeable Blazor SVG component. Path data is generated by scripts/Update-BlazeIcons.ps1.</Description>
    <Version>0.1.0-alpha.2</Version>
    <PackageTags>blazor;icons;tabler;svg</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.2" />
  </ItemGroup>

</Project>
