<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>Blaizio</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Blaizio.Base</PackageId>
    <Title>Blaizio.Base</Title>
    <Description>Headless, unstyled Blazor UI primitives - behavior, accessibility (ARIA) and a data-state contract only. The unopinionated foundation for the Blaizio component framework (the headless primitives layer).</Description>
    <Version>0.1.0-alpha.13</Version>
    <PackageTags>blazor;components;headless;primitives;accessibility</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Lowercase asset URLs (default is _content/$(PackageId), i.e. _content/Blaizio.Base). Every
         module import and the boot.js script tag use this path - keep them in sync. -->
    <StaticWebAssetBasePath>_content/blaizio.base</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- The v3 CSS contract, materialized into consumers' .blaizio/ by the buildTransitive target:
       the Tailwind contract sheet (authored in Blaizio.Ui, the styling source of truth) and the
       vendored tw-animate (from the CLI's assets - Node-free consumers can't resolve the npm
       package). Both ride this package so a style-plumbing update is just a version bump. -->
  <ItemGroup>
    <None Include="..\Blaizio.Ui\Styles\blaizio.css" Pack="true" PackagePath="css\" />
    <None Include="..\Blaizio.Cli\Assets\animate.css" Pack="true" PackagePath="css\" />
    <None Include="buildTransitive\Blaizio.Base.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.2" />
  </ItemGroup>

  <!-- The test project reaches internal mechanism members (e.g. DialogInstance.NotifyExited). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Blaizio.Base.Tests" />
  </ItemGroup>

  <!-- Keep the JS toolchain (lib/) out of compilation AND publish: its package.json etc. otherwise
       collide with the docs' own lib/ files in the publish output (NETSDK1152). The build targets
       below read lib/ via direct paths / custom items, so excluding it from None/Content is safe. -->
  <ItemGroup>
    <Compile Remove="lib\**" />
    <Content Remove="lib\**" />
    <None Remove="lib\**" />
  </ItemGroup>

  <!--
    Bundle lib/ts/ -> wwwroot/dist before static web assets are collected, so the .js modules are
    packaged and resolvable at _content/blaizio.base/dist/*.js. Incremental via Inputs/Outputs.
    Skipped (with a warning) when lib/node_modules is absent so a no-Node build still works off the
    committed wwwroot/dist.
  -->
  <ItemGroup>
    <BlaizioTypeScript Include="lib\ts\**\*.ts" />
  </ItemGroup>

  <Target Name="BuildBlaizioScripts"
          BeforeTargets="BeforeBuild;ResolveStaticWebAssetsInputs"
          Condition="Exists('$(MSBuildProjectDirectory)\lib\node_modules')"
          Inputs="@(BlaizioTypeScript);lib\build.mjs"
          Outputs="$(MSBuildProjectDirectory)\wwwroot\dist\.stamp">
    <Exec Command="node build.mjs" WorkingDirectory="$(MSBuildProjectDirectory)\lib" />
    <Touch Files="$(MSBuildProjectDirectory)\wwwroot\dist\.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="WarnMissingBlaizioNodeModules"
          BeforeTargets="BeforeBuild"
          Condition="!Exists('$(MSBuildProjectDirectory)\lib\node_modules') AND Exists('$(MSBuildProjectDirectory)\lib\package.json')">
    <Warning Text="Blaizio.Base: lib/node_modules missing - run 'pnpm install' then 'pnpm build' in the lib folder to regenerate wwwroot/dist (using committed dist if present)." />
  </Target>

  <!-- Packing without the bundled JS would ship a DLL-only package whose interop components fail
       silently at runtime. Fail the pack instead of warning. -->
  <Target Name="FailPackWithoutBlaizioDist"
          BeforeTargets="GenerateNuspec"
          Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\dist')">
    <Error Text="Blaizio.Base: wwwroot/dist is missing - run 'pnpm install' and 'pnpm build' in lib/ before packing." />
  </Target>

</Project>
