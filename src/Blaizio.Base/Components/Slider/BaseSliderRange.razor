@namespace Blaizio
@inherits BzComponentBase
@using System.Globalization
@*
    The filled portion of the track. Reads the cascaded SliderContext and publishes the fill extent
    as two custom properties - --bz-slider-range-start / --bz-slider-range-end (fractions 0..1 from
    the start side) - that the styled layer turns into an offset + length (width, or height when
    vertical). Mirrors data-orientation / data-disabled. Must sit inside a BaseSliderTrack.
*@

<BasePrimitive As="span" Attributes="BuildAttributes()" ChildContent="@ChildContent" RenderAs="@RenderAs" />

@code {
    /// <summary>Optional inner content (rarely used).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render onto your own element instead of a <c>&lt;span&gt;</c>.</summary>
    [Parameter] public RenderFragment<BzRenderProps>? RenderAs { get; set; }

    [CascadingParameter] private SliderContext? Slider { get; set; }

    private static string Fmt(double value) => value.ToString(CultureInfo.InvariantCulture);

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var (start, end) = Slider?.RangeFractions() ?? (0, 0);

        var props = new PropBuilder()
            .Data("bz-slider-range", "")
            .Data("orientation", (Slider?.Orientation ?? Orientation.Horizontal).ToAttribute())
            .Set("style", $"--bz-slider-range-start:{Fmt(start)};--bz-slider-range-end:{Fmt(end)}");

        if (Slider?.Disabled == true) props.Data("disabled", "");

        return props.Merge(Attributes, Class, Style);
    }
}
