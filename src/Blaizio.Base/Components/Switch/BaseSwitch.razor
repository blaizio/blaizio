@namespace Blaizio
@inherits BzComponentBase
@*
    An on/off switch:
      • renders a native <button type="button" role="switch"> (Space/Enter activation for free),
      • aria-checked mirrors the state; data-state is "checked"/"unchecked" for the styled layer,
      • data-disabled is emitted when disabled,
      • clicking flips the state unless disabled.
    Controllable via Checked/DefaultChecked/CheckedChanged, bridged by ControllableState. The knob is
    rendered either by the parent-owned Thumb fragment (preferred - receives the state directly, no
    cascade and no extra component) or by a nested BaseSwitchThumb reading the cascaded SwitchContext
    (the composition path; the cascade only exists when no fragment is given).
    Headless: no track/thumb styling; the styled layer dresses data-[state=checked].

    Note: native form-submission (a hidden bubble <input>) is intentionally not included - Blazor
    state flows through @bind-Checked rather than form posts.
*@

@if (Thumb is not null)
{
    <BasePrimitive Element="button" Attributes="BuildAttributes()" RenderAs="@RenderAs">
        @ChildContent
        @Thumb(Context)
    </BasePrimitive>
}
else
{
    <CascadingValue Value="@Context" IsFixed="false">
        <BasePrimitive Element="button"
                        Attributes="BuildAttributes()"
                        ChildContent="@ChildContent"
                        RenderAs="@RenderAs" />
    </CascadingValue>
}

@code {
    /// <summary>Controlled checked state. Leave <see langword="null"/> for uncontrolled (see <see cref="DefaultChecked"/>).</summary>
    [Parameter] public bool? Checked { get; set; }

    /// <summary>Initial checked state when uncontrolled. Defaults to <see langword="false"/>.</summary>
    [Parameter] public bool DefaultChecked { get; set; }

    /// <summary>Raised with the new state whenever it changes. Enables <c>@bind-Checked</c>.</summary>
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }

    /// <summary>Disables the switch (blocks interaction; emits <c>data-disabled</c>).</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Accessible name for the switch (what it turns on/off, e.g. "Airplane mode"). Prefer a
    /// visible label wired via <see cref="AriaLabelledBy"/> or a <c>label for</c>; use this when the
    /// switch stands alone.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Id of the element that names the switch (takes precedence over <see cref="AriaLabel"/>, per ARIA).</summary>
    [Parameter] public string? AriaLabelledBy { get; set; }

    /// <summary>Inner content (e.g. track icons) - rendered before the <see cref="Thumb"/> fragment,
    /// or holding a <see cref="BaseSwitchThumb"/> on the composition path.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// The knob, rendered by THIS switch after <see cref="ChildContent"/> with the current state as
    /// context. Preferred over a nested BaseSwitchThumb: no cascading context and one component
    /// less. When set, no context is cascaded.
    /// </summary>
    [Parameter] public RenderFragment<SwitchContext>? Thumb { get; set; }

    /// <summary>Render the behaviour onto your own element instead of a <c>&lt;button&gt;</c>.</summary>
    [Parameter] public RenderFragment<BzRenderProps>? RenderAs { get; set; }

    private readonly ControllableState<bool> _state = new();

    private SwitchContext Context => new(_state.Value, Disabled);

    protected override void OnParametersSet() =>
        _state.Sync(Checked.HasValue, Checked ?? false, DefaultChecked);

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var isChecked = _state.Value;
        var props = new PropBuilder(this)
            .Set("role", "switch")
            .Aria("label", AriaLabel)
            .Aria("labelledby", AriaLabelledBy)
            .Aria("checked", isChecked)
            .Data("state", isChecked ? "checked" : "unchecked")
            .On("onclick", EventCallback.Factory.Create<MouseEventArgs>(this, OnClickAsync));

        if (RenderAs is null)
        {
            props.Set("type", "button").Flag("disabled", Disabled);
        }
        else if (Disabled)
        {
            props.Aria("disabled", true);
        }

        if (Disabled) props.Data("disabled", "");

        return props.Merge(Attributes, Class, Style);
    }

    private Task OnClickAsync() =>
        Disabled ? Task.CompletedTask : _state.SetAsync(!_state.Value, CheckedChanged);
}
