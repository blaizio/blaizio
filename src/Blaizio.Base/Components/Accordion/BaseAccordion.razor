@namespace Blaizio
@inherits BzComponentBase
@*
    A vertically stacked set of expandable sections: the root owns
    which items are open - Single mode keeps at most one (closable again only with Collapsible),
    Multiple keeps any number - and cascades an AccordionContext the items read. Controllable via
    @bind-Value (single) or @bind-Values (multiple). Triggers stay in the natural tab order (the
    ARIA accordion pattern); arrow-key navigation between headers is not ported yet.
*@

<CascadingValue Value="@Context" IsFixed="false">
    <BasePrimitive Element="div" Attributes="BuildAttributes()" ChildContent="@ChildContent" />
</CascadingValue>

@code {
    /// <summary>Expansion mode. Defaults to <see cref="SelectionMode.Single"/> (<see cref="SelectionMode.None"/> is treated as Single).</summary>
    [Parameter] public SelectionMode SelectionMode { get; set; } = SelectionMode.Single;

    /// <summary>Controlled open value (single mode). Use with <c>@bind-Value</c>.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Initial open value when uncontrolled (single mode).</summary>
    [Parameter] public string? DefaultValue { get; set; }

    /// <summary>Raised with the new value - <see langword="null"/> when closed via Collapsible. Enables <c>@bind-Value</c>.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Controlled open values (multiple mode). Use with <c>@bind-Values</c>.</summary>
    [Parameter] public IReadOnlyList<string>? Values { get; set; }

    /// <summary>Initial open values when uncontrolled (multiple mode).</summary>
    [Parameter] public IReadOnlyList<string>? DefaultValues { get; set; }

    /// <summary>Raised with the new values (multiple mode). Enables <c>@bind-Values</c>.</summary>
    [Parameter] public EventCallback<IReadOnlyList<string>> ValuesChanged { get; set; }

    /// <summary>Single mode: allow closing the open item by pressing it again. Defaults to <see langword="false"/> (the conventional default).</summary>
    [Parameter] public bool Collapsible { get; set; }

    /// <summary>Disables the whole accordion.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// The heading rank (1-6) the triggers render, so the accordion slots into the page's heading
    /// outline (e.g. 2 when the sections sit directly under the page's h1). Defaults to <c>3</c>.
    /// </summary>
    [Parameter] public int HeadingLevel { get; set; } = 3;

    /// <summary>
    /// Whether each panel is a <c>role="region"</c> landmark (named by its trigger). Defaults to
    /// <see langword="true"/> per the ARIA accordion pattern; turn off for accordions with many
    /// items, where a landmark per panel is more noise than help to screen-reader navigation.
    /// </summary>
    [Parameter] public bool Region { get; set; } = true;

    /// <summary>The accordion items.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string _baseId = default!;
    private readonly ControllableState<IReadOnlyList<string>> _state = new();

    private bool Single => SelectionMode != SelectionMode.Multiple;

    private AccordionContext Context =>
        new(Single ? SelectionMode.Single : SelectionMode.Multiple, _state.Value, Disabled, _baseId,
            EventCallback.Factory.Create<string>(this, ToggleAsync),
            Math.Clamp(HeadingLevel, 1, 6), Region);

    protected override void OnInitialized() => _baseId = Identifier.Create("accordion");

    // Controlled when the consumer binds the active mode's value; both modes share one
    // list-shaped state - single is the zero-or-one case (same approach as BaseToggleGroup).
    protected override void OnParametersSet() =>
        _state.Sync(
            Single ? ValueChanged.HasDelegate : ValuesChanged.HasDelegate,
            Single ? AsList(Value) : Values ?? [],
            Single ? AsList(DefaultValue) : DefaultValues ?? []);

    private Task ToggleAsync(string itemValue)
    {
        if (Disabled) return Task.CompletedTask;

        var open = _state.Value.Contains(itemValue);
        IReadOnlyList<string> next = (Single, open) switch
        {
            (true, true) => Collapsible ? [] : _state.Value,
            (true, false) => [itemValue],
            (false, true) => _state.Value.Where(v => v != itemValue).ToArray(),
            (false, false) => [.. _state.Value, itemValue],
        };

        return ReferenceEquals(next, _state.Value)
            ? Task.CompletedTask
            : _state.SetAsync(next, EventCallback.Factory.Create<IReadOnlyList<string>>(this, NotifyAsync));
    }

    private Task NotifyAsync(IReadOnlyList<string> next) =>
        Single
            ? ValueChanged.InvokeAsync(next.Count > 0 ? next[0] : null)
            : ValuesChanged.InvokeAsync(next);

    private static IReadOnlyList<string> AsList(string? value) => value is null ? [] : [value];

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder().Data("orientation", "vertical");
        if (Disabled) props.Data("disabled", "");
        return props.Merge(Attributes, Class, Style);
    }
}
