@namespace Blaizio
@inherits BzComponentBase
@*
    The button that toggles an accordion item, inside a heading (the ARIA accordion pattern -
    the heading + trigger fused; pass HeaderClass for the heading's styling). The heading rank
    comes from the accordion's HeadingLevel (default h3) so it slots into the page outline.
    aria-expanded + aria-controls wire it to the panel; data-state mirrors the item.
*@

<BasePrimitive Element="@($"h{Accordion?.HeadingLevel ?? 3}")" Attributes="HeaderAttributes()">
    <BasePrimitive Element="button" Attributes="BuildAttributes()" ChildContent="@ChildContent" />
</BasePrimitive>

@code {
    /// <summary>Classes for the wrapping <c>&lt;h3&gt;</c> heading.</summary>
    [Parameter] public string? HeaderClass { get; set; }

    /// <summary>Trigger content (the section's label).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private AccordionContext? Accordion { get; set; }
    [CascadingParameter] private AccordionItemContext? Item { get; set; }

    private bool Open => Item?.Open ?? false;
    private bool IsDisabled => Item?.Disabled ?? false;

    private IReadOnlyDictionary<string, object> HeaderAttributes() =>
        new PropBuilder()
            .Set("class", HeaderClass)
            .Data("state", Open ? "open" : "closed")
            .Data("slot", "accordion-header")
            .Merge(null);

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder(this)
            .Set("type", "button")
            .Set("id", Item is null ? null : Accordion?.TriggerId(Item.Value))
            .Aria("expanded", Open)
            .Aria("controls", Item is null ? null : Accordion?.ContentId(Item.Value))
            .Data("state", Open ? "open" : "closed")
            .On("onclick", EventCallback.Factory.Create(this, OnClickAsync));

        if (IsDisabled) props.Flag("disabled", true).Data("disabled", "");

        return props.Merge(Attributes, Class, Style);
    }

    private Task OnClickAsync() =>
        IsDisabled || Accordion is null || Item is null
            ? Task.CompletedTask
            : Accordion.Toggle.InvokeAsync(Item.Value);
}
