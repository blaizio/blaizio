@namespace Blaizio
@inherits BzComponentBase
@*
    One expandable section of a BaseAccordion: a container with
    data-state "open"/"closed" that cascades an AccordionItemContext to its header/trigger/content.
*@

<CascadingValue Value="@ItemContext" IsFixed="false">
    <BasePrimitive As="div" Attributes="@BuildAttributes()" ChildContent="@ChildContent" />
</CascadingValue>

@code {
    /// <summary>The value identifying this item. Required.</summary>
    [Parameter] public string Value { get; set; } = default!;

    /// <summary>Disables just this item.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>The item's trigger and content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private AccordionContext? Accordion { get; set; }

    private bool Open => Accordion?.IsOpen(Value) ?? false;
    private bool IsDisabled => Disabled || (Accordion?.Disabled ?? false);

    private AccordionItemContext ItemContext => new(Value, Open, IsDisabled);

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder().Data("state", Open ? "open" : "closed");
        if (IsDisabled) props.Data("disabled", "");
        return props.Merge(Attributes, Class, Style);
    }
}
