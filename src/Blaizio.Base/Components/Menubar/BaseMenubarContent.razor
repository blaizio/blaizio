@namespace Blaizio
@inherits MenuContentBase
@*
    The floating surface of a BaseMenubarMenu: a role="menu" panel - identical machinery to
    BaseDropdownMenuContent (it reuses MenuContentBase + the shared DropdownMenuContext, so every
    BaseDropdownMenu* item / submenu drops straight in), anchored to its trigger and dismissed by Escape,
    Tab, an outside pointer-down, or selecting an item. The one difference: on close it restores focus
    to the trigger only if it was stranded, so SWITCHING to a sibling menu (which closes this one while
    the new one takes focus) does not yank focus back to this trigger.
*@

@if (Present)
{
    <BaseFocusScope Trapped="false"
                     Loop="false"
                     OnMountAutoFocus="SuppressAutoFocus"
                     OnUnmountAutoFocus="SuppressAutoFocus"
                     Attributes="BuildAttributes()"
                     ElementRefCaptured="@CaptureElement">
        @ChildContent
    </BaseFocusScope>
}

@code {
    /// <summary>Menu content (items, labels, separators, groups, submenus).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Preferred side of the trigger. Flips to stay in view. Defaults to <see cref="Blaizio.Side.Bottom"/>.</summary>
    [Parameter] public Side Side { get; set; } = Side.Bottom;

    /// <summary>Alignment along the trigger's edge. Defaults to <see cref="Blaizio.Align.Start"/>.</summary>
    [Parameter] public Align Align { get; set; } = Align.Start;

    /// <summary>Gap in pixels between the trigger and the content. Defaults to 4.</summary>
    [Parameter] public double SideOffset { get; set; } = 4;

    /// <summary>Offset in pixels along the alignment axis. Defaults to 0.</summary>
    [Parameter] public double AlignOffset { get; set; }

    /// <summary>
    /// Render the content in place instead of moving it to the document body while open. By default
    /// the surface portals to the body so no ancestor stacking context or overflow clip can cover
    /// it; set <see langword="true"/> to keep it inside its parent DOM (useful under CSS containment,
    /// for print, or in tests that assert on local markup). Submenus always stay inside their parent
    /// surface and follow it.
    /// </summary>
    [Parameter] public bool Inline { get; set; }

    /// <summary>Raised after the exit animation finishes and the content has unmounted.</summary>
    [Parameter] public EventCallback OnExitComplete { get; set; }

    [CascadingParameter] private DropdownMenuContext? Menu { get; set; }

    protected override bool IsOpen => Menu?.Open ?? false;
    protected override MenuFocusIntent FocusIntent => Menu?.FocusIntent ?? MenuFocusIntent.None;
    protected override string AnchorSelector => $"[data-bz-dropdown-menu-anchor='{Menu?.AnchorId}']";
    protected override bool Dismissable => true;
    // Switching menus closes this one while the sibling takes focus - don't pull focus back here.
    protected override bool RestoreFocusOnlyIfStranded => true;
    protected override bool RenderInline => Inline;
    protected override Side PreferredSide => Side;
    protected override Align PreferredAlign => Align;
    protected override double PreferredSideOffset => SideOffset;
    protected override double PreferredAlignOffset => AlignOffset;

    protected override Task RequestCloseAsync() =>
        Menu is null ? Task.CompletedTask : Menu.RequestClose.InvokeAsync();

    protected override async ValueTask OnClosedAsync() => await OnExitComplete.InvokeAsync();

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder(this)
            .Set("role", "menu")
            .Set("id", Menu?.ContentId)
            .Aria("labelledby", Menu?.TriggerId)
            .Aria("orientation", "vertical")
            .Data("bz-menu-content", "")
            .Data("state", Closing ? "closed" : "open")
            .Data("side", ResolvedSide)
            .Data("align", ResolvedAlign)
            // A portaled surface leaves any subtree direction provider's DOM ancestry, so the
            // cascaded direction is stamped on the element itself (inline keeps inheritance).
            .Set("dir", Inline ? DirAttribute : PortalDirAttribute)
            .On("onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, OnKeyDownAsync))
            // Fixed + hidden from the first paint so the surface never renders in normal flow
            // during the gap before ts/positioning.js imports and places it (a first-open flash on
            // a cold load). The positioning module overwrites these inline values on placement;
            // Blazor never rewrites an unchanged style attribute, so the JS-owned values survive.
            .Set("style", "position:fixed;top:0;left:0;visibility:hidden")
            .Merge(Attributes, Class, Style);

    // Escape and Tab dismiss. Escape keeps the user on the bar, so it refocuses the trigger NOW - the
    // trigger's highlight then runs unbroken from "open" into "focused" rather than flickering off
    // while the close animates and only returning afterwards. Tab moves focus onward, so it must not
    // grab the trigger. Vertical navigation + activation are owned by ts/menu.js; the inline arrows
    // move between menus at the bar level.
    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (Menu is null || e.Key is not ("Escape" or "Tab")) return;
        if (e.Key == "Escape") await RefocusTriggerAsync();
        await Menu.RequestClose.InvokeAsync();
    }
}
