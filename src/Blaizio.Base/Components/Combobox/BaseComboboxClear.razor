@namespace Blaizio
@inherits BzComponentBase
@*
    Clears the whole selection (and the query), then hands focus back to the input. Renders only while
    something is selected - there is nothing to clear otherwise - so a skin can swap it in for the trigger
    chevron. RenderAs lets it wrap your own element (e.g. a styled icon button).
*@

@if (Combobox?.HasSelection == true)
{
    <BasePrimitive Element="button"
                 Attributes="BuildAttributes()"
                 ChildContent="@ChildContent"
                 RenderAs="@RenderAs" />
}

@code {
    /// <summary>Button content (usually an X icon).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the behaviour onto your own element instead of a <c>&lt;button&gt;</c>.</summary>
    [Parameter] public RenderFragment<BzRenderProps>? RenderAs { get; set; }

    [CascadingParameter] private ComboboxContext? Combobox { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder(this)
            .Aria("label", "Clear")
            .Data("bz-combobox-clear", "")
            .On("onclick", EventCallback.Factory.Create<MouseEventArgs>(this, OnClickAsync));

        // Native `disabled` is element-only: in RenderAs mode the props may be splatted onto a
        // component, where the string would be assigned to a bool Disabled parameter and throw.
        if (Combobox?.Disabled == true)
        {
            if (RenderAs is null) props.Flag("disabled", true);
            else props.Aria("disabled", true).Data("disabled", "");
        }

        if (RenderAs is null) props.Set("type", "button");

        return props.Merge(Attributes, Class, Style);
    }

    private Task OnClickAsync() =>
        Combobox is null ? Task.CompletedTask : Combobox.ClearSelection.InvokeAsync();
}
