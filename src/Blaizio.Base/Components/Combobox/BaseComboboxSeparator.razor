@namespace Blaizio
@inherits BzComponentBase
@*
    A horizontal rule between groups. Hidden while a query is filtering (the groups it divides are
    collapsing in and out), matching how the list drops its separators mid-search.
*@

<div @attributes="BuildAttributes()"></div>

@code {
    [CascadingParameter] private ComboboxContext? Combobox { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder(this)
            .Set("role", "separator")
            .Data("bz-combobox-separator", "")
            .Set("dir", DirAttribute);

        if (Combobox?.IsFiltering == true) props.Flag("hidden", true);

        return props.Merge(Attributes, Class, Style);
    }
}
