@namespace Blaizio
@inherits BzComponentBase
@inject IJSRuntime Js
@implements IAsyncDisposable
@*
    The text box of a tags input - the free-typing area that sits after the chips. Typing flows to the
    root through the context (which splits out pasted delimiters); Enter or a delimiter key commits the
    text as a tag; Backspace on an empty query removes the newest tag. ts/inputTags.js is attached to
    swallow the boundary keys' defaults DOM-side (Enter must not submit an enclosing form, a delimiter
    must not print) - the logic itself stays here in C#. Renders a bare <input>; the styled layer adds
    the flex sizing and placeholder look.
*@

<input @ref="_element" @attributes="BuildAttributes()" />

@code {
    /// <summary>Placeholder text.</summary>
    [Parameter] public string? Placeholder { get; set; }

    [CascadingParameter] private InputTagsContext? Tags { get; set; }

    private ElementReference _element;
    private IJSObjectReference? _instance;
    private string? _attachedDelimiters;

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder(this)
            .Set("type", "text")
            .Set("id", Tags?.InputId)
            .Set("value", Tags?.Search ?? "")
            .Set("placeholder", Placeholder)
            .Set("autocomplete", "off")
            .Set("autocorrect", "off")
            .Set("autocapitalize", "none")
            .Set("spellcheck", "false")
            .Aria("label", Tags?.Label)
            .Data("bz-input-tags-input", "")
            .Set("dir", DirAttribute)
            .On("oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, OnInputAsync))
            .On("onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, OnKeyDownAsync));

        if (Tags?.Disabled == true) props.Set("disabled", "disabled");
        if (Tags?.ReadOnly == true) props.Set("readonly", "readonly");

        return props.Merge(Attributes, Class, Style);
    }

    private Task OnInputAsync(ChangeEventArgs e) =>
        Tags?.SearchChanged.InvokeAsync(e.Value?.ToString()) ?? Task.CompletedTask;

    // Enter / a delimiter commits, Backspace on an empty query removes the newest tag. The keys'
    // DOM defaults are already prevented by the attached inputTags.js guard where it matters.
    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (Tags is null) return;

        if (e.Key == "Enter" || Tags.Delimiters.Contains(e.Key))
        {
            await Tags.Commit.InvokeAsync();
            return;
        }

        if (e.Key == "Backspace" && Tags.Search.Length == 0 && Tags.HasValues)
            await Tags.RemoveLast.InvokeAsync();
    }

    // Attach (or re-attach when the delimiter set changes) the DOM-side keydown guard.
    [System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage] // JS-interop seam: verified in-browser.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var delimiters = string.Join(" ", Tags?.Delimiters ?? []);
        if (_instance is not null && _attachedDelimiters == delimiters) return;

        try
        {
            var module = await JsModules.ImportAsync(Js, "./_content/blaizio.base/dist/inputTags.js");

            if (_instance is not null) await _instance.InvokeVoidAsync("dispose");
            _instance = await module.InvokeAsync<IJSObjectReference>(
                "createInputTags", _element, new { delimiters = Tags?.Delimiters ?? [] });
            _attachedDelimiters = delimiters;
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone before the attach landed.
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            // Instances only - the modules are shared via JsModules and outlive this component.
            if (_instance is not null) await _instance.InvokeVoidAsync("dispose");
            if (_instance is not null) await _instance.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone.
        }
        GC.SuppressFinalize(this);
    }
}
