@namespace Blaizio
@inherits BzComponentBase
@*
    One committed tag in a tags input. Cascades its Index + Value so a nested BaseInputTagsChipRemove
    knows what to drop. Its content is the label plus (optionally) the remove button.
*@

<CascadingValue Value="@(new InputTagsChipContext(Index, Value))" IsFixed="true">
    <div @attributes="BuildAttributes()">@ChildContent</div>
</CascadingValue>

@code {
    /// <summary>The tag's position in the root's Values.</summary>
    [Parameter] public int Index { get; set; }

    /// <summary>The tag's text.</summary>
    [Parameter] public string Value { get; set; } = "";

    /// <summary>The chip content (the label, and usually a BaseInputTagsChipRemove).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private InputTagsContext? Tags { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder(this)
            .Data("bz-input-tags-chip", "")
            .Data("value", Value)
            .Set("dir", DirAttribute);

        if (Tags?.Disabled == true) props.Data("disabled", "");

        return props.Merge(Attributes, Class, Style);
    }
}
