@namespace Blaizio
@inherits BzComponentBase
@*
    A selectable menu item: role="menuitem", tabindex=-1 (ts/menu.js owns focus + the roving point) and
    marked data-bz-menu-item so the navigation finds it. A click - or Enter / Space, which ts/menu.js
    maps to a click - fires OnSelect and then closes the whole menu, unless the handler calls
    PreventDefault. RenderAs lets the item BE your own element (e.g. an <a> for a navigation link).
*@

<BasePrimitive As="div"
                Attributes="BuildAttributes()"
                ChildContent="@ChildContent"
                RenderAs="@RenderAs" />

@code {
    /// <summary>Item content (text, and any leading / trailing slots the skin lays out).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the behaviour onto your own element instead of a <c>&lt;div&gt;</c> (e.g. an <c>&lt;a&gt;</c>).</summary>
    [Parameter] public RenderFragment<BzRenderProps>? RenderAs { get; set; }

    /// <summary>Disables the item: skipped by keyboard navigation and inert to clicks.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Raised when the item is selected. <see cref="MenuSelectEventArgs.PreventDefault"/> keeps the menu open.</summary>
    [Parameter] public EventCallback<MenuSelectEventArgs> OnSelect { get; set; }

    [CascadingParameter] private DropdownMenuContext? Menu { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder(this)
            .Set("role", "menuitem")
            .Set("tabindex", "-1")
            .Data("bz-menu-item", "")
            .On("onclick", EventCallback.Factory.Create(this, OnClickAsync));

        if (Disabled) props.Aria("disabled", true).Data("disabled", "");

        return props.Merge(Attributes, Class, Style);
    }

    private async Task OnClickAsync()
    {
        if (Disabled || Menu is null) return;

        var args = new MenuSelectEventArgs();
        await OnSelect.InvokeAsync(args);
        if (!args.DefaultPrevented) await Menu.RequestClose.InvokeAsync();
    }
}
