@namespace Blaizio
@inherits BzComponentBase
@*
    Groups related menu items as role="group" for assistive tech. Optionally name the group by
    pointing its aria-labelledby at a BaseDropdownMenuLabel's id (pass it via Attributes).
*@

<BasePrimitive As="div" Attributes="BuildAttributes()" ChildContent="@ChildContent" />

@code {
    /// <summary>The grouped items (and an optional leading label).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder().Set("role", "group").Data("bz-menu-group", "").Merge(Attributes, Class, Style);
}
