@namespace Blaizio
@inherits MenuContentBase
@*
    A submenu's floating panel: the same surface machinery as BaseDropdownMenuContent (presence,
    @floating-ui anchoring, ts/menu.js navigation, a non-trapping focus scope) but WITHOUT its own
    dismissal layer - the root menu owns outside-press + Escape dismissal, and closing the root
    unmounts this with it. Opens to the inline-end of its trigger (right in LTR, left in RTL, flipping
    when it would overflow). Because IsSubmenu is true, ts/menu.js owns this level's pointer + close
    behaviour: it stays open while the pointer crosses the safe triangle toward it, the inline-start
    arrow closes it (refocusing the trigger synchronously), and focus moving to a sibling closes it -
    each routed back to RequestClose via OnSubCloseRequested. Escape still bubbles to the root.
*@

@if (Present)
{
    <BaseFocusScope Trapped="false"
                     Loop="false"
                     OnMountAutoFocus="SuppressAutoFocus"
                     OnUnmountAutoFocus="SuppressAutoFocus"
                     Attributes="@BuildAttributes()"
                     ElementRefCaptured="@CaptureElement">
        @ChildContent
    </BaseFocusScope>
}

@code {
    /// <summary>Submenu content (items, labels, separators, nested submenus).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private DropdownMenuSubContext? Sub { get; set; }

    // The root menu's state, cascaded from BaseDropdownMenu past every level. When it closes (Escape /
    // outside press / item select) the whole menu tears down, and this submenu must drop synchronously
    // rather than ride the root's exit-animation transform (which would reparent + shift it).
    [CascadingParameter] private DropdownMenuContext? RootMenu { get; set; }

    protected override bool IsOpen => Sub?.Open ?? false;
    protected override MenuFocusIntent FocusIntent => Sub?.FocusIntent ?? MenuFocusIntent.None;
    protected override string AnchorSelector => $"[data-bz-dropdown-menu-sub-anchor='{Sub?.AnchorId}']";
    protected override bool Dismissable => false;
    protected override bool IsSubmenu => true;
    protected override bool AncestorClosing => RootMenu is { Open: false };
    // Submenus open alongside their trigger; the inline-end side mirrors under RTL.
    protected override Side PreferredSide => ResolvedDirection == Direction.Rtl ? Side.Left : Side.Right;
    protected override Align PreferredAlign => Align.Start;
    protected override double PreferredSideOffset => 0;
    protected override double PreferredAlignOffset => -4;

    // Reached from ts/menu.js (OnSubCloseRequested) for the inline-start arrow and focus-out close.
    protected override Task RequestCloseAsync() =>
        Sub is null ? Task.CompletedTask : Sub.RequestClose.InvokeAsync();

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder(this)
            .Set("role", "menu")
            .Set("id", Sub?.ContentId)
            .Aria("labelledby", Sub?.TriggerId)
            .Aria("orientation", "vertical")
            .Data("bz-menu-content", "")
            .Data("state", Closing ? "closed" : "open")
            .Data("side", ResolvedSide)
            .Data("align", ResolvedAlign)
            .Set("dir", DirAttribute)
            .Merge(Attributes, Class, Style);
}
