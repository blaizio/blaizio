@namespace Blaizio
@inherits BzComponentBase
@*
    A non-interactive caption for a section of the menu (e.g. "My Account"). Not a menu item: it
    carries no role, no tabindex, and is skipped by keyboard navigation. Pair it with a
    BaseDropdownMenuGroup (point the group's aria-labelledby at this label's id) to name the section
    for assistive tech.
*@

<BasePrimitive As="div" Attributes="@BuildAttributes()" ChildContent="@ChildContent" />

@code {
    /// <summary>Label content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder().Data("bz-menu-label", "").Merge(Attributes, Class, Style);
}
