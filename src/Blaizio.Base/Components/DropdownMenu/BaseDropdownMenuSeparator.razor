@namespace Blaizio
@inherits BzComponentBase
@*
    A horizontal divider between groups of menu items: role="separator" with
    aria-orientation="horizontal". Decorative + non-focusable; the navigation skips it.
*@

<BasePrimitive Element="div" Attributes="BuildAttributes()" />

@code {
    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Set("role", "separator")
            .Aria("orientation", "horizontal")
            .Data("bz-menu-separator", "")
            .Merge(Attributes, Class, Style);
}
