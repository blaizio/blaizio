@namespace Blaizio
@inherits BzComponentBase
@*
    One option in a BaseDropdownMenuRadioGroup: role="menuitemradio" with aria-checked + data-state.
    Selecting it becomes the group's value and fires Select, then closes the whole menu by default
    (call PreventDefault in Select to keep it open). The Indicator fragment is rendered only while
    this item is the selected one.
*@

<BasePrimitive Element="div" Attributes="BuildAttributes()">
    @ChildContent
    @if (Checked)
    {
        @Indicator
    }
</BasePrimitive>

@code {
    /// <summary>The value this option contributes when selected. Required.</summary>
    [Parameter] public string Value { get; set; } = default!;

    /// <summary>Disables the item: skipped by keyboard navigation and inert to clicks.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Item content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The selection mark - rendered only while this item is checked.</summary>
    [Parameter] public RenderFragment? Indicator { get; set; }

    /// <summary>Raised when the item is selected. <see cref="MenuSelectEventArgs.PreventDefault"/> keeps the menu open.</summary>
    [Parameter] public EventCallback<MenuSelectEventArgs> Select { get; set; }

    [CascadingParameter] private DropdownMenuContext? Menu { get; set; }
    [CascadingParameter] private DropdownMenuRadioContext? Group { get; set; }

    private bool Checked => Group?.IsChecked(Value) ?? false;

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder(this)
            .Set("role", "menuitemradio")
            .Set("tabindex", "-1")
            .Data("bz-menu-item", "")
            .Aria("checked", Checked)
            .Data("state", Checked ? "checked" : "unchecked")
            .On("onclick", EventCallback.Factory.Create<MouseEventArgs>(this, OnClickAsync));

        if (Disabled) props.Aria("disabled", true).Data("disabled", "");

        return props.Merge(Attributes, Class, Style);
    }

    private async Task OnClickAsync()
    {
        if (Disabled || Group is null) return;

        await Group.Select.InvokeAsync(Value);
        var args = new MenuSelectEventArgs();
        await Select.InvokeAsync(args);
        if (!args.DefaultPrevented && Menu is not null) await Menu.RequestClose.InvokeAsync();
    }
}
