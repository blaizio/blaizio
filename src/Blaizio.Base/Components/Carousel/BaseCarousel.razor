@namespace Blaizio
@inherits BzComponentBase
@inject IJSRuntime Js
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Web
@*
    Headless carousel root. A region that cascades itself so the content, slides, prev/next controls and
    dots can read its state and drive it. The scrolling itself is a CSS scroll-snap viewport (rendered by
    BaseCarouselContent); ts/carousel.js attaches to that viewport, derives the selected slide + whether
    either edge is reached, and reports them back here. This root owns the JS instance and exposes the
    imperative moves (ScrollPrev/ScrollNext/ScrollTo) the controls call. Pure logic - the look is the
    styled layer's job.
*@

<CascadingValue Value="this" IsFixed="true">
    <BasePrimitive As="div" Attributes="BuildAttributes()" ChildContent="@ChildContent" />
</CascadingValue>

@code {
    /// <summary>The axis to scroll along. Defaults to <see cref="CarouselOrientation.Horizontal"/>.</summary>
    [Parameter] public CarouselOrientation Orientation { get; set; } = CarouselOrientation.Horizontal;

    /// <summary>Wrap around at the ends (next from the last slide goes to the first, and vice versa).</summary>
    [Parameter] public bool Loop { get; set; }

    /// <summary>Advance automatically every N milliseconds (0 = off). Pauses on hover/focus.</summary>
    [Parameter] public int AutoplayInterval { get; set; }

    /// <summary>Raised when the selected slide changes (its zero-based index).</summary>
    [Parameter] public EventCallback<int> OnSelectedIndexChanged { get; set; }

    /// <summary>The content, controls and dots.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Whether the carousel scrolls along the inline axis.</summary>
    public bool IsHorizontal => Orientation == CarouselOrientation.Horizontal;

    /// <summary>The zero-based index of the slide currently snapped into view.</summary>
    public int SelectedIndex { get; private set; }

    /// <summary>The number of slides.</summary>
    public int SlideCount { get; private set; }

    /// <summary>Whether there is a slide before the current one to scroll to.</summary>
    public bool CanScrollPrev { get; private set; }

    /// <summary>Whether there is a slide after the current one to scroll to.</summary>
    public bool CanScrollNext { get; private set; }

    /// <summary>Raised after the engine reports new state. The controls/dots subscribe so they re-render
    /// when the selection or edge flags change (they only read this state, so a root re-render alone
    /// wouldn't refresh them).</summary>
    public event Action? StateChanged;

    private IJSObjectReference? _module;
    private IJSObjectReference? _instance;
    private DotNetObjectReference<BaseCarousel>? _selfRef;
    private bool _attached;

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder(this)
            .Data("slot", "carousel")
            .Set("role", "region")
            .Aria("roledescription", "carousel")
            .Data("orientation", IsHorizontal ? "horizontal" : "vertical")
            .On("onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, OnKeyDown))
            .Merge(Attributes, Class, Style);

    /// <summary>Called by <see cref="BaseCarouselContent"/> once its viewport element is in the DOM; wires the
    /// scroll engine to it. Idempotent.</summary>
    public async Task AttachViewportAsync(ElementReference viewport)
    {
        if (_attached) return;
        _attached = true;
        try
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            _module = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/blaizio.base/dist/carousel.js");
            _instance = await _module.InvokeAsync<IJSObjectReference>(
                "createCarousel", viewport, _selfRef,
                new { horizontal = IsHorizontal, loop = Loop, autoplayMs = AutoplayInterval });
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone.
        }
    }

    private Task OnKeyDown(KeyboardEventArgs e) => e.Key switch
    {
        "ArrowLeft" when IsHorizontal => ScrollPrev(),
        "ArrowRight" when IsHorizontal => ScrollNext(),
        "ArrowUp" when !IsHorizontal => ScrollPrev(),
        "ArrowDown" when !IsHorizontal => ScrollNext(),
        _ => Task.CompletedTask,
    };

    /// <summary>Scroll to the previous slide (wraps to the last if <see cref="Loop"/> and at the start).</summary>
    public async Task ScrollPrev()
    {
        if (_instance is not null) await _instance.InvokeVoidAsync("scrollPrev");
    }

    /// <summary>Scroll to the next slide (wraps to the first if <see cref="Loop"/> and at the end).</summary>
    public async Task ScrollNext()
    {
        if (_instance is not null) await _instance.InvokeVoidAsync("scrollNext");
    }

    /// <summary>Scroll a specific slide (by zero-based index) into view.</summary>
    public async Task ScrollTo(int index)
    {
        if (_instance is not null) await _instance.InvokeVoidAsync("scrollTo", index);
    }

    /// <summary>Pushed from the scroll engine on init, scroll and resize.</summary>
    [JSInvokable]
    public Task OnScrollState(int index, bool canPrev, bool canNext, int count)
    {
        var indexChanged = index != SelectedIndex;
        SelectedIndex = index;
        CanScrollPrev = canPrev;
        CanScrollNext = canNext;
        SlideCount = count;
        StateHasChanged();
        StateChanged?.Invoke();
        return indexChanged ? OnSelectedIndexChanged.InvokeAsync(index) : Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_instance is not null) { await _instance.InvokeVoidAsync("dispose"); await _instance.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone.
        }
        _selfRef?.Dispose();
    }
}
