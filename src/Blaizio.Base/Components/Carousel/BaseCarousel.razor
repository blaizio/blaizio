@namespace Blaizio
@inherits BzComponentBase
@inject IJSRuntime Js
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Web
@*
    Headless carousel root. A region that cascades itself so the content, slides, prev/next controls and
    dots can read its state and drive it. The scrolling itself is a CSS scroll-snap viewport (rendered by
    BaseCarouselContent); ts/carousel.js attaches to that viewport, derives the selected slide + whether
    either edge is reached, and reports them back here. This root owns the JS instance and exposes the
    imperative moves (ScrollPrev/ScrollNext/ScrollTo) the controls call. Pure logic - the look is the
    styled layer's job.
*@

<CascadingValue Value="this" IsFixed="true">
    <BasePrimitive As="div" Attributes="BuildAttributes()" ChildContent="@ChildContent" />
</CascadingValue>

@code {
    /// <summary>The axis to scroll along. Defaults to <see cref="Orientation.Horizontal"/>.</summary>
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Horizontal;

    /// <summary>Wrap around at the ends (next from the last slide goes to the first, and vice versa).</summary>
    [Parameter] public bool Loop { get; set; }

    /// <summary>Advance automatically every N milliseconds (0 = off). Pauses on hover/focus.</summary>
    [Parameter] public int AutoplayInterval { get; set; }

    /// <summary>Controlled selected slide (zero-based). Leave <see langword="null"/> for uncontrolled; bind
    /// with <c>@bind-SelectedIndex</c> - the carousel scrolls to match a new value.</summary>
    [Parameter] public int? SelectedIndex { get; set; }

    /// <summary>The slide shown initially when uncontrolled (zero-based).</summary>
    [Parameter] public int DefaultSelectedIndex { get; set; }

    /// <summary>Raised with the new zero-based index when the selected slide changes. Enables <c>@bind-SelectedIndex</c>.</summary>
    [Parameter] public EventCallback<int> SelectedIndexChanged { get; set; }

    /// <summary>The content, controls and dots.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Whether the carousel scrolls along the inline axis.</summary>
    public bool IsHorizontal => Orientation == Orientation.Horizontal;

    /// <summary>The zero-based index of the selected slide - the effective <see cref="SelectedIndex"/>
    /// (controls and dots read this; the scroll engine keeps it in step with the viewport).</summary>
    public int CurrentIndex => _index.Value;

    /// <summary>The number of slides.</summary>
    public int SlideCount { get; private set; }

    /// <summary>Whether there is a slide before the current one to scroll to.</summary>
    public bool CanScrollPrev { get; private set; }

    /// <summary>Whether there is a slide after the current one to scroll to.</summary>
    public bool CanScrollNext { get; private set; }

    /// <summary>Raised after the engine reports new state. The controls/dots subscribe so they re-render
    /// when the selection or edge flags change (they only read this state, so a root re-render alone
    /// wouldn't refresh them).</summary>
    public event Action? StateChanged;

    private IJSObjectReference? _module;
    private IJSObjectReference? _instance;
    private DotNetObjectReference<BaseCarousel>? _selfRef;
    private bool _attached;

    // Controlled/uncontrolled selection (the usual Value/DefaultValue/ValueChanged shape), reconciled
    // against what the scroll engine last reported (_engineIndex = the viewport's actual position).
    private readonly ControllableState<int> _index = new();
    private int _engineIndex;
    private bool _pendingScroll;
    private int _pendingTarget;

    protected override void OnParametersSet() =>
        _index.Sync(SelectedIndex.HasValue, SelectedIndex ?? 0, DefaultSelectedIndex);

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder(this)
            .Data("slot", "carousel")
            .Set("role", "region")
            .Aria("roledescription", "carousel")
            .Data("orientation", IsHorizontal ? "horizontal" : "vertical")
            .On("onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, OnKeyDown))
            .Merge(Attributes, Class, Style);

    /// <summary>Called by <see cref="BaseCarouselContent"/> once its viewport element is in the DOM; wires the
    /// scroll engine to it. Idempotent.</summary>
    public async Task AttachViewportAsync(ElementReference viewport)
    {
        if (_attached) return;
        _attached = true;
        try
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            _module = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/blaizio.base/dist/carousel.js");
            _instance = await _module.InvokeAsync<IJSObjectReference>(
                "createCarousel", viewport, _selfRef,
                new { horizontal = IsHorizontal, loop = Loop, autoplayMs = AutoplayInterval });
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone.
        }
    }

    private Task OnKeyDown(KeyboardEventArgs e) => e.Key switch
    {
        "ArrowLeft" when IsHorizontal => ScrollPrev(),
        "ArrowRight" when IsHorizontal => ScrollNext(),
        "ArrowUp" when !IsHorizontal => ScrollPrev(),
        "ArrowDown" when !IsHorizontal => ScrollNext(),
        _ => Task.CompletedTask,
    };

    /// <summary>Scroll to the previous slide (wraps to the last if <see cref="Loop"/> and at the start).</summary>
    public async Task ScrollPrev()
    {
        if (_instance is not null) await _instance.InvokeVoidAsync("scrollPrev");
    }

    /// <summary>Scroll to the next slide (wraps to the first if <see cref="Loop"/> and at the end).</summary>
    public async Task ScrollNext()
    {
        if (_instance is not null) await _instance.InvokeVoidAsync("scrollNext");
    }

    /// <summary>Scroll a specific slide (by zero-based index) into view.</summary>
    public async Task ScrollTo(int index)
    {
        if (_instance is not null) await _instance.InvokeVoidAsync("scrollTo", index);
    }

    /// <summary>Pushed from the scroll engine on init, scroll and resize.</summary>
    [JSInvokable]
    public async Task OnScrollState(int index, bool canPrev, bool canNext, int count)
    {
        var moved = index != _engineIndex;
        _engineIndex = index;
        CanScrollPrev = canPrev;
        CanScrollNext = canNext;
        SlideCount = count;

        // Commit BEFORE re-rendering so the after-render reconciler sees the engine and the bound index
        // already agreeing (otherwise it would read the stale index and scroll right back). While we're
        // scrolling the viewport toward the bound index (initial default / a new controlled value) the
        // intermediate positions aren't user selections - swallow them until we arrive.
        if (_pendingScroll)
        {
            if (index == _index.Value) _pendingScroll = false;
        }
        else if (moved && index != _index.Value)
        {
            await _index.SetAsync(index, SelectedIndexChanged);
        }

        StateHasChanged();
        StateChanged?.Invoke();
    }

    // Reconcile the viewport with the bound index: whenever the effective SelectedIndex differs from
    // where the engine actually is (initial DefaultSelectedIndex, a new controlled value, or a parent
    // that refused a change), scroll to it. Uncontrolled user scrolling commits the engine's index
    // above, so the two only diverge when the parameter side moves.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_instance is null) return;
        var target = _index.Value;
        if (target == _engineIndex || target < 0 || target >= SlideCount) return;
        if (_pendingScroll && target == _pendingTarget) return;
        _pendingScroll = true;
        _pendingTarget = target;
        await ScrollTo(target);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_instance is not null) { await _instance.InvokeVoidAsync("dispose"); await _instance.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone.
        }
        _selfRef?.Dispose();
    }
}
