@namespace Blaizio
@inherits BzComponentBase
@inject IJSRuntime Js
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Web
@*
    Headless carousel root. A region that cascades itself so the content, slides, prev/next controls and
    dots can read its state and drive it. The scrolling itself is a CSS scroll-snap viewport (rendered by
    BaseCarouselContent); ts/carousel.js attaches to that viewport, derives the selected slide + whether
    either edge is reached, and reports them back here. This root owns the JS instance and exposes the
    imperative moves (ScrollPrev/ScrollNext/ScrollTo) the controls call. Pure logic - the look is the
    styled layer's job.
*@

<CascadingValue Value="this" IsFixed="true">
    <BasePrimitive Element="div" Attributes="BuildAttributes()" ChildContent="@ChildContent"
                   ElementRefCaptured="@(r => _root = r)" />
</CascadingValue>

@code {
    /// <summary>The axis to scroll along. Defaults to <see cref="Orientation.Horizontal"/>.</summary>
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Horizontal;

    /// <summary>Wrap around at the ends (next from the last slide goes to the first, and vice versa).</summary>
    [Parameter] public bool Loop { get; set; }

    /// <summary>
    /// Advance automatically every N milliseconds (0 = off). Rotation never auto-starts under
    /// prefers-reduced-motion; hover suspends it while the pointer is over the viewport; keyboard
    /// focus entering the carousel or a drag stops it until explicitly restarted via
    /// <see cref="ResumeAsync"/> (e.g. a play/pause control).
    /// </summary>
    [Parameter] public int AutoplayInterval { get; set; }

    /// <summary>Raised when rotation starts or stops (autoplay carousels): initial state, hover/focus/drag
    /// pauses, and <see cref="PauseAsync"/>/<see cref="ResumeAsync"/> calls.</summary>
    [Parameter] public EventCallback<bool> PlayingChanged { get; set; }

    /// <summary>Controlled selected slide (zero-based). Leave <see langword="null"/> for uncontrolled; bind
    /// with <c>@bind-SelectedIndex</c> - the carousel scrolls to match a new value.</summary>
    [Parameter] public int? SelectedIndex { get; set; }

    /// <summary>The slide shown initially when uncontrolled (zero-based).</summary>
    [Parameter] public int DefaultSelectedIndex { get; set; }

    /// <summary>Raised with the new zero-based index when the selected slide changes. Enables <c>@bind-SelectedIndex</c>.</summary>
    [Parameter] public EventCallback<int> SelectedIndexChanged { get; set; }

    /// <summary>Accessible name for the carousel region (what the slides show, e.g. "Featured
    /// products"). A carousel region must be named (APG); a debug warning fires when it isn't.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Id of the element that names the region (takes precedence over <see cref="AriaLabel"/>, per ARIA).</summary>
    [Parameter] public string? AriaLabelledBy { get; set; }

    /// <summary>What screen readers call the region, in place of its role. Defaults to "carousel".</summary>
    [Parameter] public string RoleDescription { get; set; } = "carousel";

    /// <summary>What screen readers call each slide, in place of its role. Defaults to "slide".</summary>
    [Parameter] public string SlideRoleDescription { get; set; } = "slide";

    /// <summary>
    /// Each slide's name for screen readers, given its place (<c>Position</c>, from 1) among
    /// <c>Count</c> slides. Defaults to "N of M". A slide's own <c>AriaLabel</c> wins over it.
    /// </summary>
    [Parameter] public Func<CarouselSlidePosition, string>? SlideAriaLabel { get; set; }

    /// <summary>The content, controls and dots.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Whether the carousel scrolls along the inline axis.</summary>
    public bool IsHorizontal => Orientation == Orientation.Horizontal;

    /// <summary>The zero-based index of the selected slide - the effective <see cref="SelectedIndex"/>
    /// (controls and dots read this; the scroll engine keeps it in step with the viewport).</summary>
    public int CurrentIndex => _index.Value;

    /// <summary>The number of slides.</summary>
    public int SlideCount { get; private set; }

    /// <summary>Whether there is a slide before the current one to scroll to.</summary>
    public bool CanScrollPrev { get; private set; }

    /// <summary>Whether there is a slide after the current one to scroll to.</summary>
    public bool CanScrollNext { get; private set; }

    /// <summary>Whether autoplay rotation is currently running (a play/pause control reads this).</summary>
    public bool IsPlaying { get; private set; }

    /// <summary>Raised after the engine reports new state. The controls/dots subscribe so they re-render
    /// when the selection or edge flags change (they only read this state, so a root re-render alone
    /// wouldn't refresh them).</summary>
    public event Action? StateChanged;

    private readonly JsInstance _instance = new();
    private DotNetObjectReference<BaseCarousel>? _selfRef;
    private bool _attached;
    private bool _ariaChecked;
    private readonly List<BaseCarouselItem> _slides = [];

    // Controlled/uncontrolled selection (the usual Value/DefaultValue/ValueChanged shape), reconciled
    // against what the scroll engine last reported (_engineIndex = the viewport's actual position).
    private readonly ControllableState<int> _index = new();
    private int _engineIndex;
    private bool _pendingScroll;
    private int _pendingTarget;

    protected override void OnParametersSet() =>
        _index.Sync(
            ControllableState.IsControlled(SelectedIndex.HasValue, SelectedIndexChanged.HasDelegate, defaultSupplied: true),
            SelectedIndex ?? 0,
            DefaultSelectedIndex);

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder(this)
            .Data("slot", "carousel")
            .Set("role", "region")
            .Aria("roledescription", RoleDescription)
            .Aria("label", AriaLabel)
            .Aria("labelledby", AriaLabelledBy)
            .Data("orientation", IsHorizontal ? "horizontal" : "vertical")
            .Merge(Attributes, Class, Style);

    // The root element, handed to the script: the arrow keys are listened for there (see
    // ts/carousel.ts), across the viewport and the controls around it.
    private ElementReference _root;

    /// <summary>Called by a <see cref="BaseCarouselItem"/> on init so slides know their position for
    /// the "N of M" labels. Registration order is render order.</summary>
    internal void RegisterSlide(BaseCarouselItem slide)
    {
        _slides.Add(slide);
        StateChanged?.Invoke(); // Earlier slides re-label as M grows.
    }

    /// <summary>Called by a <see cref="BaseCarouselItem"/> on dispose; remaining slides re-label.</summary>
    internal void UnregisterSlide(BaseCarouselItem slide)
    {
        _slides.Remove(slide);
        StateChanged?.Invoke();
    }

    /// <summary>One-based position of <paramref name="slide"/> among the registered slides (0 when unknown).</summary>
    internal int SlidePosition(BaseCarouselItem slide) => _slides.IndexOf(slide) + 1;

    /// <summary>How many slides are registered (the M in "N of M" - tracks the markup, unlike
    /// <see cref="SlideCount"/> which waits for the scroll engine's first report).</summary>
    internal int RegisteredSlideCount => _slides.Count;

    /// <summary>The default name of the slide at <paramref name="position"/>: <see cref="SlideAriaLabel"/>'s words, else "N of M".</summary>
    internal string SlideName(int position, int count) =>
        SlideAriaLabel?.Invoke(new CarouselSlidePosition(position, count)) is { Length: > 0 } name ? name : $"{position} of {count}";

    /// <summary>Called by <see cref="BaseCarouselContent"/> once its viewport element is in the DOM; wires the
    /// scroll engine to it. Idempotent.</summary>
    public async Task AttachViewportAsync(ElementReference viewport)
    {
        if (_attached) return;
        _attached = true;
        try
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            var module = await JsModules.ImportAsync(Js, "./_content/blaizio.base/dist/carousel.js");
            await _instance.CreateAsync(module, "createCarousel", viewport, _selfRef,
                new { horizontal = IsHorizontal, loop = Loop, autoplayMs = AutoplayInterval }, _root);
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone.
        }
    }

    /// <summary>Scroll to the previous slide (wraps to the last if <see cref="Loop"/> and at the start).</summary>
    public async Task ScrollPrev()
    {
        if (_instance.IsCreated) await _instance.InvokeVoidAsync("scrollPrev");
    }

    /// <summary>Scroll to the next slide (wraps to the first if <see cref="Loop"/> and at the end).</summary>
    public async Task ScrollNext()
    {
        if (_instance.IsCreated) await _instance.InvokeVoidAsync("scrollNext");
    }

    /// <summary>Scroll a specific slide (by zero-based index) into view.</summary>
    public async Task ScrollTo(int index)
    {
        if (_instance.IsCreated) await _instance.InvokeVoidAsync("scrollTo", index);
    }

    /// <summary>Stop autoplay rotation until <see cref="ResumeAsync"/> is called.</summary>
    public async Task PauseAsync()
    {
        if (_instance.IsCreated) await _instance.InvokeVoidAsync("pause");
    }

    /// <summary>Start (or restart) autoplay rotation. An explicit user request, so it also works under
    /// prefers-reduced-motion (which only blocks the automatic start).</summary>
    public async Task ResumeAsync()
    {
        if (_instance.IsCreated) await _instance.InvokeVoidAsync("play");
    }

    /// <summary>Pushed from the scroll engine whenever rotation starts or stops.</summary>
    [JSInvokable]
    public async Task OnPlayingChanged(bool playing)
    {
        if (IsPlaying == playing) return;
        IsPlaying = playing;
        await PlayingChanged.InvokeAsync(playing);
        StateHasChanged();
        StateChanged?.Invoke();
    }

    /// <summary>Pushed from the scroll engine on init, scroll and resize.</summary>
    [JSInvokable]
    public async Task OnScrollState(int index, bool canPrev, bool canNext, int count, bool settled = false)
    {
        var moved = index != _engineIndex;
        _engineIndex = index;
        CanScrollPrev = canPrev;
        CanScrollNext = canNext;
        SlideCount = count;

        // Commit BEFORE re-rendering so the after-render reconciler sees the engine and the bound index
        // already agreeing (otherwise it would read the stale index and scroll right back). While we're
        // scrolling the viewport toward the bound index (initial default / a new controlled value) the
        // intermediate positions aren't user selections - swallow them until we arrive.
        if (_pendingScroll)
        {
            if (index == _index.Value)
            {
                _pendingScroll = false;
            }
            else if (settled)
            {
                // The viewport came to rest somewhere else: the scroll we asked for was interrupted
                // (a drag, the wheel, a resize). Stop waiting for an arrival that will not come -
                // that swallowed every later scroll - and take where it rested as the selection.
                _pendingScroll = false;
                await _index.SetAsync(index, SelectedIndexChanged);
            }
        }
        else if (moved && index != _index.Value)
        {
            await _index.SetAsync(index, SelectedIndexChanged);
        }

        StateHasChanged();
        StateChanged?.Invoke();
    }

    // Reconcile the viewport with the bound index: whenever the effective SelectedIndex differs from
    // where the engine actually is (initial DefaultSelectedIndex, a new controlled value, or a parent
    // that refused a change), scroll to it. Uncontrolled user scrolling commits the engine's index
    // above, so the two only diverge when the parameter side moves.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_ariaChecked)
        {
            _ariaChecked = true;
            if (!AriaDiagnostics.HasName(AriaLabel, AriaLabelledBy, Attributes))
                await AriaDiagnostics.WarnUnnamedAsync(Js, "Carousel");
        }

        if (!_instance.IsCreated) return;
        var target = _index.Value;
        if (target == _engineIndex || target < 0 || target >= SlideCount) return;
        if (_pendingScroll && target == _pendingTarget) return;
        _pendingScroll = true;
        _pendingTarget = target;
        await ScrollTo(target);
    }

    public async ValueTask DisposeAsync()
    {
        // Instances only - the modules are shared via JsModules and outlive this component.
        await _instance.DisposeAsync();
        _selfRef?.Dispose();
    }
}
