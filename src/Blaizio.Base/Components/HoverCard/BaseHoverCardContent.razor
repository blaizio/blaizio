@namespace Blaizio
@inherits FloatingSurfaceBase
@*
    The floating surface of a BaseHoverCard: an INTERACTIVE panel (no pointer-events-none, unlike a
    tooltip) anchored to the trigger via ts/positioning.ts (@floating-ui), presence-managed for the
    enter/exit animation (ts/presence.ts), and dismissed by Escape or an outside pointer-down
    (ts/dismissableLayer.ts with dismissOnEscape:true, since - unlike a popover - focus is never
    moved into the card, so there is no focused element to catch Escape in C#). Hovering or focusing
    the card holds it open (its own enter cancels the trigger's pending close); leaving it starts the
    close delay. No overlay, no scroll lock, no focus trap - the page stays interactive.
    data-side/data-align reflect the resolved placement (JS reports flips back, so Blazor owns them).
    The lifecycle lives in FloatingSurfaceBase.
*@

@if (Present)
{
    <BasePrimitive Element="div"
                    Attributes="BuildAttributes()"
                    ChildContent="@ChildContent"
                    ElementRefCaptured="@CaptureElement" />
}

@code {
    /// <summary>Hover card content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Preferred side of the trigger. Flips to the opposite side to stay in view. Defaults to <see cref="Blaizio.Side.Bottom"/>.</summary>
    [Parameter] public Side Side { get; set; } = Side.Bottom;

    /// <summary>Alignment along the trigger's edge. Defaults to <see cref="Blaizio.Align.Center"/>.</summary>
    [Parameter] public Align Align { get; set; } = Align.Center;

    /// <summary>Gap in pixels between the trigger and the content. Defaults to 4.</summary>
    [Parameter] public double SideOffset { get; set; } = 4;

    /// <summary>Offset in pixels along the alignment axis. Defaults to 0.</summary>
    [Parameter] public double AlignOffset { get; set; }

    /// <summary>
    /// Render the content in place instead of moving it to the document body while open. By default
    /// the surface portals to the body so no ancestor stacking context or overflow clip can cover
    /// it; set <see langword="true"/> to keep it inside its parent DOM (useful under CSS containment,
    /// for print, or in tests that assert on local markup).
    /// </summary>
    [Parameter] public bool Inline { get; set; }

    /// <summary>Raised after the exit animation finishes and the content has been removed.</summary>
    [Parameter] public EventCallback OnExitComplete { get; set; }

    [CascadingParameter] private HoverCardContext? HoverCard { get; set; }

    protected override bool IsOpen => HoverCard?.Open ?? false;
    protected override string AnchorSelector => $"[data-bz-hover-card-anchor='{HoverCard?.AnchorId}']";
    protected override Side PreferredSide => Side;
    protected override Align PreferredAlign => Align;
    protected override double PreferredSideOffset => SideOffset;
    protected override double PreferredAlignOffset => AlignOffset;
    protected override bool RenderInline => Inline;
    // A press on the trigger is not "outside": moving onto and off it is handled by hover, so it
    // must not also dismiss.
    protected override bool Dismissable => true;
    // The card never holds focus, so Escape cannot reach a key handler here: the layer catches
    // it at the document level instead.
    private protected override bool DismissOnEscape => true;

    // Escape or an outside pointer-down, reported by the dismissable layer.
    protected override Task RequestCloseAsync() =>
        HoverCard is null ? Task.CompletedTask : HoverCard.Dismiss.InvokeAsync();

    protected override async ValueTask OnClosedAsync() => await OnExitComplete.InvokeAsync();

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder(this)
            .Set("id", HoverCard?.ContentId)
            .Data("state", Closing ? "closed" : "open")
            .Data("side", ResolvedSide)
            .Data("align", ResolvedAlign)
            // A portaled surface leaves any subtree direction provider's DOM ancestry, so the
            // cascaded direction is stamped on the element itself (inline keeps inheritance).
            .Set("dir", Inline ? DirAttribute : PortalDirAttribute)
            .On("onpointerenter", EventCallback.Factory.Create(this, OnPointerEnter))
            .On("onpointerleave", EventCallback.Factory.Create(this, OnPointerLeave))
            .On("onfocusin", EventCallback.Factory.Create(this, OnFocusIn))
            .On("onfocusout", EventCallback.Factory.Create(this, OnFocusOut))
            // Fixed + hidden from the first paint so the surface never renders in normal flow
            // during the gap before ts/positioning.js imports and places it (a first-open flash on
            // a cold load). The positioning module overwrites these inline values on placement;
            // Blazor never rewrites an unchanged style attribute, so the JS-owned values survive.
            .Set("style", "position:fixed;top:0;left:0;visibility:hidden")
            .Merge(Attributes, Class, Style);

    // Hovering / focusing the card holds it open - its enter cancels the trigger's pending close.
    private Task OnPointerEnter() => HoverCard?.OpenDelayed.InvokeAsync() ?? Task.CompletedTask;
    private Task OnPointerLeave() => HoverCard?.CloseDelayed.InvokeAsync() ?? Task.CompletedTask;
    private Task OnFocusIn() => HoverCard?.OpenDelayed.InvokeAsync() ?? Task.CompletedTask;
    private Task OnFocusOut() => HoverCard?.CloseDelayed.InvokeAsync() ?? Task.CompletedTask;
}
