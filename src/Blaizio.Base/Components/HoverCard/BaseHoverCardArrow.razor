@namespace Blaizio
@inherits BzComponentBase
@*
    The little arrow pointing from the hover card back to its trigger. Carries the generic
    data-bz-arrow hook that ts/positioning.ts (the @floating-ui arrow middleware) positions; the
    styled layer draws the SVG and rotates it to the resolved side. Decorative - aria-hidden.
    Optional: omit it for a plain card.
*@

<BasePrimitive Element="span" Attributes="BuildAttributes()" ChildContent="@ChildContent" />

@code {
    /// <summary>The arrow graphic (an SVG, supplied by the styled layer).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder(this)
            .Data("bz-arrow", "")
            .Aria("hidden", true)
            .Merge(Attributes, Class, Style);
}
