@namespace Blaizio
@inherits BzComponentBase
@*
    A button that closes the surrounding BasePopover. RenderAs lets it wrap your own element (e.g. a
    styled Button).
*@

<BasePrimitive As="button"
                Attributes="BuildAttributes()"
                ChildContent="@ChildContent"
                RenderAs="@RenderAs" />

@code {
    /// <summary>Button content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the behaviour onto your own element instead of a <c>&lt;button&gt;</c>.</summary>
    [Parameter] public RenderFragment<BzRenderProps>? RenderAs { get; set; }

    [CascadingParameter] private PopoverContext? Popover { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder(this)
            .On("onclick", EventCallback.Factory.Create(this, CloseAsync));

        if (RenderAs is null) props.Set("type", "button");

        return props.Merge(Attributes, Class, Style);
    }

    private Task CloseAsync() =>
        Popover is null ? Task.CompletedTask : Popover.SetOpen.InvokeAsync(false);
}
