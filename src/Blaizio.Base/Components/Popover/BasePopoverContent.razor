@namespace Blaizio
@inherits BzComponentBase
@inject IJSRuntime Js
@implements IAsyncDisposable
@using System.Diagnostics.CodeAnalysis
@*
    The floating surface of a BasePopover: a role="dialog" panel wrapped in a focus scope - focus
    moves in on open and returns to the trigger on close. It is NOT trapped (a popover is non-modal,
    so the page stays interactive and an outside press passes through), but by default Tab LOOPS
    within the panel (Loop) so keyboard focus is gated to the popover's own controls instead of
    escaping to the page behind it - Escape or an outside click is how you leave. Anchored to the
    trigger via ts/positioning.ts (@floating-ui), presence-managed like a tooltip/dialog (stays
    mounted with data-state="closed" while the exit animation plays, unmounting on ts/presence.ts's
    animationend report), and dismissed by Escape (onkeydown) or an outside pointer-down
    (ts/dismissableLayer.ts). No overlay, no scroll lock. data-side/data-align reflect the resolved
    placement (JS reports flips back, so Blazor owns those attributes).
*@

@if (_present)
{
    <BaseFocusScope Trapped="false"
                     Loop="@Loop"
                     Attributes="BuildAttributes()"
                     ElementRefCaptured="@(reference => _element = reference)"
                     OnMountAutoFocus="@OnOpenAutoFocus"
                     OnUnmountAutoFocus="@OnCloseAutoFocus">
        <CascadingValue Value="@_aria" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </BaseFocusScope>
}

@code {
    /// <summary>Popover content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Preferred side of the trigger. Flips to the opposite side to stay in view. Defaults to <see cref="Blaizio.Side.Bottom"/>.</summary>
    [Parameter] public Side Side { get; set; } = Side.Bottom;

    /// <summary>Alignment along the trigger's edge. Defaults to <see cref="Blaizio.Align.Center"/>.</summary>
    [Parameter] public Align Align { get; set; } = Align.Center;

    /// <summary>Gap in pixels between the trigger and the content. Defaults to 4.</summary>
    [Parameter] public double SideOffset { get; set; } = 4;

    /// <summary>Offset in pixels along the alignment axis. Defaults to 0.</summary>
    [Parameter] public double AlignOffset { get; set; }

    /// <summary>
    /// Tab from the last control wraps to the first (and Shift+Tab from the first wraps to the last),
    /// keeping keyboard focus gated within the panel instead of escaping to the page behind it.
    /// The popover stays non-modal either way (outside clicks pass through). Defaults to <see langword="true"/>;
    /// set <see langword="false"/> to let Tab leave the panel and continue through the page.
    /// </summary>
    [Parameter] public bool Loop { get; set; } = true;

    /// <summary>Raised before auto-focusing the first tabbable on open. PreventDefault to focus something yourself.</summary>
    [Parameter] public EventCallback<FocusScopeEvent> OnOpenAutoFocus { get; set; }

    /// <summary>Raised before focus returns to the trigger on close. PreventDefault to handle focus yourself.</summary>
    [Parameter] public EventCallback<FocusScopeEvent> OnCloseAutoFocus { get; set; }

    /// <summary>
    /// Render the content in place instead of moving it to the document body while open. By default
    /// the surface portals to the body so no ancestor stacking context or overflow clip can cover
    /// it; set <see langword="true"/> to keep it inside its parent DOM (useful under CSS containment,
    /// for print, or in tests that assert on local markup).
    /// </summary>
    [Parameter] public bool Inline { get; set; }

    /// <summary>Raised after the exit animation finishes and the content has unmounted.</summary>
    [Parameter] public EventCallback OnExitComplete { get; set; }

    [CascadingParameter] private PopoverContext? Popover { get; set; }

    private AriaNameRegistry _aria = default!;
    private bool _present;
    private bool _closing;
    private bool _ariaChecked;
    private bool _disposed;
    private string _side = "bottom";
    private string _align = "center";
    private ElementReference _element;
    private IJSObjectReference? _presenceModule;
    private IJSObjectReference? _positioningModule;
    private IJSObjectReference? _dismissModule;
    private Task<IJSObjectReference>? _presenceTask;
    private Task<IJSObjectReference>? _positioningTask;
    private Task<IJSObjectReference>? _dismissTask;
    private DotNetObjectReference<BasePopoverContent>? _selfRef;

    protected override void OnInitialized() =>
        // The registry re-renders THIS content when a title/description (de)registers; guard against a
        // notify arriving after disposal.
        _aria = new AriaNameRegistry(() => { if (!_disposed) _ = InvokeAsync(StateHasChanged); });

    protected override void OnParametersSet()
    {
        var open = Popover?.Open ?? false;

        if (open && (!_present || _closing))
        {
            _present = true;
            _closing = false;
        }
        else if (!open && _present && !_closing)
        {
            _closing = true;
        }
    }

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder(this)
            .Set("role", "dialog")
            .Set("id", Popover?.ContentId)
            .Data("state", _closing ? "closed" : "open")
            .Data("side", _side)
            .Data("align", _align)
            // A portaled surface leaves any subtree direction provider's DOM ancestry, so the
            // cascaded direction is stamped on the element itself (inline keeps inheritance).
            .Set("dir", Inline ? DirAttribute : PortalDirAttribute)
            .On("onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, OnKeyDownAsync))
            // Fixed + hidden from the first paint so the surface never renders in normal flow
            // during the gap before ts/positioning.js imports and places it (a first-open flash on
            // a cold load). The positioning module overwrites these inline values on placement;
            // Blazor never rewrites an unchanged style attribute, so the JS-owned values survive.
            .Set("style", "position:fixed;top:0;left:0;visibility:hidden");

        // Reference a title/description only when one is actually rendered - a dangling aria-labelledby/
        // describedby is worse than none (see AriaNameRegistry).
        if (_aria.HasTitle) props.Aria("labelledby", Popover?.TitleId);
        if (_aria.HasDescription) props.Aria("describedby", Popover?.DescriptionId);

        return props.Merge(Attributes, Class, Style);
    }

    // Escape is an implicit dismissal. (Outside pointer-down is handled by the dismissable layer.)
    private Task OnKeyDownAsync(KeyboardEventArgs e) =>
        e.Key == "Escape" && Popover is not null ? Popover.SetOpen.InvokeAsync(false) : Task.CompletedTask;

    // The panel is a dialog, and a dialog needs an accessible name. Warn (a dev aid) when neither a
    // BasePopoverTitle nor a consumer-supplied aria-label/aria-labelledby is present once rendered.
    [ExcludeFromCodeCoverage] // JS-interop seam: a no-op under bUnit's loose interop, verified in-browser.
    private async Task WarnIfUnnamedAsync()
    {
        if (_aria.HasTitle || HasConsumerName()) return;
        try
        {
            await Js.InvokeVoidAsync("console.warn",
                "Blaizio Popover: add a PopoverTitle (visually hidden if needed) or an aria-label on the " +
                "content so screen readers can announce the dialog.");
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone.
        }
    }

    private bool HasConsumerName() =>
        Attributes is not null && (Attributes.ContainsKey("aria-label") || Attributes.ContainsKey("aria-labelledby"));

    [ExcludeFromCodeCoverage] // JS-interop seam: a no-op under bUnit's loose interop, verified in-browser.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_present) return;

        // Guards claimed synchronously before any await: OnAfterRenderAsync re-enters on every render,
        // and a slow module import must not let a second pass create twice.
        _presenceTask ??= CreatePresenceAsync();
        _positioningTask ??= CreatePositioningAsync();
        _dismissTask ??= CreateDismissableLayerAsync();

        if (!_ariaChecked)
        {
            _ariaChecked = true;
            await WarnIfUnnamedAsync();
        }

        if (_closing)
        {
            // No-animation skins report back immediately; otherwise animationend does.
            var presence = await _presenceTask;
            await presence.InvokeVoidAsync("onClosing");
        }
    }

    [ExcludeFromCodeCoverage]
    private async Task<IJSObjectReference> CreatePresenceAsync()
    {
        _selfRef ??= DotNetObjectReference.Create(this);
        _presenceModule ??= await Js.InvokeAsync<IJSObjectReference>(
            "import", "./_content/blaizio.base/dist/presence.js");
        return await _presenceModule.InvokeAsync<IJSObjectReference>("createPresence", _element, _selfRef);
    }

    [ExcludeFromCodeCoverage]
    private async Task<IJSObjectReference> CreatePositioningAsync()
    {
        _selfRef ??= DotNetObjectReference.Create(this);
        _positioningModule ??= await Js.InvokeAsync<IJSObjectReference>(
            "import", "./_content/blaizio.base/dist/positioning.js");

        var options = new
        {
            side = Side.ToAttribute(),
            align = Align.ToAttribute(),
            sideOffset = SideOffset,
            alignOffset = AlignOffset,
            collisionPadding = 8,
            inline = Inline,
        };
        var anchorSelector = $"[data-bz-popover-anchor='{Popover?.AnchorId}']";

        return await _positioningModule.InvokeAsync<IJSObjectReference>(
            "createPositioning", anchorSelector, _element, options, _selfRef);
    }

    [ExcludeFromCodeCoverage]
    private async Task<IJSObjectReference> CreateDismissableLayerAsync()
    {
        _selfRef ??= DotNetObjectReference.Create(this);
        _dismissModule ??= await Js.InvokeAsync<IJSObjectReference>(
            "import", "./_content/blaizio.base/dist/dismissableLayer.js");

        var options = new
        {
            // A press on the trigger is not "outside" - the trigger toggles itself (no double-close).
            anchorSelector = $"[data-bz-popover-anchor='{Popover?.AnchorId}']",
            dismissOnEscape = false, // Escape is handled in C# OnKeyDownAsync, like BaseDialogContent.
        };
        return await _dismissModule.InvokeAsync<IJSObjectReference>(
            "createDismissableLayer", _element, _selfRef, options);
    }

    /// <summary>Called by the positioning module when the resolved placement flips.</summary>
    [JSInvokable]
    public void OnPlaced(string side, string align)
    {
        if (_side == side && _align == align) return;
        _side = side;
        _align = align;
        StateHasChanged();
    }

    /// <summary>Called by the dismissable layer on an outside pointer-down.</summary>
    [JSInvokable]
    public Task OnDismissRequested() =>
        Popover is null ? Task.CompletedTask : Popover.SetOpen.InvokeAsync(false);

    [JSInvokable]
    public async Task OnCloseFinished()
    {
        if (!_closing) return;
        _present = false;
        _closing = false;
        // Order matters: drop the global pointer-down listener first, then stop the positioning loop,
        // then the presence listeners; unmounting last lets BaseFocusScope return focus to the trigger.
        await DisposeDismissAsync();
        await DisposePositioningAsync();
        await DisposePresenceAsync();
        StateHasChanged();
        await OnExitComplete.InvokeAsync();
    }

    [ExcludeFromCodeCoverage]
    private async Task DisposeDismissAsync()
    {
        // Claimed synchronously before any await: the close-finish callback and the component's
        // DisposeAsync can race here (a navigation disposes the component mid close-animation) -
        // the second caller must see null and no-op instead of double-disposing the JS reference.
        var task = _dismissTask;
        _dismissTask = null;
        if (task is null) return;
        try
        {
            var dismiss = await task;
            await dismiss.InvokeVoidAsync("dispose");
            await dismiss.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone.
        }
        catch (ObjectDisposedException)
        {
            // Already disposed by the concurrent caller.
        }
    }

    [ExcludeFromCodeCoverage]
    private async Task DisposePositioningAsync()
    {
        var task = _positioningTask;
        _positioningTask = null;
        if (task is null) return;
        try
        {
            var positioning = await task;
            await positioning.InvokeVoidAsync("dispose");
            await positioning.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone.
        }
        catch (ObjectDisposedException)
        {
            // Already disposed by the concurrent caller.
        }
    }

    [ExcludeFromCodeCoverage]
    private async Task DisposePresenceAsync()
    {
        var task = _presenceTask;
        _presenceTask = null;
        if (task is null) return;
        try
        {
            var presence = await task;
            await presence.InvokeVoidAsync("dispose");
            await presence.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone.
        }
        catch (ObjectDisposedException)
        {
            // Already disposed by the concurrent caller.
        }
    }

    [ExcludeFromCodeCoverage]
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            await DisposeDismissAsync();
            await DisposePositioningAsync();
            await DisposePresenceAsync();
            if (_dismissModule is not null) await _dismissModule.DisposeAsync();
            if (_positioningModule is not null) await _positioningModule.DisposeAsync();
            if (_presenceModule is not null) await _presenceModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone.
        }
        catch (ObjectDisposedException)
        {
            // Already disposed by the racing close-finish callback.
        }

        _selfRef?.Dispose();
    }
}
