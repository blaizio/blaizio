@namespace Blaizio
@inherits BzComponentBase
@implements IDisposable
@*
    The accessible description of a BasePopover - a <p> the content's aria-describedby points at.
    Optional; the content wires aria-describedby only while this is rendered (it registers its
    presence below) so the reference never dangles.
*@

<BasePrimitive Element="p" Attributes="BuildAttributes()" ChildContent="@ChildContent" />

@code {
    /// <summary>Description text.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private PopoverContext? Popover { get; set; }
    [CascadingParameter] private AriaNameRegistry? Aria { get; set; }

    // Tell the content a description is present, so aria-describedby points at an element that exists.
    protected override void OnInitialized() => Aria?.SetDescription(true);

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Set("id", Popover?.DescriptionId)
            .Merge(Attributes, Class, Style);

    public void Dispose() => Aria?.SetDescription(false);
}
