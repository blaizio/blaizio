@namespace Blaizio
@inherits BzComponentBase
@*
    The panel for one tab: role="tabpanel" + aria-labelledby (its
    trigger's id) + tabindex="0" (so panel content is reachable right after the tablist; the tabs
    root's PanelFocusable=false drops it), rendered only while its tab is selected (the
    no-animation equivalent, rendered only while open/selected).
*@

@if (Selected)
{
    <BasePrimitive Element="div" Attributes="BuildAttributes()" ChildContent="@ChildContent" />
}

@code {
    /// <summary>The value identifying this panel (matches a <see cref="BaseTabsTrigger"/>). Required.</summary>
    [Parameter] public string Value { get; set; } = default!;

    /// <summary>Panel content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private TabsContext? Tabs { get; set; }

    private bool Selected => Tabs?.IsSelected(Value) ?? false;

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Set("role", "tabpanel")
            .Set("id", Tabs?.ContentId(Value))
            .Aria("labelledby", Tabs?.TriggerId(Value))
            .Set("tabindex", Tabs?.PanelFocusable ?? true ? "0" : null)
            .Data("state", "active")
            .Data("orientation", (Tabs?.Orientation ?? Orientation.Horizontal).ToAttribute())
            .Merge(Attributes, Class, Style);
}
