@namespace Blaizio
@inherits BzComponentBase
@inject IJSRuntime Js
@*
    The strip of tab triggers: role="tablist" + aria-orientation over a
    BaseRovingFocusGroup (arrow-key navigation + roving tabindex). With the group's ActivationMode
    Automatic, selection follows focus (arrowing clicks the focused trigger); Manual leaves
    activation to Enter/Space.
*@

<BaseRovingFocusGroup Orientation="@(Tabs?.Orientation ?? Orientation.Horizontal)"
                       Loop="@Loop"
                       SelectOnFocus="@(Tabs?.ActivationMode == TabsActivationMode.Automatic)"
                       Attributes="BuildAttributes()"
                       Class="@Class"
                       Style="@Style">
    @ChildContent
</BaseRovingFocusGroup>

@code {
    /// <summary>Wrap navigation at the ends. Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool Loop { get; set; } = true;

    /// <summary>Accessible name for the tab strip (what the tabs switch between, e.g. "Account settings").</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Id of the element that names the strip (takes precedence over <see cref="AriaLabel"/>, per ARIA).</summary>
    [Parameter] public string? AriaLabelledBy { get; set; }

    /// <summary>The tab triggers.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private TabsContext? Tabs { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder()
            .Set("role", "tablist")
            .Aria("label", AriaLabel)
            .Aria("labelledby", AriaLabelledBy)
            .Aria("orientation", (Tabs?.Orientation ?? Orientation.Horizontal).ToAttribute())
            .Merge(Attributes);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !AriaDiagnostics.HasName(AriaLabel, AriaLabelledBy, Attributes))
            await AriaDiagnostics.WarnUnnamedAsync(Js, "TabsList");
    }
}
