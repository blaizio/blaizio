@namespace Blaizio
@inject IServiceProvider Services
@implements IDisposable
@*
    Groups the tooltips inside it so they share a delay and a "skip delay" window: once one tooltip
    has opened, moving the pointer to another trigger in the group opens it immediately (no hover
    delay) until SkipDelayDuration ms after the last one closes. Renders no element of its own, and
    is optional - a BaseTooltip works without a provider (it just always waits its own delay).
*@

<CascadingValue Value="@_context" IsFixed="true">
    @ChildContent
</CascadingValue>

@code {
    /// <summary>Default hover delay (ms) for tooltips in this group. A tooltip's own DelayDuration overrides it. Unset inherits <see cref="BlaizioOptions"/> (400 out of the box).</summary>
    [Parameter] public int? DelayDuration { get; set; }

    /// <summary>How long (ms) after the last tooltip closes that the next still opens instantly. Unset inherits <see cref="BlaizioOptions"/> (300 out of the box).</summary>
    [Parameter] public int? SkipDelayDuration { get; set; }

    /// <summary>The tooltips.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private TooltipProviderContext _context = default!;

    protected override void OnInitialized()
    {
        var defaults = BlaizioOptions.Resolve(Services).Tooltip;
        _context = new TooltipProviderContext(
            DelayDuration ?? defaults.DelayDuration,
            SkipDelayDuration ?? defaults.SkipDelayDuration);
    }

    public void Dispose() => _context.Dispose();
}
