@namespace Blaizio
@inherits BzComponentBase
@inject IJSRuntime Js
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Web
@*
    The draggable boundary between two panels. role="separator" with aria-valuemin/max/now mirroring the
    panel before it. Pointer drag is wired by ts/resizable.js (it reports movement as a % of the group);
    Arrow keys (Home/End) resize from C#. Registers itself with the group so it knows which boundary it
    moves.
*@

<BasePrimitive Element="div"
                Attributes="BuildAttributes()"
                ChildContent="@ChildContent"
                ElementRefCaptured="@(r => _element = r)" />

@code {
    /// <summary>Disables the handle (not focusable, no drag).</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Accessible name for the handle (what it resizes, e.g. "Resize sidebar").</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Id of the element that names the handle (takes precedence over <see cref="AriaLabel"/>, per ARIA).</summary>
    [Parameter] public string? AriaLabelledBy { get; set; }

    /// <summary>Id of the primary panel this handle resizes (the APG window-splitter wiring).</summary>
    [Parameter] public string? AriaControls { get; set; }

    /// <summary>Optional handle content (e.g. a grip).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private BasePanelGroup? Group { get; set; }

    private ElementReference _element;
    private int _index = -1;
    private IJSObjectReference? _instance;
    private DotNetObjectReference<BaseResizeHandle>? _selfRef;

    private bool Horizontal => Group?.IsHorizontal ?? true;

    protected override void OnInitialized()
    {
        if (Group is not null) _index = Group.RegisterHandle();
    }

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var (min, max) = Group?.GetHandleBounds(_index) ?? (0, 100);
        var now = Group?.GetHandleValueNow(_index) ?? 0;
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        var props = new PropBuilder(this)
            .Data("slot", "resizable-handle")
            .Set("role", "separator")
            .Set("tabindex", Disabled ? "-1" : "0")
            .Aria("orientation", Horizontal ? "vertical" : "horizontal")
            .Aria("valuemin", ((int)System.Math.Round(min)).ToString(inv))
            .Aria("valuemax", ((int)System.Math.Round(max)).ToString(inv))
            .Aria("valuenow", ((int)System.Math.Round(now)).ToString(inv))
            .Aria("label", AriaLabel)
            .Aria("labelledby", AriaLabelledBy)
            .Aria("controls", AriaControls)
            .On("onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, KeyDown));
        if (Disabled) props.Data("disabled", "true");
        return props.Merge(Attributes, Class, Style);
    }

    private Task KeyDown(KeyboardEventArgs e)
    {
        if (Disabled || Group is null) return Task.CompletedTask;
        var step = Group.KeyboardStep;
        var delta = e.Key switch
        {
            "ArrowLeft" when Horizontal => -step,
            "ArrowRight" when Horizontal => step,
            "ArrowUp" when !Horizontal => -step,
            "ArrowDown" when !Horizontal => step,
            "Home" => -100,
            "End" => 100,
            _ => 0,
        };
        return delta == 0 ? Task.CompletedTask : Group.KeyResize(_index, delta);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Disabled) return;
        if (!AriaDiagnostics.HasName(AriaLabel, AriaLabelledBy, Attributes))
            await AriaDiagnostics.WarnUnnamedAsync(Js, "ResizeHandle");
        try
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            var module = await JsModules.ImportAsync(Js, "./_content/blaizio.base/dist/resizable.js");
            _instance = await module.InvokeAsync<IJSObjectReference>("createResizeHandle", _element, _selfRef, Horizontal);
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone.
        }
    }

    [JSInvokable] public void DragStart() => Group?.BeginResize();
    [JSInvokable] public Task OnDrag(double delta) => Group?.DragResize(_index, delta) ?? Task.CompletedTask;
    [JSInvokable] public Task DragEnd() => Group?.EndResize() ?? Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        try
        {
            // Instances only - the modules are shared via JsModules and outlive this component.
            if (_instance is not null) { await _instance.InvokeVoidAsync("dispose"); await _instance.DisposeAsync(); }
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone.
        }
        _selfRef?.Dispose();
    }
}
