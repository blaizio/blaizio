@namespace Blaizio
@inherits BzComponentBase
@*
    A single resizable panel. Registers itself with the enclosing BasePanelGroup (in document order) and
    takes a share of the group's space via flex-grow = its current size. Constraints (min/max/collapsible)
    are percentages of the group.
*@

<BasePrimitive As="div" Attributes="BuildAttributes()" ChildContent="@ChildContent" />

@code {
    /// <summary>Stable id (auto-generated when omitted).</summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>The size the panel starts at (percentage). Omit to share the remaining space equally.</summary>
    [Parameter] public double? DefaultSize { get; set; }

    /// <summary>Smallest size the panel can be dragged to. Defaults to 10.</summary>
    [Parameter] public double MinSize { get; set; } = 10;

    /// <summary>Largest size the panel can be dragged to. Defaults to 100.</summary>
    [Parameter] public double MaxSize { get; set; } = 100;

    /// <summary>Whether dragging past <see cref="MinSize"/> collapses the panel to <see cref="CollapsedSize"/>.</summary>
    [Parameter] public bool Collapsible { get; set; }

    /// <summary>The size a collapsible panel snaps to when collapsed. Defaults to 0.</summary>
    [Parameter] public double CollapsedSize { get; set; }

    /// <summary>The panel content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private BasePanelGroup? Group { get; set; }

    private PanelInfo? _info;

    protected override void OnInitialized()
    {
        if (Group is null) return;
        _info = new PanelInfo
        {
            Id = Id ?? System.Guid.NewGuid().ToString("n"),
            DefaultSize = DefaultSize,
            MinSize = MinSize,
            MaxSize = MaxSize,
            Collapsible = Collapsible,
            CollapsedSize = CollapsedSize,
        };
        Group.RegisterPanel(_info);
    }

    protected override void OnParametersSet()
    {
        if (_info is null) return;
        _info.MinSize = MinSize;
        _info.MaxSize = MaxSize;
        _info.Collapsible = Collapsible;
        _info.CollapsedSize = CollapsedSize;
    }

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var size = _info?.Size ?? DefaultSize ?? 0;
        var sizeText = size.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);
        var props = new PropBuilder(this)
            .Data("slot", "resizable-panel")
            .Data("panel-size", ((int)System.Math.Round(size)).ToString(System.Globalization.CultureInfo.InvariantCulture))
            .Data("collapsed", _info?.IsCollapsed == true ? "true" : null);
        return props.Merge(Attributes, Class, $"flex:{sizeText} 1 0px;overflow:hidden;{Style}");
    }
}
