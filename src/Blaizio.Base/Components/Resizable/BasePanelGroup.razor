@namespace Blaizio
@inherits BzComponentBase
@*
    Headless resizable panel group. Lays its BasePanel children out along Orientation (flex row/column),
    each panel taking a share of the space via flex-grow = its size (a percentage). A BaseResizeHandle
    between two panels drags the boundary: the handle reports how far the pointer moved as a % of the
    group, and the group moves that much from one neighbour to the other, honouring each panel's
    min/max (and collapsing a collapsible panel dragged past its min). Pure layout - the look is the
    styled layer's job. Cascades itself so panels and handles can register and read their state.
*@

<CascadingValue Value="this" IsFixed="true">
    <BasePrimitive Element="div" Attributes="BuildAttributes()" ChildContent="@ChildContent" />
</CascadingValue>

@code {
    /// <summary>The axis to lay panels out along. Defaults to <see cref="Orientation.Horizontal"/>.</summary>
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Horizontal;

    /// <summary>How much (percentage points) an arrow-key press resizes by. Defaults to 10.</summary>
    [Parameter] public double KeyboardStep { get; set; } = 10;

    /// <summary>Raised with every panel's size whenever the layout changes (drag or keyboard).</summary>
    [Parameter] public EventCallback<IReadOnlyList<double>> OnLayout { get; set; }

    /// <summary>The panels and handles.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private readonly List<PanelInfo> _panels = new();
    // Handle i sits just after this panel (and before the next one in _panels). Held by reference,
    // not by index: panels can leave, and an index would then point at a different panel. A slot is
    // null once its handle is gone - slots are never removed, so the index a handle holds stays its.
    private readonly List<PanelInfo?> _handlePanel = new();
    private double[] _snapshot = System.Array.Empty<double>();
    private bool _initialized;

    /// <summary>
    /// Raised after the panel sizes change (initial seeding, drag, keyboard). The group re-rendering
    /// only reaches children through ChildContent, so a handle (or an empty panel) whose own
    /// parameters didn't change would keep its first-render aria-valuenow / flex size; they
    /// subscribe and re-render themselves.
    /// </summary>
    public event Action? LayoutChanged;

    /// <summary>
    /// Whether the panel sizes have been seeded. False for the first render and for a statically
    /// rendered page (seeding happens after render), when panels lay out from their declared sizes.
    /// </summary>
    public bool IsSeeded => _initialized;

    /// <summary>Whether the group lays out (and resizes) along the inline axis.</summary>
    public bool IsHorizontal => Orientation == Orientation.Horizontal;

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder(this)
            .Data("slot", "resizable-panel-group")
            .Data("direction", IsHorizontal ? "horizontal" : "vertical")
            .Merge(Attributes, Class, Style);

    /// <summary>
    /// A panel registers itself (in document order) and gets its index. A panel that appears after
    /// the sizes were seeded (it is rendered conditionally) takes its <c>DefaultSize</c>, or an equal
    /// share, out of the others; it joins at the end of the order, whatever its place in the markup.
    /// </summary>
    public int RegisterPanel(PanelInfo info)
    {
        _panels.Add(info);
        if (_initialized) MakeRoomFor(info);
        return _panels.Count - 1;
    }

    /// <summary>
    /// A panel that is going away hands its space to the ones that stay, in proportion to their
    /// sizes. Without this it stayed registered: its share was never given back, and the handle
    /// beside it kept moving space into a panel that was no longer on the page.
    /// </summary>
    public void UnregisterPanel(PanelInfo info)
    {
        var index = _panels.IndexOf(info);
        if (index < 0) return;
        _panels.RemoveAt(index);

        // A handle that sat after the departed panel now sits after the one before it.
        var previous = index > 0 ? _panels[index - 1] : null;
        for (var i = 0; i < _handlePanel.Count; i++)
            if (ReferenceEquals(_handlePanel[i], info)) _handlePanel[i] = previous;

        if (!_initialized || _panels.Count == 0) return;
        Normalize(_panels, 100);
        NotifyLayout();
    }

    /// <summary>A handle registers itself; it sits just after the most recently registered panel.</summary>
    public int RegisterHandle()
    {
        _handlePanel.Add(_panels.Count > 0 ? _panels[^1] : null);
        return _handlePanel.Count - 1;
    }

    /// <summary>A handle that is going away gives up its slot (the other handles keep their indices).</summary>
    public void UnregisterHandle(int handleIndex)
    {
        if (handleIndex >= 0 && handleIndex < _handlePanel.Count) _handlePanel[handleIndex] = null;
    }

    // The index in _panels of the panel just before a handle, or -1 when the handle has none.
    private int PanelBefore(int handleIndex) =>
        handleIndex >= 0 && handleIndex < _handlePanel.Count && _handlePanel[handleIndex] is { } panel
            ? _panels.IndexOf(panel)
            : -1;

    // Size a late arrival and shrink the others to fit beside it.
    private void MakeRoomFor(PanelInfo info)
    {
        var others = _panels.Where(p => !ReferenceEquals(p, info)).ToList();
        var wanted = info.DefaultSize ?? 100.0 / _panels.Count;
        info.Size = System.Math.Clamp(wanted, info.Collapsible ? info.CollapsedSize : info.MinSize, System.Math.Min(info.MaxSize, 100));
        Normalize(others, 100 - info.Size);
        NotifyLayout();
    }

    // Scale panels so their sizes add up to total, keeping their proportions.
    private static void Normalize(IReadOnlyList<PanelInfo> panels, double total)
    {
        if (panels.Count == 0) return;
        var sum = panels.Sum(p => p.Size);
        foreach (var p in panels)
            p.Size = sum > 0 ? p.Size / sum * total : total / panels.Count;
    }

    private void NotifyLayout()
    {
        StateHasChanged();
        LayoutChanged?.Invoke();
    }

    /// <summary>The current size of a panel (for a handle's aria-valuenow).</summary>
    public double GetPanelSize(int index) => index >= 0 && index < _panels.Count ? _panels[index].Size : 0;

    /// <summary>The min/max of the panel just before a handle (for aria-valuemin/max).</summary>
    public (double Min, double Max) GetHandleBounds(int handleIndex)
    {
        var a = PanelBefore(handleIndex);
        return a >= 0 ? (_panels[a].MinSize, _panels[a].MaxSize) : (0, 100);
    }

    /// <summary>The size of the panel just before a handle (for aria-valuenow).</summary>
    public double GetHandleValueNow(int handleIndex)
    {
        return GetPanelSize(PanelBefore(handleIndex));
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) EnsureInitialized();
    }

    /// <summary>Seed the panel sizes once all panels have registered (idempotent). Called from the group's
    /// first after-render; safe to call again.</summary>
    public void EnsureInitialized()
    {
        if (_initialized || _panels.Count == 0) return;
        _initialized = true;
        InitSizes();
        StateHasChanged();
        LayoutChanged?.Invoke();
    }

    // Seed each panel's size: from DefaultSize, sharing the remainder equally among the rest, then
    // normalise to 100 and clamp to each panel's bounds.
    private void InitSizes()
    {
        var explicitSum = _panels.Where(p => p.DefaultSize is not null).Sum(p => p.DefaultSize!.Value);
        var nullCount = _panels.Count(p => p.DefaultSize is null);
        var remaining = System.Math.Max(0, 100 - explicitSum);
        foreach (var p in _panels)
            p.Size = p.DefaultSize ?? (nullCount > 0 ? remaining / nullCount : 0);

        var total = _panels.Sum(p => p.Size);
        if (total > 0)
            foreach (var p in _panels)
                p.Size = p.Size / total * 100;

        foreach (var p in _panels)
            p.Size = System.Math.Clamp(p.Size, p.Collapsible ? p.CollapsedSize : p.MinSize, p.MaxSize);
    }

    /// <summary>Snapshot the sizes a drag starts from.</summary>
    public void BeginResize() => _snapshot = _panels.Select(p => p.Size).ToArray();

    /// <summary>Apply a drag: move <paramref name="totalDelta"/>% across the boundary at <paramref name="handleIndex"/> (from the snapshot).</summary>
    public Task DragResize(int handleIndex, double totalDelta)
    {
        var a = PanelBefore(handleIndex);
        var b = a + 1;
        if (a < 0 || b >= _panels.Count || _snapshot.Length != _panels.Count) return Task.CompletedTask;

        var pa = _panels[a];
        var pb = _panels[b];
        var pair = _snapshot[a] + _snapshot[b]; // conserved between the two neighbours

        var newA = ClampPanel(pa, _snapshot[a] + totalDelta);
        var newB = ClampPanel(pb, pair - newA);
        newA = pair - newB; // keep the pair sum exact after b's clamp

        pa.Size = newA;
        pb.Size = newB;
        StateHasChanged();
        LayoutChanged?.Invoke();
        return OnLayout.InvokeAsync(_panels.Select(p => p.Size).ToList());
    }

    /// <summary>End of a drag - emit the final layout.</summary>
    public Task EndResize() => OnLayout.InvokeAsync(_panels.Select(p => p.Size).ToList());

    /// <summary>A one-shot keyboard resize at a handle (snapshots, applies, ends).</summary>
    public Task KeyResize(int handleIndex, double delta)
    {
        BeginResize();
        return DragResize(handleIndex, delta);
    }

    // Clamp a target size to a panel's bounds, snapping a collapsible panel to collapsed-or-min when
    // the target falls between them (so dragging a panel small enough collapses it).
    private static double ClampPanel(PanelInfo p, double value)
    {
        if (p.Collapsible)
        {
            if (value < p.MinSize)
                value = value < (p.CollapsedSize + p.MinSize) / 2 ? p.CollapsedSize : p.MinSize;
            return System.Math.Clamp(value, p.CollapsedSize, p.MaxSize);
        }
        return System.Math.Clamp(value, p.MinSize, p.MaxSize);
    }
}
