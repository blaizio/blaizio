@namespace Blaizio
@inherits BzComponentBase
@*
    A progress bar:
      • role="progressbar" with aria-valuemin=0 / aria-valuemax=Max / aria-valuenow=Value,
      • aria-valuetext carries a human label (e.g. "60%"),
      • data-state is "indeterminate" (Value null) / "complete" (Value == Max) / "loading",
      • data-value and data-max expose the raw numbers for the styled layer.
    Value is clamped to [0, Max]; a null Value means indeterminate (aria-valuenow/data-value omitted).
    The fill is rendered either by the parent-owned Indicator fragment (preferred - receives the
    state directly, no cascade and no extra component; rendered BEFORE ChildContent so an overlay
    label sits above it) or by a nested BaseProgressIndicator reading the cascaded ProgressContext
    (the composition path; the cascade only exists when no fragment is given). Headless: no
    track/fill styling - the styled layer owns the bar's look and the fill transform.
*@

@if (Indicator is not null)
{
    <BasePrimitive Element="div" Attributes="BuildAttributes()" RenderAs="@RenderAs">
        @Indicator(Context)
        @ChildContent
    </BasePrimitive>
}
else
{
    <CascadingValue Value="@Context" IsFixed="false">
        <BasePrimitive Element="div"
                        Attributes="BuildAttributes()"
                        ChildContent="@ChildContent"
                        RenderAs="@RenderAs" />
    </CascadingValue>
}

@code {
    /// <summary>The current value. <see langword="null"/> renders an indeterminate bar.</summary>
    [Parameter] public double? Value { get; set; }

    /// <summary>The maximum value (the 100% point). Defaults to <c>100</c>.</summary>
    [Parameter] public double Max { get; set; } = 100;

    /// <summary>Layout axis, exposed as <c>data-orientation</c>. Defaults to <see cref="Blaizio.Orientation.Horizontal"/>.</summary>
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Horizontal;

    /// <summary>Inner content - an overlay label, or a <see cref="BaseProgressIndicator"/> on the
    /// composition path.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// The fill, rendered by THIS bar before <see cref="ChildContent"/> with the current state as
    /// context. Preferred over a nested BaseProgressIndicator: no cascading context and one
    /// component less. When set, no context is cascaded.
    /// </summary>
    [Parameter] public RenderFragment<ProgressContext>? Indicator { get; set; }

    /// <summary>Render the behaviour onto your own element instead of a <c>&lt;div&gt;</c>.</summary>
    [Parameter] public RenderFragment<BzRenderProps>? RenderAs { get; set; }

    private double EffectiveMax => Max > 0 ? Max : 100;
    private double? Clamped => Value is null ? null : Math.Clamp(Value.Value, 0, EffectiveMax);

    private ProgressContext Context => new(Clamped, EffectiveMax, Orientation);

    private string State =>
        Clamped is null ? "indeterminate" : Clamped.Value >= EffectiveMax ? "complete" : "loading";

    private static string Fmt(double d) => d.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder()
            .Set("role", "progressbar")
            .Aria("valuemin", "0")
            .Aria("valuemax", Fmt(EffectiveMax))
            .Data("state", State)
            .Data("orientation", Orientation.ToAttribute())
            .Data("max", Fmt(EffectiveMax));

        if (Clamped is not null)
        {
            var percent = (int)Math.Round(Clamped.Value / EffectiveMax * 100);
            props.Aria("valuenow", Fmt(Clamped.Value))
                 .Aria("valuetext", $"{percent}%")
                 .Data("value", Fmt(Clamped.Value));
        }

        return props.Merge(Attributes, Class, Style);
    }
}
