@namespace Blaizio
@inherits BzComponentBase
@*
    A tri-state checkbox:
      • renders a native <button type="button" role="checkbox">,
      • aria-checked is "mixed" when indeterminate, else "true"/"false",
      • data-state is "checked"/"unchecked"/"indeterminate" for the styled layer,
      • data-disabled is emitted when disabled,
      • clicking advances the state: indeterminate → checked, otherwise it flips.
    Controllable via Checked/DefaultChecked/CheckedChanged, bridged by ControllableState - works with
    @bind-Checked (controlled) or standalone with DefaultChecked (uncontrolled). State is cascaded as a
    CheckboxContext so a nested BaseCheckboxIndicator can show/hide itself with zero wiring.

    Deviations, both deliberate: native form-submission (the hidden bubble <input>) is
    omitted - Blazor state flows through @bind-Checked; and Enter-key suppression is omitted - a native
    <button> activates on Enter as well as Space, and conditional preventDefault isn't expressible from
    a splatted handler without JS. Space still toggles, matching the primary expectation.
*@

<CascadingValue Value="@Context" IsFixed="false">
    <BasePrimitive As="button"
                    Attributes="@BuildAttributes()"
                    ChildContent="@ChildContent"
                    RenderAs="@RenderAs" />
</CascadingValue>

@code {
    /// <summary>Controlled state. Leave <see langword="null"/> for uncontrolled (see <see cref="DefaultChecked"/>).</summary>
    [Parameter] public CheckedState? Checked { get; set; }

    /// <summary>Initial state when uncontrolled. Defaults to <see cref="CheckedState.Unchecked"/>.</summary>
    [Parameter] public CheckedState DefaultChecked { get; set; } = CheckedState.Unchecked;

    /// <summary>Raised with the new state whenever it changes. Enables <c>@bind-Checked</c>.</summary>
    [Parameter] public EventCallback<CheckedState> CheckedChanged { get; set; }

    /// <summary>Disables the checkbox (blocks interaction; emits <c>data-disabled</c>).</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Inner content - typically a single <see cref="BaseCheckboxIndicator"/>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the behaviour onto your own element instead of a <c>&lt;button&gt;</c>.</summary>
    [Parameter] public RenderFragment<BzRenderProps>? RenderAs { get; set; }

    private readonly ControllableState<CheckedState> _state = new();

    private CheckboxContext Context => new(_state.Value, Disabled);

    protected override void OnParametersSet() =>
        _state.Sync(Checked.HasValue, Checked ?? CheckedState.Unchecked, DefaultChecked);

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var state = _state.Value;
        var props = new PropBuilder(this)
            .Set("role", "checkbox")
            .Aria("checked", state == CheckedState.Indeterminate ? "mixed" : state == CheckedState.Checked ? "true" : "false")
            .Data("state", state.ToAttribute())
            .On("onclick", EventCallback.Factory.Create(this, OnClickAsync));

        if (RenderAs is null)
        {
            props.Set("type", "button").Flag("disabled", Disabled);
        }
        else if (Disabled)
        {
            props.Aria("disabled", true);
        }

        if (Disabled) props.Data("disabled", "");

        return props.Merge(Attributes, Class, Style);
    }

    // Indeterminate resolves to checked; otherwise toggle.
    private Task OnClickAsync()
    {
        if (Disabled) return Task.CompletedTask;
        var next = _state.Value == CheckedState.Checked ? CheckedState.Unchecked : CheckedState.Checked;
        return _state.SetAsync(next, CheckedChanged);
    }
}
