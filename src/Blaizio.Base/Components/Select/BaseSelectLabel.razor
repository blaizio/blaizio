@namespace Blaizio
@inherits BzComponentBase
@* A non-interactive caption for a group of options. Not an option, so navigation skips it. *@

<BasePrimitive As="div" Attributes="BuildAttributes()" ChildContent="@ChildContent" />

@code {
    /// <summary>Label content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder(this).Merge(Attributes, Class, Style);
}
