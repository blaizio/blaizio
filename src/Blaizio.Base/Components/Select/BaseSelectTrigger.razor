@namespace Blaizio
@inherits BzComponentBase
@*
    The button that opens a BaseSelect's listbox: a native <button type="button"> with role="combobox".
    A pointer click toggles the listbox; ArrowDown / ArrowUp open it (Enter / Space activate the button
    as a click, which also opens). However it opens, the listbox places focus on the SELECTED option
    (or the first), so navigation continues from the current choice. Carries
    aria-haspopup="listbox"/-expanded/-controls + data-state, data-placeholder while nothing is
    selected, and the data-bz-select-anchor hook the content positions + dismisses against. RenderAs
    lets it wrap your own element.
*@

<BasePrimitive As="button"
                Attributes="BuildAttributes()"
                ChildContent="@ChildContent"
                RenderAs="@RenderAs" />

@code {
    /// <summary>Trigger content - usually a <see cref="BaseSelectValue"/> plus an icon.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the behaviour onto your own element instead of a <c>&lt;button&gt;</c>.</summary>
    [Parameter] public RenderFragment<BzRenderProps>? RenderAs { get; set; }

    [CascadingParameter] private SelectContext? Select { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var open = Select?.Open ?? false;
        var props = new PropBuilder(this)
            .Set("id", Select?.TriggerId)
            .Data("bz-select-anchor", Select?.AnchorId)
            .Set("role", "combobox")
            .Aria("haspopup", "listbox")
            .Aria("expanded", open)
            .Aria("controls", Select?.ContentId)
            .Data("state", open ? "open" : "closed")
            .On("onclick", EventCallback.Factory.Create<MouseEventArgs>(this, OnClickAsync))
            .On("onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, OnKeyDownAsync));

        // No selection yet: a hook for the skin to grey the placeholder text.
        if (!(Select?.HasSelection ?? false)) props.Data("placeholder", "");
        if (Select?.Multiple == true) props.Data("multiple", "");
        if (RenderAs is null) props.Set("type", "button");

        return props.Merge(Attributes, Class, Style);
    }

    // A pointer click toggles; Enter / Space activate the button as a click too and open when closed.
    private Task OnClickAsync(MouseEventArgs e)
    {
        if (Select is null) return Task.CompletedTask;
        return Select.Open ? Select.RequestClose.InvokeAsync() : Select.RequestOpen.InvokeAsync();
    }

    // Arrow keys open the listbox (focus lands on the selected option). ts/menu.js's guardTrigger
    // preventDefaults them so the page doesn't scroll first; once open, ts/menu.js owns navigation.
    private Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (Select is null || Select.Open) return Task.CompletedTask;
        return e.Key is "ArrowDown" or "ArrowUp" ? Select.RequestOpen.InvokeAsync() : Task.CompletedTask;
    }
}
