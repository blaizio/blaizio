@namespace Blaizio
@inherits BzComponentBase
@inject IJSRuntime Js
@implements IAsyncDisposable
@using System.Diagnostics.CodeAnalysis
@*
    The listbox surface of a BaseSelect: a role="listbox" of options, anchored to the trigger via
    ts/positioning.js, navigated by ts/menu.js (Arrow / Home / End / typeahead / Enter / Space - it
    opens with the SELECTED option focused and scrolled into view), and dismissed by Escape, Tab, an
    outside pointer-down (ts/dismissableLayer.js), or picking an option. Non-modal like the
    popover/dropdown: no overlay, no scroll lock, the outside press passes through.

    Unlike a menu, the options stay MOUNTED while the listbox is closed (the surface is just
    `hidden`), so each option keeps its display content registered with the root - that is how the
    trigger shows a value chosen before the listbox has ever been opened. Only the open behaviour
    (positioning, navigation, dismissal) is attached on open and torn down on close.
*@

<div @ref="_element" @attributes="BuildAttributes()">
    @ChildContent
</div>

@code {
    /// <summary>Listbox content (options, labels, separators, groups).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Preferred side of the trigger. Flips to stay in view. Defaults to <see cref="Blaizio.Side.Bottom"/>.</summary>
    [Parameter] public Side Side { get; set; } = Side.Bottom;

    /// <summary>Alignment along the trigger's edge. Defaults to <see cref="Blaizio.Align.Start"/>.</summary>
    [Parameter] public Align Align { get; set; } = Align.Start;

    /// <summary>Gap in pixels between the trigger and the content. Defaults to 4.</summary>
    [Parameter] public double SideOffset { get; set; } = 4;

    /// <summary>Offset in pixels along the alignment axis. Defaults to 0.</summary>
    [Parameter] public double AlignOffset { get; set; }

    /// <summary>How the listbox is placed relative to the trigger. Defaults to <see cref="SelectPosition.Popper"/>.</summary>
    [Parameter] public SelectPosition Position { get; set; } = SelectPosition.Popper;

    /// <summary>
    /// Arrow navigation wraps at the ends (past the last option returns to the first). Defaults to
    /// <see langword="true"/>; set <see langword="false"/> to stop at the first/last option instead.
    /// </summary>
    [Parameter] public bool Loop { get; set; } = true;

    /// <summary>
    /// Render the listbox in place instead of moving it to the document body while open. By default
    /// the surface portals to the body so no ancestor stacking context or overflow clip can cover
    /// it; set <see langword="true"/> to keep it inside its parent DOM (useful under CSS containment,
    /// for print, or in tests that assert on local markup).
    /// </summary>
    [Parameter] public bool Inline { get; set; }

    /// <summary>Raised after the exit animation finishes and the listbox is hidden again.</summary>
    [Parameter] public EventCallback OnExitComplete { get; set; }

    [CascadingParameter] private SelectContext? Select { get; set; }

    // _present: in the DOM and shown (open, or animating closed). The surface element is ALWAYS
    // rendered (so options register); _present only toggles its `hidden` + the open behaviour.
    private bool _present;
    private bool _closing;
    private string _side = "bottom";
    private string _align = "start";
    private ElementReference _element;
    private IJSObjectReference? _presenceModule;
    private IJSObjectReference? _positioningModule;
    private IJSObjectReference? _dismissModule;
    private IJSObjectReference? _menuModule;
    private Task<IJSObjectReference>? _presenceTask;
    private Task<IJSObjectReference>? _positioningTask;
    private Task<IJSObjectReference>? _dismissTask;
    private Task<IJSObjectReference>? _menuTask;
    private DotNetObjectReference<BaseSelectContent>? _selfRef;

    private string AnchorSelector => $"[data-bz-select-anchor='{Select?.AnchorId}']";

    protected override void OnParametersSet()
    {
        // Report our positioning mode up so the trigger can match its chevron (up/down for item-aligned,
        // a rotating chevron-down for popper). Guarded in the root, so this static report doesn't loop.
        Select?.SetPosition(Position);

        var open = Select?.Open ?? false;

        if (open && (!_present || _closing))
        {
            _present = true;
            _closing = false;
        }
        else if (!open && _present && !_closing)
        {
            _closing = true;
        }
    }

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder(this)
            .Set("role", "listbox")
            // Focusable surface: ts/menu.js clears the hover highlight (which IS :focus on an item)
            // by focusing the container - menus get this from their FocusScope, the select has none,
            // and focus() on a non-focusable div silently no-ops, leaving the last item lit.
            .Set("tabindex", "-1")
            .Set("id", Select?.ContentId)
            .Aria("labelledby", Select?.TriggerId)
            .Data("bz-menu-content", "")
            // Pre-positioned from the very first paint: fixed + invisible, so on open the listbox
            // never renders in flow (shifting the page) during the gap before ts/positioning.js
            // finishes importing and places it - noticeable on the first open after a cold load.
            // The module's placement writes over these inline values (visibility flips to visible
            // once the first position lands); Blazor never re-writes an unchanged style attribute,
            // so the JS-owned values survive re-renders.
            .Set("style", "position:fixed;top:0;left:0;visibility:hidden")
            // "open" only while actually open; a hidden (closed) or animating-out surface is "closed",
            // so the open animation re-triggers cleanly each time it is shown again.
            .Data("state", _present && !_closing ? "open" : "closed")
            .Data("side", _side)
            .Data("align", _align)
            // A portaled surface leaves any subtree direction provider's DOM ancestry, so the
            // cascaded direction is stamped on the element itself (inline keeps inheritance).
            .Set("dir", Inline ? DirAttribute : PortalDirAttribute)
            .On("onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, OnKeyDownAsync));

        // Closed (and not animating): keep the options in the DOM for registration, but hide them.
        if (!_present) props.Set("hidden", "hidden");

        return props.Merge(Attributes, Class, Style);
    }

    // Escape and Tab dismiss (vertical navigation + activation are owned by ts/menu.js).
    private Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (Select is null) return Task.CompletedTask;
        return e.Key is "Escape" or "Tab" ? Select.RequestClose.InvokeAsync() : Task.CompletedTask;
    }

    [ExcludeFromCodeCoverage] // JS-interop seam: a no-op under bUnit's loose interop, verified in-browser.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_present) return;

        // Guards claimed synchronously before any await: OnAfterRenderAsync re-enters on every render,
        // and a slow module import must not let a second pass attach twice.
        _presenceTask ??= CreatePresenceAsync();
        _positioningTask ??= CreatePositioningAsync();
        _menuTask ??= CreateMenuAsync();
        _dismissTask ??= CreateDismissableLayerAsync();

        if (_closing)
        {
            // No-animation skins report back immediately; otherwise animationend does. Guarded like
            // the dispose paths: a component torn down mid close-animation (its whole surface
            // swapped out, say) disposes the presence reference while this await is still pending,
            // and the resumed call would otherwise surface as an unhandled render exception.
            try
            {
                var presence = await _presenceTask;
                await presence.InvokeVoidAsync("onClosing");
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
        }
    }

    [ExcludeFromCodeCoverage]
    private async Task<IJSObjectReference> CreatePresenceAsync()
    {
        _selfRef ??= DotNetObjectReference.Create(this);
        _presenceModule ??= await Js.InvokeAsync<IJSObjectReference>(
            "import", "./_content/blaizio.base/dist/presence.js");
        return await _presenceModule.InvokeAsync<IJSObjectReference>("createPresence", _element, _selfRef);
    }

    [ExcludeFromCodeCoverage]
    private async Task<IJSObjectReference> CreatePositioningAsync()
    {
        _selfRef ??= DotNetObjectReference.Create(this);
        _positioningModule ??= await Js.InvokeAsync<IJSObjectReference>(
            "import", "./_content/blaizio.base/dist/positioning.js");

        var options = new
        {
            side = Side.ToAttribute(),
            align = Align.ToAttribute(),
            sideOffset = SideOffset,
            alignOffset = AlignOffset,
            collisionPadding = 8,
            inline = Inline,
        };

        // Item-aligned overlays the listbox on the trigger (selected option over it); popper floats it
        // below/above. Both publish --bz-anchor-width and report flips back through OnPlaced.
        var create = Position == SelectPosition.ItemAligned ? "createItemAlignedPositioning" : "createPositioning";
        return await _positioningModule.InvokeAsync<IJSObjectReference>(
            create, AnchorSelector, _element, options, _selfRef);
    }

    [ExcludeFromCodeCoverage]
    private async Task<IJSObjectReference> CreateMenuAsync()
    {
        _selfRef ??= DotNetObjectReference.Create(this);
        _menuModule ??= await Js.InvokeAsync<IJSObjectReference>(
            "import", "./_content/blaizio.base/dist/menu.js");

        // 'selected' lands the opening focus on the chosen option (or the first), scrolled into view.
        var options = new
        {
            initialFocus = "selected",
            typeaheadTimeout = 1000,
            loop = Loop,
            isSubmenu = false,
            triggerSelector = AnchorSelector,
        };

        return await _menuModule.InvokeAsync<IJSObjectReference>("createMenu", _element, options, _selfRef);
    }

    [ExcludeFromCodeCoverage]
    private async Task<IJSObjectReference> CreateDismissableLayerAsync()
    {
        _selfRef ??= DotNetObjectReference.Create(this);
        _dismissModule ??= await Js.InvokeAsync<IJSObjectReference>(
            "import", "./_content/blaizio.base/dist/dismissableLayer.js");

        var options = new
        {
            // A press on the trigger is not "outside" - the trigger toggles itself (no double-close).
            anchorSelector = AnchorSelector,
            dismissOnEscape = false, // Escape is handled in C# OnKeyDownAsync, like BasePopoverContent.
        };
        return await _dismissModule.InvokeAsync<IJSObjectReference>(
            "createDismissableLayer", _element, _selfRef, options);
    }

    /// <summary>Called by the positioning module when the resolved placement flips.</summary>
    [JSInvokable]
    public void OnPlaced(string side, string align)
    {
        if (_side == side && _align == align) return;
        _side = side;
        _align = align;
        StateHasChanged();
    }

    /// <summary>Called by the dismissable layer on an outside pointer-down.</summary>
    [JSInvokable]
    public Task OnDismissRequested() =>
        Select is null ? Task.CompletedTask : Select.RequestClose.InvokeAsync();

    /// <summary>Called by the presence module once the exit animation has finished.</summary>
    [JSInvokable]
    public async Task OnCloseFinished()
    {
        if (!_closing) return;
        _present = false;
        _closing = false;
        // Hide the surface again (options stay mounted for registration), then return focus to the
        // trigger ourselves via ts/menu.js (a no-op if the trigger has left the DOM). Tear the JS down
        // last: pointer-down listener, positioning loop, menu + presence listeners.
        StateHasChanged();
        await RestoreFocusAsync();
        await DisposeDismissAsync();
        await DisposePositioningAsync();
        await DisposeMenuAsync();
        await DisposePresenceAsync();
        await OnExitComplete.InvokeAsync();
    }

    [ExcludeFromCodeCoverage] // JS-interop seam: verified in-browser.
    private async Task RestoreFocusAsync()
    {
        if (_menuModule is null) return;
        try
        {
            // Stranded-only, scoped to our own (closing) surface: a keyboard close restores the
            // trigger, but a dismissing click that already focused something else (a text input)
            // keeps the user's focus - yanking it back would steal it out of the field.
            await _menuModule.InvokeVoidAsync("focusTrigger", AnchorSelector, true, _element);
        }
        catch (JSDisconnectedException) { }
    }

    [ExcludeFromCodeCoverage]
    private async Task DisposeDismissAsync()
    {
        // Claimed synchronously before any await: the close-finish callback and the component's
        // DisposeAsync can race here (a navigation disposes the component mid close-animation) -
        // the second caller must see null and no-op instead of double-disposing the JS reference.
        var task = _dismissTask;
        _dismissTask = null;
        if (task is null) return;
        try
        {
            var dismiss = await task;
            await dismiss.InvokeVoidAsync("dispose");
            await dismiss.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    [ExcludeFromCodeCoverage]
    private async Task DisposePositioningAsync()
    {
        var task = _positioningTask;
        _positioningTask = null;
        if (task is null) return;
        try
        {
            var positioning = await task;
            await positioning.InvokeVoidAsync("dispose");
            await positioning.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    [ExcludeFromCodeCoverage]
    private async Task DisposeMenuAsync()
    {
        var task = _menuTask;
        _menuTask = null;
        if (task is null) return;
        try
        {
            var menu = await task;
            await menu.InvokeVoidAsync("dispose");
            await menu.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    [ExcludeFromCodeCoverage]
    private async Task DisposePresenceAsync()
    {
        var task = _presenceTask;
        _presenceTask = null;
        if (task is null) return;
        try
        {
            var presence = await task;
            await presence.InvokeVoidAsync("dispose");
            await presence.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    [ExcludeFromCodeCoverage]
    public async ValueTask DisposeAsync()
    {
        try
        {
            await DisposeDismissAsync();
            await DisposePositioningAsync();
            await DisposeMenuAsync();
            await DisposePresenceAsync();
            if (_dismissModule is not null) await _dismissModule.DisposeAsync();
            if (_positioningModule is not null) await _positioningModule.DisposeAsync();
            if (_menuModule is not null) await _menuModule.DisposeAsync();
            if (_presenceModule is not null) await _presenceModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }

        _selfRef?.Dispose();
        GC.SuppressFinalize(this);
    }
}
