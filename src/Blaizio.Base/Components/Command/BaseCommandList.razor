@namespace Blaizio
@inherits BzComponentBase
@inject IJSRuntime Js
@implements IAsyncDisposable
@using System.Diagnostics.CodeAnalysis
@*
    The scrolling listbox surface. Holds the groups, items, and empty state, and attaches
    ts/command.js, which owns the keyboard navigation and the virtual highlight (focus stays in the
    input). Pure DOM-driven, no .NET callbacks: C# owns the search and which items render, JS owns the
    highlight, scrolling, and resetting the active option to the first match after each re-filter.
*@

<div @ref="_element" @attributes="BuildAttributes()">
    @ChildContent
</div>

@code {
    /// <summary>Groups, items, and an optional empty state.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private CommandContext? Command { get; set; }

    private ElementReference _element;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;
    private bool _attached;

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder(this)
            .Set("id", Command?.ListId)
            .Set("role", "listbox")
            .Aria("label", Command?.Label)
            .Data("bz-command-list", "")
            .Set("dir", DirAttribute)
            .Merge(Attributes, Class, Style);

    [ExcludeFromCodeCoverage] // JS-interop seam: a no-op under bUnit's loose interop, verified in-browser.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _attached || Command is null) return;
        _attached = true;

        try
        {
            _module = await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Blaizio.Base/dist/command.js");
            _handle = await _module.InvokeAsync<IJSObjectReference>(
                "createCommand", _element, new { inputId = Command.InputId, loop = Command.Loop });
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone before the module landed.
        }
    }

    [ExcludeFromCodeCoverage]
    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_handle is not null)
            {
                await _handle.InvokeVoidAsync("dispose");
                await _handle.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone - nothing to clean up.
        }

        GC.SuppressFinalize(this);
    }
}
