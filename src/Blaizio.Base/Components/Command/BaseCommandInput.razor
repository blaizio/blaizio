@namespace Blaizio
@inherits BzComponentBase
@*
    The combobox text box of a Command. Keeps DOM focus while the user types; the highlighted option is
    virtual (aria-activedescendant), owned by ts/command.js. Every keystroke flows to the root through
    the context, which re-filters. Renders a bare <input> - the styled layer adds the search icon and
    chrome.
*@

<input @attributes="BuildAttributes()" />

@code {
    /// <summary>Placeholder text.</summary>
    [Parameter] public string? Placeholder { get; set; }

    [CascadingParameter] private CommandContext? Command { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder(this)
            .Set("type", "text")
            .Set("id", Command?.InputId)
            .Set("role", "combobox")
            .Set("value", Command?.Search ?? "")
            .Set("placeholder", Placeholder)
            .Set("autocomplete", "off")
            .Set("autocorrect", "off")
            .Set("autocapitalize", "none")
            .Set("spellcheck", "false")
            .Aria("expanded", true)
            .Aria("controls", Command?.ListId)
            .Aria("autocomplete", "list")
            .Aria("label", Command?.Label)
            .Data("bz-command-input", "")
            .Set("dir", DirAttribute)
            .On("oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, OnInputAsync));

        return props.Merge(Attributes, Class, Style);
    }

    private Task OnInputAsync(ChangeEventArgs e) =>
        Command?.SearchChanged.InvokeAsync(e.Value?.ToString()) ?? Task.CompletedTask;
}
