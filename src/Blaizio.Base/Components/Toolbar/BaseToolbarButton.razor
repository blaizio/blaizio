@namespace Blaizio
@inherits BzComponentBase
@*
    One action button in a BaseToolbar: a native <button type="button"> marked
    `data-bz-roving-item` so the toolbar's roving focus manages it (it deliberately renders no
    tabindex - the script owns that). Wire the action through OnClick, not a splatted onclick: the
    component guards it, so a disabled button never fires.

    Disabled has two shapes. The default is the native `disabled` attribute - the standard,
    expected form: no hover, no focus, skipped by the arrow order. Opt in to
    FocusableWhenDisabled to keep the button in the arrow order instead (aria-disabled +
    data-focusable, pointer interaction off, clicks swallowed), so keyboard and screen-reader
    users can still DISCOVER the control and hear why it is off.
*@

<BasePrimitive Element="button"
                Attributes="BuildAttributes()"
                ChildContent="@ChildContent"
                RenderAs="@RenderAs" />

@code {
    /// <summary>Disables just this button (the toolbar's Disabled reaches it too).</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Keep a disabled button focusable and in the arrow order (aria-disabled, pointer
    /// interaction off) instead of dropping it (the native <c>disabled</c> attribute, the
    /// default) - so its state stays discoverable to keyboard and screen-reader users.
    /// </summary>
    [Parameter] public bool FocusableWhenDisabled { get; set; }

    /// <summary>The action. Guarded: never raised while disabled.</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>Button content (typically an icon).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the behaviour onto your own element instead of a <c>&lt;button&gt;</c>.</summary>
    [Parameter] public RenderFragment<BzRenderProps>? RenderAs { get; set; }

    [CascadingParameter] private ToolbarContext? Toolbar { get; set; }

    private bool IsDisabled => Disabled || (Toolbar?.Disabled ?? false);

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var disabled = IsDisabled;
        var props = new PropBuilder(this)
            .Data("bz-roving-item", "")
            .On("onclick", EventCallback.Factory.Create<MouseEventArgs>(this, OnClickAsync));

        if (RenderAs is null) props.Set("type", "button");

        if (disabled)
        {
            props.Data("disabled", "");
            if (FocusableWhenDisabled || RenderAs is not null)
            {
                // Focusable route (and the only route for arbitrary elements, which cannot take
                // `disabled`): announce the state, keep the element in the roving order.
                props.Aria("disabled", true);
                if (FocusableWhenDisabled) props.Data("focusable", "");
            }
            else
            {
                props.Flag("disabled", true);
            }
        }

        return props.Merge(Attributes, Class, Style);
    }

    private Task OnClickAsync(MouseEventArgs args) =>
        IsDisabled ? Task.CompletedTask : OnClick.InvokeAsync(args);
}
