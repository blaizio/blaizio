@namespace Blaizio
@inherits BzComponentBase
@*
    A text input inside a BaseToolbar, marked `data-bz-roving-item` so arrow keys reach it from its
    neighbours. The caret and the bar SHARE the arrows: while the caret can still move (or a
    selection is active) the key edits text; once it sits at the matching edge, the same key walks
    out to the neighbouring item - the field never traps the keyboard. Home/End always belong to
    the caret.

    Binds Value on input. Anything else an input takes (placeholder, type, maxlength...) goes
    through Attributes.
*@

<BasePrimitive Element="input"
                Attributes="BuildAttributes()" />

@code {
    /// <summary>The input's value. Use with <c>@bind-Value</c>.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Raised on every keystroke with the new value. Enables <c>@bind-Value</c>.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Disables just this input (the toolbar's Disabled reaches it too).</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Keep a disabled input focusable and in the arrow order (aria-disabled + readonly) instead
    /// of dropping it (the native <c>disabled</c> attribute, the default) - the value stays
    /// reachable, selectable and copyable.
    /// </summary>
    [Parameter] public bool FocusableWhenDisabled { get; set; }

    [CascadingParameter] private ToolbarContext? Toolbar { get; set; }

    private bool IsDisabled => Disabled || (Toolbar?.Disabled ?? false);

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder(this)
            .Data("bz-roving-item", "")
            .Set("value", Value ?? string.Empty)
            .On("oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, OnInputAsync));

        if (IsDisabled)
        {
            props.Data("disabled", "");
            if (FocusableWhenDisabled)
            {
                // readonly keeps the value reachable (focus, select, copy) while blocking edits -
                // the input equivalent of a focusable disabled button.
                props.Aria("disabled", true).Data("focusable", "").Flag("readonly", true);
            }
            else
            {
                props.Flag("disabled", true);
            }
        }

        return props.Merge(Attributes, Class, Style);
    }

    private Task OnInputAsync(ChangeEventArgs args) =>
        IsDisabled ? Task.CompletedTask : ValueChanged.InvokeAsync(args.Value?.ToString());
}
