@namespace Blaizio
@inherits BzComponentBase
@*
    The group wrapper (role=group) that lines up the input with the increment / decrement buttons and
    reads as one control. Reflects the field's disabled state with data-disabled so the styled layer can
    dim the whole shell. Renders a div by default.
*@

<div @attributes="BuildAttributes()">
    @ChildContent
</div>

@code {
    /// <summary>The input and the increment / decrement buttons.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private InputNumberContext? InputNumber { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder(this)
            .Set("role", "group")
            .Data("bz-input-number-group", "")
            .Set("dir", DirAttribute);

        if (InputNumber?.Disabled == true) props.Data("disabled", "");
        if (InputNumber?.ReadOnly == true) props.Data("readonly", "");

        return props.Merge(Attributes, Class, Style);
    }
}
