@namespace Blaizio
@inherits BzComponentBase
@implements IAsyncDisposable
@inject IJSRuntime Js
@using System.Globalization
@*
    The text box of a number field (role=spinbutton). It shows the value (raw + editable while focused,
    formatted while blurred) and reports it through aria-valuenow / valuemin / valuemax. Typing flows to
    the root, which parses + clamps it; the arrow keys step (Shift for the large step), Home / End jump to
    the bounds. Renders a bare <input> - the styled layer adds the look and the stepper buttons sit beside
    it inside the group.

    type="text", not type="number": the semantics are role=spinbutton's, and a native number field
    brings a spinner that duplicates the stepper buttons, a scroll wheel that changes the value by
    accident, and a value that reads back EMPTY for anything the browser dislikes - hiding the very
    text the root has to parse. What type="number" does give you for free is refusing letters, so
    ts/inputNumber.ts does that part explicitly (it cannot be done from here: a rejected keystroke
    leaves the model unchanged, so Blazor patches nothing and the character stays on screen).
*@

<input @ref="_element" @attributes="BuildAttributes()" />

@code {
    [CascadingParameter] private InputNumberContext? InputNumber { get; set; }

    /// <summary>Receives the rendered input's <see cref="ElementReference"/> - for a styled layer that needs the element (programmatic focus).</summary>
    [Parameter] public Action<ElementReference>? ElementRefCaptured { get; set; }

    private ElementReference _element;
    private (bool Decimal, bool Negative, string Separator)? _guard;

    // The guard is re-applied whenever what counts as numeric changes (a Min crossing zero takes the
    // minus away, a culture swap changes the separator); re-guarding replaces, never stacks.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) ElementRefCaptured?.Invoke(_element);
        if (InputNumber is not { } ctx) return;

        var wanted = (ctx.AllowDecimal, ctx.AllowNegative, ctx.DecimalSeparator);
        if (!firstRender && _guard == wanted) return;
        _guard = wanted;

        try
        {
            var module = await JsModules.ImportAsync(Js, "./_content/blaizio.base/dist/inputNumber.js");
            await module.InvokeVoidAsync("guardNumeric", _element, new
            {
                @decimal = wanted.AllowDecimal,
                negative = wanted.AllowNegative,
                separator = wanted.DecimalSeparator,
            });
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone.
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            // The module itself is shared via JsModules and outlives this component - only the
            // per-element guard is released here.
            if (_guard is not null)
            {
                var module = await JsModules.ImportAsync(Js, "./_content/blaizio.base/dist/inputNumber.js");
                await module.InvokeVoidAsync("releaseNumeric", _element);
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone (navigation / refresh) - nothing to clean up.
        }
    }

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var ctx = InputNumber;
        var props = new PropBuilder(this)
            .Set("id", ctx?.InputId)
            .Set("type", "text")
            .Set("role", "spinbutton")
            .Set("inputmode", "decimal")
            .Set("autocomplete", "off")
            .Set("autocorrect", "off")
            .Set("spellcheck", "false")
            .Set("value", ctx?.DisplayText ?? "")
            .Aria("label", ctx?.Label)
            .Aria("valuenow", ctx?.Value is { } v ? Num(v) : null)
            .Aria("valuemin", ctx?.Min is { } mn ? Num(mn) : null)
            .Aria("valuemax", ctx?.Max is { } mx ? Num(mx) : null)
            .Data("bz-input-number-input", "")
            // dir=auto: the value is a number, which should render left-to-right (with its minus sign
            // leading) even inside an RTL page, instead of inheriting the ambient direction.
            .Set("dir", "auto")
            .On("oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, OnInputAsync))
            .On("onfocus", EventCallback.Factory.Create<FocusEventArgs>(this, OnFocusAsync))
            .On("onblur", EventCallback.Factory.Create<FocusEventArgs>(this, OnBlurAsync))
            .On("onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, OnKeyDownAsync));

        if (ctx?.Disabled == true) props.Set("disabled", "disabled");
        if (ctx?.ReadOnly == true) props.Set("readonly", "readonly");

        return props.Merge(Attributes, Class, Style);
    }

    private Task OnInputAsync(ChangeEventArgs e) =>
        InputNumber?.OnInput.InvokeAsync(e.Value?.ToString()) ?? Task.CompletedTask;

    private Task OnFocusAsync(FocusEventArgs e) => InputNumber?.OnFocus.InvokeAsync() ?? Task.CompletedTask;

    private Task OnBlurAsync(FocusEventArgs e) => InputNumber?.OnBlur.InvokeAsync() ?? Task.CompletedTask;

    // Arrow keys step (Shift for the large step); Home / End jump to Min / Max. Page keys are left to the
    // browser (we cannot preventDefault per-key without a JS seam) so they do not silently scroll the page.
    private Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (InputNumber is not { } ctx || ctx.Disabled || ctx.ReadOnly) return Task.CompletedTask;

        return e.Key switch
        {
            "ArrowUp" => (e.ShiftKey ? ctx.IncrementLarge : ctx.Increment).InvokeAsync(),
            "ArrowDown" => (e.ShiftKey ? ctx.DecrementLarge : ctx.Decrement).InvokeAsync(),
            "Home" => ctx.GoToMin.InvokeAsync(),
            "End" => ctx.GoToMax.InvokeAsync(),
            _ => Task.CompletedTask,
        };
    }

    private static string Num(decimal value) => value.ToString(CultureInfo.InvariantCulture);
}
