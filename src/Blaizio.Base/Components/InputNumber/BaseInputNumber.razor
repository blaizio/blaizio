@namespace Blaizio
@typeparam TValue
@inject IServiceProvider Services
@implements IDisposable
@using System.Globalization
@*
    Headless number field root (the WAI-ARIA spinbutton pattern). Renders no element of its own: it owns
    the numeric value (controllable via Value/DefaultValue/ValueChanged - use @bind-Value), the optional
    [Min, Max] bounds, the Step / LargeStep grid, and the Disabled/ReadOnly flags, and cascades a
    InputNumberContext the Group / Input / Increment / Decrement parts read. All the math lives here: parse
    the typed text, clamp to the bounds, snap to the step grid, and format for display (a .NET format string
    in the field's Culture). The input shows the RAW editable number while focused and the FORMATTED value
    while blurred, so grouping/currency never fights the caret mid-type. Stepper buttons press-and-hold: the
    first press steps once, then this root repeats on a timer until the pointer releases.

    TValue is any numeric type Blazor's own InputNumber supports - int, long, short, float, double,
    decimal, bare or nullable (an empty field means null, so only a nullable TValue can be empty at rest).
    Internally every computation runs in decimal, so integers and money stay exact; TValue only crosses
    the parameter boundary (see InputNumberValue<TValue>), which also keeps the cascaded context - and
    with it the Input / Increment / Decrement parts - non-generic.
*@

<CascadingValue Value="@BuildContext()" IsFixed="false">
    @ChildContent
</CascadingValue>

@code {
    /// <summary>Controlled value. For a nullable <typeparamref name="TValue"/>, <see langword="null"/> is an empty field; bind with <c>@bind-Value</c>.</summary>
    [Parameter] public TValue Value { get; set; } = default!;

    /// <summary>Initial value when uncontrolled.</summary>
    [Parameter] public TValue DefaultValue { get; set; } = default!;

    /// <summary>Raised with the new value as it changes. Enables <c>@bind-Value</c>.</summary>
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }

    /// <summary>Lowest allowed value. Omit for unbounded below (the type's own range still applies).</summary>
    [Parameter] public double? Min { get; set; }

    /// <summary>Highest allowed value. Omit for unbounded above (the type's own range still applies).</summary>
    [Parameter] public double? Max { get; set; }

    /// <summary>The granularity the value snaps to and that one arrow / button press moves. Defaults to <c>1</c>.</summary>
    [Parameter] public double Step { get; set; } = 1;

    /// <summary>The bigger jump for PageUp/PageDown and Shift+Arrow. Defaults to <c>10</c>.</summary>
    [Parameter] public double LargeStep { get; set; } = 10;

    /// <summary>
    /// .NET numeric format string for the blurred display (e.g. <c>"N2"</c>, <c>"C"</c>, <c>"P0"</c>).
    /// Omit for a plain number (no grouping, up to 6 decimals). The editable text shown while focused is
    /// always the plain number, so the user types digits, not a formatted string.
    /// </summary>
    [Parameter] public string? Format { get; set; }

    /// <summary>Culture for formatting + parsing (decimal / group separators). Unset inherits <see cref="BlaizioOptions"/>, then the current culture.</summary>
    [Parameter] public CultureInfo? Culture { get; set; }

    /// <summary>Disables the whole field.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Show the value but block any change.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Accessible label applied to the input (use when there is no visible label).</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>The Group (with the Input and the Increment / Decrement buttons).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string _baseId = default!;
    private readonly ControllableState<decimal?> _value = new();
    private EventCallback<decimal?> _emit;
    private bool _focused;
    private string _text = "";
    private decimal? _lastSeen;  // the value the previous sync carried, to spot an actual change
    private bool _selfEdited;    // we committed since the last sync - the next value in is our own echo

    private CancellationTokenSource? _repeatCts;

    // The hold-to-repeat cadence: a press steps once, waits, then repeats - the native spinner feel.
    private static readonly TimeSpan RepeatDelay = TimeSpan.FromMilliseconds(300);
    private static readonly TimeSpan RepeatInterval = TimeSpan.FromMilliseconds(60);

    private CultureInfo Cult => Culture ?? BlaizioOptions.Resolve(Services).Culture ?? CultureInfo.CurrentCulture;
    private decimal EffectiveStep => Step > 0 ? InputNumberValue<TValue>.Saturate(Step) : 1;
    private decimal EffectiveLargeStep => LargeStep > 0 ? InputNumberValue<TValue>.Saturate(LargeStep) : EffectiveStep;
    private decimal? MinBound => Min is { } m ? InputNumberValue<TValue>.Saturate(m) : null;
    private decimal? MaxBound => Max is { } m ? InputNumberValue<TValue>.Saturate(m) : null;

    private bool CanIncrement => !Disabled && !ReadOnly && (MaxBound is not { } max || (_value.Value ?? MinBound ?? 0) < max);
    private bool CanDecrement => !Disabled && !ReadOnly && (MinBound is not { } min || (_value.Value ?? MaxBound ?? 0) > min);

    protected override void OnInitialized()
    {
        _baseId = Identifier.Create("input-number");
        // The one place TValue crosses back out: the decimal the state machine settled on, converted
        // for the consumer's callback.
        _emit = EventCallback.Factory.Create<decimal?>(
            this, v => ValueChanged.InvokeAsync(InputNumberValue<TValue>.FromDecimal(v)));
    }

    protected override void OnParametersSet()
    {
        _value.Sync(
            ValueChanged.HasDelegate,
            InputNumberValue<TValue>.ToDecimal(Value),
            InputNumberValue<TValue>.ToDecimal(DefaultValue));
        var current = _value.Value;

        // At rest the text simply follows the value. While the user is mid-edit the text is theirs,
        // with one exception: a change the PARENT drove (a reset button, a form load) has to reach the
        // display, or the field shows one number while the binding holds another.
        //
        // Telling those apart is the whole job, and an echo of our own commit is not always equal to
        // what we emitted: a @bind-Value:set may transform it (clamp, round, coalesce null), and on a
        // Blazor Server circuit a render can be built before a later keystroke and delivered after it,
        // so the value arriving can even be an OLDER one of ours. Hence: any commit since the last sync
        // marks the next value in as ours, and even an unflagged change is only allowed to rewrite the
        // text when the text does not already spell that value ("40." while 40 lands is the user's).
        if (!_focused)
            _text = FormatValue(current);
        else if (!_selfEdited && current != _lastSeen && !TextRepresents(current))
            _text = RawValue(current);

        _lastSeen = current;
        _selfEdited = false;
    }

    // Whether what is typed right now already means this value - a partial decimal ("1.", "40.")
    // counts, so an echo landing mid-type never truncates the caret's line.
    private bool TextRepresents(decimal? value) =>
        string.IsNullOrWhiteSpace(_text) ? value is null : TryParse(_text, out var typed) && typed == value;

    private InputNumberContext BuildContext() => new(
        _value.Value,
        MinBound,
        MaxBound,
        CanIncrement,
        CanDecrement,
        Disabled,
        ReadOnly,
        $"{_baseId}-input",
        Label,
        _text,
        EventCallback.Factory.Create<string?>(this, OnInputAsync),
        EventCallback.Factory.Create(this, OnFocusAsync),
        EventCallback.Factory.Create(this, OnBlurAsync),
        EventCallback.Factory.Create(this, () => StepByAsync(EffectiveStep)),
        EventCallback.Factory.Create(this, () => StepByAsync(-EffectiveStep)),
        EventCallback.Factory.Create(this, () => StepByAsync(EffectiveLargeStep)),
        EventCallback.Factory.Create(this, () => StepByAsync(-EffectiveLargeStep)),
        EventCallback.Factory.Create(this, () => MinBound is { } m ? SetValueAsync(m) : Task.CompletedTask),
        EventCallback.Factory.Create(this, () => MaxBound is { } m ? SetValueAsync(m) : Task.CompletedTask),
        EventCallback.Factory.Create<int>(this, PressStartAsync),
        EventCallback.Factory.Create(this, PressEnd),
        // What the typing guard is allowed to let through. An integral TValue rejects "2.7" when
        // parsing, so its separator never belongs in the field either; a Min at or above zero rules
        // out the minus the same way.
        !InputNumberValue<TValue>.Integral,
        MinBound is not { } floor || floor < 0,
        Cult.NumberFormat.NumberDecimalSeparator);

    // The user typed: keep the text exactly as typed (so the caret holds) and parse it into the value.
    // Parsing is in TValue's terms - an integral TValue rejects "2.7" outright, like Blazor's own
    // converter. Clamp live so a bound value never leaves [Min, Max]; snapping waits for blur so partial
    // decimals ("1.", "0.0") survive while typing. An unparseable string leaves the value untouched, and
    // an empty field only commits (null) when TValue can hold a null at all.
    private async Task OnInputAsync(string? text)
    {
        if (Disabled || ReadOnly) return;
        _text = text ?? "";

        if (string.IsNullOrWhiteSpace(_text))
        {
            if (InputNumberValue<TValue>.Nullable) await CommitAsync(null);
            return;
        }

        if (TryParse(_text, out var parsed)) await CommitAsync(Clamp(parsed));
    }

    private async Task OnFocusAsync()
    {
        _focused = true;
        _text = RawValue(_value.Value); // strip grouping/currency so it is cleanly editable
        await Task.CompletedTask;
    }

    // Leaving the field commits the typed value: clamp, snap to the step grid, then show it formatted.
    // An empty or unparseable field on a non-nullable TValue reverts to the last good value - the same
    // outcome as Blazor's InputNumber refusing the parse, minus the validation message plumbing.
    private async Task OnBlurAsync()
    {
        _focused = false;
        PressEnd();

        decimal? committed =
            string.IsNullOrWhiteSpace(_text) ? (InputNumberValue<TValue>.Nullable ? null : _value.Value)
            : TryParse(_text, out var parsed) ? Snap(Clamp(parsed))
            : _value.Value; // unparseable: revert to the last good value

        await CommitAsync(committed);
        _text = FormatValue(committed);
    }

    private Task StepByAsync(decimal delta) => StepFromAsync(_value.Value ?? StartFrom(), delta);

    // Steps from an explicit origin and reports where it landed, so the repeat loop can carry its own
    // running total instead of re-reading state the parent has not sent back yet.
    private async Task<decimal> StepFromAsync(decimal from, decimal delta)
    {
        var next = Snap(Clamp(from + delta));
        if (Disabled || ReadOnly) return from;
        await SetValueAsync(next);
        return next;
    }

    // A press: step once immediately, then (after a short delay) repeat on a timer until release. Fire the
    // loop without awaiting it so the pointerdown handler returns at once.
    private async Task PressStartAsync(int direction)
    {
        if (Disabled || ReadOnly) return;
        PressEnd();
        // The repeat continues from where this first step landed - not from _value, which in controlled
        // mode still holds the pre-press number until the parent's render arrives.
        var seed = await StepFromAsync(_value.Value ?? StartFrom(), direction * EffectiveStep);

        _repeatCts = new CancellationTokenSource();
        _ = RepeatAsync(direction, seed, _repeatCts.Token);
    }

    private void PressEnd()
    {
        _repeatCts?.Cancel();
        _repeatCts?.Dispose();
        _repeatCts = null;
    }

    private async Task RepeatAsync(int direction, decimal seed, CancellationToken token)
    {
        try
        {
            await Task.Delay(RepeatDelay, token);
            // Carry the running total rather than re-reading _value each tick: when controlled, the
            // parent's new value lands only with a render, and on a Blazor Server circuit renders
            // can lag well behind this cadence (batches wait on client acks) - re-reading would
            // redo the same stale math every tick and a whole hold would net a single step.
            var pending = seed;
            while (!token.IsCancellationRequested)
            {
                if (Disabled || ReadOnly) break;
                var next = Snap(Clamp(pending + direction * EffectiveStep));
                if (next == pending) break; // pinned at a bound - stop, as the buttons would disable
                pending = next;
                await SetValueAsync(next);
                await InvokeAsync(StateHasChanged); // [Timer] isn't a Blazor event - re-render ourselves.
                await Task.Delay(RepeatInterval, token);
            }
        }
        catch (OperationCanceledException)
        {
            // Released - stop quietly.
        }
    }

    private async Task SetValueAsync(decimal raw)
    {
        var next = Snap(Clamp(raw));
        await CommitAsync(next);
        // A step / jump replaces the shown text too: raw while editing, formatted at rest.
        _text = _focused ? RawValue(next) : FormatValue(next);
    }

    // Sets the value only - never the text - so live typing keeps the caret and partial decimals ("1.")
    // survive. Callers that should also change what is shown (steps, blur) update _text themselves.
    private async Task CommitAsync(decimal? next)
    {
        if (next == _value.Value) return;
        _selfEdited = true; // the parent's echo of this must not clobber the mid-type text
        await _value.SetAsync(next, _emit);
    }

    // Where stepping starts from an empty field: the nearest bound to 0, else 0.
    private decimal StartFrom() => MinBound ?? MaxBound ?? 0;

    private decimal Clamp(decimal value)
    {
        if (MinBound is { } min) value = Math.Max(value, min);
        if (MaxBound is { } max) value = Math.Min(value, max);
        // TValue's own range last, so converting back can never overflow.
        return Math.Clamp(value, InputNumberValue<TValue>.RangeMin, InputNumberValue<TValue>.RangeMax);
    }

    // Snap to the Step grid measured from Min (or 0). The math is decimal end to end, so there is no
    // binary-float drift to trim - the rounding only keeps the grid's own precision.
    private decimal Snap(decimal value)
    {
        try
        {
            var origin = MinBound ?? 0;
            var steps = decimal.Round((value - origin) / EffectiveStep, MidpointRounding.AwayFromZero);
            var snapped = Clamp(origin + steps * EffectiveStep);
            return decimal.Round(snapped, StepDecimals);
        }
        catch (OverflowException)
        {
            // A fractional step against a value near decimal's edge can overflow the step count
            // (value / step > decimal.MaxValue). Way past any real spinner - keep the clamped value.
            return Clamp(value);
        }
    }

    private int StepDecimals
    {
        get
        {
            var text = EffectiveStep.ToString(CultureInfo.InvariantCulture);
            var dot = text.IndexOf('.');
            return dot < 0 ? 0 : Math.Min(text.Length - dot - 1, 15);
        }
    }

    private bool TryParse(string text, out decimal value) =>
        InputNumberValue<TValue>.TryParse(text, Cult, out value);

    private string FormatValue(decimal? value) =>
        value is { } v ? v.ToString(Format ?? "0.######", Cult) : "";

    private string RawValue(decimal? value) =>
        value is { } v ? v.ToString("0.######", Cult) : "";

    public void Dispose() => PressEnd();
}
