@namespace Blaizio
@inject IServiceProvider Services
@implements IDisposable
@using System.Globalization
@*
    Headless number field root (the WAI-ARIA spinbutton pattern). Renders no element of its own: it owns
    the numeric value (controllable via Value/DefaultValue/ValueChanged - use @bind-Value), the optional
    [Min, Max] bounds, the Step / LargeStep grid, and the Disabled/ReadOnly flags, and cascades a
    InputNumberContext the Group / Input / Increment / Decrement parts read. All the math lives here: parse
    the typed text, clamp to the bounds, snap to the step grid, and format for display (a .NET format string
    in the field's Culture). The input shows the RAW editable number while focused and the FORMATTED value
    while blurred, so grouping/currency never fights the caret mid-type. Stepper buttons press-and-hold: the
    first press steps once, then this root repeats on a timer until the pointer releases.
*@

<CascadingValue Value="@BuildContext()" IsFixed="false">
    @ChildContent
</CascadingValue>

@code {
    /// <summary>Controlled value. Leave <see langword="null"/> for an empty field; bind with <c>@bind-Value</c>.</summary>
    [Parameter] public double? Value { get; set; }

    /// <summary>Initial value when uncontrolled.</summary>
    [Parameter] public double? DefaultValue { get; set; }

    /// <summary>Raised with the new value as it changes. Enables <c>@bind-Value</c>.</summary>
    [Parameter] public EventCallback<double?> ValueChanged { get; set; }

    /// <summary>Lowest allowed value. Omit for unbounded below.</summary>
    [Parameter] public double? Min { get; set; }

    /// <summary>Highest allowed value. Omit for unbounded above.</summary>
    [Parameter] public double? Max { get; set; }

    /// <summary>The granularity the value snaps to and that one arrow / button press moves. Defaults to <c>1</c>.</summary>
    [Parameter] public double Step { get; set; } = 1;

    /// <summary>The bigger jump for PageUp/PageDown and Shift+Arrow. Defaults to <c>10</c>.</summary>
    [Parameter] public double LargeStep { get; set; } = 10;

    /// <summary>
    /// .NET numeric format string for the blurred display (e.g. <c>"N2"</c>, <c>"C"</c>, <c>"P0"</c>).
    /// Omit for a plain number (no grouping, up to 6 decimals). The editable text shown while focused is
    /// always the plain number, so the user types digits, not a formatted string.
    /// </summary>
    [Parameter] public string? Format { get; set; }

    /// <summary>Culture for formatting + parsing (decimal / group separators). Unset inherits <see cref="BlaizioOptions"/>, then the current culture.</summary>
    [Parameter] public CultureInfo? Culture { get; set; }

    /// <summary>Disables the whole field.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Show the value but block any change.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Accessible label applied to the input (use when there is no visible label).</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>The Group (with the Input and the Increment / Decrement buttons).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string _baseId = default!;
    private readonly ControllableState<double?> _value = new();
    private bool _focused;
    private string _text = "";

    private CancellationTokenSource? _repeatCts;

    // The hold-to-repeat cadence: a press steps once, waits, then repeats - the native spinner feel.
    private static readonly TimeSpan RepeatDelay = TimeSpan.FromMilliseconds(300);
    private static readonly TimeSpan RepeatInterval = TimeSpan.FromMilliseconds(60);

    private CultureInfo Cult => Culture ?? BlaizioOptions.Resolve(Services).Culture ?? CultureInfo.CurrentCulture;
    private double EffectiveStep => Step > 0 ? Step : 1;
    private double EffectiveLargeStep => LargeStep > 0 ? LargeStep : EffectiveStep;

    private bool CanIncrement => !Disabled && !ReadOnly && (Max is not { } max || (_value.Value ?? Min ?? 0) < max);
    private bool CanDecrement => !Disabled && !ReadOnly && (Min is not { } min || (_value.Value ?? Max ?? 0) > min);

    protected override void OnInitialized() => _baseId = Identifier.Create("input-number");

    protected override void OnParametersSet()
    {
        _value.Sync(ValueChanged.HasDelegate, Value, DefaultValue);
        // Keep the shown text in step with the value while the user is NOT mid-edit (external/parent
        // changes, or the initial value). While focused the text is the user's own - leave it be.
        if (!_focused) _text = FormatValue(_value.Value);
    }

    private InputNumberContext BuildContext() => new(
        _value.Value,
        Min,
        Max,
        CanIncrement,
        CanDecrement,
        Disabled,
        ReadOnly,
        $"{_baseId}-input",
        Label,
        _text,
        EventCallback.Factory.Create<string?>(this, OnInputAsync),
        EventCallback.Factory.Create(this, OnFocusAsync),
        EventCallback.Factory.Create(this, OnBlurAsync),
        EventCallback.Factory.Create(this, () => StepByAsync(EffectiveStep)),
        EventCallback.Factory.Create(this, () => StepByAsync(-EffectiveStep)),
        EventCallback.Factory.Create(this, () => StepByAsync(EffectiveLargeStep)),
        EventCallback.Factory.Create(this, () => StepByAsync(-EffectiveLargeStep)),
        EventCallback.Factory.Create(this, () => Min is { } m ? SetValueAsync(m) : Task.CompletedTask),
        EventCallback.Factory.Create(this, () => Max is { } m ? SetValueAsync(m) : Task.CompletedTask),
        EventCallback.Factory.Create<int>(this, PressStartAsync),
        EventCallback.Factory.Create(this, PressEnd));

    // The user typed: keep the text exactly as typed (so the caret holds) and parse it into the value.
    // Clamp live so a bound value never leaves [Min, Max]; snapping waits for blur so partial decimals
    // ("1.", "0.0") survive while typing. An unparseable string leaves the value untouched.
    private async Task OnInputAsync(string? text)
    {
        if (Disabled || ReadOnly) return;
        _text = text ?? "";

        if (string.IsNullOrWhiteSpace(_text))
        {
            await CommitAsync(null);
            return;
        }

        if (TryParse(_text, out var parsed)) await CommitAsync(Clamp(parsed));
    }

    private async Task OnFocusAsync()
    {
        _focused = true;
        _text = RawValue(_value.Value); // strip grouping/currency so it is cleanly editable
        await Task.CompletedTask;
    }

    // Leaving the field commits the typed value: clamp, snap to the step grid, then show it formatted.
    private async Task OnBlurAsync()
    {
        _focused = false;
        PressEnd();

        double? committed = string.IsNullOrWhiteSpace(_text) ? null
            : TryParse(_text, out var parsed) ? Snap(Clamp(parsed))
            : _value.Value; // unparseable: revert to the last good value

        await CommitAsync(committed);
        _text = FormatValue(_value.Value);
    }

    private Task StepByAsync(double delta)
    {
        if (Disabled || ReadOnly) return Task.CompletedTask;
        var from = _value.Value ?? StartFrom();
        return SetValueAsync(from + delta);
    }

    // A press: step once immediately, then (after a short delay) repeat on a timer until release. Fire the
    // loop without awaiting it so the pointerdown handler returns at once.
    private async Task PressStartAsync(int direction)
    {
        if (Disabled || ReadOnly) return;
        PressEnd();
        await StepByAsync(direction * EffectiveStep);

        _repeatCts = new CancellationTokenSource();
        _ = RepeatAsync(direction, _repeatCts.Token);
    }

    private void PressEnd()
    {
        _repeatCts?.Cancel();
        _repeatCts?.Dispose();
        _repeatCts = null;
    }

    private async Task RepeatAsync(int direction, CancellationToken token)
    {
        try
        {
            await Task.Delay(RepeatDelay, token);
            while (!token.IsCancellationRequested)
            {
                var canStep = direction > 0 ? CanIncrement : CanDecrement;
                if (!canStep) break;
                await StepByAsync(direction * EffectiveStep);
                await InvokeAsync(StateHasChanged); // [Timer] isn't a Blazor event - re-render ourselves.
                await Task.Delay(RepeatInterval, token);
            }
        }
        catch (OperationCanceledException)
        {
            // Released - stop quietly.
        }
    }

    private async Task SetValueAsync(double raw)
    {
        var next = Snap(Clamp(raw));
        await CommitAsync(next);
        // A step / jump replaces the shown text too: raw while editing, formatted at rest.
        _text = _focused ? RawValue(next) : FormatValue(next);
    }

    // Sets the value only - never the text - so live typing keeps the caret and partial decimals ("1.")
    // survive. Callers that should also change what is shown (steps, blur) update _text themselves.
    private async Task CommitAsync(double? next)
    {
        if (next == _value.Value) return;
        await _value.SetAsync(next, ValueChanged);
    }

    // Where stepping starts from an empty field: the nearest bound to 0, else 0.
    private double StartFrom() => Min ?? Max ?? 0;

    private double Clamp(double value)
    {
        if (Min is { } min) value = Math.Max(value, min);
        if (Max is { } max) value = Math.Min(value, max);
        return value;
    }

    // Snap to the Step grid measured from Min (or 0), then trim binary-float drift so values read cleanly.
    private double Snap(double value)
    {
        var origin = Min ?? 0;
        var steps = Math.Round((value - origin) / EffectiveStep, MidpointRounding.AwayFromZero);
        var snapped = Clamp(origin + steps * EffectiveStep);
        return Math.Round(snapped, StepDecimals);
    }

    private int StepDecimals
    {
        get
        {
            var text = EffectiveStep.ToString(CultureInfo.InvariantCulture);
            var dot = text.IndexOf('.');
            return dot < 0 ? 0 : Math.Min(text.Length - dot - 1, 15);
        }
    }

    private bool TryParse(string text, out double value) =>
        double.TryParse(text, NumberStyles.Number, Cult, out value);

    private string FormatValue(double? value) =>
        value is { } v ? v.ToString(Format ?? "0.######", Cult) : "";

    private string RawValue(double? value) =>
        value is { } v ? v.ToString("0.######", Cult) : "";

    public void Dispose() => PressEnd();
}
