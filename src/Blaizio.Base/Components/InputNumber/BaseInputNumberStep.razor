@namespace Blaizio
@inherits BzComponentBase
@*
    A stepper button. Direction picks which way it moves the value - one component rather than an
    Increment/Decrement pair, since the two differed only by a sign, a label and an attribute.

    Pressing it steps once, then holds-to-repeat (the root runs the timer) until the pointer releases
    or leaves. preventDefault on pointerdown keeps focus in the input, so a press does not blur +
    reformat the field. Not in the tab order (tabindex=-1): keyboard users step with the input's arrow
    keys. Auto-disables at the bound it moves towards. Renders a button; pass the chevron (or any
    glyph) as its content.
*@

<button @onpointerdown="OnPressAsync"
        @onpointerdown:preventDefault="true"
        @onpointerup="OnReleaseAsync"
        @onpointerleave="OnReleaseAsync"
        @onpointercancel="OnReleaseAsync"
        @attributes="BuildAttributes()">
    @ChildContent
</button>

@code {
    /// <summary>Which way this button steps. Defaults to <see cref="InputNumberStepDirection.Increment"/>.</summary>
    [Parameter] public InputNumberStepDirection Direction { get; set; }

    /// <summary>The button content (typically a chevron / plus / minus icon).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private InputNumberContext? InputNumber { get; set; }

    private bool Up => Direction is InputNumberStepDirection.Increment;

    private bool Enabled => InputNumber is { } ctx && (Up ? ctx.CanIncrement : ctx.CanDecrement);

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder(this)
            .Set("type", "button")
            .Set("tabindex", "-1")
            .Aria("label", Up ? "Increase" : "Decrease")
            // One part name with the direction alongside it, so a skin can target the pair
            // ([data-bz-input-number-step]) or either half ([data-direction='decrement']).
            .Data("bz-input-number-step", "")
            .Data("direction", Up ? "increment" : "decrement")
            .Set("dir", DirAttribute);

        if (!Enabled) props.Set("disabled", "disabled");

        return props.Merge(Attributes, Class, Style);
    }

    private Task OnPressAsync(PointerEventArgs e) =>
        e.Button == 0 && InputNumber is { } ctx ? ctx.PressStart.InvokeAsync(Up ? 1 : -1) : Task.CompletedTask;

    private Task OnReleaseAsync(PointerEventArgs e) =>
        InputNumber?.PressEnd.InvokeAsync() ?? Task.CompletedTask;
}
