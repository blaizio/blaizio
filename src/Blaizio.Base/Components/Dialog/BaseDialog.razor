@namespace Blaizio
@inject IJSRuntime Js
@*
    A window overlaid on the page: renders no element of its own -
    it owns the open state and cascades DialogContext to BaseDialogTrigger / Overlay / Content /
    Title / Description / Close. Controllable via Open/DefaultOpen/OpenChanged (use @bind-Open).

    There is no portal: overlay and content are position:fixed, which escapes layout (but not a
    transformed/contained ancestor - keep dialogs out of such containers).
*@

<CascadingValue Value="@Context" IsFixed="false">
    @ChildContent
</CascadingValue>

@code {
    /// <summary>Controlled open state. Leave <see langword="null"/> for uncontrolled.</summary>
    [Parameter] public bool? Open { get; set; }

    /// <summary>Initial state when uncontrolled.</summary>
    [Parameter] public bool DefaultOpen { get; set; }

    /// <summary>Raised with the new state. Enables <c>@bind-Open</c>.</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>
    /// Modal (the default): traps focus, locks page scroll, and renders the overlay.
    /// Non-modal dialogs leave the rest of the page interactive.
    /// </summary>
    [Parameter] public bool Modal { get; set; } = true;

    /// <summary>
    /// Whether implicit dismissal closes the dialog. When <see langword="false"/>, Escape and
    /// outside-click (the backdrop) no longer close it - an explicit close still works, and the styled
    /// DialogContent hides its corner close button. Defaults to <see langword="true"/>. Set
    /// <see langword="false"/> while a lengthy operation runs.
    /// </summary>
    [Parameter] public bool DismissOnOutsideClick { get; set; } = true;

    /// <summary>The trigger and content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string _baseId = default!;
    private bool _preloaded;
    private readonly ControllableState<bool> _state = new();

    private DialogContext Context => new(
        _state.Value,
        Modal,
        !DismissOnOutsideClick,
        $"{_baseId}-content",
        $"{_baseId}-title",
        $"{_baseId}-description",
        EventCallback.Factory.Create<bool>(this, SetOpenAsync));

    protected override void OnInitialized() => _baseId = Identifier.Create("dialog");

    protected override void OnParametersSet() =>
        _state.Sync(Open.HasValue, Open ?? false, DefaultOpen);

    private Task SetOpenAsync(bool open) => _state.SetAsync(open, OpenChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _preloaded) return;
        _preloaded = true;

        // Warm the presence + portal + focus-scope (and, when modal, scroll-lock) modules so the
        // FIRST open doesn't race a cold import: content and overlay mount animating in place, and
        // a late portal.js reparents them to <body> mid-animation - CSS animations restart on
        // reinsertion, a visible first-open stutter. This primes the shared JsModules cache - the
        // content's later imports await the exact same tasks.
        try
        {
            await JsModules.ImportAsync(Js, "./_content/blaizio.base/dist/presence.js");
            await JsModules.ImportAsync(Js, "./_content/blaizio.base/dist/portal.js");
            await JsModules.ImportAsync(Js, "./_content/blaizio.base/dist/focusScope.js");
            if (Modal) await JsModules.ImportAsync(Js, "./_content/blaizio.base/dist/scrollLock.js");
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone before the warm-up landed.
        }
    }
}
