@namespace Blaizio
@inherits BzComponentBase
@inject IJSRuntime Js
@implements IAsyncDisposable
@*
    The backdrop of a modal BaseDialog - presence-managed like BaseAccordionContent: it stays
    mounted with data-state="closed" while the skin's exit animation plays and unmounts when
    ts/presence.ts reports animationend (or immediately when the active skin has no animation).
    Pressing the pointer down on it (i.e. outside the content) closes the dialog, unless
    DismissOnOutsideClick is false (alert dialogs require an explicit choice). Renders only for modal
    dialogs.
*@

@if (_present && Dialog?.Modal == true)
{
    <BasePrimitive Element="div"
                    Attributes="BuildAttributes()"
                    ChildContent="@ChildContent"
                    ElementRefCaptured="@(reference => _element = reference)" />
}

@code {
    /// <summary>Optional overlay content (rarely used).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Pressing the overlay closes the dialog. Defaults to <see langword="true"/>; alert dialogs set it false.</summary>
    [Parameter] public bool DismissOnOutsideClick { get; set; } = true;

    /// <summary>
    /// Render the overlay in place instead of moving it to the document body while open. By default
    /// it portals to the body (like the dialog content it backs) so no ancestor stacking context or
    /// overflow clip can cover it; set <see langword="true"/> to keep it inside its parent DOM.
    /// Pair with the content's <c>Inline</c> - a portaled content over an inline overlay (or the
    /// reverse) can stack wrongly.
    /// </summary>
    [Parameter] public bool Inline { get; set; }

    [CascadingParameter] private DialogContext? Dialog { get; set; }

    private bool _present;
    private bool _closing;
    private ElementReference _element;
    private Task<IJSObjectReference>? _instanceTask;
    private Task<IJSObjectReference>? _portalTask;
    private DotNetObjectReference<BaseDialogOverlay>? _selfRef;

    protected override void OnParametersSet()
    {
        var open = Dialog?.Open ?? false;

        if (open && (!_present || _closing))
        {
            _present = true;
            _closing = false;
        }
        else if (!open && _present && !_closing)
        {
            _closing = true;
        }
    }

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder(this)
            .Data("state", _closing ? "closed" : "open")
            // A portaled overlay leaves any subtree direction provider's DOM ancestry, so the
            // cascaded direction is stamped on the element itself (inline keeps inheritance).
            .Set("dir", Inline ? DirAttribute : PortalDirAttribute)
            .Set("aria-hidden", "true");
        if (DismissOnOutsideClick) props.On("onpointerdown", EventCallback.Factory.Create(this, DismissAsync));
        return props.Merge(Attributes, Class, Style);
    }

    private Task DismissAsync() =>
        // Outside-click is an implicit dismissal - suppressed entirely when the dialog is locked.
        Dialog is { PreventDismiss: false } ? Dialog.SetOpen.InvokeAsync(false) : Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_present || Dialog?.Modal != true) return;

        // Claimed synchronously (before any await) so re-entrant renders don't create twice.
        _instanceTask ??= CreatePresenceAsync();
        if (!Inline) _portalTask ??= CreatePortalAsync();

        if (_closing)
        {
            // No-animation skins report back immediately; otherwise animationend does.
            var instance = await _instanceTask;
            await instance.InvokeVoidAsync("onClosing");
        }
    }

    private async Task<IJSObjectReference> CreatePresenceAsync()
    {
        _selfRef ??= DotNetObjectReference.Create(this);
        var module = await JsModules.ImportAsync(Js, "./_content/blaizio.base/dist/presence.js");
        return await module.InvokeAsync<IJSObjectReference>("createPresence", _element, _selfRef);
    }

    // Move the overlay to <body> while open (see BaseDialogContent's portal note). ts/portal.js keeps
    // portaled elements in declaration order, so the overlay stays painted under its content.
    private async Task<IJSObjectReference> CreatePortalAsync()
    {
        var module = await JsModules.ImportAsync(Js, "./_content/blaizio.base/dist/portal.js");
        return await module.InvokeAsync<IJSObjectReference>("createPortal", _element);
    }

    [JSInvokable]
    public async Task OnCloseFinished()
    {
        if (!_closing) return;
        _present = false;
        _closing = false;
        await DisposeInstanceAsync();
        // Portal restore precedes the unmount render: the node must be back at its placeholder
        // before Blazor removes it.
        await DisposePortalAsync();
        StateHasChanged();
    }

    private async Task DisposePortalAsync()
    {
        // Claimed synchronously before any await: the close-finish callback and the component's
        // DisposeAsync can race here (a navigation disposes the component mid close-animation) -
        // the second caller must see null and no-op instead of double-disposing the JS reference.
        var task = _portalTask;
        _portalTask = null;
        if (task is null) return;
        try
        {
            var portal = await task;
            await portal.InvokeVoidAsync("dispose");
            await portal.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone.
        }
        catch (ObjectDisposedException)
        {
            // Already disposed by the concurrent caller.
        }
    }

    private async Task DisposeInstanceAsync()
    {
        var task = _instanceTask;
        _instanceTask = null;
        if (task is null) return;
        try
        {
            var instance = await task;
            await instance.InvokeVoidAsync("dispose");
            await instance.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone.
        }
        catch (ObjectDisposedException)
        {
            // Already disposed by the concurrent caller.
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            // Instances only - the modules are shared via JsModules and outlive this component.
            await DisposeInstanceAsync();
            await DisposePortalAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone.
        }
        catch (ObjectDisposedException)
        {
            // Already disposed by the racing close-finish callback.
        }

        _selfRef?.Dispose();
    }
}
