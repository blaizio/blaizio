@namespace Blaizio
@inherits PresenceSurfaceBase
@*
    The window of a BaseDialog: a role="dialog" surface wrapped
    in a focus scope (trapped + looped when modal; focus returns to the trigger on close), labelled
    by BaseDialogTitle / described by BaseDialogDescription, dismissed with Escape (the overlay
    handles pointer-down outside). Modal dialogs lock body scroll via ts/scrollLock.ts while open.

    Escape arrives through ts/dismissableLayer.ts, where the dialog is one layer among the popovers
    and menus: the topmost surface takes the key, so an Escape that closes a list inside the dialog
    does not close the dialog too, and a popover underneath no longer reads a press inside the
    dialog as a press outside itself.

    Presence-managed like BaseDialogOverlay: stays rendered with data-state="closed" while the
    style's exit animation plays, removed on ts/presence.ts's animationend report (the lifecycle
    lives in PresenceSurfaceBase). The focus scope element IS the content element - no extra wrapper.
*@

@if (Present)
{
    <BaseFocusScope Trapped="@Modal"
                     Loop="@Modal"
                     Attributes="BuildAttributes()"
                     ElementRefCaptured="@CaptureElement"
                     OnMountAutoFocus="@OnOpenAutoFocus"
                     OnUnmountAutoFocus="@OnCloseAutoFocus">
        <CascadingValue Value="@_aria" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </BaseFocusScope>
}

@code {
    /// <summary>Dialog content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The ARIA role. Defaults to <c>dialog</c>; alert dialogs pass <c>alertdialog</c>.</summary>
    [Parameter] public string Role { get; set; } = "dialog";

    /// <summary>
    /// Render the content in place instead of moving it to the document body while open. By default
    /// the surface portals to the body so no ancestor stacking context or overflow clip can cover
    /// it; set <see langword="true"/> to keep it inside its parent DOM (useful under CSS containment,
    /// for print, or in tests that assert on local markup).
    /// </summary>
    [Parameter] public bool Inline { get; set; }

    /// <summary>Raised before auto-focusing the first tabbable on open. PreventDefault to focus something yourself.</summary>
    [Parameter] public EventCallback<FocusScopeEvent> OnOpenAutoFocus { get; set; }

    /// <summary>Raised before focus returns to the trigger on close. PreventDefault to handle focus yourself.</summary>
    [Parameter] public EventCallback<FocusScopeEvent> OnCloseAutoFocus { get; set; }

    /// <summary>
    /// Raised after the exit animation finishes and the content has been removed. Hosts that render dialogs
    /// dynamically (e.g. <see cref="BaseDialogProvider"/>) use this to drop a closed instance only once its
    /// close animation has played - the exit-animation-complete hook.
    /// </summary>
    [Parameter] public EventCallback OnExitComplete { get; set; }

    [CascadingParameter] private DialogContext? Dialog { get; set; }

    private bool Modal => Dialog?.Modal ?? false;

    private const string PortalModule = "./_content/blaizio.base/dist/portal.js";
    private const string DismissModule = "./_content/blaizio.base/dist/dismissableLayer.js";
    private const string ScrollLockModule = "./_content/blaizio.base/dist/scrollLock.js";

    private AriaNameRegistry _aria = default!;
    private bool _scrollLocked;
    private bool _ariaChecked;
    private Task? _scrollLockTask;
    // The move to <body>: an overlay surface has no positioning script to inherit the portal from.
    private readonly SurfaceScript _portal = new();
    // The dialog's place in the stack of dismissable surfaces.
    private readonly SurfaceScript _dismiss = new();

    protected override bool IsOpen => Dialog?.Open ?? false;

    protected override async ValueTask OnClosedAsync() => await OnExitComplete.InvokeAsync();

    private protected override IDisposable CreateSelfReference() => DotNetObjectReference.Create(this);

    protected override void OnInitialized() =>
        // The registry re-renders THIS content when a title/description (de)registers; guard against a
        // notify arriving after disposal.
        _aria = new AriaNameRegistry(() => { if (!Disposed) _ = InvokeAsync(StateHasChanged); });

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder(this)
            .Set("role", Role)
            .Set("id", Dialog?.ContentId)
            .Data("state", Closing ? "closed" : "open")
            // A portaled surface leaves any subtree direction provider's DOM ancestry, so the
            // cascaded direction is stamped on the element itself (inline keeps inheritance).
            .Set("dir", Inline ? DirAttribute : PortalDirAttribute)
            // Marks a surface that is on its way to <body>: blaizio.css keeps it invisible while it
            // still sits at its declaration site, so the entry animation the user sees is the one
            // that starts after the move (moving a node restarts its CSS animations).
            .Data("bz-portal", Inline ? null : "");

        // Reference a title/description only when one is actually rendered - a dangling aria-labelledby/
        // describedby is worse than none (see AriaNameRegistry).
        if (_aria.HasTitle) props.Aria("labelledby", Dialog?.TitleId);
        if (_aria.HasDescription) props.Aria("describedby", Dialog?.DescriptionId);
        if (Modal) props.Aria("modal", true);

        return props.Merge(Attributes, Class, Style);
    }

    /// <summary>Called by the dismissable layer when Escape is pressed while this dialog is the topmost surface.</summary>
    [JSInvokable]
    public Task OnDismissRequested() =>
        // Escape is an implicit dismissal - suppressed entirely when the dialog is locked, and
        // not news to one that is already on its way out.
        Dialog is { PreventDismiss: false } && !Closing ? Dialog.SetOpen.InvokeAsync(false) : Task.CompletedTask;

    private protected override void ClaimScripts()
    {
        ClaimPresence();
        // Disposed (moved back) before the removal render, so Blazor removes the node from the
        // tree it still owns.
        if (!Inline && !_portal.Claimed) _portal.Claim(Js, PortalModule, "createPortal", Element);
        // A layer only while open: a dialog that is closing gives the top of the stack back at
        // once (see OnSurfaceRenderedAsync), so the next Escape goes to the surface underneath,
        // not into the exit animation. Escape only: a press outside is the overlay's to judge
        // (BaseDialogOverlay), and a dialog without one stays open under it.
        if (!Closing && !_dismiss.Claimed)
        {
            var options = new
            {
                anchorSelector = (string?)null,
                dismissOnEscape = true,
                dismissOnOutsidePress = false,
            };
            _dismiss.Claim(Js, DismissModule, "createDismissableLayer", Element, SelfReference, options);
        }

        if (Modal && !_scrollLocked)
        {
            _scrollLocked = true;
            _scrollLockTask = LockScrollAsync();
        }
    }

    private protected override async Task OnSurfaceRenderedAsync()
    {
        if (Closing) await _dismiss.ReleaseAsync();

        if (!_ariaChecked)
        {
            _ariaChecked = true;
            await WarnIfUnnamedAsync();
        }
    }

    // A dialog needs an accessible name. Warn (a dev aid) when neither a BaseDialogTitle nor
    // a consumer-supplied aria-label/aria-labelledby is present once the content has rendered.
    private async Task WarnIfUnnamedAsync()
    {
        if (_aria.HasTitle || HasConsumerName()) return;
        try
        {
            await Js.InvokeVoidAsync("console.warn",
                "Blaizio Dialog: add a DialogTitle (visually hidden if needed) or an aria-label on the " +
                "content so screen readers can announce the dialog.");
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone.
        }
    }

    private bool HasConsumerName() =>
        Attributes is not null && (Attributes.ContainsKey("aria-label") || Attributes.ContainsKey("aria-labelledby"));

    private async Task LockScrollAsync()
    {
        var module = await JsModules.ImportAsync(Js, ScrollLockModule);
        await module.InvokeVoidAsync("lock");
    }

    private protected override async Task FinishCloseAsync()
    {
        await ReleaseScriptsAsync(forGood: false);
        StateHasChanged();
    }

    private protected override ValueTask DisposeScriptsAsync() => ReleaseScriptsAsync(forGood: true);

    // The portal goes last: the node must be back at its placeholder before Blazor removes it.
    private async ValueTask ReleaseScriptsAsync(bool forGood)
    {
        await EndAsync(_dismiss, forGood);
        await EndAsync(Presence, forGood);
        await UnlockScrollAsync();
        await EndAsync(_portal, forGood);

        static ValueTask EndAsync(SurfaceScript script, bool forGood) =>
            forGood ? script.DisposeAsync() : script.ReleaseAsync();
    }

    private async Task UnlockScrollAsync()
    {
        if (!_scrollLocked) return;
        _scrollLocked = false;
        try
        {
            // Make sure the lock call has landed before undoing it.
            if (_scrollLockTask is not null) await _scrollLockTask;
            var module = await JsModules.ImportAsync(Js, ScrollLockModule);
            await module.InvokeVoidAsync("unlock");
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone.
        }
        _scrollLockTask = null;
    }
}
