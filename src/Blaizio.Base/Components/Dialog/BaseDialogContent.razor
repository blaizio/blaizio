@namespace Blaizio
@inherits BzComponentBase
@inject IJSRuntime Js
@implements IAsyncDisposable
@*
    The window of a BaseDialog: a role="dialog" surface wrapped
    in a focus scope (trapped + looped when modal; focus returns to the trigger on close), labelled
    by BaseDialogTitle / described by BaseDialogDescription, dismissed with Escape (the overlay
    handles pointer-down outside). Modal dialogs lock body scroll via ts/scrollLock.ts while open.

    Presence-managed like BaseDialogOverlay: stays mounted with data-state="closed" while the
    skin's exit animation plays, unmounting on ts/presence.ts's animationend report. The focus
    scope element IS the content element - no extra wrapper.
*@

@if (_present)
{
    <BaseFocusScope Trapped="@Modal"
                     Loop="@Modal"
                     Attributes="BuildAttributes()"
                     ElementRefCaptured="@(reference => _element = reference)"
                     OnMountAutoFocus="@OnOpenAutoFocus"
                     OnUnmountAutoFocus="@OnCloseAutoFocus">
        <CascadingValue Value="@_aria" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </BaseFocusScope>
}

@code {
    /// <summary>Dialog content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The ARIA role. Defaults to <c>dialog</c>; alert dialogs pass <c>alertdialog</c>.</summary>
    [Parameter] public string Role { get; set; } = "dialog";

    /// <summary>
    /// Render the content in place instead of moving it to the document body while open. By default
    /// the surface portals to the body so no ancestor stacking context or overflow clip can cover
    /// it; set <see langword="true"/> to keep it inside its parent DOM (useful under CSS containment,
    /// for print, or in tests that assert on local markup).
    /// </summary>
    [Parameter] public bool Inline { get; set; }

    /// <summary>Raised before auto-focusing the first tabbable on open. PreventDefault to focus something yourself.</summary>
    [Parameter] public EventCallback<FocusScopeEvent> OnOpenAutoFocus { get; set; }

    /// <summary>Raised before focus returns to the trigger on close. PreventDefault to handle focus yourself.</summary>
    [Parameter] public EventCallback<FocusScopeEvent> OnCloseAutoFocus { get; set; }

    /// <summary>
    /// Raised after the exit animation finishes and the content has unmounted. Hosts that render dialogs
    /// dynamically (e.g. <see cref="BaseDialogProvider"/>) use this to drop a closed instance only once its
    /// close animation has played - the exit-animation-complete hook.
    /// </summary>
    [Parameter] public EventCallback OnExitComplete { get; set; }

    [CascadingParameter] private DialogContext? Dialog { get; set; }

    private bool Modal => Dialog?.Modal ?? false;

    private AriaNameRegistry _aria = default!;
    private bool _present;
    private bool _closing;
    private bool _scrollLocked;
    private bool _ariaChecked;
    private bool _disposed;
    private ElementReference _element;
    private Task<IJSObjectReference>? _presenceTask;
    private Task<IJSObjectReference>? _portalTask;
    private Task? _scrollLockTask;
    private DotNetObjectReference<BaseDialogContent>? _selfRef;

    protected override void OnInitialized() =>
        // The registry re-renders THIS content when a title/description (de)registers; guard against a
        // notify arriving after disposal.
        _aria = new AriaNameRegistry(() => { if (!_disposed) _ = InvokeAsync(StateHasChanged); });

    protected override void OnParametersSet()
    {
        var open = Dialog?.Open ?? false;

        if (open && (!_present || _closing))
        {
            _present = true;
            _closing = false;
        }
        else if (!open && _present && !_closing)
        {
            _closing = true;
        }
    }

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder(this)
            .Set("role", Role)
            .Set("id", Dialog?.ContentId)
            .Data("state", _closing ? "closed" : "open")
            // A portaled surface leaves any subtree direction provider's DOM ancestry, so the
            // cascaded direction is stamped on the element itself (inline keeps inheritance).
            .Set("dir", Inline ? DirAttribute : PortalDirAttribute)
            .On("onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, OnKeyDownAsync));

        // Reference a title/description only when one is actually rendered - a dangling aria-labelledby/
        // describedby is worse than none (see AriaNameRegistry).
        if (_aria.HasTitle) props.Aria("labelledby", Dialog?.TitleId);
        if (_aria.HasDescription) props.Aria("describedby", Dialog?.DescriptionId);
        if (Modal) props.Aria("modal", true);

        return props.Merge(Attributes, Class, Style);
    }

    private Task OnKeyDownAsync(KeyboardEventArgs e) =>
        // Escape is an implicit dismissal - suppressed entirely when the dialog is locked.
        e.Key == "Escape" && Dialog is { PreventDismiss: false } ? Dialog.SetOpen.InvokeAsync(false) : Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_present) return;

        // Guards are claimed synchronously (before any await): OnAfterRenderAsync re-enters on every
        // render, and a slow module import must not let a second pass create/lock twice.
        _presenceTask ??= CreatePresenceAsync();
        if (!Inline) _portalTask ??= CreatePortalAsync();
        if (Modal && !_scrollLocked)
        {
            _scrollLocked = true;
            _scrollLockTask = LockScrollAsync();
        }

        if (!_ariaChecked)
        {
            _ariaChecked = true;
            await WarnIfUnnamedAsync();
        }

        if (_closing)
        {
            // No-animation skins report back immediately; otherwise animationend does.
            var presence = await _presenceTask;
            await presence.InvokeVoidAsync("onClosing");
        }
    }

    // A dialog needs an accessible name. Warn (a dev aid) when neither a BaseDialogTitle nor
    // a consumer-supplied aria-label/aria-labelledby is present once the content has rendered.
    private async Task WarnIfUnnamedAsync()
    {
        if (_aria.HasTitle || HasConsumerName()) return;
        try
        {
            await Js.InvokeVoidAsync("console.warn",
                "Blaizio Dialog: add a DialogTitle (visually hidden if needed) or an aria-label on the " +
                "content so screen readers can announce the dialog.");
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone.
        }
    }

    private bool HasConsumerName() =>
        Attributes is not null && (Attributes.ContainsKey("aria-label") || Attributes.ContainsKey("aria-labelledby"));

    private async Task<IJSObjectReference> CreatePresenceAsync()
    {
        _selfRef ??= DotNetObjectReference.Create(this);
        var module = await JsModules.ImportAsync(Js, "./_content/blaizio.base/dist/presence.js");
        return await module.InvokeAsync<IJSObjectReference>("createPresence", _element, _selfRef);
    }

    // Move the surface to <body> while open: an overlay surface has no positioning module to inherit
    // the portal from, so it attaches ts/portal.js itself. Disposed (moved back) before the unmount
    // render so Blazor removes the node from the tree it still owns.
    private async Task<IJSObjectReference> CreatePortalAsync()
    {
        var module = await JsModules.ImportAsync(Js, "./_content/blaizio.base/dist/portal.js");
        return await module.InvokeAsync<IJSObjectReference>("createPortal", _element);
    }

    private async Task LockScrollAsync()
    {
        var module = await JsModules.ImportAsync(Js, "./_content/blaizio.base/dist/scrollLock.js");
        await module.InvokeVoidAsync("lock");
    }

    [JSInvokable]
    public async Task OnCloseFinished()
    {
        if (!_closing) return;
        _present = false;
        _closing = false;
        await DisposePresenceAsync();
        await UnlockScrollAsync();
        // Portal restore precedes the unmount render: the node must be back at its placeholder
        // before Blazor removes it.
        await DisposePortalAsync();
        StateHasChanged();
        await OnExitComplete.InvokeAsync();
    }

    private async Task DisposePortalAsync()
    {
        // Claimed synchronously before any await: the close-finish callback and the component's
        // DisposeAsync can race here (a navigation disposes the component mid close-animation) -
        // the second caller must see null and no-op instead of double-disposing the JS reference.
        var task = _portalTask;
        _portalTask = null;
        if (task is null) return;
        try
        {
            var portal = await task;
            await portal.InvokeVoidAsync("dispose");
            await portal.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone.
        }
        catch (ObjectDisposedException)
        {
            // Already disposed by the concurrent caller.
        }
    }

    private async Task DisposePresenceAsync()
    {
        var task = _presenceTask;
        _presenceTask = null;
        if (task is null) return;
        try
        {
            var presence = await task;
            await presence.InvokeVoidAsync("dispose");
            await presence.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone.
        }
        catch (ObjectDisposedException)
        {
            // Already disposed by the concurrent caller.
        }
    }

    private async Task UnlockScrollAsync()
    {
        if (!_scrollLocked) return;
        _scrollLocked = false;
        try
        {
            // Make sure the lock call has landed before undoing it.
            if (_scrollLockTask is not null) await _scrollLockTask;
            var module = await JsModules.ImportAsync(Js, "./_content/blaizio.base/dist/scrollLock.js");
            await module.InvokeVoidAsync("unlock");
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone.
        }
        _scrollLockTask = null;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            // Instances only - the modules are shared via JsModules and outlive this component.
            await DisposePresenceAsync();
            await UnlockScrollAsync();
            await DisposePortalAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone.
        }
        catch (ObjectDisposedException)
        {
            // Already disposed by the racing close-finish callback.
        }

        _selfRef?.Dispose();
    }
}
