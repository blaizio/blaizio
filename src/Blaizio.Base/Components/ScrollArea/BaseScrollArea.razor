@namespace Blaizio
@inherits BzComponentBase
@inject IJSRuntime Js
@implements IAsyncDisposable
@*
    Headless ScrollArea root: a positioning context (<div data-slot="scroll-area">) that, on first
    render, wires the custom-overlay scrollbar engine (ts/scrollArea.ts) onto its subtree. The engine
    hides the native scrollbar (the viewport carries scrollbar-none) and draws a thumb sized + placed
    from the live scroll metrics over it - draggable, and shown/hidden per Type. The styled
    BzScrollArea supplies the viewport / scrollbar / thumb structure as ChildContent; the engine finds
    them by their data-slot hooks. Pure DOM - no C# round-trips.
*@

<BasePrimitive As="div"
                Attributes="BuildAttributes()"
                ChildContent="@ChildContent"
                ElementRefCaptured="@(reference => _element = reference)" />

@code {
    /// <summary>When the overlay scrollbars are shown. Defaults to <see cref="ScrollAreaType.Auto"/>.</summary>
    [Parameter] public ScrollAreaType Type { get; set; } = ScrollAreaType.Auto;

    /// <summary>The viewport, scrollbars and thumbs (supplied by the styled layer).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ElementReference _element;
    private IJSObjectReference? _module;
    private IJSObjectReference? _instance;

    private string TypeAttr => Type switch
    {
        ScrollAreaType.Always => "always",
        ScrollAreaType.Scroll => "scroll",
        ScrollAreaType.Hover => "hover",
        _ => "auto",
    };

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder(this).Data("slot", "scroll-area").Data("type", TypeAttr).Merge(Attributes, Class, Style);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _module = await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/blaizio.base/dist/scrollArea.js");
            _instance = await _module.InvokeAsync<IJSObjectReference>("createScrollArea", _element);
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone before the wiring landed.
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_instance is not null)
            {
                await _instance.InvokeVoidAsync("dispose");
                await _instance.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone.
        }
    }
}
