@namespace Blaizio
@inherits BzComponentBase
@* A link inside the menu (a top-level entry or inside a content panel). Choosing one closes the menu. *@

<BasePrimitive Element="a" Attributes="BuildAttributes()" ChildContent="@ChildContent" RenderAs="@RenderAs" />

@code {
    /// <summary>Marks the link as the current page (sets <c>data-active</c>).</summary>
    [Parameter] public bool Active { get; set; }

    /// <summary>Link content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the link onto your own element (e.g. a NavLink) instead of an <c>&lt;a&gt;</c>.</summary>
    [Parameter] public RenderFragment<BzRenderProps>? RenderAs { get; set; }

    [CascadingParameter] private BaseNavigationMenu? Root { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder(this)
            .Data("slot", "navigation-menu-link")
            .Data("active", Active ? "true" : "false")
            .On("onclick", EventCallback.Factory.Create(this, () => Root?.CloseNowAsync() ?? Task.CompletedTask))
            .Merge(Attributes, Class, Style);
}
