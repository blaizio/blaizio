@namespace Blaizio
@inherits BzComponentBase
@* A link inside the menu (a top-level entry or inside a content panel). Choosing one closes the menu. *@

<BasePrimitive Element="a" Attributes="BuildAttributes()" ChildContent="@ChildContent" RenderAs="@RenderAs" />

@code {
    /// <summary>Marks the link as the current page (sets <c>data-active</c>).</summary>
    [Parameter] public bool Active { get; set; }

    /// <summary>Link content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the link onto your own element (e.g. a NavLink) instead of an <c>&lt;a&gt;</c>.</summary>
    [Parameter] public RenderFragment<BzRenderProps>? RenderAs { get; set; }

    [CascadingParameter] private BaseNavigationMenu? Root { get; set; }
    [CascadingParameter] private BaseNavigationMenuContent? Content { get; set; }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder(this)
            .Data("slot", "navigation-menu-link")
            .Data("active", Active ? "true" : "false")
            .On("onpointerenter", EventCallback.Factory.Create(this, OnPointerEnter))
            .On("onclick", EventCallback.Factory.Create<MouseEventArgs>(this, () => Root?.CloseNowAsync() ?? Task.CompletedTask))
            .Merge(Attributes, Class, Style);

    // A top-level link owns no panel, so hovering it should dismiss whatever panel is open - the same
    // delayed close the menu runs when the pointer leaves it (cancelled if the pointer then lands on a
    // trigger or the panel). A link INSIDE a panel (Content is cascaded) does the opposite: it cancels
    // that pending close so travelling over the panel's own links keeps the panel open.
    private Task OnPointerEnter()
    {
        if (Root is null) return Task.CompletedTask;
        if (Content is not null) { Root.CancelClose(); return Task.CompletedTask; }
        return Root.ScheduleClose();
    }
}
