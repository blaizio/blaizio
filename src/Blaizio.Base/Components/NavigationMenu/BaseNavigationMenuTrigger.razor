@namespace Blaizio
@inherits BzComponentBase
@* The button that opens its item's content - on hover (after the menu's delay) or click. *@

<BasePrimitive As="button" Attributes="@BuildAttributes()" ChildContent="@ChildContent" RenderAs="@RenderAs" />

@code {
    /// <summary>Trigger content (label; the styled layer adds the chevron).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the trigger onto your own element instead of a <c>&lt;button&gt;</c>.</summary>
    [Parameter] public RenderFragment<BzRenderProps>? RenderAs { get; set; }

    [CascadingParameter] private BaseNavigationMenu? Root { get; set; }
    [CascadingParameter] private NavigationMenuItemContext? Item { get; set; }

    private string Id => Item?.Id ?? "";
    private bool Open => Root?.IsOpen(Id) ?? false;

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder(this)
            .Data("slot", "navigation-menu-trigger")
            .Data("state", Open ? "open" : "closed")
            .Aria("expanded", Open)
            .On("onpointerenter", EventCallback.Factory.Create(this, () => Root?.OpenAsync(Id) ?? Task.CompletedTask))
            .On("onclick", EventCallback.Factory.Create(this, () => Root?.ToggleAsync(Id) ?? Task.CompletedTask));
        if (RenderAs is null) props.Set("type", "button");
        return props.Merge(Attributes, Class, Style);
    }
}
