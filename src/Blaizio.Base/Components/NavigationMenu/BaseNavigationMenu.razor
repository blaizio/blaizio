@namespace Blaizio
@inherits BzComponentBase
@inject IJSRuntime Js
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Web
@*
    Headless navigation menu root. Owns which item is open (a value; "" = none) with the menu's hover
    feel: the FIRST open waits a short delay, switching between already-open items is instant, and
    leaving the whole menu closes after a brief delay (so the pointer can travel from a trigger down
    onto the content). Cascades itself so items/triggers/contents/links read + drive the state.

    In viewport mode each item's content is RELAYED into one shared viewport (rendered here, below the
    list) that morphs to the active content's size (measured by ts/navigationMenu.js); with viewport
    off each content drops inline under its own item.
*@

<CascadingValue Value="this" IsFixed="true">
    <div @ref="_root" @attributes="BuildAttributes()">
        @ChildContent
        @* Only mount the viewport while something is open - otherwise an empty bordered box of the last
           measured size lingers after the menu closes. (We trade the close animation for that.) *@
        @if (Viewport && IsAnyOpen && ActiveContent is { } frag)
        {
            <div class="@ViewportWrapperClass">
                <div data-slot="navigation-menu-viewport" data-state="open" class="@ViewportClass">
                    <div @key="OpenValue">@frag</div>
                </div>
            </div>
        }
    </div>
</CascadingValue>

@code {
    /// <summary>Controlled open item id ("" = none). Leave <see langword="null"/> for uncontrolled.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Initial open item id when uncontrolled.</summary>
    [Parameter] public string? DefaultValue { get; set; }

    /// <summary>Raised with the new open item id. Enables <c>@bind-Value</c>.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Relay each content into one shared, morphing viewport (the default). When off, content drops inline under its item.</summary>
    [Parameter] public bool Viewport { get; set; } = true;

    /// <summary>Milliseconds the pointer must rest on a trigger before the FIRST open. Unset inherits <see cref="BlaizioOptions"/> (200 out of the box).</summary>
    [Parameter] public int? OpenDelay { get; set; }

    /// <summary>Milliseconds after leaving the menu before it closes. Unset inherits <see cref="BlaizioOptions"/> (150 out of the box).</summary>
    [Parameter] public int? CloseDelay { get; set; }

    /// <summary>Classes for the viewport element (the styled layer passes the popover look here).</summary>
    [Parameter] public string? ViewportClass { get; set; }

    /// <summary>Classes for the wrapper that positions the viewport under the list.</summary>
    [Parameter] public string? ViewportWrapperClass { get; set; }

    /// <summary>The list (items, triggers, contents, links).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ElementReference _root;
    private string? _uncontrolled;
    private string _prevOpen = "";
    private bool _pointerOpened;
    private readonly Dictionary<string, RenderFragment> _contents = new(StringComparer.Ordinal);
    private readonly List<string> _order = new();
    private CancellationTokenSource? _cts;
    private IJSObjectReference? _instance;
    private DotNetObjectReference<BaseNavigationMenu>? _selfRef;

    private bool Controlled => ValueChanged.HasDelegate;
    private string OpenValue => Value ?? _uncontrolled ?? DefaultValue ?? "";
    private RenderFragment? ActiveContent => OpenValue != "" && _contents.TryGetValue(OpenValue, out var f) ? f : null;

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder(this)
            .Data("slot", "navigation-menu")
            .Data("viewport", Viewport ? "true" : "false")
            .On("onpointerleave", EventCallback.Factory.Create(this, ScheduleClose))
            .On("onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, KeyDown))
            .Merge(Attributes, Class, Style);

    /// <summary>Whether the given item is the open one (drives a trigger's data-state and a content's visibility).</summary>
    public bool IsOpen(string id) => OpenValue == id && id != "";

    /// <summary>Whether any item is open (drives the indicator's visibility).</summary>
    public bool IsAnyOpen => OpenValue != "";

    /// <summary>A content registers its fragment to be relayed into the shared viewport.</summary>
    public void RegisterContent(string id, RenderFragment fragment) => _contents[id] = fragment;

    /// <summary>An item registers its id (in document order, used for the switch-direction motion).</summary>
    public void RegisterItem(string id)
    {
        if (!_order.Contains(id)) _order.Add(id);
    }

    /// <summary>
    /// The slide direction for the content that's switching in: <c>from-end</c> when the newly-open item
    /// sits after the previously-open one, <c>from-start</c> when before, <see langword="null"/> on a fresh
    /// open (no previous) - so the children slide across as the viewport morphs, not just the box.
    /// </summary>
    public string? MotionFor(string id)
    {
        if (id != OpenValue || OpenValue == "" || _prevOpen == "" || _prevOpen == OpenValue) return null;
        var pi = _order.IndexOf(_prevOpen);
        var ci = _order.IndexOf(OpenValue);
        if (pi < 0 || ci < 0) return null;
        return pi < ci ? "from-end" : "from-start";
    }

    /// <summary>Hover/focus on a trigger: open it after the delay when nothing is open, or switch instantly when something already is.</summary>
    public async Task OpenAsync(string id)
    {
        CancelPending();
        if (OpenValue == id) return;
        if (OpenValue != "") { await SetValueAsync(id); _pointerOpened = true; return; } // instant switch
        var cts = _cts = new CancellationTokenSource();
        try { await Task.Delay(OpenDelay ?? Options.NavigationMenu.OpenDelay, cts.Token); }
        catch (TaskCanceledException) { return; }
        await SetValueAsync(id);
        _pointerOpened = true; // remember it opened on hover so the click that follows doesn't slam it shut
    }

    /// <summary>
    /// Click on a trigger. Opens a closed item instantly; on an already-open item it closes - UNLESS the
    /// open just happened on hover (the pointer-open guard), in which case the first click is swallowed so a
    /// "hover then click before the panel appeared" doesn't immediately close it. A second click then closes.
    /// </summary>
    public Task ToggleAsync(string id)
    {
        CancelPending();
        if (OpenValue != id) { _pointerOpened = false; return SetValueAsync(id); }
        if (_pointerOpened) { _pointerOpened = false; return Task.CompletedTask; }
        return SetValueAsync("");
    }

    /// <summary>Pointer left the whole menu: close after the delay.</summary>
    public async Task ScheduleClose()
    {
        CancelPending();
        if (OpenValue == "") return;
        var cts = _cts = new CancellationTokenSource();
        try { await Task.Delay(CloseDelay ?? Options.NavigationMenu.CloseDelay, cts.Token); }
        catch (TaskCanceledException) { return; }
        await SetValueAsync("");
    }

    /// <summary>Cancel a pending close - the content calls this on pointer-enter so hovering the panel
    /// keeps it open. (The panel sits a small gap below the bar, so crossing that gap fires the root's
    /// pointerleave and schedules a close; landing on the panel cancels it.)</summary>
    public void CancelClose() => CancelPending();

    /// <summary>Close now (Escape, or a link was chosen).</summary>
    public Task CloseNowAsync()
    {
        CancelPending();
        return OpenValue == "" ? Task.CompletedTask : SetValueAsync("");
    }

    private async Task SetValueAsync(string value)
    {
        _prevOpen = OpenValue; // capture the outgoing item so MotionFor can pick the slide direction
        if (!Controlled) _uncontrolled = value;
        await ValueChanged.InvokeAsync(value);
        StateHasChanged();
    }

    private Task KeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? CloseNowAsync() : Task.CompletedTask;

    /// <summary>Called from JS when a pointer goes down outside the menu - dismiss the open panel.</summary>
    [JSInvokable]
    public Task CloseFromOutside() => CloseNowAsync();

    private void CancelPending()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var module = await JsModules.ImportAsync(Js, "./_content/blaizio.base/dist/navigationMenu.js");
            _selfRef ??= DotNetObjectReference.Create(this);
            _instance = await module.InvokeAsync<IJSObjectReference>("createNavMenu", _root, _selfRef);
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone.
        }
    }

    public async ValueTask DisposeAsync()
    {
        CancelPending();
        try
        {
            // Instances only - the modules are shared via JsModules and outlive this component.
            if (_instance is not null) { await _instance.InvokeVoidAsync("dispose"); await _instance.DisposeAsync(); }
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone.
        }
        _selfRef?.Dispose();
    }
}
