@namespace Blaizio
@inherits BzComponentBase
@implements IDisposable
@*
    Avatar fallback - rendered only while the image hasn't successfully loaded (loading or error).
*@

@if (Avatar?.Status != AvatarStatus.Loaded)
{
    <BasePrimitive As="span" Attributes="@BuildAttributes()" ChildContent="@ChildContent" />
}

@code {
    [CascadingParameter] private BaseAvatar? Avatar { get; set; }

    /// <summary>Fallback content - typically initials.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        if (Avatar is not null) Avatar.StatusChanged += Refresh;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (Avatar is not null) Avatar.StatusChanged -= Refresh;
    }

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder().Data("slot", "avatar-fallback").Merge(Attributes, Class, Style);
}
