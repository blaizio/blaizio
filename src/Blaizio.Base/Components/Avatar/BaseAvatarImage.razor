@namespace Blaizio
@inherits BzComponentBase
@implements IDisposable
@*
    Avatar image. Always present in the DOM (so it can load), but hidden until its native load
    event fires; reports success/failure to the ancestor BaseAvatar so the fallback can react.
*@

<img src="@Src" alt="@Alt" data-slot="avatar-image"
     class="@Class" style="@CurrentStyle"
     @onload="OnLoad" @onerror="OnError"
     @attributes="Attributes" />

@code {
    [CascadingParameter] private BaseAvatar? Avatar { get; set; }

    /// <summary>Image URL.</summary>
    [Parameter] public string? Src { get; set; }

    /// <summary>Alt text.</summary>
    [Parameter] public string? Alt { get; set; }

    private string CurrentStyle =>
        Avatar?.Status == ImageStatus.Loaded ? (Style ?? string.Empty) : $"display:none;{Style}";

    protected override void OnInitialized()
    {
        if (Avatar is not null) Avatar.StatusChanged += Refresh;
    }

    private void OnLoad() => Avatar?.Report(ImageStatus.Loaded);
    private void OnError() => Avatar?.Report(ImageStatus.Error);
    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (Avatar is not null) Avatar.StatusChanged -= Refresh;
    }
}
