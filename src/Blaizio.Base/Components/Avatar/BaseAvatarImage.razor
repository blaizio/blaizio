@namespace Blaizio
@inherits BzComponentBase
@implements IDisposable
@*
    Avatar image. Always present in the DOM (so it can load), but hidden until its native load
    event fires; reports success/failure to the ancestor BaseAvatar so the fallback can react.

    A statically rendered page has no Blazor events, so nothing would ever report the load and
    the image would stay hidden for good. There the swap is done by the element itself: its own
    load handler shows it and hides the fallback beside it. Where inline handlers are blocked
    (a strict Content-Security-Policy) the fallback simply stays, as before.
*@

@if (IsInteractive)
{
    <img src="@Src" alt="@Alt" data-slot="avatar-image"
         class="@Class" style="@CurrentStyle"
         @onload="OnLoad" @onerror="OnError"
         @attributes="Attributes" />
}
else
{
    <img src="@Src" alt="@Alt" data-slot="avatar-image"
         class="@Class" style="@CurrentStyle"
         onload="@StaticOnLoad"
         @attributes="Attributes" />
}

@code {
    [CascadingParameter] private BaseAvatar? Avatar { get; set; }

    /// <summary>Image URL.</summary>
    [Parameter] public string? Src { get; set; }

    /// <summary>Alt text.</summary>
    [Parameter] public string? Alt { get; set; }

    // Shows the image and hides the fallback once the image has loaded, and does it again whenever
    // the element's style is put back. Enhanced navigation merges the next page into this one: it
    // keeps the element, restores the server's display:none and clears the fallback's style, and
    // since src did not change no second load event comes. The observer sits on the element, so it
    // goes away with it; the "complete" test keeps a source that is still loading hidden.
    private const string StaticOnLoad =
        "var i=this,s=function(){" +
        "if(!i.complete||!i.naturalWidth)return;" +
        "if(i.style.display)i.style.display='';" +
        "var f=i.parentElement&&i.parentElement.querySelector('[data-slot=avatar-fallback]');" +
        "if(f&&f.style.display!=='none')f.style.display='none'};" +
        "s();" +
        "if(!i.bzSwap&&window.MutationObserver){i.bzSwap=new MutationObserver(s);i.bzSwap.observe(i,{attributes:true,attributeFilter:['style']})}";

    private string CurrentStyle =>
        Avatar?.Status == ImageStatus.Loaded ? (Style ?? string.Empty) : $"display:none;{Style}";

    protected override void OnInitialized()
    {
        if (Avatar is not null) Avatar.StatusChanged += Refresh;
    }

    private string? _lastSrc;
    private bool _srcSeen;

    // The status only moves on the image's load and error events, and a source that is taken away
    // fires neither: the image stayed "loaded" with nothing to show and the fallback stayed away.
    protected override void OnParametersSet()
    {
        if (_srcSeen && _lastSrc == Src) return;
        var changed = _srcSeen;
        (_srcSeen, _lastSrc) = (true, Src);
        if (!changed) return;
        Avatar?.Report(string.IsNullOrEmpty(Src) ? ImageStatus.Error : ImageStatus.Loading);
    }

    private void OnLoad() => Avatar?.Report(ImageStatus.Loaded);
    private void OnError() => Avatar?.Report(ImageStatus.Error);
    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (Avatar is not null) Avatar.StatusChanged -= Refresh;
    }
}
