@namespace Blaizio
@inherits BzComponentBase
@inject IJSRuntime Js
@implements IAsyncDisposable
@*
    Reusable roving-tabindex container - the keyboard-navigation half of radio groups, toggle groups,
    toolbars, and tabs. Items inside mark themselves with `data-bz-roving-item`; arrow keys move
    focus between them and only one is ever in the tab sequence. Behaviour lives in ts/rovingFocus.ts
    and is wholly DOM-side (no per-keystroke interop) - this is just the thin wrapper that attaches it.
*@

<BasePrimitive Element="div"
                Attributes="BuildAttributes()"
                ChildContent="@ChildContent"
                ElementRefCaptured="@(reference => _container = reference)" />

@code {
    /// <summary>Which arrow axis navigates. Defaults to <see cref="Blaizio.Orientation.Horizontal"/>.</summary>
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Horizontal;

    /// <summary>Wrap around at the ends. Defaults to <see langword="false"/>.</summary>
    [Parameter] public bool Loop { get; set; }

    /// <summary>Activate (click) an item as arrow-navigation focuses it - the ARIA radio pattern.</summary>
    [Parameter] public bool SelectOnFocus { get; set; }

    /// <summary>The roving items.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ElementReference _container;
    private IJSObjectReference? _module;
    private IJSObjectReference? _instance;

    // `dir` is emitted only when an explicit Dir is set (DirAttribute) - it pins the reading direction
    // on the container so the live getComputedStyle read in rovingFocus.ts and the group's CSS follow
    // this override; with no explicit Dir it inherits the ambient direction (DirectionProvider / <html>).
    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder().Data("orientation", Orientation.ToAttribute()).Set("dir", DirAttribute).Merge(Attributes, Class, Style);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _module = await Js.InvokeAsync<IJSObjectReference>(
            "import", "./_content/blaizio.base/dist/rovingFocus.js");
        _instance = await _module.InvokeAsync<IJSObjectReference>("createRovingFocus", _container, new
        {
            orientation = Orientation == Orientation.Vertical ? "vertical" : "horizontal",
            dir = ResolvedDirection.ToAttribute(),
            loop = Loop,
            selectOnFocus = SelectOnFocus,
        });
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_instance is not null)
            {
                await _instance.InvokeVoidAsync("dispose");
                await _instance.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone (navigation / refresh) - nothing to clean up.
        }
    }
}
