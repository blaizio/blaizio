@namespace Blaizio
@inherits BzComponentBase
@inject IJSRuntime Js
@implements IAsyncDisposable
@*
    Traps and/or loops keyboard focus within its container - the focus-management half of every
    overlay (Dialog, Popover, Menu). Pairs with DismissableLayer (Esc / outside-click), which is a
    separate primitive. Behaviour lives in ts/focusScope.ts; this is the thin Blazor wrapper.
*@

<BasePrimitive Element="div"
                Attributes="BuildAttributes()"
                ElementRefCaptured="@OnRefCaptured">
    @ChildContent
</BasePrimitive>

@code {
    /// <summary>Content whose focus is managed.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Forwards the container's element reference (e.g. for presence tracking on the same element).</summary>
    [Parameter] public Action<ElementReference>? ElementRefCaptured { get; set; }

    /// <summary>Tab past the last tabbable wraps to the first (and vice-versa). Defaults to <see langword="false"/>.</summary>
    [Parameter] public bool Loop { get; set; }

    /// <summary>Focus cannot leave the container by keyboard, pointer, or script. Defaults to <see langword="false"/>.</summary>
    [Parameter] public bool Trapped { get; set; }

    /// <summary>Raised before auto-focusing on first render. <see cref="FocusScopeEvent.PreventDefault"/> to handle focus yourself.</summary>
    [Parameter] public EventCallback<FocusScopeEvent> OnOpenAutoFocus { get; set; }

    /// <summary>Raised before restoring focus on removal. <see cref="FocusScopeEvent.PreventDefault"/> to handle focus yourself.</summary>
    [Parameter] public EventCallback<FocusScopeEvent> OnCloseAutoFocus { get; set; }

    /// <summary>The earlier name of <see cref="OnOpenAutoFocus"/>.</summary>
    [Obsolete("Use OnOpenAutoFocus.")]
    [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
    [Parameter] public EventCallback<FocusScopeEvent> OnMountAutoFocus { get => OnOpenAutoFocus; set => OnOpenAutoFocus = value; }

    /// <summary>The earlier name of <see cref="OnCloseAutoFocus"/>.</summary>
    [Obsolete("Use OnCloseAutoFocus.")]
    [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
    [Parameter] public EventCallback<FocusScopeEvent> OnUnmountAutoFocus { get => OnCloseAutoFocus; set => OnCloseAutoFocus = value; }

    private ElementReference _container;
    private readonly JsInstance _scope = new();
    private DotNetObjectReference<BaseFocusScope>? _selfRef;

    // tabindex="-1" lets the container itself hold focus when nothing inside is tabbable.
    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder().Set("tabindex", "-1").Merge(Attributes, Class, Style);

    private void OnRefCaptured(ElementReference reference)
    {
        _container = reference;
        ElementRefCaptured?.Invoke(reference);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var module = await JsModules.ImportAsync(Js, "./_content/blaizio.base/dist/focusScope.js");
        _selfRef = DotNetObjectReference.Create(this);
        await _scope.CreateAsync(module, "createFocusScope", _container, _selfRef, new
        {
            loop = Loop,
            trapped = Trapped,
            hasOpenAutoFocus = OnOpenAutoFocus.HasDelegate,
            hasCloseAutoFocus = OnCloseAutoFocus.HasDelegate,
        });
    }

    [JSInvokable]
    public async Task<bool> HandleOpenAutoFocus()
    {
        var args = new FocusScopeEvent();
        await OnOpenAutoFocus.InvokeAsync(args);
        return args.DefaultPrevented;
    }

    [JSInvokable]
    public async Task<bool> HandleCloseAutoFocus()
    {
        var args = new FocusScopeEvent();
        await OnCloseAutoFocus.InvokeAsync(args);
        return args.DefaultPrevented;
    }

    /// <summary>The earlier name of <see cref="HandleOpenAutoFocus"/>.</summary>
    [Obsolete("Use HandleOpenAutoFocus.")]
    [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
    public Task<bool> HandleMountAutoFocus() => HandleOpenAutoFocus();

    /// <summary>The earlier name of <see cref="HandleCloseAutoFocus"/>.</summary>
    [Obsolete("Use HandleCloseAutoFocus.")]
    [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
    public Task<bool> HandleUnmountAutoFocus() => HandleCloseAutoFocus();

    public async ValueTask DisposeAsync()
    {
        // Instances only - the modules are shared via JsModules and outlive this component.
        await _scope.DisposeAsync();
        _selfRef?.Dispose();
    }
}
