@namespace Blaizio
@inherits BzComponentBase
@*
    Hides content visually while keeping it available to screen readers and other assistive tech
    (the standard "sr-only" clip technique). Used for accessible labels on icon-only controls,
    live-region announcements, etc.

    Note: this is the ONE place the headless layer emits inline CSS - it is an accessibility
    behaviour, not theming, so it ships with the primitive rather than the styled layer.
*@

<BasePrimitive As="span" Attributes="BuildAttributes()">@ChildContent</BasePrimitive>

@code {
    /// <summary>The content to hide visually but keep accessible.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private const string ClipStyle =
        "position:absolute;border:0;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;" +
        "clip:rect(0,0,0,0);white-space:nowrap;clip-path:inset(50%);";

    private IReadOnlyDictionary<string, object> BuildAttributes() =>
        new PropBuilder().Merge(Attributes, Class, ClipStyle + (Style ?? string.Empty));
}
