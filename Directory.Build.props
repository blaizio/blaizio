<Project>

  <!--
    Shared build settings for every Blaizio project.
    .NET 10 / C# 14, nullable + implicit usings on, XML docs generated.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Don't fail the build for missing XML docs on every internal member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Authors>Blaizio</Authors>
    <Company>Blaizio</Company>
    <Product>Blaizio</Product>
    <!-- Fail restore loudly on known-vulnerable packages, direct AND transitive (NU1901-NU1904). -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

</Project>
