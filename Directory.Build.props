<Project>

  <!--
    Shared build settings for every Blaizio project.
    .NET 10 / C# 14, nullable + implicit usings on, XML docs generated.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Don't fail the build for missing XML docs on every internal member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Authors>Blaizio</Authors>
    <Company>Blaizio</Company>
    <Product>Blaizio</Product>
    <!-- Fail restore loudly on known-vulnerable packages, direct AND transitive (NU1901-NU1904). -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <!--
    Sandboxed build outputs for the e2e suite: its fixture builds the docs app (and every
    referenced project) with BlaizioIsolatedOutput set, moving bin/obj under that root so the
    test build never deletes the fingerprinted _framework files a live dev server is serving
    from the normal bin. This must live HERE (evaluated before the SDK's common props) - the
    intermediate path is fixed by then. The explicit bin/obj excludes keep the projects' OLD
    output folders out of the default item globs, which only exclude the CURRENT paths -
    without them every generated AssemblyInfo in a stale obj compiles twice (CS0579).
  -->
  <PropertyGroup Condition="'$(BlaizioIsolatedOutput)' != ''">
    <BaseOutputPath>$(BlaizioIsolatedOutput)/$(MSBuildProjectName)/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(BlaizioIsolatedOutput)/$(MSBuildProjectName)/obj/</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
