<Project>

  <!--
    Shared build settings for every Blaizio project.
    .NET 10 / C# 14, nullable + implicit usings on, XML docs generated.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Don't fail the build for missing XML docs on every internal member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Authors>Blaizio</Authors>
    <Company>Blaizio</Company>
    <Product>Blaizio</Product>
    <!-- Fail restore loudly on known-vulnerable packages, direct AND transitive (NU1901-NU1904). -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <!--
    ONE version for the Blaizio.Base / Blaizio.Icons packages, so the two can never split (a
    consumer that restores mismatched halves fails with MSB3375), and so nothing has to be edited
    in four places to move them.

    NuGet caches by id+version and never re-extracts a version it already holds, which makes
    republishing DIFFERENT bytes under one version invisible: the consumer compiles against the new
    package, loads the old assembly, and gets a TypeLoadException at runtime that only a cache
    eviction plus a clean obj/bin clears. So packed bytes are immutable here: every version is
    packed once. The docs dogfood loop, which repacks on every edit to Base or Icons, mints a
    private revision instead (BlaizioPackRevision, owned by the docs pack target) - it appends a
    fourth identifier, sorts above the plain version, and is never the version handed to anyone.
    Directory.Build.targets fails any pack that would overwrite an existing .nupkg.
  -->
  <PropertyGroup>
    <BlaizioVersionBase>0.1.0-alpha.36</BlaizioVersionBase>
    <BlaizioPackageVersion Condition="'$(BlaizioPackRevision)' == ''">$(BlaizioVersionBase)</BlaizioPackageVersion>
    <BlaizioPackageVersion Condition="'$(BlaizioPackRevision)' != ''">$(BlaizioVersionBase).$(BlaizioPackRevision)</BlaizioPackageVersion>
  </PropertyGroup>

  <!--
    Sandboxed build outputs for the e2e suite: its fixture builds the docs app (and every
    referenced project) with BlaizioIsolatedOutput set, moving bin/obj under that root so the
    test build never deletes the fingerprinted _framework files a live dev server is serving
    from the normal bin. This must live HERE (evaluated before the SDK's common props) - the
    intermediate path is fixed by then. The explicit bin/obj excludes keep the projects' OLD
    output folders out of the default item globs, which only exclude the CURRENT paths -
    without them every generated AssemblyInfo in a stale obj compiles twice (CS0579).
  -->
  <PropertyGroup Condition="'$(BlaizioIsolatedOutput)' != ''">
    <BaseOutputPath>$(BlaizioIsolatedOutput)/$(MSBuildProjectName)/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(BlaizioIsolatedOutput)/$(MSBuildProjectName)/obj/</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
