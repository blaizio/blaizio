<Project>

  <!--
    Shared build settings for every Blazeo project.
    .NET 10 / C# 14, nullable + implicit usings on, XML docs generated.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Don't fail the build for missing XML docs on every internal member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Authors>finalstack</Authors>
    <Company>finalstack</Company>
    <Product>Blazeo</Product>
  </PropertyGroup>

</Project>
