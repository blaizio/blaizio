<?xml version="1.0" encoding="utf-8"?>
<!-- The local folder feed carries the packed Blaizio.Base / Blaizio.Icons the docs build
     consumes until the packages are published to nuget.org. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="blaizio-local" value="artifacts/local-nuget" />
  </packageSources>
</configuration>
