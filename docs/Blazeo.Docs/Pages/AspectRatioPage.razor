@page "/components/aspect-ratio"
<PageTitle>Aspect Ratio - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Aspect Ratio</h1>
        <p class="text-muted-foreground">Constrains content to a width:height ratio - even before it loads.</p>
    </header>

    <Demo Title="16 : 9" Code="@DefaultCode">
        <div class="w-full max-w-sm">
            <AspectRatio Ratio="@(16.0 / 9)" Class="overflow-hidden rounded-lg">
                <img src="https://picsum.photos/seed/blazeo/800/450" alt="Landscape" class="size-full object-cover" />
            </AspectRatio>
        </div>
    </Demo>

    <Demo Title="Square" Code="@SquareCode">
        <div class="w-full max-w-48">
            <AspectRatio Class="flex items-center justify-center overflow-hidden rounded-lg bg-muted">
                <span class="text-sm text-muted-foreground">1 : 1</span>
            </AspectRatio>
        </div>
    </Demo>
</div>

@code {
    private const string DefaultCode = """
        <AspectRatio Ratio="@(16.0 / 9)" Class="overflow-hidden rounded-lg">
            <img src="..." class="size-full object-cover" />
        </AspectRatio>
        """;

    private const string SquareCode = """
        <AspectRatio Class="flex items-center justify-center rounded-lg bg-muted">
            <span>1 : 1</span>
        </AspectRatio>
        """;
}
