@page "/components/skeleton"
<PageTitle>Skeleton - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Skeleton</h1>
        <p class="text-muted-foreground">An animated placeholder while content loads. Shimmers left to right by default; honors the OS/browser reduced-motion setting.</p>
    </header>

    <UsageBlock Setup="@UsageSetup" Code="@UsageMarkup" />

    <ExamplesHeading />

    <Demo Title="Default" Code="@DefaultCode">
        <div class="flex w-full max-w-sm items-center gap-4">
            <BzSkeleton Class="size-10 rounded-full" />
            <div class="flex-1 space-y-2">
                <BzSkeleton Class="h-4 w-3/4" />
                <BzSkeleton Class="h-4 w-1/2" />
            </div>
        </div>
    </Demo>

    <Demo Title="Animations" Code="@AnimationsCode">
        <div class="flex w-full max-w-sm flex-col gap-5">
            <div class="space-y-2">
                <p class="text-muted-foreground text-sm">Shimmer (default)</p>
                <BzSkeleton Class="h-6 w-full" />
            </div>
            <div class="space-y-2">
                <p class="text-muted-foreground text-sm">Pulse</p>
                <BzSkeleton Animation="SkeletonAnimation.Pulse" Class="h-6 w-full" />
            </div>
            <div class="space-y-2">
                <p class="text-muted-foreground text-sm">None</p>
                <BzSkeleton Animation="SkeletonAnimation.None" Class="h-6 w-full" />
            </div>
        </div>
    </Demo>

    <Demo Title="Card" Code="@CardCode">
        <div class="flex w-full max-w-sm flex-col gap-3">
            <BzSkeleton Class="h-32 w-full rounded-xl" />
            <BzSkeleton Class="h-4 w-2/3" />
            <BzSkeleton Class="h-4 w-1/3" />
        </div>
    </Demo>

    <Demo Title="Customization"
          Description="Skeletons are plain elements - set the size, shape, and tint with Class."
          Code="@CustomCode">
        <div class="flex w-full max-w-sm items-center gap-4">
            <BzSkeleton Animation="SkeletonAnimation.Pulse" Class="size-12 rounded-xl bg-indigo-200/70 dark:bg-indigo-500/25" />
            <div class="flex-1 space-y-2">
                <BzSkeleton Animation="SkeletonAnimation.Pulse" Class="h-4 w-3/4 bg-indigo-200/70 dark:bg-indigo-500/25" />
                <BzSkeleton Animation="SkeletonAnimation.Pulse" Class="h-4 w-1/2 bg-indigo-200/70 dark:bg-indigo-500/25" />
            </div>
        </div>
    </Demo>
    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the avatar and lines mirror to the right." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <div class="flex w-full max-w-sm items-center gap-4">
                <BzSkeleton Class="size-10 rounded-full" />
                <div class="flex-1 space-y-2">
                    <BzSkeleton Class="h-4 w-3/4" />
                    <BzSkeleton Class="h-4 w-1/2" />
                </div>
            </div>
        </BzDirectionProvider>
    </Demo>
    <ApiReference Types="ApiFamilies.Skeleton" />
</div>

@code {
    private const string UsageSetup = """
        @* _Imports.razor (or the top of the page) *@
        @using Blazeo.Ui
        """;

    private const string UsageMarkup = """
        <BzSkeleton Class="h-4 w-48" />
        """;

    private const string CustomCode = """
        <BzSkeleton Animation="SkeletonAnimation.Pulse" Class="size-12 rounded-xl bg-indigo-200/70 dark:bg-indigo-500/25" />
        <BzSkeleton Animation="SkeletonAnimation.Pulse" Class="h-4 w-3/4 bg-indigo-200/70 dark:bg-indigo-500/25" />
        <BzSkeleton Animation="SkeletonAnimation.Pulse" Class="h-4 w-1/2 bg-indigo-200/70 dark:bg-indigo-500/25" />
        """;

    private const string DefaultCode = """
        <div class="flex items-center gap-4">
            <BzSkeleton Class="size-10 rounded-full" />
            <div class="flex-1 space-y-2">
                <BzSkeleton Class="h-4 w-3/4" />
                <BzSkeleton Class="h-4 w-1/2" />
            </div>
        </div>
        """;

    private const string AnimationsCode = """
        <BzSkeleton Class="h-6 w-full" />
        <BzSkeleton Animation="SkeletonAnimation.Pulse" Class="h-6 w-full" />
        <BzSkeleton Animation="SkeletonAnimation.None" Class="h-6 w-full" />
        """;

    private const string CardCode = """
        <BzSkeleton Class="h-32 w-full rounded-xl" />
        <BzSkeleton Class="h-4 w-2/3" />
        <BzSkeleton Class="h-4 w-1/3" />
        """;

    private const string RtlCode = """
        <BzDirectionProvider Direction="Direction.Rtl">
            <div class="flex items-center gap-4">
                <BzSkeleton Class="size-10 rounded-full" />
                <div class="flex-1 space-y-2">
                    <BzSkeleton Class="h-4 w-3/4" />
                    <BzSkeleton Class="h-4 w-1/2" />
                </div>
            </div>
        </BzDirectionProvider>
        """;
}
