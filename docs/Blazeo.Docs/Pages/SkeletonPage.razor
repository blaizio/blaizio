@page "/components/skeleton"
<PageTitle>Skeleton - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Skeleton</h1>
        <p class="text-muted-foreground">An animated placeholder while content loads. Shimmers left to right by default; honors the OS/browser reduced-motion setting.</p>
    </header>

    <Demo Title="Default" Code="@DefaultCode">
        <div class="flex w-full max-w-sm items-center gap-4">
            <Skeleton Class="size-10 rounded-full" />
            <div class="flex-1 space-y-2">
                <Skeleton Class="h-4 w-3/4" />
                <Skeleton Class="h-4 w-1/2" />
            </div>
        </div>
    </Demo>

    <Demo Title="Animations" Code="@AnimationsCode">
        <div class="flex w-full max-w-sm flex-col gap-5">
            <div class="space-y-2">
                <p class="text-muted-foreground text-sm">Shimmer (default)</p>
                <Skeleton Class="h-6 w-full" />
            </div>
            <div class="space-y-2">
                <p class="text-muted-foreground text-sm">Pulse</p>
                <Skeleton Animation="SkeletonAnimation.Pulse" Class="h-6 w-full" />
            </div>
            <div class="space-y-2">
                <p class="text-muted-foreground text-sm">None</p>
                <Skeleton Animation="SkeletonAnimation.None" Class="h-6 w-full" />
            </div>
        </div>
    </Demo>

    <Demo Title="Card" Code="@CardCode">
        <div class="flex w-full max-w-sm flex-col gap-3">
            <Skeleton Class="h-32 w-full rounded-xl" />
            <Skeleton Class="h-4 w-2/3" />
            <Skeleton Class="h-4 w-1/3" />
        </div>
    </Demo>
</div>

@code {
    private const string DefaultCode = """
        <div class="flex items-center gap-4">
            <Skeleton Class="size-10 rounded-full" />
            <div class="flex-1 space-y-2">
                <Skeleton Class="h-4 w-3/4" />
                <Skeleton Class="h-4 w-1/2" />
            </div>
        </div>
        """;

    private const string AnimationsCode = """
        <Skeleton Class="h-6 w-full" />
        <Skeleton Animation="SkeletonAnimation.Pulse" Class="h-6 w-full" />
        <Skeleton Animation="SkeletonAnimation.None" Class="h-6 w-full" />
        """;

    private const string CardCode = """
        <Skeleton Class="h-32 w-full rounded-xl" />
        <Skeleton Class="h-4 w-2/3" />
        <Skeleton Class="h-4 w-1/3" />
        """;
}
