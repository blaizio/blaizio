        @code {
            private bool _bookmarks = true;
            private bool _fullUrls;
            private string _person = "jane";

            // Keep the menu open so several boxes can be toggled in one visit.
            private static void KeepOpen(MenuSelectEventArgs e) => e.PreventDefault();
        }
        """;

    private const string RtlCode = """
        <DirectionProvider Direction="Direction.Rtl">
            <ContextMenu>
                <ContextMenuTrigger Class="flex h-40 w-full max-w-md items-center justify-center rounded-md border border-dashed text-sm text-muted-foreground">
