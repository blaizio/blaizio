@page "/components/context-menu"
<PageTitle>Context Menu - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Context Menu</h1>
        <p class="text-muted-foreground">A menu of actions triggered by a right-click, opening at the pointer and positioned with <a class="font-medium text-foreground underline underline-offset-4" href="https://floating-ui.com" target="_blank" rel="noopener">Floating UI</a>. It shares the dropdown menu's surface - the same keyboard support (arrow keys, Home/End, type-ahead, Enter/Space, Escape), checkbox and radio items, labels, separators, and nested submenus. It is <strong>non-modal</strong>: the rest of the page stays interactive while it is open.</p>
    </header>

    <Demo Title="Default" Description="Right-click the area to open the menu at the pointer. It carries items with shortcuts, a nested submenu, a disabled item, checkbox and radio sections, and a destructive action. Navigate with the arrow keys or by typing; Escape closes it." Code="@DefaultCode">
        <ContextMenu>
            <ContextMenuTrigger Class="border-border text-muted-foreground flex h-40 w-full max-w-md items-center justify-center rounded-md border border-dashed text-sm">
                Right-click here
            </ContextMenuTrigger>
            <ContextMenuContent Class="w-52">
                <ContextMenuItem>
                    Back
                    <ContextMenuShortcut>⌘[</ContextMenuShortcut>
                </ContextMenuItem>
                <ContextMenuItem Disabled>
                    Forward
                    <ContextMenuShortcut>⌘]</ContextMenuShortcut>
                </ContextMenuItem>
                <ContextMenuItem>
                    Reload
                    <ContextMenuShortcut>⌘R</ContextMenuShortcut>
                </ContextMenuItem>
                <ContextMenuSub>
                    <ContextMenuSubTrigger>More Tools</ContextMenuSubTrigger>
                    <ContextMenuSubContent Class="w-48">
                        <ContextMenuItem>
                            Save Page As…
                            <ContextMenuShortcut>⇧⌘S</ContextMenuShortcut>
                        </ContextMenuItem>
                        <ContextMenuItem>Create Shortcut…</ContextMenuItem>
                        <ContextMenuItem>Name Window…</ContextMenuItem>
                        <ContextMenuSeparator />
                        <ContextMenuItem>Developer Tools</ContextMenuItem>
                    </ContextMenuSubContent>
                </ContextMenuSub>
                <ContextMenuSeparator />
                <ContextMenuCheckboxItem @bind-Checked="_bookmarks" OnSelect="KeepOpen">
                    Show Bookmarks
                    <ContextMenuShortcut>⌘⇧B</ContextMenuShortcut>
                </ContextMenuCheckboxItem>
                <ContextMenuCheckboxItem @bind-Checked="_fullUrls" OnSelect="KeepOpen">Show Full URLs</ContextMenuCheckboxItem>
                <ContextMenuSeparator />
                <ContextMenuLabel>People</ContextMenuLabel>
                <ContextMenuRadioGroup @bind-Value="_person">
                    <ContextMenuRadioItem Value="jane">Jane Doe</ContextMenuRadioItem>
                    <ContextMenuRadioItem Value="john">John Smith</ContextMenuRadioItem>
                </ContextMenuRadioGroup>
                <ContextMenuSeparator />
                <ContextMenuItem Variant="ContextMenuItemVariant.Destructive">
                    Delete
                    <ContextMenuShortcut>⌫</ContextMenuShortcut>
                </ContextMenuItem>
            </ContextMenuContent>
        </ContextMenu>
    </Demo>

    <Demo Title="Items with icons" Description="A clipboard menu where each action leads with an icon on the inline-start and a keyboard shortcut on the inline-end, closing with a destructive Delete." Code="@IconsCode">
        <ContextMenu>
            <ContextMenuTrigger Class="border-border text-muted-foreground flex h-40 w-full max-w-md items-center justify-center rounded-md border border-dashed text-sm">
                Right-click here
            </ContextMenuTrigger>
            <ContextMenuContent Class="w-52">
                <ContextMenuItem>
                    <BzIcon Icon="@Icons.Outline.Scissors" />
                    Cut
                    <ContextMenuShortcut>⌘X</ContextMenuShortcut>
                </ContextMenuItem>
                <ContextMenuItem>
                    <BzIcon Icon="@Icons.Outline.Copy" />
                    Copy
                    <ContextMenuShortcut>⌘C</ContextMenuShortcut>
                </ContextMenuItem>
                <ContextMenuItem>
                    <BzIcon Icon="@Icons.Outline.Clipboard" />
                    Paste
                    <ContextMenuShortcut>⌘V</ContextMenuShortcut>
                </ContextMenuItem>
                <ContextMenuSeparator />
                <ContextMenuItem Variant="ContextMenuItemVariant.Destructive">
                    <BzIcon Icon="@Icons.Outline.Trash" />
                    Delete
                    <ContextMenuShortcut>⌫</ContextMenuShortcut>
                </ContextMenuItem>
            </ContextMenuContent>
        </ContextMenu>
    </Demo>

    <Demo Title="Inset items" Description="Inset adds the leading indent that lines an item up under a label or an icon column - use it on items that have no leading icon so their text still aligns with those that do." Code="@InsetCode">
        <ContextMenu>
            <ContextMenuTrigger Class="border-border text-muted-foreground flex h-40 w-full max-w-md items-center justify-center rounded-md border border-dashed text-sm">
                Right-click here
            </ContextMenuTrigger>
            <ContextMenuContent Class="w-56">
                <ContextMenuLabel Inset>Page</ContextMenuLabel>
                <ContextMenuItem Inset>
                    Back
                    <ContextMenuShortcut>⌘[</ContextMenuShortcut>
                </ContextMenuItem>
                <ContextMenuItem Inset>
                    Forward
                    <ContextMenuShortcut>⌘]</ContextMenuShortcut>
                </ContextMenuItem>
                <ContextMenuItem Inset>
                    Reload
                    <ContextMenuShortcut>⌘R</ContextMenuShortcut>
                </ContextMenuItem>
                <ContextMenuSeparator />
                <ContextMenuItem>
                    <BzIcon Icon="@Icons.Outline.Bookmark" />
                    Add bookmark
                </ContextMenuItem>
            </ContextMenuContent>
        </ContextMenu>
    </Demo>

    <Demo Title="Nested submenus" Description="A submenu opens to the side on hover or the inline-end arrow and can nest as deep as you need. With the pointer, a short grace delay lets you cross the gap to the panel without it snapping shut." Code="@SubmenusCode">
        <ContextMenu>
            <ContextMenuTrigger Class="border-border text-muted-foreground flex h-40 w-full max-w-md items-center justify-center rounded-md border border-dashed text-sm">
                Right-click here
            </ContextMenuTrigger>
            <ContextMenuContent Class="w-52">
                <ContextMenuItem>
                    <BzIcon Icon="@Icons.Outline.Link" />
                    Copy link
                </ContextMenuItem>
                <ContextMenuItem>
                    <BzIcon Icon="@Icons.Outline.Edit" />
                    Edit
                </ContextMenuItem>
                <ContextMenuSub>
                    <ContextMenuSubTrigger>
                        <BzIcon Icon="@Icons.Outline.Share3" />
                        Share
                    </ContextMenuSubTrigger>
                    <ContextMenuSubContent Class="w-44">
                        <ContextMenuItem>
                            <BzIcon Icon="@Icons.Outline.Mail" />
                            Email
                        </ContextMenuItem>
                        <ContextMenuItem>
                            <BzIcon Icon="@Icons.Outline.MessageCircle" />
                            Message
                        </ContextMenuItem>
                        <ContextMenuSub>
                            <ContextMenuSubTrigger>
                                <BzIcon Icon="@Icons.Outline.UserPlus" />
                                Invite
                            </ContextMenuSubTrigger>
                            <ContextMenuSubContent Class="w-40">
                                <ContextMenuItem>Phone</ContextMenuItem>
                                <ContextMenuItem>Tablet</ContextMenuItem>
                                <ContextMenuItem>Laptop</ContextMenuItem>
                            </ContextMenuSubContent>
                        </ContextMenuSub>
                    </ContextMenuSubContent>
                </ContextMenuSub>
                <ContextMenuSeparator />
                <ContextMenuItem Variant="ContextMenuItemVariant.Destructive">
                    <BzIcon Icon="@Icons.Outline.Trash" />
                    Delete
                </ContextMenuItem>
            </ContextMenuContent>
        </ContextMenu>
    </Demo>

    <Demo Title="Checkbox &amp; radio items" Description="Toggle settings without the menu closing - each checkbox's OnSelect calls PreventDefault to keep it open - and pick one option from a radio group. Both states are two-way bound." Code="@CheckboxRadioCode">
        <ContextMenu>
            <ContextMenuTrigger Class="border-border text-muted-foreground flex h-40 w-full max-w-md items-center justify-center rounded-md border border-dashed text-sm">
                Right-click here
            </ContextMenuTrigger>
            <ContextMenuContent Class="w-52">
                <ContextMenuLabel>Appearance</ContextMenuLabel>
                <ContextMenuCheckboxItem @bind-Checked="_showToolbar" OnSelect="KeepOpen">Show Toolbar</ContextMenuCheckboxItem>
                <ContextMenuCheckboxItem @bind-Checked="_showGrid" OnSelect="KeepOpen">Show Grid</ContextMenuCheckboxItem>
                <ContextMenuSeparator />
                <ContextMenuLabel>Sort by</ContextMenuLabel>
                <ContextMenuRadioGroup @bind-Value="_sortBy">
                    <ContextMenuRadioItem Value="name">Name</ContextMenuRadioItem>
                    <ContextMenuRadioItem Value="date">Date modified</ContextMenuRadioItem>
                    <ContextMenuRadioItem Value="size">Size</ContextMenuRadioItem>
                </ContextMenuRadioGroup>
            </ContextMenuContent>
        </ContextMenu>
    </Demo>

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the menu anchors at the pointer and mirrors: shortcuts sit on the left and the submenu opens to the left with its chevron flipped." Code="@RtlCode">
        <DirectionProvider Direction="Direction.Rtl">
            <ContextMenu>
                <ContextMenuTrigger Class="border-border text-muted-foreground flex h-40 w-full max-w-md items-center justify-center rounded-md border border-dashed text-sm">
                    انقر بزر الفأرة الأيمن هنا
                </ContextMenuTrigger>
                <ContextMenuContent Class="w-52">
                    <ContextMenuItem>
                        رجوع
                        <ContextMenuShortcut>⌘[</ContextMenuShortcut>
                    </ContextMenuItem>
                    <ContextMenuItem>
                        إعادة تحميل
                        <ContextMenuShortcut>⌘R</ContextMenuShortcut>
                    </ContextMenuItem>
                    <ContextMenuSub>
                        <ContextMenuSubTrigger>أدوات أخرى</ContextMenuSubTrigger>
                        <ContextMenuSubContent Class="w-48">
                            <ContextMenuItem>حفظ الصفحة باسم…</ContextMenuItem>
                            <ContextMenuItem>أدوات المطور</ContextMenuItem>
                        </ContextMenuSubContent>
                    </ContextMenuSub>
                    <ContextMenuSeparator />
                    <ContextMenuItem Variant="ContextMenuItemVariant.Destructive">حذف</ContextMenuItem>
                </ContextMenuContent>
            </ContextMenu>
        </DirectionProvider>
    </Demo>

    <ApiReference Types="ApiFamilies.ContextMenu" />
</div>

