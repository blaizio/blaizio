@page "/components/separator"
<PageTitle>Separator - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Separator</h1>
        <p class="text-muted-foreground">Visually or semantically separates content.</p>
    </header>

    <Demo Title="Horizontal" Code="@HorizontalCode">
        <div class="w-full max-w-xs">
            <div class="space-y-1">
                <h4 class="text-sm font-medium leading-none">Blazeo</h4>
                <p class="text-sm text-muted-foreground">Headless Blazor primitives.</p>
            </div>
            <BzSeparator Class="my-4" />
            <div class="flex h-5 items-center gap-4 text-sm">
                <span>Docs</span>
                <BzSeparator Orientation="Orientation.Vertical" />
                <span>Source</span>
                <BzSeparator Orientation="Orientation.Vertical" />
                <span>About</span>
            </div>
        </div>
    </Demo>

    <Demo Title="Vertical" Code="@VerticalCode">
        <div class="flex h-8 items-center gap-4 text-sm">
            <span>One</span>
            <BzSeparator Orientation="Orientation.Vertical" />
            <span>Two</span>
            <BzSeparator Orientation="Orientation.Vertical" />
            <span>Three</span>
        </div>
    </Demo>

    <Demo Title="Semantic vs. decorative"
          Description="Decorative (default) renders role=none; set Decorative=false for a meaningful role=separator exposed to assistive tech."
          Code="@SemanticCode">
        <div class="flex h-8 items-center gap-4 text-sm">
            <span>Section A</span>
            <BzSeparator Orientation="Orientation.Vertical" Decorative="false" />
            <span>Section B</span>
        </div>
    </Demo>

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the row order and spacing mirror to the right." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <div class="w-full max-w-xs">
                <div class="space-y-1">
                    <h4 class="text-sm font-medium leading-none">Blazeo</h4>
                    <p class="text-sm text-muted-foreground">أساسيات Blazor بلا واجهة.</p>
                </div>
                <BzSeparator Class="my-4" />
                <div class="flex h-5 items-center gap-4 text-sm">
                    <span>الملف الشخصي</span>
                    <BzSeparator Orientation="Orientation.Vertical" />
                    <span>الإعدادات</span>
                    <BzSeparator Orientation="Orientation.Vertical" />
                    <span>تسجيل الخروج</span>
                </div>
            </div>
        </BzDirectionProvider>
    </Demo>
    <ApiReference Types="ApiFamilies.Separator" />
</div>

@code {
    private const string HorizontalCode = """
        <div>
            <h4>Blazeo</h4>
            <p>Headless Blazor primitives.</p>
        </div>
        <BzSeparator Class="my-4" />
        <div class="flex h-5 items-center gap-4">
            <span>Docs</span>
            <BzSeparator Orientation="Orientation.Vertical" />
            <span>Source</span>
            <BzSeparator Orientation="Orientation.Vertical" />
            <span>About</span>
        </div>
        """;

    private const string VerticalCode = """
        <div class="flex h-8 items-center gap-4">
            <span>One</span>
            <BzSeparator Orientation="Orientation.Vertical" />
            <span>Two</span>
            <BzSeparator Orientation="Orientation.Vertical" />
            <span>Three</span>
        </div>
        """;

    private const string SemanticCode = """
        <BzSeparator Orientation="Orientation.Vertical" Decorative="false" />
        """;

    private const string RtlCode = """
        <BzDirectionProvider Direction="Direction.Rtl">
            <div>
                <h4>Blazeo</h4>
                <p>أساسيات Blazor بلا واجهة.</p>
            </div>
            <BzSeparator Class="my-4" />
            <div class="flex h-5 items-center gap-4">
                <span>الملف الشخصي</span>
                <BzSeparator Orientation="Orientation.Vertical" />
                <span>الإعدادات</span>
                <BzSeparator Orientation="Orientation.Vertical" />
                <span>تسجيل الخروج</span>
            </div>
        </BzDirectionProvider>
        """;
}
