@page "/components/virtualizer"
<PageTitle>BzVirtualizer - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">BzVirtualizer</h1>
        <p class="text-muted-foreground">
            Renders only the items in view, so a list of thousands stays light in the DOM. Hand it
            <code class="bz-code">Items</code> and an item template; it mounts the visible slice plus two
            spacers that keep the scroll height exact. By default it virtualizes against the page (no height
            cap) - set <code class="bz-code">MaxHeight</code> for a fixed scroll box. It is the same engine
            <code class="bz-code">BzDataTable&lt;TItem&gt;</code> uses to virtualize its rows.
        </p>
    </header>

    <UsageBlock Setup="@UsageSetup" Code="@UsageMarkup"
                Description="Hand it Items and an item template. The template's context is a VirtualItem - render context.Item and spread context.Attributes on the root element. Set MaxHeight for a fixed scroll box, or omit it to virtualize against the page." />

    <ExamplesHeading />

    <Demo Title="Fixed height"
          Description="The fast path: every item is exactly ItemSize, so placement is pure index math (scales to huge lists). 100,000 rows scroll inside a 20rem box, yet only the visible band is ever in the DOM. The item template's context is a VirtualItem - render context.Item and spread context.Attributes on the root element. Drop MaxHeight to virtualize against the page instead, with no height cap."
          Code="@FixedCode">
        <div class="w-full max-w-md overflow-hidden rounded-lg border">
            <BzVirtualizer TItem="Row" Items="_rows" ItemSize="44" MaxHeight="20rem" Context="row">
                <div @attributes="row.Attributes" class="flex items-center gap-3 border-b px-4 text-sm">
                    <span class="w-14 shrink-0 text-end font-mono text-xs text-muted-foreground tabular-nums">@row.Index</span>
                    <span class="font-medium">@row.Item.Name</span>
                    <span class="ms-auto truncate text-muted-foreground">@row.Item.Email</span>
                </div>
            </BzVirtualizer>
        </div>
    </Demo>

    <Demo Title="Dynamic height"
          Description="Add Dynamic and the virtualizer measures each rendered item instead of assuming ItemSize - so items of different heights (here notes that wrap) place correctly. ItemSize becomes just the estimate used until an item is measured; in this mode context.Attributes carries only the index marker, no fixed height."
          Code="@DynamicCode">
        <div class="w-full max-w-md overflow-hidden rounded-lg border">
            <BzVirtualizer TItem="Note" Items="_notes" Dynamic ItemSize="84" MaxHeight="22rem" Context="row">
                <div @attributes="row.Attributes" class="space-y-1 border-b p-4 text-sm">
                    <div class="flex items-center justify-between">
                        <span class="font-medium">@row.Item.Author</span>
                        <span class="font-mono text-xs text-muted-foreground tabular-nums">#@row.Index</span>
                    </div>
                    <p class="text-pretty text-muted-foreground">@row.Item.Body</p>
                </div>
            </BzVirtualizer>
        </div>
    </Demo>

    <Demo Title="Empty state"
          Description="When Items is empty the spacers and rows collapse to whatever EmptyContent renders."
          Code="@EmptyCode">
        <div class="w-full max-w-md overflow-hidden rounded-lg border">
            <BzVirtualizer TItem="Row" Items="@(Array.Empty<Row>())" ItemSize="44" MaxHeight="12rem">
                <ChildContent Context="row">
                    <div @attributes="row.Attributes" class="px-4 text-sm">@row.Item.Name</div>
                </ChildContent>
                <EmptyContent>
                    <div class="flex h-24 items-center justify-center text-sm text-muted-foreground">Nothing to show.</div>
                </EmptyContent>
            </BzVirtualizer>
        </div>
    </Demo>

    <ApiReference Types="ApiFamilies.Virtualizer" />
</div>

@code {
    public sealed record Row(int Id, string Name, string Email);
    public sealed record Note(int Id, string Author, string Body);

    private IReadOnlyList<Row> _rows = [];
    private IReadOnlyList<Note> _notes = [];

    protected override void OnInitialized()
    {
        var first = new[] { "Olivia", "Jackson", "Isabella", "William", "Sofia", "Liam", "Emma", "Noah", "Ava", "Lucas", "Mia", "Ethan" };
        var last = new[] { "Martin", "Lee", "Nguyen", "Kim", "Davis", "Johnson", "Wilson", "Brown", "Garcia", "Miller", "Jones", "Khan" };
        var rng = new Random(42);

        _rows = Enumerable.Range(1, 100_000).Select(i =>
        {
            var name = $"{first[rng.Next(first.Length)]} {last[rng.Next(last.Length)]}";
            var email = name.ToLowerInvariant().Replace(' ', '.') + i + "@example.com";
            return new Row(i, name, email);
        }).ToList();

        var bodies = new[]
        {
            "Short note.",
            "A medium-length note that runs to roughly one full line of text in the row.",
            "A longer note that wraps across two or three lines, which is exactly why dynamic measurement matters: every item can be a different height and the virtualizer still places it correctly.",
            "Following up on yesterday - the numbers look right, but double-check the rounding before we ship.",
        };
        _notes = Enumerable.Range(1, 500)
            .Select(i => new Note(i, $"{first[rng.Next(first.Length)]} {last[rng.Next(last.Length)]}", bodies[rng.Next(bodies.Length)]))
            .ToList();
    }

    private const string UsageSetup = """
        @* _Imports.razor (or the top of the page) *@
        @using Blazeo.Ui
        """;

    private const string UsageMarkup = """
        <BzVirtualizer TItem="Row" Items="_rows" ItemSize="44" MaxHeight="20rem" Context="row">
            <div @attributes="row.Attributes" class="border-b px-4 py-2 text-sm">@row.Item.Name</div>
        </BzVirtualizer>

        @code {
            public sealed record Row(int Id, string Name);
            private IReadOnlyList<Row> _rows = [];
        }
        """;

    private const string FixedCode = """
        @* 100,000 rows in a 20rem scroll box - only the visible band is ever in the DOM.
           Drop MaxHeight to virtualize against the page instead (no height cap). *@
        <div class="overflow-hidden rounded-lg border">
            <BzVirtualizer TItem="Row" Items="rows" ItemSize="44" MaxHeight="20rem" Context="row">
                <div @attributes="row.Attributes" class="flex items-center gap-3 border-b px-4 text-sm">
                    <span class="w-14 text-end font-mono text-xs text-muted-foreground">@row.Index</span>
                    <span class="font-medium">@row.Item.Name</span>
                    <span class="ms-auto text-muted-foreground">@row.Item.Email</span>
                </div>
            </BzVirtualizer>
        </div>

        @code {
            private record Row(int Id, string Name, string Email);
            private IReadOnlyList<Row> rows = /* 100,000 rows */;
        }
        """;

    private const string DynamicCode = """
        <BzVirtualizer TItem="Note" Items="notes" Dynamic ItemSize="84" MaxHeight="22rem" Context="row">
            <div @attributes="row.Attributes" class="space-y-1 border-b p-4 text-sm">
                <div class="flex items-center justify-between">
                    <span class="font-medium">@row.Item.Author</span>
                    <span class="font-mono text-xs text-muted-foreground">#@row.Index</span>
                </div>
                <p class="text-pretty text-muted-foreground">@row.Item.Body</p>
            </div>
        </BzVirtualizer>
        """;

    private const string EmptyCode = """
        <BzVirtualizer TItem="Row" Items="rows" ItemSize="44" MaxHeight="12rem" Context="row">
            <ChildContent Context="row">
                <div @attributes="row.Attributes" class="px-4 text-sm">@row.Item.Name</div>
            </ChildContent>
            <EmptyContent>
                <div class="flex h-24 items-center justify-center text-sm text-muted-foreground">Nothing to show.</div>
            </EmptyContent>
        </BzVirtualizer>
        """;
}
