@page "/components/select"
@using System.ComponentModel.DataAnnotations
<PageTitle>Select - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Select</h1>
        <p class="text-muted-foreground">Pick a single value from a list, positioned with <a class="font-medium text-foreground underline underline-offset-4" href="https://floating-ui.com" target="_blank" rel="noopener">Floating UI</a>. The listbox opens on the current choice and supports full keyboard control - arrow keys, Home/End, type-ahead, Enter/Space to pick, Escape to close. Bind the chosen value with <code>@@bind-Value</code>. It is <strong>non-modal</strong>: the rest of the page stays interactive while it is open.</p>
    </header>

    <Demo Title="Default" Description="A single group of options with a placeholder. Open it and pick a value with the pointer or the keyboard - the trigger then shows your choice." Code="@DefaultCode">
        <Select>
            <SelectTrigger Class="w-48">
                <SelectValue Placeholder="Select a fruit" />
            </SelectTrigger>
            <SelectContent>
                <SelectGroup>
                    <SelectLabel>Fruits</SelectLabel>
                    <SelectItem Value="apple">Apple</SelectItem>
                    <SelectItem Value="banana">Banana</SelectItem>
                    <SelectItem Value="blueberry">Blueberry</SelectItem>
                    <SelectItem Value="grapes">Grapes</SelectItem>
                    <SelectItem Value="pineapple">Pineapple</SelectItem>
                </SelectGroup>
            </SelectContent>
        </Select>
    </Demo>

    <Demo Title="Grouped &amp; scrollable" Description="Options split into labelled groups with separators. A list taller than the room below the trigger caps its height to the viewport and scrolls (a thin scrollbar); type-ahead and the arrow keys still reach every option, scrolling it into view." Code="@ScrollableCode">
        <Select>
            <SelectTrigger Class="w-64">
                <SelectValue Placeholder="Select a timezone" />
            </SelectTrigger>
            <SelectContent>
                <SelectGroup>
                    <SelectLabel>North America</SelectLabel>
                    <SelectItem Value="est">Eastern Standard Time (EST)</SelectItem>
                    <SelectItem Value="cst">Central Standard Time (CST)</SelectItem>
                    <SelectItem Value="mst">Mountain Standard Time (MST)</SelectItem>
                    <SelectItem Value="pst">Pacific Standard Time (PST)</SelectItem>
                    <SelectItem Value="akst">Alaska Standard Time (AKST)</SelectItem>
                    <SelectItem Value="hst">Hawaii Standard Time (HST)</SelectItem>
                </SelectGroup>
                <SelectSeparator />
                <SelectGroup>
                    <SelectLabel>Europe &amp; Africa</SelectLabel>
                    <SelectItem Value="gmt">Greenwich Mean Time (GMT)</SelectItem>
                    <SelectItem Value="cet">Central European Time (CET)</SelectItem>
                    <SelectItem Value="eet">Eastern European Time (EET)</SelectItem>
                    <SelectItem Value="west">Western European Summer Time (WEST)</SelectItem>
                    <SelectItem Value="cat">Central Africa Time (CAT)</SelectItem>
                </SelectGroup>
                <SelectSeparator />
                <SelectGroup>
                    <SelectLabel>Asia</SelectLabel>
                    <SelectItem Value="ist">India Standard Time (IST)</SelectItem>
                    <SelectItem Value="cst-china">China Standard Time (CST)</SelectItem>
                    <SelectItem Value="jst">Japan Standard Time (JST)</SelectItem>
                    <SelectItem Value="gst">Gulf Standard Time (GST)</SelectItem>
                </SelectGroup>
                <SelectSeparator />
                <SelectGroup>
                    <SelectLabel>Australia &amp; Pacific</SelectLabel>
                    <SelectItem Value="awst">Australian Western Time (AWST)</SelectItem>
                    <SelectItem Value="aest">Australian Eastern Time (AEST)</SelectItem>
                    <SelectItem Value="nzst">New Zealand Standard Time (NZST)</SelectItem>
                </SelectGroup>
            </SelectContent>
        </Select>
    </Demo>

    <Demo Title="Scroll buttons" Description="Scroll=Buttons swaps the scrollbar for an up and a down chevron - each hides at its end of the list, and hovering one auto-scrolls (the native select feel). The height is capped here so the buttons appear." Code="@ScrollButtonsCode">
        <Select>
            <SelectTrigger Class="w-64">
                <SelectValue Placeholder="Select a timezone" />
            </SelectTrigger>
            <SelectContent Scroll="SelectScrollMode.Buttons" Class="max-h-72">
                <SelectGroup>
                    <SelectLabel>North America</SelectLabel>
                    <SelectItem Value="est">Eastern Standard Time (EST)</SelectItem>
                    <SelectItem Value="cst">Central Standard Time (CST)</SelectItem>
                    <SelectItem Value="mst">Mountain Standard Time (MST)</SelectItem>
                    <SelectItem Value="pst">Pacific Standard Time (PST)</SelectItem>
                    <SelectItem Value="akst">Alaska Standard Time (AKST)</SelectItem>
                    <SelectItem Value="hst">Hawaii Standard Time (HST)</SelectItem>
                </SelectGroup>
                <SelectSeparator />
                <SelectGroup>
                    <SelectLabel>Europe &amp; Africa</SelectLabel>
                    <SelectItem Value="gmt">Greenwich Mean Time (GMT)</SelectItem>
                    <SelectItem Value="cet">Central European Time (CET)</SelectItem>
                    <SelectItem Value="eet">Eastern European Time (EET)</SelectItem>
                    <SelectItem Value="cat">Central Africa Time (CAT)</SelectItem>
                </SelectGroup>
                <SelectSeparator />
                <SelectGroup>
                    <SelectLabel>Asia</SelectLabel>
                    <SelectItem Value="ist">India Standard Time (IST)</SelectItem>
                    <SelectItem Value="jst">Japan Standard Time (JST)</SelectItem>
                    <SelectItem Value="gst">Gulf Standard Time (GST)</SelectItem>
                </SelectGroup>
            </SelectContent>
        </Select>
    </Demo>

    <Demo Title="Sizes" Description="Two trigger heights via the Size parameter - the default and a more compact sm for dense layouts." Code="@SizesCode">
        <div class="flex items-center gap-4">
            <Select>
                <SelectTrigger Class="w-40">
                    <SelectValue Placeholder="Default" />
                </SelectTrigger>
                <SelectContent>
                    <SelectItem Value="s">Small</SelectItem>
                    <SelectItem Value="m">Medium</SelectItem>
                    <SelectItem Value="l">Large</SelectItem>
                </SelectContent>
            </Select>
            <Select>
                <SelectTrigger Size="SelectTriggerSize.Sm" Class="w-40">
                    <SelectValue Placeholder="Small" />
                </SelectTrigger>
                <SelectContent>
                    <SelectItem Value="s">Small</SelectItem>
                    <SelectItem Value="m">Medium</SelectItem>
                    <SelectItem Value="l">Large</SelectItem>
                </SelectContent>
            </Select>
        </div>
    </Demo>

    <Demo Title="Disabled options" Description="A disabled option is skipped by the pointer and the keyboard and cannot be picked. Here the sold-out sizes are disabled." Code="@DisabledCode">
        <Select>
            <SelectTrigger Class="w-48">
                <SelectValue Placeholder="Select a size" />
            </SelectTrigger>
            <SelectContent>
                <SelectItem Value="xs">Extra Small</SelectItem>
                <SelectItem Value="sm" Disabled>Small (sold out)</SelectItem>
                <SelectItem Value="md">Medium</SelectItem>
                <SelectItem Value="lg" Disabled>Large (sold out)</SelectItem>
                <SelectItem Value="xl">Extra Large</SelectItem>
            </SelectContent>
        </Select>
    </Demo>

    <Demo Title="Preselected" Description="A value set up front (DefaultValue, or a bound value) shows in the trigger straight away - before the listbox has ever been opened - and is highlighted when you open it." Code="@PreselectedCode">
        <Select DefaultValue="banana">
            <SelectTrigger Class="w-48">
                <SelectValue Placeholder="Select a fruit" />
            </SelectTrigger>
            <SelectContent>
                <SelectItem Value="apple">Apple</SelectItem>
                <SelectItem Value="banana">Banana</SelectItem>
                <SelectItem Value="blueberry">Blueberry</SelectItem>
                <SelectItem Value="grapes">Grapes</SelectItem>
            </SelectContent>
        </Select>
    </Demo>

    <Demo Title="Controlled" Description="Drive the value yourself with two-way binding. The live selection is shown above, and a button clears it." Code="@ControlledCode">
        <div class="flex flex-col items-center gap-4">
            <span class="text-muted-foreground text-sm">Value: @(_fruit ?? "(none)")</span>
            <div class="flex items-center gap-4">
                <Select @bind-Value="_fruit">
                    <SelectTrigger Class="w-48">
                        <SelectValue Placeholder="Select a fruit" />
                    </SelectTrigger>
                    <SelectContent>
                        <SelectItem Value="apple">Apple</SelectItem>
                        <SelectItem Value="banana">Banana</SelectItem>
                        <SelectItem Value="blueberry">Blueberry</SelectItem>
                        <SelectItem Value="grapes">Grapes</SelectItem>
                    </SelectContent>
                </Select>
                <Button Variant="ButtonVariant.Secondary" @onclick="() => _fruit = null">Clear</Button>
            </div>
        </div>
    </Demo>

    <Demo Title="Validation in an EditForm" Description="Wrap the SelectTrigger in a FieldControl and it joins the Field's validation - the wrapper hands the trigger the field's id, aria-describedby, and (when invalid) aria-invalid, which turns it destructive. DataAnnotations here, validated on submit." Code="@ValidationEditFormCode">
        <EditForm Model="@_order" OnValidSubmit="@(() => _ordered = true)" OnInvalidSubmit="@(() => _ordered = false)" class="w-full max-w-sm">
            <DataAnnotationsValidator />
            <FieldGroup>
                <Field Name="@nameof(OrderModel.Size)">
                    <FieldLabel>T-shirt size</FieldLabel>
                    <Select @bind-Value="_order.Size">
                        <FieldControl Context="ctl">
                            <SelectTrigger @attributes="ctl" Class="w-full">
                                <SelectValue Placeholder="Select a size" />
                            </SelectTrigger>
                        </FieldControl>
                        <SelectContent>
                            <SelectItem Value="xs">Extra Small</SelectItem>
                            <SelectItem Value="sm">Small</SelectItem>
                            <SelectItem Value="md">Medium</SelectItem>
                            <SelectItem Value="lg">Large</SelectItem>
                        </SelectContent>
                    </Select>
                    <FieldDescription>Pick the size you want to order.</FieldDescription>
                    <FieldError />
                </Field>
                <Field Orientation="FieldOrientation.Horizontal">
                    <Button Type="submit">Place order</Button>
                    @if (_ordered)
                    {
                        <span class="text-sm font-medium text-emerald-600">Order placed 🎉</span>
                    }
                </Field>
            </FieldGroup>
        </EditForm>
    </Demo>

    <Demo Title="Validation without EditForm" Description="No EditForm needed - drive the Error string yourself and the field (and its trigger) turn destructive live as the value changes." Code="@ValidationStandaloneCode">
        <div class="w-full max-w-sm">
            <Field Error="@(_plan is null ? "Please choose a plan to continue." : null)">
                <FieldLabel>Plan</FieldLabel>
                <Select @bind-Value="_plan">
                    <FieldControl Context="ctl">
                        <SelectTrigger @attributes="ctl" Class="w-full">
                            <SelectValue Placeholder="Select a plan" />
                        </SelectTrigger>
                    </FieldControl>
                    <SelectContent>
                        <SelectItem Value="free">Free</SelectItem>
                        <SelectItem Value="pro">Pro</SelectItem>
                        <SelectItem Value="team">Team</SelectItem>
                    </SelectContent>
                </Select>
                <FieldError />
            </Field>
        </div>
    </Demo>

    <Demo Title="Align item with trigger" Description="With Position=ItemAligned the listbox opens OVER the trigger so the selected option sits directly on top of it - the native select feel - and it appears instantly (no open animation) so it feels snappy. Popper instead floats in below or above with a fade. Flip the switch to compare; it is preselected, so opening lines the highlighted option up with the trigger (near a screen edge the list scrolls to keep it aligned). The trigger's chevron adapts too - an up/down selector for item-aligned, a chevron that rotates up-on-open for popper." Code="@ItemAlignedCode">
        <div class="space-y-4">
            <div class="flex items-center gap-2">
                <Switch id="select-item-aligned" @bind-Checked="_itemAligned" />
                <Label For="select-item-aligned">Align item with trigger (@(_itemAligned ? "ItemAligned" : "Popper"))</Label>
            </div>
            <Select DefaultValue="banana">
                <SelectTrigger Class="w-48">
                    <SelectValue Placeholder="Select a fruit" />
                </SelectTrigger>
                <SelectContent Position="@(_itemAligned ? SelectPosition.ItemAligned : SelectPosition.Popper)">
                    <SelectItem Value="apple">Apple</SelectItem>
                    <SelectItem Value="banana">Banana</SelectItem>
                    <SelectItem Value="blueberry">Blueberry</SelectItem>
                    <SelectItem Value="grapes">Grapes</SelectItem>
                    <SelectItem Value="pineapple">Pineapple</SelectItem>
                </SelectContent>
            </Select>
        </div>
    </Demo>

    <Demo Title="Custom chevron" Description="Swap the trailing chevron with the trigger's Icon parameter, or replace it entirely with a Chevron template (pass an empty Chevron to hide it)." Code="@ChevronCode">
        <div class="flex items-center gap-4">
            <Select>
                <SelectTrigger Class="w-44" Icon="@Icons.Outline.CaretDown">
                    <SelectValue Placeholder="Caret" />
                </SelectTrigger>
                <SelectContent>
                    <SelectItem Value="a">Option A</SelectItem>
                    <SelectItem Value="b">Option B</SelectItem>
                </SelectContent>
            </Select>
            <Select>
                <SelectTrigger Class="w-44">
                    <ChildContent>
                        <SelectValue Placeholder="Template" />
                    </ChildContent>
                    <Chevron>
                        <BzIcon Icon="@Icons.Outline.Filter" Class="size-4 opacity-50" />
                    </Chevron>
                </SelectTrigger>
                <SelectContent>
                    <SelectItem Value="a">Option A</SelectItem>
                    <SelectItem Value="b">Option B</SelectItem>
                </SelectContent>
            </Select>
        </div>
    </Demo>

    <Demo Title="Multiple" Description="Set Multiple to pick several values, two-way bound as a list of values. Each choice shows as a removable badge in the trigger (the ✕ deselects it); picking toggles an option and leaves the listbox open, and the checks mark every chosen option." Code="@MultipleCode">
        <div class="flex flex-col items-center gap-4">
            <span class="text-muted-foreground text-sm">@(_fruits.Count == 0 ? "(none)" : string.Join(", ", _fruits))</span>
            <Select Multiple @bind-Values="_fruits">
                <SelectTrigger Class="w-72">
                    <SelectValue Placeholder="Select fruits" />
                </SelectTrigger>
                <SelectContent>
                    <SelectGroup>
                        <SelectLabel>Fruits</SelectLabel>
                        <SelectItem Value="apple">Apple</SelectItem>
                        <SelectItem Value="banana">Banana</SelectItem>
                        <SelectItem Value="blueberry">Blueberry</SelectItem>
                        <SelectItem Value="grapes">Grapes</SelectItem>
                        <SelectItem Value="pineapple">Pineapple</SelectItem>
                    </SelectGroup>
                </SelectContent>
            </Select>
        </div>
    </Demo>

    <Demo Title="Token overflow" Description="When the badges outgrow the trigger, Overflow on SelectValue decides what happens. Count (the default) keeps the trigger one line tall and shows a +N counter before the chevron; Wrap lets the badges flow onto more lines, growing the trigger. Both fields below bind the same list, so a change in one shows in the other." Code="@OverflowCode">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
            <div class="space-y-1.5">
                <span class="text-muted-foreground text-sm">Count (fixed height)</span>
                <Select Multiple @bind-Values="_langs">
                    <SelectTrigger Class="w-60">
                        <SelectValue Placeholder="Select languages" Overflow="SelectTokenOverflow.Count" />
                    </SelectTrigger>
                    <SelectContent>
                        @foreach (var lang in _languages)
                        {
                            <SelectItem Value="@lang">@lang</SelectItem>
                        }
                    </SelectContent>
                </Select>
            </div>
            <div class="space-y-1.5">
                <span class="text-muted-foreground text-sm">Wrap (grows)</span>
                <Select Multiple @bind-Values="_langs">
                    <SelectTrigger Class="w-60">
                        <SelectValue Placeholder="Select languages" Overflow="SelectTokenOverflow.Wrap" />
                    </SelectTrigger>
                    <SelectContent>
                        @foreach (var lang in _languages)
                        {
                            <SelectItem Value="@lang">@lang</SelectItem>
                        }
                    </SelectContent>
                </Select>
            </div>
        </div>
    </Demo>

    <Demo Title="Custom tokens" Description="Pass a Tokens template on SelectValue to render the selection your own way - here as outline badges with a status dot. The template receives the selected options and a remove callback to wire onto your own control." Code="@CustomTokensCode">
        <Select Multiple @bind-Values="_members">
            <SelectTrigger Class="w-80">
                <SelectValue Placeholder="Add members">
                    <Tokens Context="t">
                        @foreach (var member in t.Options)
                        {
                            <Badge Variant="BadgeVariant.Outline" Class="gap-1.5 ps-2 pe-1">
                                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                @member.Content
                                <span role="button" tabindex="-1" aria-label="Remove"
                                      class="flex size-4 items-center justify-center rounded-xs opacity-60 transition-opacity hover:bg-foreground/10 hover:opacity-100"
                                      @onclick="@(() => t.Deselect.InvokeAsync(member.Value))"
                                      @onclick:stopPropagation="true"
                                      @onpointerdown:stopPropagation="true">
                                    <BzIcon Icon="@Icons.Outline.X" Class="size-3" />
                                </span>
                            </Badge>
                        }
                    </Tokens>
                </SelectValue>
            </SelectTrigger>
            <SelectContent>
                <SelectItem Value="jane">Jane Doe</SelectItem>
                <SelectItem Value="john">John Smith</SelectItem>
                <SelectItem Value="alex">Alex Park</SelectItem>
                <SelectItem Value="maria">Maria Lopez</SelectItem>
                <SelectItem Value="sam">Sam Carter</SelectItem>
            </SelectContent>
        </Select>
    </Demo>

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the trigger's icon and the option checkmarks mirror to the other side, and the listbox aligns from the right." Code="@RtlCode">
        <DirectionProvider Direction="Direction.Rtl">
            <Select>
                <SelectTrigger Class="w-56">
                    <SelectValue Placeholder="اختر فاكهة" />
                </SelectTrigger>
                <SelectContent>
                    <SelectGroup>
                        <SelectLabel>الفواكه</SelectLabel>
                        <SelectItem Value="apple">تفاحة</SelectItem>
                        <SelectItem Value="banana">موزة</SelectItem>
                        <SelectItem Value="blueberry">توت أزرق</SelectItem>
                        <SelectItem Value="grapes">عنب</SelectItem>
                    </SelectGroup>
                </SelectContent>
            </Select>
        </DirectionProvider>
    </Demo>

    <ApiReference Types="ApiFamilies.Select" />
</div>

