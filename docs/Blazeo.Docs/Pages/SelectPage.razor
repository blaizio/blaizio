    private const string OverflowCode = """
        @* Count (default): one line tall, a +N counter before the chevron. *@
        <Select Multiple @bind-Values="_langs">
            <SelectTrigger Class="w-60">
                <SelectValue Placeholder="Select languages" Overflow="SelectTokenOverflow.Count" />
            </SelectTrigger>
            <SelectContent>
                @foreach (var lang in _languages)
                {
                    <SelectItem Value="@lang">@lang</SelectItem>
                }
            </SelectContent>
        </Select>

        @* Wrap: badges flow onto more lines, growing the trigger. *@
        <Select Multiple @bind-Values="_langs">
            <SelectTrigger Class="w-60">
                <SelectValue Placeholder="Select languages" Overflow="SelectTokenOverflow.Wrap" />
            </SelectTrigger>
            <SelectContent>
                @foreach (var lang in _languages)
                {
                    <SelectItem Value="@lang">@lang</SelectItem>
                }
            </SelectContent>
        </Select>

        @code {
            private IReadOnlyList<string> _langs = ["C#", "TypeScript", "Rust", "Go"];
            private static readonly string[] _languages =
                ["C#", "TypeScript", "Rust", "Go", "Python", "Java", "Kotlin", "Swift", "Ruby", "Elixir"];
        }
        """;

