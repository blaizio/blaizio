@page "/components/breadcrumb"
@* Class is BreadcrumbDocsPage, not the usual *Page convention, to avoid colliding with the
   Blazeo.Ui.BzBreadcrumbPage sub-component this page references by tag (both _Imports'd -> ambiguous). *@
<PageTitle>Breadcrumb - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Breadcrumb</h1>
        <p class="text-muted-foreground">Shows the path to the current page and lets you step back up the hierarchy. The divider between steps is <strong>style-aware</strong> - each Blazeo style draws its own glyph (chevron, slash, dot, dash, pipe, arrow...) - or you can supply your own.</p>
    </header>

    <Demo Title="Default" Code="@DefaultCode">
        <BzBreadcrumb>
            <BzBreadcrumbList>
                <BzBreadcrumbItem>
                    <BzBreadcrumbLink Href="#">Home</BzBreadcrumbLink>
                </BzBreadcrumbItem>
                <BzBreadcrumbSeparator />
                <BzBreadcrumbItem>
                    <BzBreadcrumbLink Href="#">Components</BzBreadcrumbLink>
                </BzBreadcrumbItem>
                <BzBreadcrumbSeparator />
                <BzBreadcrumbItem>
                    <BzBreadcrumbPage>Breadcrumb</BzBreadcrumbPage>
                </BzBreadcrumbItem>
            </BzBreadcrumbList>
        </BzBreadcrumb>
    </Demo>

    <Demo Title="Current page" Description="Mark the active step with Current on the item - it renders as a non-interactive label (aria-current=page), not a link. Shorthand for nesting a BreadcrumbPage." Code="@CurrentCode">
        <BzBreadcrumb>
            <BzBreadcrumbList>
                <BzBreadcrumbItem>
                    <BzBreadcrumbLink Href="#">Home</BzBreadcrumbLink>
                </BzBreadcrumbItem>
                <BzBreadcrumbSeparator />
                <BzBreadcrumbItem>
                    <BzBreadcrumbLink Href="#">Settings</BzBreadcrumbLink>
                </BzBreadcrumbItem>
                <BzBreadcrumbSeparator />
                <BzBreadcrumbItem Current>Profile</BzBreadcrumbItem>
            </BzBreadcrumbList>
        </BzBreadcrumb>
    </Demo>

    <Demo Title="Custom separator" Description="Put any content inside a separator - here a slash icon - to override the style's default glyph." Code="@CustomSeparatorCode">
        <BzBreadcrumb>
            <BzBreadcrumbList>
                <BzBreadcrumbItem>
                    <BzBreadcrumbLink Href="#">Home</BzBreadcrumbLink>
                </BzBreadcrumbItem>
                <BzBreadcrumbSeparator><BzIcon Icon="@Icons.Outline.Slash" /></BzBreadcrumbSeparator>
                <BzBreadcrumbItem>
                    <BzBreadcrumbLink Href="#">Components</BzBreadcrumbLink>
                </BzBreadcrumbItem>
                <BzBreadcrumbSeparator><BzIcon Icon="@Icons.Outline.Slash" /></BzBreadcrumbSeparator>
                <BzBreadcrumbItem>
                    <BzBreadcrumbPage>Breadcrumb</BzBreadcrumbPage>
                </BzBreadcrumbItem>
            </BzBreadcrumbList>
        </BzBreadcrumb>
    </Demo>

    <Demo Title="Collapsed" Description="When a trail is long, collapse the middle into an ellipsis that opens a menu of the hidden steps. Reuses the Dropdown Menu." Code="@CollapsedCode">
        <BzBreadcrumb>
            <BzBreadcrumbList>
                <BzBreadcrumbItem>
                    <BzBreadcrumbLink Href="#">Home</BzBreadcrumbLink>
                </BzBreadcrumbItem>
                <BzBreadcrumbSeparator />
                <BzBreadcrumbItem>
                    <BzDropdownMenu>
                        <BzDropdownMenuTrigger>
                            <AsChild Context="p">
                                <button type="button" class="flex items-center gap-1 rounded-sm outline-none focus-visible:ring-2 focus-visible:ring-ring/50" @attributes="p.Attributes">
                                    <BzBreadcrumbEllipsis MoreLabel="Toggle menu" />
                                </button>
                            </AsChild>
                        </BzDropdownMenuTrigger>
                        <BzDropdownMenuContent>
                            <BzDropdownMenuItem>Documentation</BzDropdownMenuItem>
                            <BzDropdownMenuItem>Themes</BzDropdownMenuItem>
                            <BzDropdownMenuItem>GitHub</BzDropdownMenuItem>
                        </BzDropdownMenuContent>
                    </BzDropdownMenu>
                </BzBreadcrumbItem>
                <BzBreadcrumbSeparator />
                <BzBreadcrumbItem>
                    <BzBreadcrumbLink Href="#">Components</BzBreadcrumbLink>
                </BzBreadcrumbItem>
                <BzBreadcrumbSeparator />
                <BzBreadcrumbItem>
                    <BzBreadcrumbPage>Breadcrumb</BzBreadcrumbPage>
                </BzBreadcrumbItem>
            </BzBreadcrumbList>
        </BzBreadcrumb>
    </Demo>

    <Demo Title="Routed links" Description="Use AsChild to render a step onto your own routed element (here a NavLink) instead of a plain anchor - so navigation goes through the router." Code="@RoutedCode">
        <BzBreadcrumb>
            <BzBreadcrumbList>
                <BzBreadcrumbItem>
                    <BzBreadcrumbLink>
                        <AsChild Context="p"><NavLink href="" Match="NavLinkMatch.All" @attributes="p.Attributes">Overview</NavLink></AsChild>
                    </BzBreadcrumbLink>
                </BzBreadcrumbItem>
                <BzBreadcrumbSeparator />
                <BzBreadcrumbItem>
                    <BzBreadcrumbLink>
                        <AsChild Context="p"><NavLink href="components/badge" @attributes="p.Attributes">Badge</NavLink></AsChild>
                    </BzBreadcrumbLink>
                </BzBreadcrumbItem>
                <BzBreadcrumbSeparator />
                <BzBreadcrumbItem>
                    <BzBreadcrumbPage>Breadcrumb</BzBreadcrumbPage>
                </BzBreadcrumbItem>
            </BzBreadcrumbList>
        </BzBreadcrumb>
    </Demo>

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the trail lays out right-to-left and any directional separator mirrors." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzBreadcrumb>
                <BzBreadcrumbList>
                    <BzBreadcrumbItem>
                        <BzBreadcrumbLink Href="#">الرئيسية</BzBreadcrumbLink>
                    </BzBreadcrumbItem>
                    <BzBreadcrumbSeparator />
                    <BzBreadcrumbItem>
                        <BzBreadcrumbLink Href="#">المكوّنات</BzBreadcrumbLink>
                    </BzBreadcrumbItem>
                    <BzBreadcrumbSeparator />
                    <BzBreadcrumbItem>
                        <BzBreadcrumbPage>مسار التنقل</BzBreadcrumbPage>
                    </BzBreadcrumbItem>
                </BzBreadcrumbList>
            </BzBreadcrumb>
        </BzDirectionProvider>
    </Demo>

    <ApiReference Types="ApiFamilies.Breadcrumb" />
</div>

