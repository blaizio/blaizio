@page "/components/command"
<PageTitle>Command - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Command</h1>
        <p class="text-muted-foreground">A fast, composable command palette. Type to filter; the highlight stays in sync as you navigate with the arrow keys or the mouse, and focus never leaves the input. Use it inline, inside a Popover as a combobox, or as a modal <code>CommandDialog</code> opened with a shortcut.</p>
    </header>

    <Demo Title="Default" Description="An inline palette. Type to fuzzy-filter; empty groups and their separators drop out, and the empty state shows when nothing matches. Arrow keys, Home/End and Enter all work while you keep typing." Code="@DefaultCode">
        <BzCommand Class="w-full max-w-md rounded-lg border shadow-md">
            <BzCommandInput Placeholder="Type a command or search..." />
            <BzCommandList>
                <BzCommandEmpty>No results found.</BzCommandEmpty>
                <BzCommandGroup Heading="Suggestions">
                    <BzCommandItem Value="Calendar"><BzIcon Icon="@Icons.Outline.Calendar" /><span>Calendar</span></BzCommandItem>
                    <BzCommandItem Value="Send mail" Keywords="@(new[] { "email", "compose" })"><BzIcon Icon="@Icons.Outline.Mail" /><span>Send mail</span></BzCommandItem>
                    <BzCommandItem Value="Calculator" Disabled><BzIcon Icon="@Icons.Outline.Calculator" /><span>Calculator</span></BzCommandItem>
                </BzCommandGroup>
                <BzCommandSeparator />
                <BzCommandGroup Heading="Settings">
                    <BzCommandItem Value="Profile"><BzIcon Icon="@Icons.Outline.User" /><span>Profile</span><BzCommandShortcut>⌘P</BzCommandShortcut></BzCommandItem>
                    <BzCommandItem Value="Billing"><BzIcon Icon="@Icons.Outline.CreditCard" /><span>Billing</span><BzCommandShortcut>⌘B</BzCommandShortcut></BzCommandItem>
                    <BzCommandItem Value="Settings"><BzIcon Icon="@Icons.Outline.Settings" /><span>Settings</span><BzCommandShortcut>⌘S</BzCommandShortcut></BzCommandItem>
                </BzCommandGroup>
            </BzCommandList>
        </BzCommand>
    </Demo>

    <Demo Title="Dialog (⌘K)" Description="The modal palette. The button opens it, and the Kbd binds a global ⌘K / Ctrl+K shortcut that opens it too. The input autofocuses; picking an item closes the dialog." Code="@DialogCode">
        <div class="flex flex-col items-center gap-3">
            <BzButton Variant="ButtonVariant.Outline" Class="w-64 justify-between text-muted-foreground" @onclick="@(() => _paletteOpen = true)">
                <span class="flex items-center gap-2"><BzIcon Icon="@Icons.Outline.Search" />Search...</span>
                <BzKbd Key="mod+k" OnTrigger="@(() => _paletteOpen = true)" />
            </BzButton>
            <p class="text-sm text-muted-foreground">Last run: <span class="font-mono">@(_lastRun ?? "-")</span></p>
        </div>
        <BzCommandDialog @bind-Open="_paletteOpen" Description="Search for a command to run.">
            <BzCommandInput Placeholder="Type a command or search..." />
            <BzCommandList>
                <BzCommandEmpty>No results found.</BzCommandEmpty>
                <BzCommandGroup Heading="Suggestions">
                    <BzCommandItem Value="Calendar" OnSelect="RunCommand"><BzIcon Icon="@Icons.Outline.Calendar" /><span>Calendar</span></BzCommandItem>
                    <BzCommandItem Value="Send mail" OnSelect="RunCommand"><BzIcon Icon="@Icons.Outline.Mail" /><span>Send mail</span></BzCommandItem>
                    <BzCommandItem Value="Launch" OnSelect="RunCommand"><BzIcon Icon="@Icons.Outline.Rocket" /><span>Launch</span></BzCommandItem>
                </BzCommandGroup>
                <BzCommandSeparator />
                <BzCommandGroup Heading="Settings">
                    <BzCommandItem Value="Profile" OnSelect="RunCommand"><BzIcon Icon="@Icons.Outline.User" /><span>Profile</span><BzCommandShortcut>⌘P</BzCommandShortcut></BzCommandItem>
                    <BzCommandItem Value="Settings" OnSelect="RunCommand"><BzIcon Icon="@Icons.Outline.Settings" /><span>Settings</span><BzCommandShortcut>⌘S</BzCommandShortcut></BzCommandItem>
                </BzCommandGroup>
            </BzCommandList>
        </BzCommandDialog>
    </Demo>

    <Demo Title="Combobox" Description="Drop a Command inside a Popover for a searchable single-select. The chosen value shows on the trigger; selecting closes the panel." Code="@ComboboxCode">
        <BzPopover @bind-Open="_comboOpen">
            <BzPopoverTrigger>
                <AsChild Context="p">
                    <BzButton Variant="ButtonVariant.Outline" role="combobox" Class="w-64 justify-between" @attributes="p.Attributes">
                        @(_assignee ?? "Assign to...")
                        <BzIcon Icon="@Icons.Outline.Selector" Class="opacity-50" />
                    </BzButton>
                </AsChild>
            </BzPopoverTrigger>
            <BzPopoverContent Class="w-64 !p-0">
                <BzCommand>
                    <BzCommandInput Placeholder="Search people..." />
                    <BzCommandList>
                        <BzCommandEmpty>No one found.</BzCommandEmpty>
                        <BzCommandGroup>
                            @foreach (var person in _people)
                            {
                                <BzCommandItem Value="@person" OnSelect="SelectAssignee">
                                    <BzIcon Icon="@Icons.Outline.Check" Class="@(_assignee == person ? "opacity-100" : "opacity-0")" />
                                    <span>@person</span>
                                </BzCommandItem>
                            }
                        </BzCommandGroup>
                    </BzCommandList>
                </BzCommand>
            </BzPopoverContent>
        </BzPopover>
    </Demo>

    <Demo Title="Controlled search" Description="Bind the search text two-way to read it or preset the query." Code="@ControlledCode">
        <div class="flex w-full max-w-md flex-col items-center gap-3">
            <BzCommand @bind-Search="_search" Class="w-full rounded-lg border shadow-md">
                <BzCommandInput Placeholder="Search fruit..." />
                <BzCommandList>
                    <BzCommandEmpty>No fruit found.</BzCommandEmpty>
                    <BzCommandGroup Heading="Fruit">
                        <BzCommandItem Value="Apple">Apple</BzCommandItem>
                        <BzCommandItem Value="Banana">Banana</BzCommandItem>
                        <BzCommandItem Value="Blueberry">Blueberry</BzCommandItem>
                        <BzCommandItem Value="Grapes">Grapes</BzCommandItem>
                        <BzCommandItem Value="Pineapple">Pineapple</BzCommandItem>
                    </BzCommandGroup>
                </BzCommandList>
            </BzCommand>
            <p class="text-sm text-muted-foreground">Search: <span class="font-mono">@(string.IsNullOrEmpty(_search) ? "(empty)" : _search)</span></p>
        </div>
    </Demo>

    <Demo Title="Looping" Description="Set Loop so the arrow keys wrap around the ends of the list." Code="@LoopCode">
        <BzCommand Loop="true" Class="w-full max-w-md rounded-lg border shadow-md">
            <BzCommandInput Placeholder="Arrow past the ends to wrap..." />
            <BzCommandList>
                <BzCommandEmpty>No results found.</BzCommandEmpty>
                <BzCommandGroup Heading="Letters">
                    <BzCommandItem Value="Alpha">Alpha</BzCommandItem>
                    <BzCommandItem Value="Bravo">Bravo</BzCommandItem>
                    <BzCommandItem Value="Charlie">Charlie</BzCommandItem>
                    <BzCommandItem Value="Delta">Delta</BzCommandItem>
                </BzCommandGroup>
            </BzCommandList>
        </BzCommand>
    </Demo>

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the icons, padding and shortcuts all mirror to the right." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzCommand Class="w-full max-w-md rounded-lg border shadow-md">
                <BzCommandInput Placeholder="اكتب أمرًا أو ابحث..." />
                <BzCommandList>
                    <BzCommandEmpty>لا توجد نتائج.</BzCommandEmpty>
                    <BzCommandGroup Heading="اقتراحات">
                        <BzCommandItem Value="التقويم"><BzIcon Icon="@Icons.Outline.Calendar" /><span>التقويم</span></BzCommandItem>
                        <BzCommandItem Value="البريد"><BzIcon Icon="@Icons.Outline.Mail" /><span>البريد</span></BzCommandItem>
                        <BzCommandItem Value="الملف الشخصي"><BzIcon Icon="@Icons.Outline.User" /><span>الملف الشخصي</span><BzCommandShortcut>⌘P</BzCommandShortcut></BzCommandItem>
                    </BzCommandGroup>
                </BzCommandList>
            </BzCommand>
        </BzDirectionProvider>
    </Demo>

    <ApiReference Types="ApiFamilies.Command" />
</div>

@code {
    private bool _paletteOpen;
    private string? _lastRun;
    private bool _comboOpen;
    private string? _assignee;
    private string _search = "";

    private static readonly string[] _people = ["Jane Doe", "John Smith", "Alex Johnson", "Maria Garcia"];

    private void RunCommand(string value)
    {
        _lastRun = value;
        _paletteOpen = false;
    }

    private void SelectAssignee(string value)
    {
        _assignee = _assignee == value ? null : value;
        _comboOpen = false;
    }

    private const string DefaultCode = """
        <BzCommand Class="w-full max-w-md rounded-lg border shadow-md">
            <BzCommandInput Placeholder="Type a command or search..." />
            <BzCommandList>
                <BzCommandEmpty>No results found.</BzCommandEmpty>
                <BzCommandGroup Heading="Suggestions">
                    <BzCommandItem Value="Calendar"><BzIcon Icon="@Icons.Outline.Calendar" /><span>Calendar</span></BzCommandItem>
                    <BzCommandItem Value="Send mail" Keywords="@(new[] { "email", "compose" })"><BzIcon Icon="@Icons.Outline.Mail" /><span>Send mail</span></BzCommandItem>
                    <BzCommandItem Value="Calculator" Disabled><BzIcon Icon="@Icons.Outline.Calculator" /><span>Calculator</span></BzCommandItem>
                </BzCommandGroup>
                <BzCommandSeparator />
                <BzCommandGroup Heading="Settings">
                    <BzCommandItem Value="Profile"><BzIcon Icon="@Icons.Outline.User" /><span>Profile</span><BzCommandShortcut>⌘P</BzCommandShortcut></BzCommandItem>
                    <BzCommandItem Value="Billing"><BzIcon Icon="@Icons.Outline.CreditCard" /><span>Billing</span><BzCommandShortcut>⌘B</BzCommandShortcut></BzCommandItem>
                    <BzCommandItem Value="Settings"><BzIcon Icon="@Icons.Outline.Settings" /><span>Settings</span><BzCommandShortcut>⌘S</BzCommandShortcut></BzCommandItem>
                </BzCommandGroup>
            </BzCommandList>
        </BzCommand>
        """;

    private const string DialogCode = """
        <BzButton Variant="ButtonVariant.Outline" @onclick="@(() => _open = true)">
            Search... <BzKbd Key="mod+k" OnTrigger="@(() => _open = true)" />
        </BzButton>

        <BzCommandDialog @bind-Open="_open" Description="Search for a command to run.">
            <BzCommandInput Placeholder="Type a command or search..." />
            <BzCommandList>
                <BzCommandEmpty>No results found.</BzCommandEmpty>
                <BzCommandGroup Heading="Suggestions">
                    <BzCommandItem Value="Calendar" OnSelect="Run"><BzIcon Icon="@Icons.Outline.Calendar" />Calendar</BzCommandItem>
                    <BzCommandItem Value="Launch" OnSelect="Run"><BzIcon Icon="@Icons.Outline.Rocket" />Launch</BzCommandItem>
                </BzCommandGroup>
            </BzCommandList>
        </BzCommandDialog>

        @code {
            private bool _open;
            private void Run(string value) => _open = false;
        }
        """;

    private const string ComboboxCode = """
        <BzPopover @bind-Open="_open">
            <BzPopoverTrigger>
                <AsChild Context="p">
                    <BzButton Variant="ButtonVariant.Outline" role="combobox" Class="w-64 justify-between" @attributes="p.Attributes">
                        @(_value ?? "Assign to...")
                        <BzIcon Icon="@Icons.Outline.Selector" Class="opacity-50" />
                    </BzButton>
                </AsChild>
            </BzPopoverTrigger>
            <BzPopoverContent Class="w-64 !p-0">
                <BzCommand>
                    <BzCommandInput Placeholder="Search people..." />
                    <BzCommandList>
                        <BzCommandEmpty>No one found.</BzCommandEmpty>
                        <BzCommandGroup>
                            <BzCommandItem Value="Jane Doe" OnSelect="Select">
                                <BzIcon Icon="@Icons.Outline.Check" Class="@(_value == "Jane Doe" ? "opacity-100" : "opacity-0")" />
                                Jane Doe
                            </BzCommandItem>
                            @* ...more items... *@
                        </BzCommandGroup>
                    </BzCommandList>
                </BzCommand>
            </BzPopoverContent>
        </BzPopover>

        @code {
            private bool _open;
            private string? _value;
            private void Select(string v) { _value = v; _open = false; }
        }
        """;

    private const string ControlledCode = """
        <BzCommand @bind-Search="_search">
            <BzCommandInput Placeholder="Search fruit..." />
            <BzCommandList>
                <BzCommandEmpty>No fruit found.</BzCommandEmpty>
                <BzCommandGroup Heading="Fruit">
                    <BzCommandItem Value="Apple">Apple</BzCommandItem>
                    <BzCommandItem Value="Banana">Banana</BzCommandItem>
                </BzCommandGroup>
            </BzCommandList>
        </BzCommand>

        @code { private string _search = ""; }
        """;

    private const string LoopCode = """
        <BzCommand Loop="true">
            <BzCommandInput Placeholder="Arrow past the ends to wrap..." />
            <BzCommandList>
                <BzCommandEmpty>No results found.</BzCommandEmpty>
                <BzCommandGroup Heading="Letters">
                    <BzCommandItem Value="Alpha">Alpha</BzCommandItem>
                    <BzCommandItem Value="Bravo">Bravo</BzCommandItem>
                </BzCommandGroup>
            </BzCommandList>
        </BzCommand>
        """;

    private const string RtlCode = """
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzCommand Class="w-full max-w-md rounded-lg border shadow-md">
                <BzCommandInput Placeholder="اكتب أمرًا أو ابحث..." />
                <BzCommandList>
                    <BzCommandEmpty>لا توجد نتائج.</BzCommandEmpty>
                    <BzCommandGroup Heading="اقتراحات">
                        <BzCommandItem Value="التقويم"><BzIcon Icon="@Icons.Outline.Calendar" /><span>التقويم</span></BzCommandItem>
                        <BzCommandItem Value="البريد"><BzIcon Icon="@Icons.Outline.Mail" /><span>البريد</span></BzCommandItem>
                    </BzCommandGroup>
                </BzCommandList>
            </BzCommand>
        </BzDirectionProvider>
        """;
}
