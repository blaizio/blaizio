@page "/components/icons"
<PageTitle>Icons - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Icons</h1>
        <p class="text-muted-foreground">The full Tabler icon set, rendered with <code>BzIcon</code>. Each member of <code>Icons.Outline</code> / <code>Icons.Filled</code> is a typed <code>Icon</code> value that knows its own family, so a single value is all you pass. Colour follows <code>currentColor</code>; size it with a CSS class.</p>
    </header>

    <UsageBlock Setup="@UsageSetup" Code="@UsageMarkup"
                Description="Pass a typed Icon from Icons.Outline or Icons.Filled - no string, no family flag. Colour follows currentColor; size it with a class." />

    <ExamplesHeading />

    <Demo Title="Basic" Description="Pass an Icon from Icons.Outline or Icons.Filled - no string, no family flag." Code="@UsageCode">
        <div class="flex items-center gap-5 text-foreground">
            <BzIcon Icon="@Icons.Outline.Heart" Class="size-6" />
            <BzIcon Icon="@Icons.Outline.Star" Class="size-6" />
            <BzIcon Icon="@Icons.Outline.Bell" Class="size-6" />
            <BzIcon Icon="@Icons.Outline.Settings" Class="size-6" />
            <BzIcon Icon="@Icons.Outline.Home" Class="size-6" />
        </div>
    </Demo>

    <Demo Title="Outline and filled" Description="The two Tabler families; the Icon carries which it is." Code="@FamiliesCode">
        <div class="flex items-center gap-6">
            <div class="flex items-center gap-3 text-foreground">
                <BzIcon Icon="@Icons.Outline.Heart" Class="size-7" />
                <BzIcon Icon="@Icons.Outline.Star" Class="size-7" />
                <BzIcon Icon="@Icons.Outline.Sun" Class="size-7" />
            </div>
            <BzSeparator Orientation="Orientation.Vertical" Class="!h-7" />
            <div class="flex items-center gap-3">
                <BzIcon Icon="@Icons.Filled.Heart" Class="size-7 text-rose-500" />
                <BzIcon Icon="@Icons.Filled.Star" Class="size-7 text-amber-500" />
                <BzIcon Icon="@Icons.Filled.Sun" Class="size-7 text-yellow-500" />
            </div>
        </div>
    </Demo>

    <Demo Title="Sizing" Description="Set the size with a class (e.g. Tailwind size-*); the stroke scales with it." Code="@SizingCode">
        <div class="flex items-end gap-4 text-primary">
            <BzIcon Icon="@Icons.Outline.Bolt" Class="size-4" />
            <BzIcon Icon="@Icons.Outline.Bolt" Class="size-6" />
            <BzIcon Icon="@Icons.Outline.Bolt" Class="size-8" />
            <BzIcon Icon="@Icons.Outline.Bolt" Class="size-10" />
        </div>
    </Demo>

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider - the icon row mirrors and flows from the right." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <div class="flex items-center gap-5 text-foreground">
                <BzIcon Icon="@Icons.Outline.Heart" Class="size-6" />
                <BzIcon Icon="@Icons.Outline.Star" Class="size-6" />
                <BzIcon Icon="@Icons.Outline.Bell" Class="size-6" />
                <BzIcon Icon="@Icons.Outline.Settings" Class="size-6" />
                <BzIcon Icon="@Icons.Outline.Home" Class="size-6" />
            </div>
        </BzDirectionProvider>
    </Demo>

    <section class="space-y-3">
        <h2 data-toc class="scroll-mt-20 text-lg font-semibold tracking-tight">Bundle size: you only ship what you use</h2>
        <p class="text-muted-foreground text-sm">The package carries the whole Tabler set (~6,000 icons), but a real app references a handful - and only those are shipped.</p>
        <BzAlert>
            <BzIcon Icon="@Icons.Outline.InfoCircle" />
            <BzAlertTitle>Keep trimming on for WebAssembly</BzAlertTitle>
            <BzAlertDescription>
                <code>Blazeo.Icons</code> is marked trimmable, and each icon is a self-contained expression-bodied
                property (no whole-set static constructor). So when you publish a Blazor WebAssembly app with IL
                trimming - the default for a <code>Release</code> publish (<code>PublishTrimmed</code>) - the trimmer
                drops every icon you never reference. In this docs app that takes <code>Blazeo.Icons</code> from
                <strong>~3.2 MB to ~5 KB</strong> over the wire. Leave <code>PublishTrimmed</code> enabled (it is by
                default); the only thing that defeats it is reaching the icons by reflection instead of a direct
                <code>Icons.Outline.X</code> reference. To check your <em>real</em> payload, open
                <code>publish/wwwroot/_framework</code> after a Release publish (the trimmed assembly there has a
                <code>.br</code> and no <code>.pdb</code>) - not the full ~3.2 MB copy in
                <code>bin/&hellip;/wwwroot/_framework</code> that <code>build</code> and <code>dotnet run</code> serve.
                On <strong>Blazor Server</strong> there is nothing to download - the assembly is loaded host-side - so
                its size is a non-issue there.
            </BzAlertDescription>
        </BzAlert>
    </section>
</div>

@code {
    private const string UsageSetup = """
        @* _Imports.razor (or the top of the page) *@
        @using Blazeo.Ui
        """;

    private const string UsageMarkup = """
        <BzIcon Icon="@Icons.Outline.Heart" Class="size-6" />
        <BzIcon Icon="@Icons.Filled.Star" Class="size-6 text-amber-500" />
        """;

    private const string UsageCode = """
        <BzIcon Icon="@Icons.Outline.Heart" Class="size-6" />
        <BzIcon Icon="@Icons.Outline.Star" Class="size-6" />
        <BzIcon Icon="@Icons.Outline.Bell" Class="size-6" />
        <BzIcon Icon="@Icons.Outline.Settings" Class="size-6" />
        <BzIcon Icon="@Icons.Outline.Home" Class="size-6" />
        """;

    private const string FamiliesCode = """
        @* Outline (stroked) *@
        <BzIcon Icon="@Icons.Outline.Heart" Class="size-7" />
        <BzIcon Icon="@Icons.Outline.Star" Class="size-7" />
        <BzIcon Icon="@Icons.Outline.Sun" Class="size-7" />

        <BzSeparator Orientation="Orientation.Vertical" Class="!h-7" />

        @* Filled - the Icon already knows it's filled *@
        <BzIcon Icon="@Icons.Filled.Heart" Class="size-7 text-rose-500" />
        <BzIcon Icon="@Icons.Filled.Star" Class="size-7 text-amber-500" />
        <BzIcon Icon="@Icons.Filled.Sun" Class="size-7 text-yellow-500" />
        """;

    private const string SizingCode = """
        <BzIcon Icon="@Icons.Outline.Bolt" Class="size-4" />
        <BzIcon Icon="@Icons.Outline.Bolt" Class="size-6" />
        <BzIcon Icon="@Icons.Outline.Bolt" Class="size-8" />
        <BzIcon Icon="@Icons.Outline.Bolt" Class="size-10" />
        """;

    private const string RtlCode = """
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzIcon Icon="@Icons.Outline.Heart" Class="size-6" />
            <BzIcon Icon="@Icons.Outline.Star" Class="size-6" />
            <BzIcon Icon="@Icons.Outline.Bell" Class="size-6" />
            <BzIcon Icon="@Icons.Outline.Settings" Class="size-6" />
            <BzIcon Icon="@Icons.Outline.Home" Class="size-6" />
        </BzDirectionProvider>
        """;
}
