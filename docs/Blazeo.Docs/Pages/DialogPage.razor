@page "/components/dialog"
<PageTitle>Dialog - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Dialog</h1>
        <p class="text-muted-foreground">A modal window overlaid on the page: focus is trapped inside, page scroll locks, and Escape or a click on the backdrop dismisses it.</p>
    </header>

    <UsageBlock Setup="@UsageSetup" Code="@UsageMarkup"
                Description="Add the using once, then compose a trigger and content. Wrap any action in BzDialogClose to dismiss." />

    <CompositionTree Root="_anatomy"
                     Description="The full anatomy. Header holds the title and description; wrap footer actions in BzDialogClose to close the dialog." />

    <ExamplesHeading />

    <Demo Title="Default"
          Description="The trigger and close buttons render a styled BzButton by default - no RenderAs needed. Set Variant/Size to restyle them."
          Code="@DefaultCode">
        <BzDialog>
            <BzDialogTrigger Variant="ButtonVariant.Outline">Edit profile</BzDialogTrigger>
            <BzDialogContent>
                <BzDialogHeader>
                    <BzDialogTitle>Edit profile</BzDialogTitle>
                    <BzDialogDescription>Make changes to your profile here. Click save when you're done.</BzDialogDescription>
                </BzDialogHeader>
                <div class="grid gap-4">
                    <div class="grid gap-2">
                        <BzLabel for="dialog-name">Name</BzLabel>
                        <BzInputText id="dialog-name" Value="Ada Lovelace" />
                    </div>
                    <div class="grid gap-2">
                        <BzLabel for="dialog-username">Username</BzLabel>
                        <BzInputText id="dialog-username" Value="@("@ada")" />
                    </div>
                </div>
                <BzDialogFooter>
                    <BzDialogClose>Cancel</BzDialogClose>
                    <BzDialogClose Variant="ButtonVariant.Default">Save changes</BzDialogClose>
                </BzDialogFooter>
            </BzDialogContent>
        </BzDialog>
    </Demo>

    <Demo Title="Custom trigger element (RenderAs)"
          Description="When you need the trigger to be something other than a button - a link, a card, your own component - use RenderAs and splat the behaviour onto your element."
          Code="@RenderAsTriggerCode">
        <BzDialog>
            <BzDialogTrigger>
                <RenderAs Context="p">
                    <a href="#" @onclick:preventDefault @attributes="p.Attributes" class="text-sm font-medium text-indigo-600 underline-offset-4 hover:underline dark:text-indigo-400">Open as a link</a>
                </RenderAs>
            </BzDialogTrigger>
            <BzDialogContent>
                <BzDialogHeader>
                    <BzDialogTitle>Custom trigger</BzDialogTitle>
                    <BzDialogDescription>This dialog was opened by an anchor, not a button.</BzDialogDescription>
                </BzDialogHeader>
                <BzDialogFooter>
                    <BzDialogClose>Close</BzDialogClose>
                </BzDialogFooter>
            </BzDialogContent>
        </BzDialog>
    </Demo>

    <Demo Title="Scrollable content" Code="@ScrollableCode">
        <BzDialog>
            <BzDialogTrigger Variant="ButtonVariant.Outline">Scrollable content</BzDialogTrigger>
            <BzDialogContent>
                <BzDialogHeader>
                    <BzDialogTitle>Terms of service</BzDialogTitle>
                    <BzDialogDescription>The body scrolls; the page behind stays locked.</BzDialogDescription>
                </BzDialogHeader>
                <div class="scrollbar-thin -mx-6 max-h-[50vh] overflow-y-auto px-6">
                    @for (var i = 0; i < 8; i++)
                    {
                        <p class="mb-4 leading-normal">@LoremText</p>
                    }
                </div>
            </BzDialogContent>
        </BzDialog>
    </Demo>

    <Demo Title="Sticky footer" Code="@StickyFooterCode">
        <BzDialog>
            <BzDialogTrigger Variant="ButtonVariant.Outline">Sticky footer</BzDialogTrigger>
            <BzDialogContent>
                <BzDialogHeader>
                    <BzDialogTitle>Release notes</BzDialogTitle>
                    <BzDialogDescription>Header and footer stay visible while the body scrolls.</BzDialogDescription>
                </BzDialogHeader>
                <div class="scrollbar-thin -mx-6 max-h-[50vh] overflow-y-auto px-6">
                    @for (var i = 0; i < 8; i++)
                    {
                        <p class="mb-4 leading-normal">@LoremText</p>
                    }
                </div>
                <BzDialogFooter>
                    <BzDialogClose Variant="ButtonVariant.Outline">Close</BzDialogClose>
                    <BzDialogClose>Accept</BzDialogClose>
                </BzDialogFooter>
            </BzDialogContent>
        </BzDialog>
    </Demo>

    <Demo Title="Controlled" Code="@ControlledCode">
        <div class="flex flex-col items-center gap-4">
            <span class="text-muted-foreground text-sm">Open: @_open</span>
            <BzDialog @bind-Open="_open">
                <BzDialogTrigger Variant="ButtonVariant.Outline">Open</BzDialogTrigger>
                <BzDialogContent>
                    <BzDialogHeader>
                        <BzDialogTitle>Controlled dialog</BzDialogTitle>
                        <BzDialogDescription>The open state lives in the page via @@bind-Open.</BzDialogDescription>
                    </BzDialogHeader>
                    <BzDialogFooter ShowCloseButton="true" />
                </BzDialogContent>
            </BzDialog>
        </div>
    </Demo>

    <Demo Title="Without close button" Code="@NoCloseCode">
        <BzDialog>
            <BzDialogTrigger Variant="ButtonVariant.Outline">Terms</BzDialogTrigger>
            <BzDialogContent ShowCloseButton="false">
                <BzDialogHeader>
                    <BzDialogTitle>Terms of service</BzDialogTitle>
                    <BzDialogDescription>You must explicitly accept or decline.</BzDialogDescription>
                </BzDialogHeader>
                <BzDialogFooter>
                    <BzDialogClose Variant="ButtonVariant.Outline">Decline</BzDialogClose>
                    <BzDialogClose>Accept</BzDialogClose>
                </BzDialogFooter>
            </BzDialogContent>
        </BzDialog>
    </Demo>
    <Demo Title="Prevent dismiss" Code="@PreventDismissCode">
        <BzDialog PreventDismiss="true">
            <BzDialogTrigger Variant="ButtonVariant.Outline">Open locked dialog</BzDialogTrigger>
            <BzDialogContent>
                <BzDialogHeader>
                    <BzDialogTitle>Locked</BzDialogTitle>
                    <BzDialogDescription>Escape and clicking outside do nothing, and the corner close button is hidden. Use Done to close.</BzDialogDescription>
                </BzDialogHeader>
                <BzDialogFooter>
                    <BzDialogClose>Done</BzDialogClose>
                </BzDialogFooter>
            </BzDialogContent>
        </BzDialog>
    </Demo>
    <Demo Title="Customization"
          Description="Restyle any part via Class, and the backdrop via OverlayClass - here a branded surface (custom radius, tinted border and background), an indigo title, a matching primary action, and an indigo-blurred backdrop. Root-level utilities win over the skin."
          Code="@CustomCode">
        <BzDialog>
            <BzDialogTrigger Class="bg-indigo-600 text-white hover:bg-indigo-700">Edit profile</BzDialogTrigger>
            <BzDialogContent OverlayClass="bg-indigo-950/40 backdrop-blur-sm"
                             Class="rounded-2xl border-indigo-200 bg-indigo-50/80 dark:border-indigo-900 dark:bg-indigo-950/70">
                <BzDialogHeader>
                    <BzDialogTitle Class="text-indigo-700 dark:text-indigo-300">Edit profile</BzDialogTitle>
                    <BzDialogDescription>Make changes to your profile here. Click save when you're done.</BzDialogDescription>
                </BzDialogHeader>
                <div class="grid gap-4">
                    <div class="grid gap-2">
                        <BzLabel for="dialog-name-custom">Name</BzLabel>
                        <BzInputText id="dialog-name-custom" Value="Ada Lovelace" />
                    </div>
                </div>
                <BzDialogFooter>
                    <BzDialogClose Variant="ButtonVariant.Outline">Cancel</BzDialogClose>
                    <BzDialogClose Class="bg-indigo-600 text-white hover:bg-indigo-700">Save changes</BzDialogClose>
                </BzDialogFooter>
            </BzDialogContent>
        </BzDialog>
    </Demo>
    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the layout, labels and footer buttons mirror to the right." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzDialog>
                <BzDialogTrigger Variant="ButtonVariant.Outline">تعديل الملف الشخصي</BzDialogTrigger>
                <BzDialogContent>
                    <BzDialogHeader>
                        <BzDialogTitle>تعديل الملف الشخصي</BzDialogTitle>
                        <BzDialogDescription>أجرِ تغييرات على ملفك الشخصي هنا. اضغط على حفظ عند الانتهاء.</BzDialogDescription>
                    </BzDialogHeader>
                    <div class="grid gap-4">
                        <div class="grid gap-2">
                            <BzLabel for="dialog-name-rtl">الاسم</BzLabel>
                            <BzInputText id="dialog-name-rtl" Value="آدا لوفلايس" />
                        </div>
                        <div class="grid gap-2">
                            <BzLabel for="dialog-username-rtl">اسم المستخدم</BzLabel>
                            <BzInputText id="dialog-username-rtl" Value="@("@ada")" />
                        </div>
                    </div>
                    <BzDialogFooter>
                        <BzDialogClose Variant="ButtonVariant.Outline">إلغاء</BzDialogClose>
                        <BzDialogClose>حفظ التغييرات</BzDialogClose>
                    </BzDialogFooter>
                </BzDialogContent>
            </BzDialog>
        </BzDirectionProvider>
    </Demo>
    <ApiReference Types="ApiFamilies.Dialog" />
</div>

