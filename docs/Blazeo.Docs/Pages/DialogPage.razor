@page "/components/dialog"
<PageTitle>Dialog - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Dialog</h1>
        <p class="text-muted-foreground">A modal window overlaid on the page: focus is trapped inside, page scroll locks, and Escape or a click on the backdrop dismisses it.</p>
    </header>

    <Demo Title="Default" Code="@DefaultCode">
        <BzDialog>
            <BzDialogTrigger>
                <AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Edit profile</BzButton></AsChild>
            </BzDialogTrigger>
            <BzDialogContent>
                <BzDialogHeader>
                    <BzDialogTitle>Edit profile</BzDialogTitle>
                    <BzDialogDescription>Make changes to your profile here. Click save when you're done.</BzDialogDescription>
                </BzDialogHeader>
                <div class="grid gap-4">
                    <div class="grid gap-2">
                        <BzLabel for="dialog-name">Name</BzLabel>
                        <BzInputText id="dialog-name" Value="Ada Lovelace" />
                    </div>
                    <div class="grid gap-2">
                        <BzLabel for="dialog-username">Username</BzLabel>
                        <BzInputText id="dialog-username" Value="@("@ada")" />
                    </div>
                </div>
                <BzDialogFooter>
                    <BzDialogClose>
                        <AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Cancel</BzButton></AsChild>
                    </BzDialogClose>
                    <BzDialogClose>
                        <AsChild Context="p"><BzButton @attributes="p.Attributes">Save changes</BzButton></AsChild>
                    </BzDialogClose>
                </BzDialogFooter>
            </BzDialogContent>
        </BzDialog>
    </Demo>

    <Demo Title="Scrollable content" Code="@ScrollableCode">
        <BzDialog>
            <BzDialogTrigger>
                <AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Scrollable content</BzButton></AsChild>
            </BzDialogTrigger>
            <BzDialogContent>
                <BzDialogHeader>
                    <BzDialogTitle>Terms of service</BzDialogTitle>
                    <BzDialogDescription>The body scrolls; the page behind stays locked.</BzDialogDescription>
                </BzDialogHeader>
                <div class="scrollbar-thin -mx-6 max-h-[50vh] overflow-y-auto px-6">
                    @for (var i = 0; i < 8; i++)
                    {
                        <p class="mb-4 leading-normal">@LoremText</p>
                    }
                </div>
            </BzDialogContent>
        </BzDialog>
    </Demo>

    <Demo Title="Sticky footer" Code="@StickyFooterCode">
        <BzDialog>
            <BzDialogTrigger>
                <AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Sticky footer</BzButton></AsChild>
            </BzDialogTrigger>
            <BzDialogContent>
                <BzDialogHeader>
                    <BzDialogTitle>Release notes</BzDialogTitle>
                    <BzDialogDescription>Header and footer stay visible while the body scrolls.</BzDialogDescription>
                </BzDialogHeader>
                <div class="scrollbar-thin -mx-6 max-h-[50vh] overflow-y-auto px-6">
                    @for (var i = 0; i < 8; i++)
                    {
                        <p class="mb-4 leading-normal">@LoremText</p>
                    }
                </div>
                <BzDialogFooter>
                    <BzDialogClose>
                        <AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Close</BzButton></AsChild>
                    </BzDialogClose>
                    <BzDialogClose>
                        <AsChild Context="p"><BzButton @attributes="p.Attributes">Accept</BzButton></AsChild>
                    </BzDialogClose>
                </BzDialogFooter>
            </BzDialogContent>
        </BzDialog>
    </Demo>

    <Demo Title="Controlled" Code="@ControlledCode">
        <div class="flex flex-col items-center gap-4">
            <span class="text-muted-foreground text-sm">Open: @_open</span>
            <BzDialog @bind-Open="_open">
                <BzDialogTrigger>
                    <AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Open</BzButton></AsChild>
                </BzDialogTrigger>
                <BzDialogContent>
                    <BzDialogHeader>
                        <BzDialogTitle>Controlled dialog</BzDialogTitle>
                        <BzDialogDescription>The open state lives in the page via @@bind-Open.</BzDialogDescription>
                    </BzDialogHeader>
                    <BzDialogFooter ShowCloseButton="true" />
                </BzDialogContent>
            </BzDialog>
        </div>
    </Demo>

    <Demo Title="Without close button" Code="@NoCloseCode">
        <BzDialog>
            <BzDialogTrigger>
                <AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Terms</BzButton></AsChild>
            </BzDialogTrigger>
            <BzDialogContent ShowCloseButton="false">
                <BzDialogHeader>
                    <BzDialogTitle>Terms of service</BzDialogTitle>
                    <BzDialogDescription>You must explicitly accept or decline.</BzDialogDescription>
                </BzDialogHeader>
                <BzDialogFooter>
                    <BzDialogClose>
                        <AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Decline</BzButton></AsChild>
                    </BzDialogClose>
                    <BzDialogClose>
                        <AsChild Context="p"><BzButton @attributes="p.Attributes">Accept</BzButton></AsChild>
                    </BzDialogClose>
                </BzDialogFooter>
            </BzDialogContent>
        </BzDialog>
    </Demo>
    <Demo Title="Prevent dismiss" Code="@PreventDismissCode">
        <BzDialog PreventDismiss="true">
            <BzDialogTrigger>
                <AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Open locked dialog</BzButton></AsChild>
            </BzDialogTrigger>
            <BzDialogContent>
                <BzDialogHeader>
                    <BzDialogTitle>Locked</BzDialogTitle>
                    <BzDialogDescription>Escape and clicking outside do nothing, and the corner close button is hidden. Use Done to close.</BzDialogDescription>
                </BzDialogHeader>
                <BzDialogFooter>
                    <BzDialogClose>
                        <AsChild Context="p"><BzButton @attributes="p.Attributes">Done</BzButton></AsChild>
                    </BzDialogClose>
                </BzDialogFooter>
            </BzDialogContent>
        </BzDialog>
    </Demo>
    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the layout, labels and footer buttons mirror to the right." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzDialog>
                <BzDialogTrigger>
                    <AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">تعديل الملف الشخصي</BzButton></AsChild>
                </BzDialogTrigger>
                <BzDialogContent>
                    <BzDialogHeader>
                        <BzDialogTitle>تعديل الملف الشخصي</BzDialogTitle>
                        <BzDialogDescription>أجرِ تغييرات على ملفك الشخصي هنا. اضغط على حفظ عند الانتهاء.</BzDialogDescription>
                    </BzDialogHeader>
                    <div class="grid gap-4">
                        <div class="grid gap-2">
                            <BzLabel for="dialog-name-rtl">الاسم</BzLabel>
                            <BzInputText id="dialog-name-rtl" Value="آدا لوفلايس" />
                        </div>
                        <div class="grid gap-2">
                            <BzLabel for="dialog-username-rtl">اسم المستخدم</BzLabel>
                            <BzInputText id="dialog-username-rtl" Value="@("@ada")" />
                        </div>
                    </div>
                    <BzDialogFooter>
                        <BzDialogClose>
                            <AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">إلغاء</BzButton></AsChild>
                        </BzDialogClose>
                        <BzDialogClose>
                            <AsChild Context="p"><BzButton @attributes="p.Attributes">حفظ التغييرات</BzButton></AsChild>
                        </BzDialogClose>
                    </BzDialogFooter>
                </BzDialogContent>
            </BzDialog>
        </BzDirectionProvider>
    </Demo>
    <ApiReference Types="ApiFamilies.Dialog" />
</div>

