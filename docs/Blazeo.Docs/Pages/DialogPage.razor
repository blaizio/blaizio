    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode _anatomy = new CompositionNode("BzDialog",
        new CompositionNode("BzDialogTrigger"),
        new CompositionNode("BzDialogContent",
            new CompositionNode("BzDialogHeader",
                new CompositionNode("BzDialogTitle"),
                new CompositionNode("BzDialogDescription")),
            new CompositionNode("BzDialogFooter",
