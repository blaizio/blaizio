@page "/components/dialog"
<PageTitle>Dialog - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Dialog</h1>
        <p class="text-muted-foreground">A modal window overlaid on the page: focus is trapped inside, page scroll locks, and Escape or a click on the backdrop dismisses it.</p>
    </header>

    <Demo Title="Default" Code="@DefaultCode">
        <Dialog>
            <DialogTrigger>
                <AsChild Context="p"><Button Variant="ButtonVariant.Outline" @attributes="p.Attributes">Edit profile</Button></AsChild>
            </DialogTrigger>
            <DialogContent>
                <DialogHeader>
                    <DialogTitle>Edit profile</DialogTitle>
                    <DialogDescription>Make changes to your profile here. Click save when you're done.</DialogDescription>
                </DialogHeader>
                <div class="grid gap-4">
                    <div class="grid gap-2">
                        <Label for="dialog-name">Name</Label>
                        <Input id="dialog-name" Value="Ada Lovelace" />
                    </div>
                    <div class="grid gap-2">
                        <Label for="dialog-username">Username</Label>
                        <Input id="dialog-username" Value="@("@ada")" />
                    </div>
                </div>
                <DialogFooter>
                    <DialogClose>
                        <AsChild Context="p"><Button Variant="ButtonVariant.Outline" @attributes="p.Attributes">Cancel</Button></AsChild>
                    </DialogClose>
                    <DialogClose>
                        <AsChild Context="p"><Button @attributes="p.Attributes">Save changes</Button></AsChild>
                    </DialogClose>
                </DialogFooter>
            </DialogContent>
        </Dialog>
    </Demo>

    <Demo Title="Scrollable content" Code="@ScrollableCode">
        <Dialog>
            <DialogTrigger>
                <AsChild Context="p"><Button Variant="ButtonVariant.Outline" @attributes="p.Attributes">Scrollable content</Button></AsChild>
            </DialogTrigger>
            <DialogContent>
                <DialogHeader>
                    <DialogTitle>Terms of service</DialogTitle>
                    <DialogDescription>The body scrolls; the page behind stays locked.</DialogDescription>
                </DialogHeader>
                <div class="-mx-6 max-h-[50vh] overflow-y-auto px-6">
                    @for (var i = 0; i < 8; i++)
                    {
                        <p class="mb-4 leading-normal">@LoremText</p>
                    }
                </div>
            </DialogContent>
        </Dialog>
    </Demo>

    <Demo Title="Sticky footer" Code="@StickyFooterCode">
        <Dialog>
            <DialogTrigger>
                <AsChild Context="p"><Button Variant="ButtonVariant.Outline" @attributes="p.Attributes">Sticky footer</Button></AsChild>
            </DialogTrigger>
            <DialogContent>
                <DialogHeader>
                    <DialogTitle>Release notes</DialogTitle>
                    <DialogDescription>Header and footer stay visible while the body scrolls.</DialogDescription>
                </DialogHeader>
                <div class="-mx-6 max-h-[50vh] overflow-y-auto px-6">
                    @for (var i = 0; i < 8; i++)
                    {
                        <p class="mb-4 leading-normal">@LoremText</p>
                    }
                </div>
                <DialogFooter>
                    <DialogClose>
                        <AsChild Context="p"><Button Variant="ButtonVariant.Outline" @attributes="p.Attributes">Close</Button></AsChild>
                    </DialogClose>
                    <DialogClose>
                        <AsChild Context="p"><Button @attributes="p.Attributes">Accept</Button></AsChild>
                    </DialogClose>
                </DialogFooter>
            </DialogContent>
        </Dialog>
    </Demo>

    <Demo Title="Controlled" Code="@ControlledCode">
        <div class="flex items-center gap-4">
            <Dialog @bind-Open="_open">
                <DialogTrigger>
                    <AsChild Context="p"><Button Variant="ButtonVariant.Outline" @attributes="p.Attributes">Open</Button></AsChild>
                </DialogTrigger>
                <DialogContent>
                    <DialogHeader>
                        <DialogTitle>Controlled dialog</DialogTitle>
                        <DialogDescription>The open state lives in the page via @@bind-Open.</DialogDescription>
                    </DialogHeader>
                    <DialogFooter ShowCloseButton="true" />
                </DialogContent>
            </Dialog>
            <span class="text-muted-foreground text-sm">Open: @_open</span>
        </div>
    </Demo>

    <Demo Title="Without close button" Code="@NoCloseCode">
        <Dialog>
            <DialogTrigger>
                <AsChild Context="p"><Button Variant="ButtonVariant.Outline" @attributes="p.Attributes">Terms</Button></AsChild>
            </DialogTrigger>
            <DialogContent ShowCloseButton="false">
                <DialogHeader>
                    <DialogTitle>Terms of service</DialogTitle>
                    <DialogDescription>You must explicitly accept or decline.</DialogDescription>
                </DialogHeader>
                <DialogFooter>
                    <DialogClose>
                        <AsChild Context="p"><Button Variant="ButtonVariant.Outline" @attributes="p.Attributes">Decline</Button></AsChild>
                    </DialogClose>
                    <DialogClose>
                        <AsChild Context="p"><Button @attributes="p.Attributes">Accept</Button></AsChild>
                    </DialogClose>
                </DialogFooter>
            </DialogContent>
        </Dialog>
    </Demo>
    <Demo Title="Prevent dismiss" Code="@PreventDismissCode">
        <Dialog PreventDismiss="true">
            <DialogTrigger>
                <AsChild Context="p"><Button Variant="ButtonVariant.Outline" @attributes="p.Attributes">Open locked dialog</Button></AsChild>
            </DialogTrigger>
            <DialogContent>
                <DialogHeader>
                    <DialogTitle>Locked</DialogTitle>
                    <DialogDescription>Escape and clicking outside do nothing, and the corner close button is hidden. Use Done to close.</DialogDescription>
                </DialogHeader>
                <DialogFooter>
                    <DialogClose>
                        <AsChild Context="p"><Button @attributes="p.Attributes">Done</Button></AsChild>
                    </DialogClose>
                </DialogFooter>
            </DialogContent>
        </Dialog>
    </Demo>
    <ApiReference Types="ApiFamilies.Dialog" />
</div>

