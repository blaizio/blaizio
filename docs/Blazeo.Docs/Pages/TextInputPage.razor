@page "/components/text-input"
<PageTitle>Text Input - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Text Input</h1>
        <p class="text-muted-foreground">One text field for both single- and multi-line input: it is a single-line <code class="font-mono text-sm">&lt;input&gt;</code> by default, and becomes a multi-line <code class="font-mono text-sm">&lt;textarea&gt;</code> the moment you set <code class="font-mono text-sm">Rows</code>. <code class="font-mono text-sm">@@bind-Value</code> updates live as you type.</p>
    </header>

    <Demo Title="Default" Code="@DefaultCode">
        <TextInput placeholder="Email" Type="email" Class="max-w-sm" />
    </Demo>

    <Demo Title="Multiline" Description="Set Rows to render a textarea. It still grows with its content above that height." Code="@MultilineCode">
        <TextInput Rows="4" placeholder="Type your message here." Class="max-w-sm" />
    </Demo>

    <Demo Title="With Field" Description="Field wires the label, description, and ids; the field stays validation-agnostic." Code="@FieldCode">
        <div class="w-full max-w-sm">
            <Field>
                <FieldLabel>Email</FieldLabel>
                <FieldControl Context="ctl">
                    <TextInput @attributes="ctl" Type="email" placeholder="m@example.com" @bind-Value="_email" />
                </FieldControl>
                <FieldDescription>We'll never share it.</FieldDescription>
            </Field>
        </div>
    </Demo>

    <Demo Title="Multiline with Field" Description="The same Field wiring works for the multi-line mode." Code="@MultilineFieldCode">
        <div class="w-full max-w-sm">
            <Field>
                <FieldLabel>Your message</FieldLabel>
                <FieldControl Context="ctl">
                    <TextInput @attributes="ctl" Rows="4" placeholder="Type your message here." @bind-Value="_message" />
                </FieldControl>
                <FieldDescription>It will be sent to the team.</FieldDescription>
            </Field>
        </div>
    </Demo>

    <Demo Title="Invalid" Description="aria-invalid drives the destructive ring - here forced, normally set by FieldControl." Code="@InvalidCode">
        <TextInput placeholder="Username" aria-invalid="true" Class="max-w-sm" />
    </Demo>

    <Demo Title="Disabled" Code="@DisabledCode">
        <TextInput placeholder="Disabled" Disabled Class="max-w-sm" />
    </Demo>

    <Demo Title="File" Description="Type is single-line only (a textarea has no type), so it is ignored once Rows is set." Code="@FileCode">
        <TextInput Type="file" Class="max-w-sm" />
    </Demo>

    <Demo Title="Live binding" Description="The label mirrors the value on every keystroke." Code="@BindingCode">
        <div class="flex w-full max-w-sm flex-col items-center gap-3">
            <TextInput placeholder="Type something…" @bind-Value="_live" />
            <p class="text-sm text-muted-foreground">Value: <span class="font-mono">@(_live ?? "-")</span></p>
        </div>
    </Demo>

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the labels, placeholders, and descriptions all mirror to the right." Code="@RtlCode">
        <DirectionProvider Direction="Direction.Rtl">
            <div class="w-full max-w-sm space-y-4">
                <Field>
                    <FieldLabel>البريد الإلكتروني</FieldLabel>
                    <FieldControl Context="ctl">
                        <TextInput @attributes="ctl" Type="email" placeholder="m@example.com" @bind-Value="_email" />
                    </FieldControl>
                    <FieldDescription>لن نشاركه مع أحد أبدًا.</FieldDescription>
                </Field>
                <Field>
                    <FieldLabel>رسالتك</FieldLabel>
                    <FieldControl Context="ctl">
                        <TextInput @attributes="ctl" Rows="4" placeholder="اكتب رسالتك هنا." @bind-Value="_message" />
                    </FieldControl>
                    <FieldDescription>ستُرسل إلى الفريق.</FieldDescription>
                </Field>
            </div>
        </DirectionProvider>
    </Demo>
    <ApiReference Types="ApiFamilies.TextInput" />
</div>

@code {
    private string? _email;
    private string? _message;
    private string? _live;

    private const string DefaultCode = """
        <TextInput placeholder="Email" Type="email" />
        """;

    private const string MultilineCode = """
        <TextInput Rows="4" placeholder="Type your message here." />
        """;

    private const string FieldCode = """
        <Field>
            <FieldLabel>Email</FieldLabel>
            <FieldControl Context="ctl">
                <TextInput @attributes="ctl" Type="email" placeholder="m@example.com" @bind-Value="_email" />
            </FieldControl>
            <FieldDescription>We'll never share it.</FieldDescription>
        </Field>
        """;

    private const string MultilineFieldCode = """
        <Field>
            <FieldLabel>Your message</FieldLabel>
            <FieldControl Context="ctl">
                <TextInput @attributes="ctl" Rows="4" @bind-Value="_message" />
            </FieldControl>
            <FieldDescription>It will be sent to the team.</FieldDescription>
        </Field>
        """;

    private const string InvalidCode = """
        <TextInput placeholder="Username" aria-invalid="true" />
        """;

    private const string DisabledCode = """
        <TextInput placeholder="Disabled" Disabled />
        """;

    private const string FileCode = """
        <TextInput Type="file" />
        """;

    private const string BindingCode = """
        <TextInput placeholder="Type something…" @bind-Value="_live" />
        <p>Value: @_live</p>

        @code { private string? _live; }
        """;

    private const string RtlCode = """
        <DirectionProvider Direction="Direction.Rtl">
            <Field>
                <FieldLabel>البريد الإلكتروني</FieldLabel>
                <FieldControl Context="ctl">
                    <TextInput @attributes="ctl" Type="email" placeholder="m@example.com" @bind-Value="_email" />
                </FieldControl>
                <FieldDescription>لن نشاركه مع أحد أبدًا.</FieldDescription>
            </Field>
            <Field>
                <FieldLabel>رسالتك</FieldLabel>
                <FieldControl Context="ctl">
                    <TextInput @attributes="ctl" Rows="4" placeholder="اكتب رسالتك هنا." @bind-Value="_message" />
                </FieldControl>
                <FieldDescription>ستُرسل إلى الفريق.</FieldDescription>
            </Field>
        </DirectionProvider>
        """;
}
