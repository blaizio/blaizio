@page "/components/badge"
<PageTitle>Badge - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Badge</h1>
        <p class="text-muted-foreground">A small label for status, counts, or categories.</p>
    </header>

    <Demo Title="Variants" Code="@VariantsCode">
        <div class="flex flex-wrap items-center gap-2">
            <Badge>Default</Badge>
            <Badge Variant="BadgeVariant.Secondary">Secondary</Badge>
            <Badge Variant="BadgeVariant.Destructive">Destructive</Badge>
            <Badge Variant="BadgeVariant.Outline">Outline</Badge>
        </div>
    </Demo>

    <Demo Title="With icon" Code="@IconCode">
        <div class="flex flex-wrap items-center gap-2">
            <Badge><BzIcon Icon="@Icons.Outline.Check" /> Verified</Badge>
            <Badge Variant="BadgeVariant.Destructive"><BzIcon Icon="@Icons.Outline.X" /> Failed</Badge>
        </div>
    </Demo>

    <Demo Title="Counts" Description="Numeric badges, e.g. for notifications." Code="@CountsCode">
        <div class="flex flex-wrap items-center gap-2">
            <Badge>8</Badge>
            <Badge Variant="BadgeVariant.Secondary">99+</Badge>
            <Badge Variant="BadgeVariant.Destructive">3</Badge>
            <Badge Class="size-5 rounded-full p-0" Variant="BadgeVariant.Destructive">5</Badge>
        </div>
    </Demo>

    <Demo Title="As a link" Description="Use asChild to render the badge as an anchor." Code="@AsChildCode">
        <Badge Variant="BadgeVariant.Outline">
            <AsChild Context="p">
                <a href="#" @attributes="p.Attributes">View docs <BzIcon Icon="@Icons.Outline.ArrowRight" /></a>
            </AsChild>
        </Badge>
    </Demo>
    <ApiReference Types="ApiFamilies.Badge" />
</div>

@code {
    private const string VariantsCode = """
        <Badge>Default</Badge>
        <Badge Variant="BadgeVariant.Secondary">Secondary</Badge>
        <Badge Variant="BadgeVariant.Destructive">Destructive</Badge>
        <Badge Variant="BadgeVariant.Outline">Outline</Badge>
        """;

    private const string IconCode = """
        <Badge><BzIcon Icon="@Icons.Outline.Check" /> Verified</Badge>
        <Badge Variant="BadgeVariant.Destructive"><BzIcon Icon="@Icons.Outline.X" /> Failed</Badge>
        """;

    private const string CountsCode = """
        <Badge>8</Badge>
        <Badge Variant="BadgeVariant.Secondary">99+</Badge>
        <Badge Class="size-5 rounded-full p-0" Variant="BadgeVariant.Destructive">5</Badge>
        """;

    private const string AsChildCode = """
        <Badge Variant="BadgeVariant.Outline">
            <AsChild Context="p">
                <a href="#" @attributes="p.Attributes">View docs <BzIcon Icon="@Icons.Outline.ArrowRight" /></a>
            </AsChild>
        </Badge>
        """;
}
