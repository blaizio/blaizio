    private const string TwoPaneCode = """
        @* Master/detail inside one panel: a roving tablist of audiences on the left, the selected one's
           detail on the right. Focus stays on the <ul>; arrow keys move the selection (aria-activedescendant)
           and the highlight + detail follow - no Enter needed. data-nav-manual hands the arrows to OnTwoPaneKey
           instead of the menu's own roving. Viewport=false so the panel re-renders in place as it changes;
           Value/ValueChanged reset the selection to the first audience each time the menu closes (clicking
           outside or Escape closes it). *@
        <BzNavigationMenu Viewport="false" Class="justify-start" Value="@_twoPaneOpen" ValueChanged="OnTwoPaneOpenChanged">
            <BzNavigationMenuList>
                <BzNavigationMenuItem>
                    <BzNavigationMenuTrigger>Product</BzNavigationMenuTrigger>
