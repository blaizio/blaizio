@page "/components/navigation-menu"
<PageTitle>Navigation Menu - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Navigation Menu</h1>
        <p class="text-muted-foreground">A horizontal site-navigation bar whose items can open rich dropdown panels. Hovering (or clicking) a trigger opens its content in a shared viewport that morphs to fit; plain items are just links. Keyboard and screen-reader friendly.</p>
    </header>

    <UsageBlock Setup="@UsageSetup" Code="@UsageMarkup"
                Description="Put items in a BzNavigationMenuList. An item with a dropdown pairs a BzNavigationMenuTrigger with a BzNavigationMenuContent; a plain item holds a single BzNavigationMenuLink." />

    <CompositionTree Root="_anatomy"
                     Description="A list of items. A dropdown item is a trigger plus content; a link item is a single link." />

    <ExamplesHeading />

    <Demo Title="Default" Description="Hover a trigger to open its panel in the shared viewport (it morphs between sizes); the last item is a plain link. Click a trigger to toggle it." Code="@DefaultCode">
        <div class="flex min-h-[320px] justify-center">
            <BzNavigationMenu>
                <BzNavigationMenuList>
                    <BzNavigationMenuItem>
                        <BzNavigationMenuTrigger>Getting started</BzNavigationMenuTrigger>
                        <BzNavigationMenuContent>
                            <ul class="grid gap-2 md:w-[420px] lg:w-[520px] lg:grid-cols-[.75fr_1fr]">
                                <li class="row-span-3">
                                    <BzNavigationMenuLink href="#" Class="from-muted/50 to-muted flex h-full w-full flex-col justify-end rounded-md bg-gradient-to-b p-6 no-underline select-none">
                                        <div class="mt-4 mb-2 text-lg font-medium">Blazeo UI</div>
                                        <p class="text-muted-foreground text-sm leading-tight">Beautifully designed components built for Blazor.</p>
                                    </BzNavigationMenuLink>
                                </li>
                                @ListItem("Introduction", "Re-usable components built with Blazor and Tailwind.")
                                @ListItem("Installation", "How to install dependencies and structure your app.")
                                @ListItem("Typography", "Styles for headings, paragraphs, lists, and more.")
                            </ul>
                        </BzNavigationMenuContent>
                    </BzNavigationMenuItem>
                    <BzNavigationMenuItem>
                        <BzNavigationMenuTrigger>Components</BzNavigationMenuTrigger>
                        <BzNavigationMenuContent>
                            <ul class="grid gap-2 sm:w-[400px] md:w-[500px] md:grid-cols-2 lg:w-[600px]">
                                @ListItem("Alert Dialog", "A modal dialog that interrupts the user with important content and expects a response.")
                                @ListItem("Hover Card", "For sighted users to preview content available behind a link.")
                                @ListItem("Progress", "Displays an indicator showing the completion progress of a task, typically a progress bar.")
                                @ListItem("Scroll Area", "Augments native scroll with a custom, cross-browser styled scrollbar.")
                                @ListItem("Tabs", "A set of layered sections of content displayed one panel at a time.")
                                @ListItem("Tooltip", "A popup that displays information related to an element on hover or focus.")
                            </ul>
                        </BzNavigationMenuContent>
                    </BzNavigationMenuItem>
                    <BzNavigationMenuItem>
                        <BzNavigationMenuLink Class="@NavigationMenuTriggerStyle.Classes" href="#">Docs</BzNavigationMenuLink>
                    </BzNavigationMenuItem>
                    <BzNavigationMenuItem>
                        <BzNavigationMenuTrigger>List</BzNavigationMenuTrigger>
                        <BzNavigationMenuContent>
                            <ul class="grid w-[300px] gap-2">
                                @ListItem("Components", "Browse all components in the library.")
                                @ListItem("Documentation", "Learn how to use the library.")
                                @ListItem("Blog", "Read our latest posts and release notes.")
                            </ul>
                        </BzNavigationMenuContent>
                    </BzNavigationMenuItem>
                </BzNavigationMenuList>
            </BzNavigationMenu>
        </div>
    </Demo>

    <Demo Title="Without the viewport" Description="With Viewport=false each panel drops as a bordered dropdown directly under its own item, instead of into a shared morphing viewport." Code="@InlineCode">
        <div class="flex min-h-[280px] justify-center">
            <BzNavigationMenu Viewport="false">
                <BzNavigationMenuList>
                    <BzNavigationMenuItem>
                        <BzNavigationMenuTrigger>Overview</BzNavigationMenuTrigger>
                        <BzNavigationMenuContent>
                            <ul class="grid w-[300px] gap-2">
                                @ListItem("Dashboard", "Your activity at a glance.")
                                @ListItem("Settings", "Manage your account and preferences.")
                            </ul>
                        </BzNavigationMenuContent>
                    </BzNavigationMenuItem>
                    <BzNavigationMenuItem>
                        <BzNavigationMenuTrigger>Resources</BzNavigationMenuTrigger>
                        <BzNavigationMenuContent>
                            <ul class="grid w-[300px] gap-2">
                                @ListItem("Guides", "Step-by-step walkthroughs.")
                                @ListItem("Blog", "The latest news and releases.")
                            </ul>
                        </BzNavigationMenuContent>
                    </BzNavigationMenuItem>
                </BzNavigationMenuList>
            </BzNavigationMenu>
        </div>
    </Demo>

    <Demo Title="Two-pane menu (master / detail)" Description="A panel split into a list of audiences on the left and a detail pane on the right. Open with the trigger (or ArrowDown), then walk the audiences with the arrow keys - the highlight and the detail follow as you go; hover or click does the same with the mouse. Escape (or clicking outside) closes and returns focus to the trigger. It's a composition of the same parts, no new component." Code="@TwoPaneCode">
        @* Viewport=false so the panel re-renders in place as the active audience changes (the shared
           morphing viewport renders the panel once on open and wouldn't reflect later state changes).
           Value/ValueChanged are bound so the selection resets to the first audience each time it closes. *@
        @* w-full + justify-start so the bar sits at the left edge and its wide left-anchored panel has the
           whole preview width to the right (otherwise the demo card centers the bar and clips the panel). *@
        <div class="flex min-h-[420px] w-full">
            <BzNavigationMenu Viewport="false" Class="justify-start" Value="@_twoPaneOpen" ValueChanged="OnTwoPaneOpenChanged">
                <BzNavigationMenuList>
                    <BzNavigationMenuItem>
                        <BzNavigationMenuTrigger>Product</BzNavigationMenuTrigger>
                        <BzNavigationMenuContent>
                            <div class="flex w-[480px] gap-4">
                                @* A roving tablist: focus stays on the <ul>, arrow keys move the selection (and the
                                   highlight + detail follow it) via aria-activedescendant - so navigating is enough,
                                   no Enter needed. data-nav-manual tells the menu engine to leave the arrows to us. *@
                                <ul class="w-48 shrink-0 space-y-1 border-e pe-3 outline-none" role="tablist" aria-orientation="vertical"
                                    aria-label="Product audiences" tabindex="0" data-nav-manual
                                    aria-activedescendant="@($"twopane-{_twoPaneActive}")" @onkeydown="OnTwoPaneKey">
                                    @foreach (var cat in TwoPane)
                                    {
                                        var key = cat.Key;
                                        <li role="presentation">
                                            <div role="tab" id="@($"twopane-{key}")" aria-selected="@(key == _twoPaneActive ? "true" : "false")"
                                                 @onmouseenter="@(() => _twoPaneActive = key)"
                                                 @onclick="@(() => _twoPaneActive = key)"
                                                 class="@TwoPaneTabClass(key == _twoPaneActive)">
                                                <div class="text-sm font-medium leading-none">@cat.Title</div>
                                                <p class="text-muted-foreground mt-1 text-sm leading-snug">@cat.Subtitle</p>
                                            </div>
                                        </li>
                                    }
                                </ul>
                                <div class="flex-1">
                                    <p class="mb-3 text-base font-medium">@ActiveTwoPane.Lead</p>
                                    <ul class="space-y-1">
                                        @foreach (var link in ActiveTwoPane.Links)
                                        {
                                            <li>
                                                <BzNavigationMenuLink href="#">
                                                    <div class="text-sm font-medium leading-none">@link.Title</div>
                                                    <p class="text-muted-foreground text-sm leading-snug">@link.Desc</p>
                                                </BzNavigationMenuLink>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </BzNavigationMenuContent>
                    </BzNavigationMenuItem>
                    <BzNavigationMenuItem>
                        <BzNavigationMenuLink Class="@NavigationMenuTriggerStyle.Classes" href="#">Learn</BzNavigationMenuLink>
                    </BzNavigationMenuItem>
                    <BzNavigationMenuItem>
                        <BzNavigationMenuLink Class="@NavigationMenuTriggerStyle.Classes" href="#">Releases</BzNavigationMenuLink>
                    </BzNavigationMenuItem>
                </BzNavigationMenuList>
            </BzNavigationMenu>
        </div>
    </Demo>

    <Demo Title="With an arrow" Description="Add a BzNavigationMenuArrow as the last item to show a little tail that slides under the open trigger - drawn like the Popover and Tooltip arrows." Code="@ArrowCode">
        <div class="flex min-h-[260px] justify-center">
            <BzNavigationMenu>
                <BzNavigationMenuList>
                    <BzNavigationMenuItem>
                        <BzNavigationMenuTrigger>Product</BzNavigationMenuTrigger>
                        <BzNavigationMenuContent>
                            <ul class="grid w-[320px] gap-2">
                                @ListItem("Features", "Everything you can build.")
                                @ListItem("Pricing", "Plans for every team.")
                            </ul>
                        </BzNavigationMenuContent>
                    </BzNavigationMenuItem>
                    <BzNavigationMenuItem>
                        <BzNavigationMenuTrigger>Company</BzNavigationMenuTrigger>
                        <BzNavigationMenuContent>
                            <ul class="grid w-[320px] gap-2">
                                @ListItem("About", "Who we are.")
                                @ListItem("Careers", "Join the team.")
                            </ul>
                        </BzNavigationMenuContent>
                    </BzNavigationMenuItem>
                    <BzNavigationMenuArrow />
                </BzNavigationMenuList>
            </BzNavigationMenu>
        </div>
    </Demo>

    <Demo Title="Customization" Description="Restyle any part via Class - here pill-shaped triggers with a branded open state and a tinted panel - all merged over the defaults." Code="@CustomCode">
        <div class="flex min-h-[260px] justify-center">
            <BzNavigationMenu>
                <BzNavigationMenuList>
                    <BzNavigationMenuItem>
                        <BzNavigationMenuTrigger Class="rounded-full data-[state=open]:bg-indigo-500/10 data-[state=open]:text-indigo-600 dark:data-[state=open]:text-indigo-400">Product</BzNavigationMenuTrigger>
                        <BzNavigationMenuContent Class="bg-indigo-50/70 dark:bg-indigo-950/40">
                            <ul class="grid w-[320px] gap-2">
                                @ListItem("Features", "Everything you can build.")
                                @ListItem("Pricing", "Plans for every team.")
                            </ul>
                        </BzNavigationMenuContent>
                    </BzNavigationMenuItem>
                    <BzNavigationMenuItem>
                        <BzNavigationMenuLink Class="@($"{NavigationMenuTriggerStyle.Classes} rounded-full")" href="#">Docs</BzNavigationMenuLink>
                    </BzNavigationMenuItem>
                </BzNavigationMenuList>
            </BzNavigationMenu>
        </div>
    </Demo>

    <Demo Title="RTL" Description="Under a right-to-left DirectionProvider the bar, the chevron offset, the panels and the arrow all mirror; the same rich content as the Default example, in Arabic." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <div class="flex min-h-[320px] justify-center">
                <BzNavigationMenu>
                    <BzNavigationMenuList>
                        <BzNavigationMenuItem>
                            <BzNavigationMenuTrigger>البدء</BzNavigationMenuTrigger>
                            <BzNavigationMenuContent>
                                <ul class="grid gap-2 md:w-[420px] lg:w-[520px] lg:grid-cols-[.75fr_1fr]">
                                    <li class="row-span-3">
                                        <BzNavigationMenuLink href="#" Class="from-muted/50 to-muted flex h-full w-full flex-col justify-end rounded-md bg-gradient-to-b p-6 no-underline select-none">
                                            <div class="mt-4 mb-2 text-lg font-medium">بليزو</div>
                                            <p class="text-muted-foreground text-sm leading-tight">مكوّنات مصمّمة بعناية لتطبيقات Blazor.</p>
                                        </BzNavigationMenuLink>
                                    </li>
                                    @ListItemRtl("مقدمة", "مكوّنات قابلة لإعادة الاستخدام مبنية بـ Blazor وTailwind.")
                                    @ListItemRtl("التثبيت", "كيفية تثبيت التبعيات وهيكلة تطبيقك.")
                                    @ListItemRtl("الطباعة", "أنماط للعناوين والفقرات والقوائم.")
                                </ul>
                            </BzNavigationMenuContent>
                        </BzNavigationMenuItem>
                        <BzNavigationMenuItem>
                            <BzNavigationMenuTrigger>المكوّنات</BzNavigationMenuTrigger>
                            <BzNavigationMenuContent>
                                <ul class="grid gap-2 sm:w-[400px] md:w-[500px] md:grid-cols-2">
                                    @ListItemRtl("نافذة تنبيه", "نافذة حوارية تقاطع المستخدم بمحتوى مهم وتنتظر رده.")
                                    @ListItemRtl("بطاقة تمرير", "لمعاينة المحتوى المتاح خلف الرابط.")
                                    @ListItemRtl("شريط التقدّم", "يعرض مؤشرًا لمدى اكتمال مهمة ما.")
                                    @ListItemRtl("علامات تبويب", "أقسام محتوى متراكبة تُعرض واحدة في كل مرة.")
                                </ul>
                            </BzNavigationMenuContent>
                        </BzNavigationMenuItem>
                        <BzNavigationMenuItem>
                            <BzNavigationMenuLink Class="@NavigationMenuTriggerStyle.Classes" href="#">الوثائق</BzNavigationMenuLink>
                        </BzNavigationMenuItem>
                    </BzNavigationMenuList>
                </BzNavigationMenu>
            </div>
        </BzDirectionProvider>
    </Demo>

</div>

@code {
    private RenderFragment ListItem(string title, string description) => @<li>
        <BzNavigationMenuLink href="#">
            <div class="text-sm font-medium leading-none">@title</div>
            <p class="text-muted-foreground line-clamp-2 text-sm leading-snug">@description</p>
        </BzNavigationMenuLink>
    </li>;

    private RenderFragment ListItemRtl(string title, string description) => @<li>
        <BzNavigationMenuLink href="#">
            <div class="text-sm font-medium leading-none">@title</div>
            <p class="text-muted-foreground line-clamp-2 text-sm leading-snug">@description</p>
        </BzNavigationMenuLink>
    </li>;

    // --- Two-pane (master / detail) demo state ---
    private string? _twoPaneOpen;       // the open trigger id (bound) - so we can react when the menu closes
    private string _twoPaneActive = "developers";

    private void OnTwoPaneOpenChanged(string? value)
    {
        _twoPaneOpen = value;
        // Reset the selection to the first audience whenever the menu closes, so a reopen always starts fresh.
        if (string.IsNullOrEmpty(value)) _twoPaneActive = "developers";
    }

    private sealed record TwoPaneCat(string Key, string Title, string Subtitle, string Lead, (string Title, string Desc)[] Links);

    private static readonly TwoPaneCat[] TwoPane =
    [
        new("developers", "Developers", "Go from idea to UI faster.", "Build product UI without giving up control.",
            [("Quick start", "Get your first component on screen fast."), ("Composition", "Combine parts to match your structure.")]),
        new("design", "Design Systems", "Keep patterns aligned across teams.", "One source of truth for every surface.",
            [("Tokens", "Theme color, spacing and radius in one place."), ("Primitives", "Accessible building blocks to brand.")]),
        new("leads", "Engineering Leads", "Roll out shared UI without drag.", "Ship a consistent toolkit org-wide.",
            [("Adoption", "Drop into existing apps incrementally."), ("Governance", "Review and version changes safely.")]),
        new("startups", "Startups", "Ship polished basics while things change.", "Move fast without rebuilding the basics.",
            [("Templates", "Start from ready-made layouts."), ("Scale", "Swap skins as the brand matures.")]),
    ];

    private TwoPaneCat ActiveTwoPane => TwoPane.FirstOrDefault(c => c.Key == _twoPaneActive) ?? TwoPane[0];

    // Arrow keys move the selection along the left list (wrapping); the highlight + detail follow it.
    private void OnTwoPaneKey(KeyboardEventArgs e)
    {
        var i = Array.FindIndex(TwoPane, c => c.Key == _twoPaneActive);
        if (i < 0) i = 0;
        i = e.Key switch
        {
            "ArrowDown" or "ArrowRight" => (i + 1) % TwoPane.Length,
            "ArrowUp" or "ArrowLeft" => (i - 1 + TwoPane.Length) % TwoPane.Length,
            "Home" => 0,
            "End" => TwoPane.Length - 1,
            _ => -1,
        };
        if (i >= 0) _twoPaneActive = TwoPane[i].Key;
    }

    private static string TwoPaneTabClass(bool active)
    {
        const string baseCls = "block w-full cursor-pointer rounded-md p-3 text-start transition-colors " +
            "hover:bg-accent hover:text-accent-foreground";
        return active ? baseCls + " bg-accent text-accent-foreground" : baseCls;
    }

    private static readonly CompositionNode _anatomy = new CompositionNode("BzNavigationMenu",
        new CompositionNode("BzNavigationMenuList",
            new CompositionNode("BzNavigationMenuItem",
                new CompositionNode("BzNavigationMenuTrigger"),
                new CompositionNode("BzNavigationMenuContent",
                    new CompositionNode("BzNavigationMenuLink"))),
            new CompositionNode("BzNavigationMenuItem",
                new CompositionNode("BzNavigationMenuLink")),
            new CompositionNode("BzNavigationMenuArrow")));

