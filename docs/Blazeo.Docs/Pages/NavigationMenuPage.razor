@page "/components/navigation-menu"
<PageTitle>Navigation Menu - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Navigation Menu</h1>
        <p class="text-muted-foreground">A horizontal site-navigation bar whose items can open rich dropdown panels. Hovering (or clicking) a trigger opens its content in a shared viewport that morphs to fit; plain items are just links. Keyboard and screen-reader friendly.</p>
    </header>

    <UsageBlock Setup="@UsageSetup" Code="@UsageMarkup"
                Description="Put items in a BzNavigationMenuList. An item with a dropdown pairs a BzNavigationMenuTrigger with a BzNavigationMenuContent; a plain item holds a single BzNavigationMenuLink." />

    <CompositionTree Root="_anatomy"
                     Description="A list of items. A dropdown item is a trigger plus content; a link item is a single link." />

    <ExamplesHeading />

    <Demo Title="Default" Description="Hover a trigger to open its panel in the shared viewport (it morphs between sizes); the last item is a plain link. Click a trigger to toggle it." Code="@DefaultCode">
        <div class="flex min-h-[320px] justify-center">
            <BzNavigationMenu>
                <BzNavigationMenuList>
                    <BzNavigationMenuItem>
                        <BzNavigationMenuTrigger>Getting started</BzNavigationMenuTrigger>
                        <BzNavigationMenuContent>
                            <ul class="grid gap-2 md:w-[420px] lg:w-[520px] lg:grid-cols-[.75fr_1fr]">
                                <li class="row-span-3">
                                    <BzNavigationMenuLink Class="from-muted/50 to-muted flex h-full w-full flex-col justify-end rounded-md bg-gradient-to-b p-6 no-underline select-none">
                                        <div class="mt-4 mb-2 text-lg font-medium">Blazeo UI</div>
                                        <p class="text-muted-foreground text-sm leading-tight">Beautifully designed components built for Blazor.</p>
                                    </BzNavigationMenuLink>
                                </li>
                                @ListItem("Introduction", "Re-usable components built with Blazor and Tailwind.")
                                @ListItem("Installation", "How to install dependencies and structure your app.")
                                @ListItem("Typography", "Styles for headings, paragraphs, lists, and more.")
                            </ul>
                        </BzNavigationMenuContent>
                    </BzNavigationMenuItem>
                    <BzNavigationMenuItem>
                        <BzNavigationMenuTrigger>Components</BzNavigationMenuTrigger>
                        <BzNavigationMenuContent>
                            <ul class="grid gap-2 sm:w-[400px] md:w-[500px] md:grid-cols-2 lg:w-[600px]">
                                @ListItem("Alert Dialog", "A modal dialog that interrupts the user with important content and expects a response.")
                                @ListItem("Hover Card", "For sighted users to preview content available behind a link.")
                                @ListItem("Progress", "Displays an indicator showing the completion progress of a task, typically a progress bar.")
                                @ListItem("Scroll Area", "Augments native scroll with a custom, cross-browser styled scrollbar.")
                                @ListItem("Tabs", "A set of layered sections of content displayed one panel at a time.")
                                @ListItem("Tooltip", "A popup that displays information related to an element on hover or focus.")
                            </ul>
                        </BzNavigationMenuContent>
                    </BzNavigationMenuItem>
                    <BzNavigationMenuItem>
                        <BzNavigationMenuLink Class="@NavigationMenuTriggerStyle.Classes" href="#">Docs</BzNavigationMenuLink>
                    </BzNavigationMenuItem>
                    <BzNavigationMenuItem>
                        <BzNavigationMenuTrigger>List</BzNavigationMenuTrigger>
                        <BzNavigationMenuContent>
                            <ul class="grid w-[300px] gap-2">
                                @ListItem("Components", "Browse all components in the library.")
                                @ListItem("Documentation", "Learn how to use the library.")
                                @ListItem("Blog", "Read our latest posts and release notes.")
                            </ul>
                        </BzNavigationMenuContent>
                    </BzNavigationMenuItem>
                </BzNavigationMenuList>
            </BzNavigationMenu>
        </div>
    </Demo>

    <Demo Title="Without the viewport" Description="With Viewport=false each panel drops as a bordered dropdown directly under its own item, instead of into a shared morphing viewport." Code="@InlineCode">
        <div class="flex min-h-[280px] justify-center">
            <BzNavigationMenu Viewport="false">
                <BzNavigationMenuList>
                    <BzNavigationMenuItem>
                        <BzNavigationMenuTrigger>Overview</BzNavigationMenuTrigger>
                        <BzNavigationMenuContent>
                            <ul class="grid w-[300px] gap-2">
                                @ListItem("Dashboard", "Your activity at a glance.")
                                @ListItem("Settings", "Manage your account and preferences.")
                            </ul>
                        </BzNavigationMenuContent>
                    </BzNavigationMenuItem>
                    <BzNavigationMenuItem>
                        <BzNavigationMenuTrigger>Resources</BzNavigationMenuTrigger>
                        <BzNavigationMenuContent>
                            <ul class="grid w-[300px] gap-2">
                                @ListItem("Guides", "Step-by-step walkthroughs.")
                                @ListItem("Blog", "The latest news and releases.")
                            </ul>
                        </BzNavigationMenuContent>
                    </BzNavigationMenuItem>
                </BzNavigationMenuList>
            </BzNavigationMenu>
        </div>
    </Demo>

    <Demo Title="With an arrow" Description="Add a BzNavigationMenuArrow as the last item to show a little tail that slides under the open trigger - drawn like the Popover and Tooltip arrows." Code="@ArrowCode">
        <div class="flex min-h-[260px] justify-center">
            <BzNavigationMenu>
                <BzNavigationMenuList>
                    <BzNavigationMenuItem>
                        <BzNavigationMenuTrigger>Product</BzNavigationMenuTrigger>
                        <BzNavigationMenuContent>
                            <ul class="grid w-[320px] gap-2">
                                @ListItem("Features", "Everything you can build.")
                                @ListItem("Pricing", "Plans for every team.")
                            </ul>
                        </BzNavigationMenuContent>
                    </BzNavigationMenuItem>
                    <BzNavigationMenuItem>
                        <BzNavigationMenuTrigger>Company</BzNavigationMenuTrigger>
                        <BzNavigationMenuContent>
                            <ul class="grid w-[320px] gap-2">
                                @ListItem("About", "Who we are.")
                                @ListItem("Careers", "Join the team.")
                            </ul>
                        </BzNavigationMenuContent>
                    </BzNavigationMenuItem>
                    <BzNavigationMenuArrow />
                </BzNavigationMenuList>
            </BzNavigationMenu>
        </div>
    </Demo>

    <Demo Title="RTL" Description="Under a right-to-left DirectionProvider the bar, the chevron offset, the panels and the arrow all mirror; the same rich content as the Default example, in Arabic." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <div class="flex min-h-[320px] justify-center">
                <BzNavigationMenu>
                    <BzNavigationMenuList>
                        <BzNavigationMenuItem>
                            <BzNavigationMenuTrigger>البدء</BzNavigationMenuTrigger>
                            <BzNavigationMenuContent>
                                <ul class="grid gap-2 md:w-[420px] lg:w-[520px] lg:grid-cols-[.75fr_1fr]">
                                    <li class="row-span-3">
                                        <BzNavigationMenuLink Class="from-muted/50 to-muted flex h-full w-full flex-col justify-end rounded-md bg-gradient-to-b p-6 no-underline select-none">
                                            <div class="mt-4 mb-2 text-lg font-medium">بليزو</div>
                                            <p class="text-muted-foreground text-sm leading-tight">مكوّنات مصمّمة بعناية لتطبيقات Blazor.</p>
                                        </BzNavigationMenuLink>
                                    </li>
                                    @ListItemRtl("مقدمة", "مكوّنات قابلة لإعادة الاستخدام مبنية بـ Blazor وTailwind.")
                                    @ListItemRtl("التثبيت", "كيفية تثبيت التبعيات وهيكلة تطبيقك.")
                                    @ListItemRtl("الطباعة", "أنماط للعناوين والفقرات والقوائم.")
                                </ul>
                            </BzNavigationMenuContent>
                        </BzNavigationMenuItem>
                        <BzNavigationMenuItem>
                            <BzNavigationMenuTrigger>المكوّنات</BzNavigationMenuTrigger>
                            <BzNavigationMenuContent>
                                <ul class="grid gap-2 sm:w-[400px] md:w-[500px] md:grid-cols-2">
                                    @ListItemRtl("نافذة تنبيه", "نافذة حوارية تقاطع المستخدم بمحتوى مهم وتنتظر رده.")
                                    @ListItemRtl("بطاقة تمرير", "لمعاينة المحتوى المتاح خلف الرابط.")
                                    @ListItemRtl("شريط التقدّم", "يعرض مؤشرًا لمدى اكتمال مهمة ما.")
                                    @ListItemRtl("علامات تبويب", "أقسام محتوى متراكبة تُعرض واحدة في كل مرة.")
                                </ul>
                            </BzNavigationMenuContent>
                        </BzNavigationMenuItem>
                        <BzNavigationMenuItem>
                            <BzNavigationMenuLink Class="@NavigationMenuTriggerStyle.Classes" href="#">الوثائق</BzNavigationMenuLink>
                        </BzNavigationMenuItem>
                    </BzNavigationMenuList>
                </BzNavigationMenu>
            </div>
        </BzDirectionProvider>
    </Demo>

    <ApiReference Types="ApiFamilies.NavigationMenu" />
</div>

@code {
    private RenderFragment ListItem(string title, string description) => @<li>
        <BzNavigationMenuLink href="#">
            <div class="text-sm font-medium leading-none">@title</div>
            <p class="text-muted-foreground line-clamp-2 text-sm leading-snug">@description</p>
        </BzNavigationMenuLink>
    </li>;

    private RenderFragment ListItemRtl(string title, string description) => @<li>
        <BzNavigationMenuLink href="#">
            <div class="text-sm font-medium leading-none">@title</div>
            <p class="text-muted-foreground line-clamp-2 text-sm leading-snug">@description</p>
        </BzNavigationMenuLink>
    </li>;

    private static readonly CompositionNode _anatomy = new CompositionNode("BzNavigationMenu",
        new CompositionNode("BzNavigationMenuList",
            new CompositionNode("BzNavigationMenuItem",
                new CompositionNode("BzNavigationMenuTrigger"),
                new CompositionNode("BzNavigationMenuContent",
                    new CompositionNode("BzNavigationMenuLink"))),
            new CompositionNode("BzNavigationMenuItem",
                new CompositionNode("BzNavigationMenuLink")),
            new CompositionNode("BzNavigationMenuArrow")));

    private const string UsageSetup = """
        @* _Imports.razor (or the top of the page) *@
        @using Blazeo.Ui
        """;

    private const string UsageMarkup = """
        <BzNavigationMenu>
            <BzNavigationMenuList>
                <BzNavigationMenuItem>
                    <BzNavigationMenuTrigger>Getting started</BzNavigationMenuTrigger>
                    <BzNavigationMenuContent>
                        <ul class="grid w-[400px] gap-2 md:grid-cols-2">
                            <li>
                                <BzNavigationMenuLink href="/docs">
                                    <div class="text-sm font-medium leading-none">Introduction</div>
                                    <p class="text-muted-foreground text-sm leading-snug">Re-usable components for Blazor.</p>
                                </BzNavigationMenuLink>
                            </li>
                        </ul>
                    </BzNavigationMenuContent>
                </BzNavigationMenuItem>
                <BzNavigationMenuItem>
                    <BzNavigationMenuLink Class="@NavigationMenuTriggerStyle.Classes" href="/docs">Docs</BzNavigationMenuLink>
                </BzNavigationMenuItem>
            </BzNavigationMenuList>
        </BzNavigationMenu>
        """;

    private const string DefaultCode = """
        <BzNavigationMenu>
            <BzNavigationMenuList>
                <BzNavigationMenuItem>
                    <BzNavigationMenuTrigger>Getting started</BzNavigationMenuTrigger>
                    <BzNavigationMenuContent>
                        <ul class="grid gap-2 md:w-[420px] lg:w-[520px] lg:grid-cols-[.75fr_1fr]">
                            <li class="row-span-3">
                                <BzNavigationMenuLink Class="from-muted/50 to-muted flex h-full w-full flex-col justify-end rounded-md bg-gradient-to-b p-6 no-underline">
                                    <div class="mt-4 mb-2 text-lg font-medium">Blazeo UI</div>
                                    <p class="text-muted-foreground text-sm leading-tight">Beautifully designed components.</p>
                                </BzNavigationMenuLink>
                            </li>
                            <li>
                                <BzNavigationMenuLink href="/docs">
                                    <div class="text-sm font-medium leading-none">Introduction</div>
                                    <p class="text-muted-foreground text-sm leading-snug">Re-usable components for Blazor.</p>
                                </BzNavigationMenuLink>
                            </li>
                        </ul>
                    </BzNavigationMenuContent>
                </BzNavigationMenuItem>
                <BzNavigationMenuItem>
                    <BzNavigationMenuLink Class="@NavigationMenuTriggerStyle.Classes" href="/docs">Docs</BzNavigationMenuLink>
                </BzNavigationMenuItem>
            </BzNavigationMenuList>
        </BzNavigationMenu>
        """;

    private const string InlineCode = """
        @* Viewport=false: each panel drops under its own item instead of a shared viewport. *@
        <BzNavigationMenu Viewport="false">
            <BzNavigationMenuList>
                <BzNavigationMenuItem>
                    <BzNavigationMenuTrigger>Overview</BzNavigationMenuTrigger>
                    <BzNavigationMenuContent>
                        <ul class="grid w-[300px] gap-2">
                            <li>
                                <BzNavigationMenuLink href="#">
                                    <div class="text-sm font-medium leading-none">Dashboard</div>
                                    <p class="text-muted-foreground text-sm leading-snug">Your activity at a glance.</p>
                                </BzNavigationMenuLink>
                            </li>
                        </ul>
                    </BzNavigationMenuContent>
                </BzNavigationMenuItem>
            </BzNavigationMenuList>
        </BzNavigationMenu>
        """;

    private const string ArrowCode = """
        <BzNavigationMenu>
            <BzNavigationMenuList>
                <BzNavigationMenuItem>
                    <BzNavigationMenuTrigger>Product</BzNavigationMenuTrigger>
                    <BzNavigationMenuContent>@* … *@</BzNavigationMenuContent>
                </BzNavigationMenuItem>
                <BzNavigationMenuItem>
                    <BzNavigationMenuTrigger>Company</BzNavigationMenuTrigger>
                    <BzNavigationMenuContent>@* … *@</BzNavigationMenuContent>
                </BzNavigationMenuItem>
                <BzNavigationMenuArrow />
            </BzNavigationMenuList>
        </BzNavigationMenu>
        """;

    private const string RtlCode = """
        @* Same rich content as the Default example, under an RTL DirectionProvider. *@
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzNavigationMenu>
                <BzNavigationMenuList>
                    <BzNavigationMenuItem>
                        <BzNavigationMenuTrigger>البدء</BzNavigationMenuTrigger>
                        <BzNavigationMenuContent>
                            <ul class="grid gap-2 md:w-[420px] lg:w-[520px] lg:grid-cols-[.75fr_1fr]">
                                <li class="row-span-3">
                                    <BzNavigationMenuLink Class="from-muted/50 to-muted flex h-full w-full flex-col justify-end rounded-md bg-gradient-to-b p-6">
                                        <div class="mt-4 mb-2 text-lg font-medium">بليزو</div>
                                        <p class="text-muted-foreground text-sm leading-tight">مكوّنات مصمّمة بعناية لتطبيقات Blazor.</p>
                                    </BzNavigationMenuLink>
                                </li>
                                @* … مقدمة / التثبيت / الطباعة *@
                            </ul>
                        </BzNavigationMenuContent>
                    </BzNavigationMenuItem>
                    <BzNavigationMenuItem>
                        <BzNavigationMenuTrigger>المكوّنات</BzNavigationMenuTrigger>
                        <BzNavigationMenuContent>@* … *@</BzNavigationMenuContent>
                    </BzNavigationMenuItem>
                    <BzNavigationMenuItem>
                        <BzNavigationMenuLink Class="@NavigationMenuTriggerStyle.Classes" href="#">الوثائق</BzNavigationMenuLink>
                    </BzNavigationMenuItem>
                </BzNavigationMenuList>
            </BzNavigationMenu>
        </BzDirectionProvider>
        """;
}
