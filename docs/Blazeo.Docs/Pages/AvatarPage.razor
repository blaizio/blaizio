@page "/components/avatar"
<PageTitle>Avatar — Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Avatar</h1>
        <p class="text-muted-foreground">An image element with a graceful fallback while it loads or if it fails.</p>
    </header>

    <Demo Title="Default" Code="@DefaultCode">
        <Avatar>
            <AvatarImage Src="https://i.pravatar.cc/120?img=12" Alt="User" />
            <AvatarFallback>CN</AvatarFallback>
        </Avatar>
    </Demo>

    <Demo Title="Fallback" Description="When the image is missing or fails to load, the fallback shows." Code="@FallbackCode">
        <Avatar>
            <AvatarImage Src="https://example.invalid/missing.png" Alt="Broken" />
            <AvatarFallback>AB</AvatarFallback>
        </Avatar>
    </Demo>

    <Demo Title="Sizes" Description="Use the Size prop — the style sheet scales it via data-size." Code="@SizesCode">
        <div class="flex items-center gap-4">
            <Avatar Size="AvatarSize.Sm">
                <AvatarImage Src="https://i.pravatar.cc/120?img=5" Alt="User" />
                <AvatarFallback>SM</AvatarFallback>
            </Avatar>
            <Avatar>
                <AvatarImage Src="https://i.pravatar.cc/120?img=8" Alt="User" />
                <AvatarFallback>MD</AvatarFallback>
            </Avatar>
            <Avatar Size="AvatarSize.Lg">
                <AvatarImage Src="https://i.pravatar.cc/120?img=15" Alt="User" />
                <AvatarFallback>LG</AvatarFallback>
            </Avatar>
        </div>
    </Demo>

    <Demo Title="Badge" Description="A status dot pinned to the corner, scaling with the avatar." Code="@BadgeCode">
        <div class="flex items-center gap-4">
            <Avatar Size="AvatarSize.Lg">
                <AvatarImage Src="https://i.pravatar.cc/120?img=12" Alt="User" />
                <AvatarFallback>CN</AvatarFallback>
                <AvatarBadge Class="bg-emerald-500" />
            </Avatar>
            <Avatar>
                <AvatarImage Src="https://i.pravatar.cc/120?img=8" Alt="User" />
                <AvatarFallback>MD</AvatarFallback>
                <AvatarBadge />
            </Avatar>
        </div>
    </Demo>

    <Demo Title="Group" Description="AvatarGroup overlaps avatars; AvatarGroupCount shows the overflow." Code="@GroupCode">
        <AvatarGroup>
            <Avatar>
                <AvatarImage Src="https://i.pravatar.cc/120?img=1" Alt="User" />
                <AvatarFallback>A</AvatarFallback>
            </Avatar>
            <Avatar>
                <AvatarImage Src="https://i.pravatar.cc/120?img=2" Alt="User" />
                <AvatarFallback>B</AvatarFallback>
            </Avatar>
            <Avatar>
                <AvatarImage Src="https://i.pravatar.cc/120?img=3" Alt="User" />
                <AvatarFallback>C</AvatarFallback>
            </Avatar>
            <AvatarGroupCount Class="size-8 rounded-full bg-muted text-xs">+3</AvatarGroupCount>
        </AvatarGroup>
    </Demo>
</div>

@code {
    private const string DefaultCode = """
        <Avatar>
            <AvatarImage Src="https://i.pravatar.cc/120?img=12" Alt="User" />
            <AvatarFallback>CN</AvatarFallback>
        </Avatar>
        """;

    private const string FallbackCode = """
        <Avatar>
            <AvatarImage Src="https://example.invalid/missing.png" Alt="Broken" />
            <AvatarFallback>AB</AvatarFallback>
        </Avatar>
        """;

    private const string SizesCode = """
        <Avatar Size="AvatarSize.Sm">…</Avatar>
        <Avatar>…</Avatar>
        <Avatar Size="AvatarSize.Lg">…</Avatar>
        """;

    private const string BadgeCode = """
        <Avatar Size="AvatarSize.Lg">
            <AvatarImage Src="..." Alt="User" />
            <AvatarFallback>CN</AvatarFallback>
            <AvatarBadge Class="bg-emerald-500" />
        </Avatar>
        """;

    private const string GroupCode = """
        <AvatarGroup>
            <Avatar>
                <AvatarImage Src="..." Alt="User" />
                <AvatarFallback>A</AvatarFallback>
            </Avatar>
            <!-- more avatars -->
            <AvatarGroupCount Class="size-8 rounded-full bg-muted text-xs">+3</AvatarGroupCount>
        </AvatarGroup>
        """;
}
