@page "/components/carousel"
<PageTitle>Carousel - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Carousel</h1>
        <p class="text-muted-foreground">A slideshow of panels the user can page through - drag, swipe, click the arrows or dots, or use the arrow keys. Slides snap into place; show one or several at a time, horizontally or vertically, with optional looping and autoplay.</p>
    </header>

    <UsageBlock Setup="@UsageSetup" Code="@UsageMarkup"
                Description="Put BzCarouselItem slides inside a BzCarouselContent, then add BzCarouselPrevious / BzCarouselNext (and optionally BzCarouselDots) as siblings inside the BzCarousel. The arrows and dots sit just outside the slides, so leave a little room around the carousel." />

    <CompositionTree Root="_anatomy"
                     Description="The content holds the slides; the controls and dots are siblings pinned to the carousel's edges and driven by the same engine." />

    <ExamplesHeading />

    <Demo Title="Default" Description="One slide at a time with arrows and position dots. Drag with the mouse, focus a control and use the arrow keys, or click a dot." Code="@DefaultCode">
        <div class="mx-auto w-full max-w-xs">
            <BzCarousel>
                <BzCarouselContent>
                    @for (var i = 1; i <= 5; i++)
                    {
                        <BzCarouselItem>@Slide(i)</BzCarouselItem>
                    }
                </BzCarouselContent>
                <BzCarouselPrevious />
                <BzCarouselNext />
                <BzCarouselDots />
            </BzCarousel>
        </div>
    </Demo>

    <Demo Title="Multiple slides" Description="Override a slide's basis to show several at once - here half a slide on small screens and a third on larger ones." Code="@MultipleCode">
        <div class="mx-auto w-full max-w-2xl">
            <BzCarousel>
                <BzCarouselContent>
                    @for (var i = 1; i <= 8; i++)
                    {
                        <BzCarouselItem Class="basis-1/2 md:basis-1/3">@Slide(i)</BzCarouselItem>
                    }
                </BzCarouselContent>
                <BzCarouselPrevious />
                <BzCarouselNext />
            </BzCarousel>
        </div>
    </Demo>

    <Demo Title="Vertical" Description="Set Orientation=Vertical to page up and down. The content needs a height." Code="@VerticalCode">
        <div class="mx-auto w-full max-w-xs py-2">
            <BzCarousel Orientation="CarouselOrientation.Vertical">
                <BzCarouselContent Class="h-[300px]">
                    @for (var i = 1; i <= 5; i++)
                    {
                        <BzCarouselItem Class="basis-1/2">@Slide(i)</BzCarouselItem>
                    }
                </BzCarouselContent>
                <BzCarouselPrevious />
                <BzCarouselNext />
            </BzCarousel>
        </div>
    </Demo>

    <Demo Title="Loop" Description="With Loop the arrows never disable - paging past either end wraps around." Code="@LoopCode">
        <div class="mx-auto w-full max-w-xs">
            <BzCarousel Loop="true">
                <BzCarouselContent>
                    @for (var i = 1; i <= 5; i++)
                    {
                        <BzCarouselItem>@Slide(i)</BzCarouselItem>
                    }
                </BzCarouselContent>
                <BzCarouselPrevious />
                <BzCarouselNext />
                <BzCarouselDots />
            </BzCarousel>
        </div>
    </Demo>

    <Demo Title="Autoplay" Description="Set AutoplayInterval (ms) to advance on a timer; it pauses while the pointer is over the carousel or a control is focused." Code="@AutoplayCode">
        <div class="mx-auto w-full max-w-xs">
            <BzCarousel Loop="true" AutoplayInterval="3000">
                <BzCarouselContent>
                    @for (var i = 1; i <= 5; i++)
                    {
                        <BzCarouselItem>@Slide(i)</BzCarouselItem>
                    }
                </BzCarouselContent>
                <BzCarouselDots />
            </BzCarousel>
        </div>
    </Demo>

    <Demo Title="Tracking the selected slide" Description="Handle OnSelectedIndexChanged to react as the slide changes - to sync a caption, fetch data, etc." Code="@TrackingCode">
        <div class="w-full space-y-3">
            <div class="mx-auto w-full max-w-xs">
                <BzCarousel OnSelectedIndexChanged="OnSlideChanged">
                    <BzCarouselContent>
                        @for (var i = 1; i <= 5; i++)
                        {
                            <BzCarouselItem>@Slide(i)</BzCarouselItem>
                        }
                    </BzCarouselContent>
                    <BzCarouselPrevious />
                    <BzCarouselNext />
                </BzCarousel>
            </div>
            <p class="text-muted-foreground text-center text-sm">Slide <span class="text-foreground font-mono">@(_selected + 1)</span> of 5</p>
        </div>
    </Demo>

    <Demo Title="Customization" Description="Restyle the controls and dots with Class - here solid arrows tucked inside the slides and wider dots. Anything you put inside a control replaces its icon." Code="@CustomCode">
        <div class="mx-auto w-full max-w-xs">
            <BzCarousel Loop="true">
                <BzCarouselContent>
                    @for (var i = 1; i <= 5; i++)
                    {
                        <BzCarouselItem>@Slide(i)</BzCarouselItem>
                    }
                </BzCarouselContent>
                <BzCarouselPrevious Class="start-2 size-9 border-0 bg-primary text-primary-foreground hover:bg-primary/90" />
                <BzCarouselNext Class="end-2 size-9 border-0 bg-primary text-primary-foreground hover:bg-primary/90" />
                <BzCarouselDots Class="gap-3 [&_button]:h-1.5 [&_button]:w-6 [&_button]:rounded-full" />
            </BzCarousel>
        </div>
    </Demo>

    <Demo Title="RTL" Description="Under a right-to-left DirectionProvider the slides, arrows and drag direction mirror automatically." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <div class="mx-auto w-full max-w-xs">
                <BzCarousel>
                    <BzCarouselContent>
                        @for (var i = 1; i <= 5; i++)
                        {
                            <BzCarouselItem>@Slide(i)</BzCarouselItem>
                        }
                    </BzCarouselContent>
                    <BzCarouselPrevious />
                    <BzCarouselNext />
                    <BzCarouselDots />
                </BzCarousel>
            </div>
        </BzDirectionProvider>
    </Demo>

    <ApiReference Types="ApiFamilies.Carousel" />
</div>

@code {
    private int _selected;

    private void OnSlideChanged(int index) => _selected = index;

    // A simple numbered slide used across the demos.
    private RenderFragment Slide(int n) =>
        @<div class="flex aspect-square items-center justify-center rounded-xl border bg-muted">
            <span class="text-4xl font-semibold">@n</span>
        </div>;

    private static readonly CompositionNode _anatomy = new CompositionNode("BzCarousel",
        new CompositionNode("BzCarouselContent",
            new CompositionNode("BzCarouselItem")),
        new CompositionNode("BzCarouselPrevious"),
        new CompositionNode("BzCarouselNext"),
        new CompositionNode("BzCarouselDots"));

    private const string UsageSetup = """
        @* _Imports.razor (or the top of the page) *@
        @using Blazeo.Ui
        """;

    private const string UsageMarkup = """
        <div class="mx-auto w-full max-w-xs">
            <BzCarousel>
                <BzCarouselContent>
                    <BzCarouselItem>
                        <div class="flex aspect-square items-center justify-center rounded-xl border bg-muted">1</div>
                    </BzCarouselItem>
                    <BzCarouselItem>
                        <div class="flex aspect-square items-center justify-center rounded-xl border bg-muted">2</div>
                    </BzCarouselItem>
                </BzCarouselContent>
                <BzCarouselPrevious />
                <BzCarouselNext />
                <BzCarouselDots />
            </BzCarousel>
        </div>
        """;

    private const string DefaultCode = """
        <div class="mx-auto w-full max-w-xs">
            <BzCarousel>
                <BzCarouselContent>
                    @for (var i = 1; i <= 5; i++)
                    {
                        <BzCarouselItem>
                            <div class="flex aspect-square items-center justify-center rounded-xl border bg-muted">
                                <span class="text-4xl font-semibold">@i</span>
                            </div>
                        </BzCarouselItem>
                    }
                </BzCarouselContent>
                <BzCarouselPrevious />
                <BzCarouselNext />
                <BzCarouselDots />
            </BzCarousel>
        </div>
        """;

    private const string MultipleCode = """
        <div class="mx-auto w-full max-w-2xl">
            <BzCarousel>
                <BzCarouselContent>
                    @for (var i = 1; i <= 8; i++)
                    {
                        <BzCarouselItem Class="basis-1/2 md:basis-1/3">
                            <div class="flex aspect-square items-center justify-center rounded-xl border bg-muted">
                                <span class="text-4xl font-semibold">@i</span>
                            </div>
                        </BzCarouselItem>
                    }
                </BzCarouselContent>
                <BzCarouselPrevious />
                <BzCarouselNext />
            </BzCarousel>
        </div>
        """;

    private const string VerticalCode = """
        <div class="mx-auto w-full max-w-xs">
            <BzCarousel Orientation="CarouselOrientation.Vertical">
                <BzCarouselContent Class="h-[300px]">
                    @for (var i = 1; i <= 5; i++)
                    {
                        <BzCarouselItem Class="basis-1/2">
                            <div class="flex aspect-square items-center justify-center rounded-xl border bg-muted">
                                <span class="text-4xl font-semibold">@i</span>
                            </div>
                        </BzCarouselItem>
                    }
                </BzCarouselContent>
                <BzCarouselPrevious />
                <BzCarouselNext />
            </BzCarousel>
        </div>
        """;

    private const string LoopCode = """
        <BzCarousel Loop="true">
            <BzCarouselContent>
                @* slides *@
            </BzCarouselContent>
            <BzCarouselPrevious />
            <BzCarouselNext />
            <BzCarouselDots />
        </BzCarousel>
        """;

    private const string AutoplayCode = """
        <BzCarousel Loop="true" AutoplayInterval="3000">
            <BzCarouselContent>
                @* slides *@
            </BzCarouselContent>
            <BzCarouselDots />
        </BzCarousel>
        """;

    private const string TrackingCode = """
        <BzCarousel OnSelectedIndexChanged="OnSlideChanged">
            <BzCarouselContent>
                @* slides *@
            </BzCarouselContent>
            <BzCarouselPrevious />
            <BzCarouselNext />
        </BzCarousel>
        <p>Slide @(_selected + 1) of 5</p>

        @code {
            private int _selected;
            private void OnSlideChanged(int index) => _selected = index;
        }
        """;

    private const string CustomCode = """
        <BzCarousel Loop="true">
            <BzCarouselContent>
                @* slides *@
            </BzCarouselContent>
            @* Tuck solid arrows just inside the slides... *@
            <BzCarouselPrevious Class="start-2 size-9 border-0 bg-primary text-primary-foreground hover:bg-primary/90" />
            <BzCarouselNext Class="end-2 size-9 border-0 bg-primary text-primary-foreground hover:bg-primary/90" />
            @* ...and stretch the dots into pills. *@
            <BzCarouselDots Class="[&_button]:h-1.5 [&_button]:w-6 [&_button]:rounded-full" />
        </BzCarousel>
        """;

    private const string RtlCode = """
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzCarousel>
                <BzCarouselContent>
                    @* slides *@
                </BzCarouselContent>
                <BzCarouselPrevious />
                <BzCarouselNext />
                <BzCarouselDots />
            </BzCarousel>
        </BzDirectionProvider>
        """;
}
