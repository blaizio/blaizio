@page "/components/input"
<PageTitle>Input — Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Input</h1>
        <p class="text-muted-foreground">A text field. <code class="font-mono text-sm">@@bind-Value</code> updates live as you type.</p>
    </header>

    <Demo Title="Default" Code="@DefaultCode">
        <Input placeholder="Email" Type="email" Class="max-w-sm" />
    </Demo>

    <Demo Title="With Field" Description="Field wires the label, description, and ids; the input stays validation-agnostic." Code="@FieldCode">
        <div class="w-full max-w-sm">
            <Field>
                <FieldLabel>Email</FieldLabel>
                <FieldControl Context="ctl">
                    <Input @attributes="ctl" Type="email" placeholder="m@example.com" @bind-Value="_email" />
                </FieldControl>
                <FieldDescription>We'll never share it.</FieldDescription>
            </Field>
        </div>
    </Demo>

    <Demo Title="Invalid" Description="aria-invalid drives the destructive ring — here forced, normally set by FieldControl." Code="@InvalidCode">
        <Input placeholder="Username" aria-invalid="true" Class="max-w-sm" />
    </Demo>

    <Demo Title="Disabled" Code="@DisabledCode">
        <Input placeholder="Disabled" Disabled Class="max-w-sm" />
    </Demo>

    <Demo Title="File" Code="@FileCode">
        <Input Type="file" Class="max-w-sm" />
    </Demo>

    <Demo Title="Live binding" Description="The label mirrors the value on every keystroke." Code="@BindingCode">
        <div class="flex w-full max-w-sm flex-col items-center gap-3">
            <Input placeholder="Type something…" @bind-Value="_live" />
            <p class="text-sm text-muted-foreground">Value: <span class="font-mono">@(_live ?? "—")</span></p>
        </div>
    </Demo>
</div>

@code {
    private string? _email;
    private string? _live;

    private const string DefaultCode = """
        <Input placeholder="Email" Type="email" />
        """;

    private const string FieldCode = """
        <Field>
            <FieldLabel>Email</FieldLabel>
            <FieldControl Context="ctl">
                <Input @attributes="ctl" Type="email" placeholder="m@example.com" @bind-Value="_email" />
            </FieldControl>
            <FieldDescription>We'll never share it.</FieldDescription>
        </Field>
        """;

    private const string InvalidCode = """
        <Input placeholder="Username" aria-invalid="true" />
        """;

    private const string DisabledCode = """
        <Input placeholder="Disabled" Disabled />
        """;

    private const string FileCode = """
        <Input Type="file" />
        """;

    private const string BindingCode = """
        <Input placeholder="Type something…" @bind-Value="_live" />
        <p>Value: @_live</p>

        @code { private string? _live; }
        """;
}
