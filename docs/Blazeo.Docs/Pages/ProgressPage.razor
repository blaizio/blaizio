@page "/components/progress"
@implements IDisposable
<PageTitle>Progress - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Progress</h1>
        <p class="text-muted-foreground">Displays an indicator showing the completion progress of a task.</p>
    </header>

    <Demo Title="Default" Code="@DefaultCode">
        <BzProgress Value="60" Class="max-w-sm" />
    </Demo>

    <Demo Title="Values" Code="@ValuesCode">
        <div class="w-full max-w-sm space-y-4">
            @foreach (var v in new[] { 0, 25, 50, 75, 100 })
            {
                <div class="flex items-center gap-3">
                    <BzProgress Value="@v" />
                    <span class="w-10 text-end text-sm tabular-nums text-muted-foreground">@v%</span>
                </div>
            }
        </div>
    </Demo>

    <Demo Title="Custom max" Description="Value is relative to Max - 7 of 10 here." Code="@MaxCode">
        <BzProgress Value="7" Max="10" Class="max-w-sm" />
    </Demo>

    <Demo Title="Animated" Description="The fill transitions smoothly as Value changes." Code="@AnimatedCode">
        <div class="flex w-full max-w-sm flex-col items-center gap-4">
            <BzProgress Value="@_animated" />
            <BzButton Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" @onclick="RunAsync" disabled="@_running">
                @(_running ? "Running…" : "Run")
            </BzButton>
        </div>
    </Demo>

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the bar fills from the right and the value column mirrors to the left." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <div class="w-full max-w-sm space-y-4">
                @foreach (var v in new[] { 0, 25, 50, 75, 100 })
                {
                    <div class="flex items-center gap-3">
                        <BzProgress Value="@v" />
                        <span class="w-10 text-end text-sm tabular-nums text-muted-foreground">@v%</span>
                    </div>
                }
            </div>
        </BzDirectionProvider>
    </Demo>
    <ApiReference Types="ApiFamilies.Progress" />
</div>

@code {
    private double _animated;
    private bool _running;
    private bool _disposed;

    private async Task RunAsync()
    {
        if (_running) return;
        _running = true;
        for (var v = 0; v <= 100; v += 5)
        {
            if (_disposed) return;
            _animated = v;
            StateHasChanged();
            await Task.Delay(120);
        }
        _running = false;
    }

    public void Dispose() => _disposed = true;

    private const string DefaultCode = """
        <BzProgress Value="60" />
        """;

    private const string ValuesCode = """
        <BzProgress Value="0" />
        <BzProgress Value="50" />
        <BzProgress Value="100" />
        """;

    private const string MaxCode = """
        <BzProgress Value="7" Max="10" />
        """;

    private const string AnimatedCode = """
        <BzProgress Value="@_animated" />

        @code {
            private double _animated;

            private async Task RunAsync()
            {
                for (var v = 0; v <= 100; v += 5)
                {
                    _animated = v;
                    StateHasChanged();
                    await Task.Delay(120);
                }
            }
        }
        """;

    private const string RtlCode = """
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzProgress Value="0" />
            <BzProgress Value="50" />
            <BzProgress Value="100" />
        </BzDirectionProvider>
        """;
}
