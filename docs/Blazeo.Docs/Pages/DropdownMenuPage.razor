    private bool _panel;
    private string _position = "bottom";

    // Selecting a checkbox item closes the menu by default (the Radix behaviour); PreventDefault keeps
    // it open so several can be toggled in one visit.
    private static void KeepOpen(MenuSelectEventArgs e) => e.PreventDefault();

