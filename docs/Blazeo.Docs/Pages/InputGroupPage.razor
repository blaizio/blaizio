@page "/components/input-group"
@using System.ComponentModel.DataAnnotations
<PageTitle>Input Group - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Input Group</h1>
        <p class="text-muted-foreground">Wrap an input or textarea with addons - icons, text, or buttons - inside one bordered, focusable box. Addons sit inline (before or after) or in a full-width block above or below the control. It is the shell the Combobox input is built on.</p>
    </header>

    <UsageBlock Setup="@UsageSetup" Code="@UsageMarkup"
                Description="Add the using once, then wrap a control with addons. An inline-start addon renders before the control regardless of DOM order." />

    <CompositionTree Root="_anatomy"
                     Description="The full anatomy. The group wraps one control plus any number of addons; each addon clusters icons, text, or buttons against one edge." />

    <ExamplesHeading />

    <Demo Title="Icon" Description="A leading icon. An inline-start addon renders before the control regardless of DOM order." Code="@IconCode">
        <BzInputGroup Class="max-w-sm">
            <BzInputGroupInput placeholder="Search..." />
            <BzInputGroupAddon>
                <BzIcon Icon="@Icons.Outline.Search" />
            </BzInputGroupAddon>
        </BzInputGroup>
    </Demo>

    <Demo Title="Text affixes" Description="InputGroupText for a prefix or suffix - a protocol, unit, or domain. The whole box focuses when you click anywhere in it." Code="@TextCode">
        <BzInputGroup Class="max-w-sm">
            <BzInputGroupAddon>
                <BzInputGroupText>https://</BzInputGroupText>
            </BzInputGroupAddon>
            <BzInputGroupInput placeholder="example" />
            <BzInputGroupAddon Align="InputGroupAddonAlign.InlineEnd">
                <BzInputGroupText>.com</BzInputGroupText>
            </BzInputGroupAddon>
        </BzInputGroup>
    </Demo>

    <Demo Title="Button" Description="An InputGroupButton in a trailing addon - sized to sit flush inside the group." Code="@ButtonCode">
        <BzInputGroup Class="max-w-sm">
            <BzInputGroupInput placeholder="Paste a link to copy" />
            <BzInputGroupAddon Align="InputGroupAddonAlign.InlineEnd">
                <BzInputGroupButton Size="InputGroupButtonSize.IconXs" aria-label="Copy">
                    <BzIcon Icon="@Icons.Outline.Copy" />
                </BzInputGroupButton>
            </BzInputGroupAddon>
        </BzInputGroup>
    </Demo>

    <Demo Title="Keyboard shortcut" Description="A Kbd in a trailing addon hints at the shortcut that focuses the field." Code="@KbdCode">
        <BzInputGroup Class="max-w-sm">
            <BzInputGroupAddon>
                <BzIcon Icon="@Icons.Outline.Search" />
            </BzInputGroupAddon>
            <BzInputGroupInput placeholder="Search..." />
            <BzInputGroupAddon Align="InputGroupAddonAlign.InlineEnd">
                <BzKbd>⌘K</BzKbd>
            </BzInputGroupAddon>
        </BzInputGroup>
    </Demo>

    <Demo Title="Dropdown" Description="An InputGroupButton in an addon opens a DropdownMenu - here a country-code picker beside a phone number." Code="@DropdownCode">
        <BzInputGroup Class="max-w-sm">
            <BzInputGroupAddon>
                <BzDropdownMenu>
                    <BzDropdownMenuTrigger>
                        <RenderAs Context="p">
                            <BzInputGroupButton @attributes="p.Attributes" Class="text-muted-foreground tabular-nums">
                                @_countryCode
                                <BzIcon Icon="@Icons.Outline.ChevronDown" />
                            </BzInputGroupButton>
                        </RenderAs>
                    </BzDropdownMenuTrigger>
                    <BzDropdownMenuContent Align="Align.Start" Class="min-w-16">
                        <BzDropdownMenuItem OnSelect='@(() => _countryCode = "+1")'>+1</BzDropdownMenuItem>
                        <BzDropdownMenuItem OnSelect='@(() => _countryCode = "+44")'>+44</BzDropdownMenuItem>
                        <BzDropdownMenuItem OnSelect='@(() => _countryCode = "+46")'>+46</BzDropdownMenuItem>
                    </BzDropdownMenuContent>
                </BzDropdownMenu>
            </BzInputGroupAddon>
            <BzInputGroupInput Type="tel" placeholder="(555) 000-0000" />
        </BzInputGroup>
    </Demo>

    <Demo Title="Spinner" Description="A spinning Loader in an addon marks a busy field - for example while a value is validated." Code="@SpinnerCode">
        <BzInputGroup Class="max-w-sm">
            <BzInputGroupInput placeholder="Username" Value="octocat" />
            <BzInputGroupAddon Align="InputGroupAddonAlign.InlineEnd">
                <BzIcon Icon="@Icons.Outline.Loader2" Class="animate-spin" />
            </BzInputGroupAddon>
        </BzInputGroup>
    </Demo>

    <Demo Title="Custom control" Description="Any control works, not just InputGroupInput - give it the input-group-control data-slot and the group lends it the shared border, focus ring, and invalid state. Here, a native select." Code="@CustomCode">
        <BzInputGroup Class="max-w-sm">
            <BzInputGroupAddon>
                <BzIcon Icon="@Icons.Outline.Globe" />
            </BzInputGroupAddon>
            <select data-slot="input-group-control" class="bz-input-group-input flex-1 bg-transparent text-sm outline-none">
                <option>English</option>
                <option>العربية</option>
                <option>Español</option>
                <option>Français</option>
            </select>
        </BzInputGroup>
    </Demo>

    <Demo Title="Textarea with a toolbar" Description="A block-end addon spans the full width and stacks below the control - a natural spot for a toolbar." Code="@TextareaCode">
        <BzInputGroup Class="max-w-sm">
            <BzInputGroupTextarea placeholder="Write a comment..." />
            <BzInputGroupAddon Align="InputGroupAddonAlign.BlockEnd">
                <BzInputGroupText class="text-xs">Markdown supported</BzInputGroupText>
                <BzInputGroupButton Variant="ButtonVariant.Default" Size="InputGroupButtonSize.Sm" Class="ms-auto">Post</BzInputGroupButton>
            </BzInputGroupAddon>
        </BzInputGroup>
    </Demo>

    <Demo Title="Invalid" Description="aria-invalid on the control turns the whole group destructive - here forced; a Field normally sets it." Code="@InvalidCode">
        <BzInputGroup Class="max-w-sm">
            <BzInputGroupAddon>
                <BzIcon Icon="@Icons.Outline.Mail" />
            </BzInputGroupAddon>
            <BzInputGroupInput placeholder="you@example.com" aria-invalid="true" />
        </BzInputGroup>
    </Demo>

    <Demo Title="Invalid in a form" Description="Inside an EditForm, FieldControl wires aria-invalid from validation. Submit with an empty or malformed email to see the group turn destructive and the error appear." Code="@FormInvalidCode">
        <EditForm Model="@_signup" OnValidSubmit="@(() => _submitted = true)" OnInvalidSubmit="@(() => _submitted = false)" class="w-full max-w-sm">
            <DataAnnotationsValidator />
            <BzFieldGroup>
                <BzField Name="@nameof(SignupModel.Email)">
                    <BzFieldLabel>Email</BzFieldLabel>
                    <BzFieldControl Context="ctl">
                        <BzInputGroup>
                            <BzInputGroupAddon>
                                <BzIcon Icon="@Icons.Outline.Mail" />
                            </BzInputGroupAddon>
                            <BzInputGroupInput @attributes="ctl" Type="email" placeholder="you@example.com" @bind-Value="_signup.Email" />
                        </BzInputGroup>
                    </BzFieldControl>
                    <BzFieldError />
                </BzField>
                <BzField>
                    <BzButton Type="submit">Subscribe</BzButton>
                </BzField>
                @if (_submitted)
                {
                    <p class="text-sm font-medium text-emerald-600">Subscribed 🎉</p>
                }
            </BzFieldGroup>
        </EditForm>
    </Demo>

    <Demo Title="Disabled" Description="Disable the control; it greys out and stops accepting input." Code="@DisabledCode">
        <BzInputGroup Class="max-w-sm">
            <BzInputGroupAddon>
                <BzIcon Icon="@Icons.Outline.Mail" />
            </BzInputGroupAddon>
            <BzInputGroupInput placeholder="you@example.com" Disabled />
        </BzInputGroup>
    </Demo>

    <Demo Title="Customization"
          Description="Restyle the box via Class on the group - here a pill shell with an emerald focus ring and a tinted leading icon. Root utilities win over the skin, so the rounding and ring take effect."
          Code="@CustomizationCode">
        <BzInputGroup Class="max-w-sm rounded-full focus-within:ring-2 focus-within:ring-emerald-500">
            <BzInputGroupAddon Class="text-emerald-600">
                <BzIcon Icon="@Icons.Outline.Search" />
            </BzInputGroupAddon>
            <BzInputGroupInput placeholder="Search..." />
        </BzInputGroup>
    </Demo>

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider - the addons mirror to the right." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzInputGroup Class="max-w-sm">
                <BzInputGroupInput placeholder="بحث..." />
                <BzInputGroupAddon>
                    <BzIcon Icon="@Icons.Outline.Search" />
                </BzInputGroupAddon>
            </BzInputGroup>
        </BzDirectionProvider>
    </Demo>

    <ApiReference Types="ApiFamilies.InputGroup" />
</div>

