@page "/components/checkbox"
<PageTitle>Checkbox - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Checkbox</h1>
        <p class="text-muted-foreground">A box that can be checked, unchecked, or indeterminate.</p>
    </header>

    <UsageBlock Setup="@UsageSetup" Code="@UsageMarkup" Description="Pair with a Label, associated by id." />

    <ExamplesHeading />

    <Demo Title="Default" Description="Pair with a Label, associated by id." Code="@DefaultCode">
        <div class="flex items-center gap-2">
            <BzCheckbox id="terms" />
            <BzLabel For="terms">Accept terms and conditions</BzLabel>
        </div>
    </Demo>

    <Demo Title="States" Description="Unchecked, checked, and indeterminate." Code="@StatesCode">
        <div class="flex items-center gap-6">
            <div class="flex items-center gap-2"><BzCheckbox id="s1" /><BzLabel For="s1">Unchecked</BzLabel></div>
            <div class="flex items-center gap-2"><BzCheckbox id="s2" DefaultChecked="CheckedState.Checked" /><BzLabel For="s2">Checked</BzLabel></div>
            <div class="flex items-center gap-2"><BzCheckbox id="s3" DefaultChecked="CheckedState.Indeterminate" /><BzLabel For="s3">Indeterminate</BzLabel></div>
        </div>
    </Demo>

    <Demo Title="Disabled" Code="@DisabledCode">
        <div class="flex items-center gap-6">
            <div class="flex items-center gap-2"><BzCheckbox id="d1" Disabled /><BzLabel For="d1">Off</BzLabel></div>
            <div class="flex items-center gap-2"><BzCheckbox id="d2" Disabled DefaultChecked="CheckedState.Checked" /><BzLabel For="d2">On</BzLabel></div>
        </div>
    </Demo>

    <Demo Title="Controlled" Description="Bind the tri-state value two-way." Code="@ControlledCode">
        <div class="flex flex-col items-center gap-3">
            <div class="flex items-center gap-2">
                <BzCheckbox id="news" @bind-Checked="_state" />
                <BzLabel For="news">Subscribe to the newsletter</BzLabel>
            </div>
            <div class="flex items-center gap-3">
                <p class="text-sm text-muted-foreground">State: <span class="font-mono">@_state</span></p>
                <BzButton Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" @onclick="@(() => _state = CheckedState.Indeterminate)">
                    Set indeterminate
                </BzButton>
            </div>
        </div>
    </Demo>
    <Demo Title="Customization"
          Description="Recolor the checked state with data-checked: utilities - they win over the variant default."
          Code="@CustomCode">
        <div class="flex items-center gap-4">
            <BzCheckbox DefaultChecked="CheckedState.Checked" Class="rounded-full data-checked:bg-emerald-600 data-checked:border-emerald-600" aria-label="Emerald" />
            <BzCheckbox DefaultChecked="CheckedState.Checked" Class="rounded-full data-checked:bg-indigo-600 data-checked:border-indigo-600" aria-label="Indigo" />
            <BzCheckbox DefaultChecked="CheckedState.Checked" Class="rounded-full data-checked:bg-rose-600 data-checked:border-rose-600" aria-label="Rose" />
        </div>
    </Demo>
    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the box and its label mirror to the right." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <div class="flex items-center gap-2">
                <BzCheckbox id="rtl-terms" />
                <BzLabel For="rtl-terms">أوافق على الشروط والأحكام</BzLabel>
            </div>
        </BzDirectionProvider>
    </Demo>
</div>

@code {
    private CheckedState _state = CheckedState.Unchecked;

    private const string UsageSetup = """
        @* _Imports.razor (or the top of the page) *@
        @using Blazeo.Ui
        """;

    private const string UsageMarkup = """
        <BzCheckbox id="terms" />
        <BzLabel For="terms">Accept terms and conditions</BzLabel>
        """;

    private const string CustomCode = """
        <BzCheckbox DefaultChecked="CheckedState.Checked" Class="rounded-full data-checked:bg-emerald-600 data-checked:border-emerald-600" />
        <BzCheckbox DefaultChecked="CheckedState.Checked" Class="rounded-full data-checked:bg-indigo-600 data-checked:border-indigo-600" />
        <BzCheckbox DefaultChecked="CheckedState.Checked" Class="rounded-full data-checked:bg-rose-600 data-checked:border-rose-600" />
        """;

    private const string DefaultCode = """
        <BzCheckbox id="terms" />
        <BzLabel For="terms">Accept terms and conditions</BzLabel>
        """;

    private const string StatesCode = """
        <BzCheckbox id="s1" /><BzLabel For="s1">Unchecked</BzLabel>
        <BzCheckbox id="s2" DefaultChecked="CheckedState.Checked" /><BzLabel For="s2">Checked</BzLabel>
        <BzCheckbox id="s3" DefaultChecked="CheckedState.Indeterminate" /><BzLabel For="s3">Indeterminate</BzLabel>
        """;

    private const string DisabledCode = """
        <BzCheckbox id="d1" Disabled /><BzLabel For="d1">Off</BzLabel>
        <BzCheckbox id="d2" Disabled DefaultChecked="CheckedState.Checked" /><BzLabel For="d2">On</BzLabel>
        """;

    private const string ControlledCode = """
        <BzCheckbox id="news" @bind-Checked="_state" />
        <BzLabel For="news">Subscribe to the newsletter</BzLabel>

        <p class="text-sm text-muted-foreground">State: <span class="font-mono">@_state</span></p>
        <BzButton Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" @onclick="@(() => _state = CheckedState.Indeterminate)">
            Set indeterminate
        </BzButton>

        @code { private CheckedState _state = CheckedState.Unchecked; }
        """;

    private const string RtlCode = """
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzCheckbox id="rtl-terms" />
            <BzLabel For="rtl-terms">أوافق على الشروط والأحكام</BzLabel>
        </BzDirectionProvider>
        """;
}
