    private bool _formOpen;
    private string? _fbName;
    private string? _fbEmail;
    private string? _fbMessage;

    private bool _asyncOpen;
    private string? _asyncProfile;

    private async Task OnAsyncOpenChanged(bool open)
    {
        _asyncOpen = open;
        if (!open) return;
        _asyncProfile = null;          // show the skeletons
        await Task.Delay(1200);        // stand-in for an API call
        if (_asyncOpen) _asyncProfile = "Ada Lovelace";
    }

    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode _anatomy = new CompositionNode("BzDrawer",
        new CompositionNode("BzDrawerTrigger"),
        new CompositionNode("BzDrawerContent",
            new CompositionNode("BzDrawerHeader",
                new CompositionNode("BzDrawerTitle"),
                new CompositionNode("BzDrawerDescription")),
            new CompositionNode("BzDrawerFooter",
                new CompositionNode("BzDrawerClose"))));

