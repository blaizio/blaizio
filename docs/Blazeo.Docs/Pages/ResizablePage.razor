@page "/components/resizable"
<PageTitle>Resizable - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Resizable</h1>
        <p class="text-muted-foreground">Panels the user can resize by dragging the handle between them - horizontally or vertically, nested, and keyboard-accessible. Each panel takes a percentage of the group; drag (or focus a handle and use the arrow keys) to shift space between neighbours, within each panel's min/max.</p>
    </header>

    <UsageBlock Setup="@UsageSetup" Code="@UsageMarkup"
                Description="Put alternating BzResizablePanel and BzResizableHandle inside a BzResizablePanelGroup. Give panels a DefaultSize (percent); the group fills its container, so size that container." />

    <CompositionTree Root="_anatomy"
                     Description="A group of panels separated by handles. The handle resizes the two panels it sits between." />

    <ExamplesHeading />

    <Demo Title="Default" Description="Two panels with a grip handle. Drag the handle, or focus it (Tab) and use the arrow keys." Code="@DefaultCode">
        <div class="h-[260px] w-full max-w-2xl">
            <BzResizablePanelGroup Direction="ResizeDirection.Horizontal" Class="rounded-lg border">
                <BzResizablePanel DefaultSize="50">
                    <div class="flex h-full items-center justify-center p-6"><span class="font-semibold">One</span></div>
                </BzResizablePanel>
                <BzResizableHandle WithHandle="true" />
                <BzResizablePanel DefaultSize="50">
                    <div class="flex h-full items-center justify-center p-6"><span class="font-semibold">Two</span></div>
                </BzResizablePanel>
            </BzResizablePanelGroup>
        </div>
    </Demo>

    <Demo Title="Vertical" Description="Set Direction=Vertical to stack panels and resize their heights." Code="@VerticalCode">
        <div class="h-[320px] w-full max-w-md">
            <BzResizablePanelGroup Direction="ResizeDirection.Vertical" Class="rounded-lg border">
                <BzResizablePanel DefaultSize="35">
                    <div class="flex h-full items-center justify-center p-6"><span class="font-semibold">Top</span></div>
                </BzResizablePanel>
                <BzResizableHandle WithHandle="true" />
                <BzResizablePanel DefaultSize="65">
                    <div class="flex h-full items-center justify-center p-6"><span class="font-semibold">Bottom</span></div>
                </BzResizablePanel>
            </BzResizablePanelGroup>
        </div>
    </Demo>

    <Demo Title="Three panels" Description="Any number of panels; each handle resizes only the two it sits between." Code="@ThreeCode">
        <div class="h-[260px] w-full">
            <BzResizablePanelGroup Direction="ResizeDirection.Horizontal" Class="rounded-lg border">
                <BzResizablePanel DefaultSize="25" MinSize="15">
                    <div class="flex h-full items-center justify-center p-6"><span class="font-semibold">Nav</span></div>
                </BzResizablePanel>
                <BzResizableHandle />
                <BzResizablePanel DefaultSize="50">
                    <div class="flex h-full items-center justify-center p-6"><span class="font-semibold">Content</span></div>
                </BzResizablePanel>
                <BzResizableHandle />
                <BzResizablePanel DefaultSize="25" MinSize="15">
                    <div class="flex h-full items-center justify-center p-6"><span class="font-semibold">Aside</span></div>
                </BzResizablePanel>
            </BzResizablePanelGroup>
        </div>
    </Demo>

    <Demo Title="Nested" Description="A panel can hold another group - here a vertical split inside the right panel, the classic app layout." Code="@NestedCode">
        <div class="h-[320px] w-full">
            <BzResizablePanelGroup Direction="ResizeDirection.Horizontal" Class="rounded-lg border">
                <BzResizablePanel DefaultSize="40" MinSize="20">
                    <div class="flex h-full items-center justify-center p-6"><span class="font-semibold">Sidebar</span></div>
                </BzResizablePanel>
                <BzResizableHandle WithHandle="true" />
                <BzResizablePanel DefaultSize="60">
                    <BzResizablePanelGroup Direction="ResizeDirection.Vertical">
                        <BzResizablePanel DefaultSize="30">
                            <div class="flex h-full items-center justify-center p-6"><span class="font-semibold">Header</span></div>
                        </BzResizablePanel>
                        <BzResizableHandle WithHandle="true" />
                        <BzResizablePanel DefaultSize="70">
                            <div class="flex h-full items-center justify-center p-6"><span class="font-semibold">Main</span></div>
                        </BzResizablePanel>
                    </BzResizablePanelGroup>
                </BzResizablePanel>
            </BzResizablePanelGroup>
        </div>
    </Demo>

    <Demo Title="Collapsible" Description="A collapsible panel snaps shut when you drag it past its MinSize, and pops back open when you drag it out." Code="@CollapsibleCode">
        <div class="h-[260px] w-full">
            <BzResizablePanelGroup Direction="ResizeDirection.Horizontal" Class="rounded-lg border">
                <BzResizablePanel DefaultSize="25" MinSize="15" Collapsible="true" CollapsedSize="0">
                    <div class="flex h-full items-center justify-center p-6"><span class="font-semibold">Panel</span></div>
                </BzResizablePanel>
                <BzResizableHandle WithHandle="true" />
                <BzResizablePanel DefaultSize="75">
                    <div class="flex h-full items-center justify-center p-6"><span class="font-semibold">Main</span></div>
                </BzResizablePanel>
            </BzResizablePanelGroup>
        </div>
    </Demo>

    <Demo Title="Tracking the layout" Description="Handle OnLayout to read the panel sizes as they change - to persist them, sync a preview, etc." Code="@LayoutCode">
        <div class="space-y-3">
            <div class="h-[200px] w-full">
                <BzResizablePanelGroup Direction="ResizeDirection.Horizontal" OnLayout="OnLayoutChanged" Class="rounded-lg border">
                    <BzResizablePanel DefaultSize="40">
                        <div class="flex h-full items-center justify-center p-6"><span class="font-semibold">Left</span></div>
                    </BzResizablePanel>
                    <BzResizableHandle WithHandle="true" />
                    <BzResizablePanel DefaultSize="60">
                        <div class="flex h-full items-center justify-center p-6"><span class="font-semibold">Right</span></div>
                    </BzResizablePanel>
                </BzResizablePanelGroup>
            </div>
            <p class="text-muted-foreground text-sm">Sizes: <span class="text-foreground font-mono">@_sizesText</span></p>
        </div>
    </Demo>

    <Demo Title="RTL" Description="Under a right-to-left DirectionProvider the panels and the drag direction mirror automatically." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <div class="h-[240px] w-full">
                <BzResizablePanelGroup Direction="ResizeDirection.Horizontal" Class="rounded-lg border">
                    <BzResizablePanel DefaultSize="50">
                        <div class="flex h-full items-center justify-center p-6"><span class="font-semibold">الأول</span></div>
                    </BzResizablePanel>
                    <BzResizableHandle WithHandle="true" />
                    <BzResizablePanel DefaultSize="50">
                        <div class="flex h-full items-center justify-center p-6"><span class="font-semibold">الثاني</span></div>
                    </BzResizablePanel>
                </BzResizablePanelGroup>
            </div>
        </BzDirectionProvider>
    </Demo>

    <ApiReference Types="ApiFamilies.Resizable" />
</div>

@code {
