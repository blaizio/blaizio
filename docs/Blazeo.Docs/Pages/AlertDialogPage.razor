@page "/components/alert-dialog"
<PageTitle>Alert Dialog - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Alert Dialog</h1>
        <p class="text-muted-foreground">A modal that interrupts the user with important content and expects a response. Unlike a dialog, the backdrop is inert - it can only be dismissed through Cancel, the action, or Escape.</p>
    </header>

    <Demo Title="Default" Code="@DefaultCode">
        <BzAlertDialog>
            <BzAlertDialogTrigger>
                <AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Show dialog</BzButton></AsChild>
            </BzAlertDialogTrigger>
            <BzAlertDialogContent>
                <BzAlertDialogHeader>
                    <BzAlertDialogTitle>Are you absolutely sure?</BzAlertDialogTitle>
                    <BzAlertDialogDescription>This action cannot be undone. This will permanently delete your account and remove your data from our servers.</BzAlertDialogDescription>
                </BzAlertDialogHeader>
                <BzAlertDialogFooter>
                    <BzAlertDialogCancel>Cancel</BzAlertDialogCancel>
                    <BzAlertDialogAction>Continue</BzAlertDialogAction>
                </BzAlertDialogFooter>
            </BzAlertDialogContent>
        </BzAlertDialog>
    </Demo>

    <Demo Title="Destructive action"
          Description="Confirm a delete. The action runs your handler and closes; Variant=Destructive tints it."
          Code="@DestructiveCode">
        <div class="flex flex-col items-center gap-3">
            <BzAlertDialog Open="_deleteOpen" OpenChanged="OnDeleteToggled">
                <BzAlertDialogTrigger>
                    <AsChild Context="p"><BzButton Variant="ButtonVariant.Destructive" @attributes="p.Attributes">Delete project</BzButton></AsChild>
                </BzAlertDialogTrigger>
                <BzAlertDialogContent>
                    <BzAlertDialogHeader>
                        <BzAlertDialogTitle>Delete "blazeo"?</BzAlertDialogTitle>
                        <BzAlertDialogDescription>This permanently deletes the project and all of its data. This cannot be undone.</BzAlertDialogDescription>
                    </BzAlertDialogHeader>
                    <BzAlertDialogFooter>
                        <BzAlertDialogCancel>Keep</BzAlertDialogCancel>
                        <BzAlertDialogAction Variant="ButtonVariant.Destructive" @onclick="Delete">Delete</BzAlertDialogAction>
                    </BzAlertDialogFooter>
                </BzAlertDialogContent>
            </BzAlertDialog>
            <p class="text-sm text-muted-foreground">@_status</p>
        </div>
    </Demo>

    <Demo Title="Compact"
          Description='Size="Sm" narrows the surface; on small screens the footer becomes a two-column grid.'
          Code="@CompactCode">
        <BzAlertDialog>
            <BzAlertDialogTrigger>
                <AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Sign out</BzButton></AsChild>
            </BzAlertDialogTrigger>
            <BzAlertDialogContent Size="AlertDialogSize.Sm">
                <BzAlertDialogHeader>
                    <BzAlertDialogTitle>Sign out?</BzAlertDialogTitle>
                    <BzAlertDialogDescription>You will need to sign in again to continue.</BzAlertDialogDescription>
                </BzAlertDialogHeader>
                <BzAlertDialogFooter>
                    <BzAlertDialogCancel>Cancel</BzAlertDialogCancel>
                    <BzAlertDialogAction>Sign out</BzAlertDialogAction>
                </BzAlertDialogFooter>
            </BzAlertDialogContent>
        </BzAlertDialog>
    </Demo>
    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the footer actions mirror to the right." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzAlertDialog>
                <BzAlertDialogTrigger>
                    <AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">عرض النافذة</BzButton></AsChild>
                </BzAlertDialogTrigger>
                <BzAlertDialogContent>
                    <BzAlertDialogHeader>
                        <BzAlertDialogTitle>هل أنت متأكد تمامًا؟</BzAlertDialogTitle>
                        <BzAlertDialogDescription>لا يمكن التراجع عن هذا الإجراء. سيؤدي ذلك إلى حذف حسابك نهائيًا وإزالة بياناتك من خوادمنا.</BzAlertDialogDescription>
                    </BzAlertDialogHeader>
                    <BzAlertDialogFooter>
                        <BzAlertDialogCancel>إلغاء</BzAlertDialogCancel>
                        <BzAlertDialogAction>متابعة</BzAlertDialogAction>
                    </BzAlertDialogFooter>
                </BzAlertDialogContent>
            </BzAlertDialog>
        </BzDirectionProvider>
    </Demo>
    <ApiReference Types="ApiFamilies.AlertDialog" />
</div>

@code {
    private bool _deleteOpen;
    private string _status = "No project deleted.";

    // Reset the status each time the dialog opens, so the demo shows the transition every time.
    private void OnDeleteToggled(bool open)
    {
        _deleteOpen = open;
        if (open) _status = "No project deleted.";
    }

    private void Delete() => _status = "Project deleted.";

    private const string DefaultCode = """
        <BzAlertDialog>
            <BzAlertDialogTrigger>
                <AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Show dialog</BzButton></AsChild>
            </BzAlertDialogTrigger>
            <BzAlertDialogContent>
                <BzAlertDialogHeader>
                    <BzAlertDialogTitle>Are you absolutely sure?</BzAlertDialogTitle>
                    <BzAlertDialogDescription>This action cannot be undone.</BzAlertDialogDescription>
                </BzAlertDialogHeader>
                <BzAlertDialogFooter>
                    <BzAlertDialogCancel>Cancel</BzAlertDialogCancel>
                    <BzAlertDialogAction>Continue</BzAlertDialogAction>
                </BzAlertDialogFooter>
            </BzAlertDialogContent>
        </BzAlertDialog>
        """;

    private const string DestructiveCode = """
        <BzAlertDialog Open="_deleteOpen" OpenChanged="OnDeleteToggled">
            ...
            <BzAlertDialogAction Variant="ButtonVariant.Destructive" @onclick="Delete">Delete</BzAlertDialogAction>
            ...
        </BzAlertDialog>

        @code {
            private bool _deleteOpen;
            private string _status = "No project deleted.";

            // Reset each time it opens so the transition shows every time.
            private void OnDeleteToggled(bool open)
            {
                _deleteOpen = open;
                if (open) _status = "No project deleted.";
            }

            private void Delete() => _status = "Project deleted.";
        }
        """;

    private const string CompactCode = """
        <BzAlertDialogContent Size="AlertDialogSize.Sm">
            <BzAlertDialogHeader>
                <BzAlertDialogTitle>Sign out?</BzAlertDialogTitle>
                <BzAlertDialogDescription>You will need to sign in again to continue.</BzAlertDialogDescription>
            </BzAlertDialogHeader>
            <BzAlertDialogFooter>
                <BzAlertDialogCancel>Cancel</BzAlertDialogCancel>
                <BzAlertDialogAction>Sign out</BzAlertDialogAction>
            </BzAlertDialogFooter>
        </BzAlertDialogContent>
        """;

    private const string RtlCode = """
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzAlertDialog>
                <BzAlertDialogTrigger>
                    <AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">عرض النافذة</BzButton></AsChild>
                </BzAlertDialogTrigger>
                <BzAlertDialogContent>
                    <BzAlertDialogHeader>
                        <BzAlertDialogTitle>هل أنت متأكد تمامًا؟</BzAlertDialogTitle>
                        <BzAlertDialogDescription>لا يمكن التراجع عن هذا الإجراء.</BzAlertDialogDescription>
                    </BzAlertDialogHeader>
                    <BzAlertDialogFooter>
                        <BzAlertDialogCancel>إلغاء</BzAlertDialogCancel>
                        <BzAlertDialogAction>متابعة</BzAlertDialogAction>
                    </BzAlertDialogFooter>
                </BzAlertDialogContent>
            </BzAlertDialog>
        </BzDirectionProvider>
        """;
}
