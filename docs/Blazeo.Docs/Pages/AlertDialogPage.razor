@page "/components/alert-dialog"
<PageTitle>Alert Dialog - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Alert Dialog</h1>
        <p class="text-muted-foreground">A modal that interrupts the user with important content and expects a response. Unlike a dialog, the backdrop is inert - it can only be dismissed through Cancel, the action, or Escape.</p>
    </header>

    <UsageBlock Setup="@UsageSetup" Code="@UsageMarkup"
                Description="Add the using once, then compose a trigger, content, header, and footer. Cancel dismisses; Action runs your handler then closes." />

    <CompositionTree Root="_anatomy"
                     Description="The full anatomy. Header holds the title and description; the footer pairs a Cancel with an Action." />

    <ExamplesHeading />

    <Demo Title="Default" Code="@DefaultCode">
        <BzAlertDialog>
            <BzAlertDialogTrigger Variant="ButtonVariant.Outline">Show dialog</BzAlertDialogTrigger>
            <BzAlertDialogContent>
                <BzAlertDialogHeader>
                    <BzAlertDialogTitle>Are you absolutely sure?</BzAlertDialogTitle>
                    <BzAlertDialogDescription>This action cannot be undone. This will permanently delete your account and remove your data from our servers.</BzAlertDialogDescription>
                </BzAlertDialogHeader>
                <BzAlertDialogFooter>
                    <BzAlertDialogCancel>Cancel</BzAlertDialogCancel>
                    <BzAlertDialogAction>Continue</BzAlertDialogAction>
                </BzAlertDialogFooter>
            </BzAlertDialogContent>
        </BzAlertDialog>
    </Demo>

    <Demo Title="Custom trigger element (RenderAs)"
          Description="When you need the trigger to be something other than a button - a link, a card, your own component - use RenderAs and splat the behaviour onto your element."
          Code="@RenderAsTriggerCode">
        <BzAlertDialog>
            <BzAlertDialogTrigger>
                <RenderAs Context="p">
                    <a href="#" @onclick:preventDefault @attributes="p.Attributes" class="text-sm font-medium text-indigo-600 underline-offset-4 hover:underline dark:text-indigo-400">Open as a link</a>
                </RenderAs>
            </BzAlertDialogTrigger>
            <BzAlertDialogContent>
                <BzAlertDialogHeader>
                    <BzAlertDialogTitle>Custom trigger</BzAlertDialogTitle>
                    <BzAlertDialogDescription>This alert dialog was opened by an anchor, not a button.</BzAlertDialogDescription>
                </BzAlertDialogHeader>
                <BzAlertDialogFooter>
                    <BzAlertDialogCancel>Cancel</BzAlertDialogCancel>
                    <BzAlertDialogAction>Continue</BzAlertDialogAction>
                </BzAlertDialogFooter>
            </BzAlertDialogContent>
        </BzAlertDialog>
    </Demo>

    <Demo Title="Destructive action"
          Description="Confirm a delete. The action runs your handler and closes; Variant=Destructive tints it."
          Code="@DestructiveCode">
        <div class="flex flex-col items-center gap-3">
            <BzAlertDialog Open="_deleteOpen" OpenChanged="OnDeleteToggled">
                <BzAlertDialogTrigger Variant="ButtonVariant.Destructive">Delete project</BzAlertDialogTrigger>
                <BzAlertDialogContent>
                    <BzAlertDialogHeader>
                        <BzAlertDialogTitle>Delete "blazeo"?</BzAlertDialogTitle>
                        <BzAlertDialogDescription>This permanently deletes the project and all of its data. This cannot be undone.</BzAlertDialogDescription>
                    </BzAlertDialogHeader>
                    <BzAlertDialogFooter>
                        <BzAlertDialogCancel>Keep</BzAlertDialogCancel>
                        <BzAlertDialogAction Variant="ButtonVariant.Destructive" @onclick="Delete">Delete</BzAlertDialogAction>
                    </BzAlertDialogFooter>
                </BzAlertDialogContent>
            </BzAlertDialog>
            <p class="text-sm text-muted-foreground">@_status</p>
        </div>
    </Demo>

    <Demo Title="Compact"
          Description='Size="Sm" narrows the surface; on small screens the footer becomes a two-column grid.'
          Code="@CompactCode">
        <BzAlertDialog>
            <BzAlertDialogTrigger Variant="ButtonVariant.Outline">Sign out</BzAlertDialogTrigger>
            <BzAlertDialogContent Size="AlertDialogSize.Sm">
                <BzAlertDialogHeader>
                    <BzAlertDialogTitle>Sign out?</BzAlertDialogTitle>
                    <BzAlertDialogDescription>You will need to sign in again to continue.</BzAlertDialogDescription>
                </BzAlertDialogHeader>
                <BzAlertDialogFooter>
                    <BzAlertDialogCancel>Cancel</BzAlertDialogCancel>
                    <BzAlertDialogAction>Sign out</BzAlertDialogAction>
                </BzAlertDialogFooter>
            </BzAlertDialogContent>
        </BzAlertDialog>
    </Demo>
    <Demo Title="Customization"
          Description="Restyle any part via Class - here a branded surface (custom radius, tinted border and background) and an indigo title. Root-level utilities win over the skin."
          Code="@CustomCode">
        <BzAlertDialog>
            <BzAlertDialogTrigger Class="bg-indigo-600 text-white hover:bg-indigo-700">Show dialog</BzAlertDialogTrigger>
            <BzAlertDialogContent Class="rounded-2xl border-indigo-200 bg-indigo-50/80 dark:border-indigo-900 dark:bg-indigo-950/70">
                <BzAlertDialogHeader>
                    <BzAlertDialogTitle Class="text-indigo-700 dark:text-indigo-300">Are you absolutely sure?</BzAlertDialogTitle>
                    <BzAlertDialogDescription>This action cannot be undone. This will permanently delete your account and remove your data from our servers.</BzAlertDialogDescription>
                </BzAlertDialogHeader>
                <BzAlertDialogFooter>
                    <BzAlertDialogCancel>Cancel</BzAlertDialogCancel>
                    <BzAlertDialogAction Class="bg-indigo-600 text-white hover:bg-indigo-700">Continue</BzAlertDialogAction>
                </BzAlertDialogFooter>
            </BzAlertDialogContent>
        </BzAlertDialog>
    </Demo>
    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the footer actions mirror to the right." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzAlertDialog>
                <BzAlertDialogTrigger Variant="ButtonVariant.Outline">عرض النافذة</BzAlertDialogTrigger>
                <BzAlertDialogContent>
                    <BzAlertDialogHeader>
                        <BzAlertDialogTitle>هل أنت متأكد تمامًا؟</BzAlertDialogTitle>
                        <BzAlertDialogDescription>لا يمكن التراجع عن هذا الإجراء. سيؤدي ذلك إلى حذف حسابك نهائيًا وإزالة بياناتك من خوادمنا.</BzAlertDialogDescription>
                    </BzAlertDialogHeader>
                    <BzAlertDialogFooter>
                        <BzAlertDialogCancel>إلغاء</BzAlertDialogCancel>
                        <BzAlertDialogAction>متابعة</BzAlertDialogAction>
                    </BzAlertDialogFooter>
                </BzAlertDialogContent>
            </BzAlertDialog>
        </BzDirectionProvider>
    </Demo>
    <ApiReference Types="ApiFamilies.AlertDialog" />
</div>

@code {
    private bool _deleteOpen;
    private string _status = "No project deleted.";

    // Reset the status each time the dialog opens, so the demo shows the transition every time.
    private void OnDeleteToggled(bool open)
    {
        _deleteOpen = open;
        if (open) _status = "No project deleted.";
    }

    private void Delete() => _status = "Project deleted.";

    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode _anatomy = new CompositionNode("BzAlertDialog",
        new CompositionNode("BzAlertDialogTrigger"),
        new CompositionNode("BzAlertDialogContent",
            new CompositionNode("BzAlertDialogHeader",
                new CompositionNode("BzAlertDialogTitle"),
                new CompositionNode("BzAlertDialogDescription")),
            new CompositionNode("BzAlertDialogFooter",
                new CompositionNode("BzAlertDialogCancel"),
                new CompositionNode("BzAlertDialogAction"))));

