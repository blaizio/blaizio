@page "/components/hover-card"
<PageTitle>Hover Card - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Hover Card</h1>
        <p class="text-muted-foreground">A card that previews rich content when you hover or focus a trigger - usually a link or avatar - positioned with <a class="font-medium text-foreground underline underline-offset-4" href="https://floating-ui.com" target="_blank" rel="noopener">Floating UI</a>. It opens after a short delay and, unlike a tooltip, the card is <strong>interactive</strong>: a close delay lets you move the pointer onto it without it snapping shut. It is <strong>non-modal</strong> - the rest of the page stays interactive, and Escape or a click outside dismisses it.</p>
    </header>

    <Demo Title="Default" Description="A profile preview behind a username link. Hover or focus the trigger; move onto the card to interact with it, or leave to dismiss it after a short delay." Code="@DefaultCode">
        <BzHoverCard>
            <BzHoverCardTrigger>
                <AsChild Context="p"><BzButton Variant="ButtonVariant.Link" @attributes="p.Attributes">@@janedoe</BzButton></AsChild>
            </BzHoverCardTrigger>
            <BzHoverCardContent Class="w-80">
                <div class="flex gap-4">
                    <BzAvatar>
                        <BzAvatarImage Src="https://i.pravatar.cc/120?img=47" Alt="Jane Doe" />
                        <BzAvatarFallback>JD</BzAvatarFallback>
                    </BzAvatar>
                    <div class="space-y-1">
                        <h4 class="text-sm font-semibold">Jane Doe</h4>
                        <p class="text-sm text-muted-foreground">Product designer. Building accessible component libraries and writing about design systems.</p>
                        <div class="flex items-center gap-1.5 pt-1 text-xs text-muted-foreground">
                            <BzIcon Icon="@Icons.Outline.Calendar" Class="size-3.5" />
                            Joined March 2024
                        </div>
                    </div>
                </div>
            </BzHoverCardContent>
        </BzHoverCard>
    </Demo>

    <Demo Title="Arrow" Description="Drop an optional HoverCardArrow inside the content to point back at the trigger. It is filled with the card surface and shares the card's hairline ring and shadow, so it reads as the card's tail rather than a flat sticker - and it rotates to whichever side the card resolves to." Code="@ArrowCode">
        <BzHoverCard>
            <BzHoverCardTrigger>
                <AsChild Context="p"><BzButton Variant="ButtonVariant.Link" @attributes="p.Attributes">@@janedoe</BzButton></AsChild>
            </BzHoverCardTrigger>
            <BzHoverCardContent Class="w-64">
                <div class="space-y-1">
                    <h4 class="text-sm font-semibold">Jane Doe</h4>
                    <p class="text-sm text-muted-foreground">Product designer building accessible component libraries.</p>
                </div>
                <BzHoverCardArrow />
            </BzHoverCardContent>
        </BzHoverCard>
    </Demo>

    <Demo Title="Alignment" Description="Align sets where the card sits along the trigger's edge - start, center, or end." Code="@AlignCode">
        <div class="flex items-center gap-2">
            <BzHoverCard>
                <BzHoverCardTrigger><AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Start</BzButton></AsChild></BzHoverCardTrigger>
                <BzHoverCardContent Align="Align.Start">Aligned to the start edge.</BzHoverCardContent>
            </BzHoverCard>
            <BzHoverCard>
                <BzHoverCardTrigger><AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Center</BzButton></AsChild></BzHoverCardTrigger>
                <BzHoverCardContent Align="Align.Center">Centered on the trigger.</BzHoverCardContent>
            </BzHoverCard>
            <BzHoverCard>
                <BzHoverCardTrigger><AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">End</BzButton></AsChild></BzHoverCardTrigger>
                <BzHoverCardContent Align="Align.End">Aligned to the end edge.</BzHoverCardContent>
            </BzHoverCard>
        </div>
    </Demo>

    <Demo Title="Sides" Description="Side sets the preferred edge the card opens from - left, top, bottom, or right - and it flips to the opposite side when there isn't room. Drop in an optional HoverCardArrow to point back at the trigger." Code="@SideCode">
        <div class="flex items-center justify-center gap-3 py-12">
            <BzHoverCard>
                <BzHoverCardTrigger><AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Left</BzButton></AsChild></BzHoverCardTrigger>
                <BzHoverCardContent Side="Side.Left" Class="w-auto">Opens to the left.<BzHoverCardArrow /></BzHoverCardContent>
            </BzHoverCard>
            <BzHoverCard>
                <BzHoverCardTrigger><AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Top</BzButton></AsChild></BzHoverCardTrigger>
                <BzHoverCardContent Side="Side.Top" Class="w-auto">Opens above the trigger.<BzHoverCardArrow /></BzHoverCardContent>
            </BzHoverCard>
            <BzHoverCard>
                <BzHoverCardTrigger><AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Bottom</BzButton></AsChild></BzHoverCardTrigger>
                <BzHoverCardContent Side="Side.Bottom" Class="w-auto">Opens below the trigger.<BzHoverCardArrow /></BzHoverCardContent>
            </BzHoverCard>
            <BzHoverCard>
                <BzHoverCardTrigger><AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Right</BzButton></AsChild></BzHoverCardTrigger>
                <BzHoverCardContent Side="Side.Right" Class="w-auto">Opens to the right.<BzHoverCardArrow /></BzHoverCardContent>
            </BzHoverCard>
        </div>
    </Demo>

    <Demo Title="Open &amp; close delays" Description="OpenDelay is how long the pointer must rest before the card opens; CloseDelay how long it lingers after you leave (long enough to move onto the card). One here opens instantly, the other takes its time." Code="@DelayCode">
        <div class="flex items-center gap-6">
            <BzHoverCard OpenDelay="0">
                <BzHoverCardTrigger><AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Instant</BzButton></AsChild></BzHoverCardTrigger>
                <BzHoverCardContent>Opens the moment you hover (OpenDelay 0).</BzHoverCardContent>
            </BzHoverCard>
            <BzHoverCard OpenDelay="700" CloseDelay="600">
                <BzHoverCardTrigger><AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Relaxed</BzButton></AsChild></BzHoverCardTrigger>
                <BzHoverCardContent>Waits to open, then lingers before closing.</BzHoverCardContent>
            </BzHoverCard>
        </div>
    </Demo>

    <Demo Title="Controlled" Description="Drive the open state with a two-way Open binding - the live state is shown above and stays in sync as you hover the trigger, move onto the card, or dismiss it." Code="@ControlledCode">
        <div class="flex flex-col items-center gap-4">
            <span class="text-muted-foreground text-sm">Open: @_open</span>
            <BzHoverCard @bind-Open="_open">
                <BzHoverCardTrigger>
                    <AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Hover me</BzButton></AsChild>
                </BzHoverCardTrigger>
                <BzHoverCardContent>The open state lives in the page via @@bind-Open.</BzHoverCardContent>
            </BzHoverCard>
        </div>
    </Demo>

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the card anchors and aligns mirrored to the right." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzHoverCard>
                <BzHoverCardTrigger>
                    <AsChild Context="p"><BzButton Variant="ButtonVariant.Link" @attributes="p.Attributes">@@جين</BzButton></AsChild>
                </BzHoverCardTrigger>
                <BzHoverCardContent Class="w-80">
                    <div class="flex gap-4">
                        <BzAvatar>
                            <BzAvatarImage Src="https://i.pravatar.cc/120?img=47" Alt="جين دو" />
                            <BzAvatarFallback>ج</BzAvatarFallback>
                        </BzAvatar>
                        <div class="space-y-1">
                            <h4 class="text-sm font-semibold">جين دو</h4>
                            <p class="text-sm text-muted-foreground">مصممة منتجات. تبني مكتبات مكونات سهلة الوصول وتكتب عن أنظمة التصميم.</p>
                        </div>
                    </div>
                </BzHoverCardContent>
            </BzHoverCard>
        </BzDirectionProvider>
    </Demo>

    <ApiReference Types="ApiFamilies.HoverCard" />
</div>

