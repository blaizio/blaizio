@page "/components/pagination"
<PageTitle>Pagination - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Pagination</h1>
        <p class="text-muted-foreground">
            Steps through pages of content. Compose the parts - <code class="bz-code">PaginationContent</code>,
            <code class="bz-code">PaginationItem</code>, <code class="bz-code">PaginationLink</code>,
            <code class="bz-code">PaginationFirst</code>/<code class="bz-code">Last</code>,
            <code class="bz-code">PaginationPrevious</code>/<code class="bz-code">Next</code> and
            <code class="bz-code">PaginationEllipsis</code> - and drive the page state yourself. Use
            <code class="bz-code">Href</code> for URL paging or <code class="bz-code">OnClick</code> for in-place paging.
            <code class="bz-code">BzDataTable&lt;TItem&gt;</code> wires this up for you via <code class="bz-code">PageSize</code>.
        </p>
    </header>

    <UsageBlock Setup="@UsageSetup" Code="@UsageMarkup"
                Description="Add the using once, then compose the content with items. Mark the current page with Active and stand a gap in with an ellipsis." />

    <CompositionTree Root="_anatomy"
                     Description="The full anatomy. Each control sits in its own item; PaginationPrevious/Next are PaginationLinks with a chevron and label, and the ellipsis fills a gap." />

    <ExamplesHeading />

    <Demo Title="Default" Description="The active page is marked with Active (aria-current=page) and gaps collapse to an ellipsis. Drive it in place with OnClick - or swap to Href for URL paging (e.g. products?page=2)." Code="@DefaultCode">
        <BzPagination>
            <BzPaginationContent>
                <BzPaginationItem><BzPaginationPrevious Disabled="@(_basic == 1)" OnClick="@(() => _basic = Math.Clamp(_basic - 1, 1, TotalPages))" /></BzPaginationItem>
                @foreach (var token in PageTokens(_basic))
                {
                    <BzPaginationItem>
                        @if (token == 0)
                        {
                            <BzPaginationEllipsis />
                        }
                        else
                        {
                            <BzPaginationLink Active="@(token == _basic)" OnClick="@(() => _basic = token)" AriaLabel="@($"Go to page {token}")">@token</BzPaginationLink>
                        }
                    </BzPaginationItem>
                }
                <BzPaginationItem><BzPaginationNext Disabled="@(_basic == TotalPages)" OnClick="@(() => _basic = Math.Clamp(_basic + 1, 1, TotalPages))" /></BzPaginationItem>
            </BzPaginationContent>
        </BzPagination>
    </Demo>

    <Demo Title="Routed links (RenderAs)"
          Description="Render each link onto a Blazor NavLink via RenderAs, so the router owns navigation and the active styling."
          Code="@RenderAsCode">
        <BzPagination>
            <BzPaginationContent>
                <BzPaginationItem>
                    <BzPaginationLink>
                        <RenderAs Context="p"><NavLink href="components/pagination?page=1" @attributes="p.Attributes">1</NavLink></RenderAs>
                    </BzPaginationLink>
                </BzPaginationItem>
                <BzPaginationItem>
                    <BzPaginationLink Active="true">
                        <RenderAs Context="p"><NavLink href="components/pagination?page=2" @attributes="p.Attributes">2</NavLink></RenderAs>
                    </BzPaginationLink>
                </BzPaginationItem>
                <BzPaginationItem>
                    <BzPaginationLink>
                        <RenderAs Context="p"><NavLink href="components/pagination?page=3" @attributes="p.Attributes">3</NavLink></RenderAs>
                    </BzPaginationLink>
                </BzPaginationItem>
            </BzPaginationContent>
        </BzPagination>
    </Demo>

    <Demo Title="Simple" Description="A bare previous/next pager - no page-number links, just the two controls flanking a page indicator. Good for feeds and infinite-ish lists where the exact page count doesn't matter." Code="@SimpleCode">
        <div class="flex flex-col items-center gap-3">
            <BzPagination>
                <BzPaginationContent>
                    <BzPaginationItem><BzPaginationPrevious Disabled="@(_simple == 1)" OnClick="@(() => _simple = Math.Clamp(_simple - 1, 1, TotalPages))" /></BzPaginationItem>
                    <BzPaginationItem><BzPaginationNext Disabled="@(_simple == TotalPages)" OnClick="@(() => _simple = Math.Clamp(_simple + 1, 1, TotalPages))" /></BzPaginationItem>
                </BzPaginationContent>
            </BzPagination>
            <p class="text-sm text-muted-foreground">Page @_simple of @TotalPages</p>
        </div>
    </Demo>

    <Demo Title="Icons only" Description="Drop the Previous/Next labels and let the chevrons stand alone - each is a PaginationLink with just an icon, so it renders as a square button. Keep an AriaLabel so the control is still announced." Code="@IconsOnlyCode">
        <BzPagination>
            <BzPaginationContent>
                <BzPaginationItem>
                    <BzPaginationLink Disabled="@(_icons == 1)" OnClick="@(() => _icons -= 1)" AriaLabel="Go to previous page"><BzIcon Icon="@Icons.Outline.ChevronLeft" /></BzPaginationLink>
                </BzPaginationItem>
                <BzPaginationItem><BzPaginationLink Active="@(_icons == 1)" OnClick="@(() => _icons = 1)">1</BzPaginationLink></BzPaginationItem>
                <BzPaginationItem><BzPaginationLink Active="@(_icons == 2)" OnClick="@(() => _icons = 2)">2</BzPaginationLink></BzPaginationItem>
                <BzPaginationItem><BzPaginationLink Active="@(_icons == 3)" OnClick="@(() => _icons = 3)">3</BzPaginationLink></BzPaginationItem>
                <BzPaginationItem>
                    <BzPaginationLink Disabled="@(_icons == 3)" OnClick="@(() => _icons += 1)" AriaLabel="Go to next page"><BzIcon Icon="@Icons.Outline.ChevronRight" /></BzPaginationLink>
                </BzPaginationItem>
            </BzPaginationContent>
        </BzPagination>
    </Demo>

    <Demo Title="Controlled" Description="Drive the current page with state and OnClick (no navigation). Previous/Next disable at the ends; the window around the current page slides, with ellipses standing in for the gaps." Code="@ControlledCode">
        <div class="flex flex-col items-center gap-3">
            <BzPagination>
                <BzPaginationContent>
                    <BzPaginationItem>
                        <BzPaginationPrevious Disabled="@(_page == 1)" OnClick="@(() => GoTo(_page - 1))" />
                    </BzPaginationItem>
                    @foreach (var token in PageTokens())
                    {
                        <BzPaginationItem>
                            @if (token == 0)
                            {
                                <BzPaginationEllipsis />
                            }
                            else
                            {
                                <BzPaginationLink Active="@(token == _page)" OnClick="@(() => GoTo(token))" AriaLabel="@($"Go to page {token}")">@token</BzPaginationLink>
                            }
                        </BzPaginationItem>
                    }
                    <BzPaginationItem>
                        <BzPaginationNext Disabled="@(_page == TotalPages)" OnClick="@(() => GoTo(_page + 1))" />
                    </BzPaginationItem>
                </BzPaginationContent>
            </BzPagination>
            <p class="text-sm text-muted-foreground">Page <span class="font-medium text-foreground">@_page</span> of @TotalPages</p>
        </div>
    </Demo>

    <Demo Title="First and last" Description="Add First and Last controls to jump straight to either end. Both carry a double-chevron that mirrors under RTL; First and Previous disable on the first page, Next and Last on the last." Code="@FirstLastCode">
        <div class="flex flex-col items-center gap-3">
            <BzPagination>
                <BzPaginationContent>
                    <BzPaginationItem><BzPaginationFirst Disabled="@(_jump == 1)" OnClick="@(() => _jump = 1)" /></BzPaginationItem>
                    <BzPaginationItem><BzPaginationPrevious Disabled="@(_jump == 1)" OnClick="@(() => JumpTo(_jump - 1))" /></BzPaginationItem>
                    @foreach (var token in PageTokens(_jump))
                    {
                        <BzPaginationItem>
                            @if (token == 0)
                            {
                                <BzPaginationEllipsis />
                            }
                            else
                            {
                                <BzPaginationLink Active="@(token == _jump)" OnClick="@(() => JumpTo(token))" AriaLabel="@($"Go to page {token}")">@token</BzPaginationLink>
                            }
                        </BzPaginationItem>
                    }
                    <BzPaginationItem><BzPaginationNext Disabled="@(_jump == TotalPages)" OnClick="@(() => JumpTo(_jump + 1))" /></BzPaginationItem>
                    <BzPaginationItem><BzPaginationLast Disabled="@(_jump == TotalPages)" OnClick="@(() => _jump = TotalPages)" /></BzPaginationItem>
                </BzPaginationContent>
            </BzPagination>
            <p class="text-sm text-muted-foreground">Page <span class="font-medium text-foreground">@_jump</span> of @TotalPages</p>
        </div>
    </Demo>

    <Demo Title="Rows per page" Description="A data-grid footer - a rows-per-page Select drives the page size and a previous/next pager steps through. The listbox uses item-aligned positioning, so it overlays the trigger like a native select. Changing the size returns to the first page." Code="@RowsPerPageCode">
        <div class="flex w-full flex-col items-center gap-4 sm:flex-row sm:justify-between">
            <div class="flex items-center gap-2">
                <span class="text-sm font-medium">Rows per page</span>
                <BzSelect Value="@_rppSize" ValueChanged="OnRppSizeChanged">
                    <BzSelectTrigger Size="SelectTriggerSize.Sm" Class="w-[4.5rem]">
                        <BzSelectValue />
                    </BzSelectTrigger>
                    <BzSelectContent Position="SelectPosition.ItemAligned">
                        <BzSelectItem Value="10">10</BzSelectItem>
                        <BzSelectItem Value="20">20</BzSelectItem>
                        <BzSelectItem Value="30">30</BzSelectItem>
                        <BzSelectItem Value="50">50</BzSelectItem>
                    </BzSelectContent>
                </BzSelect>
            </div>
            <div class="flex items-center gap-4">
                <span class="text-sm font-medium">Page @_rppPage of @RppPages</span>
                <BzPagination Class="mx-0 w-auto">
                    <BzPaginationContent>
                        <BzPaginationItem>
                            <BzPaginationPrevious Disabled="@(_rppPage == 1)" OnClick="@(() => RppGoTo(_rppPage - 1))" />
                        </BzPaginationItem>
                        <BzPaginationItem>
                            <BzPaginationNext Disabled="@(_rppPage == RppPages)" OnClick="@(() => RppGoTo(_rppPage + 1))" />
                        </BzPaginationItem>
                    </BzPaginationContent>
                </BzPagination>
            </div>
        </div>
    </Demo>

    <Demo Title="Custom labels" Description="Every bit of copy is a parameter - rename the rows-per-page label and pass Label (and AriaLabel) to Previous/Next. Use this to localize the pager or word it for your domain." Code="@CustomLabelsCode">
        <div class="flex w-full flex-col items-center gap-4 sm:flex-row sm:justify-between">
            <div class="flex items-center gap-2">
                <span class="text-sm font-medium">Items per page</span>
                <BzSelect Value="@_rppSize" ValueChanged="OnRppSizeChanged">
                    <BzSelectTrigger Size="SelectTriggerSize.Sm" Class="w-[4.5rem]">
                        <BzSelectValue />
                    </BzSelectTrigger>
                    <BzSelectContent Position="SelectPosition.ItemAligned">
                        <BzSelectItem Value="10">10</BzSelectItem>
                        <BzSelectItem Value="20">20</BzSelectItem>
                        <BzSelectItem Value="30">30</BzSelectItem>
                        <BzSelectItem Value="50">50</BzSelectItem>
                    </BzSelectContent>
                </BzSelect>
            </div>
            <BzPagination Class="mx-0 w-auto">
                <BzPaginationContent>
                    <BzPaginationItem>
                        <BzPaginationPrevious Disabled="@(_feed == 1)" OnClick="@(() => _feed = Math.Clamp(_feed - 1, 1, TotalPages))" Label="Newer" AriaLabel="Go to newer page" />
                    </BzPaginationItem>
                    <BzPaginationItem>
                        <BzPaginationNext Disabled="@(_feed == TotalPages)" OnClick="@(() => _feed = Math.Clamp(_feed + 1, 1, TotalPages))" Label="Older" AriaLabel="Go to older page" />
                    </BzPaginationItem>
                </BzPaginationContent>
            </BzPagination>
        </div>
    </Demo>

    <Demo Title="Customization"
          Description="Restyle any part via Class - here the links become rounded-full pills with a wider gap and an indigo active page. Utilities win over the skin, so the data-active override takes effect."
          Code="@CustomCode">
        <BzPagination>
            <BzPaginationContent Class="gap-2">
                <BzPaginationItem><BzPaginationPrevious Disabled="@(_custom == 1)" OnClick="@(() => _custom -= 1)" Class="rounded-full" /></BzPaginationItem>
                <BzPaginationItem><BzPaginationLink Active="@(_custom == 1)" OnClick="@(() => _custom = 1)" Class="rounded-full data-[active=true]:border-indigo-600 data-[active=true]:bg-indigo-600 data-[active=true]:text-white">1</BzPaginationLink></BzPaginationItem>
                <BzPaginationItem><BzPaginationLink Active="@(_custom == 2)" OnClick="@(() => _custom = 2)" Class="rounded-full data-[active=true]:border-indigo-600 data-[active=true]:bg-indigo-600 data-[active=true]:text-white">2</BzPaginationLink></BzPaginationItem>
                <BzPaginationItem><BzPaginationLink Active="@(_custom == 3)" OnClick="@(() => _custom = 3)" Class="rounded-full data-[active=true]:border-indigo-600 data-[active=true]:bg-indigo-600 data-[active=true]:text-white">3</BzPaginationLink></BzPaginationItem>
                <BzPaginationItem><BzPaginationNext Disabled="@(_custom == 3)" OnClick="@(() => _custom += 1)" Class="rounded-full" /></BzPaginationItem>
            </BzPaginationContent>
        </BzPagination>
    </Demo>

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the bar lays out right-to-left and the previous/next chevrons mirror. Arabic uses the same 1 2 3 digits as English." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzPagination>
                <BzPaginationContent>
                    <BzPaginationItem><BzPaginationPrevious Disabled="@(_rtl == 1)" OnClick="@(() => _rtl -= 1)" Label="السابق" AriaLabel="الصفحة السابقة" /></BzPaginationItem>
                    <BzPaginationItem><BzPaginationLink Active="@(_rtl == 1)" OnClick="@(() => _rtl = 1)">1</BzPaginationLink></BzPaginationItem>
                    <BzPaginationItem><BzPaginationLink Active="@(_rtl == 2)" OnClick="@(() => _rtl = 2)">2</BzPaginationLink></BzPaginationItem>
                    <BzPaginationItem><BzPaginationLink Active="@(_rtl == 3)" OnClick="@(() => _rtl = 3)">3</BzPaginationLink></BzPaginationItem>
                    <BzPaginationItem><BzPaginationNext Disabled="@(_rtl == 3)" OnClick="@(() => _rtl += 1)" Label="التالي" AriaLabel="الصفحة التالية" /></BzPaginationItem>
                </BzPaginationContent>
            </BzPagination>
        </BzDirectionProvider>
    </Demo>

</div>

@code {
    private int _page = 3;
    private int _jump = 1;
    private const int TotalPages = 10;

    // Each presentational demo drives its own page in place (OnClick), so nothing navigates away.
    private int _basic = 2;
    private int _icons = 2;
    private int _custom = 2;
    private int _rtl = 2;
    private int _simple = 2;
    private int _feed = 2;

    private void GoTo(int page) => _page = Math.Clamp(page, 1, TotalPages);
    private void JumpTo(int page) => _jump = Math.Clamp(page, 1, TotalPages);

    // Rows-per-page demo state. The size is a string so it binds straight to the Select; the page count
    // derives from a fixed row total and resets to 1 whenever the size changes.
    private const int RppTotal = 100;
    private string _rppSize = "10";
    private int _rppPage = 1;
    private int RppPages => (int)Math.Ceiling(RppTotal / (double)int.Parse(_rppSize));

    private void OnRppSizeChanged(string? value)
    {
        _rppSize = value ?? "10";
        _rppPage = 1;
    }

    private void RppGoTo(int page) => _rppPage = Math.Clamp(page, 1, RppPages);

    // The page tokens to render: 1, the last page, and a sliding window around the current page,
    // with 0 standing in for an ellipsis where there is a gap.
    private IEnumerable<int> PageTokens() => PageTokens(_page);

    private IEnumerable<int> PageTokens(int current)
    {
        var pages = new List<int> { 1 };
        var start = Math.Max(2, current - 1);
        var end = Math.Min(TotalPages - 1, current + 1);

        if (start > 2) pages.Add(0);
        for (var p = start; p <= end; p++) pages.Add(p);
        if (end < TotalPages - 1) pages.Add(0);
        if (TotalPages > 1) pages.Add(TotalPages);

        return pages;
    }

    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode _anatomy = new CompositionNode("BzPagination",
        new CompositionNode("BzPaginationContent",
            new CompositionNode("BzPaginationItem",
                new CompositionNode("BzPaginationFirst")),
            new CompositionNode("BzPaginationItem",
                new CompositionNode("BzPaginationPrevious")),
            new CompositionNode("BzPaginationItem",
                new CompositionNode("BzPaginationLink")),
            new CompositionNode("BzPaginationItem",
                new CompositionNode("BzPaginationEllipsis")),
            new CompositionNode("BzPaginationItem",
                new CompositionNode("BzPaginationNext")),
            new CompositionNode("BzPaginationItem",
                new CompositionNode("BzPaginationLast"))));

    private const string UsageSetup = """
        @* _Imports.razor (or the top of the page) *@
        @using Blazeo.Ui
        """;

    private const string UsageMarkup = """
        @* Href renders <a> for URL paging; pass OnClick instead to page in place. Give Href a
           base-relative path ("products?page=2"), not a bare "?page=2" - a query-only href resolves
           against <base> and jumps to the site root. *@
        <BzPagination>
            <BzPaginationContent>
                <BzPaginationItem><BzPaginationPrevious Href="products?page=1" /></BzPaginationItem>
                <BzPaginationItem><BzPaginationLink Href="products?page=1">1</BzPaginationLink></BzPaginationItem>
                <BzPaginationItem><BzPaginationLink Href="products?page=2" Active>2</BzPaginationLink></BzPaginationItem>
                <BzPaginationItem><BzPaginationLink Href="products?page=3">3</BzPaginationLink></BzPaginationItem>
                <BzPaginationItem><BzPaginationEllipsis /></BzPaginationItem>
                <BzPaginationItem><BzPaginationNext Href="products?page=3" /></BzPaginationItem>
            </BzPaginationContent>
        </BzPagination>
        """;

    private const string RenderAsCode = """
        @* RenderAs puts each link on a NavLink so the router drives navigation + active state. The href
           is base-relative (a path, not a bare "?page=N"): a query-only href resolves against <base>
           and would jump to the site root. *@
        <BzPagination>
            <BzPaginationContent>
                <BzPaginationItem>
                    <BzPaginationLink>
                        <RenderAs Context="p"><NavLink href="components/pagination?page=1" @attributes="p.Attributes">1</NavLink></RenderAs>
                    </BzPaginationLink>
                </BzPaginationItem>
                <BzPaginationItem>
                    <BzPaginationLink Active="true">
                        <RenderAs Context="p"><NavLink href="components/pagination?page=2" @attributes="p.Attributes">2</NavLink></RenderAs>
                    </BzPaginationLink>
                </BzPaginationItem>
            </BzPaginationContent>
        </BzPagination>
        """;

    private const string DefaultCode = """
        @* OnClick pages in place; swap to Href (e.g. Href="products?page=2") for URL paging. *@
        <BzPagination>
            <BzPaginationContent>
                <BzPaginationItem>
                    <BzPaginationPrevious Disabled="@(_page == 1)" OnClick="@(() => GoTo(_page - 1))" />
                </BzPaginationItem>
                @foreach (var token in PageTokens())
                {
                    <BzPaginationItem>
                        @if (token == 0)
                        {
                            <BzPaginationEllipsis />
                        }
                        else
                        {
                            <BzPaginationLink Active="@(token == _page)" OnClick="@(() => GoTo(token))">@token</BzPaginationLink>
                        }
                    </BzPaginationItem>
                }
                <BzPaginationItem>
                    <BzPaginationNext Disabled="@(_page == TotalPages)" OnClick="@(() => GoTo(_page + 1))" />
                </BzPaginationItem>
            </BzPaginationContent>
        </BzPagination>

        @code {
            private int _page = 2;
            private const int TotalPages = 10;
            private void GoTo(int page) => _page = Math.Clamp(page, 1, TotalPages);

            // 1, last, and a window around the current page; 0 = ellipsis.
            private IEnumerable<int> PageTokens()
            {
                var pages = new List<int> { 1 };
                var start = Math.Max(2, _page - 1);
                var end = Math.Min(TotalPages - 1, _page + 1);
                if (start > 2) pages.Add(0);
                for (var p = start; p <= end; p++) pages.Add(p);
                if (end < TotalPages - 1) pages.Add(0);
                if (TotalPages > 1) pages.Add(TotalPages);
                return pages;
            }
        }
        """;

    private const string SimpleCode = """
        <BzPagination>
            <BzPaginationContent>
                <BzPaginationItem><BzPaginationPrevious Disabled="@(_page == 1)" OnClick="@(() => GoTo(_page - 1))" /></BzPaginationItem>
                <BzPaginationItem><BzPaginationNext Disabled="@(_page == Total)" OnClick="@(() => GoTo(_page + 1))" /></BzPaginationItem>
            </BzPaginationContent>
        </BzPagination>
        <p>Page @_page of @Total</p>

        @code {
            private int _page = 2;
            private const int Total = 10;
            private void GoTo(int page) => _page = Math.Clamp(page, 1, Total);
        }
        """;

    private const string IconsOnlyCode = """
        @* Previous/Next are just chevron icons - a PaginationLink with an icon child renders a square
           button. Keep an AriaLabel so each control is still announced. *@
        <BzPagination>
            <BzPaginationContent>
                <BzPaginationItem>
                    <BzPaginationLink Disabled="@(_page == 1)" OnClick="@(() => _page -= 1)" AriaLabel="Go to previous page"><BzIcon Icon="@Icons.Outline.ChevronLeft" /></BzPaginationLink>
                </BzPaginationItem>
                <BzPaginationItem><BzPaginationLink Active="@(_page == 1)" OnClick="@(() => _page = 1)">1</BzPaginationLink></BzPaginationItem>
                <BzPaginationItem><BzPaginationLink Active="@(_page == 2)" OnClick="@(() => _page = 2)">2</BzPaginationLink></BzPaginationItem>
                <BzPaginationItem><BzPaginationLink Active="@(_page == 3)" OnClick="@(() => _page = 3)">3</BzPaginationLink></BzPaginationItem>
                <BzPaginationItem>
                    <BzPaginationLink Disabled="@(_page == 3)" OnClick="@(() => _page += 1)" AriaLabel="Go to next page"><BzIcon Icon="@Icons.Outline.ChevronRight" /></BzPaginationLink>
                </BzPaginationItem>
            </BzPaginationContent>
        </BzPagination>

        @code { private int _page = 2; }
        """;

    private const string ControlledCode = """
        <BzPagination>
            <BzPaginationContent>
                <BzPaginationItem>
                    <BzPaginationPrevious Disabled="@(_page == 1)" OnClick="@(() => GoTo(_page - 1))" />
                </BzPaginationItem>
                @foreach (var token in PageTokens())
                {
                    <BzPaginationItem>
                        @if (token == 0)
                        {
                            <BzPaginationEllipsis />
                        }
                        else
                        {
                            <BzPaginationLink Active="@(token == _page)" OnClick="@(() => GoTo(token))">@token</BzPaginationLink>
                        }
                    </BzPaginationItem>
                }
                <BzPaginationItem>
                    <BzPaginationNext Disabled="@(_page == TotalPages)" OnClick="@(() => GoTo(_page + 1))" />
                </BzPaginationItem>
            </BzPaginationContent>
        </BzPagination>

        @code {
            private int _page = 3;
            private const int TotalPages = 10;
            private void GoTo(int page) => _page = Math.Clamp(page, 1, TotalPages);

            // 1, last, and a window around the current page; 0 = ellipsis.
            private IEnumerable<int> PageTokens()
            {
                var pages = new List<int> { 1 };
                var start = Math.Max(2, _page - 1);
                var end = Math.Min(TotalPages - 1, _page + 1);
                if (start > 2) pages.Add(0);
                for (var p = start; p <= end; p++) pages.Add(p);
                if (end < TotalPages - 1) pages.Add(0);
                if (TotalPages > 1) pages.Add(TotalPages);
                return pages;
            }
        }
        """;

    private const string FirstLastCode = """
        <BzPagination>
            <BzPaginationContent>
                <BzPaginationItem><BzPaginationFirst Disabled="@(_page == 1)" OnClick="@(() => GoTo(1))" /></BzPaginationItem>
                <BzPaginationItem><BzPaginationPrevious Disabled="@(_page == 1)" OnClick="@(() => GoTo(_page - 1))" /></BzPaginationItem>
                @foreach (var token in PageTokens())
                {
                    <BzPaginationItem>
                        @if (token == 0)
                        {
                            <BzPaginationEllipsis />
                        }
                        else
                        {
                            <BzPaginationLink Active="@(token == _page)" OnClick="@(() => GoTo(token))">@token</BzPaginationLink>
                        }
                    </BzPaginationItem>
                }
                <BzPaginationItem><BzPaginationNext Disabled="@(_page == TotalPages)" OnClick="@(() => GoTo(_page + 1))" /></BzPaginationItem>
                <BzPaginationItem><BzPaginationLast Disabled="@(_page == TotalPages)" OnClick="@(() => GoTo(TotalPages))" /></BzPaginationItem>
            </BzPaginationContent>
        </BzPagination>

        @code {
            private int _page = 1;
            private const int TotalPages = 10;
            private void GoTo(int page) => _page = Math.Clamp(page, 1, TotalPages);

            // 1, last, and a window around the current page; 0 = ellipsis.
            private IEnumerable<int> PageTokens()
            {
                var pages = new List<int> { 1 };
                var start = Math.Max(2, _page - 1);
                var end = Math.Min(TotalPages - 1, _page + 1);
                if (start > 2) pages.Add(0);
                for (var p = start; p <= end; p++) pages.Add(p);
                if (end < TotalPages - 1) pages.Add(0);
                if (TotalPages > 1) pages.Add(TotalPages);
                return pages;
            }
        }
        """;

    private const string RowsPerPageCode = """
        <div class="flex w-full flex-col items-center gap-4 sm:flex-row sm:justify-between">
            <div class="flex items-center gap-2">
                <span class="text-sm font-medium">Rows per page</span>
                <BzSelect Value="@_size" ValueChanged="OnSizeChanged">
                    <BzSelectTrigger Size="SelectTriggerSize.Sm" Class="w-[4.5rem]">
                        <BzSelectValue />
                    </BzSelectTrigger>
                    <BzSelectContent Position="SelectPosition.ItemAligned">
                        <BzSelectItem Value="10">10</BzSelectItem>
                        <BzSelectItem Value="20">20</BzSelectItem>
                        <BzSelectItem Value="30">30</BzSelectItem>
                        <BzSelectItem Value="50">50</BzSelectItem>
                    </BzSelectContent>
                </BzSelect>
            </div>
            <div class="flex items-center gap-4">
                <span class="text-sm font-medium">Page @_page of @Pages</span>
                <BzPagination Class="mx-0 w-auto">
                    <BzPaginationContent>
                        <BzPaginationItem>
                            <BzPaginationPrevious Disabled="@(_page == 1)" OnClick="@(() => GoTo(_page - 1))" />
                        </BzPaginationItem>
                        <BzPaginationItem>
                            <BzPaginationNext Disabled="@(_page == Pages)" OnClick="@(() => GoTo(_page + 1))" />
                        </BzPaginationItem>
                    </BzPaginationContent>
                </BzPagination>
            </div>
        </div>

        @code {
            private const int Total = 100;
            private string _size = "10";
            private int _page = 1;
            private int Pages => (int)Math.Ceiling(Total / (double)int.Parse(_size));

            // Changing the page size returns to the first page so the indicator stays valid.
            private void OnSizeChanged(string? value)
            {
                _size = value ?? "10";
                _page = 1;
            }

            private void GoTo(int page) => _page = Math.Clamp(page, 1, Pages);
        }
        """;

