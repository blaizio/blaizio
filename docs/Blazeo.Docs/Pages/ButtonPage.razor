@page "/components/button"
<PageTitle>Button - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Button</h1>
        <p class="text-muted-foreground">Triggers an action. Six variants, several sizes, and <code class="rounded bg-muted px-1 text-xs">RenderAs</code> for polymorphism.</p>
    </header>

    <UsageBlock Setup="@UsageSetup" Code="@UsageMarkup" />

    <ExamplesHeading />

    <Demo Title="Variants" Code="@VariantsCode">
        <div class="flex flex-wrap items-center gap-3">
            <BzButton>Default</BzButton>
            <BzButton Variant="ButtonVariant.Secondary">Secondary</BzButton>
            <BzButton Variant="ButtonVariant.Destructive">Destructive</BzButton>
            <BzButton Variant="ButtonVariant.Outline">Outline</BzButton>
            <BzButton Variant="ButtonVariant.Ghost">Ghost</BzButton>
            <BzButton Variant="ButtonVariant.Link">Link</BzButton>
        </div>
    </Demo>

    <Demo Title="Sizes" Description="Use the Size prop to change the height and padding." Code="@SizesCode">
        <div class="flex flex-wrap items-center gap-3">
            <BzButton Size="ButtonSize.Xs">Extra Small</BzButton>
            <BzButton Size="ButtonSize.Sm">Small</BzButton>
            <BzButton>Default</BzButton>
            <BzButton Size="ButtonSize.Lg">Large</BzButton>
        </div>
    </Demo>

    <Demo Title="Icon" Description="Square, icon-only buttons. Always give them an aria-label." Code="@IconOnlyCode">
        <div class="flex flex-wrap items-center gap-3">
            <BzButton Size="ButtonSize.Icon" aria-label="Add"><BzIcon Icon="@Icons.Outline.Plus" /></BzButton>
            <BzButton Size="ButtonSize.Icon" Variant="ButtonVariant.Secondary" aria-label="Add"><BzIcon Icon="@Icons.Outline.Plus" /></BzButton>
            <BzButton Size="ButtonSize.Icon" Variant="ButtonVariant.Outline" aria-label="Add"><BzIcon Icon="@Icons.Outline.Plus" /></BzButton>
            <BzButton Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" aria-label="Add"><BzIcon Icon="@Icons.Outline.Plus" /></BzButton>
        </div>
    </Demo>

    <Demo Title="With icon"
          Description="Mark edge icons with data-icon so the style tightens the padding on that side."
          Code="@WithIconCode">
        <div class="flex flex-wrap items-center gap-3">
            <BzButton><BzIcon Icon="@Icons.Outline.Plus" data-icon="inline-start" /> New</BzButton>
            <BzButton Variant="ButtonVariant.Outline">Continue <BzIcon Icon="@Icons.Outline.ArrowRight" data-icon="inline-end" /></BzButton>
        </div>
    </Demo>

    <Demo Title="Rounded" Description="Use the rounded-full class for a pill button." Code="@RoundedCode">
        <div class="flex flex-wrap items-center gap-3">
            <BzButton Class="rounded-full">Button</BzButton>
            <BzButton Class="rounded-full" Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" aria-label="Add"><BzIcon Icon="@Icons.Outline.Plus" /></BzButton>
        </div>
    </Demo>

    <Demo Title="Loading" Description="Show a spinner and disable the button while busy." Code="@LoadingCode">
        <div class="flex flex-wrap items-center gap-3">
            <BzButton Disabled><BzIcon Icon="@Icons.Outline.Loader2" Class="animate-spin" data-icon="inline-start" /> Generating</BzButton>
            <BzButton Variant="ButtonVariant.Outline" Disabled><BzIcon Icon="@Icons.Outline.Loader2" Class="animate-spin" data-icon="inline-start" /> Downloading</BzButton>
        </div>
    </Demo>

    <Demo Title="Button group" Description="Adjacent buttons with merged borders." Code="@GroupCode">
        <div class="inline-flex -space-x-px rounded-md shadow-sm [&>button:first-child]:rounded-l-md [&>button:last-child]:rounded-r-md [&>button]:rounded-none">
            <BzButton Variant="ButtonVariant.Outline">Archive</BzButton>
            <BzButton Variant="ButtonVariant.Outline">Report</BzButton>
            <BzButton Variant="ButtonVariant.Outline">Snooze</BzButton>
        </div>
    </Demo>

    <Demo Title="Disabled" Code="@DisabledCode">
        <div class="flex flex-wrap items-center gap-3">
            <BzButton Disabled>Disabled</BzButton>
            <BzButton Variant="ButtonVariant.Outline" Disabled>Disabled</BzButton>
        </div>
    </Demo>

    <Demo Title="Custom element (RenderAs)"
          Description="Render the button styling onto your own element instead of a <button> - e.g. an anchor."
          Code="@RenderAsCode">
        <div class="flex flex-wrap items-center gap-3">
            <BzButton Variant="ButtonVariant.Outline">
                <RenderAs Context="p">
                    <a href="#" @attributes="p.Attributes">I'm an &lt;a&gt;, styled as a button</a>
                </RenderAs>
            </BzButton>
            <BzButton Variant="ButtonVariant.Link">
                <RenderAs Context="p">
                    <a href="#" @attributes="p.Attributes">...or as a link</a>
                </RenderAs>
            </BzButton>
        </div>
    </Demo>
    <Demo Title="Customization"
          Description="Pass your own classes via Class - brand colors, gradients, tints, or width - merged over the variant defaults."
          Code="@CustomCode">
        <div class="flex flex-wrap items-center gap-3">
            <BzButton Class="bg-indigo-600 text-white hover:bg-indigo-700">Brand color</BzButton>
            <BzButton Class="bg-gradient-to-r from-fuchsia-600 to-violet-600 text-white hover:opacity-90">Gradient</BzButton>
            <BzButton Variant="ButtonVariant.Ghost" Class="bg-emerald-500/10 text-emerald-600 hover:bg-emerald-500/20 dark:text-emerald-400">Tinted</BzButton>
            <BzButton Class="w-48">Full width</BzButton>
        </div>
    </Demo>
    <Demo Title="RTL"
          Description="Wrapped in a DirectionProvider with Arabic copy - the data-icon edge icons flip to the mirrored side."
          Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <div class="flex flex-wrap items-center gap-3">
                <BzButton><BzIcon Icon="@Icons.Outline.Plus" data-icon="inline-start" /> جديد</BzButton>
                <BzButton Variant="ButtonVariant.Outline">متابعة <BzIcon Icon="@Icons.Outline.ArrowLeft" data-icon="inline-end" /></BzButton>
            </div>
        </BzDirectionProvider>
    </Demo>
    <ApiReference Types="ApiFamilies.Button" />
</div>

@code {
