@page "/components/button"
<PageTitle>Button - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Button</h1>
        <p class="text-muted-foreground">Triggers an action. Six variants, several sizes, and <code class="rounded bg-muted px-1 text-xs">AsChild</code> for polymorphism.</p>
    </header>

    <Demo Title="Variants" Code="@VariantsCode">
        <div class="flex flex-wrap items-center gap-3">
            <Button>Default</Button>
            <Button Variant="ButtonVariant.Secondary">Secondary</Button>
            <Button Variant="ButtonVariant.Destructive">Destructive</Button>
            <Button Variant="ButtonVariant.Outline">Outline</Button>
            <Button Variant="ButtonVariant.Ghost">Ghost</Button>
            <Button Variant="ButtonVariant.Link">Link</Button>
        </div>
    </Demo>

    <Demo Title="Sizes" Description="Use the Size prop to change the height and padding." Code="@SizesCode">
        <div class="flex flex-wrap items-center gap-3">
            <Button Size="ButtonSize.Xs">Extra Small</Button>
            <Button Size="ButtonSize.Sm">Small</Button>
            <Button>Default</Button>
            <Button Size="ButtonSize.Lg">Large</Button>
        </div>
    </Demo>

    <Demo Title="Icon" Description="Square, icon-only buttons. Always give them an aria-label." Code="@IconOnlyCode">
        <div class="flex flex-wrap items-center gap-3">
            <Button Size="ButtonSize.Icon" aria-label="Add"><BzIcon Icon="@Icons.Outline.Plus" /></Button>
            <Button Size="ButtonSize.Icon" Variant="ButtonVariant.Secondary" aria-label="Add"><BzIcon Icon="@Icons.Outline.Plus" /></Button>
            <Button Size="ButtonSize.Icon" Variant="ButtonVariant.Outline" aria-label="Add"><BzIcon Icon="@Icons.Outline.Plus" /></Button>
            <Button Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" aria-label="Add"><BzIcon Icon="@Icons.Outline.Plus" /></Button>
        </div>
    </Demo>

    <Demo Title="With icon"
          Description="Mark edge icons with data-icon so the style tightens the padding on that side."
          Code="@WithIconCode">
        <div class="flex flex-wrap items-center gap-3">
            <Button><BzIcon Icon="@Icons.Outline.Plus" data-icon="inline-start" /> New</Button>
            <Button Variant="ButtonVariant.Outline">Continue <BzIcon Icon="@Icons.Outline.ArrowRight" data-icon="inline-end" /></Button>
        </div>
    </Demo>

    <Demo Title="Rounded" Description="Use the rounded-full class for a pill button." Code="@RoundedCode">
        <div class="flex flex-wrap items-center gap-3">
            <Button Class="rounded-full">Button</Button>
            <Button Class="rounded-full" Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" aria-label="Add"><BzIcon Icon="@Icons.Outline.Plus" /></Button>
        </div>
    </Demo>

    <Demo Title="Loading" Description="Show a spinner and disable the button while busy." Code="@LoadingCode">
        <div class="flex flex-wrap items-center gap-3">
            <Button Disabled><BzIcon Icon="@Icons.Outline.Loader2" Class="animate-spin" data-icon="inline-start" /> Generating</Button>
            <Button Variant="ButtonVariant.Outline" Disabled><BzIcon Icon="@Icons.Outline.Loader2" Class="animate-spin" data-icon="inline-start" /> Downloading</Button>
        </div>
    </Demo>

    <Demo Title="Button group" Description="Adjacent buttons with merged borders." Code="@GroupCode">
        <div class="inline-flex -space-x-px rounded-md shadow-sm [&>button:first-child]:rounded-l-md [&>button:last-child]:rounded-r-md [&>button]:rounded-none">
            <Button Variant="ButtonVariant.Outline">Archive</Button>
            <Button Variant="ButtonVariant.Outline">Report</Button>
            <Button Variant="ButtonVariant.Outline">Snooze</Button>
        </div>
    </Demo>

    <Demo Title="Disabled" Code="@DisabledCode">
        <div class="flex flex-wrap items-center gap-3">
            <Button Disabled>Disabled</Button>
            <Button Variant="ButtonVariant.Outline" Disabled>Disabled</Button>
        </div>
    </Demo>

    <Demo Title="As child"
          Description="Render the button styling onto your own element instead of a <button> - e.g. an anchor."
          Code="@AsChildCode">
        <div class="flex flex-wrap items-center gap-3">
            <Button Variant="ButtonVariant.Outline">
                <AsChild Context="p">
                    <a href="#" @attributes="p.Attributes">I'm an &lt;a&gt;, styled as a button</a>
                </AsChild>
            </Button>
            <Button Variant="ButtonVariant.Link">
                <AsChild Context="p">
                    <a href="#" @attributes="p.Attributes">...or as a link</a>
                </AsChild>
            </Button>
        </div>
    </Demo>
    <ApiReference Types="ApiFamilies.Button" />
</div>

@code {
    private const string VariantsCode = """
        <Button>Default</Button>
        <Button Variant="ButtonVariant.Secondary">Secondary</Button>
        <Button Variant="ButtonVariant.Destructive">Destructive</Button>
        <Button Variant="ButtonVariant.Outline">Outline</Button>
        <Button Variant="ButtonVariant.Ghost">Ghost</Button>
        <Button Variant="ButtonVariant.Link">Link</Button>
        """;

    private const string SizesCode = """
        <Button Size="ButtonSize.Xs">Extra Small</Button>
        <Button Size="ButtonSize.Sm">Small</Button>
        <Button>Default</Button>
        <Button Size="ButtonSize.Lg">Large</Button>
