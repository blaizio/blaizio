@page "/components/tabs"
<PageTitle>Tabs — Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Tabs</h1>
        <p class="text-muted-foreground">Layered panels, one visible at a time. Arrow keys move between tabs.</p>
    </header>

    <Demo Title="Default" Description="The filled pill strip; arrowing also activates (selection follows focus)." Code="@DefaultCode">
        <Tabs DefaultValue="account" Class="w-full max-w-sm">
            <TabsList>
                <TabsTrigger Value="account">Account</TabsTrigger>
                <TabsTrigger Value="password">Password</TabsTrigger>
            </TabsList>
            <TabsContent Value="account">
                <Card>
                    <CardHeader>
                        <CardTitle>Account</CardTitle>
                        <CardDescription>Make changes to your account here.</CardDescription>
                    </CardHeader>
                    <CardContent>
                        <p class="text-sm text-muted-foreground">Your account settings live here.</p>
                    </CardContent>
                </Card>
            </TabsContent>
            <TabsContent Value="password">
                <Card>
                    <CardHeader>
                        <CardTitle>Password</CardTitle>
                        <CardDescription>Change your password here.</CardDescription>
                    </CardHeader>
                    <CardContent>
                        <p class="text-sm text-muted-foreground">Password settings live here.</p>
                    </CardContent>
                </Card>
            </TabsContent>
        </Tabs>
    </Demo>

    <Demo Title="Line" Description="The transparent strip — the active tab gets an underline." Code="@LineCode">
        <Tabs DefaultValue="overview" Class="w-full max-w-sm">
            <TabsList Variant="TabsListVariant.Line">
                <TabsTrigger Value="overview">Overview</TabsTrigger>
                <TabsTrigger Value="analytics">Analytics</TabsTrigger>
                <TabsTrigger Value="reports">Reports</TabsTrigger>
            </TabsList>
            <TabsContent Value="overview"><p class="p-2 text-sm text-muted-foreground">A bird's-eye view of the project.</p></TabsContent>
            <TabsContent Value="analytics"><p class="p-2 text-sm text-muted-foreground">Charts and numbers.</p></TabsContent>
            <TabsContent Value="reports"><p class="p-2 text-sm text-muted-foreground">Exports and summaries.</p></TabsContent>
        </Tabs>
    </Demo>

    <Demo Title="Vertical" Description="Orientation Vertical puts the list beside the content; Up/Down arrows navigate." Code="@VerticalCode">
        <Tabs DefaultValue="general" Orientation="Orientation.Vertical" Class="w-full max-w-md">
            <TabsList Variant="TabsListVariant.Line">
                <TabsTrigger Value="general">General</TabsTrigger>
                <TabsTrigger Value="privacy">Privacy</TabsTrigger>
                <TabsTrigger Value="advanced">Advanced</TabsTrigger>
            </TabsList>
            <TabsContent Value="general"><p class="p-2 text-sm text-muted-foreground">General settings.</p></TabsContent>
            <TabsContent Value="privacy"><p class="p-2 text-sm text-muted-foreground">Privacy settings.</p></TabsContent>
            <TabsContent Value="advanced"><p class="p-2 text-sm text-muted-foreground">Advanced settings.</p></TabsContent>
        </Tabs>
    </Demo>

    <Demo Title="Disabled tab" Code="@DisabledCode">
        <Tabs DefaultValue="active" Class="w-full max-w-sm">
            <TabsList>
                <TabsTrigger Value="active">Active</TabsTrigger>
                <TabsTrigger Value="archived" Disabled>Archived</TabsTrigger>
            </TabsList>
            <TabsContent Value="active"><p class="p-2 text-sm text-muted-foreground">Only this tab is reachable.</p></TabsContent>
        </Tabs>
    </Demo>

    <Demo Title="Controlled" Description="Bind the value two-way; the label reacts to it." Code="@ControlledCode">
        <div class="flex w-full max-w-sm flex-col items-center gap-3">
            <Tabs @bind-Value="_tab" Class="w-full">
                <TabsList>
                    <TabsTrigger Value="one">One</TabsTrigger>
                    <TabsTrigger Value="two">Two</TabsTrigger>
                </TabsList>
                <TabsContent Value="one"><p class="p-2 text-sm text-muted-foreground">First panel.</p></TabsContent>
                <TabsContent Value="two"><p class="p-2 text-sm text-muted-foreground">Second panel.</p></TabsContent>
            </Tabs>
            <p class="text-sm text-muted-foreground">Selected: <span class="font-mono">@_tab</span></p>
        </div>
    </Demo>
</div>

@code {
    private string? _tab = "one";

    private const string DefaultCode = """
        <Tabs DefaultValue="account">
            <TabsList>
                <TabsTrigger Value="account">Account</TabsTrigger>
                <TabsTrigger Value="password">Password</TabsTrigger>
            </TabsList>
            <TabsContent Value="account">…</TabsContent>
            <TabsContent Value="password">…</TabsContent>
        </Tabs>
        """;

    private const string LineCode = """
        <Tabs DefaultValue="overview">
            <TabsList Variant="TabsListVariant.Line">
                <TabsTrigger Value="overview">Overview</TabsTrigger>
                <TabsTrigger Value="analytics">Analytics</TabsTrigger>
                <TabsTrigger Value="reports">Reports</TabsTrigger>
            </TabsList>
            <TabsContent Value="overview">…</TabsContent>
        </Tabs>
        """;

    private const string VerticalCode = """
        <Tabs DefaultValue="general" Orientation="Orientation.Vertical">
            <TabsList Variant="TabsListVariant.Line">
                <TabsTrigger Value="general">General</TabsTrigger>
                <TabsTrigger Value="privacy">Privacy</TabsTrigger>
            </TabsList>
            <TabsContent Value="general">…</TabsContent>
        </Tabs>
        """;

    private const string DisabledCode = """
        <TabsList>
            <TabsTrigger Value="active">Active</TabsTrigger>
            <TabsTrigger Value="archived" Disabled>Archived</TabsTrigger>
        </TabsList>
        """;

    private const string ControlledCode = """
        <Tabs @bind-Value="_tab">
            <TabsList>
                <TabsTrigger Value="one">One</TabsTrigger>
                <TabsTrigger Value="two">Two</TabsTrigger>
            </TabsList>
            <TabsContent Value="one">…</TabsContent>
            <TabsContent Value="two">…</TabsContent>
        </Tabs>

        @code { private string? _tab = "one"; }
        """;
}
