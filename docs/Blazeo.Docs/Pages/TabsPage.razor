@page "/components/tabs"
<PageTitle>Tabs - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Tabs</h1>
        <p class="text-muted-foreground">Layered panels, one visible at a time. Arrow keys move between tabs.</p>
    </header>

    <Demo Title="Default" Description="The filled pill strip; arrowing also activates (selection follows focus)." Code="@DefaultCode">
        <BzTabs DefaultValue="account" Class="w-full max-w-sm">
            <BzTabsList>
                <BzTabsTrigger Value="account">Account</BzTabsTrigger>
                <BzTabsTrigger Value="password">Password</BzTabsTrigger>
            </BzTabsList>
            <BzTabsContent Value="account">
                <BzCard>
                    <BzCardHeader>
                        <BzCardTitle>Account</BzCardTitle>
                        <BzCardDescription>Make changes to your account here.</BzCardDescription>
                    </BzCardHeader>
                    <BzCardContent>
                        <p class="text-sm text-muted-foreground">Your account settings live here.</p>
                    </BzCardContent>
                </BzCard>
            </BzTabsContent>
            <BzTabsContent Value="password">
                <BzCard>
                    <BzCardHeader>
                        <BzCardTitle>Password</BzCardTitle>
                        <BzCardDescription>Change your password here.</BzCardDescription>
                    </BzCardHeader>
                    <BzCardContent>
                        <p class="text-sm text-muted-foreground">Password settings live here.</p>
                    </BzCardContent>
                </BzCard>
            </BzTabsContent>
        </BzTabs>
    </Demo>

    <Demo Title="Line" Description="The transparent strip - the active tab gets an underline." Code="@LineCode">
        <BzTabs DefaultValue="overview" Class="w-full max-w-sm">
            <BzTabsList Variant="TabsListVariant.Line">
                <BzTabsTrigger Value="overview">Overview</BzTabsTrigger>
                <BzTabsTrigger Value="analytics">Analytics</BzTabsTrigger>
                <BzTabsTrigger Value="reports">Reports</BzTabsTrigger>
            </BzTabsList>
            <BzTabsContent Value="overview"><p class="p-2 text-sm text-muted-foreground">A bird's-eye view of the project.</p></BzTabsContent>
            <BzTabsContent Value="analytics"><p class="p-2 text-sm text-muted-foreground">Charts and numbers.</p></BzTabsContent>
            <BzTabsContent Value="reports"><p class="p-2 text-sm text-muted-foreground">Exports and summaries.</p></BzTabsContent>
        </BzTabs>
    </Demo>

    <Demo Title="Vertical" Description="Orientation Vertical puts the list beside the content; Up/Down arrows navigate." Code="@VerticalCode">
        <BzTabs DefaultValue="general" Orientation="Orientation.Vertical" Class="w-full max-w-md">
            <BzTabsList Variant="TabsListVariant.Line">
                <BzTabsTrigger Value="general">General</BzTabsTrigger>
                <BzTabsTrigger Value="privacy">Privacy</BzTabsTrigger>
                <BzTabsTrigger Value="advanced">Advanced</BzTabsTrigger>
            </BzTabsList>
            <BzTabsContent Value="general"><p class="p-2 text-sm text-muted-foreground">General settings.</p></BzTabsContent>
            <BzTabsContent Value="privacy"><p class="p-2 text-sm text-muted-foreground">Privacy settings.</p></BzTabsContent>
            <BzTabsContent Value="advanced"><p class="p-2 text-sm text-muted-foreground">Advanced settings.</p></BzTabsContent>
        </BzTabs>
    </Demo>

    <Demo Title="Disabled tab" Code="@DisabledCode">
        <BzTabs DefaultValue="active" Class="w-full max-w-sm">
            <BzTabsList>
                <BzTabsTrigger Value="active">Active</BzTabsTrigger>
                <BzTabsTrigger Value="archived" Disabled>Archived</BzTabsTrigger>
            </BzTabsList>
            <BzTabsContent Value="active"><p class="p-2 text-sm text-muted-foreground">Only this tab is reachable.</p></BzTabsContent>
        </BzTabs>
    </Demo>

    <Demo Title="Controlled" Description="Bind the value two-way; the label reacts to it." Code="@ControlledCode">
        <div class="flex w-full max-w-sm flex-col items-center gap-3">
            <BzTabs @bind-Value="_tab" Class="w-full">
                <BzTabsList>
                    <BzTabsTrigger Value="one">One</BzTabsTrigger>
                    <BzTabsTrigger Value="two">Two</BzTabsTrigger>
                </BzTabsList>
                <BzTabsContent Value="one"><p class="p-2 text-sm text-muted-foreground">First panel.</p></BzTabsContent>
                <BzTabsContent Value="two"><p class="p-2 text-sm text-muted-foreground">Second panel.</p></BzTabsContent>
            </BzTabs>
            <p class="text-sm text-muted-foreground">Selected: <span class="font-mono">@_tab</span></p>
        </div>
    </Demo>
    <Demo Title="Looping" Description="Arrow keys wrap from the last tab back to the first by default. Set Loop to false on the TabsList to stop at the ends instead. Focus a tab and hold the arrow key to feel the difference." Code="@LoopCode">
        <div class="flex flex-col gap-8 sm:flex-row sm:gap-12">
            <div class="space-y-2">
                <p class="text-sm font-medium">Loops (default)</p>
                <BzTabs DefaultValue="a" Class="w-full max-w-xs">
                    <BzTabsList>
                        <BzTabsTrigger Value="a">First</BzTabsTrigger>
                        <BzTabsTrigger Value="b">Second</BzTabsTrigger>
                        <BzTabsTrigger Value="c">Third</BzTabsTrigger>
                    </BzTabsList>
                    <BzTabsContent Value="a"><p class="p-2 text-sm text-muted-foreground">Past the last tab returns to the first.</p></BzTabsContent>
                    <BzTabsContent Value="b"><p class="p-2 text-sm text-muted-foreground">Second panel.</p></BzTabsContent>
                    <BzTabsContent Value="c"><p class="p-2 text-sm text-muted-foreground">Third panel.</p></BzTabsContent>
                </BzTabs>
            </div>
            <div class="space-y-2">
                <p class="text-sm font-medium">Stops (Loop = false)</p>
                <BzTabs DefaultValue="a" Class="w-full max-w-xs">
                    <BzTabsList Loop="false">
                        <BzTabsTrigger Value="a">First</BzTabsTrigger>
                        <BzTabsTrigger Value="b">Second</BzTabsTrigger>
                        <BzTabsTrigger Value="c">Third</BzTabsTrigger>
                    </BzTabsList>
                    <BzTabsContent Value="a"><p class="p-2 text-sm text-muted-foreground">The last tab is the end of the line.</p></BzTabsContent>
                    <BzTabsContent Value="b"><p class="p-2 text-sm text-muted-foreground">Second panel.</p></BzTabsContent>
                    <BzTabsContent Value="c"><p class="p-2 text-sm text-muted-foreground">Third panel.</p></BzTabsContent>
                </BzTabs>
            </div>
        </div>
    </Demo>
    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the active underline and arrow-key navigation mirror to the right." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzTabs DefaultValue="overview" Class="w-full max-w-sm">
                <BzTabsList Variant="TabsListVariant.Line">
                    <BzTabsTrigger Value="overview">نظرة عامة</BzTabsTrigger>
                    <BzTabsTrigger Value="analytics">التحليلات</BzTabsTrigger>
                    <BzTabsTrigger Value="reports">التقارير</BzTabsTrigger>
                </BzTabsList>
                <BzTabsContent Value="overview"><p class="p-2 text-sm text-muted-foreground">نظرة شاملة على المشروع.</p></BzTabsContent>
                <BzTabsContent Value="analytics"><p class="p-2 text-sm text-muted-foreground">الرسوم البيانية والأرقام.</p></BzTabsContent>
                <BzTabsContent Value="reports"><p class="p-2 text-sm text-muted-foreground">التصدير والملخّصات.</p></BzTabsContent>
            </BzTabs>
        </BzDirectionProvider>
    </Demo>
    <ApiReference Types="ApiFamilies.Tabs" />
</div>

@code {
    private string? _tab = "one";

    private const string DefaultCode = """
        <BzTabs DefaultValue="account">
            <BzTabsList>
                <BzTabsTrigger Value="account">Account</BzTabsTrigger>
                <BzTabsTrigger Value="password">Password</BzTabsTrigger>
            </BzTabsList>
            <BzTabsContent Value="account">…</BzTabsContent>
            <BzTabsContent Value="password">…</BzTabsContent>
        </BzTabs>
        """;

    private const string LineCode = """
        <BzTabs DefaultValue="overview">
            <BzTabsList Variant="TabsListVariant.Line">
                <BzTabsTrigger Value="overview">Overview</BzTabsTrigger>
                <BzTabsTrigger Value="analytics">Analytics</BzTabsTrigger>
                <BzTabsTrigger Value="reports">Reports</BzTabsTrigger>
            </BzTabsList>
            <BzTabsContent Value="overview">…</BzTabsContent>
        </BzTabs>
        """;

    private const string VerticalCode = """
        <BzTabs DefaultValue="general" Orientation="Orientation.Vertical">
            <BzTabsList Variant="TabsListVariant.Line">
                <BzTabsTrigger Value="general">General</BzTabsTrigger>
                <BzTabsTrigger Value="privacy">Privacy</BzTabsTrigger>
            </BzTabsList>
            <BzTabsContent Value="general">…</BzTabsContent>
        </BzTabs>
        """;

    private const string DisabledCode = """
        <BzTabsList>
            <BzTabsTrigger Value="active">Active</BzTabsTrigger>
            <BzTabsTrigger Value="archived" Disabled>Archived</BzTabsTrigger>
        </BzTabsList>
        """;

    private const string ControlledCode = """
        <BzTabs @bind-Value="_tab">
            <BzTabsList>
                <BzTabsTrigger Value="one">One</BzTabsTrigger>
                <BzTabsTrigger Value="two">Two</BzTabsTrigger>
            </BzTabsList>
            <BzTabsContent Value="one">…</BzTabsContent>
            <BzTabsContent Value="two">…</BzTabsContent>
        </BzTabs>

        @code { private string? _tab = "one"; }
        """;

    private const string LoopCode = """
        @* Wraps from the last tab back to the first (the default). *@
        <BzTabs DefaultValue="a">
            <BzTabsList>
                <BzTabsTrigger Value="a">First</BzTabsTrigger>
                <BzTabsTrigger Value="b">Second</BzTabsTrigger>
                <BzTabsTrigger Value="c">Third</BzTabsTrigger>
            </BzTabsList>
            <BzTabsContent Value="a">…</BzTabsContent>
        </BzTabs>

        @* Stops at the ends instead. *@
        <BzTabs DefaultValue="a">
            <BzTabsList Loop="false">
                <BzTabsTrigger Value="a">First</BzTabsTrigger>
                <BzTabsTrigger Value="b">Second</BzTabsTrigger>
                <BzTabsTrigger Value="c">Third</BzTabsTrigger>
            </BzTabsList>
            <BzTabsContent Value="a">…</BzTabsContent>
        </BzTabs>
        """;

    private const string RtlCode = """
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzTabs DefaultValue="overview">
                <BzTabsList Variant="TabsListVariant.Line">
                    <BzTabsTrigger Value="overview">نظرة عامة</BzTabsTrigger>
                    <BzTabsTrigger Value="analytics">التحليلات</BzTabsTrigger>
                    <BzTabsTrigger Value="reports">التقارير</BzTabsTrigger>
                </BzTabsList>
                <BzTabsContent Value="overview">…</BzTabsContent>
            </BzTabs>
        </BzDirectionProvider>
        """;
}
