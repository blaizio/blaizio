                </BzSheetHeader>
                <BzSheetFooter>
                    <BzSheetClose>
                        <AsChild Context="p"><BzButton @attributes="p.Attributes">Save changes</BzButton></AsChild>
                    </BzSheetClose>
                </BzSheetFooter>
            </BzSheetContent>
        </BzSheet>
        """;

    private const string ScrollableCode = """
        <BzSheet>
            <BzSheetTrigger>
