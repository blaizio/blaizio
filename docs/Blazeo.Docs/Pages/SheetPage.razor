@page "/components/sheet"
<PageTitle>Sheet - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Sheet</h1>
        <p class="text-muted-foreground">A panel that slides in from an edge of the screen. Built on the Dialog machinery: focus is trapped inside, page scroll locks, and Escape or a backdrop click dismisses it.</p>
    </header>

    <Demo Title="Default" Description="Slides in from the right by default." Code="@DefaultCode">
        <BzSheet>
            <BzSheetTrigger>
                <AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Edit profile</BzButton></AsChild>
            </BzSheetTrigger>
            <BzSheetContent>
                <BzSheetHeader>
                    <BzSheetTitle>Edit profile</BzSheetTitle>
                    <BzSheetDescription>Update your details. Save when you're done.</BzSheetDescription>
                </BzSheetHeader>
                <div class="grid gap-4 px-4">
                    <div class="grid gap-2">
                        <BzLabel for="sheet-name">Name</BzLabel>
                        <BzInputText id="sheet-name" Value="Ada Lovelace" />
                    </div>
                    <div class="grid gap-2">
                        <BzLabel for="sheet-email">Email</BzLabel>
                        <BzInputText id="sheet-email" Value="ada@example.com" />
                    </div>
                </div>
                <BzSheetFooter>
                    <BzSheetClose>
                        <AsChild Context="p"><BzButton @attributes="p.Attributes">Save changes</BzButton></AsChild>
                    </BzSheetClose>
                    <BzSheetClose>
                        <AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Cancel</BzButton></AsChild>
                    </BzSheetClose>
                </BzSheetFooter>
            </BzSheetContent>
        </BzSheet>
    </Demo>

    <Demo Title="Sides" Description="Anchor the sheet to any edge with Side." Code="@SidesCode">
        <div class="flex flex-wrap gap-2">
            @foreach (var side in _sides)
            {
                <BzSheet>
                    <BzSheetTrigger>
                        <AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">@side</BzButton></AsChild>
                    </BzSheetTrigger>
                    <BzSheetContent Side="@side">
                        <BzSheetHeader>
                            <BzSheetTitle>@side sheet</BzSheetTitle>
                            <BzSheetDescription>Slides in from the @(side.ToString().ToLowerInvariant()) edge.</BzSheetDescription>
                        </BzSheetHeader>
                        <BzSheetFooter>
                            <BzSheetClose>
                                <AsChild Context="p"><BzButton @attributes="p.Attributes">Done</BzButton></AsChild>
                            </BzSheetClose>
                        </BzSheetFooter>
                    </BzSheetContent>
                </BzSheet>
            }
        </div>
    </Demo>

    <Demo Title="Controlled" Description="Bind the open state two-way." Code="@ControlledCode">
        <div class="flex flex-col items-center gap-4">
            <span class="text-muted-foreground text-sm">Open: @_open</span>
            <BzSheet @bind-Open="_open">
                <BzSheetTrigger>
                    <AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Open</BzButton></AsChild>
                </BzSheetTrigger>
                <BzSheetContent>
                    <BzSheetHeader>
                        <BzSheetTitle>Controlled sheet</BzSheetTitle>
                        <BzSheetDescription>The open state lives in the page via @@bind-Open.</BzSheetDescription>
                    </BzSheetHeader>
                </BzSheetContent>
            </BzSheet>
        </div>
    </Demo>
    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the sheet slides in from the left and the content mirrors." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzSheet>
                <BzSheetTrigger>
                    <AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">تعديل الملف الشخصي</BzButton></AsChild>
                </BzSheetTrigger>
                <BzSheetContent>
                    <BzSheetHeader>
                        <BzSheetTitle>تعديل الملف الشخصي</BzSheetTitle>
                        <BzSheetDescription>حدّث بياناتك. احفظ عند الانتهاء.</BzSheetDescription>
                    </BzSheetHeader>
                    <div class="grid gap-4 px-4">
                        <div class="grid gap-2">
                            <BzLabel for="sheet-name-rtl">الاسم</BzLabel>
                            <BzInputText id="sheet-name-rtl" Value="آدا لوفلايس" />
                        </div>
                        <div class="grid gap-2">
                            <BzLabel for="sheet-email-rtl">البريد الإلكتروني</BzLabel>
                            <BzInputText id="sheet-email-rtl" Value="ada@example.com" />
                        </div>
                    </div>
                    <BzSheetFooter>
                        <BzSheetClose>
                            <AsChild Context="p"><BzButton @attributes="p.Attributes">حفظ التغييرات</BzButton></AsChild>
                        </BzSheetClose>
                        <BzSheetClose>
                            <AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">إلغاء</BzButton></AsChild>
                        </BzSheetClose>
                    </BzSheetFooter>
                </BzSheetContent>
            </BzSheet>
        </BzDirectionProvider>
    </Demo>
    <ApiReference Types="ApiFamilies.Sheet" />
</div>

@code {
    private bool _open;
    private static readonly SheetSide[] _sides = [SheetSide.Top, SheetSide.Right, SheetSide.Bottom, SheetSide.Left];

    private const string DefaultCode = """
        <BzSheet>
            <BzSheetTrigger>
                <AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Edit profile</BzButton></AsChild>
            </BzSheetTrigger>
            <BzSheetContent>
                <BzSheetHeader>
                    <BzSheetTitle>Edit profile</BzSheetTitle>
                    <BzSheetDescription>Update your details. Save when you're done.</BzSheetDescription>
                </BzSheetHeader>
                <div class="grid gap-4 px-4"> … fields … </div>
                <BzSheetFooter>
                    <BzSheetClose>
                        <AsChild Context="p"><BzButton @attributes="p.Attributes">Save changes</BzButton></AsChild>
                    </BzSheetClose>
                </BzSheetFooter>
            </BzSheetContent>
        </BzSheet>
        """;

    private const string SidesCode = """
        <BzSheet>
            <BzSheetTrigger>
                <AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Left</BzButton></AsChild>
            </BzSheetTrigger>
            <BzSheetContent Side="SheetSide.Left">
                <BzSheetHeader>
                    <BzSheetTitle>Left sheet</BzSheetTitle>
                    <BzSheetDescription>Slides in from the left edge.</BzSheetDescription>
                </BzSheetHeader>
            </BzSheetContent>
        </BzSheet>
        """;

    private const string ControlledCode = """
        <BzSheet @bind-Open="_open">
            <BzSheetTrigger>…</BzSheetTrigger>
            <BzSheetContent>…</BzSheetContent>
        </BzSheet>

        @code { private bool _open; }
        """;

    private const string RtlCode = """
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzSheet>
                <BzSheetTrigger>
                    <AsChild Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">تعديل الملف الشخصي</BzButton></AsChild>
                </BzSheetTrigger>
                <BzSheetContent>
                    <BzSheetHeader>
                        <BzSheetTitle>تعديل الملف الشخصي</BzSheetTitle>
                        <BzSheetDescription>حدّث بياناتك. احفظ عند الانتهاء.</BzSheetDescription>
                    </BzSheetHeader>
                    <div class="grid gap-4 px-4"> … الحقول … </div>
                    <BzSheetFooter>
                        <BzSheetClose>
                            <AsChild Context="p"><BzButton @attributes="p.Attributes">حفظ التغييرات</BzButton></AsChild>
                        </BzSheetClose>
                    </BzSheetFooter>
                </BzSheetContent>
            </BzSheet>
        </BzDirectionProvider>
        """;
}
