@page "/components/kbd"
<PageTitle>Kbd - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Kbd</h1>
        <p class="text-muted-foreground">Keyboard-key chips, for shortcuts and hints.</p>
    </header>

    <Demo Title="Default" Code="@DefaultCode">
        <div class="flex items-center gap-4">
            <Kbd>⌘</Kbd>
            <Kbd>Shift</Kbd>
            <Kbd>Esc</Kbd>
        </div>
    </Demo>

    <Demo Title="Group" Code="@GroupCode">
        <p class="text-sm text-muted-foreground">
            Press <KbdGroup><Kbd>Ctrl</Kbd><Kbd>K</Kbd></KbdGroup> to open the command palette.
        </p>
    </Demo>

    <Demo Title="Platform-aware"
          Description="Key renders the combo in the visitor's convention - ⌘⇧K on macOS, Ctrl+Shift+K elsewhere ('mod' is the platform primary modifier)."
          Code="@PlatformCode">
        <div class="flex items-center gap-4">
            <Kbd Key="mod+k" />
            <Kbd Key="mod+shift+p" />
            <Kbd Key="alt+enter" />
        </div>
    </Demo>

    <Demo Title="Bound"
          Description="With OnTrigger the chip is live: pressing the combo anywhere on the page fires the callback."
          Code="@BoundCode">
        <div class="flex flex-col items-center gap-3">
            <p class="text-sm text-muted-foreground">Press <Kbd Key="mod+i" OnTrigger="@(() => _count++)" /> anywhere.</p>
            <p class="text-sm text-muted-foreground">Triggered <span class="font-mono">@_count</span> times.</p>
        </div>
    </Demo>

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the chip stays in its key convention while the sentence flows right-to-left." Code="@RtlCode">
        <DirectionProvider Direction="Direction.Rtl">
            <p class="text-sm text-muted-foreground">
                اضغط <KbdGroup><Kbd>Ctrl</Kbd><Kbd>K</Kbd></KbdGroup> لفتح لوحة الأوامر.
            </p>
        </DirectionProvider>
    </Demo>
    <ApiReference Types="ApiFamilies.Kbd" />
</div>

@code {
    private int _count;

    private const string DefaultCode = """
        <Kbd>⌘</Kbd>
        <Kbd>Shift</Kbd>
        <Kbd>Esc</Kbd>
        """;

    private const string GroupCode = """
        Press <KbdGroup><Kbd>Ctrl</Kbd><Kbd>K</Kbd></KbdGroup> to open the command palette.
        """;

    private const string PlatformCode = """
        <Kbd Key="mod+k" />          @* ⌘K on macOS, Ctrl+K elsewhere *@
        <Kbd Key="mod+shift+p" />
        <Kbd Key="alt+enter" />
        """;

    private const string BoundCode = """
        <Kbd Key="mod+i" OnTrigger="@(() => _count++)" />

        @code { private int _count; }
        """;

    private const string RtlCode = """
        <DirectionProvider Direction="Direction.Rtl">
            اضغط <KbdGroup><Kbd>Ctrl</Kbd><Kbd>K</Kbd></KbdGroup> لفتح لوحة الأوامر.
        </DirectionProvider>
        """;
}
