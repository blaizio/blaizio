@page "/components/calendar"
@using System.Globalization
@using System.Linq
<PageTitle>Calendar - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Calendar</h1>
        <p class="text-muted-foreground">A date-grid field for picking a day, several days, or a range. Driven by <code>DateOnly</code> with full keyboard navigation (arrows, Home/End, PageUp/PageDown), month paging, optional month/year dropdowns, bounds, per-day disabling, multiple months, and locale-aware layout - the grid follows the culture's own calendar (Gregorian, Persian, Hijri).</p>
    </header>

    <UsageBlock Setup="@UsageSetup" Code="@UsageMarkup"
                Description="Add the using once, then two-way bind a nullable DateOnly to Value." />

    <ExamplesHeading />

    <Demo Title="Basic" Description="A single-date picker. Click a day to select it; clicking it again clears it. Tab into the grid and use the arrow keys to move, Enter or Space to pick." Code="@BasicCode">
        <div class="space-y-3">
            <p class="text-muted-foreground text-sm">Selected: <span class="text-foreground font-medium tabular-nums">@(_date is { } d ? BzCalendar.FormatValue(d) : "None")</span></p>
            <BzCalendar @bind-Value="_date" Class="rounded-md border p-3 shadow-sm" />
        </div>
    </Demo>

    <Demo Title="Multiple" Description="Set Mode to Multiple to toggle any number of independent days on and off, two-way bound to a list via Values." Code="@MultipleCode">
        <div class="space-y-3">
            <p class="text-muted-foreground text-sm">Selected: <span class="text-foreground font-medium tabular-nums">@(_dates.Count == 0 ? "None" : string.Join(", ", _dates.Select(d => BzCalendar.FormatValue(d))))</span></p>
            <BzCalendar Mode="CalendarMode.Multiple" @bind-Values="_dates" Class="rounded-md border p-3 shadow-sm" />
        </div>
    </Demo>

    <Demo Title="Range" Description="Mode Range picks a contiguous span in two clicks - the first sets the start, the second the end; a third starts over. The days between fill in as a band." Code="@RangeCode">
        <div class="space-y-3">
            <p class="text-muted-foreground text-sm">Selected: <span class="text-foreground font-medium tabular-nums">@FormatRange(_range)</span></p>
            <BzCalendar Mode="CalendarMode.Range" @bind-Range="_range" Class="rounded-md border p-3 shadow-sm" />
        </div>
    </Demo>

    <Demo Title="Formatting the value" Description="The calendar binds a raw DateOnly and renders no value text itself. To display the chosen value, use BzCalendar.FormatValue(date, culture) - it renders the day in that culture's own calendar with native month names and digits, exactly like the grid (so fa-IR yields the Persian year 1405, not 2026). Plain DateOnly.ToString stays on the Gregorian calendar and, on WebAssembly, romanizes non-Gregorian month names - shown here for contrast." Code="@FormattingCode">
        <div class="space-y-3">
            <BzCalendar @bind-Value="_formatDate" Class="rounded-md border p-3 shadow-sm" />
            <dl class="grid grid-cols-[14rem_1fr] gap-x-3 gap-y-1 text-sm">
                <dt class="text-muted-foreground">ToString ISO (yyyy-MM-dd)</dt>
                <dd class="font-medium tabular-nums">@(_formatDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "None")</dd>
                <dt class="text-muted-foreground">ToString long, invariant</dt>
                <dd class="font-medium">@(_formatDate?.ToString("D", CultureInfo.InvariantCulture) ?? "None")</dd>
                <dt class="text-muted-foreground">ToString, Persian</dt>
                <dd class="font-medium">@(_formatDate?.ToDateTime(TimeOnly.MinValue).ToString("d MMMM yyyy", _persian) ?? "None")</dd>
                <dt class="text-muted-foreground">FormatValue, invariant</dt>
                <dd class="font-medium">@(_formatDate is { } d ? BzCalendar.FormatValue(d) : "None")</dd>
                <dt class="text-muted-foreground">FormatValue, Persian</dt>
                <dd class="font-medium">@(_formatDate is { } fd ? BzCalendar.FormatValue(fd, _persian) : "None")</dd>
            </dl>
        </div>
    </Demo>

    <Demo Title="Month & year dropdowns" Description="CaptionLayout swaps the caption label for dropdowns so you can jump straight to a month or year - handy for far-off dates. Use Dropdown (both), DropdownMonths, or DropdownYears. The year list defaults to roughly a century back through ten years ahead." Code="@DropdownCode">
        <div class="space-y-3">
            <p class="text-muted-foreground text-sm">Selected: <span class="text-foreground font-medium tabular-nums">@(_dropdownDate is { } d ? BzCalendar.FormatValue(d) : "None")</span></p>
            <BzCalendar @bind-Value="_dropdownDate" CaptionLayout="CalendarCaptionLayout.Dropdown"
                        Class="rounded-md border p-3 shadow-sm" />
        </div>
    </Demo>

    <Demo Title="Custom year range" Description="Set FromYear and ToYear to bound the year dropdown to your own span - here a date-of-birth picker reaching back to 1925." Code="@YearRangeCode">
        <div class="space-y-3">
            <p class="text-muted-foreground text-sm">Selected: <span class="text-foreground font-medium tabular-nums">@(_dobDate is { } d ? BzCalendar.FormatValue(d) : "None")</span></p>
            <BzCalendar @bind-Value="_dobDate" CaptionLayout="CalendarCaptionLayout.Dropdown"
                        FromYear="1925" ToYear="_today.Year" DefaultMonth="_dobMonth"
                        Class="rounded-md border p-3 shadow-sm" />
        </div>
    </Demo>

    <Demo Title="Multiple months" Description="NumberOfMonths renders several months side by side; the nav pages all of them together." Code="@MonthsCode">
        <div class="space-y-3">
            <p class="text-muted-foreground text-sm">Selected: <span class="text-foreground font-medium tabular-nums">@FormatRange(_rangeMonths)</span></p>
            <BzCalendar Mode="CalendarMode.Range" @bind-Range="_rangeMonths" NumberOfMonths="2" Class="rounded-md border p-3 shadow-sm" />
        </div>
    </Demo>

    <Demo Title="Bounds" Description="Min and Max clamp the selectable window - earlier and later days grey out and the nav stops at the edge months." Code="@BoundsCode">
        <div class="space-y-3">
            <p class="text-muted-foreground text-sm">Selected: <span class="text-foreground font-medium tabular-nums">@(_boundsDate is { } d ? BzCalendar.FormatValue(d) : "None")</span></p>
            <BzCalendar @bind-Value="_boundsDate" Min="_today" Max="_today.AddDays(20)" Class="rounded-md border p-3 shadow-sm" />
        </div>
    </Demo>

    <Demo Title="Disabled days" Description="Pass IsDateDisabled to grey out and block individual days - here every weekend - while leaving the rest selectable." Code="@DisabledDaysCode">
        <div class="space-y-3">
            <p class="text-muted-foreground text-sm">Selected: <span class="text-foreground font-medium tabular-nums">@(_weekendDate is { } d ? BzCalendar.FormatValue(d) : "None")</span></p>
            <BzCalendar @bind-Value="_weekendDate"
                        IsDateDisabled="@(d => d.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)"
                        Class="rounded-md border p-3 shadow-sm" />
        </div>
    </Demo>

    <Demo Title="Hide outside days" Description="ShowOutsideDays=false drops the greyed leading/trailing days from adjacent months, leaving a ragged grid." Code="@OutsideCode">
        <div class="space-y-3">
            <p class="text-muted-foreground text-sm">Selected: <span class="text-foreground font-medium tabular-nums">@(_outsideDate is { } d ? BzCalendar.FormatValue(d) : "None")</span></p>
            <BzCalendar @bind-Value="_outsideDate" ShowOutsideDays="false" Class="rounded-md border p-3 shadow-sm" />
        </div>
    </Demo>

    <Demo Title="Date picker" Description="Drop the calendar inside a Popover to build a date-picker field: the button shows the chosen date and the popup closes on pick." Code="@PickerCode">
        <BzPopover @bind-Open="_pickerOpen">
            <BzPopoverTrigger>
                <AsChild Context="p">
                    <BzButton Variant="ButtonVariant.Outline" Class="w-56 justify-start font-normal" @attributes="p.Attributes">
                        <BzIcon Icon="@Icons.Outline.Calendar" />
                        @(_pickerDate is { } d ? BzCalendar.FormatValue(d) : "Pick a date")
                    </BzButton>
                </AsChild>
            </BzPopoverTrigger>
            <BzPopoverContent Class="w-auto p-0">
                <BzCalendar Value="_pickerDate" ValueChanged="OnPickerChanged" Class="p-3" />
            </BzPopoverContent>
        </BzPopover>
    </Demo>

    <Demo Title="Localization" Description="Pass a Culture and the month names, weekday names and first day of week follow it. Here German (de-DE) - the week starts on Monday. Display the value with the same culture via BzCalendar.FormatValue, and the label in the same language." Code="@LocalizationCode">
        <div class="space-y-3">
            <p class="text-muted-foreground text-sm">Ausgewählt: <span class="text-foreground font-medium tabular-nums">@(_germanDate is { } d ? BzCalendar.FormatValue(d, _german) : "Keine")</span></p>
            <BzCalendar @bind-Value="_germanDate" Culture="_german" Class="rounded-md border p-3 shadow-sm" />
        </div>
    </Demo>

    <Demo Title="Arabic (Gregorian)" Description="Not every Arabic locale is Hijri. ar-EG keeps the Gregorian calendar but renders Arabic month and weekday names and Arabic-Indic digits, inside an RTL provider. BzCalendar.FormatValue(date, ar-EG) renders the value to match, and the label is Arabic." Code="@ArabicGregCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <div class="space-y-3">
                <p class="text-muted-foreground text-sm">الإختيار: <span class="text-foreground font-medium tabular-nums">@(_arabicGregDate is { } d ? BzCalendar.FormatValue(d, _arabicEg) : "لا شيء")</span></p>
                <BzCalendar @bind-Value="_arabicGregDate" Culture="_arabicEg" Class="rounded-md border p-3 shadow-sm" />
            </div>
        </BzDirectionProvider>
    </Demo>

    <Demo Title="Arabic (Hijri)" Description="A culture whose calendar is non-Gregorian lays out its own months and years. Arabic (ar-SA) uses the Umm al-Qura (Hijri) calendar; inside an RTL DirectionProvider the whole grid mirrors. BzCalendar.FormatValue gives the Hijri year (1448), not the Gregorian one." Code="@ArabicCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <div class="space-y-3">
                <p class="text-muted-foreground text-sm">الإختيار: <span class="text-foreground font-medium tabular-nums">@(_arabicDate is { } d ? BzCalendar.FormatValue(d, _arabic) : "لا شيء")</span></p>
                <BzCalendar @bind-Value="_arabicDate" Culture="_arabic" Class="rounded-md border p-3 shadow-sm" />
            </div>
        </BzDirectionProvider>
    </Demo>

    <Demo Title="Latin digits" Description="Numbers default to the culture's native digits (Arabic ١٢٣, Persian ۱۲۳). Set NativeDigits=false to keep Latin numerals while still using the localized calendar, month and weekday names. Pass nativeDigits: false to BzCalendar.FormatValue so the readout matches." Code="@LatinDigitsCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <div class="space-y-3">
                <p class="text-muted-foreground text-sm">الإختيار: <span class="text-foreground font-medium tabular-nums">@(_latinDate is { } d ? BzCalendar.FormatValue(d, _arabic, nativeDigits: false) : "لا شيء")</span></p>
                <BzCalendar @bind-Value="_latinDate" Culture="_arabic" NativeDigits="false" Class="rounded-md border p-3 shadow-sm" />
            </div>
        </BzDirectionProvider>
    </Demo>

    <Demo Title="Persian / Farsi (Jalali)" Description="Farsi (fa-IR) uses the Persian (Jalali) calendar - different months (Farvardin, Ordibehesht, ...) and a different year (1405, not 2026). The value is still a normal DateOnly; only the display changes. BzCalendar.FormatValue(date, fa-IR) renders it in the Persian calendar." Code="@PersianCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <div class="space-y-3">
                <p class="text-muted-foreground text-sm">انتخاب شده: <span class="text-foreground font-medium tabular-nums">@(_persianDate is { } d ? BzCalendar.FormatValue(d, _persian) : "هیچ‌کدام")</span></p>
                <BzCalendar @bind-Value="_persianDate" Culture="_persian" CaptionLayout="CalendarCaptionLayout.Dropdown"
                            Class="rounded-md border p-3 shadow-sm" />
            </div>
        </BzDirectionProvider>
    </Demo>

    <Demo Title="Week numbers" Description="ShowWeekNumber adds a leading column with the week-of-year for each row, in the culture's week rule." Code="@WeekNumberCode">
        <div class="space-y-3">
            <p class="text-muted-foreground text-sm">Selected: <span class="text-foreground font-medium tabular-nums">@(_weekDate is { } d ? BzCalendar.FormatValue(d) : "None")</span></p>
            <BzCalendar @bind-Value="_weekDate" ShowWeekNumber Class="rounded-md border p-3 shadow-sm" />
        </div>
    </Demo>

    <Demo Title="Custom cell size" Description="Bigger cells make room for content under each day. Override --cell-size and supply DayContent - here a nightly price, dearer at weekends - for a booking-style calendar." Code="@CellSizeCode">
        <div class="space-y-3">
            <p class="text-muted-foreground text-sm">Selected: <span class="text-foreground font-medium tabular-nums">@(_cellSizeDate is { } d ? BzCalendar.FormatValue(d) : "None")</span></p>
            <BzCalendar @bind-Value="_cellSizeDate"
                        Class="rounded-md border p-3 shadow-sm [--cell-size:3.4rem] [&_[data-slot=calendar-day-button]]:flex-col [&_[data-slot=calendar-day-button]]:gap-0.5 [&_[data-slot=calendar-day-button]]:font-normal">
                <DayContent Context="day">
                    <span>@day.DayLabel</span>
                    @if (!day.IsOutside)
                    {
                        <span class="text-[0.65rem] @(day.IsSelected ? "opacity-80" : "text-muted-foreground")">$@Price(day.Date)</span>
                    }
                </DayContent>
            </BzCalendar>
        </div>
    </Demo>

    <Demo Title="Booked dates" Description="Mark certain days as taken with IsDateDisabled, then style the disabled day slot - here a strike-through - so booked days read clearly." Code="@BookedCode">
        <div class="space-y-3">
            <p class="text-muted-foreground text-sm">Selected: <span class="text-foreground font-medium tabular-nums">@(_bookedDate is { } d ? BzCalendar.FormatValue(d) : "None")</span></p>
            <BzCalendar @bind-Value="_bookedDate" DefaultMonth="_today"
                        IsDateDisabled="@(d => _booked.Contains(d))"
                        Class="rounded-md border p-3 shadow-sm [&_[data-slot=calendar-day-button][data-disabled]]:line-through" />
        </div>
    </Demo>

    <Demo Title="Presets" Description="Pair the calendar with quick-pick buttons inside the popover for a date picker with presets." Code="@PresetCode">
        <BzPopover @bind-Open="_presetOpen">
            <BzPopoverTrigger>
                <AsChild Context="p">
                    <BzButton Variant="ButtonVariant.Outline" Class="w-56 justify-start font-normal" @attributes="p.Attributes">
                        <BzIcon Icon="@Icons.Outline.Calendar" />
                        @(_presetDate is { } d ? BzCalendar.FormatValue(d) : "Pick a date")
                    </BzButton>
                </AsChild>
            </BzPopoverTrigger>
            <BzPopoverContent Class="w-auto p-0">
                <div class="flex">
                    <div class="flex flex-col gap-1 border-e p-2">
                        @foreach (var (label, offset) in _presets)
                        {
                            <BzButton Variant="ButtonVariant.Ghost" Class="justify-start font-normal" @onclick="@(() => ApplyPreset(offset))">@label</BzButton>
                        }
                    </div>
                    <BzCalendar Value="_presetDate" ValueChanged="OnPresetChanged" Class="p-3" />
                </div>
            </BzPopoverContent>
        </BzPopover>
    </Demo>

    <Demo Title="Date and time" Description="Compose the calendar with the inline BzTimePicker for a date-and-time picker - the two bind independently; combine them when you read the value." Code="@DateTimeCode">
        <div class="w-fit space-y-3 rounded-md border p-3 shadow-sm">
            <p class="text-muted-foreground text-sm">Selected: <span class="text-foreground font-medium tabular-nums">@FormatDateTime(_dtDate, _time)</span></p>
            <BzCalendar @bind-Value="_dtDate" />
            <div class="space-y-2 border-t pt-3">
                <BzLabel Class="px-1 text-sm font-medium">Time</BzLabel>
                <BzTimePicker @bind-Value="_time" ShowSeconds Class="w-full" />
            </div>
        </div>
    </Demo>

    <Demo Title="Date and time range" Description="Pair the calendar with two time pickers for a start and end time - a booking-style slot. Each binds its own TimeOnly." Code="@DateTimeRangeCode">
        <div class="w-fit space-y-4 rounded-md border p-3 shadow-sm">
            <p class="text-muted-foreground text-sm">Selected: <span class="text-foreground font-medium tabular-nums">@FormatDateTimeRange(_rangeDtDate, _startTime, _endTime)</span></p>
            <BzCalendar @bind-Value="_rangeDtDate" />
            <div class="grid grid-cols-2 gap-3 border-t pt-4">
                <div class="space-y-2">
                    <BzLabel Class="px-1 text-sm font-medium">Start Time</BzLabel>
                    <BzTimePicker @bind-Value="_startTime" ShowSeconds Class="w-full" />
                </div>
                <div class="space-y-2">
                    <BzLabel Class="px-1 text-sm font-medium">End Time</BzLabel>
                    <BzTimePicker @bind-Value="_endTime" ShowSeconds Class="w-full" />
                </div>
            </div>
        </div>
    </Demo>

    <Demo Title="Customization"
          Description="Restyle any part via Class. Here the selected day swaps the primary fill for a branded indigo by targeting the calendar-day-button slot in its data-selected-single state. Utilities win over the skin, so it takes effect."
          Code="@CustomizationCode">
        <div class="space-y-3">
            <p class="text-muted-foreground text-sm">Selected: <span class="text-foreground font-medium tabular-nums">@(_customDate is { } d ? BzCalendar.FormatValue(d) : "None")</span></p>
            <BzCalendar @bind-Value="_customDate"
                        Class="rounded-md border p-3 shadow-sm [&_[data-slot=calendar-day-button][data-selected-single]]:bg-indigo-600 [&_[data-slot=calendar-day-button][data-selected-single]]:text-white" />
        </div>
    </Demo>

    <Demo Title="Disabled" Description="Disabled greys the whole calendar and blocks selection and navigation, while still showing the current value." Code="@DisabledCode">
        <div class="space-y-3">
            <p class="text-muted-foreground text-sm">Selected: <span class="text-foreground font-medium tabular-nums">@(_disabledDate is { } d ? BzCalendar.FormatValue(d) : "None")</span></p>
            <BzCalendar @bind-Value="_disabledDate" Disabled Class="rounded-md border p-3 opacity-60 shadow-sm" />
        </div>
    </Demo>

    <ApiReference Types="ApiFamilies.Calendar" />
</div>

@code {
    private static readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);
    private static readonly CultureInfo _german = new("de-DE");
    private static readonly CultureInfo _arabicEg = new("ar-EG");
    private static readonly CultureInfo _arabic = new("ar-SA");
    private static readonly CultureInfo _persian = new("fa-IR");

    private static readonly (string Label, int Offset)[] _presets =
        [("Today", 0), ("Tomorrow", 1), ("In a week", 7), ("In a month", 30)];
    private static readonly HashSet<DateOnly> _booked =
        [_today.AddDays(2), _today.AddDays(3), _today.AddDays(8), _today.AddDays(9)];

    private DateOnly? _date = _today;
    private IReadOnlyList<DateOnly> _dates = [_today, _today.AddDays(2), _today.AddDays(5)];
    private DateRange _range = new(_today, _today.AddDays(5));
    private DateRange _rangeMonths = new(_today, _today.AddDays(9));
    private DateOnly? _dropdownDate = _today;
    private DateOnly? _formatDate = _today;
    private DateOnly? _dobDate;
    private static readonly DateOnly _dobMonth = new(1990, 1, 1);
    private DateOnly? _boundsDate = _today;
    private DateOnly? _weekendDate;
    private DateOnly? _outsideDate = _today;
    private DateOnly? _germanDate = _today;
    private DateOnly? _arabicGregDate = _today;
    private DateOnly? _arabicDate = _today;
    private DateOnly? _persianDate = _today;
    private DateOnly? _weekDate = _today;
    private DateOnly? _cellSizeDate = _today;
    private DateOnly? _bookedDate;
    private DateOnly? _customDate = _today;
    private DateOnly? _disabledDate = _today;
    private DateOnly? _dtDate = _today;
    private TimeOnly? _time = new(21, 30, 0);
    private DateOnly? _rangeDtDate = _today;
    private TimeOnly? _startTime = new(21, 30, 0);
    private TimeOnly? _endTime = new(0, 30, 0);
    private DateOnly? _latinDate = _today;

    private static int Price(DateOnly date) =>
        date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday ? 120 : 100;

    // Compose BzCalendar.FormatValue (the component's culture-aware day formatter) for ranges and times.
    private static string FmtTime(TimeOnly? time, string format) =>
        time is { } t ? t.ToString(format, CultureInfo.InvariantCulture) : "--";

    private static string FormatRange(DateRange range) =>
        range.Start is { } start
            ? range.End is { } end
                ? $"{BzCalendar.FormatValue(start)} - {BzCalendar.FormatValue(end)}"
                : $"{BzCalendar.FormatValue(start)} - select end"
            : "None";

    private static string FormatDateTime(DateOnly? date, TimeOnly? time) =>
        date is { } d ? $"{BzCalendar.FormatValue(d)} at {FmtTime(time, "h:mm:ss tt")}" : "None";

    private static string FormatDateTimeRange(DateOnly? date, TimeOnly? start, TimeOnly? end) =>
        date is { } d ? $"{BzCalendar.FormatValue(d)}, {FmtTime(start, "h:mm tt")} - {FmtTime(end, "h:mm tt")}" : "None";

    private DateOnly? _pickerDate;
    private bool _pickerOpen;
    private DateOnly? _presetDate;
    private bool _presetOpen;

    private void OnPickerChanged(DateOnly? date)
    {
        _pickerDate = date;
        _pickerOpen = false;
    }

    private void OnPresetChanged(DateOnly? date)
    {
        _presetDate = date;
        _presetOpen = false;
    }

    private void ApplyPreset(int offset)
    {
        _presetDate = _today.AddDays(offset);
        _presetOpen = false;
    }

    private const string UsageSetup = """
        @* _Imports.razor (or the top of the page) *@
        @using Blazeo.Ui
        """;

    private const string UsageMarkup = """
        <BzCalendar @bind-Value="_date" Class="rounded-md border p-3 shadow-sm" />

        @code {
            private DateOnly? _date = DateOnly.FromDateTime(DateTime.Today);
        }
        """;

    private const string BasicCode = """
        <p>Selected: @(_date is { } d ? BzCalendar.FormatValue(d) : "None")</p>
        <BzCalendar @bind-Value="_date" Class="rounded-md border p-3 shadow-sm" />

        @code {
            private DateOnly? _date = DateOnly.FromDateTime(DateTime.Today);
        }
        """;

    private const string MultipleCode = """
        <p>Selected: @(_dates.Count == 0 ? "None" : string.Join(", ", _dates.Select(d => BzCalendar.FormatValue(d))))</p>
        <BzCalendar Mode="CalendarMode.Multiple" @bind-Values="_dates" Class="rounded-md border p-3 shadow-sm" />

        @code {
            private static readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);
            private IReadOnlyList<DateOnly> _dates = [_today, _today.AddDays(2), _today.AddDays(5)];
        }
        """;

    private const string RangeCode = """
        <p>Selected: @Format(_range)</p>
        <BzCalendar Mode="CalendarMode.Range" @bind-Range="_range" Class="rounded-md border p-3 shadow-sm" />

        @code {
            private static readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);
            private DateRange _range = new(_today, _today.AddDays(5));

            private static string Format(DateRange r) =>
                r.Start is { } s
                    ? (r.End is { } e ? $"{BzCalendar.FormatValue(s)} - {BzCalendar.FormatValue(e)}" : $"{BzCalendar.FormatValue(s)} - select end")
                    : "None";
        }
        """;

    private const string FormattingCode = """
        @using System.Globalization

        <BzCalendar @bind-Value="_date" Class="rounded-md border p-3 shadow-sm" />

        @* FormatValue renders the value in a culture's own calendar with native names + digits (like the
           grid). Plain ToString stays Gregorian and romanizes non-Gregorian month names under WASM. *@
        <p>ToString ISO:     @(_date?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))</p>
        <p>ToString Persian: @(_date?.ToDateTime(TimeOnly.MinValue).ToString("d MMMM yyyy", new CultureInfo("fa-IR")))</p>
        <p>FormatValue:      @(_date is { } d ? BzCalendar.FormatValue(d) : "None")</p>
        <p>FormatValue fa:   @(_date is { } fa ? BzCalendar.FormatValue(fa, new CultureInfo("fa-IR")) : "None")</p>

        @code {
            private DateOnly? _date = DateOnly.FromDateTime(DateTime.Today);
        }
        """;

    private const string DropdownCode = """
        <p>Selected: @(_date is { } d ? BzCalendar.FormatValue(d) : "None")</p>
        <BzCalendar @bind-Value="_date" CaptionLayout="CalendarCaptionLayout.Dropdown"
                    Class="rounded-md border p-3 shadow-sm" />

        @code {
            private DateOnly? _date = DateOnly.FromDateTime(DateTime.Today);
        }
        """;

    private const string YearRangeCode = """
        <p>Selected: @(_dob is { } d ? BzCalendar.FormatValue(d) : "None")</p>
