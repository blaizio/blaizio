@page "/components/card"
<PageTitle>Card - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Card</h1>
        <p class="text-muted-foreground">A surface for grouping related content and actions.</p>
    </header>

    <Demo Title="With header, content & footer" Code="@CardCode">
        <Card Class="w-full max-w-sm">
            <CardHeader>
                <CardTitle>Deploy your project</CardTitle>
                <CardDescription>Push to the global edge network in one click.</CardDescription>
                <CardAction>
                    <Badge Variant="BadgeVariant.Secondary">Pro</Badge>
                </CardAction>
            </CardHeader>
            <CardContent>
                <p class="text-sm text-muted-foreground">
                    Your project will be built and served from the location closest to each visitor.
                </p>
            </CardContent>
            <CardFooter Class="justify-between border-t">
                <Button Variant="ButtonVariant.Outline">Cancel</Button>
                <Button>Deploy</Button>
            </CardFooter>
        </Card>
    </Demo>

    <Demo Title="Stat card" Description="A compact card with just a header and content." Code="@StatCode">
        <Card Class="w-full max-w-xs">
            <CardHeader>
                <CardDescription>Total revenue</CardDescription>
                <CardTitle Class="text-3xl tabular-nums">$45,231.89</CardTitle>
                <CardAction>
                    <Badge>+20.1%</Badge>
                </CardAction>
            </CardHeader>
            <CardContent>
                <p class="text-xs text-muted-foreground">Trending up vs. last month</p>
            </CardContent>
        </Card>
    </Demo>

    <Demo Title="Notification" Code="@NotificationCode">
        <Card Class="w-full max-w-sm">
            <CardContent>
                <div class="flex items-start gap-3">
                    <span class="mt-1 size-2 shrink-0 rounded-full bg-primary"></span>
                    <div class="space-y-1">
                        <p class="text-sm font-medium leading-none">New comment on your envelope</p>
                        <p class="text-sm text-muted-foreground">Sarah left a note on “Q3 Agreement”.</p>
                    </div>
                </div>
            </CardContent>
        </Card>
    </Demo>
    <ApiReference Types="ApiFamilies.Card" />
</div>

