@page "/components/collapsible"
<PageTitle>Collapsible - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Collapsible</h1>
        <p class="text-muted-foreground">An expandable section with a trigger you style yourself.</p>
    </header>

    <UsageBlock Setup="@UsageSetup" Code="@UsageMarkup"
                Description="Add the using once, then compose a trigger and content. The trigger is usually a Button via RenderAs; the panel animates open and closed." />

    <CompositionTree Root="_anatomy"
                     Description="The full anatomy. The collapsible holds a trigger (your own element, via RenderAs) and a content panel that animates open and closed." />

    <ExamplesHeading />

    <Demo Title="Default" Description="The trigger is usually a Button via RenderAs. The panel animates open and closed." Code="@DefaultCode">
        <BzCollapsible Class="flex w-full max-w-sm flex-col gap-2">
            <div class="flex items-center justify-between gap-4">
                <h4 class="text-sm font-semibold">3 files changed</h4>
                <BzCollapsibleTrigger>
                    <RenderAs Context="p">
                        <BzButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" aria-label="Toggle" @attributes="p.Attributes">
                            <BzIcon Icon="@Icons.Outline.Selector" />
                        </BzButton>
                    </RenderAs>
                </BzCollapsibleTrigger>
            </div>
            <div class="rounded-md border px-4 py-2 font-mono text-sm">src/App.razor</div>
            <BzCollapsibleContent Class="flex flex-col gap-2">
                <div class="rounded-md border px-4 py-2 font-mono text-sm">src/Layout.razor</div>
                <div class="rounded-md border px-4 py-2 font-mono text-sm">wwwroot/app.css</div>
            </BzCollapsibleContent>
        </BzCollapsible>
    </Demo>

    <Demo Title="Custom trigger (RenderAs)" Description="Render the trigger onto your own element - here an anchor - instead of the default button, by splatting p.Attributes." Code="@RenderAsTriggerCode">
        <BzCollapsible Class="flex w-full max-w-sm flex-col gap-2">
            <div class="flex items-center justify-between gap-4">
                <h4 class="text-sm font-semibold">3 files changed</h4>
                <BzCollapsibleTrigger>
                    <RenderAs Context="p">
                        <a href="#" @onclick:preventDefault @attributes="p.Attributes" class="text-sm font-medium text-indigo-600 underline-offset-4 hover:underline dark:text-indigo-400">Toggle</a>
                    </RenderAs>
                </BzCollapsibleTrigger>
            </div>
            <div class="rounded-md border px-4 py-2 font-mono text-sm">src/App.razor</div>
            <BzCollapsibleContent Class="flex flex-col gap-2">
                <div class="rounded-md border px-4 py-2 font-mono text-sm">src/Layout.razor</div>
                <div class="rounded-md border px-4 py-2 font-mono text-sm">wwwroot/app.css</div>
            </BzCollapsibleContent>
        </BzCollapsible>
    </Demo>

    <Demo Title="Open by default" Description="Start expanded with DefaultOpen." Code="@DefaultOpenCode">
        <BzCollapsible DefaultOpen="true" Class="flex w-full max-w-sm flex-col gap-2">
            <div class="flex items-center justify-between gap-4">
                <h4 class="text-sm font-semibold">Build output</h4>
                <BzCollapsibleTrigger>
                    <RenderAs Context="p">
                        <BzButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" aria-label="Toggle" @attributes="p.Attributes">
                            <BzIcon Icon="@Icons.Outline.Selector" />
                        </BzButton>
                    </RenderAs>
                </BzCollapsibleTrigger>
            </div>
            <BzCollapsibleContent Class="flex flex-col gap-2">
                <div class="rounded-md border px-4 py-2 font-mono text-sm">Build succeeded in 2.1s</div>
                <div class="rounded-md border px-4 py-2 font-mono text-sm">0 warnings, 0 errors</div>
            </BzCollapsibleContent>
        </BzCollapsible>
    </Demo>

    <Demo Title="Disabled" Description="Disabled blocks toggling and dims the trigger." Code="@DisabledCode">
        <BzCollapsible Disabled="true" Class="flex w-full max-w-sm flex-col gap-2">
            <div class="flex items-center justify-between gap-4">
                <h4 class="text-sm font-semibold">Locked section</h4>
                <BzCollapsibleTrigger>
                    <RenderAs Context="p">
                        <BzButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" aria-label="Toggle" Disabled="true" @attributes="p.Attributes">
                            <BzIcon Icon="@Icons.Outline.Selector" />
                        </BzButton>
                    </RenderAs>
                </BzCollapsibleTrigger>
            </div>
            <div class="rounded-md border px-4 py-2 font-mono text-sm">Always visible</div>
            <BzCollapsibleContent Class="flex flex-col gap-2">
                <div class="rounded-md border px-4 py-2 font-mono text-sm">Hidden while disabled</div>
            </BzCollapsibleContent>
        </BzCollapsible>
    </Demo>

    <Demo Title="Custom indicator" Description="Swap an icon off the trigger's expanded state, the way the accordion does." Code="@IndicatorCode">
        <BzCollapsible Class="w-full max-w-sm">
            <BzCollapsibleTrigger>
                <RenderAs Context="p">
                    <BzButton Variant="ButtonVariant.Outline" Class="group/collapsible w-full justify-between" @attributes="p.Attributes">
                        Show details
                        <BzIcon Icon="@Icons.Outline.ChevronDown" Class="size-4 shrink-0 group-aria-expanded/collapsible:hidden" />
                        <BzIcon Icon="@Icons.Outline.ChevronUp" Class="hidden size-4 shrink-0 group-aria-expanded/collapsible:inline" />
                    </BzButton>
                </RenderAs>
            </BzCollapsibleTrigger>
            <BzCollapsibleContent>
                <p class="mt-2 rounded-md border px-4 py-3 text-sm text-muted-foreground">
                    The up/down chevron swaps when the panel opens, driven by the trigger's expanded state.
                </p>
            </BzCollapsibleContent>
        </BzCollapsible>
    </Demo>

    <Demo Title="Controlled" Description="Bind the open state two-way." Code="@ControlledCode">
        <div class="flex w-full max-w-sm flex-col items-center gap-3">
            <BzCollapsible @bind-Open="_open" Class="flex w-full flex-col gap-2">
                <BzCollapsibleTrigger>
                    <RenderAs Context="p">
                        <BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" @attributes="p.Attributes">
                            @(_open ? "Hide details" : "Show details")
                        </BzButton>
                    </RenderAs>
                </BzCollapsibleTrigger>
                <BzCollapsibleContent>
                    <p class="rounded-md border px-4 py-2 text-sm text-muted-foreground">The fine print.</p>
                </BzCollapsibleContent>
            </BzCollapsible>
            <p class="text-sm text-muted-foreground">Open: <span class="font-mono">@_open</span></p>
        </div>
    </Demo>
    <Demo Title="Customization"
          Description="Restyle the parts via Class - here the trigger is a full-width indigo pill and the panel rows pick up a tinted border. The trigger is your own Button, so style it directly."
          Code="@CustomCode">
        <BzCollapsible Class="flex w-full max-w-sm flex-col gap-2">
            <BzCollapsibleTrigger>
                <RenderAs Context="p">
                    <BzButton Class="w-full justify-between rounded-full bg-indigo-600 text-white hover:bg-indigo-600/90" @attributes="p.Attributes">
                        Release notes
                        <BzIcon Icon="@Icons.Outline.Selector" />
                    </BzButton>
                </RenderAs>
            </BzCollapsibleTrigger>
            <BzCollapsibleContent Class="flex flex-col gap-2">
                <div class="rounded-md border border-indigo-600/40 px-4 py-2 text-sm">Added two-way binding</div>
                <div class="rounded-md border border-indigo-600/40 px-4 py-2 text-sm">Fixed the open animation</div>
            </BzCollapsibleContent>
        </BzCollapsible>
    </Demo>
    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the trigger, padding and rows all mirror to the right." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzCollapsible Class="flex w-full max-w-sm flex-col gap-2">
                <div class="flex items-center justify-between gap-4">
                    <h4 class="text-sm font-semibold">3 ملفات معدّلة</h4>
                    <BzCollapsibleTrigger>
                        <RenderAs Context="p">
                            <BzButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" aria-label="تبديل" @attributes="p.Attributes">
                                <BzIcon Icon="@Icons.Outline.Selector" />
                            </BzButton>
                        </RenderAs>
                    </BzCollapsibleTrigger>
                </div>
                <div class="rounded-md border px-4 py-2 font-mono text-sm">src/App.razor</div>
                <BzCollapsibleContent Class="flex flex-col gap-2">
                    <div class="rounded-md border px-4 py-2 font-mono text-sm">src/Layout.razor</div>
                    <div class="rounded-md border px-4 py-2 font-mono text-sm">wwwroot/app.css</div>
                </BzCollapsibleContent>
            </BzCollapsible>
        </BzDirectionProvider>
    </Demo>
    <ApiReference Types="ApiFamilies.Collapsible" />
</div>

@code {
    private bool _open;

    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode _anatomy = new CompositionNode("BzCollapsible",
        new CompositionNode("BzCollapsibleTrigger"),
        new CompositionNode("BzCollapsibleContent"));

    private const string UsageSetup = """
        @* _Imports.razor (or the top of the page) *@
        @using Blazeo.Ui
        """;

    private const string UsageMarkup = """
        <BzCollapsible Class="flex flex-col gap-2">
            <BzCollapsibleTrigger>
                <RenderAs Context="p">
                    <BzButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" @attributes="p.Attributes">
                        <BzIcon Icon="@Icons.Outline.Selector" />
                    </BzButton>
                </RenderAs>
            </BzCollapsibleTrigger>
            <BzCollapsibleContent>
                …hidden rows…
            </BzCollapsibleContent>
        </BzCollapsible>
        """;

    private const string CustomCode = """
