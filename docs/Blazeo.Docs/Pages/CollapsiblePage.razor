@page "/components/collapsible"
<PageTitle>Collapsible - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Collapsible</h1>
        <p class="text-muted-foreground">An expandable section with a trigger you style yourself.</p>
    </header>

    <Demo Title="Default" Description="The trigger is usually a Button via AsChild. The panel animates open and closed." Code="@DefaultCode">
        <Collapsible Class="flex w-full max-w-sm flex-col gap-2">
            <div class="flex items-center justify-between gap-4">
                <h4 class="text-sm font-semibold">3 files changed</h4>
                <CollapsibleTrigger>
                    <AsChild Context="p">
                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" aria-label="Toggle" @attributes="p.Attributes">
                            <BzIcon Icon="@Icons.Outline.Selector" />
                        </Button>
                    </AsChild>
                </CollapsibleTrigger>
            </div>
            <div class="rounded-md border px-4 py-2 font-mono text-sm">src/App.razor</div>
            <CollapsibleContent Class="flex flex-col gap-2">
                <div class="rounded-md border px-4 py-2 font-mono text-sm">src/Layout.razor</div>
                <div class="rounded-md border px-4 py-2 font-mono text-sm">wwwroot/app.css</div>
            </CollapsibleContent>
        </Collapsible>
    </Demo>

    <Demo Title="Open by default" Description="Start expanded with DefaultOpen." Code="@DefaultOpenCode">
        <Collapsible DefaultOpen="true" Class="flex w-full max-w-sm flex-col gap-2">
            <div class="flex items-center justify-between gap-4">
                <h4 class="text-sm font-semibold">Build output</h4>
                <CollapsibleTrigger>
                    <AsChild Context="p">
                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" aria-label="Toggle" @attributes="p.Attributes">
                            <BzIcon Icon="@Icons.Outline.Selector" />
                        </Button>
                    </AsChild>
                </CollapsibleTrigger>
            </div>
            <CollapsibleContent Class="flex flex-col gap-2">
                <div class="rounded-md border px-4 py-2 font-mono text-sm">Build succeeded in 2.1s</div>
                <div class="rounded-md border px-4 py-2 font-mono text-sm">0 warnings, 0 errors</div>
            </CollapsibleContent>
        </Collapsible>
    </Demo>

    <Demo Title="Disabled" Description="Disabled blocks toggling and dims the trigger." Code="@DisabledCode">
        <Collapsible Disabled="true" Class="flex w-full max-w-sm flex-col gap-2">
            <div class="flex items-center justify-between gap-4">
                <h4 class="text-sm font-semibold">Locked section</h4>
                <CollapsibleTrigger>
                    <AsChild Context="p">
                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" aria-label="Toggle" Disabled="true" @attributes="p.Attributes">
                            <BzIcon Icon="@Icons.Outline.Selector" />
                        </Button>
                    </AsChild>
                </CollapsibleTrigger>
            </div>
            <div class="rounded-md border px-4 py-2 font-mono text-sm">Always visible</div>
            <CollapsibleContent Class="flex flex-col gap-2">
                <div class="rounded-md border px-4 py-2 font-mono text-sm">Hidden while disabled</div>
            </CollapsibleContent>
        </Collapsible>
    </Demo>

    <Demo Title="Custom indicator" Description="Swap an icon off the trigger's expanded state, the way the accordion does." Code="@IndicatorCode">
        <Collapsible Class="w-full max-w-sm">
            <CollapsibleTrigger>
                <AsChild Context="p">
                    <Button Variant="ButtonVariant.Outline" Class="group/collapsible w-full justify-between" @attributes="p.Attributes">
                        Show details
                        <BzIcon Icon="@Icons.Outline.ChevronDown" Class="size-4 shrink-0 group-aria-expanded/collapsible:hidden" />
                        <BzIcon Icon="@Icons.Outline.ChevronUp" Class="hidden size-4 shrink-0 group-aria-expanded/collapsible:inline" />
                    </Button>
                </AsChild>
            </CollapsibleTrigger>
            <CollapsibleContent>
                <p class="mt-2 rounded-md border px-4 py-3 text-sm text-muted-foreground">
                    The up/down chevron swaps when the panel opens, driven by the trigger's expanded state.
                </p>
            </CollapsibleContent>
        </Collapsible>
    </Demo>

    <Demo Title="Controlled" Description="Bind the open state two-way." Code="@ControlledCode">
        <div class="flex w-full max-w-sm flex-col items-center gap-3">
            <Collapsible @bind-Open="_open" Class="flex w-full flex-col gap-2">
                <CollapsibleTrigger>
                    <AsChild Context="p">
                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" @attributes="p.Attributes">
                            @(_open ? "Hide details" : "Show details")
                        </Button>
                    </AsChild>
                </CollapsibleTrigger>
                <CollapsibleContent>
                    <p class="rounded-md border px-4 py-2 text-sm text-muted-foreground">The fine print.</p>
                </CollapsibleContent>
            </Collapsible>
            <p class="text-sm text-muted-foreground">Open: <span class="font-mono">@_open</span></p>
        </div>
    </Demo>
    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the trigger, padding and rows all mirror to the right." Code="@RtlCode">
        <DirectionProvider Direction="Direction.Rtl">
            <Collapsible Class="flex w-full max-w-sm flex-col gap-2">
                <div class="flex items-center justify-between gap-4">
                    <h4 class="text-sm font-semibold">٣ ملفات معدّلة</h4>
                    <CollapsibleTrigger>
                        <AsChild Context="p">
                            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" aria-label="تبديل" @attributes="p.Attributes">
                                <BzIcon Icon="@Icons.Outline.Selector" />
                            </Button>
                        </AsChild>
                    </CollapsibleTrigger>
                </div>
                <div class="rounded-md border px-4 py-2 font-mono text-sm">src/App.razor</div>
                <CollapsibleContent Class="flex flex-col gap-2">
                    <div class="rounded-md border px-4 py-2 font-mono text-sm">src/Layout.razor</div>
                    <div class="rounded-md border px-4 py-2 font-mono text-sm">wwwroot/app.css</div>
                </CollapsibleContent>
            </Collapsible>
        </DirectionProvider>
    </Demo>
    <ApiReference Types="ApiFamilies.Collapsible" />
</div>

@code {
    private bool _open;

    private const string DefaultCode = """
        <Collapsible Class="flex flex-col gap-2">
            <CollapsibleTrigger>
                <AsChild Context="p">
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" @attributes="p.Attributes">
                        <BzIcon Icon="@Icons.Outline.Selector" />
                    </Button>
                </AsChild>
            </CollapsibleTrigger>
            <CollapsibleContent>
                …hidden rows…
            </CollapsibleContent>
        </Collapsible>
        """;

    private const string DefaultOpenCode = """
        <Collapsible DefaultOpen="true">
            <CollapsibleTrigger>…</CollapsibleTrigger>
            <CollapsibleContent>…</CollapsibleContent>
        </Collapsible>
        """;

    private const string DisabledCode = """
        <Collapsible Disabled="true">
            <CollapsibleTrigger>…</CollapsibleTrigger>
            <CollapsibleContent>…</CollapsibleContent>
        </Collapsible>
        """;

    private const string IndicatorCode = """
        <Collapsible>
            <CollapsibleTrigger>
                <AsChild Context="p">
                    <Button Variant="ButtonVariant.Outline" Class="group/collapsible justify-between" @attributes="p.Attributes">
                        Show details
                        <BzIcon Icon="@Icons.Outline.ChevronDown" Class="group-aria-expanded/collapsible:hidden" />
                        <BzIcon Icon="@Icons.Outline.ChevronUp" Class="hidden group-aria-expanded/collapsible:inline" />
                    </Button>
                </AsChild>
            </CollapsibleTrigger>
            <CollapsibleContent>…</CollapsibleContent>
        </Collapsible>
        """;

    private const string ControlledCode = """
        <Collapsible @bind-Open="_open">
            <CollapsibleTrigger>…</CollapsibleTrigger>
            <CollapsibleContent>…</CollapsibleContent>
        </Collapsible>

        @code { private bool _open; }
        """;

    private const string RtlCode = """
        <DirectionProvider Direction="Direction.Rtl">
            <Collapsible Class="flex flex-col gap-2">
                <CollapsibleTrigger>
                    <AsChild Context="p">
                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" @attributes="p.Attributes">
                            <BzIcon Icon="@Icons.Outline.Selector" />
                        </Button>
                    </AsChild>
                </CollapsibleTrigger>
                <CollapsibleContent>
                    …الصفوف المخفية…
                </CollapsibleContent>
            </Collapsible>
        </DirectionProvider>
        """;
}
