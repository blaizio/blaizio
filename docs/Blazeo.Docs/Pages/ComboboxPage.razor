@page "/components/combobox"
<PageTitle>Combobox - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Combobox</h1>
        <p class="text-muted-foreground">An autocomplete input with a popup list of suggestions. Type to filter; pick with the mouse or the arrow keys while focus stays in the input. Data-driven over <code>Items</code> with a render-prop list - single or multiple selection (with chips), groups, a clear button, and object items via <code>ItemToStringValue</code>.</p>
    </header>

    <Demo Title="Basic" Description="A single-select over a flat list. Typing fuzzy-filters the options; picking one fills the input and closes the popup." Code="@BasicCode">
        <BzCombobox Items="_frameworks">
            <BzComboboxInput Placeholder="Select a framework" Class="w-64" />
            <BzComboboxContent>
                <BzComboboxEmpty>No framework found.</BzComboboxEmpty>
                <BzComboboxList Context="item">
                    <BzComboboxItem Value="@item">@item</BzComboboxItem>
                </BzComboboxList>
            </BzComboboxContent>
        </BzCombobox>
    </Demo>

    <Demo Title="Multiple" Description="Set Multiple for chips. Each pick adds a token; the remove button or Backspace on an empty query removes one. The popup stays open so several can be chosen in one visit." Code="@MultipleCode">
        <BzCombobox Items="_frameworks" Multiple @bind-Values="_selectedFrameworks" AutoHighlight>
            <BzComboboxChips Class="w-80">
                <BzComboboxValue>
                    <Selection Context="values">
                        @foreach (var v in values)
                        {
                            <BzComboboxChip Value="@v">@v</BzComboboxChip>
                        }
                        <BzComboboxChipsInput Placeholder="Add framework" />
                    </Selection>
                </BzComboboxValue>
            </BzComboboxChips>
            <BzComboboxContent>
                <BzComboboxEmpty>No framework found.</BzComboboxEmpty>
                <BzComboboxList Context="item">
                    <BzComboboxItem Value="@item">@item</BzComboboxItem>
                </BzComboboxList>
            </BzComboboxContent>
        </BzCombobox>
    </Demo>

    <Demo Title="Clear button" Description="Pass ShowClear and the trailing chevron swaps for a clear button whenever a value is selected. Clearing empties the field and returns focus to the input." Code="@ClearCode">
        <BzCombobox Items="_frameworks" DefaultValue='@("Next.js")'>
            <BzComboboxInput Placeholder="Select a framework" ShowClear Class="w-64" />
            <BzComboboxContent>
                <BzComboboxEmpty>No framework found.</BzComboboxEmpty>
                <BzComboboxList Context="item">
                    <BzComboboxItem Value="@item">@item</BzComboboxItem>
                </BzComboboxList>
            </BzComboboxContent>
        </BzCombobox>
    </Demo>

    <Demo Title="Groups" Description="When the items are groups, the list render-prop yields each group; nest a ComboboxCollection for its items and a ComboboxSeparator between them. Empty groups (and their separators) drop out as you filter." Code="@GroupsCode">
        <BzCombobox Items="_timezoneGroups">
            <BzComboboxInput Placeholder="Select a timezone" Class="w-72" />
            <BzComboboxContent>
                <BzComboboxEmpty>No timezone found.</BzComboboxEmpty>
                <BzComboboxList Context="group">
                    @if (group!.Region != _timezoneGroups[0].Region)
                    {
                        <BzComboboxSeparator />
                    }
                    <BzComboboxGroup>
                        <BzComboboxLabel>@group.Region</BzComboboxLabel>
                        <BzComboboxCollection Items="@group.Zones" Context="tz">
                            <BzComboboxItem Value="@tz">@tz</BzComboboxItem>
                        </BzComboboxCollection>
                    </BzComboboxGroup>
                </BzComboboxList>
            </BzComboboxContent>
        </BzCombobox>
    </Demo>

    <Demo Title="Custom items" Description="Items can be objects. Give ItemToStringValue so the engine knows the filter + selection text, then render whatever you like inside each ComboboxItem." Code="@CustomCode">
        <BzCombobox Items="_people" ItemToStringValue="@(p => p.Name)" @bind-Value="_person">
            <BzComboboxInput Placeholder="Assign a person" Class="w-72" />
            <BzComboboxContent>
                <BzComboboxEmpty>No person found.</BzComboboxEmpty>
                <BzComboboxList Context="p">
                    <BzComboboxItem Value="@p">
                        <span class="flex flex-col">
                            <span>@p.Name</span>
                            <span class="text-muted-foreground text-xs">@p.Role</span>
                        </span>
                    </BzComboboxItem>
                </BzComboboxList>
            </BzComboboxContent>
        </BzCombobox>
    </Demo>

    <Demo Title="Auto highlight" Description="With AutoHighlight the first match stays highlighted as you type, so Enter picks it with no arrow press. Opening highlights the current selection instead (here Remix, the fourth option) - the highlight follows the value, never an unconditional first item." Code="@AutoHighlightCode">
        <BzCombobox Items="_frameworks" AutoHighlight DefaultValue='@("Remix")'>
            <BzComboboxInput Placeholder="Select a framework" Class="w-64" />
            <BzComboboxContent>
                <BzComboboxEmpty>No framework found.</BzComboboxEmpty>
                <BzComboboxList Context="item">
                    <BzComboboxItem Value="@item">@item</BzComboboxItem>
                </BzComboboxList>
            </BzComboboxContent>
        </BzCombobox>
    </Demo>

    <Demo Title="Input group" Description="Drop an InputGroupAddon inside ComboboxInput for a leading icon (or any affix) - the field still reads as one control." Code="@InputGroupCode">
        <BzCombobox Items="_timezoneGroups">
            <BzComboboxInput Placeholder="Select a timezone" Class="w-72">
                <BzInputGroupAddon>
                    <BzIcon Icon="@Icons.Outline.World" />
                </BzInputGroupAddon>
            </BzComboboxInput>
            <BzComboboxContent>
                <BzComboboxEmpty>No timezone found.</BzComboboxEmpty>
                <BzComboboxList Context="group">
                    <BzComboboxGroup>
                        <BzComboboxLabel>@group.Region</BzComboboxLabel>
                        <BzComboboxCollection Items="@group.Zones" Context="tz">
                            <BzComboboxItem Value="@tz">@tz</BzComboboxItem>
                        </BzComboboxCollection>
                    </BzComboboxGroup>
                </BzComboboxList>
            </BzComboboxContent>
        </BzCombobox>
    </Demo>

    <Demo Title="In a popup" Description="Trigger the combobox from a button by making it the anchor and moving the input inside the content. ComboboxValue shows the current pick on the button." Code="@PopupCode">
        <BzCombobox Items="_countries" ItemToStringValue="@(c => c.Label)" DefaultValue="@_countries[0]">
            <BzComboboxTrigger Anchor Class="border-input hover:bg-accent hover:text-foreground h-9 w-64 justify-between rounded-md border bg-transparent px-3 text-sm font-normal shadow-xs">
                <BzComboboxValue />
            </BzComboboxTrigger>
            <BzComboboxContent>
                <BzComboboxInput ShowTrigger="false" Anchor="false" Placeholder="Search country" />
                <BzComboboxEmpty>No country found.</BzComboboxEmpty>
                <BzComboboxList Context="c">
                    <BzComboboxItem Value="@c">@c.Label</BzComboboxItem>
                </BzComboboxList>
            </BzComboboxContent>
        </BzCombobox>
    </Demo>

    <Demo Title="Invalid" Description="Pass aria-invalid to mark the field invalid - the input group picks up the destructive ring." Code="@InvalidCode">
        <BzCombobox Items="_frameworks">
            <BzComboboxInput Placeholder="Select a framework" aria-invalid="true" Class="w-64" />
            <BzComboboxContent>
                <BzComboboxEmpty>No framework found.</BzComboboxEmpty>
                <BzComboboxList Context="item">
                    <BzComboboxItem Value="@item">@item</BzComboboxItem>
                </BzComboboxList>
            </BzComboboxContent>
        </BzCombobox>
    </Demo>

    <Demo Title="Disabled" Description="Disabled on the root greys the field and its addons and blocks interaction, while still showing the current value." Code="@DisabledCode">
        <BzCombobox Items="_frameworks" Disabled DefaultValue='@("Astro")'>
            <BzComboboxInput Placeholder="Select a framework" Class="w-64" />
            <BzComboboxContent>
                <BzComboboxEmpty>No framework found.</BzComboboxEmpty>
                <BzComboboxList Context="item">
                    <BzComboboxItem Value="@item">@item</BzComboboxItem>
                </BzComboboxList>
            </BzComboboxContent>
        </BzCombobox>
    </Demo>

    <Demo Title="RTL" Description="Inside a right-to-left DirectionProvider the field, popup and check all mirror; the highlight and filtering behave the same." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzCombobox Items="_arabicFrameworks">
                <BzComboboxInput Placeholder="اختر إطار عمل" Class="w-64" />
                <BzComboboxContent>
                    <BzComboboxEmpty>لا توجد نتائج.</BzComboboxEmpty>
                    <BzComboboxList Context="item">
                        <BzComboboxItem Value="@item">@item</BzComboboxItem>
                    </BzComboboxList>
                </BzComboboxContent>
            </BzCombobox>
        </BzDirectionProvider>
    </Demo>

    <ApiReference Types="ApiFamilies.Combobox" />
</div>

