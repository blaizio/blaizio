@page "/components/sidebar"
<PageTitle>Sidebar - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Sidebar</h1>
        <p class="text-muted-foreground">A composable application sidebar. Wrap your layout in a BzSidebarProvider, then build the panel from a header, scrollable content (groups and menus), and a footer. It collapses to an icon rail or slides off-canvas, becomes a Sheet on mobile, persists its state to a cookie, and toggles with Ctrl/Cmd+B.</p>
    </header>

    <UsageBlock Setup="@UsageSetup" Code="@UsageMarkup"
                Description="Wrap the page in a BzSidebarProvider, put a BzSidebar (header / content / footer) beside a BzSidebarInset, and drop a BzSidebarTrigger in the inset to toggle it." />

    <CompositionTree Root="_anatomy"
                     Description="The provider owns the state; the sidebar holds a header, a scrollable content area of groups and menus, and a footer; the inset is the page beside it." />

    <ExamplesHeading />

    <Demo Title="Default" Description="An off-canvas sidebar: the trigger (or Ctrl/Cmd+B) collapses it fully off the edge and the inset reclaims the space. Click a row to make it the active page. The demos are framed in a contained box; in your app the provider wraps the whole screen." Code="@DefaultCode">
        @DemoShell(SidebarCollapsible.Offcanvas, SidebarSide.Start, SidebarVariant.Sidebar, false)
    </Demo>

    <Demo Title="Collapse to icons" Description="With Collapsible=Icon the sidebar shrinks to a narrow rail of icons instead of vanishing - labels hide, rows become square, and each row reveals its label as a tooltip on hover (set Tooltip on the menu button). Toggle it to see the rail." Code="@IconCode">
        @DemoShell(SidebarCollapsible.Icon, SidebarSide.Start, SidebarVariant.Sidebar, true)
    </Demo>

    <Demo Title="Variants" Description="Three surfaces. Sidebar is flush to the edge; Floating detaches into a rounded, bordered card; Inset pairs a flush sidebar with a lifted content card (collapse to icons here too)." Code="@VariantsCode">
        <div class="grid gap-4 lg:grid-cols-2">
            <div>
                <p class="text-muted-foreground mb-2 text-xs font-medium">Floating</p>
                @DemoShell(SidebarCollapsible.Icon, SidebarSide.Start, SidebarVariant.Floating, true)
            </div>
            <div>
                <p class="text-muted-foreground mb-2 text-xs font-medium">Inset</p>
                @DemoShell(SidebarCollapsible.Icon, SidebarSide.Start, SidebarVariant.Inset, true)
            </div>
        </div>
    </Demo>

    <Demo Title="Submenus, actions and badges" Description="Nest a BzSidebarMenuSub under a row for child links, pin a BzSidebarMenuBadge (e.g. a count) to a row, and add a BzSidebarMenuAction for a trailing button. A group can carry a BzSidebarGroupAction in its corner." Code="@RichCode">
        <div class="relative h-[480px] w-full overflow-hidden rounded-xl border [transform:translateZ(0)]">
            <BzSidebarProvider Class="h-full min-h-0">
                <BzSidebar Class="h-full">
                    <BzSidebarContent>
                        <BzSidebarGroup>
                            <BzSidebarGroupLabel>Projects</BzSidebarGroupLabel>
                            <BzSidebarGroupAction title="Add project"><BzIcon Icon="@Icons.Outline.Plus" /></BzSidebarGroupAction>
                            <BzSidebarGroupContent>
                                <BzSidebarMenu>
                                    <BzSidebarMenuItem>
                                        <BzSidebarMenuButton IsActive="true"><BzIcon Icon="@Icons.Outline.Folder" /><span>Design system</span></BzSidebarMenuButton>
                                        <BzSidebarMenuBadge>12</BzSidebarMenuBadge>
                                        <BzSidebarMenuSub>
                                            <BzSidebarMenuSubItem><BzSidebarMenuSubButton IsActive="true">Foundations</BzSidebarMenuSubButton></BzSidebarMenuSubItem>
                                            <BzSidebarMenuSubItem><BzSidebarMenuSubButton>Components</BzSidebarMenuSubButton></BzSidebarMenuSubItem>
                                            <BzSidebarMenuSubItem><BzSidebarMenuSubButton>Tokens</BzSidebarMenuSubButton></BzSidebarMenuSubItem>
                                        </BzSidebarMenuSub>
                                    </BzSidebarMenuItem>
                                    <BzSidebarMenuItem>
                                        <BzSidebarMenuButton><BzIcon Icon="@Icons.Outline.ChartBar" /><span>Analytics</span></BzSidebarMenuButton>
                                        <BzSidebarMenuAction ShowOnHover="true" title="More"><BzIcon Icon="@Icons.Outline.DotsVertical" /></BzSidebarMenuAction>
                                    </BzSidebarMenuItem>
                                    <BzSidebarMenuItem>
                                        <BzSidebarMenuButton><BzIcon Icon="@Icons.Outline.FileText" /><span>Reports</span></BzSidebarMenuButton>
                                        <BzSidebarMenuBadge>3</BzSidebarMenuBadge>
                                    </BzSidebarMenuItem>
                                </BzSidebarMenu>
                            </BzSidebarGroupContent>
                        </BzSidebarGroup>
                    </BzSidebarContent>
                </BzSidebar>
                <BzSidebarInset>
                    <header class="flex h-12 items-center gap-2 border-b px-3"><BzSidebarTrigger /><span class="text-sm font-medium">Projects</span></header>
                </BzSidebarInset>
            </BzSidebarProvider>
        </div>
    </Demo>

    <Demo Title="Loading state" Description="Render a stack of BzSidebarMenuSkeleton while the menu data loads - each gets a randomised text width so the placeholder reads naturally. Set ShowIcon for a leading icon block." Code="@SkeletonCode">
        <div class="relative h-[360px] w-full overflow-hidden rounded-xl border [transform:translateZ(0)]">
            <BzSidebarProvider Class="h-full min-h-0">
                <BzSidebar Class="h-full">
                    <BzSidebarContent>
                        <BzSidebarGroup>
                            <BzSidebarGroupLabel>Workspace</BzSidebarGroupLabel>
                            <BzSidebarGroupContent>
                                <BzSidebarMenu>
                                    @for (var i = 0; i < 6; i++)
                                    {
                                        <BzSidebarMenuItem><BzSidebarMenuSkeleton ShowIcon="true" /></BzSidebarMenuItem>
                                    }
                                </BzSidebarMenu>
                            </BzSidebarGroupContent>
                        </BzSidebarGroup>
                    </BzSidebarContent>
                </BzSidebar>
                <BzSidebarInset>
                    <header class="flex h-12 items-center gap-2 border-b px-3"><BzSidebarTrigger /><span class="text-sm font-medium">Loading…</span></header>
                </BzSidebarInset>
            </BzSidebarProvider>
        </div>
    </Demo>

    <Demo Title="End side" Description="Anchor the sidebar to the inline-end edge with Side=End - the panel, its border and its collapse direction all flip to the other side." Code="@EndCode">
        @DemoShell(SidebarCollapsible.Offcanvas, SidebarSide.End, SidebarVariant.Sidebar, false)
    </Demo>

    <Demo Title="Controlled" Description="Bind the open state two-way to drive the sidebar from your own state, or read it. The keyboard shortcut and the trigger update the same value." Code="@ControlledCode">
        <div class="space-y-3">
            <div class="flex items-center gap-3">
                <BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" @onclick="@(() => _open = !_open)">Toggle from code</BzButton>
                <span class="text-muted-foreground text-sm">Open: <span class="text-foreground font-mono">@_open</span></span>
            </div>
            <div class="relative h-[400px] w-full overflow-hidden rounded-xl border [transform:translateZ(0)]">
                <BzSidebarProvider @bind-Open="_open" PersistState="false" Class="h-full min-h-0">
                    <BzSidebar Class="h-full">
                        <BzSidebarContent>
                            <BzSidebarGroup>
                                <BzSidebarGroupContent>
                                    <BzSidebarMenu>
                                        <BzSidebarMenuItem><BzSidebarMenuButton IsActive="true"><BzIcon Icon="@Icons.Outline.Home" /><span>Home</span></BzSidebarMenuButton></BzSidebarMenuItem>
                                        <BzSidebarMenuItem><BzSidebarMenuButton><BzIcon Icon="@Icons.Outline.Search" /><span>Explore</span></BzSidebarMenuButton></BzSidebarMenuItem>
                                    </BzSidebarMenu>
                                </BzSidebarGroupContent>
                            </BzSidebarGroup>
                        </BzSidebarContent>
                    </BzSidebar>
                    <BzSidebarInset>
                        <header class="flex h-12 items-center gap-2 border-b px-3"><BzSidebarTrigger /><span class="text-sm font-medium">Controlled</span></header>
                    </BzSidebarInset>
                </BzSidebarProvider>
            </div>
        </div>
    </Demo>

    <Demo Title="Customization" Description="The whole surface is themable: set the panel width on the provider, and restyle any part via Class - here a branded gradient header and an indigo active row - merged over the defaults." Code="@CustomCode">
        <div class="relative h-[440px] w-full overflow-hidden rounded-xl border [transform:translateZ(0)]">
            <BzSidebarProvider Width="15rem" Class="h-full min-h-0">
                <BzSidebar Class="h-full">
                    <BzSidebarHeader>
                        <div class="mx-1 mt-1 rounded-lg bg-gradient-to-br from-indigo-500 to-violet-600 px-3 py-2 text-sm font-semibold text-white">Acme Studio</div>
                    </BzSidebarHeader>
                    <BzSidebarContent>
                        <BzSidebarGroup>
                            <BzSidebarGroupLabel>Workspace</BzSidebarGroupLabel>
                            <BzSidebarGroupContent>
                                <BzSidebarMenu>
                                    <BzSidebarMenuItem>
                                        <BzSidebarMenuButton IsActive="true" Class="data-[active=true]:bg-indigo-500/10 data-[active=true]:text-indigo-600 dark:data-[active=true]:text-indigo-400">
                                            <BzIcon Icon="@Icons.Outline.Home" /><span>Home</span>
                                        </BzSidebarMenuButton>
                                    </BzSidebarMenuItem>
                                    <BzSidebarMenuItem>
                                        <BzSidebarMenuButton Class="data-[active=true]:bg-indigo-500/10 data-[active=true]:text-indigo-600">
                                            <BzIcon Icon="@Icons.Outline.ChartBar" /><span>Analytics</span>
                                        </BzSidebarMenuButton>
                                    </BzSidebarMenuItem>
                                    <BzSidebarMenuItem>
                                        <BzSidebarMenuButton Class="data-[active=true]:bg-indigo-500/10 data-[active=true]:text-indigo-600">
                                            <BzIcon Icon="@Icons.Outline.Settings" /><span>Settings</span>
                                        </BzSidebarMenuButton>
                                    </BzSidebarMenuItem>
                                </BzSidebarMenu>
                            </BzSidebarGroupContent>
                        </BzSidebarGroup>
                    </BzSidebarContent>
                </BzSidebar>
                <BzSidebarInset>
                    <header class="flex h-12 items-center gap-2 border-b px-3"><BzSidebarTrigger /><span class="text-sm font-medium">Custom</span></header>
                </BzSidebarInset>
            </BzSidebarProvider>
        </div>
    </Demo>

    <Demo Title="RTL" Description="Side is logical (Start/End), so under a right-to-left DirectionProvider a Start sidebar mirrors to the right edge and the content flows right-to-left - no extra configuration." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <div class="relative h-[440px] w-full overflow-hidden rounded-xl border [transform:translateZ(0)]">
                <BzSidebarProvider Class="h-full min-h-0">
                    <BzSidebar Class="h-full">
                        <BzSidebarHeader>
                            <div class="px-2 py-1.5 text-sm font-semibold">القائمة</div>
                        </BzSidebarHeader>
                        <BzSidebarContent>
                            <BzSidebarGroup>
                                <BzSidebarGroupLabel>التنقل</BzSidebarGroupLabel>
                                <BzSidebarGroupContent>
                                    <BzSidebarMenu>
                                        <BzSidebarMenuItem><BzSidebarMenuButton IsActive="true"><BzIcon Icon="@Icons.Outline.Home" /><span>الرئيسية</span></BzSidebarMenuButton></BzSidebarMenuItem>
                                        <BzSidebarMenuItem><BzSidebarMenuButton><BzIcon Icon="@Icons.Outline.Mail" /><span>الرسائل</span></BzSidebarMenuButton></BzSidebarMenuItem>
                                        <BzSidebarMenuItem><BzSidebarMenuButton><BzIcon Icon="@Icons.Outline.Settings" /><span>الإعدادات</span></BzSidebarMenuButton></BzSidebarMenuItem>
                                    </BzSidebarMenu>
                                </BzSidebarGroupContent>
                            </BzSidebarGroup>
                        </BzSidebarContent>
                    </BzSidebar>
                    <BzSidebarInset>
                        <header class="flex h-12 items-center gap-2 border-b px-3"><BzSidebarTrigger /><span class="text-sm font-medium">لوحة التحكم</span></header>
                    </BzSidebarInset>
                </BzSidebarProvider>
            </div>
        </BzDirectionProvider>
    </Demo>

</div>

@code {
    private bool _open = true;
    private string _active = "Home";

    private static readonly (string Label, Icon Icon)[] _nav =
    [
        ("Home", Icons.Outline.Home),
        ("Inbox", Icons.Outline.Mail),
        ("Calendar", Icons.Outline.Calendar),
        ("Search", Icons.Outline.Search),
        ("Settings", Icons.Outline.Settings),
    ];

    // A self-contained sidebar+inset framed in a transform-contained box (so the fixed panel stays
    // inside the demo). Parameterised so several demos can reuse it.
    private RenderFragment DemoShell(SidebarCollapsible collapsible, SidebarSide side, SidebarVariant variant, bool tooltips) => @<text>
        <div class="relative h-[480px] w-full overflow-hidden rounded-xl border [transform:translateZ(0)]">
            <BzSidebarProvider Class="h-full min-h-0">
                <BzSidebar Side="side" Variant="variant" Collapsible="collapsible" Class="h-full">
                    <BzSidebarHeader>
                        <div class="flex items-center gap-2 px-1 py-1.5">
                            <div class="bg-sidebar-primary text-sidebar-primary-foreground flex aspect-square size-8 items-center justify-center rounded-lg">
                                <BzIcon Icon="@Icons.Outline.LayoutDashboard" />
                            </div>
                            <div class="grid flex-1 text-start text-sm leading-tight group-data-[collapsible=icon]:hidden">
                                <span class="truncate font-semibold">Acme Inc</span>
                                <span class="text-muted-foreground truncate text-xs">Enterprise</span>
                            </div>
                        </div>
                    </BzSidebarHeader>
                    <BzSidebarContent>
                        <BzSidebarGroup>
                            <BzSidebarGroupLabel>Platform</BzSidebarGroupLabel>
                            <BzSidebarGroupContent>
                                <BzSidebarMenu>
                                    @foreach (var (label, icon) in _nav)
                                    {
                                        <BzSidebarMenuItem>
                                            <BzSidebarMenuButton IsActive="@(_active == label)"
                                                                 Tooltip="@(tooltips ? label : null)"
                                                                 @onclick="@(() => _active = label)">
                                                <BzIcon Icon="@icon" />
                                                <span>@label</span>
                                            </BzSidebarMenuButton>
                                        </BzSidebarMenuItem>
                                    }
                                </BzSidebarMenu>
                            </BzSidebarGroupContent>
                        </BzSidebarGroup>
                    </BzSidebarContent>
                    <BzSidebarFooter>
                        <BzSidebarMenu>
                            <BzSidebarMenuItem>
                                <BzSidebarMenuButton Size="SidebarMenuButtonSize.Lg" Tooltip="@(tooltips ? "Ada Lovelace" : null)">
                                    <BzIcon Icon="@Icons.Outline.User" />
                                    <div class="grid flex-1 text-start text-sm leading-tight group-data-[collapsible=icon]:hidden">
                                        <span class="truncate font-medium">Ada Lovelace</span>
                                        <span class="text-muted-foreground truncate text-xs">ada@@example.com</span>
                                    </div>
                                </BzSidebarMenuButton>
                            </BzSidebarMenuItem>
                        </BzSidebarMenu>
                    </BzSidebarFooter>
                    <BzSidebarRail />
                </BzSidebar>
                <BzSidebarInset>
                    <header class="flex h-12 items-center gap-2 border-b px-3">
                        <BzSidebarTrigger />
                        <BzSeparator Orientation="Orientation.Vertical" Class="h-4" />
                        <span class="text-sm font-medium">@_active</span>
                    </header>
                    <div class="text-muted-foreground p-4 text-sm">Selected: <span class="text-foreground font-medium">@_active</span></div>
                </BzSidebarInset>
            </BzSidebarProvider>
        </div>
    </text>;

    private static readonly CompositionNode _anatomy = new CompositionNode("BzSidebarProvider",
        new CompositionNode("BzSidebar",
            new CompositionNode("BzSidebarHeader"),
            new CompositionNode("BzSidebarContent",
                new CompositionNode("BzSidebarGroup",
                    new CompositionNode("BzSidebarGroupLabel"),
                    new CompositionNode("BzSidebarGroupContent",
                        new CompositionNode("BzSidebarMenu",
                            new CompositionNode("BzSidebarMenuItem",
                                new CompositionNode("BzSidebarMenuButton")))))),
            new CompositionNode("BzSidebarFooter"),
            new CompositionNode("BzSidebarRail")),
        new CompositionNode("BzSidebarInset",
            new CompositionNode("BzSidebarTrigger")));

    private const string UsageSetup = """
        @* _Imports.razor (or the top of the page) *@
        @using Blazeo.Ui
        """;

    private const string UsageMarkup = """
        <BzSidebarProvider>
            <BzSidebar>
                <BzSidebarHeader>Acme Inc</BzSidebarHeader>
                <BzSidebarContent>
                    <BzSidebarGroup>
                        <BzSidebarGroupLabel>Platform</BzSidebarGroupLabel>
                        <BzSidebarGroupContent>
                            <BzSidebarMenu>
                                <BzSidebarMenuItem>
                                    <BzSidebarMenuButton IsActive="true">
                                        <BzIcon Icon="@Icons.Outline.Home" />
                                        <span>Home</span>
                                    </BzSidebarMenuButton>
                                </BzSidebarMenuItem>
                            </BzSidebarMenu>
                        </BzSidebarGroupContent>
                    </BzSidebarGroup>
                </BzSidebarContent>
                <BzSidebarRail />
            </BzSidebar>
            <BzSidebarInset>
                <header class="flex h-12 items-center gap-2 border-b px-3">
                    <BzSidebarTrigger />
                    <span class="text-sm font-medium">Dashboard</span>
                </header>
                <div class="p-4">Your page content.</div>
            </BzSidebarInset>
        </BzSidebarProvider>
        """;

    private const string DefaultCode = """
        @* The provider wraps the whole screen; here it's framed in a contained box for the demo. *@
        <BzSidebarProvider>
            <BzSidebar Collapsible="SidebarCollapsible.Offcanvas">
                <BzSidebarHeader>Acme Inc</BzSidebarHeader>
                <BzSidebarContent>
                    <BzSidebarGroup>
                        <BzSidebarGroupLabel>Platform</BzSidebarGroupLabel>
                        <BzSidebarGroupContent>
                            <BzSidebarMenu>
                                @foreach (var (label, icon) in _nav)
                                {
                                    <BzSidebarMenuItem>
                                        <BzSidebarMenuButton IsActive="@(_active == label)" @onclick="@(() => _active = label)">
                                            <BzIcon Icon="@icon" />
                                            <span>@label</span>
                                        </BzSidebarMenuButton>
                                    </BzSidebarMenuItem>
                                }
                            </BzSidebarMenu>
                        </BzSidebarGroupContent>
                    </BzSidebarGroup>
                </BzSidebarContent>
                <BzSidebarRail />
            </BzSidebar>
            <BzSidebarInset>
                <header class="flex h-12 items-center gap-2 border-b px-3">
                    <BzSidebarTrigger />
                    <span class="text-sm font-medium">@_active</span>
                </header>
            </BzSidebarInset>
        </BzSidebarProvider>

        @code {
            private string _active = "Home";
            private (string Label, Icon Icon)[] _nav =
            [
                ("Home", Icons.Outline.Home),
                ("Inbox", Icons.Outline.Mail),
                ("Settings", Icons.Outline.Settings),
            ];
        }
        """;

    private const string IconCode = """
        @* Collapsible=Icon shrinks to a rail; set Tooltip so each row shows its label when collapsed. *@
        <BzSidebarProvider>
            <BzSidebar Collapsible="SidebarCollapsible.Icon">
                <BzSidebarContent>
                    <BzSidebarGroup>
                        <BzSidebarGroupLabel>Platform</BzSidebarGroupLabel>
                        <BzSidebarGroupContent>
                            <BzSidebarMenu>
                                <BzSidebarMenuItem>
                                    <BzSidebarMenuButton IsActive="true" Tooltip="Home">
                                        <BzIcon Icon="@Icons.Outline.Home" />
                                        <span>Home</span>
                                    </BzSidebarMenuButton>
                                </BzSidebarMenuItem>
                                <BzSidebarMenuItem>
                                    <BzSidebarMenuButton Tooltip="Settings">
                                        <BzIcon Icon="@Icons.Outline.Settings" />
                                        <span>Settings</span>
                                    </BzSidebarMenuButton>
                                </BzSidebarMenuItem>
                            </BzSidebarMenu>
                        </BzSidebarGroupContent>
                    </BzSidebarGroup>
                </BzSidebarContent>
                <BzSidebarRail />
            </BzSidebar>
            <BzSidebarInset>
                <header class="flex h-12 items-center gap-2 border-b px-3"><BzSidebarTrigger /></header>
            </BzSidebarInset>
        </BzSidebarProvider>
        """;

    private const string VariantsCode = """
        @* Variant controls the surface: Sidebar (flush), Floating (detached card), Inset (lifted content). *@
        <BzSidebarProvider>
            <BzSidebar Variant="SidebarVariant.Floating" Collapsible="SidebarCollapsible.Icon">
                @* … header / content / footer … *@
            </BzSidebar>
            <BzSidebarInset>
                <header class="flex h-12 items-center border-b px-3"><BzSidebarTrigger /></header>
            </BzSidebarInset>
        </BzSidebarProvider>

        @* For the lifted-content look, use Variant="SidebarVariant.Inset" on the sidebar. *@
        """;

    private const string RichCode = """
        <BzSidebarMenu>
            <BzSidebarMenuItem>
                <BzSidebarMenuButton IsActive="true">
                    <BzIcon Icon="@Icons.Outline.Folder" /><span>Design system</span>
                </BzSidebarMenuButton>
                <BzSidebarMenuBadge>12</BzSidebarMenuBadge>
                <BzSidebarMenuSub>
                    <BzSidebarMenuSubItem><BzSidebarMenuSubButton IsActive="true">Foundations</BzSidebarMenuSubButton></BzSidebarMenuSubItem>
                    <BzSidebarMenuSubItem><BzSidebarMenuSubButton>Components</BzSidebarMenuSubButton></BzSidebarMenuSubItem>
                </BzSidebarMenuSub>
            </BzSidebarMenuItem>
            <BzSidebarMenuItem>
                <BzSidebarMenuButton><BzIcon Icon="@Icons.Outline.ChartBar" /><span>Analytics</span></BzSidebarMenuButton>
                <BzSidebarMenuAction ShowOnHover="true" title="More"><BzIcon Icon="@Icons.Outline.DotsVertical" /></BzSidebarMenuAction>
            </BzSidebarMenuItem>
        </BzSidebarMenu>

        @* A group can carry an action in its corner: *@
        <BzSidebarGroup>
            <BzSidebarGroupLabel>Projects</BzSidebarGroupLabel>
            <BzSidebarGroupAction title="Add project"><BzIcon Icon="@Icons.Outline.Plus" /></BzSidebarGroupAction>
            <BzSidebarGroupContent>@* … *@</BzSidebarGroupContent>
        </BzSidebarGroup>
        """;

    private const string SkeletonCode = """
        <BzSidebarMenu>
            @for (var i = 0; i < 6; i++)
            {
                <BzSidebarMenuItem>
                    <BzSidebarMenuSkeleton ShowIcon="true" />
                </BzSidebarMenuItem>
            }
        </BzSidebarMenu>
        """;

    private const string EndCode = """
        <BzSidebarProvider>
            <BzSidebar Side="SidebarSide.End">
                @* … header / content / footer … *@
                <BzSidebarRail />
            </BzSidebar>
            <BzSidebarInset>
                <header class="flex h-12 items-center border-b px-3"><BzSidebarTrigger /></header>
            </BzSidebarInset>
        </BzSidebarProvider>
        """;

    private const string CustomCode = """
        @* Set the width on the provider; restyle any part via Class (merged over the defaults). *@
        <BzSidebarProvider Width="15rem">
            <BzSidebar>
                <BzSidebarHeader>
                    <div class="rounded-lg bg-gradient-to-br from-indigo-500 to-violet-600 px-3 py-2 text-sm font-semibold text-white">Acme Studio</div>
                </BzSidebarHeader>
                <BzSidebarContent>
                    <BzSidebarGroup>
                        <BzSidebarGroupLabel>Workspace</BzSidebarGroupLabel>
                        <BzSidebarGroupContent>
                            <BzSidebarMenu>
                                <BzSidebarMenuItem>
                                    <BzSidebarMenuButton IsActive="true" Class="data-[active=true]:bg-indigo-500/10 data-[active=true]:text-indigo-600">
                                        <BzIcon Icon="@Icons.Outline.Home" /><span>Home</span>
                                    </BzSidebarMenuButton>
                                </BzSidebarMenuItem>
                            </BzSidebarMenu>
                        </BzSidebarGroupContent>
                    </BzSidebarGroup>
                </BzSidebarContent>
            </BzSidebar>
            <BzSidebarInset>
                <header class="flex h-12 items-center gap-2 border-b px-3"><BzSidebarTrigger /></header>
            </BzSidebarInset>
        </BzSidebarProvider>
        """;

    private const string RtlCode = """
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzSidebarProvider>
                <BzSidebar>
                    <BzSidebarHeader>القائمة</BzSidebarHeader>
                    <BzSidebarContent>
                        <BzSidebarGroup>
                            <BzSidebarGroupLabel>التنقل</BzSidebarGroupLabel>
                            <BzSidebarGroupContent>
                                <BzSidebarMenu>
                                    <BzSidebarMenuItem>
                                        <BzSidebarMenuButton IsActive="true">
                                            <BzIcon Icon="@Icons.Outline.Home" /><span>الرئيسية</span>
                                        </BzSidebarMenuButton>
                                    </BzSidebarMenuItem>
                                </BzSidebarMenu>
                            </BzSidebarGroupContent>
                        </BzSidebarGroup>
                    </BzSidebarContent>
                </BzSidebar>
                <BzSidebarInset>
                    <header class="flex h-12 items-center gap-2 border-b px-3"><BzSidebarTrigger /></header>
                </BzSidebarInset>
            </BzSidebarProvider>
        </BzDirectionProvider>
        """;

    private const string ControlledCode = """
        <BzButton @onclick="@(() => _open = !_open)">Toggle from code</BzButton>
        <span>Open: @_open</span>

        <BzSidebarProvider @bind-Open="_open">
            <BzSidebar>
                @* … content … *@
            </BzSidebar>
            <BzSidebarInset>
                <header class="flex h-12 items-center border-b px-3"><BzSidebarTrigger /></header>
            </BzSidebarInset>
        </BzSidebarProvider>

        @code { private bool _open = true; }
        """;
