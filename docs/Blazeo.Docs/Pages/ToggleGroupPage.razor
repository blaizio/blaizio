@page "/components/toggle-group"
<PageTitle>Toggle Group - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Toggle Group</h1>
        <p class="text-muted-foreground">A set of two-state buttons that can be toggled on or off.</p>
    </header>

    <Demo Title="Default" Description="Multiple mode - any number of items can be on at once." Code="@DefaultCode">
        <BzToggleGroup Type="ToggleGroupType.Multiple" DefaultValues="@(["bold"])">
            <BzToggleGroupItem Value="bold" aria-label="Toggle bold"><BzIcon Icon="@Icons.Outline.Bold" /></BzToggleGroupItem>
            <BzToggleGroupItem Value="italic" aria-label="Toggle italic"><BzIcon Icon="@Icons.Outline.Italic" /></BzToggleGroupItem>
            <BzToggleGroupItem Value="strike" aria-label="Toggle strikethrough"><BzIcon Icon="@Icons.Outline.Strikethrough" /></BzToggleGroupItem>
        </BzToggleGroup>
    </Demo>

    <Demo Title="Outline" Description="The outline variant set on the group applies to every item." Code="@OutlineCode">
        <BzToggleGroup Type="ToggleGroupType.Multiple" Variant="ToggleVariant.Outline">
            <BzToggleGroupItem Value="bold" aria-label="Toggle bold"><BzIcon Icon="@Icons.Outline.Bold" /></BzToggleGroupItem>
            <BzToggleGroupItem Value="italic" aria-label="Toggle italic"><BzIcon Icon="@Icons.Outline.Italic" /></BzToggleGroupItem>
            <BzToggleGroupItem Value="strike" aria-label="Toggle strikethrough"><BzIcon Icon="@Icons.Outline.Strikethrough" /></BzToggleGroupItem>
        </BzToggleGroup>
    </Demo>

    <Demo Title="Single" Description="Single mode - at most one item is on; pressing it again clears it." Code="@SingleCode">
        <BzToggleGroup DefaultValue="center">
            <BzToggleGroupItem Value="left" aria-label="Align left"><BzIcon Icon="@Icons.Outline.AlignLeft" /></BzToggleGroupItem>
            <BzToggleGroupItem Value="center" aria-label="Align center"><BzIcon Icon="@Icons.Outline.AlignCenter" /></BzToggleGroupItem>
            <BzToggleGroupItem Value="right" aria-label="Align right"><BzIcon Icon="@Icons.Outline.AlignRight" /></BzToggleGroupItem>
        </BzToggleGroup>
    </Demo>

    <Demo Title="Sizes" Code="@SizesCode">
        <div class="flex flex-col items-center gap-4">
            <BzToggleGroup Type="ToggleGroupType.Multiple" Variant="ToggleVariant.Outline" Size="ToggleSize.Sm">
                <BzToggleGroupItem Value="bold" aria-label="Toggle bold"><BzIcon Icon="@Icons.Outline.Bold" /></BzToggleGroupItem>
                <BzToggleGroupItem Value="italic" aria-label="Toggle italic"><BzIcon Icon="@Icons.Outline.Italic" /></BzToggleGroupItem>
            </BzToggleGroup>
            <BzToggleGroup Type="ToggleGroupType.Multiple" Variant="ToggleVariant.Outline" Size="ToggleSize.Lg">
                <BzToggleGroupItem Value="bold" aria-label="Toggle bold"><BzIcon Icon="@Icons.Outline.Bold" /></BzToggleGroupItem>
                <BzToggleGroupItem Value="italic" aria-label="Toggle italic"><BzIcon Icon="@Icons.Outline.Italic" /></BzToggleGroupItem>
            </BzToggleGroup>
        </div>
    </Demo>

    <Demo Title="Disabled" Code="@DisabledCode">
        <BzToggleGroup Type="ToggleGroupType.Multiple" Disabled>
            <BzToggleGroupItem Value="bold" aria-label="Toggle bold"><BzIcon Icon="@Icons.Outline.Bold" /></BzToggleGroupItem>
            <BzToggleGroupItem Value="italic" aria-label="Toggle italic"><BzIcon Icon="@Icons.Outline.Italic" /></BzToggleGroupItem>
        </BzToggleGroup>
    </Demo>

    <Demo Title="Controlled" Description="Bind the single-mode value two-way; deselecting reports null." Code="@ControlledCode">
        <div class="flex flex-col items-center gap-3">
            <BzToggleGroup @bind-Value="_align" Variant="ToggleVariant.Outline">
                <BzToggleGroupItem Value="left" aria-label="Align left"><BzIcon Icon="@Icons.Outline.AlignLeft" /></BzToggleGroupItem>
                <BzToggleGroupItem Value="center" aria-label="Align center"><BzIcon Icon="@Icons.Outline.AlignCenter" /></BzToggleGroupItem>
                <BzToggleGroupItem Value="right" aria-label="Align right"><BzIcon Icon="@Icons.Outline.AlignRight" /></BzToggleGroupItem>
            </BzToggleGroup>
            <p class="text-sm text-muted-foreground">Alignment: <span class="font-mono">@(_align ?? "none")</span></p>
        </div>
    </Demo>
    <Demo Title="Looping" Description="Arrow keys wrap from the last item back to the first by default. Set Loop to false to stop at the ends instead. Focus an item and hold the arrow key to feel the difference." Code="@LoopCode">
        <div class="flex flex-col items-start gap-8 sm:flex-row sm:items-center sm:gap-16">
            <div class="space-y-2">
                <p class="text-sm font-medium">Loops (default)</p>
                <BzToggleGroup Type="ToggleGroupType.Multiple" Variant="ToggleVariant.Outline">
                    <BzToggleGroupItem Value="bold" aria-label="Toggle bold"><BzIcon Icon="@Icons.Outline.Bold" /></BzToggleGroupItem>
                    <BzToggleGroupItem Value="italic" aria-label="Toggle italic"><BzIcon Icon="@Icons.Outline.Italic" /></BzToggleGroupItem>
                    <BzToggleGroupItem Value="strike" aria-label="Toggle strikethrough"><BzIcon Icon="@Icons.Outline.Strikethrough" /></BzToggleGroupItem>
                </BzToggleGroup>
            </div>
            <div class="space-y-2">
                <p class="text-sm font-medium">Stops (Loop = false)</p>
                <BzToggleGroup Type="ToggleGroupType.Multiple" Variant="ToggleVariant.Outline" Loop="false">
                    <BzToggleGroupItem Value="bold" aria-label="Toggle bold"><BzIcon Icon="@Icons.Outline.Bold" /></BzToggleGroupItem>
                    <BzToggleGroupItem Value="italic" aria-label="Toggle italic"><BzIcon Icon="@Icons.Outline.Italic" /></BzToggleGroupItem>
                    <BzToggleGroupItem Value="strike" aria-label="Toggle strikethrough"><BzIcon Icon="@Icons.Outline.Strikethrough" /></BzToggleGroupItem>
                </BzToggleGroup>
            </div>
        </div>
    </Demo>
    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic aria-labels - the items lay out from the right." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzToggleGroup DefaultValue="center">
                <BzToggleGroupItem Value="left" aria-label="محاذاة لليسار"><BzIcon Icon="@Icons.Outline.AlignLeft" /></BzToggleGroupItem>
                <BzToggleGroupItem Value="center" aria-label="محاذاة للوسط"><BzIcon Icon="@Icons.Outline.AlignCenter" /></BzToggleGroupItem>
                <BzToggleGroupItem Value="right" aria-label="محاذاة لليمين"><BzIcon Icon="@Icons.Outline.AlignRight" /></BzToggleGroupItem>
            </BzToggleGroup>
        </BzDirectionProvider>
    </Demo>
    <ApiReference Types="ApiFamilies.ToggleGroup" />
</div>

@code {
    private string? _align = "left";

    private const string DefaultCode = """
        <BzToggleGroup Type="ToggleGroupType.Multiple" DefaultValues="@(["bold"])">
            <BzToggleGroupItem Value="bold" aria-label="Toggle bold"><BzIcon Icon="@Icons.Outline.Bold" /></BzToggleGroupItem>
            <BzToggleGroupItem Value="italic" aria-label="Toggle italic"><BzIcon Icon="@Icons.Outline.Italic" /></BzToggleGroupItem>
            <BzToggleGroupItem Value="strike" aria-label="Toggle strikethrough"><BzIcon Icon="@Icons.Outline.Strikethrough" /></BzToggleGroupItem>
        </BzToggleGroup>
        """;

    private const string OutlineCode = """
        <BzToggleGroup Type="ToggleGroupType.Multiple" Variant="ToggleVariant.Outline">
            <BzToggleGroupItem Value="bold" aria-label="Toggle bold"><BzIcon Icon="@Icons.Outline.Bold" /></BzToggleGroupItem>
            <BzToggleGroupItem Value="italic" aria-label="Toggle italic"><BzIcon Icon="@Icons.Outline.Italic" /></BzToggleGroupItem>
            <BzToggleGroupItem Value="strike" aria-label="Toggle strikethrough"><BzIcon Icon="@Icons.Outline.Strikethrough" /></BzToggleGroupItem>
        </BzToggleGroup>
        """;

    private const string SingleCode = """
        <BzToggleGroup DefaultValue="center">
            <BzToggleGroupItem Value="left" aria-label="Align left"><BzIcon Icon="@Icons.Outline.AlignLeft" /></BzToggleGroupItem>
            <BzToggleGroupItem Value="center" aria-label="Align center"><BzIcon Icon="@Icons.Outline.AlignCenter" /></BzToggleGroupItem>
            <BzToggleGroupItem Value="right" aria-label="Align right"><BzIcon Icon="@Icons.Outline.AlignRight" /></BzToggleGroupItem>
        </BzToggleGroup>
        """;

    private const string SizesCode = """
        <BzToggleGroup Type="ToggleGroupType.Multiple" Variant="ToggleVariant.Outline" Size="ToggleSize.Sm">…</BzToggleGroup>
        <BzToggleGroup Type="ToggleGroupType.Multiple" Variant="ToggleVariant.Outline" Size="ToggleSize.Lg">…</BzToggleGroup>
        """;

    private const string DisabledCode = """
        <BzToggleGroup Type="ToggleGroupType.Multiple" Disabled>
            <BzToggleGroupItem Value="bold" aria-label="Toggle bold"><BzIcon Icon="@Icons.Outline.Bold" /></BzToggleGroupItem>
            <BzToggleGroupItem Value="italic" aria-label="Toggle italic"><BzIcon Icon="@Icons.Outline.Italic" /></BzToggleGroupItem>
        </BzToggleGroup>
        """;

    private const string ControlledCode = """
        <BzToggleGroup @bind-Value="_align" Variant="ToggleVariant.Outline">
            <BzToggleGroupItem Value="left" aria-label="Align left"><BzIcon Icon="@Icons.Outline.AlignLeft" /></BzToggleGroupItem>
            <BzToggleGroupItem Value="center" aria-label="Align center"><BzIcon Icon="@Icons.Outline.AlignCenter" /></BzToggleGroupItem>
            <BzToggleGroupItem Value="right" aria-label="Align right"><BzIcon Icon="@Icons.Outline.AlignRight" /></BzToggleGroupItem>
        </BzToggleGroup>

        @code { private string? _align = "left"; }
        """;

    private const string LoopCode = """
        @* Wraps from the last item back to the first (the default). *@
        <BzToggleGroup Type="ToggleGroupType.Multiple" Variant="ToggleVariant.Outline">
            <BzToggleGroupItem Value="bold" aria-label="Toggle bold"><BzIcon Icon="@Icons.Outline.Bold" /></BzToggleGroupItem>
            <BzToggleGroupItem Value="italic" aria-label="Toggle italic"><BzIcon Icon="@Icons.Outline.Italic" /></BzToggleGroupItem>
            <BzToggleGroupItem Value="strike" aria-label="Toggle strikethrough"><BzIcon Icon="@Icons.Outline.Strikethrough" /></BzToggleGroupItem>
        </BzToggleGroup>

        @* Stops at the ends instead. *@
        <BzToggleGroup Type="ToggleGroupType.Multiple" Variant="ToggleVariant.Outline" Loop="false">
            <BzToggleGroupItem Value="bold" aria-label="Toggle bold"><BzIcon Icon="@Icons.Outline.Bold" /></BzToggleGroupItem>
            <BzToggleGroupItem Value="italic" aria-label="Toggle italic"><BzIcon Icon="@Icons.Outline.Italic" /></BzToggleGroupItem>
            <BzToggleGroupItem Value="strike" aria-label="Toggle strikethrough"><BzIcon Icon="@Icons.Outline.Strikethrough" /></BzToggleGroupItem>
        </BzToggleGroup>
        """;

    private const string RtlCode = """
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzToggleGroup DefaultValue="center">
                <BzToggleGroupItem Value="left" aria-label="محاذاة لليسار"><BzIcon Icon="@Icons.Outline.AlignLeft" /></BzToggleGroupItem>
                <BzToggleGroupItem Value="center" aria-label="محاذاة للوسط"><BzIcon Icon="@Icons.Outline.AlignCenter" /></BzToggleGroupItem>
                <BzToggleGroupItem Value="right" aria-label="محاذاة لليمين"><BzIcon Icon="@Icons.Outline.AlignRight" /></BzToggleGroupItem>
            </BzToggleGroup>
        </BzDirectionProvider>
        """;
}
