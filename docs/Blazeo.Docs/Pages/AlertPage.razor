@page "/components/alert"
<PageTitle>Alert - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Alert</h1>
        <p class="text-muted-foreground">A callout for short, important messages. A leading <code class="rounded bg-muted px-1 text-xs">&lt;svg&gt;</code> aligns automatically.</p>
    </header>

    <UsageBlock Setup="@UsageSetup" Code="@UsageMarkup"
                Description="Add the using once, then compose an optional leading icon, a title, and a description inside the alert." />

    <CompositionTree Root="_anatomy"
                     Description="The full anatomy. The leading icon is optional; the description and a top-right action are optional too." />

    <ExamplesHeading />

    <Demo Title="Default" Code="@DefaultCode">
        <BzAlert class="max-w-md">
            <BzIcon Icon="@Icons.Outline.InfoCircle" />
            <BzAlertTitle>Heads up!</BzAlertTitle>
            <BzAlertDescription>You can add components to your app using the Blazeo CLI.</BzAlertDescription>
        </BzAlert>
    </Demo>

    <Demo Title="Title only" Description="A description is optional." Code="@TitleOnlyCode">
        <BzAlert class="max-w-md">
            <BzIcon Icon="@Icons.Outline.CircleCheck" />
            <BzAlertTitle>Your changes have been saved.</BzAlertTitle>
        </BzAlert>
    </Demo>

    <Demo Title="Without icon" Code="@NoIconCode">
        <BzAlert class="max-w-md">
            <BzAlertTitle>Scheduled maintenance</BzAlertTitle>
            <BzAlertDescription>The service will be briefly unavailable on Sunday at 02:00 UTC.</BzAlertDescription>
        </BzAlert>
    </Demo>

    <Demo Title="Destructive" Code="@DestructiveCode">
        <BzAlert Variant="AlertVariant.Destructive" class="max-w-md">
            <BzIcon Icon="@Icons.Outline.AlertTriangle" />
            <BzAlertTitle>Something went wrong</BzAlertTitle>
            <BzAlertDescription>Your session has expired. Please log in again to continue.</BzAlertDescription>
        </BzAlert>
    </Demo>
    <Demo Title="Customization"
          Description="Recolor the whole callout via Class - an emerald tint, border, text, and a larger radius. Utilities win over the skin, so these take effect."
          Code="@CustomCode">
        <BzAlert Class="max-w-md rounded-xl border-emerald-300 bg-emerald-50 text-emerald-900 dark:border-emerald-900 dark:bg-emerald-950/50 dark:text-emerald-100">
            <BzIcon Icon="@Icons.Outline.CircleCheck" />
            <BzAlertTitle>Deployment complete</BzAlertTitle>
            <BzAlertDescription>Your project is live and serving traffic.</BzAlertDescription>
        </BzAlert>
    </Demo>
    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the icon, padding and text all mirror to the right." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzAlert class="max-w-md">
                <BzIcon Icon="@Icons.Outline.CircleCheck" />
                <BzAlertTitle>تم بنجاح</BzAlertTitle>
                <BzAlertDescription>تم حفظ تغييراتك ونشر مشروعك بنجاح.</BzAlertDescription>
            </BzAlert>
        </BzDirectionProvider>
    </Demo>
    <ApiReference Types="ApiFamilies.Alert" />
</div>

@code {
    private static readonly CompositionNode _anatomy = new CompositionNode("BzAlert",
        new CompositionNode("BzIcon"),
        new CompositionNode("BzAlertTitle"),
        new CompositionNode("BzAlertDescription"),
        new CompositionNode("BzAlertAction"));

    private const string UsageSetup = """
        @* _Imports.razor (or the top of the page) *@
        @using Blazeo.Ui
        """;

    private const string UsageMarkup = """
        <BzAlert>
            <BzIcon Icon="@Icons.Outline.InfoCircle" />
            <BzAlertTitle>Heads up!</BzAlertTitle>
            <BzAlertDescription>You can add components to your app using the Blazeo CLI.</BzAlertDescription>
        </BzAlert>
        """;

    private const string DefaultCode = """
        <BzAlert>
            <BzIcon Icon="@Icons.Outline.InfoCircle" />
            <BzAlertTitle>Heads up!</BzAlertTitle>
            <BzAlertDescription>You can add components to your app using the Blazeo CLI.</BzAlertDescription>
        </BzAlert>
        """;

    private const string TitleOnlyCode = """
        <BzAlert>
            <BzIcon Icon="@Icons.Outline.CircleCheck" />
            <BzAlertTitle>Your changes have been saved.</BzAlertTitle>
        </BzAlert>
        """;

    private const string NoIconCode = """
        <BzAlert>
            <BzAlertTitle>Scheduled maintenance</BzAlertTitle>
            <BzAlertDescription>The service will be briefly unavailable on Sunday at 02:00 UTC.</BzAlertDescription>
        </BzAlert>
        """;

    private const string DestructiveCode = """
        <BzAlert Variant="AlertVariant.Destructive">
            <BzIcon Icon="@Icons.Outline.AlertTriangle" />
            <BzAlertTitle>Something went wrong</BzAlertTitle>
            <BzAlertDescription>Your session has expired. Please log in again.</BzAlertDescription>
        </BzAlert>
        """;

    private const string CustomCode = """
        <BzAlert Class="rounded-xl border-emerald-300 bg-emerald-50 text-emerald-900 dark:border-emerald-900 dark:bg-emerald-950/50 dark:text-emerald-100">
            <BzIcon Icon="@Icons.Outline.CircleCheck" />
            <BzAlertTitle>Deployment complete</BzAlertTitle>
            <BzAlertDescription>Your project is live and serving traffic.</BzAlertDescription>
        </BzAlert>
        """;

    private const string RtlCode = """
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzAlert>
                <BzIcon Icon="@Icons.Outline.CircleCheck" />
                <BzAlertTitle>تم بنجاح</BzAlertTitle>
                <BzAlertDescription>تم حفظ تغييراتك ونشر مشروعك بنجاح.</BzAlertDescription>
            </BzAlert>
        </BzDirectionProvider>
        """;
}
