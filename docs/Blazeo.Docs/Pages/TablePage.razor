    private const string ProviderCode = """
        <BzDataTable TItem="Member" ItemsProvider="LoadMembers" PageSize="8" Searchable>
            <BzPropertyColumn Title="#" Property="@(m => m.Id)" ColumnKey="id" Align="end" Sortable />
            <BzPropertyColumn Property="@(m => m.Name)" ColumnKey="name" Sortable />
            <BzPropertyColumn Property="@(m => m.Email)" ColumnKey="email" Sortable />
            <BzPropertyColumn Property="@(m => m.Role)" ColumnKey="role" Sortable />
            <BzTemplateColumn Title="Status">
                <BzBadge Variant="@StatusVariant(context.Status)">@context.Status</BzBadge>
            </BzTemplateColumn>
            <BzPropertyColumn Title="Balance" Property="@(m => m.Balance)" ColumnKey="balance" Format="C" Align="end" Sortable />
        </BzDataTable>

        @code {
            // Filter, sort and page at the source, returning the window + total count. Honour the
            // CancellationToken so a superseded request drops out.
            async ValueTask<DataGridResult<Member>> LoadMembers(DataGridRequest<Member> request)
            {
                var sorted = await QueryAsync(request.Filter, request.Sort, request.CancellationToken);
                var page = sorted.Skip(request.StartIndex).Take(request.Count).ToList();
                return new DataGridResult<Member>(page, sorted.Count);
            }
        }
        """;

