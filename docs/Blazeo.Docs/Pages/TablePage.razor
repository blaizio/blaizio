@page "/components/table"
<PageTitle>Table - Blazeo</PageTitle>

<div class="space-y-10">
    <header class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">Table</h1>
        <p class="text-muted-foreground">
            A responsive data table. Compose the styled primitives directly, or hand rows to
            <code class="bz-code">BzDataTable&lt;TItem&gt;</code> for sorting, search, column visibility, selection,
            pagination and virtualization - inside a fixed-height scroll box (<code class="bz-code">MaxHeight</code>)
            or, by default, against the page itself with no height restriction. For server-side data, swap
            <code class="bz-code">Items</code> for an async <code class="bz-code">ItemsProvider</code>.
        </p>
    </header>

    <UsageBlock Setup="@UsageSetup" Code="@UsageMarkup"
                Description="Add the using once, then compose the styled primitives - or hand rows to BzDataTable&lt;TItem&gt; for sorting, search and more." />

    <CompositionTree Root="_anatomy"
                     Description="The styled-primitive anatomy: a Table wraps an optional Caption, a Header of head cells, a Body of rows, and an optional Footer. BzDataTable composes these for you." />

    <ExamplesHeading />

    <Demo Title="Basic" Description="The styled primitives - Table, TableHeader, TableBody, TableRow, TableHead, TableCell, TableCaption - composed by hand." Code="@BasicCode">
        <div class="w-full max-w-2xl">
            <BzTable>
                <BzTableCaption>A list of recent invoices.</BzTableCaption>
                <BzTableHeader>
                    <BzTableRow>
                        <BzTableHead>Invoice</BzTableHead>
                        <BzTableHead>Status</BzTableHead>
                        <BzTableHead>Method</BzTableHead>
                        <BzTableHead Class="text-end">Amount</BzTableHead>
                    </BzTableRow>
                </BzTableHeader>
                <BzTableBody>
                    @foreach (var invoice in _invoices)
                    {
                        <BzTableRow>
                            <BzTableCell Class="font-medium">@invoice.Number</BzTableCell>
                            <BzTableCell>@invoice.Status</BzTableCell>
                            <BzTableCell>@invoice.Method</BzTableCell>
                            <BzTableCell Class="text-end">@invoice.Amount.ToString("C")</BzTableCell>
                        </BzTableRow>
                    }
                </BzTableBody>
                <BzTableFooter>
                    <BzTableRow>
                        <BzTableCell Class="font-medium" colspan="3">Total</BzTableCell>
                        <BzTableCell Class="text-end font-medium">@_invoices.Sum(i => i.Amount).ToString("C")</BzTableCell>
                    </BzTableRow>
                </BzTableFooter>
            </BzTable>
        </div>
    </Demo>

    <Demo Title="Data table"
          Description="BzDataTable wires the columns to sorting (click a header), search, a column-visibility menu and row selection. Define columns as BzPropertyColumn / BzTemplateColumn children - TItem cascades, so you usually only pass the property."
          Code="@DataTableCode">
        <div class="w-full max-w-3xl">
            <BzDataTable TItem="Member" Items="_members" Searchable SearchColumn="email" SearchPlaceholder="Filter emails..."
                       ColumnToggle Selectable @bind-SelectedItems="_selected" RowKey="@(m => m.Id)">
                <BzPropertyColumn Property="@(m => m.Name)" Sortable />
                <BzPropertyColumn Property="@(m => m.Email)" ColumnKey="email" Sortable />
                <BzPropertyColumn Property="@(m => m.Role)" Sortable />
                <BzTemplateColumn Title="Status" SortBy="@(m => m.Status)" Sortable>
                    <BzBadge Variant="@StatusVariant(context.Status)">@context.Status</BzBadge>
                </BzTemplateColumn>
                <BzPropertyColumn Title="Balance" Property="@(m => m.Balance)" Format="C" Sortable Align="end" />
                <BzTemplateColumn Align="end" CellClass="w-[1%]">
                    <BzDropdownMenu>
                        <BzDropdownMenuTrigger>
                            <RenderAs Context="p">
                                <BzButton Variant="ButtonVariant.Ghost" @attributes="p.Attributes" Class="size-8 p-0" aria-label="Row actions">
                                    <BzIcon Icon="@Icons.Outline.DotsVertical" Class="size-4" />
                                </BzButton>
                            </RenderAs>
                        </BzDropdownMenuTrigger>
                        <BzDropdownMenuContent Class="w-40">
                            <BzDropdownMenuLabel>Actions</BzDropdownMenuLabel>
                            <BzDropdownMenuItem>Copy email</BzDropdownMenuItem>
                            <BzDropdownMenuItem>Edit member</BzDropdownMenuItem>
                            <BzDropdownMenuSeparator />
                            <BzDropdownMenuItem>Delete</BzDropdownMenuItem>
                        </BzDropdownMenuContent>
                    </BzDropdownMenu>
                </BzTemplateColumn>
            </BzDataTable>
        </div>
    </Demo>

    <Demo Title="Columns as data"
          Description="The data-driven alternative: pass a Columns list instead of child components. SortBy makes a column sortable; Text adds it to search."
          Code="@ColumnsAsDataCode">
        <div class="w-full max-w-2xl">
            <BzDataTable TItem="Member" Items="_members" Columns="_memberColumns" Searchable SearchPlaceholder="Search members..." />
        </div>
    </Demo>

    <Demo Title="Empty state"
          Description="When the filter matches nothing, the body collapses to a single EmptyContent row (defaulting to 'No results.')."
          Code="@EmptyCode">
        <div class="w-full max-w-2xl">
            <BzDataTable TItem="Member" Items="_members" Searchable DefaultFilter="zzz no match" SearchPlaceholder="Search members...">
                <BzPropertyColumn Property="@(m => m.Name)" Sortable />
                <BzPropertyColumn Property="@(m => m.Email)" />
                <BzPropertyColumn Property="@(m => m.Role)" />
            </BzDataTable>
        </div>
    </Demo>

    <Demo Title="Virtualized rows (fixed height)"
          Description="Virtualize mounts only the rows in view. Here 10,000 rows scroll inside a fixed-height box (MaxHeight) with its own scrollbar - reach the top or bottom and the page takes over. Fixed height means every row is exactly RowHeight, so placement is pure index math (fastest; best for uniform rows). Omit MaxHeight to virtualize against the page instead, with no height cap."
          Code="@VirtualFixedCode">
        <div class="w-full max-w-3xl">
            <BzDataTable TItem="Member" Items="_bigData" RowKey="@(m => m.Id)"
                       Virtualize RowHeight="49" MaxHeight="24rem" StickyHeader
                       Searchable SearchPlaceholder="Search 10,000 rows...">
                <BzPropertyColumn Title="#" Property="@(m => m.Id)" Align="end" CellClass="text-muted-foreground w-[1%] tabular-nums" Sortable />
                <BzPropertyColumn Property="@(m => m.Name)" Sortable />
                <BzPropertyColumn Property="@(m => m.Email)" Sortable />
                <BzPropertyColumn Property="@(m => m.Role)" Sortable />
                <BzTemplateColumn Title="Status" SortBy="@(m => m.Status)" Sortable>
                    <BzBadge Variant="@StatusVariant(context.Status)">@context.Status</BzBadge>
                </BzTemplateColumn>
                <BzPropertyColumn Title="Balance" Property="@(m => m.Balance)" Format="C" Align="end" Sortable />
            </BzDataTable>
        </div>
    </Demo>

    <Demo Title="Virtualized rows (dynamic height)"
          Description="Add DynamicRowHeight and the virtualizer measures each rendered row instead of assuming RowHeight - so rows of different heights (here, notes that wrap) place correctly. Same fixed-height scroll box, its own scrollbar; RowHeight is just the estimate used until a row is measured."
          Code="@VirtualDynamicCode">
        <div class="w-full max-w-2xl">
            <BzDataTable TItem="Note" Items="_notes" Virtualize DynamicRowHeight RowHeight="64" MaxHeight="22rem" StickyHeader Overscan="8">
                <BzPropertyColumn Title="#" Property="@(n => n.Id)" Align="end" CellClass="text-muted-foreground w-[1%] tabular-nums align-top" />
                <BzPropertyColumn Property="@(n => n.Author)" CellClass="w-40 font-medium align-top" />
                <BzTemplateColumn Title="Note" CellClass="align-top whitespace-normal">
                    <p class="max-w-md text-pretty">@context.Body</p>
                </BzTemplateColumn>
            </BzDataTable>
        </div>
    </Demo>

    <Demo Title="Row class"
          Description="RowClass returns a CSS class per row from its data - here suspended members are dimmed and struck through, and admins get a subtle tint. It styles the whole row, independent of the columns."
          Code="@RowClassCode">
        <div class="w-full max-w-2xl">
            <BzDataTable TItem="Member" Items="_members" RowClass="@RowClassFor">
                <BzPropertyColumn Property="@(m => m.Name)" Sortable />
                <BzPropertyColumn Property="@(m => m.Role)" Sortable />
                <BzPropertyColumn Property="@(m => m.Status)" Sortable />
                <BzPropertyColumn Title="Balance" Property="@(m => m.Balance)" Format="C" Align="end" Sortable />
            </BzDataTable>
        </div>
    </Demo>

    <Demo Title="Tie-breaker sort"
          Description="A column's Sort can chain keys. This Role column sorts by Role, then by Name within each role - so equal roles stay grouped and alphabetical inside the group instead of arbitrary order. Click the Role header; the toggle flips the whole chain."
          Code="@TieBreakerCode">
        <div class="w-full max-w-2xl">
            <BzDataTable TItem="Member" Items="_members" DefaultSort="@(new SortState("Role", SortDirection.Ascending))">
                <BzPropertyColumn Property="@(m => m.Name)" Sortable />
                <BzPropertyColumn Property="@(m => m.Role)" Sortable
                                Sort="@(GridSort<Member>.By(m => m.Role).ThenBy(m => m.Name))" />
                <BzPropertyColumn Property="@(m => m.Email)" />
            </BzDataTable>
        </div>
    </Demo>

    <Demo Title="Pagination"
          Description="Set PageSize to page the rows instead of showing them all - a pager renders below the table, searching resets to the first page, and sorting carries across pages. An alternative to Virtualize for moderate data."
          Code="@PaginationCode">
        <div class="w-full max-w-3xl">
            <BzDataTable TItem="Member" Items="_members" PageSize="5" Searchable SearchPlaceholder="Search members...">
                <BzPropertyColumn Property="@(m => m.Name)" Sortable />
                <BzPropertyColumn Property="@(m => m.Email)" Sortable />
                <BzPropertyColumn Property="@(m => m.Role)" Sortable />
                <BzPropertyColumn Title="Balance" Property="@(m => m.Balance)" Format="C" Align="end" Sortable />
            </BzDataTable>
        </div>
    </Demo>

    <Demo Title="Async data (ItemsProvider)"
          Description="For server-side data, give an ItemsProvider instead of Items: it receives the page window + sort + filter and returns that page plus the total count, so sorting, search and paging all happen at the source. Here it queries 10,000 rows behind a simulated 300ms latency (watch the Loading... row); stale requests are cancelled as you click."
          Code="@ProviderCode">
        <div class="w-full max-w-3xl">
            <BzDataTable TItem="Member" ItemsProvider="_membersProvider" PageSize="8" Searchable SearchPlaceholder="Search 10,000 rows...">
                <BzPropertyColumn Title="#" Property="@(m => m.Id)" ColumnKey="id" Align="end" CellClass="text-muted-foreground tabular-nums" Sortable />
                <BzPropertyColumn Property="@(m => m.Name)" ColumnKey="name" Sortable />
                <BzPropertyColumn Property="@(m => m.Email)" ColumnKey="email" Sortable />
                <BzPropertyColumn Property="@(m => m.Role)" ColumnKey="role" Sortable />
                <BzTemplateColumn Title="Status">
                    <BzBadge Variant="@StatusVariant(context.Status)">@context.Status</BzBadge>
                </BzTemplateColumn>
                <BzPropertyColumn Title="Balance" Property="@(m => m.Balance)" ColumnKey="balance" Format="C" Align="end" Sortable />
            </BzDataTable>
        </div>
    </Demo>

    <Demo Title="Customization"
          Description="Restyle the primitives via Class - here the header row gets an indigo tint and white text, and the caption an indigo accent. Root utilities win over the skin, so the recolor takes effect."
          Code="@CustomCode">
        <div class="w-full max-w-2xl">
            <BzTable Class="overflow-hidden rounded-lg border">
                <BzTableCaption Class="text-indigo-600">A list of recent invoices.</BzTableCaption>
                <BzTableHeader>
                    <BzTableRow Class="[&_[data-slot=table-head]]:text-white bg-indigo-600 hover:bg-indigo-600">
                        <BzTableHead>Invoice</BzTableHead>
                        <BzTableHead>Status</BzTableHead>
                        <BzTableHead Class="text-end">Amount</BzTableHead>
                    </BzTableRow>
                </BzTableHeader>
                <BzTableBody>
                    @foreach (var invoice in _invoices)
                    {
                        <BzTableRow>
                            <BzTableCell Class="font-medium">@invoice.Number</BzTableCell>
                            <BzTableCell>@invoice.Status</BzTableCell>
                            <BzTableCell Class="text-end">@invoice.Amount.ToString("C")</BzTableCell>
                        </BzTableRow>
                    }
                </BzTableBody>
            </BzTable>
        </div>
    </Demo>

    <Demo Title="RTL"
          Description="Wrapped in a DirectionProvider with Arabic copy - alignment, the select column and the sort affordance all mirror."
          Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <div class="w-full max-w-2xl">
                <BzDataTable TItem="Member" Items="_members.Take(4)" Selectable RowKey="@(m => m.Id)">
                    <BzPropertyColumn Title="الاسم" Property="@(m => m.Name)" Sortable />
                    <BzPropertyColumn Title="الدور" Property="@(m => m.Role)" Sortable />
                    <BzPropertyColumn Title="الرصيد" Property="@(m => m.Balance)" Format="C" Align="end" Sortable />
                </BzDataTable>
            </div>
        </BzDirectionProvider>
    </Demo>

    <ApiReference Types="ApiFamilies.Table" />
</div>

@code {
    public sealed record Invoice(string Number, string Status, string Method, decimal Amount);
    public sealed record Member(int Id, string Name, string Email, string Role, string Status, decimal Balance);
    public sealed record Note(int Id, string Author, string Body);

    private IReadOnlyCollection<Member> _selected = [];

    private static readonly Invoice[] _invoices =
    [
        new("INV-001", "Paid", "Credit Card", 250.00m),
        new("INV-002", "Pending", "PayPal", 150.00m),
        new("INV-003", "Unpaid", "Bank Transfer", 350.00m),
        new("INV-004", "Paid", "Credit Card", 450.00m),
        new("INV-005", "Paid", "PayPal", 550.00m),
    ];

    private static readonly Member[] _members =
    [
        new(1, "Olivia Martin", "olivia.martin@example.com", "Admin", "Active", 1999.00m),
        new(2, "Jackson Lee", "jackson.lee@example.com", "Member", "Active", 39.00m),
        new(3, "Isabella Nguyen", "isabella.nguyen@example.com", "Owner", "Invited", 299.00m),
        new(4, "William Kim", "will.kim@example.com", "Member", "Suspended", 99.00m),
        new(5, "Sofia Davis", "sofia.davis@example.com", "Viewer", "Active", 0.00m),
        new(6, "Liam Johnson", "liam.johnson@example.com", "Admin", "Active", 845.50m),
        new(7, "Emma Wilson", "emma.wilson@example.com", "Member", "Invited", 120.00m),
        new(8, "Noah Brown", "noah.brown@example.com", "Viewer", "Suspended", 12.75m),
    ];

    private readonly List<ColumnDef<Member>> _memberColumns =
    [
        new() { Title = "Name", SortBy = m => m.Name, Text = m => m.Name, Cell = m => @<span class="font-medium">@m.Name</span> },
        new() { Title = "Email", SortBy = m => m.Email, Text = m => m.Email, Cell = m => @<text>@m.Email</text> },
        new() { Title = "Role", SortBy = m => m.Role, Text = m => m.Role, Cell = m => @<text>@m.Role</text> },
        new() { Title = "Balance", Align = "end", SortBy = m => m.Balance, Cell = m => @<text>@m.Balance.ToString("C")</text> },
    ];

    private List<Member> _bigData = [];
    private List<Note> _notes = [];
    private DataItemsProvider<Member> _membersProvider = default!;

    protected override void OnInitialized()
    {
        var first = new[] { "Olivia", "Jackson", "Isabella", "William", "Sofia", "Liam", "Emma", "Noah", "Ava", "Lucas", "Mia", "Ethan" };
        var last = new[] { "Martin", "Lee", "Nguyen", "Kim", "Davis", "Johnson", "Wilson", "Brown", "Garcia", "Miller", "Jones", "Khan" };
        var roles = new[] { "Owner", "Admin", "Member", "Viewer" };
        var statuses = new[] { "Active", "Invited", "Suspended" };
        var rng = new Random(42);

        _bigData = Enumerable.Range(1, 10_000).Select(i =>
        {
            var name = $"{first[rng.Next(first.Length)]} {last[rng.Next(last.Length)]}";
            var email = name.ToLowerInvariant().Replace(' ', '.') + i + "@example.com";
            return new Member(i, name, email, roles[rng.Next(roles.Length)], statuses[rng.Next(statuses.Length)], Math.Round((decimal)(rng.NextDouble() * 2000), 2));
        }).ToList();

        var lorem = new[]
        {
            "Short note.",
            "A medium-length note that runs to roughly one full line of text in the cell.",
            "A longer note that wraps across two or three lines, which is exactly why dynamic measurement matters: every row can be a different height and the virtualizer still places it correctly.",
            "Following up on yesterday - the numbers look right, but double-check the rounding on the balance column before we ship.",
        };
        _notes = Enumerable.Range(1, 250)
            .Select(i => new Note(i, $"{first[rng.Next(first.Length)]} {last[rng.Next(last.Length)]}", lorem[rng.Next(lorem.Length)]))
            .ToList();

        _membersProvider = LoadMembersAsync;
    }

    // A stand-in for a server query: filter, sort and page the 10,000 rows behind a simulated latency.
    private async ValueTask<DataGridResult<Member>> LoadMembersAsync(DataGridRequest<Member> request)
    {
        await Task.Delay(300, request.CancellationToken);

        IEnumerable<Member> query = _bigData;

        if (!string.IsNullOrWhiteSpace(request.Filter))
        {
            var f = request.Filter;
            query = query.Where(m => m.Name.Contains(f, StringComparison.OrdinalIgnoreCase)
                                  || m.Email.Contains(f, StringComparison.OrdinalIgnoreCase));
        }

        if (request.Sort is { } sort)
        {
            Func<Member, object> key = sort.ColumnKey switch
            {
                "name" => m => m.Name,
                "email" => m => m.Email,
                "role" => m => m.Role,
                "balance" => m => m.Balance,
                _ => m => m.Id,
            };
            query = sort.Direction == SortDirection.Ascending ? query.OrderBy(key) : query.OrderByDescending(key);
        }

        var all = query.ToList();
        var page = all.Skip(request.StartIndex).Take(request.Count).ToList();
        return new DataGridResult<Member>(page, all.Count);
    }

    private static BadgeVariant StatusVariant(string status) => status switch
    {
        "Active" => BadgeVariant.Default,
        "Suspended" => BadgeVariant.Destructive,
        _ => BadgeVariant.Secondary,
    };

    private static string? RowClassFor(Member m) => m.Status switch
    {
        "Suspended" => "opacity-50 line-through",
        _ => m.Role == "Admin" ? "bg-primary/5" : null,
    };

    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode _anatomy = new CompositionNode("BzTable",
        new CompositionNode("BzTableCaption"),
        new CompositionNode("BzTableHeader",
            new CompositionNode("BzTableRow",
                new CompositionNode("BzTableHead"))),
        new CompositionNode("BzTableBody",
            new CompositionNode("BzTableRow",
                new CompositionNode("BzTableCell"))),
        new CompositionNode("BzTableFooter",
            new CompositionNode("BzTableRow",
                new CompositionNode("BzTableCell"))));

