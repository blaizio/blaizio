        ("components/accordion", "Accordion"),
        ("components/alert", "Alert"),
        ("components/alert-dialog", "Alert Dialog"),
        ("components/aspect-ratio", "Aspect Ratio"),
        ("components/avatar", "Avatar"),
        ("components/badge", "Badge"),
        ("components/button", "Button"),
        ("components/card", "Card"),
        ("components/checkbox", "Checkbox"),
        ("components/collapsible", "Collapsible"),
        ("components/context-menu", "Context Menu"),
        ("components/dialog", "Dialog"),
        ("components/dropdown-menu", "Dropdown Menu"),
        ("components/field", "Field"),
        ("components/icons", "Icons"),
        ("components/input", "Input"),
        ("components/kbd", "Kbd"),
        ("components/label", "Label"),
        ("components/popover", "Popover"),
        ("components/progress", "Progress"),
        ("components/radio-group", "Radio Group"),
        ("components/select", "Select"),
        ("components/separator", "Separator"),
