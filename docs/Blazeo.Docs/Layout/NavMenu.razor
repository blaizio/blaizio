@*
    Docs sidebar. Each ported component gets a link here.
*@
<nav class="space-y-6 text-sm">
    <div>
        <div class="mb-2 px-2 text-xs font-medium uppercase tracking-wide text-muted-foreground">Getting started</div>
        <NavLink class="block rounded-md px-2 py-1.5 text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
                 ActiveClass="bg-accent !text-accent-foreground" href="" Match="NavLinkMatch.All">
            Overview
        </NavLink>
    </div>
    <div>
        <div class="mb-2 px-2 text-xs font-medium uppercase tracking-wide text-muted-foreground">Components</div>
        @foreach (var (href, label) in _components)
        {
            <NavLink class="block rounded-md px-2 py-1.5 text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
                     ActiveClass="bg-accent !text-accent-foreground" href="@href">
                @label
            </NavLink>
        }
    </div>
</nav>

@code {
    // Component docs links, alphabetical. Add an entry here when a new component lands.
    private static readonly (string Href, string Label)[] _components =
    [
        ("components/accordion", "Accordion"),
        ("components/alert", "Alert"),
        ("components/aspect-ratio", "Aspect Ratio"),
        ("components/avatar", "Avatar"),
        ("components/badge", "Badge"),
        ("components/button", "Button"),
        ("components/card", "Card"),
        ("components/checkbox", "Checkbox"),
        ("components/collapsible", "Collapsible"),
        ("components/dialog", "Dialog"),
        ("components/field", "Field"),
        ("components/input", "Input"),
        ("components/kbd", "Kbd"),
        ("components/label", "Label"),
        ("components/progress", "Progress"),
        ("components/radio-group", "Radio Group"),
        ("components/separator", "Separator"),
        ("components/skeleton", "Skeleton"),
        ("components/switch", "Switch"),
        ("components/tabs", "Tabs"),
        ("components/textarea", "Textarea"),
        ("components/toggle", "Toggle"),
        ("components/toggle-group", "Toggle Group"),
    ];
}
