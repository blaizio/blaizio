@inject IJSRuntime Js
@*
    Component showcase matching the reference docs' layout: ONE bordered card with the rendered
    preview on top and the source directly below — syntax-highlighted, line-numbered, copyable,
    and collapsed behind a "View Code" toggle that reveals the full example markup.
    The code surface + palette are theme-aware (driven by the --code* CSS variables).
*@
<section class="space-y-3">
    @if (Title is not null)
    {
        <h3 class="text-lg font-semibold tracking-tight">@Title</h3>
    }
    @if (Description is not null)
    {
        <p class="text-sm text-muted-foreground">@Description</p>
    }

    <div class="overflow-hidden rounded-xl border">
        <div class="flex min-h-[280px] w-full items-center justify-center p-10">
            @ChildContent
        </div>

        @if (Code is not null)
        {
            <div class="relative border-t bg-code text-code-foreground">
                <button type="button" @onclick="Copy" aria-label="Copy code"
                        class="absolute right-3 top-3 z-20 inline-flex size-7 items-center justify-center rounded-md border border-foreground/10 bg-foreground/5 text-foreground/60 transition hover:bg-foreground/10">
                    @if (_copied)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg>
                    }
                </button>

                <div class="@(_expanded ? "" : "max-h-[7.5rem]") overflow-hidden">
                    <pre class="overflow-x-auto p-4 text-[13px] leading-relaxed"><code @ref="_codeRef" class="language-html">@Code</code></pre>
                </div>

                @if (_expanded)
                {
                    <div class="flex justify-center border-t py-2">
                        <button type="button" @onclick="Toggle" class="rounded-md px-3 py-1 text-xs font-medium text-foreground/70 transition hover:bg-foreground/10">Collapse</button>
                    </div>
                }
                else
                {
                    <div class="pointer-events-none absolute inset-x-0 bottom-0 flex items-end justify-center bg-gradient-to-t from-code to-transparent pb-3 pt-12">
                        <button type="button" @onclick="Toggle" class="pointer-events-auto rounded-md bg-foreground/10 px-3 py-1 text-xs font-medium text-foreground transition hover:bg-foreground/15">View Code</button>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    /// <summary>Heading above the card.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Optional description under the heading.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>Full example source for the Code area. Omit to show only a preview.</summary>
    [Parameter] public string? Code { get; set; }

    /// <summary>The rendered example.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _expanded;
    private bool _copied;
    private ElementReference _codeRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Code is not null)
            await Js.InvokeVoidAsync("blazeoCode.highlight", _codeRef);
    }

    private void Toggle() => _expanded = !_expanded;

    private async Task Copy()
    {
        if (Code is null) return;
        await Js.InvokeVoidAsync("blazeoCode.copy", Code);
        _copied = true;
    }
}
