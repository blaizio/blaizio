@inject IJSRuntime Js
@*
    Component showcase matching the reference docs' layout: ONE bordered card with the rendered
    preview on top and the source directly below — syntax-highlighted, line-numbered, copyable,
    and collapsed behind a "View Code" toggle that reveals the full example markup.
    The code surface + palette are theme-aware (driven by the --code* CSS variables).
*@
<section class="space-y-3">
    @if (Title is not null)
    {
        <h3 class="text-lg font-semibold tracking-tight">@Title</h3>
    }
    @if (Description is not null)
    {
        <p class="text-sm text-muted-foreground">@Description</p>
    }

    <div class="overflow-hidden rounded-xl border">
        <div class="flex min-h-[280px] w-full items-center justify-center p-10">
            @ChildContent
        </div>

        @if (Code is not null)
        {
            <div class="relative border-t bg-code text-code-foreground">
                @* Top-right controls, shadcn-style: expand/collapse | separator | copy. *@
                <div class="absolute right-2 top-2 z-20 flex items-center rounded-md bg-code/80 backdrop-blur-sm">
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" @onclick="Toggle"
                            Class="h-7 px-2">
                        @(_expanded ? "Collapse" : "View Code")
                    </Button>
                    <Separator Orientation="Orientation.Vertical" Class="mx-1 !h-4 bg-code-foreground/20" />
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" @onclick="Copy" aria-label="Copy code"
                            Class="@($"size-7 {ControlClasses}")">
                        <BlazeIcon Icon="@(_copied ? Icons.Outline.Check : Icons.Outline.Copy)" />
                    </Button>
                </div>

                <div class="@(_expanded ? "" : "max-h-[7.5rem]") overflow-hidden">
                    <pre class="overflow-x-auto p-4 text-[13px] leading-relaxed"><code @ref="_codeRef" class="language-cshtml-razor">@Code</code></pre>
                </div>

                @if (!_expanded)
                {
                    @* The whole bottom strip is the trigger; the gradient ends SOLID so the label stays readable. *@
                    <Button Variant="ButtonVariant.Ghost" @onclick="Toggle"
                            Class="absolute inset-x-0 bottom-0 h-16 w-full rounded-none bg-gradient-to-b from-code/70 to-code font-normal text-code-foreground/70 hover:bg-transparent hover:text-code-foreground dark:hover:bg-transparent">
                        View Code
                    </Button>
                }
            </div>
        }
    </div>
</section>

@code {
    /// <summary>Heading above the card.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Optional description under the heading.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>Full example source for the Code area. Omit to show only a preview.</summary>
    [Parameter] public string? Code { get; set; }

    /// <summary>The rendered example.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _expanded;
    private bool _copied;
    private ElementReference _codeRef;

    // Ghost-button recolouring for the code surface (its palette is --code*, not the page's).
    private const string ControlClasses =
        "text-code-foreground/60 hover:bg-code-foreground/10 hover:text-code-foreground " +
        "dark:hover:bg-code-foreground/10";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Code is not null)
            await Js.InvokeVoidAsync("blazeoCode.highlight", _codeRef);
    }

    private void Toggle() => _expanded = !_expanded;

    private async Task Copy()
    {
        if (Code is null) return;
        await Js.InvokeVoidAsync("blazeoCode.copy", Code);
        _copied = true;
        // Intermediate awaits don't trigger a render — flush the check icon in before the revert delay.
        StateHasChanged();
        await Task.Delay(1500);
        _copied = false;
    }
}
