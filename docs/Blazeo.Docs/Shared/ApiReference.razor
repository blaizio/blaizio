@inject IApiDocs ApiDocs
@inject ICodeHighlighter Highlighter
@*
    The "API Reference" section at the foot of a component page. Pass the whole family - the parent
    plus its children (e.g. Dialog, DialogTrigger, DialogContent, ...) - and it renders one table
    per component (Prop / Type / Default / Description), filled by reflection + the shipped XML docs
    (ApiDocs). The "API Reference" heading carries data-toc so it joins the page's On This Page rail.

    Every styled component also follows the ambient reading direction and accepts a per-component
    dir override, so the section closes with a standing "Direction & RTL" note + example. It's
    skipped on the DirectionProvider page itself, which documents that mechanism directly.
*@
<section class="space-y-6">
    <h3 data-toc class="scroll-mt-20 text-lg font-semibold tracking-tight">API Reference</h3>

    @foreach (var entry in _entries)
    {
        <div class="space-y-3">
            <h4 class="font-mono text-sm font-semibold">@entry.Name</h4>
            @if (entry.Params.Count == 0)
            {
                <p class="text-sm text-muted-foreground">No parameters.</p>
            }
            else
            {
                <div class="overflow-x-auto rounded-lg border">
                    <table class="w-full text-sm">
                        <thead class="bg-muted/50 text-start">
                            <tr class="text-muted-foreground">
                                <th class="px-4 py-2 font-medium">Prop</th>
                                <th class="px-4 py-2 font-medium">Type</th>
                                <th class="px-4 py-2 font-medium">Default</th>
                                <th class="px-4 py-2 font-medium">Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in entry.Params)
                            {
                                <tr class="border-t align-top">
                                    <td class="px-4 py-2 font-mono whitespace-nowrap">@p.Name</td>
                                    <td class="px-4 py-2 font-mono text-xs text-muted-foreground whitespace-nowrap">@p.Type</td>
                                    <td class="px-4 py-2 font-mono text-xs whitespace-nowrap">@p.Default</td>
                                    <td class="px-4 py-2 text-muted-foreground">@p.Summary</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    @if (_showDirectionNote)
    {
        @* Applies to every component, so it's documented here once rather than per page. *@
        <div class="space-y-3">
            <h4 class="font-mono text-sm font-semibold">Direction &amp; RTL</h4>
            <p class="text-sm text-muted-foreground">
                <code>@_rootName</code> follows the ambient reading <strong>direction</strong>. Wrap a
                subtree in a <code>DirectionProvider</code> to flip it to <strong>RTL</strong>, or set
                <code>dir="rtl"</code> on the component itself - spacing, alignment and arrow-key
                navigation all mirror. See
                <a class="font-medium text-foreground underline underline-offset-4" href="direction">Direction (RTL)</a>.
            </p>
            @* Code stays LTR even under RTL - source reads left-to-right regardless of page direction. *@
            <div class="overflow-hidden rounded-lg border bg-code text-code-foreground">
                <pre dir="ltr" class="overflow-x-auto p-4 text-[13px] leading-relaxed"><code class="code-block">@_directionExample</code></pre>
            </div>
        </div>
    }
</section>

@code {
    /// <summary>The component family to document: the parent first, then its children.</summary>
    [Parameter, EditorRequired] public Type[] Types { get; set; } = [];

    private readonly List<(string Name, IReadOnlyList<ApiParam> Params)> _entries = [];
    private string _rootName = "";
    private bool _showDirectionNote;
    private MarkupString _directionExample;

    protected override async Task OnParametersSetAsync()
    {
        _entries.Clear();
        foreach (var type in Types)
        {
            _entries.Add((type.Name, await ApiDocs.GetParametersAsync(type)));
        }

        // The parent is listed first; the note speaks to the family as a whole.
        _rootName = Types.Length > 0 ? Types[0].Name : "";
        // The DirectionProvider page documents this mechanism itself - don't point it back at itself.
        _showDirectionNote = _rootName is not "" and not "DirectionProvider";
        _directionExample = _showDirectionNote ? Highlighter.Highlight(DirectionExample(_rootName)) : default;
    }

    // A two-way worked example: inherit RTL from an ancestor, or pin it on this component alone.
    private static string DirectionExample(string root) =>
        $$"""
        @* Inherit RTL from an ancestor… *@
        <DirectionProvider Direction="Direction.Rtl">
            <{{root}}>…</{{root}}>
        </DirectionProvider>

        @* …or set it on just this component. *@
        <{{root}} dir="rtl">…</{{root}}>
        """;
}
