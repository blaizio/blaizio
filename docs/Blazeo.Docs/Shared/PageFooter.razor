@implements IDisposable
@inject NavigationManager Nav
@*
    The foot of every component page (rendered once by MainLayout for /components/* routes). It always
    lays out as a balanced two-column row of cards so it never looks lop-sided:

      - middle component (has prev AND next): a full-width API/back card on top, then [prev] [next].
      - first component (no prev):            [API/back card] [next].
      - last component (no next):             [prev] [API/back card].

    The "special" card is the API Reference call-to-action on a doc page (jumping to the API page flips
    the sidebar to the API tab) and a back-to-docs card on an API page. Prev/next page within the
    current mode (docs<->docs, api<->api). Everything is derived from the URL + the DocsNav registry.
*@
@if (_current is not null)
{
    <footer class="mt-16 border-t pt-8">
        @if (_hasPrev && _hasNext)
        {
            <div class="space-y-4">
                @SpecialCard()
                <div class="grid gap-4 sm:grid-cols-2">
                    @PrevCard(_prev!)
                    @NextCard(_next!)
                </div>
            </div>
        }
        else
        {
            <div class="grid gap-4 sm:grid-cols-2">
                @if (_hasPrev) { @PrevCard(_prev!) } else { @SpecialCard() }
                @if (_hasNext) { @NextCard(_next!) } else { @SpecialCard() }
            </div>
        }
    </footer>
}

@code {
    private DocEntry? _current;
    private DocEntry? _prev;
    private DocEntry? _next;
    private bool _isApi;
    private bool _hasPrev;
    private bool _hasNext;

    private const string CardClass =
        "group flex min-h-[5rem] flex-col justify-center rounded-xl border bg-card p-4 no-underline " +
        "transition-all hover:border-primary/50 hover:bg-accent/30";

    // The API-reference (doc mode) / back-to-docs (api mode) call-to-action card.
    private RenderFragment SpecialCard() => @<a href="@(_isApi ? _current!.DocHref : _current!.ApiHref)" class="@($"{CardClass} !flex-row items-center gap-4")">
        <div class="bg-primary/10 text-primary flex size-10 shrink-0 items-center justify-center rounded-lg">
            <BzIcon Icon="@(_isApi ? Icons.Outline.Book : Icons.Outline.Code)" Class="size-5" />
        </div>
        <div class="min-w-0 flex-1">
            <div class="text-foreground font-medium">@(_isApi ? $"{_current!.Label} documentation" : "API Reference")</div>
            <p class="text-muted-foreground truncate text-sm">@(_isApi ? "Back to the examples and usage." : "Props, types and defaults for every part.")</p>
        </div>
        <BzIcon Icon="@Icons.Outline.ArrowRight" Class="text-muted-foreground group-hover:text-primary size-4 shrink-0 transition-transform group-hover:translate-x-0.5 rtl:rotate-180" />
    </a>;

    private RenderFragment PrevCard(DocEntry e) => @<a href="@Href(e)" class="@($"{CardClass} flex flex-col")">
        <span class="text-muted-foreground flex items-center gap-1 text-xs">
            <BzIcon Icon="@Icons.Outline.ArrowLeft" Class="size-3.5 transition-transform group-hover:-translate-x-0.5 rtl:rotate-180" />Previous
        </span>
        <span class="text-foreground group-hover:text-primary mt-1 font-medium transition-colors">@e.Label</span>
        <span class="text-muted-foreground mt-0.5 line-clamp-1 text-sm">@e.Blurb</span>
    </a>;

    private RenderFragment NextCard(DocEntry e) => @<a href="@Href(e)" class="@($"{CardClass} flex flex-col text-end")">
        <span class="text-muted-foreground flex items-center justify-end gap-1 text-xs">
            Next<BzIcon Icon="@Icons.Outline.ArrowRight" Class="size-3.5 transition-transform group-hover:translate-x-0.5 rtl:rotate-180" />
        </span>
        <span class="text-foreground group-hover:text-primary mt-1 font-medium transition-colors">@e.Label</span>
        <span class="text-muted-foreground mt-0.5 line-clamp-1 text-sm">@e.Blurb</span>
    </a>;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        Recompute();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        Recompute();
        StateHasChanged();
    }

    private void Recompute()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        var q = path.IndexOf('?');
        if (q >= 0) path = path[..q];
        var parts = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2 && parts[0] == "components")
        {
            _current = DocsNav.Find(parts[1]);
            _isApi = parts.Length >= 3 && parts[2] == "api";
            _prev = _current is null ? null : DocsNav.Prev(_current.Slug);
            _next = _current is null ? null : DocsNav.Next(_current.Slug);
        }
        else
        {
            _current = _prev = _next = null;
            _isApi = false;
        }
        _hasPrev = _prev is not null;
        _hasNext = _next is not null;
    }

    // Stay in the current mode when paging: api->api (falls back to docs when a neighbour has no API
    // page), docs->docs.
    private string Href(DocEntry e) => _isApi ? e.ApiHref : e.DocHref;

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
