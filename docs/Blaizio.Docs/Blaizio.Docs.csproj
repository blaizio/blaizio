<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Load the full ICU dataset so non-Gregorian locales (the Arabic Hijri / Persian Jalali calendar
         demos) render their month and weekday names in native script, not Latin transliteration. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>

    <!-- The CLI-copied components compile into this assembly and carry the Blaizio.Ui XML docs the
         API reference renders (published as wwwroot/api/Blaizio.Ui.xml below). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    The docs site consumes Blaizio exactly like any real consumer would — no project references:

    - Blaizio.Base / Blaizio.Icons come as NuGet packages (from artifacts/local-nuget until they
      are published to nuget.org; the repo nuget.config lists that feed).
    - The styled components are copied in by the Blaizio CLI ("blaizio add") into Components/Ui,
      generated on build and gitignored. blaizio.json pins their namespace to Blaizio.Ui.

    The BlaizioConsumerPrepare target below automates the whole chain. After editing component
    source in src/Blaizio.Ui, rebuild with -p:BlaizioRefresh=true to re-copy the components and
    regenerate the registry; -p:BlaizioRepack=true additionally repacks Base/Icons and purges
    their NuGet cache entries.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.8" PrivateAssets="all" />
    <PackageReference Include="Blaizio.Base" Version="0.1.0-alpha.1" />
    <PackageReference Include="Blaizio.Icons" Version="0.1.0-alpha.1" />
    <PackageReference Include="TailwindMerge.NET" Version="1.4.0" />
  </ItemGroup>

  <!-- Keep the Tailwind toolchain (lib/) out of compilation AND publish: its package.json etc.
       otherwise collide with Blaizio.Base's lib/ files in the publish output (NETSDK1152). The
       Tailwind target reads lib/ via DocsCssInputs / a direct path, so this exclusion is safe. -->
  <ItemGroup>
    <Compile Remove="lib\**" />
    <Content Remove="lib\**" />
    <None Remove="lib\**" />
  </ItemGroup>

  <!--
    Compile Tailwind (lib/Styles/app.css -> wwwroot/app.css) before static web assets are gathered,
    scanning this app's .razor (including the CLI-copied components) for utility classes. Invoked
    via node directly to sidestep pnpm's pre-run dependency check. Skipped (warning) when
    lib/node_modules is absent.
  -->
  <ItemGroup>
    <DocsCssInputs Include="lib\Styles\**\*.css" />
    <DocsCssInputs Include="**\*.razor" Exclude="lib\node_modules\**;bin\**;obj\**" />
    <DocsCssInputs Include="Components\**\*.cs" />
  </ItemGroup>

  <Target Name="BuildDocsTailwind"
          BeforeTargets="BeforeBuild;ResolveStaticWebAssetsInputs"
          Condition="Exists('$(MSBuildProjectDirectory)\lib\node_modules')"
          Inputs="@(DocsCssInputs)"
          Outputs="$(MSBuildProjectDirectory)\wwwroot\app.css">
    <Exec Command="node node_modules/@tailwindcss/cli/dist/index.mjs -i Styles/app.css -o ../wwwroot/app.css --minify"
          WorkingDirectory="$(MSBuildProjectDirectory)\lib" />
  </Target>

  <Target Name="WarnMissingDocsNodeModules"
          BeforeTargets="BeforeBuild"
          Condition="!Exists('$(MSBuildProjectDirectory)\lib\node_modules') AND Exists('$(MSBuildProjectDirectory)\lib\package.json')">
    <Warning Text="Blaizio.Docs: lib/node_modules missing - run 'pnpm install' then the build:css script in the lib folder to regenerate wwwroot/app.css." />
  </Target>

  <!-- The copied components compile into this assembly, so our own XML doc file carries the
       Blaizio.Ui member docs. Publish it under the name the API reference fetches at runtime. -->
  <Target Name="CopyBlaizioApiXml"
          AfterTargets="Compile"
          BeforeTargets="ResolveStaticWebAssetsInputs"
          Condition="Exists('$(IntermediateOutputPath)$(AssemblyName).xml')">
    <Copy SourceFiles="$(IntermediateOutputPath)$(AssemblyName).xml"
          DestinationFiles="$(MSBuildProjectDirectory)\wwwroot\api\Blaizio.Ui.xml"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    Consumer preparation: everything a real consumer's machine would have, produced by this build.
      1. pack Blaizio.Base + Blaizio.Icons into the local feed (skipped when the .nupkg files exist;
         -p:BlaizioRepack=true repacks and purges the NuGet cache entries so a same-version repack
         actually restores).
      2. build the CLI and compile the registry into wwwroot/r, which the docs origin serves at
         /r/*.json (blaiz.io/r in production). Skipped when wwwroot/r exists; -p:BlaizioRefresh=true
         regenerates it.
      3. "blaizio add" (all components) copies everything into Components/Ui; blaizio.json pins the
         namespace to Blaizio.Ui, so docs pages compile against the copied source unchanged.
         Skipped when Components/Ui exists; -p:BlaizioRefresh=true re-copies.
    Runs before Restore so freshly packed packages are resolvable in the same invocation.
  -->
  <Target Name="BlaizioConsumerPrepare"
          BeforeTargets="Restore;BeforeBuild">
    <PropertyGroup>
      <_BlaizioFeed>$(MSBuildProjectDirectory)\..\..\artifacts\local-nuget</_BlaizioFeed>
      <_BlaizioCliDll>..\..\src\Blaizio.Cli\bin\Release\net10.0\blaizio.dll</_BlaizioCliDll>
      <_BlaizioNeedPack Condition="!Exists('$(_BlaizioFeed)\Blaizio.Base.0.1.0-alpha.1.nupkg') OR !Exists('$(_BlaizioFeed)\Blaizio.Icons.0.1.0-alpha.1.nupkg') OR '$(BlaizioRepack)' == 'true'">true</_BlaizioNeedPack>
      <_BlaizioNeedRegistry Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\r\index.json') OR '$(BlaizioRefresh)' == 'true'">true</_BlaizioNeedRegistry>
      <_BlaizioNeedAdd Condition="!Exists('$(MSBuildProjectDirectory)\Components\Ui') OR '$(BlaizioRefresh)' == 'true'">true</_BlaizioNeedAdd>
    </PropertyGroup>

    <RemoveDir Directories="$(NuGetPackageRoot)blaizio.base;$(NuGetPackageRoot)blaizio.icons"
               Condition="'$(BlaizioRepack)' == 'true'" />
    <Exec Command="dotnet pack ..\..\src\Blaizio.Base\Blaizio.Base.csproj -c Release -o &quot;$(_BlaizioFeed)&quot; -v q"
          Condition="'$(_BlaizioNeedPack)' == 'true'" />
    <Exec Command="dotnet pack ..\..\src\Blaizio.Icons\Blaizio.Icons.csproj -c Release -o &quot;$(_BlaizioFeed)&quot; -v q"
          Condition="'$(_BlaizioNeedPack)' == 'true'" />

    <Exec Command="dotnet build ..\..\src\Blaizio.Cli\Blaizio.Cli.csproj -c Release -v q"
          Condition="'$(_BlaizioNeedRegistry)' == 'true' OR '$(_BlaizioNeedAdd)' == 'true'" />
    <Exec Command="dotnet &quot;$(_BlaizioCliDll)&quot; generate ..\..\src\Blaizio.Ui"
          Condition="'$(_BlaizioNeedRegistry)' == 'true'" />
    <Exec Command="dotnet &quot;$(_BlaizioCliDll)&quot; build .\registry.json -o &quot;$(MSBuildProjectDirectory)\wwwroot\r&quot; --cwd ..\..\src\Blaizio.Ui"
          Condition="'$(_BlaizioNeedRegistry)' == 'true'" />
    <Exec Command="dotnet &quot;$(_BlaizioCliDll)&quot; add --all --overwrite --no-nuget --silent -c &quot;$(MSBuildProjectDirectory)&quot;"
          Condition="'$(_BlaizioNeedAdd)' == 'true'" />
  </Target>

</Project>
