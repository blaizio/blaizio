<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Load the full ICU dataset so non-Gregorian locales (the Arabic Hijri / Persian Jalali calendar
         demos) render their month and weekday names in native script, not Latin transliteration. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>

    <!-- The CLI-copied components compile into this assembly and carry the Blaizio.Ui XML docs the
         API reference renders (boiled down to wwwroot/api/Blaizio.Ui.json below). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Per-checkout package cache. Checkouts pack into their own feed but share a version base,
         and the global ~/.nuget cache holds one extraction per id+version: two checkouts at the
         same revision would otherwise take each other's bytes (stale dist assets, silently).
         Scoping the cache to the checkout ends the fight. -->
    <RestorePackagesPath>$(MSBuildProjectDirectory)\..\..\artifacts\pkg-cache</RestorePackagesPath>
  </PropertyGroup>

  <!--
    The docs site consumes Blaizio exactly like any real consumer would — no project references:

    - Blaizio.Base / Blaizio.Icons come as NuGet packages (from artifacts/local-nuget until they
      are published to nuget.org; the repo nuget.config lists that feed).
    - The styled components are copied in by the Blaizio CLI ("blaizio add") into Components/Ui,
      generated on build and gitignored. blaizio.json pins their namespace to Blaizio.Ui.

    The incremental Blaizio* targets below automate the whole chain: each compares source
    timestamps against its outputs, so edits to src/Blaizio.Base|Icons|Ui|Cli are picked up by the
    next plain build - no flags needed. -p:BlaizioRefresh=true / -p:BlaizioRepack=true force the
    steps by deleting their outputs first (escape hatch when timestamps lie, e.g. after a checkout).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.8" PrivateAssets="all" />
    <!-- Floating on purpose: BlaizioPackPackages mints a new revision every time it repacks (see
         Directory.Build.props), so the version this build has to restore is not known when the
         project is evaluated. The float resolves after the pack, against the local feed, and picks
         exactly what was just written. A fixed pin here is what forced same-version repacks. -->
    <PackageReference Include="Blaizio.Base" Version="0.1.0-alpha.*" />
    <PackageReference Include="Blaizio.Icons" Version="0.1.0-alpha.*" />
    <PackageReference Include="TailwindMerge.NET" Version="1.4.0" />
    <!-- QR encoding for the copied qr-code component. Real consumers get this from the registry
         item's nugetDependencies; the docs add runs with - -no-nuget, so reference it here. -->
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.1.0" />
    <!-- Preset-code encode/decode shared with the CLI's preset flag (PresetCode + its canonical
         option tables) and the registry wire model: a project ref so the docs and the CLI
         literally cannot drift. Contracts only - referencing the full Blaizio.Cli.Core engine
         shipped ~110 KB (brotli) of unused CLI machinery to WebAssembly. -->
    <ProjectReference Include="..\..\src\Blaizio.Cli.Contracts\Blaizio.Cli.Contracts.csproj" />
  </ItemGroup>

  <!-- Every example component's .razor file is ALSO embedded as a resource: the ExampleSource
       service reads it back at runtime so the Demo/UsageBlock code panels show byte-for-byte the
       source that compiled - one file is both the rendered demo and the displayed code. -->
  <ItemGroup>
    <EmbeddedResource Include="Examples\**\*.razor" />
    <!-- Non-component snippets (Program.cs lines, service interfaces) - read back by SnippetSource. -->
    <EmbeddedResource Include="Snippets\**\*.txt" />
    <!-- The color preset token sheets (and Nova's theme.css) - the /themes page's Get Code dialog
         serves their raw text back through Presets.GetCss. Link groups the cross-project files
         under Assets\presets in the IDE instead of the project root. -->
    <EmbeddedResource Include="..\..\src\Blaizio.Ui\Styles\preset-*.css" LogicalName="Blaizio.Docs.Presets.%(Filename)%(Extension)" Link="Assets\presets\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\src\Blaizio.Cli\Assets\theme.css" LogicalName="Blaizio.Docs.Presets.theme.css" Link="Assets\presets\theme.css" />
    <!-- The typeset stylesheet - the /typeset designer's Get Code dialog serves its raw text
         back through TypesetCss.Get, so the copied file is byte-for-byte the one the docs run
         and the registry ships (it lives in Blaizio.Ui as the `typeset` item's source). -->
    <EmbeddedResource Include="..\..\src\Blaizio.Ui\Styles\typeset.css" LogicalName="Blaizio.Docs.Typeset.typeset.css" Link="Assets\typeset\typeset.css" />
  </ItemGroup>

  <!-- The Node toolchain lives at the project ROOT (package.json + node_modules), exactly like a
       real consumer's app - that's what lets Styles/app.css resolve `@import "tailwindcss"` by
       walking up to node_modules. Keep it out of COMPILE and PUBLISH: node_modules is dropped
       from every group (excluded and hidden); package.json / lockfiles / the Tailwind input move
       to None (shown in the IDE, not published - publishing them as Content would collide with
       Blaizio.Base's own toolchain files, NETSDK1152). The Tailwind target reads them by direct
       path, so none of this affects the CSS build. -->
  <ItemGroup>
    <Compile Remove="node_modules\**" />
    <Content Remove="node_modules\**;package.json;pnpm-lock.yaml;pnpm-workspace.yaml;Styles\**;lib\**" />
    <None Remove="node_modules\**" />
    <None Include="package.json;pnpm-lock.yaml;pnpm-workspace.yaml;Styles\**;lib\**" />
  </ItemGroup>

  <!--
    Compile Tailwind (Styles/app.css -> wwwroot/app.css) before static web assets are gathered,
    scanning this app's .razor (including the CLI-copied components) for utility classes. Invoked
    via node directly to sidestep pnpm's pre-run dependency check. Skipped (warning) when
    node_modules is absent.
  -->
  <!-- DocsCssInputs is collected inside a target (not a top-level ItemGroup) on purpose: top-level
       custom items make the IDE draw an extra node per file (or, with Visible=false, hide the file
       entirely). Items created at execution time never reach the IDE's project model, and they're
       ready before BuildDocsTailwind's incremental Inputs check runs. -->
  <Target Name="CollectDocsCssInputs">
    <ItemGroup>
      <DocsCssInputs Include="Styles\**\*.css" />
      <DocsCssInputs Include="**\*.razor" Exclude="node_modules\**;bin\**;obj\**" />
      <DocsCssInputs Include="Components\**\*.cs" />
    </ItemGroup>
  </Target>

  <Target Name="BuildDocsTailwind"
          BeforeTargets="BeforeBuild;ResolveStaticWebAssetsInputs"
          DependsOnTargets="CollectDocsCssInputs"
          Condition="Exists('$(MSBuildProjectDirectory)\node_modules')"
          Inputs="@(DocsCssInputs)"
          Outputs="$(IntermediateOutputPath)blaizio-docs-css.stamp">
    <!-- pin-base.css (the ember skin rescoped under .bz-theme-base) is generated, not committed. -->
    <Exec Command="node tools/make-pin-base.mjs"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Command="node node_modules/@tailwindcss/cli/dist/index.mjs -i Styles/app.css -o wwwroot/app.css --minify"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    <!-- Freshness lives in a dedicated obj/ stamp, NOT in the served asset's timestamp: Tailwind
         skips the write when the output is unchanged, and Touching wwwroot/app.css instead can
         hard-fail the whole build when the file is locked or read-only (it is being served). -->
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(IntermediateOutputPath)blaizio-docs-css.stamp" Lines="built" Overwrite="true" />
  </Target>

  <!-- Bundle the docs scripts (lib/ts/docs.ts -> wwwroot/js/docs.js, and prepaint.ts), the same shape as
       Blaizio.Base's lib/ts pipeline. The ../_content import stays external: it is a runtime
       path into Blazor's static web assets, resolved by the browser, not the bundler. -->
  <Target Name="CollectDocsJsInputs">
    <ItemGroup>
      <DocsJsInputs Include="lib\ts\**\*.ts" />
    </ItemGroup>
  </Target>

  <Target Name="BuildDocsJs"
          BeforeTargets="BeforeBuild;ResolveStaticWebAssetsInputs"
          DependsOnTargets="CollectDocsJsInputs"
          Condition="Exists('$(MSBuildProjectDirectory)\node_modules')"
          Inputs="@(DocsJsInputs)"
          Outputs="$(IntermediateOutputPath)blaizio-docs-js.stamp">
    <Exec Command="node node_modules/esbuild/bin/esbuild lib/ts/docs.ts --bundle --format=esm --external:../_content/* --outfile=wwwroot/js/docs.js --minify --sourcemap"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    <!-- The pre-paint script (lib/ts/prepaint.ts -> wwwroot/js/prepaint.js): a classic IIFE, loaded
         by a plain script tag in index.html before Blazor boots. -->
    <Exec Command="node node_modules/esbuild/bin/esbuild lib/ts/prepaint.ts --bundle --format=iife --outfile=wwwroot/js/prepaint.js --minify --sourcemap"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    <!-- Same staleness guard as app.css: a dedicated obj/ stamp, never the served asset's timestamp. -->
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(IntermediateOutputPath)blaizio-docs-js.stamp" Lines="built" Overwrite="true" />
  </Target>

  <Target Name="WarnMissingDocsNodeModules"
          BeforeTargets="BeforeBuild"
          Condition="!Exists('$(MSBuildProjectDirectory)\node_modules') AND Exists('$(MSBuildProjectDirectory)\package.json')">
    <Warning Text="Blaizio.Docs: node_modules missing - run 'pnpm install' then 'pnpm build:css' in the project root to regenerate wwwroot/app.css." />
  </Target>

  <!-- The copied components compile into this assembly, so our own XML doc file carries the
       Blaizio.Ui member docs. Shipping that XML raw made the first API page parse 600KB /
       ~2900 members with XDocument on the WASM interpreter (a visible second-plus stall), so
       the build boils it down here instead: property and type summaries only, cref/langword
       refs already flattened to text, emitted as the small JSON the API reference fetches. -->
  <UsingTask TaskName="BlaizioApiJson" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <InputFile ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // Mirrors what Blaizio.Docs.Services.ApiDocs used to do at runtime: flatten a <summary>
        // to plain text, resolving <see cref="..."/> / langword to their short names.

        string ShortName(string cref)
        {
            if (string.IsNullOrEmpty(cref)) return null;
            var name = cref.Length > 2 && cref[1] == ':' ? cref.Substring(2) : cref;
            var paren = name.IndexOf('(');
            if (paren >= 0) name = name.Substring(0, paren);
            var dot = name.LastIndexOf('.');
            return dot >= 0 ? name.Substring(dot + 1) : name;
        }

        // Every whitespace run in the doc text becomes ONE space - including the newlines the
        // source is hard-wrapped with, which are an editor artefact and not authored breaks. That
        // leaves the newline free to mean a real break, which is what Walk emits below.
        string Collapse(string text)
        {
            var buffer = new StringBuilder(text.Length);
            var pendingSpace = false;
            foreach (var ch in text)
            {
                if (char.IsWhiteSpace(ch)) { pendingSpace = true; continue; }
                if (pendingSpace) { buffer.Append(' '); pendingSpace = false; }
                buffer.Append(ch);
            }
            if (pendingSpace) buffer.Append(' ');
            return buffer.ToString();
        }

        // Newlines are the ONE piece of structure that survives into the flat string: <para> starts
        // a line, <item> starts a bulleted one. The API table renders the cell whitespace-pre-line,
        // so a summary that documents a grammar plus a handful of examples reads as a list rather
        // than one run-on paragraph. Everything else is unwrapped to its text.
        void Walk(XNode node, StringBuilder sb)
        {
            if (node is XText text) { sb.Append(Collapse(text.Value)); return; }
            if (node is XElement el)
            {
                if (el.Name.LocalName == "see" || el.Name.LocalName == "seealso")
                {
                    var cref = (string)el.Attribute("cref");
                    var langword = (string)el.Attribute("langword");
                    sb.Append(langword ?? ShortName(cref) ?? el.Value);
                    return;
                }
                if (el.Name.LocalName == "para" || el.Name.LocalName == "list") sb.Append('\n');
                if (el.Name.LocalName == "item") sb.Append("\n• ");
                foreach (var child in el.Nodes()) Walk(child, sb);
                if (el.Name.LocalName == "para") sb.Append('\n');
            }
        }

        // Trim each line and drop the empty ones. Text whitespace is already collapsed by
        // Collapse, so every newline still standing is one Walk deliberately emitted.
        string Normalise(string raw)
        {
            var lines = raw.Split('\n')
                .Select(line => string.Join(" ", line.Split((char[])null, StringSplitOptions.RemoveEmptyEntries)))
                .Where(line => line.Length > 0);
            return string.Join("\n", lines);
        }

        string Escape(string s)
        {
            var sb = new StringBuilder(s.Length + 8);
            foreach (var c in s)
            {
                if (c == '"') sb.Append("\\\"");
                else if (c == '\\') sb.Append("\\\\");
                else if (c < ' ') sb.Append("\\u").Append(((int)c).ToString("x4"));
                else sb.Append(c);
            }
            return sb.ToString();
        }

        var doc = XDocument.Load(InputFile);
        var json = new StringBuilder("{");
        var first = true;
        foreach (var member in doc.Root.Element("members").Elements("member"))
        {
            var name = (string)member.Attribute("name");
            var summary = member.Element("summary");
            // Only what the runtime looks up: P: (parameter rows) and T: (type summaries).
            if (name == null || summary == null || (!name.StartsWith("P:") && !name.StartsWith("T:"))) continue;
            var sb = new StringBuilder();
            Walk(summary, sb);
            var flat = Normalise(sb.ToString());
            if (flat.Length == 0) continue;
            if (!first) json.Append(',');
            first = false;
            json.Append('"').Append(Escape(name)).Append("\":\"").Append(Escape(flat)).Append('"');
        }
        json.Append('}');
        Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
        File.WriteAllText(OutputFile, json.ToString(), new UTF8Encoding(false));
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateBlaizioApiJson"
          AfterTargets="Compile"
          BeforeTargets="ResolveStaticWebAssetsInputs"
          Inputs="$(IntermediateOutputPath)$(AssemblyName).xml"
          Outputs="$(MSBuildProjectDirectory)\wwwroot\api\Blaizio.Ui.json"
          Condition="Exists('$(IntermediateOutputPath)$(AssemblyName).xml')">
    <BlaizioApiJson InputFile="$(IntermediateOutputPath)$(AssemblyName).xml"
                    OutputFile="$(MSBuildProjectDirectory)\wwwroot\api\Blaizio.Ui.json" />
    <!-- The raw-XML era left a 600KB Blaizio.Ui.xml behind; anything lingering in wwwroot/api
         would still publish, so clear the folder down to the JSON. -->
    <Delete Files="$(MSBuildProjectDirectory)\wwwroot\api\Blaizio.Ui.xml" />
  </Target>

  <!--
    Consumer preparation: everything a real consumer's machine would have, produced by this build.
    Split into incremental targets - MSBuild's Inputs/Outputs timestamp check decides what reruns,
    so stale copies can't survive a plain build (the old existence-only checks let e.g. a
    pre-refactor Components/Ui linger while the registry moved on):
      1. BlaizioPackPackages: pack Blaizio.Base + Blaizio.Icons into the local feed whenever their
         sources are newer than the last pack, each time under a fresh revision the floating
         PackageReferences above then resolve to.
      2. BlaizioBuildCli: rebuild the CLI when its sources changed (stamped in obj/, since
         "dotnet build" leaves the dll untouched when up to date).
      3. BlaizioBuildRegistry: regenerate registry.json and compile it into wwwroot/r - served by
         the docs origin at /r/*.json (blaiz.io/r in production) - whenever src/Blaizio.Ui or the
         CLI changed. wwwroot/r is purged first so items removed upstream don't linger.
      4. BlaizioAddComponents: "blaizio add" (all components, overwrite + prune) copies everything
         into Components/Ui (blaizio.json pins the namespace to Blaizio.Ui) and deletes orphaned
         files no registry item ships anymore. Completion is stamped in obj/.
    -p:BlaizioRepack=true / -p:BlaizioRefresh=true force steps 1 / 3+4 by deleting their outputs.
    Runs before Restore so freshly packed packages are resolvable in the same invocation.
  -->
  <PropertyGroup>
    <_BlaizioSrc>$(MSBuildProjectDirectory)\..\..\src</_BlaizioSrc>
    <_BlaizioFeed>$(MSBuildProjectDirectory)\..\..\artifacts\local-nuget</_BlaizioFeed>
    <!-- The revision counter this build advances, and the stamp that records the pack. Freshness
         cannot hang off the .nupkg path anymore: every pack writes a DIFFERENT filename, so a
         version-named output would never exist and the target would fire on every build. -->
    <_BlaizioRevisionFile>$(MSBuildProjectDirectory)\..\..\artifacts\pack-revision.txt</_BlaizioRevisionFile>
    <_BlaizioPackStamp>$(BaseIntermediateOutputPath)blaizio-pack.stamp</_BlaizioPackStamp>
    <_BlaizioCliDll>$(_BlaizioSrc)\Blaizio.Cli\bin\Release\net10.0\blaizio.dll</_BlaizioCliDll>
    <_BlaizioCliStamp>$(BaseIntermediateOutputPath)blaizio-cli.stamp</_BlaizioCliStamp>
    <_BlaizioAddStamp>$(BaseIntermediateOutputPath)blaizio-add.stamp</_BlaizioAddStamp>
    <_BlaizioRegistryDir>$(MSBuildProjectDirectory)\wwwroot\r</_BlaizioRegistryDir>
  </PropertyGroup>

  <Target Name="CollectBlaizioSources">
    <ItemGroup>
      <!-- wwwroot/dist is REGENERATED by Base's own bundler during pack (after the nupkg is
           written), so including it makes this target perpetually stale - every docs build then
           purges the NuGet cache and NETSDK1064s. The lib/ts sources it's built from still gate. -->
      <BlaizioBaseSources Include="$(_BlaizioSrc)\Blaizio.Base\**" Exclude="$(_BlaizioSrc)\Blaizio.Base\bin\**;$(_BlaizioSrc)\Blaizio.Base\obj\**;$(_BlaizioSrc)\Blaizio.Base\node_modules\**;$(_BlaizioSrc)\Blaizio.Base\wwwroot\dist\**" />
      <!-- Blaizio.Base packs two files from OUTSIDE its own folder (the Tailwind contract sheet
           from Blaizio.Ui, the vendored tw-animate from the CLI's assets), so they gate the pack
           too. Without them an edit to blaizio.css reaches the docs - which import it straight
           from source - while every packaged consumer stays on the previous sheet. -->
      <BlaizioIconsSources Include="$(_BlaizioSrc)\Blaizio.Icons\**" Exclude="$(_BlaizioSrc)\Blaizio.Icons\bin\**;$(_BlaizioSrc)\Blaizio.Icons\obj\**" />
      <BlaizioBaseSources Include="$(_BlaizioSrc)\Blaizio.Ui\Styles\blaizio.css;$(_BlaizioSrc)\Blaizio.Cli\Assets\animate.css" />
      <!-- registry.json is generated by BlaizioBuildRegistry itself - excluded so its own write
           can't retrigger the step. -->
      <BlaizioUiSources Include="$(_BlaizioSrc)\Blaizio.Ui\**" Exclude="$(_BlaizioSrc)\Blaizio.Ui\bin\**;$(_BlaizioSrc)\Blaizio.Ui\obj\**;$(_BlaizioSrc)\Blaizio.Ui\registry.json" />
      <BlaizioCliSources Include="$(_BlaizioSrc)\Blaizio.Cli\**;$(_BlaizioSrc)\Blaizio.Cli.Core\**;$(_BlaizioSrc)\Blaizio.Cli.Contracts\**" Exclude="$(_BlaizioSrc)\Blaizio.Cli\bin\**;$(_BlaizioSrc)\Blaizio.Cli\obj\**;$(_BlaizioSrc)\Blaizio.Cli.Core\bin\**;$(_BlaizioSrc)\Blaizio.Cli.Core\obj\**;$(_BlaizioSrc)\Blaizio.Cli.Contracts\bin\**;$(_BlaizioSrc)\Blaizio.Cli.Contracts\obj\**" />
    </ItemGroup>
  </Target>

  <!-- The force flags work by deleting step outputs, which fails the timestamp checks below. -->
  <Target Name="BlaizioForce" Condition="'$(BlaizioRepack)' == 'true' OR '$(BlaizioRefresh)' == 'true'">
    <Delete Files="$(_BlaizioPackStamp)" Condition="'$(BlaizioRepack)' == 'true'" />
    <Delete Files="$(_BlaizioAddStamp)" Condition="'$(BlaizioRefresh)' == 'true'" />
    <RemoveDir Directories="$(_BlaizioRegistryDir)" Condition="'$(BlaizioRefresh)' == 'true'" />
  </Target>

  <Target Name="BlaizioPackPackages"
          BeforeTargets="Restore;BeforeBuild"
          DependsOnTargets="CollectBlaizioSources;BlaizioForce"
          Inputs="@(BlaizioBaseSources);@(BlaizioIconsSources)"
          Outputs="$(_BlaizioPackStamp)">
    <!-- Advance the revision BEFORE packing and hand the SAME one to both packages: they restore
         as a pair, and a split version fails the consumer with MSB3375. Because every pack now
         writes a version of its own, nothing purges the NuGet cache here anymore - the extraction
         the cache holds belongs to a version these bytes will never claim. -->
    <PropertyGroup>
      <_BlaizioRevision>0</_BlaizioRevision>
      <_BlaizioRevision Condition="Exists('$(_BlaizioRevisionFile)')">$([System.IO.File]::ReadAllText('$(_BlaizioRevisionFile)').Trim())</_BlaizioRevision>
      <_BlaizioRevision>$([MSBuild]::Add($(_BlaizioRevision), 1))</_BlaizioRevision>
    </PropertyGroup>
    <WriteLinesToFile File="$(_BlaizioRevisionFile)" Lines="$(_BlaizioRevision)" Overwrite="true" />
    <Exec Command="dotnet pack &quot;$(_BlaizioSrc)\Blaizio.Base\Blaizio.Base.csproj&quot; -c Release -o &quot;$(_BlaizioFeed)&quot; -v q -p:BlaizioPackRevision=$(_BlaizioRevision)" />
    <Exec Command="dotnet pack &quot;$(_BlaizioSrc)\Blaizio.Icons\Blaizio.Icons.csproj&quot; -c Release -o &quot;$(_BlaizioFeed)&quot; -v q -p:BlaizioPackRevision=$(_BlaizioRevision)" />
    <!-- Drop the revisions this one replaces. They are dogfood-only by construction (a revision is
         never the version handed to a consumer), and leaving one per edit to Base or Icons grows
         the feed without bound. The plain versions - what consumers pin - are not matched: their
         filenames end at the base version. -->
    <ItemGroup>
      <_BlaizioStaleRevision Include="$(_BlaizioFeed)\Blaizio.Base.$(BlaizioVersionBase).*.nupkg;$(_BlaizioFeed)\Blaizio.Icons.$(BlaizioVersionBase).*.nupkg"
                             Exclude="$(_BlaizioFeed)\Blaizio.Base.$(BlaizioVersionBase).$(_BlaizioRevision).nupkg;$(_BlaizioFeed)\Blaizio.Icons.$(BlaizioVersionBase).$(_BlaizioRevision).nupkg" />
    </ItemGroup>
    <Delete Files="@(_BlaizioStaleRevision)" />
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <Touch Files="$(_BlaizioPackStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="BlaizioBuildCli"
          DependsOnTargets="CollectBlaizioSources"
          Inputs="@(BlaizioCliSources)"
          Outputs="$(_BlaizioCliStamp)">
    <Exec Command="dotnet build &quot;$(_BlaizioSrc)\Blaizio.Cli\Blaizio.Cli.csproj&quot; -c Release -v q" />
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <Touch Files="$(_BlaizioCliStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="BlaizioBuildRegistry"
          BeforeTargets="Restore;BeforeBuild"
          DependsOnTargets="CollectBlaizioSources;BlaizioForce;BlaizioBuildCli"
          Inputs="@(BlaizioUiSources);$(_BlaizioCliStamp)"
          Outputs="$(_BlaizioRegistryDir)\index.json">
    <RemoveDir Directories="$(_BlaizioRegistryDir)" />
    <Exec Command="dotnet &quot;$(_BlaizioCliDll)&quot; generate &quot;$(_BlaizioSrc)\Blaizio.Ui&quot; --fonts" />
    <Exec Command="dotnet &quot;$(_BlaizioCliDll)&quot; build .\registry.json -o &quot;$(_BlaizioRegistryDir)&quot; --cwd &quot;$(_BlaizioSrc)\Blaizio.Ui&quot;" />
  </Target>

  <!-- The global-usings file doubles as a second output: deleting Components/Ui by hand makes the
       step rerun even though the stamp survived in obj/. -->
  <Target Name="BlaizioAddComponents"
          BeforeTargets="Restore;BeforeBuild"
          DependsOnTargets="BlaizioForce;BlaizioBuildRegistry"
          Inputs="$(_BlaizioRegistryDir)\index.json"
          Outputs="$(_BlaizioAddStamp);$(MSBuildProjectDirectory)\Components\Ui\Blaizio.GlobalUsings.g.cs">
    <!-- Forcing the overwrite is deliberate: Components/Ui is generated output, not a working
         copy. An unattended add keeps files it cannot prove are untouched (and a record written
         before the hash ledger can prove nothing), which would leave the dogfood on old sources. -->
    <Exec Command="dotnet &quot;$(_BlaizioCliDll)&quot; add --all --overwrite --force-overwrite --prune --no-nuget --silent -c &quot;$(MSBuildProjectDirectory)&quot;" />
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <!-- Stamp BOTH declared outputs (same trap the pack target documents): add skips rewriting an
         unchanged GlobalUsings.g.cs, and one stale output re-fires this target - and its full
         Components/Ui rewrite - on every subsequent build, which in turn re-fires the Tailwind
         build by bumping every .razor input. -->
