@implements IDisposable
@inject NavigationManager Nav
@*
    The foot of every component page (rendered once by MainLayout for /components/* routes). A balanced
    two-column row: previous on the left, next on the right (an empty cell holds the column when an edge
    component has no neighbor on one side, so prev always reads left and next always reads right). The
    API Reference / Documentation jump lives next to the page title (see PageHeaderActions), along with
    arrow buttons to the same two neighbors; paging stays within the current mode (docs<->docs,
    api<->api). Derived from the URL by DocsNav.Paging.
*@
@if (_prev is not null || _next is not null)
{
    <footer class="mt-16 border-t pt-8">
        <div class="grid gap-4 sm:grid-cols-2">
            @if (_prev is not null) { @PrevCard(_prev) } else { <div></div> }
            @if (_next is not null) { @NextCard(_next) }
        </div>
    </footer>
}

@code {
    private PageLink? _prev;
    private PageLink? _next;

    private const string CardClass =
        "group flex min-h-[5rem] flex-col justify-center rounded-xl border bg-card p-4 no-underline " +
        "transition-all hover:border-primary/50 hover:bg-accent/30 " +
        // The standard two-layer focus treatment (border-ring + halo), not the UA outline.
        "outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50";

    private RenderFragment PrevCard(PageLink e) => @<a href="@e.Href" class="@($"{CardClass} flex flex-col")">
        <span class="text-muted-foreground flex items-center gap-1 text-xs">
            <BzIcon Icon="@Tabler.Outline.ArrowLeft" Class="size-3.5 transition-transform group-hover:-translate-x-0.5 rtl:rotate-180" />Previous
        </span>
        <span class="text-foreground group-hover:text-primary-ink mt-1 font-medium transition-colors">@e.Label</span>
        <span class="text-muted-foreground mt-0.5 line-clamp-1 text-sm">@e.Blurb</span>
    </a>;

    private RenderFragment NextCard(PageLink e) => @<a href="@e.Href" class="@($"{CardClass} flex flex-col text-end")">
        <span class="text-muted-foreground flex items-center justify-end gap-1 text-xs">
            Next<BzIcon Icon="@Tabler.Outline.ArrowRight" Class="size-3.5 transition-transform group-hover:translate-x-0.5 rtl:rotate-180" />
        </span>
        <span class="text-foreground group-hover:text-primary-ink mt-1 font-medium transition-colors">@e.Label</span>
        <span class="text-muted-foreground mt-0.5 line-clamp-1 text-sm">@e.Blurb</span>
    </a>;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        Recompute();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        Recompute();
        StateHasChanged();
    }

    private void Recompute() =>
        (_prev, _next) = DocsNav.Paging(Nav.ToBaseRelativePath(Nav.Uri)) ?? (null, null);

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
