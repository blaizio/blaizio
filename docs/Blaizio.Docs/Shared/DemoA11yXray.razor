@inject IDocsJs Js
@implements IAsyncDisposable
@*
    The Demo accessibility x-ray: while Active, chips every accessibility-relevant element of the
    preview with its role and tab-stop order, and shows the hovered element's computed name and
    aria state here. Interaction stays LIVE (unlike the inspect probe) so aria state flips
    re-annotate. Owns the JS session and the details strip; the parent only flips Active.
*@

@if (Active)
{
    <div class="border-t px-4 py-3 text-sm" aria-live="polite">
        @if (_tag is null)
        {
            <p class="text-muted-foreground text-xs">Chips show each element's role and tab-stop order. Operate the demo normally - state changes re-annotate. Hover an outlined element for its details.</p>
        }
        else
        {
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <span class="font-semibold">@(_role ?? $"<{_tag}>")</span>
                @if (_tabStop > 0)
                {
                    <span class="text-muted-foreground text-xs">tab stop @_tabStop</span>
                }
                else
                {
                    <span class="text-muted-foreground text-xs">not tabbable</span>
                }
            </div>
            <p class="mt-1 text-xs">
                <span class="text-muted-foreground">Accessible name (computed):</span>
                @if (string.IsNullOrEmpty(_name))
                {
                    <span class="text-destructive ms-1 font-medium">none</span>
                }
                else
                {
                    <span class="ms-1 font-medium">"@_name"</span>
                }
            </p>
            @if (_aria.Count > 0)
            {
                <div class="mt-2 flex flex-wrap items-center gap-1.5">
                    @foreach (var pair in _aria)
                    {
                        <code class="bg-muted rounded-md px-1.5 py-0.5 font-mono text-xs">@pair</code>
                    }
                </div>
            }
        }
    </div>
}

@code {
    /// <summary>The preview element the x-ray overlays.</summary>
    [Parameter] public ElementReference Preview { get; set; }

    /// <summary>Whether the x-ray is running. The session starts/stops as this flips.</summary>
    [Parameter] public bool Active { get; set; }

    private IJSObjectReference? _session;
    private DotNetObjectReference<DemoA11yXray>? _selfRef;
    private string? _role;
    private string? _tag;
    private string _name = "";
    private int _tabStop = -1;
    private IReadOnlyList<string> _aria = [];

    protected override async Task OnParametersSetAsync()
    {
        if (Active && _session is null)
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            _tag = null;
            _session = await Js.A11yStartAsync(Preview, _selfRef);
        }
        else if (!Active && _session is not null)
        {
            await StopAsync();
        }
    }

    /// <summary>js/docs.ts reports the hovered accessibility-annotated element (nulls on leave).</summary>
    [JSInvokable]
    public void OnA11yHover(string? role, string? name, int tabStop, string[] aria, string? tag)
    {
        // Movement within one element re-reports identical details - skip the render.
        if (tag == _tag && role == _role && (name ?? "") == _name
            && tabStop == _tabStop && aria.SequenceEqual(_aria, StringComparer.Ordinal))
            return;

        _role = role;
        _name = name ?? "";
        _tabStop = tabStop;
        _aria = aria;
        _tag = tag;
        StateHasChanged(); // [JSInvokable] isn't a Blazor event - flush the panel ourselves.
    }

    private async Task StopAsync()
    {
        _tag = null;
        if (_session is not null)
        {
            try
            {
                await _session.InvokeVoidAsync("dispose");
                await _session.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Runtime already gone - nothing to clean up.
            }
            _session = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        await StopAsync();
        _selfRef?.Dispose();
    }
}
