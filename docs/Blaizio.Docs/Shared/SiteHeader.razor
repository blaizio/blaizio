@implements IDisposable
@inject NavigationManager Nav
@inject IDocsJs Js
@*
    The site-wide top bar: logo, the primary nav (Docs / Components / Examples / Charts, from
    DocsNav.SiteNav) and the trailing controls - search (mod+K palette), GitHub, the theme
    switcher, and the Create / Get Code action. Used by BOTH layouts:

    BOTH layouts (MainLayout and CreateLayout) wrap the header in a BzSidebarProvider, so the
    cascaded SidebarContext is non-null everywhere and the mobile hamburger is always a
    BzSidebarTrigger opening the same full docs menu sheet (NavMenu - brand header, Home + site
    links, guides, components).

    Desktop has no sidebar toggle at all - the docs sidebar is pinned open (MainLayout passes
    Open="true"; CreateLayout keeps it collapsed off screen), so the hamburger renders only below md.
*@
<header class="sticky top-0 z-40 flex h-14 items-center gap-3 border-b bg-background/80 px-6 backdrop-blur">
    @* Every layout (docs AND /create) now wraps the header in a BzSidebarProvider, so this one
       trigger opens the SAME full docs menu (NavMenu) everywhere. *@
    @if (Sidebar is not null)
    {
        <BzSidebarTrigger Class="md:hidden">
            <BzIcon Icon="@Icons.Outline.Menu" Class="size-4.5" />
        </BzSidebarTrigger>
    }

    <a href="" class="focus-ring -mx-2 flex items-center rounded-md px-2 py-1 text-foreground no-underline" aria-label="Blaizio home">
        <BrandLogo Class="h-5 w-auto" />
    </a>
    <span class="rounded bg-muted px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wide text-muted-foreground">alpha</span>

    <nav class="ms-4 hidden items-center gap-1 md:flex">
        @foreach (var item in DocsNav.SiteNav)
        {
            <BzButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                      Class="@($"no-underline {(IsActive(item) ? "text-foreground" : "font-normal text-muted-foreground hover:text-foreground")}")">
                <RenderAs Context="p">
                    <a href="@item.Href" @attributes="p.Attributes">@item.Label</a>
                </RenderAs>
            </BzButton>
        }
    </nav>

    <div class="ms-auto flex items-center gap-2">
        @* The search box is a button dressed as an input; the real input lives in the palette.
           The bz-input hook hands it the skin's field look (border, radius, shadow, focus ring)
           so it reads as an input, not a button. data-slot="input-group" lets the kbd chip pick
           up the same on-field fill every skin gives a kbd inside an input group. *@
        <button type="button" data-slot="input-group"
                class="bz-input hidden h-8 w-56 cursor-pointer items-center gap-2 text-muted-foreground select-none md:flex"
                @onclick="() => _searchOpen = true">
            <BzIcon Icon="@Icons.Outline.Search" Class="size-3.5 shrink-0" />
            <span class="truncate">Search documentation...</span>
            <BzKbd Key="mod+k" Class="ms-auto shrink-0" />
        </button>
        <BzButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" Class="md:hidden" aria-label="Search documentation" @onclick="() => _searchOpen = true">
            <BzIcon Icon="@Icons.Outline.Search" Class="size-4.5" />
        </BzButton>

        <BzButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="no-underline">
            <RenderAs Context="p">
                <a href="https://github.com/blaizio/blaizio" target="_blank" rel="noreferrer" @attributes="p.Attributes">
                    @* The official GitHub mark (fill=currentColor, so it follows the button's text
                       color in light and dark) - the Tabler outline glyph isn't the brand mark. *@
                    <svg viewBox="0 0 438.549 438.549" class="size-4" aria-hidden="true"><path fill="currentColor" d="M409.132 114.573c-19.608-33.596-46.205-60.194-79.798-79.8-33.598-19.607-70.277-29.408-110.063-29.408-39.781 0-76.472 9.804-110.063 29.408-33.596 19.605-60.192 46.204-79.8 79.8C9.803 148.168 0 184.854 0 224.63c0 47.78 13.94 90.745 41.827 128.906 27.884 38.164 63.906 64.572 108.063 79.227 5.14.954 8.945.283 11.419-1.996 2.475-2.282 3.711-5.14 3.711-8.562 0-.571-.049-5.708-.144-15.417a2549.81 2549.81 0 01-.144-25.406l-6.567 1.136c-4.187.767-9.469 1.092-15.846 1-6.374-.089-12.991-.757-19.842-1.999-6.854-1.231-13.229-4.086-19.13-8.559-5.898-4.473-10.085-10.328-12.56-17.556l-2.855-6.57c-1.903-4.374-4.899-9.233-8.992-14.559-4.093-5.331-8.232-8.945-12.419-10.848l-1.999-1.431c-1.332-.951-2.568-2.098-3.711-3.429-1.142-1.331-1.997-2.663-2.568-3.997-.572-1.335-.098-2.43 1.427-3.289 1.525-.859 4.281-1.276 8.28-1.276l5.708.853c3.807.763 8.516 3.042 14.133 6.851 5.614 3.806 10.229 8.754 13.846 14.842 4.38 7.806 9.657 13.754 15.846 17.847 6.184 4.093 12.419 6.136 18.699 6.136 6.28 0 11.704-.476 16.274-1.423 4.565-.952 8.848-2.383 12.847-4.285 1.713-12.758 6.377-22.559 13.988-29.41-10.848-1.14-20.601-2.857-29.264-5.14-8.658-2.286-17.605-5.996-26.835-11.14-9.235-5.137-16.896-11.516-22.985-19.126-6.09-7.614-11.088-17.61-14.987-29.979-3.901-12.374-5.852-26.648-5.852-42.826 0-23.035 7.52-42.637 22.557-58.817-7.044-17.318-6.379-36.732 1.997-58.24 5.52-1.715 13.706-.428 24.554 3.853 10.85 4.283 18.794 7.952 23.84 10.994 5.046 3.041 9.089 5.618 12.135 7.708 17.705-4.947 35.976-7.421 54.818-7.421s37.117 2.474 54.823 7.421l10.849-6.849c7.419-4.57 16.18-8.758 26.262-12.565 10.088-3.805 17.802-4.853 23.134-3.138 8.562 21.509 9.325 40.922 2.279 58.24 15.036 16.18 22.559 35.787 22.559 58.817 0 16.178-1.958 30.497-5.853 42.966-3.9 12.471-8.941 22.457-15.125 29.979-6.191 7.521-13.901 13.85-23.131 18.986-9.232 5.14-18.182 8.85-26.84 11.136-8.662 2.286-18.415 4.004-29.263 5.146 9.894 8.562 14.842 22.077 14.842 40.539v60.237c0 3.422 1.19 6.279 3.572 8.562 2.379 2.279 6.136 2.95 11.276 1.995 44.163-14.653 80.185-41.062 108.068-79.226 27.88-38.161 41.825-81.126 41.825-128.906-.01-39.771-9.818-76.454-29.414-110.049z"></path></svg>
                    @* Placeholder count until the repo is public and we fetch the real stars. *@
                    <span class="text-xs tabular-nums text-muted-foreground">12.4k</span>
                </a>
            </RenderAs>
        </BzButton>

        @* "D" flips light/dark app-wide (wired in docs.js); the tooltip advertises the shortcut.
           A single cycling button: light -> dark -> system (the monitor icon while following the OS). *@
        <BzTooltip>
            <BzTooltipTrigger>
                <RenderAs Context="p">
                    <span @attributes="p.Attributes"><BzThemeToggle ShowSystem="true" Class="size-8" /></span>
                </RenderAs>
            </BzTooltipTrigger>
            <BzTooltipContent>Toggle theme <BzKbd Class="ms-1">D</BzKbd><BzTooltipArrow /></BzTooltipContent>
        </BzTooltip>

        @if (CreateMode)
        {
            @* On /create the primary action is exporting the current look, not starting a new one.
               Desktop only - on mobile Get Code lives in the composer's bottom panel. *@
            <BzButton Size="ButtonSize.Sm" Class="max-md:hidden" @onclick="OnGetCode">
                <BzIcon Icon="@Icons.Outline.Code" Class="size-4" /> Get Code
            </BzButton>
        }
        else
        {
            @* Desktop only - on mobile Create lives inside the main menu. *@
            <BzButton Size="ButtonSize.Sm" Class="no-underline max-md:hidden">
                <RenderAs Context="p">
                    <a href="create" @onclick="OnCreateAsync" @onclick:preventDefault @attributes="p.Attributes">
                        <BzIcon Icon="@Icons.Outline.Plus" Class="size-4" /> Create
                    </a>
                </RenderAs>
            </BzButton>
        }
    </div>
</header>

<SearchDialog @bind-Open="_searchOpen" />
<BaseHotkey Combo="mod+k" OnTrigger="() => _searchOpen = true" />

@code {
    private bool _searchOpen;
    private string _path = "";

    /// <summary>Non-null when rendered inside a BzSidebarProvider (the docs layout).</summary>
    [CascadingParameter] private SidebarContext? Sidebar { get; set; }

    /// <summary>Seeded from the persisted dir on first render so each layout's direction cascade stays wired.</summary>
    [Parameter] public EventCallback<Direction> DirectionChanged { get; set; }

    /// <summary>On the /create tool the trailing button is "Get Code" (see <see cref="OnGetCode"/>) instead of "+ Create".</summary>
    [Parameter] public bool CreateMode { get; set; }

    /// <summary>Invoked by the "Get Code" button in <see cref="CreateMode"/>.</summary>
    [Parameter] public EventCallback OnGetCode { get; set; }

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        Recompute();
    }

    // The /create tool always opens on the default Nova palette: a preset left over from a
    // previous visit would silently skew every color the composer previews.
    private async Task OnCreateAsync()
    {
        await Js.SetPresetAsync("nova");
        Nav.NavigateTo("create");
    }


    // Seed the layout's direction cascade from the persisted dir (already applied pre-paint by
    // boot.js) - this used to live in the removed ThemeToggle's style/dir selects.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var dir = await Js.GetDirAsync();
        await DirectionChanged.InvokeAsync(dir == "rtl" ? Direction.Rtl : Direction.Ltr);

        // Persisted /create webfont picks follow the visitor around the docs: boot.js re-applied
        // their overlay classes pre-paint, but the stylesheet itself must load each session. The
        // header renders on every layout, so this covers every page.
        foreach (var name in new[] { await Js.GetHeadingAsync(), await Js.GetFontAsync() })
        {
            if (FontCatalog.CssUrl(name) is { } url)
                await Js.LoadWebFontAsync(url);
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        Recompute();
        StateHasChanged();
    }

    private void Recompute()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        var cut = path.IndexOfAny(['?', '#']);
        _path = (cut >= 0 ? path[..cut] : path).TrimEnd('/');
    }

    // "Docs" lights up on every guide route (the Introduction at /docs included) EXCEPT the
    // component routes, which belong to "Components"; the rest are simple prefix matches.
    private bool IsActive(SiteNavEntry item) => item.Href switch
    {
        "docs" => _path.Length == 0
            || (_path.StartsWith("docs", StringComparison.OrdinalIgnoreCase)
                && !_path.StartsWith("docs/components", StringComparison.OrdinalIgnoreCase)),
        "docs/components" => _path.StartsWith("docs/components", StringComparison.OrdinalIgnoreCase),
        _ => _path.StartsWith(item.Href, StringComparison.OrdinalIgnoreCase),
    };

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
