@using Blaizio.Cli.Core.Registry
@inject IRegistrySource Registry
@inject IDocsJs Js
@*
    The "Source" dialog on a component doc page: the EXACT files `blaizio add <item>` would copy
    into a project, fetched from the docs' own registry build at /r. In v3 the look ships inlined
    in the component classes, so the source is per-style - the dialog reads the visitor's active
    style (the same persisted selection the search palette and the Themes page use) and fetches that
    style's variant from /r/{style}/. Opened imperatively through IDialogService (see
    PageHeaderActions); the Item name arrives via ShowAsync parameters.
*@
<BzDialogHeader>
    @* The heading reads the page's display label ("Virtualizer source"); the command below keeps the
       registry slug, which is what `blaizio add` actually takes. *@
    <BzDialogTitle>@(Label ?? Item) source</BzDialogTitle>
    <BzDialogDescription>
        @if (_item is not null)
        {
            <text>What <code class="text-foreground">blaizio add @Item</code> copies into your project: the
            <span class="text-foreground">@_style</span> style, inlined. Switch styles from search (Ctrl+K, Styles) or on
            <a class="underline underline-offset-4" href="themes">Themes</a>, then reopen to compare.</text>
        }
        else if (_loaded)
        {
            <text>This item isn't in the registry.</text>
        }
        else
        {
            <text>Loading...</text>
        }
    </BzDialogDescription>
</BzDialogHeader>

@if (_item is { Files.Count: > 0 })
{
    <BzTabs DefaultValue="@_item.Files[0].Path" Class="mt-1 min-w-0">
        @* overflow-x-auto computes overflow-y to auto too - pin it hidden or a vertical
           scrollbar appears inside the pill row (the triggers overhang the list's padding box). *@
        <BzTabsList AriaLabel="Source files" Class="scrollbar-thin h-auto max-w-full justify-start overflow-x-auto overflow-y-hidden">
            @foreach (var file in _item.Files)
            {
                <BzTabsTrigger Value="@file.Path">@FileName(file.Path)</BzTabsTrigger>
            }
        </BzTabsList>
        @foreach (var file in _item.Files)
        {
            <BzTabsContent Value="@file.Path" Class="pt-3">
                @* Both axes scroll on the content itself: with the vertical scroll on an outer
                   wrapper the horizontal bar sits at the bottom of the full content height -
                   off-screen until you scroll all the way down. On one box it stays visible.
                   Copy takes the file as published, byte for byte. *@
                <BzCodeBlock Class="not-typeset">
                    <BzCodeBlockActions>
                        <BzCodeBlockWrapButton />
                        <BzCodeBlockCopyButton Value="@(file.Content ?? "")" />
                    </BzCodeBlockActions>
                    <BzCodeBlockContent Code="@(file.Content ?? "")" Language="@LanguageOf(file)" LineNumbers
                                        role="region" aria-label="Source code" Class="max-h-[60vh]" />
                </BzCodeBlock>
            </BzTabsContent>
        }
    </BzTabs>
}

@code {
    /// <summary>The registry item name (the doc page's slug, e.g. <c>button</c>).</summary>
    [Parameter, EditorRequired] public string Item { get; set; } = "";

    /// <summary>The page's display label (e.g. <c>Virtualizer</c>). Falls back to <see cref="Item"/>.</summary>
    [Parameter] public string? Label { get; set; }

    private RegistryItem? _item;
    private string _style = "ember";
    private bool _loaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        // The active style is a JS-side persisted preference - readable only after render.
        _style = await Js.GetStyleAsync();
        _item = await Registry.GetItemAsync(Item, _style);
        _loaded = true;
        StateHasChanged();
    }

    // The file's extension names its language (razor, cs, css, ts, json); anything else is sniffed.
    private static string? LanguageOf(RegistryFile file) =>
        CodeLanguage.Detect(file.Content ?? "", Path.GetExtension(file.Path).TrimStart('.'));

    private static string FileName(string path) => path[(path.LastIndexOf('/') + 1)..];
}
