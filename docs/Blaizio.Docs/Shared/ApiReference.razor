@inject IApiDocs ApiDocs
@inject ISnippetSource Snippets
@*
    The body of a component's API page. Pass the whole family - the parent plus its children (e.g.
    Dialog, DialogTrigger, DialogContent, ...) - and it renders one table per component (Prop /
    Type / Default / Description), filled by reflection + the shipped XML docs (ApiDocs).

    Each component name is a data-toc heading, so the page's On This Page rail lists the family
    (BzInputGroup, BzInputGroupAddon, ...). There is no "API Reference" section heading: the page's
    own h1 already says it, and as a lone rail entry it told the reader nothing.

    Every styled component also follows the ambient reading direction and accepts a per-component
    dir override, so the section closes with a standing "Direction & RTL" note + example. It's
    skipped on the DirectionProvider page itself, which documents that mechanism directly.
*@
<section class="space-y-6">
    @foreach (var entry in _entries)
    {
        <div class="space-y-3">
            <h2 id="@Anchor(entry.Name)" data-toc class="scroll-mt-20 font-mono text-sm font-semibold">@entry.Name</h2>
            @if (entry.Params is null)
            {
                @* Summaries still loading (one fetch per session) - the heading is already in the
                   DOM, which is what the table of contents scan needs. *@
            }
            else if (entry.Params.Count == 0)
            {
                <p class="text-sm text-muted-foreground">No parameters.</p>
            }
            else
            {
                @* The docs eat their own cooking: BzTable and its parts, not a hand-rolled <table>.
                   The scroll container, borders and density come from the skin's bz-table* hooks. *@
                <BzTable ContainerClass="rounded-lg border" Class="text-sm">
                    <BzTableHeader Class="bg-muted/50">
                        <BzTableRow Class="text-muted-foreground">
                            <BzTableHead>Prop</BzTableHead>
                            <BzTableHead>Type</BzTableHead>
                            <BzTableHead>Default</BzTableHead>
                            <BzTableHead>Description</BzTableHead>
                        </BzTableRow>
                    </BzTableHeader>
                    <BzTableBody>
                        @foreach (var p in entry.Params)
                        {
                            <BzTableRow Class="align-top">
                                <BzTableCell Class="font-mono whitespace-nowrap">@p.Name</BzTableCell>
                                <BzTableCell Class="font-mono text-xs text-muted-foreground whitespace-nowrap">@p.Type</BzTableCell>
                                <BzTableCell Class="font-mono text-xs whitespace-nowrap">@p.Default</BzTableCell>
                                @* The inner div is the wrap constraint: the skin's bz-table cells are
                                   whitespace-nowrap, which laid a long summary out as one endless line, and
                                   max-width on the td itself is not reliably honored by the auto table layout.
                                   min-w keeps short tables from crushing the column - the container scrolls.
                                   pre-line both wraps and keeps the newlines the build's XML flattener emits
                                   for <para> / <item>, so a documented grammar reads as a list. *@
                                <BzTableCell Class="text-muted-foreground">
                                    <div class="min-w-72 max-w-xl whitespace-pre-line">@p.Summary</div>
                                </BzTableCell>
                            </BzTableRow>
                        }
                    </BzTableBody>
                </BzTable>
            }
        </div>
    }

    @if (_showDirectionNote)
    {
        @* Applies to every component, so it's documented here once rather than per page. *@
        <div class="space-y-3">
            <h2 id="direction-rtl" data-toc class="scroll-mt-20 font-mono text-sm font-semibold">Direction &amp; RTL</h2>
            <p class="text-sm text-muted-foreground">
                <code>@_rootName</code> follows the ambient reading <strong>direction</strong>. Wrap a
                subtree in a <code>DirectionProvider</code> to flip it to <strong>RTL</strong>, or set
                <code>dir="rtl"</code> on the component itself - spacing, alignment and arrow-key
                navigation all mirror. See
                <a class="font-medium text-foreground underline underline-offset-4" href="docs/direction">Direction (RTL)</a>.
            </p>
            <CodeBlock Code="@_directionExample" />
        </div>
    }
</section>

@code {
    /// <summary>The component family to document: the parent first, then its children.</summary>
    [Parameter, EditorRequired] public Type[] Types { get; set; } = [];

    /// <summary>One component's section. A null <c>Params</c> means its summaries are still loading.</summary>
    private sealed record ApiEntry(string Name, IReadOnlyList<ApiParam>? Params);

    private IReadOnlyList<ApiEntry> _entries = [];
    private string _rootName = "";
    private bool _showDirectionNote;
    private string _directionExample = "";

    // Everything that can be known without interop is settled here, in the SYNCHRONOUS pass: the
    // section headings (and their ids) must exist in the first render, because the layout's table
    // of contents scans the page for [data-toc] once that render lands - headings that waited for
    // the summaries below would leave it empty.
    protected override void OnParametersSet()
    {
        _entries = Types.Select(type => new ApiEntry(FriendlyName(type), null)).ToList();

        // The parent is listed first; the note speaks to the family as a whole.
        _rootName = Types.Length > 0 ? FriendlyName(Types[0]) : "";
        // The DirectionProvider page documents this mechanism itself - don't point it back at itself.
        _showDirectionNote = _rootName is not "" and not "DirectionProvider";
        // A two-way worked example (inherit RTL from an ancestor, or pin it on this component alone),
        // shared by every API page - the embedded snippet carries a {root} token for the family name.
        _directionExample = _showDirectionNote
            ? Snippets.Get("Shared/DirectionExample").Replace("{root}", _rootName)
            : "";
    }

    protected override async Task OnParametersSetAsync()
    {
        // Build into a local and swap in atomically. OnParametersSetAsync can re-enter while the awaits
        // below are still pending (a parent re-render mid-load - e.g. a page whose components fire
        // callbacks on first render), and mutating one shared list across those overlapping runs would
        // append duplicate entries, rendering the same table two or three times. Each run owns its list.
        var entries = new List<ApiEntry>();
        foreach (var type in Types)
        {
            entries.Add(new ApiEntry(FriendlyName(type), await ApiDocs.GetParametersAsync(type)));
        }
        _entries = entries;
    }

    // Mirrors the slug ts/toc.ts would assign, but set here so the anchors are stable enough to
    // link to from elsewhere ("#bzinputgroupaddon") whether or not the rail ever runs.
    private static string Anchor(string name) =>
        new string(name.Where(c => char.IsLetterOrDigit(c) || c is '-').ToArray()).ToLowerInvariant();

    // Render generic component names with their type-parameter names (BzDataTable`1 -> BzDataTable<TItem>).
    private static string FriendlyName(Type type)
    {
        if (!type.IsGenericType) return type.Name;
        var name = type.Name[..type.Name.IndexOf('`')];
        return $"{name}<{string.Join(", ", type.GetGenericArguments().Select(a => a.Name))}>";
    }
}
