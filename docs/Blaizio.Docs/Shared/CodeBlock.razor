@inject ICodeHighlighter Highlighter
@inject ISnippetSource Snippets
@*
    A standalone, syntax-highlighted, copyable code block - the Demo card's code area without the
    preview or the collapse toggle. Use it for the Usage snippets at the top of a page, or anywhere
    a plain code sample is enough. Highlighting happens once in C# (CodeHighlighter); the surface +
    palette are theme-aware (the --code* variables).

        <CodeBlock Snippet="Toast/IToastService" />
        <CodeBlock Code="@("<BzButton>Click</BzButton>")" />
*@
<CodeSurface CopyText="@_code" ShowCopy="@ShowCopy" Class="@Class">
    @* Code stays LTR even under RTL - source reads left-to-right regardless of page direction.
       tabindex + region: the pre scrolls horizontally, so keyboard users need a stop to arrow it
       (axe scrollable-region-focusable). *@
    <pre dir="ltr" tabindex="0" role="region" aria-label="Code sample"
         class="scrollbar-thin overflow-x-auto p-4 text-[13px] leading-relaxed outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring/50"><code class="@CodeClass">@_highlighted</code></pre>
</CodeSurface>

@code {
    /// <summary>Embedded snippet name (under Snippets/, no extension). Takes precedence over <see cref="Code"/>.</summary>
    [Parameter] public string? Snippet { get; set; }

    /// <summary>The source to render. Prefer <see cref="Snippet"/> for anything longer than a line.</summary>
    [Parameter] public string Code { get; set; } = "";

    /// <summary>Extra classes for the card.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Render the corner copy button. Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool ShowCopy { get; set; } = true;

    /// <summary>Show the line-number gutter. Defaults to <see langword="true"/>; false for a single command line.</summary>
    [Parameter] public bool Numbered { get; set; } = true;

    /// <summary>Pin the tokenizer (<c>yaml</c>, <c>text</c>) for content the automatic detection
    /// cannot classify - a workflow file or a directory tree would otherwise color as C#.</summary>
    [Parameter] public string? Language { get; set; }

    private string CodeClass => Numbered ? "code-block" : "code-block no-gutter";

    private string _code = "";
    private MarkupString _highlighted;

    protected override void OnParametersSet()
    {
        _code = Snippet is not null ? Snippets.Get(Snippet) : Code;
        _highlighted = Highlighter.Highlight(_code, Language);
    }
}
