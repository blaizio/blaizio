@namespace Blaizio.Docs.Shared
@inject IDocsJs Js
@*
    Frame for the RTL demos: an Arabic/Hebrew tab pair above the example content. The picked
    language flows to the content as the template context (an RtlLang - use @t["عربي", "עברית"]),
    and the panel stamps lang + the matching script font (font-arabic / font-hebrew, explicit
    families the Themes font overlays can't override). The Noto faces load lazily, once, when the
    first RtlDemo renders. Direction still comes from the example's own BzDirectionProvider - this
    frame only supplies language, font, and the switch.
*@

<div class="flex w-full flex-col items-center gap-5">
    @* No switch when the demo has no words in it - a language choice that changes nothing on screen
       is furniture. Those demos still get the direction, the lang attribute and the script font. *@
    @if (ShowLanguage)
    {
        @* A panel per language, each stamping its own lang + script font. Only the selected one is
           in the DOM (BaseTabsContent renders nothing for the others, so the example is never built
           twice), and the panel classes restore the column the demos used to sit in - a panel is a
           real box, where the old wrapper was display:contents. *@
        <BzTabs Value="@_lang.Code" ValueChanged="@(v => _lang = new(v == "he"))" Class="w-full gap-5">
            @* dir="rtl" on the list: its labels are Arabic and Hebrew, so the tabs read - and
               arrow-key - right to left like the demo underneath them. *@
            <BzTabsList AriaLabel="Demo language" dir="rtl" Class="self-end">
                <BzTabsTrigger Value="ar">Arabic (العربية)</BzTabsTrigger>
                <BzTabsTrigger Value="he">Hebrew (עברית)</BzTabsTrigger>
            </BzTabsList>
            <BzTabsContent Value="ar" lang="ar" Class="flex w-full flex-col items-center gap-5 font-arabic">
                @ChildContent(new RtlLang(false))
            </BzTabsContent>
            <BzTabsContent Value="he" lang="he" Class="flex w-full flex-col items-center gap-5 font-hebrew">
                @ChildContent(new RtlLang(true))
            </BzTabsContent>
        </BzTabs>
    }
    else
    {
        @* display:contents - the demo content sits in this column as if unwrapped, while lang and
           the script font still inherit down from here. *@
        <div lang="@_lang.Code" class="@($"contents {(_lang.IsHebrew ? "font-hebrew" : "font-arabic")}")">
            @ChildContent(_lang)
        </div>
    }
</div>

@code {
    private RtlLang _lang;

    /// <summary>The demo content - receives the active <see cref="RtlLang"/> as its context.</summary>
    [Parameter, EditorRequired] public RenderFragment<RtlLang> ChildContent { get; set; } = default!;

    /// <summary>
    /// Shows the Arabic/Hebrew picker (the default). Set <see langword="false"/> on a demo with no
    /// copy in it - a skeleton, a spinner, an icon grid - where switching language changes nothing.
    /// </summary>
    [Parameter] public bool ShowLanguage { get; set; } = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            // De-duped by href in docs.ts - many RtlDemos on a page still load the faces once.
            await Js.LoadWebFontAsync(
                "https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@100..900&family=Noto+Sans+Hebrew:wght@100..900&display=swap");
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }
}
