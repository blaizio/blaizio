@inject IExampleSource Examples
@inject ISnippetSource Snippets
@*
    Component showcase matching the reference docs' layout: ONE bordered card with the rendered
    preview on top and the source directly below (DemoCodePanel - highlighted, copyable, collapsed
    behind "View Code"). The Inspect probe (DemoInspector) and accessibility x-ray (DemoA11yXray)
    are self-contained children owning their JS sessions and detail strips; this component only
    resolves the source, hosts the preview and keeps the two probes mutually exclusive.

    Prefer Example (a component under Examples/): its .razor file is rendered AND displayed, so
    the demo and its code cannot drift. Code/ChildContent remain for pages not yet migrated.
*@
<section class="space-y-3">
    @* data-toc marks this as a section for the right-hand TableOfContents (headings rendered by
       demo CONTENT - DialogTitle, accordion triggers - must not end up there). *@
    @if (Title is not null)
    {
        <h3 data-toc class="scroll-mt-20 text-lg font-semibold tracking-tight">@Title</h3>
    }
    @if (Description is not null)
    {
        <p class="text-sm text-muted-foreground">@Description</p>
    }

    <div class="overflow-hidden rounded-xl border">
        <div class="relative">
            @* Inspect toggle: outlines every [data-slot] part and maps the hovered one to its
               component type below (interaction suppressed - the pointer is a probe). A11y toggle:
               role/tab-stop chips over every accessibility-relevant element, with hover details -
               interaction stays LIVE there so aria state flips re-annotate. Mutually exclusive. *@
            <div class="absolute end-2 top-2 z-10 flex gap-1">
                <BzButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" @onclick="ToggleA11y"
                        aria-label="@(_a11y ? "Stop accessibility x-ray" : "Accessibility x-ray")" aria-pressed="@(_a11y ? "true" : "false")"
                        Class="@($"size-7 text-muted-foreground hover:text-foreground {(_a11y ? "bg-accent text-accent-foreground" : "")}")">
                    <BzIcon Icon="@Icons.Outline.Accessible" />
                </BzButton>
                <BzButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" @onclick="ToggleInspect"
                        aria-label="@(_inspecting ? "Stop inspecting" : "Inspect parts")" aria-pressed="@(_inspecting ? "true" : "false")"
                        Class="@($"size-7 text-muted-foreground hover:text-foreground {(_inspecting ? "bg-accent text-accent-foreground" : "")}")">
                    <BzIcon Icon="@Icons.Outline.BoxModel2" />
                </BzButton>
            </div>

            <div @ref="_preview" class="flex min-h-[280px] w-full items-center justify-center p-10">
                @if (Example is not null)
                {
                    <DynamicComponent Type="Example" />
                }
                else
                {
                    @ChildContent
                }
            </div>
        </div>

        <DemoA11yXray Preview="_preview" Active="_a11y" />
        <DemoInspector Preview="_preview" Active="_inspecting" />

        @if (_code is not null)
        {
            <DemoCodePanel Code="@_code" />
        }
    </div>
</section>

@code {
    /// <summary>Heading above the card.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Optional description under the heading.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>
    /// An example component under Examples/ - rendered as the preview, with its own .razor source
    /// (embedded at build time) shown as the code. The rigid path: render and code cannot drift.
    /// Takes precedence over Code/ChildContent.
    /// </summary>
    [Parameter] public Type? Example { get; set; }

    /// <summary>Embedded snippet name (under Snippets/, no extension) for the Code area - for content that can't be a component (e.g. Program.cs lines). Takes precedence over Code.</summary>
    [Parameter] public string? Snippet { get; set; }

    /// <summary>Full example source for the Code area. Omit to show only a preview. Prefer Example or Snippet.</summary>
    [Parameter] public string? Code { get; set; }

    /// <summary>The rendered example (ignored when Example is set).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? _code;
    private ElementReference _preview;
    private bool _inspecting;
    private bool _a11y;

    protected override void OnParametersSet() =>
        _code = Example is not null ? Examples.GetSource(Example)
            : Snippet is not null ? Snippets.Get(Snippet)
            : Code;

    // The two probes are mutually exclusive - turning one on turns the other off.
    private void ToggleInspect()
    {
        _inspecting = !_inspecting;
        if (_inspecting) _a11y = false;
    }

    private void ToggleA11y()
    {
        _a11y = !_a11y;
        if (_a11y) _inspecting = false;
    }
}
