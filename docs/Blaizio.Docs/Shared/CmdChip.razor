@inject IDocsJs Js
@*
    An inline command chip: a terminal one-liner rendered as a copyable token instead of being
    buried in prose. Click copies; the icon flips to a check for a moment as feedback. Use it for
    short commands referenced mid-sentence ("install the CLI once: <CmdChip Command="..." />") -
    anything longer belongs in a CodeBlock.
*@
<BzTooltip>
    <BzTooltipTrigger>
        <RenderAs Context="p">
            <BzButton @attributes="p.Attributes" Variant="ButtonVariant.Outline" Size="ButtonSize.Xs"
                      Class="h-auto translate-y-[-1px] gap-1.5 rounded-md bg-muted/50 px-2 py-0.5 align-middle font-mono text-xs text-foreground hover:border-primary/50 hover:bg-muted/50 dark:bg-muted/50 dark:hover:bg-muted/50"
                      @onclick="CopyAsync">
                <BzIcon Icon="@(_copied ? Icons.Outline.Check : Icons.Outline.Terminal)"
                        Class="@($"size-3 shrink-0 {(_copied ? "text-success" : "text-muted-foreground")}")" />
                @Command
            </BzButton>
        </RenderAs>
    </BzTooltipTrigger>
    <BzTooltipContent>Copy<BzTooltipArrow /></BzTooltipContent>
</BzTooltip>

@code {
    /// <summary>The command line the chip shows and copies.</summary>
    [Parameter, EditorRequired] public string Command { get; set; } = "";

    private bool _copied;

    private async Task CopyAsync()
    {
        await Js.CopyAsync(Command);
        _copied = true;
        StateHasChanged();
        await Task.Delay(1500);
        _copied = false;
    }
}
