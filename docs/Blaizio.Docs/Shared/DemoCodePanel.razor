@*
    The code strip under a Demo preview: a BzCodeBlock flush with the demo card (a top border is all
    that separates it from the preview), line-numbered and copyable, collapsed behind "View code"
    when the source runs past PreviewLines. Collapsed, it renders only the lines on show - every
    demo on a page would otherwise render every line of its source - and Copy still takes it all.
*@

<BzCodeBlock Class="@PanelClasses">
    @* The buttons live in a header row, not floating over the code, so they never cover the first
       line. View code only exists when there is more code than the collapsed panel shows. *@
    <BzCodeBlockHeader>
        <BzCodeBlockActions>
            @if (_overflows)
            {
                <BzButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Xs" @onclick="Toggle"
                          aria-expanded="@(_expanded ? "true" : "false")">
                    @(_expanded ? "Collapse" : "View code")
                </BzButton>
                @* !self-center overrides the separator's default vertical self-stretch, which would
                   otherwise pin this fixed-height (h-4) divider to the top of the row. *@
                <BzSeparator Orientation="Orientation.Vertical" Class="mx-0.5 !h-4 !self-center" />
            }
            <BzCodeBlockWrapButton />
            <BzCodeBlockCopyButton AriaLabel="Copy code" Value="@Code" />
        </BzCodeBlockActions>
    </BzCodeBlockHeader>
    @* The height cap keeps the horizontal scrollbar on screen - an expanded panel of 80 lines
       otherwise parks it below the fold. Collapsed, nothing scrolls: the fade already says there
       is more, and View code shows it. *@
    <BzCodeBlockContent Code="@(Collapsed ? _preview : Code)" Language="@_language" LineNumbers
                        role="region" aria-label="Example code"
                        Class="@(Collapsed ? CollapsedClasses : "max-h-[70vh]")" />
</BzCodeBlock>

@code {
    /// <summary>The source to display. The panel renders nothing sensible without one - the parent
    /// only renders it when there is code.</summary>
    [Parameter, EditorRequired] public string Code { get; set; } = "";

    private bool _expanded;
    private bool _overflows;
    private string _preview = "";
    private string? _language;

    // Past this many lines the panel collapses behind View code, showing just these: the last one
    // fades out, and there is always at least one more line to view.
    private const int PreviewLines = 5;

    private bool Collapsed => _overflows && !_expanded;

    // Flush with the demo card: the card draws the outer border and the corners, so the block keeps
    // only a top border and drops the style's own border, ring and radius. Its focus ring, which the
    // card would clip, is drawn inside instead.
    private const string PanelClasses =
        "not-typeset rounded-none border-0 border-t border-border ring-0 " +
        "has-[>[data-slot=code-block-content]:focus-visible]:ring-2 " +
        "has-[>[data-slot=code-block-content]:focus-visible]:ring-inset " +
        "has-[>[data-slot=code-block-content]:focus-visible]:ring-ring/50";

    // The preview lines, the last ones fading out. No height cap: the lines rendered are the lines
    // shown, whatever padding the style gives the content. The mask is important: the content's
    // scroll-fade-x sets mask-image from an animation, which an important declaration outranks.
    private const string CollapsedClasses =
        "overflow-hidden [mask-image:linear-gradient(to_bottom,black_55%,transparent)]!";

    protected override void OnParametersSet()
    {
        var lines = Code.ReplaceLineEndings("\n").TrimEnd('\n').Split('\n');
        _overflows = lines.Length > PreviewLines;
        _preview = _overflows ? string.Join('\n', lines.Take(PreviewLines)) : Code;
        _language = CodeLanguage.Detect(Code);
    }

    private void Toggle() => _expanded = !_expanded;
}
