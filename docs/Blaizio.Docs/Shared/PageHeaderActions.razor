@implements IDisposable
@inject NavigationManager Nav
@inject IRegistrySource Registry
@inject IDialogService Dialogs
@*
    The top-right actions shown next to a component page's title (placed by MainLayout). On a doc
    page: a "Source" button (the exact per-skin files `blaizio add` would copy, from the docs' own
    registry - see SourceDialog) and a link to the API Reference (which flips the sidebar to the
    API tab); on an API page a link back to the documentation. Derived from the URL + the DocsNav
    registry, the same way PageFooter is. Renders nothing on non-component routes; the Source
    button only appears once the registry index confirms the slug is an installable item.
*@
@if (_source is not null)
{
    <BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="@LinkClass" @onclick="OpenSource">
        <BzIcon Icon="@Icons.Outline.FileCode" Class="size-4 text-primary" />
        Source
    </BzButton>
}
@if (_link is not null)
{
    <BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="@LinkClass">
        <RenderAs Context="p">
            <a href="@_link.Value.Href" @attributes="p.Attributes">
                <BzIcon Icon="@_link.Value.Icon" Class="size-4 text-primary" />
                @_link.Value.Label
            </a>
        </RenderAs>
    </BzButton>
}

@code {
    private (string Href, string Label, Icon Icon)? _link;
    private string? _source;
    private HashSet<string>? _items;

    // Merged over the outline button defaults: the card-chip look these actions have always had.
    private const string LinkClass =
        "h-auto gap-1.5 rounded-lg bg-card px-3 py-1.5 text-sm text-muted-foreground no-underline " +
        "hover:border-primary/50 hover:bg-card hover:text-foreground dark:bg-card dark:hover:bg-card";

    private static readonly BzDialogOptions SourceDialogOptions = new() { ContentClass = "sm:max-w-3xl" };

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        // One cached index fetch tells us which slugs are installable registry items.
        var index = await Registry.GetIndexAsync();
        _items = index is null
            ? new HashSet<string>(StringComparer.OrdinalIgnoreCase)
            : new HashSet<string>(index.Items.Select(i => i.Name), StringComparer.OrdinalIgnoreCase);
        Recompute();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        Recompute();
        StateHasChanged();
    }

    private void Recompute()
    {
        _link = null;
        _source = null;
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        var cut = path.IndexOfAny(['?', '#']); // fragment too, or a TOC-anchored refresh breaks the slug
        if (cut >= 0) path = path[..cut];
        var parts = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length < 3 || parts[0] != "docs" || parts[1] != "components") return;

        var entry = DocsNav.Find(parts[2]);
        if (entry is null) return;

        var isApi = parts.Length >= 4 && parts[3] == "api";
        if (isApi)
        {
            _link = (entry.DocHref, "Documentation", Icons.Outline.Book);
        }
        else
        {
            if (entry.HasApiPage)
                _link = (entry.ApiHref, "API Reference", Icons.Outline.Code);
            if (_items?.Contains(entry.Slug) == true)
                _source = entry.Slug;
        }
    }

    private Task OpenSource() => Dialogs.ShowAsync<SourceDialog>(new Dictionary<string, object?>
    {
        [nameof(SourceDialog.Item)] = _source,
    }, SourceDialogOptions);

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
