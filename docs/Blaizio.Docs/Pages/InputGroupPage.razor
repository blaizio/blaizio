@page "/docs/components/input-group"
@using Blaizio.Docs.Examples.InputGroup
<PageTitle>Input Group - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Input Group</h1>
            <DocBadges Slug="input-group" />
        </div>
        <p>Wrap an input or textarea with addons - icons, text, or buttons - inside one bordered, focusable box. Addons sit inline (before or after) or in a full-width block above or below the control. It is the shell the Combobox input is built on.</p>
    </header>

    <UsageBlock Example="typeof(InputGroupUsageExample)"
                Description="Add the using once, then wrap a control with addons. An inline-start addon renders before the control regardless of DOM order." />

    <CompositionTree Root="Anatomy"
                     Description="The full anatomy. The group wraps one control plus any number of addons; each addon clusters icons, text, or buttons against one edge." />

    <ExamplesHeading />

    <Demo Title="Icon" Description="A leading icon. An inline-start addon renders before the control regardless of DOM order."
          Example="typeof(InputGroupIconExample)" />

    <Demo Title="Debounced search" Description="InputGroupInput forwards DebounceDelay to the inner field - ValueChanged fires after the typing pause, one change per burst. A trailing spinner shows while the (simulated) search runs; the second field also waits for at least 3 characters before it searches."
          Example="typeof(InputGroupDebounceExample)" />

    <Demo Title="Text affixes" Description="InputGroupText for a prefix or suffix - a protocol, unit, or domain. The whole box focuses when you click anywhere in it."
          Example="typeof(InputGroupTextExample)" />

    <Demo Title="Button" Description="An InputGroupButton in a trailing addon - sized to sit flush inside the group."
          Example="typeof(InputGroupButtonExample)" />

    <Demo Title="Keyboard shortcut" Description="A Kbd in a trailing addon hints at the shortcut that focuses the field."
          Example="typeof(InputGroupKbdExample)" />

    <Demo Title="Dropdown" Description="An InputGroupButton in an addon opens a DropdownMenu - here a country-code picker beside a phone number."
          Example="typeof(InputGroupDropdownExample)" />

    <Demo Title="Split button" Description="No control at all - the group shell borders a primary action plus a dropdown of alternatives, split by a vertical Separator."
          Example="typeof(InputGroupSplitButtonExample)" />

    <Demo Title="Spinner" Description="A Spinner in an addon marks a busy field - for example while a value is validated."
          Example="typeof(InputGroupSpinnerExample)" />

    <Demo Title="Custom control" Description="Any control works, not just InputGroupInput - give it the input-group-control data-slot and the group lends it the shared border, focus ring, and invalid state. Here, a native select."
          Example="typeof(InputGroupCustomControlExample)" />

    <Demo Title="Textarea with a toolbar" Description="Rows turns InputGroupInput multi-line, same as on InputText. A block-end addon spans the full width and stacks below the control - here a formatting toolbar of icon buttons with the submit pushed to the end."
          Example="typeof(InputGroupTextareaExample)" />

    <Demo Title="Chat composer" Description="An AI-chat send box against a MessageScroller transcript: Rows=1 starts one line tall and the control grows with its content - bottom of a fixed column, so it expands upward. Enter sends on keyup - after the newline and its input echo have landed, so posting the trimmed draft and clearing leaves nothing to race - Ctrl+Enter adds a line, and past ten lines a max-h cap plus scrollbar-thin take over."
          Example="typeof(InputGroupChatExample)" />

    <Demo Title="Invalid" Description="aria-invalid on the control turns the whole group destructive - here forced; a Field normally sets it."
          Example="typeof(InputGroupInvalidExample)" />

    <Demo Title="Invalid in a form" Description="Inside an EditForm, FieldControl wires aria-invalid from validation. Submit with an empty or malformed email to see the group turn destructive and the error appear."
          Example="typeof(InputGroupFormInvalidExample)" />

    <Demo Title="Disabled" Description="Disable the control; it greys out and stops accepting input."
          Example="typeof(InputGroupDisabledExample)" />

    <Demo Title="Customization"
          Description="Restyle the box via Class on the group - here a pill shell with an emerald focus ring and a tinted leading icon. Root utilities win over the skin, so the rounding and ring take effect."
          Example="typeof(InputGroupCustomExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider - the addons mirror to the right."
          Example="typeof(InputGroupRtlExample)" />

</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzInputGroup",
        new CompositionNode("BzInputGroupAddon",
            new CompositionNode("BzInputGroupText"),
            new CompositionNode("BzInputGroupButton")),
        new CompositionNode("BzInputGroupInput"));
}
