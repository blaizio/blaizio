@page "/docs/components/input-group"
@using Blaizio.Docs.Examples.InputGroup
<PageTitle>Input Group - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Input Group</h1>
            <DocBadges Slug="input-group" />
        </div>
        <p>One bordered, focusable box around an input or textarea and its addons, which can hold icons, text or buttons. Addons sit inline before or after the control, or span the full width above or below it. The group supplies the shared border, focus ring and invalid state, and the Combobox input is built on it.</p>
    </header>

    <UsageBlock Example="typeof(InputGroupUsageExample)"
                Description="Import `Blaizio.Ui` once, then wrap a control with addons. An addon with `Align` set to `InlineStart` renders before the control wherever it sits in the markup." />

    <CompositionTree Root="Anatomy"
                     Description="The group wraps one control and any number of addons. Each addon clusters icons, text or buttons against one edge." />

    <ExamplesHeading />

    <Demo Title="Icon" Description="An inline-start addon puts an icon in front of the field."
          Example="typeof(InputGroupIconExample)" />

    <Demo Title="Debounced search" Description="`BzInputGroupInput` forwards `DebounceDelay` to the field it wraps, so `ValueChanged` fires once per burst of typing. A trailing spinner shows while the simulated search runs, and the second field waits for at least 3 characters before it searches."
          Example="typeof(InputGroupDebounceExample)" />

    <Demo Title="Text affixes" Description="Use `BzInputGroupText` for a prefix or suffix such as a protocol, unit or domain. Clicking anywhere in the box focuses the control."
          Example="typeof(InputGroupTextExample)" />

    <Demo Title="Button" Description="A `BzInputGroupButton` in a trailing addon is sized to sit flush inside the group."
          Example="typeof(InputGroupButtonExample)" />

    <Demo Title="Keyboard shortcut" Description="A `BzKbd` in a trailing addon hints at the shortcut that focuses the field."
          Example="typeof(InputGroupKbdExample)" />

    <Demo Title="Dropdown" Description="A `BzInputGroupButton` in an addon can open a `BzDropdownMenu`. Here it is a country-code picker beside a phone number."
          Example="typeof(InputGroupDropdownExample)" />

    <Demo Title="Split button" Description="The group also works without a control. Here it borders a primary action and a dropdown of alternatives, divided by a vertical `BzSeparator`."
          Example="typeof(InputGroupSplitButtonExample)" />

    <Demo Title="Spinner" Description="A `BzSpinner` in an addon marks the field as busy, for example while a value is being validated."
          Example="typeof(InputGroupSpinnerExample)" />

    <Demo Title="Custom control" Description="Any control can join the group, not only `BzInputGroupInput`. Give it `data-slot=&quot;input-group-control&quot;` and it picks up the shared border, focus ring and invalid state. Here the control is a native select."
          Example="typeof(InputGroupCustomControlExample)" />

    <Demo Title="Textarea with a toolbar" Description="`Rows` makes `BzInputGroupInput` multi-line, as it does on `BzInputText`. A block-end addon spans the full width below the control, here holding a formatting toolbar with the submit button pushed to the end."
          Example="typeof(InputGroupTextareaExample)" />

    <Demo Title="Chat composer" Description="A chat composer below a `BzMessageScroller` transcript. With `Rows` set to 1 it starts one line tall and grows upward with its content, then scrolls once it passes ten lines. `PreventKeys=&quot;enter&quot;` stops the newline in the browser so a bare Enter sends from `OnKeyDown`, while Shift+Enter still adds a line."
          Example="typeof(InputGroupChatExample)" />

    <Demo Title="Invalid" Description="Setting `aria-invalid` on the control turns the whole group destructive. It is forced here; inside a `BzField` it is set for you."
          Example="typeof(InputGroupInvalidExample)" />

    <Demo Title="Invalid in a form" Description="Inside an `EditForm`, `BzFieldControl` sets `aria-invalid` from validation. Submit with an empty or malformed email to see the group turn destructive and the error appear."
          Example="typeof(InputGroupFormInvalidExample)" />

    <Demo Title="Programmatic focus" Description="Keep a reference to the control and call `FocusAsync` to move focus from code. Here sending clears the draft and returns the caret to the composer, so you can keep typing. `BzInputGroupInput` forwards the call to the field it wraps."
          Example="typeof(InputGroupFocusMethodExample)" />

    <Demo Title="Disabled" Description="A disabled control grays out and stops accepting input."
          Example="typeof(InputGroupDisabledExample)" />

    <Demo Title="Customization"
          Description="`Class` on the group restyles the whole box. This example makes a pill with an emerald focus ring and a tinted leading icon."
          Example="typeof(InputGroupCustomExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, inline-start and inline-end addons swap sides."
          Example="typeof(InputGroupRtlExample)" />

</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzInputGroup",
        new CompositionNode("BzInputGroupAddon",
            new CompositionNode("BzInputGroupText"),
            new CompositionNode("BzInputGroupButton")),
        new CompositionNode("BzInputGroupInput"));
}
