@page "/docs/components/button"
@using Blaizio.Docs.Examples.Button
<PageTitle>Button - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Button</h1>
        <p class="text-muted-foreground">Triggers an action. Six variants, several sizes, and <code class="rounded bg-muted px-1 text-xs">RenderAs</code> for polymorphism.</p>
    </header>

    <UsageBlock Example="typeof(ButtonUsageExample)" />

    <ExamplesHeading />

    <Demo Title="Variants" Example="typeof(ButtonVariantsExample)" />

    <Demo Title="Sizes" Description="Use the Size prop to change the height and padding." Example="typeof(ButtonSizesExample)" />

    <Demo Title="Icon" Description="Square, icon-only buttons. Always give them an aria-label." Example="typeof(ButtonIconOnlyExample)" />

    <Demo Title="With icon"
          Description="Mark edge icons with data-icon so the style tightens the padding on that side."
          Example="typeof(ButtonWithIconExample)" />

    <Demo Title="Rounded" Description="Use the rounded-full class for a pill button." Example="typeof(ButtonRoundedExample)" />

    <Demo Title="Loading" Description="Show a spinner and disable the button while busy." Example="typeof(ButtonLoadingExample)" />

    <Demo Title="Button group" Description="Adjacent buttons with merged borders." Example="typeof(ButtonGroupExample)" />

    <Demo Title="Disabled" Example="typeof(ButtonDisabledExample)" />

    <Demo Title="Custom element (RenderAs)"
          Description="Render the button styling onto your own element instead of a <button> - e.g. an anchor."
          Example="typeof(ButtonRenderAsExample)" />

    <Demo Title="Customization"
          Description="Pass your own classes via Class - brand colors, gradients, tints, or width - merged over the variant defaults."
          Example="typeof(ButtonCustomExample)" />

    <Demo Title="RTL"
          Description="Wrapped in a DirectionProvider with Arabic copy - the data-icon edge icons flip to the mirrored side."
          Example="typeof(ButtonRtlExample)" />
</div>

