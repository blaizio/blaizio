@page "/docs/components/button"
@using Blaizio.Docs.Examples.Button
<PageTitle>Button - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Button</h1>
            <DocBadges Slug="button" />
        </div>
        <p>Ten variants and eight sizes, from extra small to icon-only. When the markup has to be something other than a <code>&lt;button&gt;</code>, such as an anchor that navigates, <code>RenderAs</code> applies the same styling to your own element.</p>
    </header>

    <UsageBlock Example="typeof(ButtonUsageExample)" />

    <ExamplesHeading />

    <Demo Title="Variants"
          Description="Set `Variant` to match the weight of the action. Status variants such as `Destructive` and `Success` carry meaning on their own, while `Outline`, `Ghost` and `Link` step back for secondary actions."
          Example="typeof(ButtonVariantsExample)" />

    <Demo Title="Sizes" Description="`Size` adjusts height and padding together, from `Xs` up to `Lg`." Example="typeof(ButtonSizesExample)" />

    <Demo Title="Icon" Description="The `Icon` sizes give a square button for a single glyph. Since there is no visible text, add an `aria-label` so screen readers can announce it." Example="typeof(ButtonIconOnlyExample)" />

    <Demo Title="With icon"
          Description="Put `data-icon=&quot;inline-start&quot;` or `data-icon=&quot;inline-end&quot;` on an icon next to the label. The button then trims the padding on that side, which keeps the label optically centered."
          Example="typeof(ButtonWithIconExample)" />

    <Demo Title="Rounded" Description="For a pill shape, add `rounded-full` through `Class`. No extra parameter is needed." Example="typeof(ButtonRoundedExample)" />

    <Demo Title="Loading" Description="Set `Loading` while work is in progress. The button shows a spinner before its label, ignores further clicks and reports `aria-busy` to assistive technology." Example="typeof(ButtonLoadingExample)" />

    <Demo Title="Disabled"
          Description="`Disabled` dims the button and stops `OnClick` from firing, whichever variant it uses."
          Example="typeof(ButtonDisabledExample)" />

    <Demo Title="Custom element (RenderAs)"
          Description="Use `RenderAs` when you need the button look on another element. Here it styles an anchor, so the link keeps native navigation, middle-click and copy-link behavior."
          Example="typeof(ButtonRenderAsExample)" />

    <Demo Title="Customization"
          Description="Classes passed through `Class` are merged over the variant defaults, and conflicting utilities are resolved in your favor. That covers brand colors, gradients, tints and fixed widths."
          Example="typeof(ButtonCustomExample)" />

    <Demo Title="RTL"
          Description="Inside a `DirectionProvider` set to right-to-left, icons marked with `data-icon` move to the opposite edge automatically, along with the padding adjustment."
          Example="typeof(ButtonRtlExample)" />
</div>

