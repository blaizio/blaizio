@page "/docs/components/command"
@using Blaizio.Docs.Examples.Command
<PageTitle>Command - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Command</h1>
            <DocBadges Slug="command" />
        </div>
        <p>A searchable list of actions with fuzzy filtering, where focus stays in the input the whole time. The highlight follows the arrow keys, tracks the mouse while it hovers and returns to where it was when the pointer leaves. Use it inline, inside a popover as a combobox, or as a modal <code>BzCommandDialog</code> opened with a keyboard shortcut.</p>
    </header>

    <UsageBlock Example="typeof(CommandUsageExample)"
                Description="After importing `Blaizio.Ui`, compose an input and a list of groups and items." />

    <CompositionTree Root="Anatomy"
                     Description="Every part of a command palette. `BzCommandInput` filters the items, groups put them under headings, and `BzCommandEmpty` shows when nothing matches. `BzCommandDialog` wraps the same parts in a modal." />

    <ExamplesHeading />

    <Demo Title="Default" Description="An inline palette. As you type, groups with no matches disappear along with their separators. The arrow keys, Home, End and Enter all work without leaving the input." Example="typeof(CommandDefaultExample)" />

    <Demo Title="Dialog (⌘K)" Description="The modal palette. Besides the button, a `BzKbd` bound to `mod+k` opens it with a global ⌘K or Ctrl+K shortcut. The input receives focus on open, and picking an item closes the dialog." Example="typeof(CommandDialogExample)" />

    <Demo Title="Combobox" Description="Place a `BzCommand` inside a popover for a searchable single select. The chosen value shows on the trigger, and selecting an item closes the panel." Example="typeof(CommandComboboxExample)" />

    <Demo Title="Controlled search" Description="Bind `Search` two-way when you need to read the query or set it from code." Example="typeof(CommandControlledExample)" />

    <Demo Title="Looping" Description="Set `Loop` so the arrow keys wrap from the last item to the first and back." Example="typeof(CommandLoopExample)" />

    <Demo Title="Scrollable" Description="The list is capped at 300px and scrolls past that. Pass a smaller height through `Class` on `BzCommandList`, and keyboard navigation keeps the highlighted row in view." Example="typeof(CommandScrollableExample)" />

    <Demo Title="Customization" Description="Every part accepts `Class`. This example adds an indigo input border, a smaller radius and a custom highlight color keyed off `data-selected`, with the row's icon turning white so it stays visible." Example="typeof(CommandCustomExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, the icons and shortcuts swap sides and the padding mirrors with them." Example="typeof(CommandRtlExample)" />

</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzCommand",
        new CompositionNode("BzCommandInput"),
        new CompositionNode("BzCommandList",
            new CompositionNode("BzCommandEmpty"),
            new CompositionNode("BzCommandGroup",
                new CompositionNode("BzCommandItem",
                    new CompositionNode("BzCommandShortcut"))),
            new CompositionNode("BzCommandSeparator")),
        new CompositionNode("BzCommandDialog"));
}
