@page "/components/command"
@using Blaizio.Docs.Examples.Command
<PageTitle>Command - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Command</h1>
        <p class="text-muted-foreground">A fast, composable command palette. Type to filter; the highlight stays in sync as you navigate with the arrow keys or the mouse, and focus never leaves the input. Use it inline, inside a Popover as a combobox, or as a modal <code>CommandDialog</code> opened with a shortcut.</p>
    </header>

    <UsageBlock Example="typeof(CommandUsageExample)"
                Description="Add the using once, then compose an input and a list of groups and items." />

    <CompositionTree Root="Anatomy"
                     Description="The full anatomy. Filter with BzCommandInput, group items under headings, drop in a BzCommandSeparator between sections, and show BzCommandEmpty when nothing matches. BzCommandDialog wraps the same parts in a modal." />

    <ExamplesHeading />

    <Demo Title="Default" Description="An inline palette. Type to fuzzy-filter; empty groups and their separators drop out, and the empty state shows when nothing matches. Arrow keys, Home/End and Enter all work while you keep typing." Example="typeof(CommandDefaultExample)" />

    <Demo Title="Dialog (⌘K)" Description="The modal palette. The button opens it, and the Kbd binds a global ⌘K / Ctrl+K shortcut that opens it too. The input autofocuses; picking an item closes the dialog." Example="typeof(CommandDialogExample)" />

    <Demo Title="Combobox" Description="Drop a Command inside a Popover for a searchable single-select. The chosen value shows on the trigger; selecting closes the panel." Example="typeof(CommandComboboxExample)" />

    <Demo Title="Controlled search" Description="Bind the search text two-way to read it or preset the query." Example="typeof(CommandControlledExample)" />

    <Demo Title="Looping" Description="Set Loop so the arrow keys wrap around the ends of the list." Example="typeof(CommandLoopExample)" />

    <Demo Title="Scrollable" Description="The list already caps at 300px and scrolls; tighten it further via Class on BzCommandList. Keyboard navigation keeps the highlighted row in view as it scrolls." Example="typeof(CommandScrollableExample)" />

    <Demo Title="Customization" Description="Restyle with utilities via Class. Here a branded indigo input border and accent, square-ish radius, and a custom selected-row color - the selected state keys off data-selected, and the row's icon flips to white with it so it stays visible." Example="typeof(CommandCustomExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the icons, padding and shortcuts all mirror to the right." Example="typeof(CommandRtlExample)" />

</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzCommand",
        new CompositionNode("BzCommandInput"),
        new CompositionNode("BzCommandList",
            new CompositionNode("BzCommandEmpty"),
            new CompositionNode("BzCommandGroup",
                new CompositionNode("BzCommandItem",
                    new CompositionNode("BzCommandShortcut"))),
            new CompositionNode("BzCommandSeparator")),
        new CompositionNode("BzCommandDialog"));
}
