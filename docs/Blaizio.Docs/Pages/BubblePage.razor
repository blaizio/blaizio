@page "/docs/components/bubble"
@using Blaizio.Docs.Examples.Bubble
<PageTitle>Bubble - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Bubble</h1>
            <DocBadges Slug="bubble" />
        </div>
        <p>The frame around a single chat message. Bubbles align to either side, connect into runs with squared inner corners, take a pointed tail, and carry a reaction pill on their edge. For the surrounding layout with an avatar, header and footer, pair it with the Message component.</p>
    </header>

    <UsageBlock Example="typeof(BubbleUsageExample)" />

    <CompositionTree Root="Anatomy"
                     Description="Every part of a bubble. Reactions are optional, and `BzBubbleGroup` stacks a run of bubbles into one column." />

    <ExamplesHeading />

    <Demo Title="Variants"
          Description="Seven variants, from the solid primary `Default` down to the unframed `Ghost`. Since color alone does not convey meaning to everyone, pair a variant with text, alignment or an icon."
          Example="typeof(BubbleVariantsExample)" />

    <Demo Title="Alignment"
          Description="Set `Align` to `End` to put the bubble on the current user's side. Inside a Message, the bubble follows the message's alignment on its own."
          Example="typeof(BubbleAlignExample)" />

    <Demo Title="Group" Example="typeof(BubbleGroupExample)" />

    <Demo Title="Connected group"
          Description="Set `Connected` on the group to square the corners between neighbors on the same side and tighten the gap, so each sender's run reads as one block. Cap the run with a `Tail` on its first or last bubble."
          Example="typeof(BubbleConnectedExample)" />

    <Demo Title="Tail"
          Description="`Tail` adds a pointer on an outer corner: `Top` on the first bubble of a run points at the avatar, and `Bottom` finishes the last. `TailShape` switches between the default flat triangle and a curved wedge with a rounded tip."
          Example="typeof(BubbleTailExample)" />

    <Demo Title="Chat thread"
          Description="The pieces combined into a thread. The first bubble of each run has a top tail pointing at the avatar and the sender's name, the rest connect below it, and each bubble shows its time and delivery ticks in the corner."
          Example="typeof(BubbleChatExample)" />

    <Demo Title="Reply quote"
          Description="The quoted message sits inside the bubble as a bordered strip. It is tinted from the bubble's own foreground color, so it reads on every variant."
          Example="typeof(BubbleReplyExample)" />

    <Demo Title="Reactions"
          Description="`BzBubbleReactions` overlaps the bubble's edge as a pill. `Side` picks the top or bottom edge and `Align` picks the corner. Give the row a `role` and an `aria-label` so screen readers announce it once."
          Example="typeof(BubbleReactionsExample)" />

    <Demo Title="Buttons and links (RenderAs)"
          Description="Use `RenderAs` on `BzBubbleContent` to render the bubble as a real button or anchor. The variant then gains a hover tint and the shared focus ring."
          Example="typeof(BubbleLinkExample)" />

    <Demo Title="Show more (Collapsible)"
          Description="Long content collapses inside the bubble behind a show-more trigger, which hides itself once the content is open."
          Example="typeof(BubbleCollapsibleExample)" />

    <Demo Title="With tooltip"
          Description="Make the bubble the tooltip trigger to show read receipts or a full timestamp on hover."
          Example="typeof(BubbleTooltipExample)" />

    <Demo Title="With popover"
          Description="Here a failed message opens its error details. The popover trigger's attributes pass through `BzBubbleContent` onto the button it renders."
          Example="typeof(BubblePopoverExample)" />

    <Demo Title="RTL"
          Description="Inside a right-to-left `DirectionProvider`, alignment, reactions and tails all mirror, so the current user's bubbles sit on the left."
          Example="typeof(BubbleRtlExample)" />
</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzBubbleGroup",
        new CompositionNode("BzBubble",
            new CompositionNode("BzBubbleContent"),
            new CompositionNode("BzBubbleReactions")));
}
