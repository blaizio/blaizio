@page "/docs/components/input-color"
@using Blaizio.Docs.Examples.InputColor
<PageTitle>Input Color - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Input Color</h1>
            <DocBadges Slug="input-color" />
        </div>
        <p>An inline field bound to a color string. You can type any color the parser understands and the field shows it back in your chosen <code>Format</code>, or open the <a href="/docs/components/color-picker">Color Picker</a> from the trailing button and watch the field update as you drag. It is the color counterpart of <a href="/docs/components/input-date">Input Date</a>.</p>
    </header>

    <UsageBlock Example="typeof(InputColorUsageExample)"
                Description="After importing `Blaizio.Ui`, bind a nullable string to `Value`. Type a color and press Enter, or open the picker." />

    <ExamplesHeading />

    <Demo Title="Basic" Description="The default field shows hex with a leading swatch and the picker button. `Value` holds the color in the field's format, and `null` means an empty field."
          Example="typeof(InputColorBasicExample)" />

    <Demo Title="Format" Description="`Format` sets both what the field shows and how `Value` is written, using any of the picker's ten formats. An oklch or oklab value in its own format is kept exactly as written."
          Example="typeof(InputColorFormatExample)" />

    <Demo Title="Alpha" Description="`ShowAlpha` includes transparency in the value and adds an alpha slider to the popup. The swatch shows it over a checkerboard."
          Example="typeof(InputColorAlphaExample)" />

    <Demo Title="Swatches and eye dropper" Description="`Swatches` and `ShowEyeDropper` are passed through to the picker in the popup, the same way `Min`, `Max` and `Culture` reach the calendar in Input Date."
          Example="typeof(InputColorSwatchesExample)" />

    <Demo Title="Format dropdown" Description="`ShowFormatPicker` adds a format dropdown to the popup. Switching it converts the value and the field follows, and you can bind `Format` to track the choice."
          Example="typeof(InputColorFormatPickerExample)" />

    <Demo Title="Typed entry" Description="With `ShowPicker` set to `false`, the field is text only. It still accepts hex without the #, a bare channel list or any color function, and converts it to `Format` on blur or Enter. Text that doesn't parse stays in the field, marked invalid, until it does."
          Example="typeof(InputColorTypedExample)" />

    <Demo Title="No swatch" Description="Set `ShowSwatch` to `false` to drop the leading swatch."
          Example="typeof(InputColorNoSwatchExample)" />

    <Demo Title="Programmatic focus" Description="Keep a reference to the component and call `FocusAsync` to move focus yourself. Here a shortcut sets the color and focuses the field, and `Select` highlights the text so it can be typed over right away."
          Example="typeof(InputColorFocusMethodExample)" />

    <Demo Title="Auto focus" Description="`AutoFocus` focuses the field as soon as it appears. `BzInputDate` has the same parameter."
          Example="typeof(InputColorAutoFocusExample)" />

    <Demo Title="Disabled" Description="`Disabled` dims the field and blocks both editing and the popup."
          Example="typeof(InputColorDisabledExample)" />

    <Demo Title="Customization"
          Description="Classes passed through `Class` style the field. This example sets the radius, a brand focus ring and a width for the text field to grow into."
          Example="typeof(InputColorCustomExample)" />
</div>
