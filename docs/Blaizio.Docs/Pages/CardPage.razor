@page "/components/card"
<PageTitle>Card - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Card</h1>
        <p class="text-muted-foreground">A surface for grouping related content and actions.</p>
    </header>

    <UsageBlock Setup="@UsageSetup" Code="@UsageMarkup"
                Description="Add the using once, then compose the parts. Header holds the title, description and an optional action; content and footer follow." />

    <CompositionTree Root="_anatomy"
                     Description="The full anatomy. BzCard is the surface; the header groups the title, description and a corner action, then content and footer fill out the body." />

    <ExamplesHeading />

    <Demo Title="With header, content & footer" Code="@CardCode">
        <BzCard Class="w-full max-w-sm">
            <BzCardHeader>
                <BzCardTitle>Deploy your project</BzCardTitle>
                <BzCardDescription>Push to the global edge network in one click.</BzCardDescription>
                <BzCardAction>
                    <BzBadge Variant="BadgeVariant.Secondary">Pro</BzBadge>
                </BzCardAction>
            </BzCardHeader>
            <BzCardContent>
                <p class="text-sm text-muted-foreground">
                    Your project will be built and served from the location closest to each visitor.
                </p>
            </BzCardContent>
            <BzCardFooter Class="justify-between border-t">
                <BzButton Variant="ButtonVariant.Outline">Cancel</BzButton>
                <BzButton>Deploy</BzButton>
            </BzCardFooter>
        </BzCard>
    </Demo>

    <Demo Title="Stat card" Description="A compact card with just a header and content." Code="@StatCode">
        <BzCard Class="w-full max-w-xs">
            <BzCardHeader>
                <BzCardDescription>Total revenue</BzCardDescription>
                <BzCardTitle Class="text-3xl tabular-nums">$45,231.89</BzCardTitle>
                <BzCardAction>
                    <BzBadge>+20.1%</BzBadge>
                </BzCardAction>
            </BzCardHeader>
            <BzCardContent>
                <p class="text-xs text-muted-foreground">Trending up vs. last month</p>
            </BzCardContent>
        </BzCard>
    </Demo>

    <Demo Title="Notification" Code="@NotificationCode">
        <BzCard Class="w-full max-w-sm">
            <BzCardContent>
                <div class="flex items-start gap-3">
                    <span class="mt-1 size-2 shrink-0 rounded-full bg-primary"></span>
                    <div class="space-y-1">
                        <p class="text-sm font-medium leading-none">New comment on your envelope</p>
                        <p class="text-sm text-muted-foreground">Sarah left a note on “Q3 Agreement”.</p>
                    </div>
                </div>
            </BzCardContent>
        </BzCard>
    </Demo>

    <Demo Title="With menu"
          Description="A kebab (vertical dots) dropdown wired to a ghost icon button. Put it in the header's BzCardAction for a top menu, or in the footer for a bottom one."
          Code="@MenuCode">
        <div class="flex w-full flex-wrap justify-center gap-6">
            <BzCard Class="w-full max-w-sm">
                <BzCardHeader>
                    <BzCardTitle>Q3 Marketing Site</BzCardTitle>
                    <BzCardDescription>Updated 2 days ago by Sarah.</BzCardDescription>
                    <BzCardAction>
                        <BzDropdownMenu>
                            <BzDropdownMenuTrigger>
                                <RenderAs Context="p">
                                    <BzButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8" @attributes="p.Attributes">
                                        <BzIcon Icon="@Icons.Outline.DotsVertical" />
                                        <span class="sr-only">Open menu</span>
                                    </BzButton>
                                </RenderAs>
                            </BzDropdownMenuTrigger>
                            <BzDropdownMenuContent Align="Align.End">
                                <BzDropdownMenuItem>Edit</BzDropdownMenuItem>
                                <BzDropdownMenuItem>Duplicate</BzDropdownMenuItem>
                                <BzDropdownMenuSeparator />
                                <BzDropdownMenuItem Variant="DropdownMenuItemVariant.Destructive">Delete</BzDropdownMenuItem>
                            </BzDropdownMenuContent>
                        </BzDropdownMenu>
                    </BzCardAction>
                </BzCardHeader>
                <BzCardContent>
                    <p class="text-sm text-muted-foreground">The landing pages and campaign assets for the autumn launch.</p>
                </BzCardContent>
            </BzCard>

            <BzCard Class="w-full max-w-sm">
                <BzCardHeader>
                    <BzCardTitle>Design System</BzCardTitle>
                    <BzCardDescription>Shared tokens and components.</BzCardDescription>
                </BzCardHeader>
                <BzCardContent>
                    <p class="text-sm text-muted-foreground">The single source of truth for product UI.</p>
                </BzCardContent>
                <BzCardFooter Class="justify-between border-t">
                    <p class="text-xs text-muted-foreground">12 contributors</p>
                    <BzDropdownMenu>
                        <BzDropdownMenuTrigger>
                            <RenderAs Context="p">
                                <BzButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8" @attributes="p.Attributes">
                                    <BzIcon Icon="@Icons.Outline.DotsVertical" />
                                    <span class="sr-only">Open menu</span>
                                </BzButton>
                            </RenderAs>
                        </BzDropdownMenuTrigger>
                        <BzDropdownMenuContent Align="Align.End" Side="Side.Top">
                            <BzDropdownMenuItem>Share</BzDropdownMenuItem>
                            <BzDropdownMenuItem>Export</BzDropdownMenuItem>
                            <BzDropdownMenuSeparator />
                            <BzDropdownMenuItem Variant="DropdownMenuItemVariant.Destructive">Archive</BzDropdownMenuItem>
                        </BzDropdownMenuContent>
                    </BzDropdownMenu>
                </BzCardFooter>
            </BzCard>
        </div>
    </Demo>

    <Demo Title="Media"
          Description="A stream-style card: a full-bleed cover image with overlaid badges, then an avatar, title, channel line, a kebab menu, and topic tags - showing how far the card composes."
          Code="@MediaCode">
        <BzCard Class="w-full max-w-sm pt-0">
            <div class="relative">
                <img src="https://picsum.photos/seed/blaizio-live/640/360" alt="Stream preview" class="aspect-video w-full object-cover" />
                <BzBadge Class="absolute start-2 top-2 border-0 bg-red-600 text-white">LIVE</BzBadge>
                <span class="absolute bottom-2 end-2 rounded bg-black/70 px-1.5 py-0.5 text-xs font-medium text-white">2:24:11</span>
            </div>
            <BzCardHeader>
                <div class="flex items-start gap-3">
                    <BzAvatar>
                        <BzAvatarImage Src="https://i.pravatar.cc/120?img=22" Alt="Adam" />
                        <BzAvatarFallback>AY</BzAvatarFallback>
                    </BzAvatar>
                    <div class="space-y-1">
                        <BzCardTitle Class="text-base">Building the level editor live!</BzCardTitle>
                        <BzCardDescription>PixelSmith · Software and Game Development</BzCardDescription>
                    </div>
                </div>
                <BzCardAction>
                    <BzDropdownMenu>
                        <BzDropdownMenuTrigger>
                            <RenderAs Context="p">
                                <BzButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8" @attributes="p.Attributes">
                                    <BzIcon Icon="@Icons.Outline.DotsVertical" />
                                    <span class="sr-only">Open menu</span>
                                </BzButton>
                            </RenderAs>
                        </BzDropdownMenuTrigger>
                        <BzDropdownMenuContent Align="Align.End">
                            <BzDropdownMenuItem>Save to watch later</BzDropdownMenuItem>
                            <BzDropdownMenuItem>Share</BzDropdownMenuItem>
                            <BzDropdownMenuSeparator />
                            <BzDropdownMenuItem Variant="DropdownMenuItemVariant.Destructive">Not interested</BzDropdownMenuItem>
                        </BzDropdownMenuContent>
                    </BzDropdownMenu>
                </BzCardAction>
            </BzCardHeader>
            <BzCardContent Class="flex flex-wrap items-center gap-2">
                <BzBadge Variant="BadgeVariant.Secondary">design</BzBadge>
                <BzBadge Variant="BadgeVariant.Secondary">gamedevelopment</BzBadge>
                <span class="ms-auto text-xs text-muted-foreground">131 viewers</span>
            </BzCardContent>
        </BzCard>
    </Demo>
    <Demo Title="Customization"
          Description="Restyle the surface via Class - here the card gets a branded indigo gradient, a larger radius and white text. Root-level color and radius utilities win over the skin, so the override just takes." Code="@CustomCode">
        <BzCard Class="w-full max-w-sm rounded-2xl border-0 bg-gradient-to-br from-indigo-600 to-violet-600 text-white">
            <BzCardHeader>
                <BzCardTitle>Upgrade to Pro</BzCardTitle>
                <BzCardDescription Class="text-indigo-100">Unlock unlimited projects and priority support.</BzCardDescription>
                <BzCardAction>
                    <BzBadge Class="border-0 bg-white/20 text-white">New</BzBadge>
                </BzCardAction>
            </BzCardHeader>
            <BzCardContent>
                <p class="text-sm text-indigo-100">
                    Everything in Free, plus team seats and advanced analytics.
                </p>
            </BzCardContent>
            <BzCardFooter>
                <BzButton Class="border-white/25 bg-white/15 text-white shadow-none hover:bg-white/25">Upgrade</BzButton>
            </BzCardFooter>
        </BzCard>
    </Demo>

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the action, footer and text all mirror to the right." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzCard Class="w-full max-w-sm">
                <BzCardHeader>
                    <BzCardTitle>انشر مشروعك</BzCardTitle>
                    <BzCardDescription>ادفع إلى شبكة الحافة العالمية بنقرة واحدة.</BzCardDescription>
                    <BzCardAction>
                        <BzBadge Variant="BadgeVariant.Secondary">احترافي</BzBadge>
                    </BzCardAction>
                </BzCardHeader>
                <BzCardContent>
                    <p class="text-sm text-muted-foreground">
                        سيُبنى مشروعك ويُقدَّم من أقرب موقع لكل زائر.
                    </p>
                </BzCardContent>
                <BzCardFooter Class="justify-between border-t">
                    <BzButton Variant="ButtonVariant.Outline">إلغاء</BzButton>
                    <BzButton>نشر</BzButton>
                </BzCardFooter>
            </BzCard>
        </BzDirectionProvider>
    </Demo>
</div>

@code {
