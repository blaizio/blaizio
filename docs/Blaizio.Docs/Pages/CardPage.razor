@page "/docs/components/card"
@using Blaizio.Docs.Examples.Card
<PageTitle>Card - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Card</h1>
        <p class="text-muted-foreground">A surface for grouping related content and actions.</p>
    </header>

    <UsageBlock Example="typeof(CardUsageExample)"
                Description="Add the using once, then compose the parts. Header holds the title, description and an optional action; content and footer follow." />

    <CompositionTree Root="Anatomy"
                     Description="The full anatomy. BzCard is the surface; the header groups the title, description and a corner action, then content and footer fill out the body." />

    <ExamplesHeading />

    <Demo Title="With header, content & footer" Example="typeof(CardDefaultExample)" />

    <Demo Title="Stat card" Description="A compact card with just a header and content." Example="typeof(CardStatExample)" />

    <Demo Title="Notification" Example="typeof(CardNotificationExample)" />

    <Demo Title="With menu"
          Description="A kebab (vertical dots) dropdown wired to a ghost icon button. Put it in the header's BzCardAction for a top menu, or in the footer for a bottom one."
          Example="typeof(CardMenuExample)" />

    <Demo Title="Media"
          Description="A stream-style card: a full-bleed cover image with overlaid badges, then an avatar, title, channel line, a kebab menu, and topic tags - showing how far the card composes."
          Example="typeof(CardMediaExample)" />

    <Demo Title="Customization"
          Description="Restyle the surface via Class - here the card gets a branded indigo gradient, a larger radius and white text. Root-level color and radius utilities win over the skin, so the override just takes."
          Example="typeof(CardCustomExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the action, footer and text all mirror to the right." Example="typeof(CardRtlExample)" />
</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzCard",
        new CompositionNode("BzCardHeader",
            new CompositionNode("BzCardTitle"),
            new CompositionNode("BzCardDescription"),
            new CompositionNode("BzCardAction")),
        new CompositionNode("BzCardContent"),
        new CompositionNode("BzCardFooter"));
}
