@page "/docs/components/label"
@using Blaizio.Docs.Examples.Label
<PageTitle>Label - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Label</h1>
            <DocBadges Slug="label" />
        </div>
        <p>A caption associated with a form control through <code>For</code> or by wrapping it. It dims inside a disabled group, and <code>RenderAs</code> applies the same styling to another element when the control is not a native input.</p>
    </header>

    <UsageBlock Example="typeof(LabelUsageExample)" />

    <ExamplesHeading />

    <Demo Title="Default" Description="Set `For` to the control's id to associate the label with it."
          Example="typeof(LabelDefaultExample)" />

    <Demo Title="Custom element (RenderAs)"
          Description="Use `RenderAs` to apply the label styling to your own element. That helps when the control is not a native input, because a native label element would not associate with it."
          Example="typeof(LabelRenderAsExample)" />

    <Demo Title="Wrapping a control" Description="A label can wrap its control to associate them implicitly, so clicking the text toggles the control."
          Example="typeof(LabelWrapExample)" />

    <Demo Title="Disabled" Description="Inside a `group` element marked `data-disabled=&quot;true&quot;`, the label dims and ignores pointer events."
          Example="typeof(LabelDisabledExample)" />

    <Demo Title="Customization"
          Description="The label is a single element, so color, weight, size and tracking utilities on `Class` apply to it directly."
          Example="typeof(LabelCustomExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, the label and field align to the right."
          Example="typeof(LabelRtlExample)" />
</div>

