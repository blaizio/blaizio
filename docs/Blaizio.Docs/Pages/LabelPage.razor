@page "/components/label"
@using Blaizio.Docs.Examples.Label
<PageTitle>Label - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Label</h1>
        <p class="text-muted-foreground">An accessible caption associated with a form control.</p>
    </header>

    <UsageBlock Example="typeof(LabelUsageExample)" />

    <ExamplesHeading />

    <Demo Title="Default" Description="Link a label to a control with For matching the control's id."
          Example="typeof(LabelDefaultExample)" />

    <Demo Title="Custom element (RenderAs)"
          Description="Render the label styling onto your own element via RenderAs - useful when the control is not a native input, so a real <label> would not associate."
          Example="typeof(LabelRenderAsExample)" />

    <Demo Title="Wrapping a control" Description="A label can wrap its control to associate them implicitly - clicking the text toggles it."
          Example="typeof(LabelWrapExample)" />

    <Demo Title="Disabled" Description="Inside a group marked data-disabled, the label dims and ignores pointer events."
          Example="typeof(LabelDisabledExample)" />

    <Demo Title="Customization"
          Description="The label is a single element, so type utilities apply directly - tune color, weight, size and tracking with utilities on class."
          Example="typeof(LabelCustomExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the label and field align to the right."
          Example="typeof(LabelRtlExample)" />
</div>

