@page "/docs/components/message-scroller"
@using Blaizio.Docs.Examples.MessageScroller
<PageTitle>Message Scroller - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Message Scroller</h1>
            <DocBadges Slug="message-scroller" />
        </div>
        <p>A chat transcript scroller built for streaming conversations: it opens at the newest message, follows streamed responses, anchors new turns, loads history without jumping, and can jump to any message.</p>
    </header>

    <UsageBlock Example="typeof(MessageScrollerUsageExample)" />

    <CompositionTree Root="Anatomy"
                     Description="The full anatomy. Wrap every direct child of the content in an Item so the engine can anchor, preserve position, and jump to it; the buttons are optional and sit as siblings of the viewport." />

    <section>
        <h2 data-toc class="scroll-mt-20">Sizing</h2>
        <p>
            The scroller fills its container. Give it a height directly (Class="h-96") or make it
            the flex-1 child of a height-constrained column - a chat page layout. All the scroll
            state lives in the browser; appending, prepending, or streaming messages from C# never
            round-trips through .NET for scrolling.
        </p>
    </section>

    <ExamplesHeading />

    <Demo Title="Streaming"
          Description="The transcript follows the streamed reply while you are within FollowMargin of the bottom. Scroll up out of that block mid-stream and it stays put - the button appears the moment follow pauses; scroll back into the block (or press the button) and it picks the stream up again."
          Example="typeof(MessageScrollerStreamExample)" />

    <Demo Title="Streaming typeset prose"
          Description="Markdown-shaped blocks landing in a typeset typeset-chat wrapper, one arrival at a time. The typeset spaces blocks only from above (margin-block-start, sibling-gated), so everything already on screen holds still while the next block appears. See the Typeset guide for the contract."
          Example="typeof(MessageScrollerTypesetExample)" />

    <Demo Title="Anchored turns"
          Description="ScrollAnchor marks turn boundaries. A turn you send anchors near the viewport top wherever you were reading, keeping AnchorPeek pixels of the previous turn visible, and the reply streams into the reserved space below it. The space is used up as the reply grows, and once the reply reaches the bottom the view follows it like any other stream. A reply that ends short leaves some: the app hands it back with ReleaseReservedSpaceAsync when its stream is over, and the engine hands it back itself when you scroll up out of the follow margin or press the end button."
          Example="typeof(MessageScrollerAnchorExample)" />

    <Demo Title="Keeping context visible"
          Description="AnchorPeek sets how much of the previous turn stays visible above an anchored one - here a generous 64px slice, so the question being answered never fully leaves the screen."
          Example="typeof(MessageScrollerPeekExample)" />

    <Demo Title="Group chat"
          Description="ScrollAnchor works on any row, not just messages - here the Markers announcing room events anchor each burst of activity so it reads top-down."
          Example="typeof(MessageScrollerGroupChatExample)" />

    <Demo Title="Prepending history"
          Description="Older messages added above keep the row you were reading exactly where it was. Always give looped items a key directive - without it Blazor recycles the rows in place and a prepend reaches the DOM as an append."
          Example="typeof(MessageScrollerPrependExample)" />

    <Demo Title="Commands"
          Description="Capture the scroller with a ref and drive it from outside: ScrollToMessageAsync jumps to any MessageId, ScrollToStartAsync and ScrollToEndAsync take either edge."
          Example="typeof(MessageScrollerCommandsExample)" />

    <Demo Title="Animated arrivals"
          Description="Entrance utilities on the item animate new rows in (gated behind motion-safe); the scroller keeps hugging the live edge while they play."
          Example="typeof(MessageScrollerAnimationExample)" />

    <Demo Title="Scroll buttons"
          Description="A control per edge, each inert and hidden until there is content in its direction. DefaultPosition Start opens the transcript at the oldest message instead of the newest."
          Example="typeof(MessageScrollerButtonsExample)" />

    <Demo Title="RTL"
          Description="Wrapped in a DirectionProvider with Arabic or Hebrew copy: bubbles mirror and the scroll button stays centred."
          Example="typeof(MessageScrollerRtlExample)" />
</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzMessageScroller",
        new CompositionNode("BzMessageScrollerViewport",
            new CompositionNode("BzMessageScrollerContent",
                new CompositionNode("BzMessageScrollerItem"))),
        new CompositionNode("BzMessageScrollerButton"));
}
