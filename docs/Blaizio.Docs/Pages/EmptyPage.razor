@page "/docs/components/empty"
@using Blaizio.Docs.Examples.Empty
<PageTitle>Empty - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Empty</h1>
            <DocBadges Slug="empty" />
        </div>
        <p>A centered placeholder for when there is nothing to show yet, such as a search with no results, an empty inbox or a first run. You compose it from a header with optional media, a title and a description, followed by an area for actions.</p>
    </header>

    <UsageBlock Example="typeof(EmptyUsageExample)" />

    <CompositionTree Root="Anatomy"
                     Description="Every part of an empty state. `BzEmptyMedia` is optional: its `Icon` variant puts a single icon on a muted tile, while `Default` shows avatars or artwork as they are. The content area holds actions or helper links." />

    <ExamplesHeading />

    <Demo Title="Default" Example="typeof(EmptyDefaultExample)" />

    <Demo Title="Outline"
          Description="The container has no border of its own. Add one through `Class` when you want the dashed drop-zone look."
          Example="typeof(EmptyOutlineExample)" />

    <Demo Title="Avatar"
          Description="The `Default` media variant adds no tile, so avatars, illustrations and images appear as they are."
          Example="typeof(EmptyAvatarExample)" />

    <Demo Title="RTL"
          Description="Inside a right-to-left `DirectionProvider`, the text alignment and the order of the action buttons mirror."
          Example="typeof(EmptyRtlExample)" />
</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzEmpty",
        new CompositionNode("BzEmptyHeader",
            new CompositionNode("BzEmptyMedia"),
            new CompositionNode("BzEmptyTitle"),
            new CompositionNode("BzEmptyDescription")),
        new CompositionNode("BzEmptyContent"));
}
