@page "/docs/components/empty"
@using Blaizio.Docs.Examples.Empty
<PageTitle>Empty - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Empty</h1>
        <p class="text-muted-foreground">A centered placeholder for states with nothing to show - no results, an empty inbox, a first run. Compose a header (media, title, description) with an action area.</p>
    </header>

    <UsageBlock Example="typeof(EmptyUsageExample)" />

    <CompositionTree Root="Anatomy"
                     Description="The full anatomy. Media is optional (Icon variant wraps a lone icon in a muted tile; Default renders avatars or art bare), and the content area holds actions or helper links." />

    <ExamplesHeading />

    <Demo Title="Default" Example="typeof(EmptyDefaultExample)" />

    <Demo Title="Outline"
          Description="The container is unopinionated - add the classic dashed drop-zone look with Class."
          Example="typeof(EmptyOutlineExample)" />

    <Demo Title="Avatar"
          Description="The default media variant renders content bare - avatars, illustrations, images."
          Example="typeof(EmptyAvatarExample)" />

    <Demo Title="RTL"
          Description="Wrapped in a DirectionProvider with Arabic copy - text alignment and the action row mirror to the right."
          Example="typeof(EmptyRtlExample)" />
</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzEmpty",
        new CompositionNode("BzEmptyHeader",
            new CompositionNode("BzEmptyMedia"),
            new CompositionNode("BzEmptyTitle"),
            new CompositionNode("BzEmptyDescription")),
        new CompositionNode("BzEmptyContent"));
}
