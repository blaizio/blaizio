@page "/docs/components/qr-code"
@using Blaizio.Docs.Examples.QrCode
<PageTitle>QR Code - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">QR Code</h1>
            <DocBadges Slug="qr-code" />
        </div>
        <p class="text-muted-foreground">A themeable, pure-SVG QR code: sizes, colors and gradients, module and eye shapes, a center logo or icon, and configurable error correction. No JavaScript, works in static SSR.</p>
    </header>

    <UsageBlock Example="typeof(QrCodeUsageExample)" />

    <ExamplesHeading />

    <Demo Title="Sizes" Description="Four presets; pass your own size utilities via Class for anything else. The SVG scales losslessly." Example="typeof(QrCodeSizesExample)" />

    <Demo Title="Error correction"
          Description="Higher levels survive more damage or cover at the cost of a denser symbol. Use High when a logo sits in the center."
          Example="typeof(QrCodeErrorCorrectionExample)" />

    <Demo Title="Colors"
          Description="Any CSS color, including theme tokens. By default the symbol follows the themed foreground; note that some readers struggle with light-on-dark, so pin fixed colors when scanning must never fail."
          Example="typeof(QrCodeColorsExample)" />

    <Demo Title="Gradient"
          Description="Set ForegroundEnd for a two-stop linear gradient over the modules; GradientAngle steers it. Keep both stops dark against the background or scanners lose the light half."
          Example="typeof(QrCodeGradientExample)" />

    <Demo Title="Module styles" Description="The shape of the data modules." Example="typeof(QrCodeModuleStylesExample)" />

    <Demo Title="Eye styles"
          Description="The three finder patterns take their own shape and, via EyeColor, their own color."
          Example="typeof(QrCodeEyesExample)" />

    <Demo Title="Center image"
          Description="ImageSrc draws a logo in the middle; the modules underneath are excavated so it sits on a clean patch."
          Example="typeof(QrCodeImageExample)" />

    <Demo Title="Center content"
          Description="CenterContent renders arbitrary HTML over the symbol instead - an icon, initials, anything. CenterScale sets how much of the width it takes."
          Example="typeof(QrCodeCenterContentExample)" />

    <Demo Title="Quiet zone"
          Description="The blank margin around the symbol, in modules. It scales with the code; the spec recommends 4 for hard scanning conditions."
          Example="typeof(QrCodeQuietZoneExample)" />

    <Demo Title="WiFi network"
          Description="QR payloads are just strings - here a WIFI: payload built from live inputs. Scanning joins the network."
          Example="typeof(QrCodeWifiExample)" />
</div>
