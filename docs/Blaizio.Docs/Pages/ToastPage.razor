@page "/docs/components/toast"
@using Blaizio.Docs.Examples.Toast
<PageTitle>Toast - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Toast</h1>
            <DocBadges Slug="toast" />
        </div>
        <p>An opinionated toast notification system. Raise toasts imperatively from C# anywhere - they stack at the corner, lift apart on hover, auto-close, and swipe away.</p>
    </header>

    <UsageBlock SetupSnippet="Toast/UsageSetup" Example="typeof(ToastDefaultExample)"
                Description="Register the service and host once, then inject IToastService and raise toasts imperatively from anywhere." />

    @* Setup and API are reference, not examples: plain code sections (no preview frame to leave
       empty) and h2s, so the TOC lists them beside Usage instead of nesting them under Examples. *@
    <section>
        <h2 data-toc class="scroll-mt-20">Setup</h2>
        <p>Register the service once and drop a single host at your app root.</p>
        <CodeBlock Snippet="Toast/Setup" />
        <p>Already wired up in this docs app (<code>AddBlaizio()</code> in <code>Program.cs</code> and one <code>&lt;ToastProvider /&gt;</code> in the layout), so every demo below is live.</p>
    </section>

    <section>
        <h2 data-toc class="scroll-mt-20">API</h2>
        <p>Inject <code>IToastService</code> anywhere and call one of:</p>
        <CodeBlock Snippet="Toast/IToastService" />
    </section>

    <ExamplesHeading />

    <Demo Title="Default" Description="The common case: a one-line message that auto-closes." Example="typeof(ToastDefaultExample)" />

    <Demo Title="With description" Description="A title plus a secondary line." Example="typeof(ToastDescriptionExample)" />

    <Demo Title="Types" Description="Success, error, warning and info each get an icon; loading shows a spinner and stays until you resolve it." Example="typeof(ToastTypesExample)" />

    <Demo Title="Rich colors" Description="Fill the whole toast with its type colour." Example="typeof(ToastRichColorsExample)" />

    <Demo Title="Action button" Description="A primary action that runs a handler and closes the toast." Example="typeof(ToastActionExample)" />

    <Demo Title="Cancel button" Description="A secondary button - here paired with a close button." Example="typeof(ToastCancelExample)" />

    <Demo Title="Track an async operation" Description="One toast that starts as a spinner, then resolves in place to success or error when the Task settles." Example="typeof(ToastTrackExample)" />

    <Demo Title="Custom content" Description="Pass a RenderFragment for a fully bespoke toast body." Example="typeof(ToastCustomContentExample)" />

    <Demo Title="Custom icon" Description="Override the icon per toast with Icon. The default loading spinner can be swapped globally on the provider via LoadingIcon (e.g. a spinning Tabler icon)." Example="typeof(ToastIconExample)" />

    <Demo Title="Close button" Description="Show a close button at the end of the toast - per toast, or default it on the ToastProvider." Example="typeof(ToastCloseExample)" />

    <Demo Title="Custom duration" Description="Override how long it stays - or keep it until dismissed." Example="typeof(ToastDurationExample)" />

    <Demo Title="Position" Description="A toast can open at any corner, overriding the ToastProvider default." Example="typeof(ToastPositionExample)" />

    <Demo Title="Update and dismiss" Description="Every call returns an id: pass it back to update a toast in place, or dismiss it." Example="typeof(ToastUpdateExample)" />

    <Demo Title="Customization" Description="Compose the options to brand a toast - here a custom Icon, rich colours and a description on a success toast - so it matches your product's voice. (For a fully bespoke body, see Custom content above.)" Example="typeof(ToastCustomizationExample)" />

    <Demo Title="RTL" Description="Toasts follow the app's reading direction, or a single toast can opt in via Direction - here an RTL toast on this LTR page. The icon, buttons and text all mirror." Example="typeof(ToastRtlExample)" />

</div>

