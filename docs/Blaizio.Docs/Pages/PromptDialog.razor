@namespace Blaizio.Docs.Pages
@*
    Example dialog body shown via IDialogService.ShowAsync<PromptDialog>. Reads its DialogInstance
    from the cascade and resolves the typed input value with DialogResult.Ok.
*@

<BzDialogHeader>
    <BzDialogTitle>Rename project</BzDialogTitle>
    <BzDialogDescription>Give the project a new name, then choose Save.</BzDialogDescription>
</BzDialogHeader>
<div class="grid gap-2 py-4">
    <BzLabel for="prompt-name">Name</BzLabel>
    <BzInputText id="prompt-name" @bind-Value="_value" />
    @* A popup inside a dialog: it portals to the body, so it is a stacking SIBLING of the dialog
       window rather than a descendant. The layer cascade is what lifts it above. *@
    <BzLabel for="prompt-visibility">Visibility</BzLabel>
    <BzSelect @bind-Value="_visibility">
        <BzSelectTrigger id="prompt-visibility">
            <BzSelectValue Placeholder="Choose..." />
        </BzSelectTrigger>
        <BzSelectContent>
            <BzSelectItem Value="private">Private</BzSelectItem>
            <BzSelectItem Value="team">Team</BzSelectItem>
            <BzSelectItem Value="public">Public</BzSelectItem>
        </BzSelectContent>
    </BzSelect>
</div>
<BzDialogFooter>
    <BzButton Variant="ButtonVariant.Outline" @onclick="() => Dialog.Cancel()">Cancel</BzButton>
    <BzButton @onclick="Save">Save</BzButton>
</BzDialogFooter>

@code {
    /// <summary>Initial text for the input.</summary>
    [Parameter] public string? Initial { get; set; }

    [CascadingParameter] private DialogInstance Dialog { get; set; } = default!;

    private string? _value;
    private string? _visibility = "private";

    protected override void OnInitialized() => _value = Initial;

    private void Save() => Dialog.Close(DialogResult.Ok(_value ?? ""));
}
