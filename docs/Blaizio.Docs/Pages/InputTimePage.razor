@page "/components/input-time"
@page "/components/time-picker"
@using Blaizio.Docs.Examples.InputTime
<PageTitle>Input Time - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Input Time</h1>
        <p class="text-muted-foreground">An inline time field binding a <code>TimeOnly</code>. You edit the hour, minute and optional seconds segments in place - type or step them - and <code>HourCycle</code> picks the clock face: the browser's own locale (default), or a forced 12- or 24-hour rendering. Pairs with <a class="underline underline-offset-4" href="/components/calendar">Calendar</a> for a date-and-time picker.</p>
    </header>

    <UsageBlock Example="typeof(InputTimeBasicExample)"
                Description="Add the using once, then two-way bind a nullable TimeOnly to Value." />

    <ExamplesHeading />

    <Demo Title="Basic" Description="An hour:minute field with a leading clock icon. 12- or 24-hour follows the browser's locale."
          Example="typeof(InputTimeBasicExample)" />

    <Demo Title="12- and 24-hour" Description="HourCycle forces the clock face whatever the browser locale: TwelveHour renders segments with an AM/PM toggle (click it, arrow it, or press A/P), TwentyFourHour a 00-23 hour. Type digits - the focus hops along - or step with the arrows."
          Example="typeof(InputTimeHourCycleExample)" />

    <Demo Title="With seconds" Description="ShowSeconds adds the seconds segment (the native step becomes one second)."
          Example="typeof(InputTimeSecondsExample)" />

    <Demo Title="Minute step" Description="MinuteStep coarsens the stepper increment - here to 15-minute jumps when you use the arrows."
          Example="typeof(InputTimeStepExample)" />

    <Demo Title="No icon" Description="ShowIcon=false drops the leading clock for a bare field. Pass Icon to swap in your own."
          Example="typeof(InputTimeNoIconExample)" />

    <Demo Title="Disabled" Description="Disabled greys the field and blocks editing."
          Example="typeof(InputTimeDisabledExample)" />

    <Demo Title="Customization"
          Description="Pass your own classes via Class - width, radius, brand focus ring - merged over the field defaults, and swap the leading glyph through the Icon slot."
          Example="typeof(InputTimeCustomExample)" />

    <Demo Title="RTL"
          Description="Under a right-to-left DirectionProvider the field mirrors - the clock icon moves to the inline-end edge - while the native time segments stay numeric."
          Example="typeof(InputTimeRtlExample)" />

</div>

