@page "/components/virtualizer"
@using Blaizio.Docs.Examples.Virtualizer
<PageTitle>BzVirtualizer - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">BzVirtualizer</h1>
        <p class="text-muted-foreground">
            Renders only the items in view, so a list of thousands stays light in the DOM. Hand it
            <code class="bz-code">Items</code> and an item template; it mounts the visible slice plus two
            spacers that keep the scroll height exact. By default it virtualizes against the page (no height
            cap) - set <code class="bz-code">MaxHeight</code> for a fixed scroll box. It is the same engine
            <code class="bz-code">BzDataTable&lt;TItem&gt;</code> uses to virtualize its rows.
        </p>
    </header>

    <UsageBlock Example="typeof(VirtualizerUsageExample)"
                Description="Hand it Items and an item template. The template's context is a VirtualItem - render context.Item and spread context.Attributes on the root element. Set MaxHeight for a fixed scroll box, or omit it to virtualize against the page." />

    <ExamplesHeading />

    <Demo Title="Fixed height"
          Description="The fast path: every item is exactly ItemSize, so placement is pure index math (scales to huge lists). 100,000 rows scroll inside a 20rem box, yet only the visible band is ever in the DOM. The item template's context is a VirtualItem - render context.Item and spread context.Attributes on the root element. Drop MaxHeight to virtualize against the page instead, with no height cap."
          Example="typeof(VirtualizerFixedExample)" />

    <Demo Title="Dynamic height"
          Description="Add Dynamic and the virtualizer measures each rendered item instead of assuming ItemSize - so items of different heights (here notes that wrap) place correctly. ItemSize becomes just the estimate used until an item is measured; in this mode context.Attributes carries only the index marker, no fixed height."
          Example="typeof(VirtualizerDynamicExample)" />

    <Demo Title="Empty state"
          Description="When Items is empty the spacers and rows collapse to whatever EmptyContent renders."
          Example="typeof(VirtualizerEmptyExample)" />

    <Demo Title="Customization"
          Description="The chrome is yours: style the scroll box however you like (Class is merged onto the virtualizer root) and drive the row look from the template - here zebra striping keyed off row.Index."
          Example="typeof(VirtualizerCustomExample)" />

    <Demo Title="RTL"
          Description="Nothing in the virtualizer is direction-specific - under a right-to-left DirectionProvider the rows flow right-to-left and the logical ms-auto pushes the email to the inline-end edge."
          Example="typeof(VirtualizerRtlExample)" />

</div>

