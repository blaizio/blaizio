@page "/docs/components/input-otp"
@using Blaizio.Docs.Examples.InputOtp
<PageTitle>Input OTP - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Input OTP</h1>
            <DocBadges Slug="input-otp" />
        </div>
        <p>A one-time-code field with individual character slots. A single hidden input drives it, so typing, pasting, focus, arrow keys and the OS autofill all work; the active slot is highlighted and shows a blinking caret. Compose the slots in groups with optional separators.</p>
    </header>

    <UsageBlock Example="typeof(InputOtpUsageExample)"
                Description="Set MaxLength, then lay out that many BzInputOtpSlot (each with its Index) inside one or more BzInputOtpGroup, separated by BzInputOtpSeparator. Two-way bind the Value to read the code." />

    <CompositionTree Root="Anatomy"
                     Description="One field, split into groups of slots. Each slot renders the character at its Index; the separator is decorative." />

    <ExamplesHeading />

    <Demo Title="Default" Description="Six digit slots in two groups. Type, or paste a full code at once; backspace and arrow keys move between slots."
          Example="typeof(InputOtpDefaultExample)" />

    <Demo Title="Patterns" Description="Restrict input with Pattern - a regex the whole value must match on each keystroke. Use the InputOtpPatterns helpers for the common cases."
          Example="typeof(InputOtpPatternExample)" />

    <Demo Title="Mask" Description="Set Mask to hide the typed characters behind a glyph - useful for a private PIN. The bound value still holds the real digits; pass MaskChar for a different glyph."
          Example="typeof(InputOtpMaskExample)" />

    <Demo Title="One group" Description="Skip the separator for a single continuous group."
          Example="typeof(InputOtpSingleExample)" />

    <Demo Title="Programmatic focus" Description="Hold a reference to the component and call FocusAsync to move the keyboard yourself - Resend clears the code and puts the caret back in the first slot. The focus lands on the overlay input behind the slots, so typing fills them."
          Example="typeof(InputOtpFocusMethodExample)" />

    <Demo Title="Auto focus" Description="AutoFocus focuses the field the moment it appears - press Send code and the slots are ready for typing, no click needed. Unlike the native autofocus attribute this works for markup that mounts later, which is exactly when a code prompt shows up."
          Example="typeof(InputOtpAutoFocusExample)" />

    <Demo Title="Controlled" Description="Bind the value two-way to read or set the code from your own state."
          Example="typeof(InputOtpControlledExample)" />

    <Demo Title="On complete" Description="OnComplete fires once when the last slot is filled - the natural place to submit the code."
          Example="typeof(InputOtpCompleteExample)" />

    <Demo Title="Disabled" Description="A disabled field is dimmed and inert."
          Example="typeof(InputOtpDisabledExample)" />

    <Demo Title="Invalid" Description="aria-invalid turns the slots destructive - a red border across the field and a ring on the active slot - here forced, normally set by FieldControl."
          Example="typeof(InputOtpInvalidExample)" />

    <Demo Title="Validation in an EditForm" Description="A verify-your-login card. The OTP field joins the Field's validation via FieldControl - the wrapper hands it the field's id, aria-describedby and (when invalid) aria-invalid, which turns every slot destructive. DataAnnotations, validated on submit."
          Example="typeof(InputOtpValidationEditFormExample)" />

    <Demo Title="Customization" Description="Restyle the slots through the input-otp-slot data slot - here a rounded indigo field with a branded active ring. Utilities win over the skin, so these take effect."
          Example="typeof(InputOtpCustomExample)" />

    <Demo Title="RTL" Description="Under a right-to-left DirectionProvider the groups and slot rounding mirror and the arrow keys follow the visual order; the code still reads left-to-right within the value."
          Example="typeof(InputOtpRtlExample)" />

</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzInputOtp",
        new CompositionNode("BzInputOtpGroup",
            new CompositionNode("BzInputOtpSlot")),
        new CompositionNode("BzInputOtpSeparator"),
        new CompositionNode("BzInputOtpGroup",
            new CompositionNode("BzInputOtpSlot")));
}
