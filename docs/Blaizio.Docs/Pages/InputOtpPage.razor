@page "/docs/components/input-otp"
@using Blaizio.Docs.Examples.InputOtp
<PageTitle>Input OTP - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Input OTP</h1>
            <DocBadges Slug="input-otp" />
        </div>
        <p>A one-time-code field drawn as individual character slots over a single hidden input. Because one real input does the work, typing, pasting, arrow keys and the operating system's code autofill all behave natively. The active slot is highlighted with a blinking caret, and you arrange the slots into groups with optional separators.</p>
    </header>

    <UsageBlock Example="typeof(InputOtpUsageExample)"
                Description="Set `MaxLength`, then lay out that many `BzInputOtpSlot` elements, each with its `Index`, inside one or more `BzInputOtpGroup` with a `BzInputOtpSeparator` between groups. Bind `Value` two-way to read the code." />

    <CompositionTree Root="Anatomy"
                     Description="One field split into groups of slots. Each slot shows the character at its `Index`, and the separator is decorative." />

    <ExamplesHeading />

    <Demo Title="Default" Description="Six digit slots in two groups. Type the code or paste it in one go; Backspace and the arrow keys move between slots."
          Example="typeof(InputOtpDefaultExample)" />

    <Demo Title="Patterns" Description="`Pattern` restricts input with a regex the whole value must match on every keystroke. The `InputOtpPatterns` helpers cover the common cases."
          Example="typeof(InputOtpPatternExample)" />

    <Demo Title="Mask" Description="Set `Mask` to hide the typed characters behind a glyph, as you would for a private PIN. The bound value still holds the real digits, and `MaskChar` changes the glyph."
          Example="typeof(InputOtpMaskExample)" />

    <Demo Title="One group" Description="Leave out the separator for a single continuous group."
          Example="typeof(InputOtpSingleExample)" />

    <Demo Title="Programmatic focus" Description="Keep a reference to the component and call `FocusAsync` to move focus from code. Here Resend clears the code and puts the caret back in the first slot. Focus lands on the hidden input behind the slots, so typing fills them."
          Example="typeof(InputOtpFocusMethodExample)" />

    <Demo Title="Auto focus" Description="`AutoFocus` focuses the field as soon as it appears, so after Send code the slots are ready for typing without a click. Unlike the native `autofocus` attribute, it also works for markup that renders later, which is exactly when a code prompt shows up."
          Example="typeof(InputOtpAutoFocusExample)" />

    <Demo Title="Controlled" Description="Bind the value two-way to read or set the code from your own state."
          Example="typeof(InputOtpControlledExample)" />

    <Demo Title="On complete" Description="`OnComplete` fires once when the last slot is filled, which makes it the natural place to submit the code."
          Example="typeof(InputOtpCompleteExample)" />

    <Demo Title="Disabled" Description="A disabled field is dimmed and ignores input."
          Example="typeof(InputOtpDisabledExample)" />

    <Demo Title="Invalid" Description="`aria-invalid` turns the slots destructive, with a red border across the field and a ring on the active slot. It is forced here; normally `BzFieldControl` sets it."
          Example="typeof(InputOtpInvalidExample)" />

    <Demo Title="Validation in an EditForm" Description="A login verification card validated with DataAnnotations on submit. `BzFieldControl` gives the code field its id, `aria-describedby` and, when validation fails, `aria-invalid`, which turns every slot destructive."
          Example="typeof(InputOtpValidationEditFormExample)" />

    <Demo Title="Customization" Description="Restyle the slots through the `input-otp-slot` data slot. This example draws a rounded indigo field with a branded active ring."
          Example="typeof(InputOtpCustomExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, the groups and slot rounding mirror and the arrow keys follow the visual order. The bound value still reads left to right."
          Example="typeof(InputOtpRtlExample)" />

</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzInputOtp",
        new CompositionNode("BzInputOtpGroup",
            new CompositionNode("BzInputOtpSlot")),
        new CompositionNode("BzInputOtpSeparator"),
        new CompositionNode("BzInputOtpGroup",
            new CompositionNode("BzInputOtpSlot")));
}
