@page "/components/input-otp"
@using System.ComponentModel.DataAnnotations
<PageTitle>Input OTP - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Input OTP</h1>
        <p class="text-muted-foreground">A one-time-code field with individual character slots. A single hidden input drives it, so typing, pasting, focus, arrow keys and the OS autofill all work; the active slot is highlighted and shows a blinking caret. Compose the slots in groups with optional separators.</p>
    </header>

    <UsageBlock Setup="@UsageSetup" Code="@UsageMarkup"
                Description="Set MaxLength, then lay out that many BzInputOtpSlot (each with its Index) inside one or more BzInputOtpGroup, separated by BzInputOtpSeparator. Two-way bind the Value to read the code." />

    <CompositionTree Root="_anatomy"
                     Description="One field, split into groups of slots. Each slot renders the character at its Index; the separator is decorative." />

    <ExamplesHeading />

    <Demo Title="Default" Description="Six digit slots in two groups. Type, or paste a full code at once; backspace and arrow keys move between slots." Code="@DefaultCode">
        <BzInputOtp MaxLength="6" Pattern="@InputOtpPatterns.Digits" AriaLabel="One-time code">
            <BzInputOtpGroup>
                <BzInputOtpSlot Index="0" />
                <BzInputOtpSlot Index="1" />
                <BzInputOtpSlot Index="2" />
            </BzInputOtpGroup>
            <BzInputOtpSeparator />
            <BzInputOtpGroup>
                <BzInputOtpSlot Index="3" />
                <BzInputOtpSlot Index="4" />
                <BzInputOtpSlot Index="5" />
            </BzInputOtpGroup>
        </BzInputOtp>
    </Demo>

    <Demo Title="Patterns" Description="Restrict input with Pattern - a regex the whole value must match on each keystroke. Use the InputOtpPatterns helpers for the common cases." Code="@PatternCode">
        <div class="flex flex-col gap-6">
            <div class="space-y-2">
                <p class="text-muted-foreground text-sm">Digits only</p>
                <BzInputOtp MaxLength="4" Pattern="@InputOtpPatterns.Digits" InputMode="numeric">
                    <BzInputOtpGroup>
                        <BzInputOtpSlot Index="0" />
                        <BzInputOtpSlot Index="1" />
                        <BzInputOtpSlot Index="2" />
                        <BzInputOtpSlot Index="3" />
                    </BzInputOtpGroup>
                </BzInputOtp>
            </div>
            <div class="space-y-2">
                <p class="text-muted-foreground text-sm">Letters and digits (uppercased)</p>
                <BzInputOtp MaxLength="6" Pattern="@InputOtpPatterns.DigitsAndChars" InputMode="text" Class="uppercase">
                    <BzInputOtpGroup>
                        <BzInputOtpSlot Index="0" />
                        <BzInputOtpSlot Index="1" />
                        <BzInputOtpSlot Index="2" />
                        <BzInputOtpSlot Index="3" />
                        <BzInputOtpSlot Index="4" />
                        <BzInputOtpSlot Index="5" />
                    </BzInputOtpGroup>
                </BzInputOtp>
            </div>
        </div>
    </Demo>

    <Demo Title="Mask" Description="Set Mask to hide the typed characters behind a glyph - useful for a private PIN. The bound value still holds the real digits; pass MaskChar for a different glyph." Code="@MaskCode">
        <BzInputOtp MaxLength="6" Pattern="@InputOtpPatterns.Digits" Mask AriaLabel="PIN">
            <BzInputOtpGroup>
                <BzInputOtpSlot Index="0" />
                <BzInputOtpSlot Index="1" />
                <BzInputOtpSlot Index="2" />
            </BzInputOtpGroup>
            <BzInputOtpSeparator />
            <BzInputOtpGroup>
                <BzInputOtpSlot Index="3" />
                <BzInputOtpSlot Index="4" />
                <BzInputOtpSlot Index="5" />
            </BzInputOtpGroup>
        </BzInputOtp>
    </Demo>

    <Demo Title="One group" Description="Skip the separator for a single continuous group." Code="@SingleCode">
        <BzInputOtp MaxLength="5" Pattern="@InputOtpPatterns.Digits">
            <BzInputOtpGroup>
                <BzInputOtpSlot Index="0" />
                <BzInputOtpSlot Index="1" />
                <BzInputOtpSlot Index="2" />
                <BzInputOtpSlot Index="3" />
                <BzInputOtpSlot Index="4" />
            </BzInputOtpGroup>
        </BzInputOtp>
    </Demo>

    <Demo Title="Controlled" Description="Bind the value two-way to read or set the code from your own state." Code="@ControlledCode">
        <div class="space-y-3">
            <BzInputOtp @bind-Value="_controlled" MaxLength="6" Pattern="@InputOtpPatterns.Digits">
                <BzInputOtpGroup>
                    @for (var i = 0; i < 6; i++)
                    {
                        <BzInputOtpSlot Index="i" />
                    }
                </BzInputOtpGroup>
            </BzInputOtp>
            <p class="text-muted-foreground text-sm">Value: <span class="text-foreground font-mono">@(string.IsNullOrEmpty(_controlled) ? "(empty)" : _controlled)</span></p>
            <BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" @onclick="@(() => _controlled = "")">Clear</BzButton>
        </div>
    </Demo>

    <Demo Title="On complete" Description="OnComplete fires once when the last slot is filled - the natural place to submit the code." Code="@CompleteCode">
        <div class="space-y-3">
            <BzInputOtp @bind-Value="_completeValue" MaxLength="6" Pattern="@InputOtpPatterns.Digits" OnComplete="OnOtpComplete">
                <BzInputOtpGroup>
                    <BzInputOtpSlot Index="0" />
                    <BzInputOtpSlot Index="1" />
                    <BzInputOtpSlot Index="2" />
                </BzInputOtpGroup>
                <BzInputOtpSeparator />
                <BzInputOtpGroup>
                    <BzInputOtpSlot Index="3" />
                    <BzInputOtpSlot Index="4" />
                    <BzInputOtpSlot Index="5" />
                </BzInputOtpGroup>
            </BzInputOtp>
            <p class="text-sm @(_completed ? "text-emerald-600 dark:text-emerald-400" : "text-muted-foreground")">@_completeStatus</p>
        </div>
    </Demo>

    <Demo Title="Disabled" Description="A disabled field is dimmed and inert." Code="@DisabledCode">
        <BzInputOtp MaxLength="6" Disabled Value="123456">
            <BzInputOtpGroup>
                <BzInputOtpSlot Index="0" />
                <BzInputOtpSlot Index="1" />
                <BzInputOtpSlot Index="2" />
            </BzInputOtpGroup>
            <BzInputOtpSeparator />
            <BzInputOtpGroup>
                <BzInputOtpSlot Index="3" />
                <BzInputOtpSlot Index="4" />
                <BzInputOtpSlot Index="5" />
            </BzInputOtpGroup>
        </BzInputOtp>
    </Demo>

    <Demo Title="Invalid" Description="aria-invalid turns the slots destructive - a red border across the field and a ring on the active slot - here forced, normally set by FieldControl." Code="@InvalidCode">
        <BzInputOtp MaxLength="6" Pattern="@InputOtpPatterns.Digits" Value="123" aria-invalid="true" AriaLabel="One-time code">
            <BzInputOtpGroup>
                <BzInputOtpSlot Index="0" />
                <BzInputOtpSlot Index="1" />
                <BzInputOtpSlot Index="2" />
            </BzInputOtpGroup>
            <BzInputOtpSeparator />
            <BzInputOtpGroup>
                <BzInputOtpSlot Index="3" />
                <BzInputOtpSlot Index="4" />
                <BzInputOtpSlot Index="5" />
            </BzInputOtpGroup>
        </BzInputOtp>
    </Demo>

    <Demo Title="Validation in an EditForm" Description="Wrap the field in a FieldControl and it joins the Field's validation - the wrapper hands it the field's id, aria-describedby and (when invalid) aria-invalid, which turns every slot destructive. DataAnnotations here, validated on submit." Code="@ValidationEditFormCode">
        <EditForm Model="@_verify" OnValidSubmit="@(() => _verified = true)" OnInvalidSubmit="@(() => _verified = false)" class="w-full max-w-sm">
            <DataAnnotationsValidator />
            <BzFieldGroup>
                <BzField Name="@nameof(VerifyModel.Code)">
                    <BzFieldLabel>Verification code</BzFieldLabel>
                    <BzFieldControl Context="ctl">
                        <BzInputOtp @bind-Value="_verify.Code" @attributes="ctl" MaxLength="6" Pattern="@InputOtpPatterns.Digits">
                            <BzInputOtpGroup>
                                <BzInputOtpSlot Index="0" />
                                <BzInputOtpSlot Index="1" />
                                <BzInputOtpSlot Index="2" />
                            </BzInputOtpGroup>
                            <BzInputOtpSeparator />
                            <BzInputOtpGroup>
                                <BzInputOtpSlot Index="3" />
                                <BzInputOtpSlot Index="4" />
                                <BzInputOtpSlot Index="5" />
                            </BzInputOtpGroup>
                        </BzInputOtp>
                    </BzFieldControl>
                    <BzFieldDescription>Enter the 6-digit code we sent you.</BzFieldDescription>
                    <BzFieldError />
                </BzField>
                <BzField Orientation="FieldOrientation.Horizontal">
                    <BzButton Type="submit">Verify</BzButton>
                    @if (_verified)
                    {
                        <span class="text-sm font-medium text-emerald-600">Verified 🎉</span>
                    }
                </BzField>
            </BzFieldGroup>
        </EditForm>
    </Demo>

    <Demo Title="Customization" Description="Restyle the slots through the input-otp-slot data slot - here a rounded indigo field with a branded active ring. Utilities win over the skin, so these take effect." Code="@CustomCode">
        <BzInputOtp MaxLength="6" Pattern="@InputOtpPatterns.Digits"
                    Class="[&_[data-slot=input-otp-slot]]:size-11 [&_[data-slot=input-otp-slot]]:rounded-md [&_[data-slot=input-otp-slot]]:border-indigo-300 [&_[data-slot=input-otp-slot]]:text-base [&_[data-slot=input-otp-slot]]:data-[active=true]:border-indigo-500 [&_[data-slot=input-otp-slot]]:data-[active=true]:ring-indigo-500/40 dark:[&_[data-slot=input-otp-slot]]:border-indigo-800">
            <BzInputOtpGroup>
                <BzInputOtpSlot Index="0" />
                <BzInputOtpSlot Index="1" />
                <BzInputOtpSlot Index="2" />
                <BzInputOtpSlot Index="3" />
                <BzInputOtpSlot Index="4" />
                <BzInputOtpSlot Index="5" />
            </BzInputOtpGroup>
        </BzInputOtp>
    </Demo>

    <Demo Title="RTL" Description="Under a right-to-left DirectionProvider the groups and slot rounding mirror and the arrow keys follow the visual order; the code still reads left-to-right within the value." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzInputOtp MaxLength="6" Pattern="@InputOtpPatterns.Digits" AriaLabel="رمز التحقق">
                <BzInputOtpGroup>
                    <BzInputOtpSlot Index="0" />
                    <BzInputOtpSlot Index="1" />
                    <BzInputOtpSlot Index="2" />
                </BzInputOtpGroup>
                <BzInputOtpSeparator />
                <BzInputOtpGroup>
                    <BzInputOtpSlot Index="3" />
                    <BzInputOtpSlot Index="4" />
                    <BzInputOtpSlot Index="5" />
                </BzInputOtpGroup>
            </BzInputOtp>
        </BzDirectionProvider>
    </Demo>

</div>

@code {
    private string? _controlled = "";
    private string? _completeValue = "";
    private bool _completed;
    private string _completeStatus = "Enter the 6-digit code.";

    private readonly VerifyModel _verify = new();
    private bool _verified;

    private void OnOtpComplete(string code)
    {
        _completed = true;
        _completeStatus = $"Code {code} submitted.";
    }

    private sealed class VerifyModel
    {
        [Required(ErrorMessage = "Please enter the code.")]
        [RegularExpression(@"\d{6}", ErrorMessage = "Enter all 6 digits.")]
        public string? Code { get; set; }
    }

    private static readonly CompositionNode _anatomy = new CompositionNode("BzInputOtp",
        new CompositionNode("BzInputOtpGroup",
            new CompositionNode("BzInputOtpSlot")),
        new CompositionNode("BzInputOtpSeparator"),
        new CompositionNode("BzInputOtpGroup",
            new CompositionNode("BzInputOtpSlot")));

