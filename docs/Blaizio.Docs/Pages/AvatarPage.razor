@page "/docs/components/avatar"
@using Blaizio.Docs.Examples.Avatar
<PageTitle>Avatar - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Avatar</h1>
        <p class="text-muted-foreground">An image element with a graceful fallback while it loads or if it fails.</p>
    </header>

    <UsageBlock Example="typeof(AvatarDefaultExample)"
                Description="Add the using once, then nest an image and a fallback. The fallback shows until the image loads or if it fails." />

    <CompositionTree Root="Anatomy"
                     Description="The full anatomy. BzAvatar wraps the image and fallback, with an optional corner badge; BzAvatarGroup overlaps several avatars and caps the overflow with a count." />

    <ExamplesHeading />

    <Demo Title="Default" Example="typeof(AvatarDefaultExample)" />

    <Demo Title="Fallback" Description="When the image is missing or fails to load, the fallback shows."
          Example="typeof(AvatarFallbackExample)" />

    <Demo Title="Sizes" Description="Use the Size prop - the style sheet scales it via data-size."
          Example="typeof(AvatarSizesExample)" />

    <Demo Title="Badge" Description="A status dot pinned to a corner, scaling with the avatar. Position picks the corner."
          Example="typeof(AvatarBadgeExample)" />

    <Demo Title="Notification count"
          Description="Turn AutoSize off, pin the badge to a corner, and size it yourself - here a red counter at the top-start corner."
          Example="typeof(AvatarCountBadgeExample)" />

    <Demo Title="Group" Description="AvatarGroup overlaps avatars; AvatarGroupCount shows the overflow."
          Example="typeof(AvatarGroupExample)" />

    <Demo Title="With tooltip"
          Description="Make the avatar itself the tooltip trigger via RenderAs - hover to see the name and role. Works standalone and inside a group; in a group, add the separation ring back via Class since the trigger takes over the avatar's slot."
          Example="typeof(AvatarTooltipExample)" />

    <Demo Title="Customization"
          Description="Restyle any part via Class - here the fallback gets a branded indigo gradient and the badge a rounded amber pill. Root-level color utilities win over the skin, so the recolor just takes."
          Example="typeof(AvatarCustomExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the avatars overlap and the overflow count sits to the right."
          Example="typeof(AvatarRtlExample)" />
</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzAvatarGroup",
        new CompositionNode("BzAvatar",
            new CompositionNode("BzAvatarImage"),
            new CompositionNode("BzAvatarFallback"),
            new CompositionNode("BzAvatarBadge")),
        new CompositionNode("BzAvatarGroupCount"));
}
