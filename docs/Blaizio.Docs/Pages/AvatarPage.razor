@page "/docs/components/avatar"
@using Blaizio.Docs.Examples.Avatar
<PageTitle>Avatar - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Avatar</h1>
            <DocBadges Slug="avatar" />
        </div>
        <p>A profile image that shows initials or an icon until the picture loads, and keeps showing them if it never does. Avatars also take a corner badge for status or counts, and <code>BzAvatarGroup</code> overlaps several of them with an overflow count.</p>
    </header>

    <UsageBlock Example="typeof(AvatarDefaultExample)"
                Description="After importing `Blaizio.Ui`, nest an image and a fallback inside the avatar. The fallback shows until the image loads, and stays if it fails." />

    <CompositionTree Root="Anatomy"
                     Description="Every part of an avatar. `BzAvatar` wraps the image, the fallback and an optional corner badge, while `BzAvatarGroup` overlaps several avatars and ends the row with `BzAvatarGroupCount`." />

    <ExamplesHeading />

    <Demo Title="Default" Example="typeof(AvatarDefaultExample)" />

    <Demo Title="Fallback" Description="When the image source is missing or fails to load, the fallback takes its place."
          Example="typeof(AvatarFallbackExample)" />

    <Demo Title="Sizes" Description="`Size` scales the avatar and everything inside it: `Sm`, `Default` or `Lg`."
          Example="typeof(AvatarSizesExample)" />

    <Demo Title="Badge" Description="`BzAvatarBadge` pins a status dot to a corner and scales with the avatar. `Position` picks the corner."
          Example="typeof(AvatarBadgeExample)" />

    <Demo Title="Notification count"
          Description="For a counter, turn `AutoSize` off and size the badge yourself through `Class`. This example pins a red count to the top-start corner."
          Example="typeof(AvatarCountBadgeExample)" />

    <Demo Title="Group" Description="`BzAvatarGroup` overlaps its avatars, and `BzAvatarGroupCount` shows how many more there are."
          Example="typeof(AvatarGroupExample)" />

    <Demo Title="With tooltip"
          Description="Use the tooltip trigger's `RenderAs` to make the avatar itself the trigger, so hovering shows the name and role. Inside a group, add the separating ring back through `Class`, because the trigger takes over the avatar's slot."
          Example="typeof(AvatarTooltipExample)" />

    <Demo Title="Customization"
          Description="Every part accepts `Class`. This example gives the fallback an indigo gradient and turns the badge into a rounded amber pill."
          Example="typeof(AvatarCustomExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, the group overlaps from the right and the overflow count moves to the left end."
          Example="typeof(AvatarRtlExample)" />
</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzAvatarGroup",
        new CompositionNode("BzAvatar",
            new CompositionNode("BzAvatarImage"),
            new CompositionNode("BzAvatarFallback"),
            new CompositionNode("BzAvatarBadge")),
        new CompositionNode("BzAvatarGroupCount"));
}
