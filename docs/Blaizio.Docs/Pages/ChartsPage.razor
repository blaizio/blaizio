@page "/charts"
@page "/charts/{Section}"
@using Blaizio.Docs.Examples.Charts
<PageTitle>Charts - Blaizio</PageTitle>

@*
    The charts gallery: one sub-page per chart family (Area / Bar / ... / Tooltips), each a grid of
    flat, ready-to-copy chart cards. Every block renders through ChartBlock - the preview and the
    code in its end-side sheet come from the same embedded example file, so they can never drift.
    Everything is the stock pieces from /docs/components/chart on the --chart-1..5 tokens.
*@
<div class="mx-auto max-w-6xl space-y-8 px-4 py-10">
    <header class="space-y-2.5">
        <h1 class="font-heading text-3xl font-bold tracking-tight">Beautiful charts, zero JavaScript</h1>
        <p class="text-muted-foreground max-w-2xl text-balance">
            Pure-SVG Blazor charts built from composable pieces, themed by your preset and skin.
            Open any card's code, copy it, then read
            <a class="text-primary hover:underline" href="docs/components/chart">the Chart component docs</a> to go further.
        </p>
    </header>

    <nav class="flex flex-wrap items-center gap-x-6 gap-y-2 border-b pb-3 text-sm" aria-label="Chart families">
        @foreach (var section in Sections)
        {
            <a href="charts/@section.Slug"
               class="@(section.Slug == ActiveSlug ? "text-foreground font-semibold" : "text-muted-foreground hover:text-foreground") no-underline">
                @section.Title
            </a>
        }
    </nav>

    <div class="grid items-start gap-x-6 gap-y-10 md:grid-cols-2">
        @foreach (var block in Active.Blocks)
        {
            <div class="@(block.Wide ? "md:col-span-2" : null) min-w-0">
                <ChartBlock Title="@block.Title" Example="block.Example" />
            </div>
        }
    </div>
</div>

@code {
    /// <summary>The active family slug from the route; defaults to area.</summary>
    [Parameter] public string? Section { get; set; }

    private sealed record Block(string Title, Type Example, bool Wide = false);
    private sealed record Family(string Slug, string Title, Block[] Blocks);

    private static readonly Family[] Sections =
    [
        new("area", "Area Charts",
        [
            new("Area Chart - Interactive", typeof(AreaChartInteractiveExample), Wide: true),
            new("Area Chart", typeof(AreaChartExample)),
            new("Area Chart - Linear", typeof(AreaChartLinearExample)),
            new("Area Chart - Stacked", typeof(AreaChartStackedExample)),
            new("Area Chart - Legend", typeof(AreaChartLegendExample)),
        ]),
        new("bar", "Bar Charts",
        [
            new("Bar Chart", typeof(BarChartExample)),
            new("Bar Chart - Multiple", typeof(BarChartMultipleExample)),
            new("Bar Chart - Stacked", typeof(BarChartStackedExample)),
            new("Bar Chart - Negative", typeof(BarChartNegativeExample)),
        ]),
        new("line", "Line Charts",
        [
            new("Line Chart", typeof(LineChartExample)),
            new("Line Chart - Curved", typeof(LineChartCurvedExample)),
            new("Line Chart - Multiple", typeof(LineChartMultipleExample)),
        ]),
        new("scatter", "Scatter Charts",
        [
            new("Scatter Chart", typeof(ScatterChartExample)),
        ]),
        new("pie", "Pie Charts",
        [
            new("Pie Chart", typeof(PieChartExample)),
            new("Pie Chart - Donut with Text", typeof(PieChartDonutTextExample)),
            new("Pie Chart - Legend", typeof(PieChartLegendExample)),
        ]),
        new("radar", "Radar Charts",
        [
            new("Radar Chart", typeof(RadarChartExample)),
            new("Radar Chart - Multiple", typeof(RadarChartMultipleExample)),
        ]),
        new("radial", "Radial Charts",
        [
            new("Radial Bar Chart", typeof(RadialBarChartExample)),
            new("Radial Chart - Progress", typeof(RadialChartProgressExample)),
            new("Radial Chart - Text", typeof(RadialChartTextExample)),
        ]),
        new("tooltip", "Tooltips & Legend",
        [
            new("Tooltip - Default", typeof(TooltipDefaultExample)),
            new("Tooltip - Formatter", typeof(TooltipFormatterExample)),
            new("Tooltip - Custom", typeof(TooltipCustomExample)),
            new("Legend - Custom Icons", typeof(LegendIconsExample)),
        ]),
    ];

    private string ActiveSlug =>
        Sections.Any(s => s.Slug == Section) ? Section! : Sections[0].Slug;

    private Family Active => Sections.First(s => s.Slug == ActiveSlug);
}
