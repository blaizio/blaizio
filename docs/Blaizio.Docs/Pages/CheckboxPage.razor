@page "/docs/components/checkbox"
@using Blaizio.Docs.Examples.Checkbox
<PageTitle>Checkbox - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Checkbox</h1>
        <p class="text-muted-foreground">A box that can be checked, unchecked, or indeterminate.</p>
    </header>

    <UsageBlock Example="typeof(CheckboxDefaultExample)" Description="Pair with a Label, associated by id." />

    <ExamplesHeading />

    <Demo Title="Default" Description="Pair with a Label, associated by id." Example="typeof(CheckboxDefaultExample)" />

    <Demo Title="States" Description="Unchecked, checked, and indeterminate." Example="typeof(CheckboxStatesExample)" />

    <Demo Title="Status colors" Description="Color repaints the checked fill with a status token." Example="typeof(CheckboxColorsExample)" />

    <Demo Title="Disabled" Example="typeof(CheckboxDisabledExample)" />

    <Demo Title="Controlled" Description="Bind the tri-state value two-way." Example="typeof(CheckboxControlledExample)" />

    <Demo Title="Customization"
          Description="Recolor the checked state with data-checked: utilities - they win over the variant default."
          Example="typeof(CheckboxCustomExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the box and its label mirror to the right." Example="typeof(CheckboxRtlExample)" />
</div>

