    private const string ControlledCode = """
        <BzButton @onclick="@(() => _tree!.ExpandAllAsync())">Expand all</BzButton>
        <BzButton @onclick="@(() => _tree!.CollapseAllAsync())">Collapse all</BzButton>

        <BzTree TItem="TreeItem" Items="_explorer" ValueSelector="@(n => n.Id)"
                TextSelector="@(n => n.Name)" ChildrenSelector="@(n => n.Children)"
                @bind-ExpandedValues="_expanded" @ref="_tree" />
        <p>Expanded: @string.Join(", ", _expanded.Order())</p>

        @code {
            private BzTree<TreeItem>? _tree;
            private IReadOnlyList<string> _expanded = ["src"];
        }
        """;

    private const string RenameCode = """
        <BzTree TItem="TreeItem"
                Items="_notes"
                ValueSelector="@(n => n.Id)"
                TextSelector="@(n => n.Name)"
                ChildrenSelector="@(n => n.Children)"
                DefaultExpandedValues="@(new[] { "inbox" })"
                Renamable="true"
                CanRename="@(n => n.Id != "inbox")"
                OnRename="HandleRename" />

        @code {
            private readonly List<TreeItem> _notes =
            [
                Folder("inbox", "Inbox", File("groceries", "Groceries"), File("ideas", "Ideas")),
                File("scratch", "Scratchpad"),
            ];

            private void HandleRename(TreeRename<TreeItem> rename) => rename.Item.Name = rename.Text;
        }
        """;

