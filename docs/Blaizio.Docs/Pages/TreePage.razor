@page "/docs/components/tree"
@using Blaizio.Docs.Examples.Tree
<PageTitle>Tree - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Tree</h1>
            <DocBadges Slug="tree" />
        </div>
        <p class="text-muted-foreground">A hierarchical tree view (the WAI-ARIA treeview pattern) driven by your own data: expand and collapse branches, select nodes (single or multiple, with Ctrl and Shift), tri-state checkboxes, lazy loading, F2 rename, full keyboard navigation with typeahead - and drag-and-drop to reorder, reparent, or hand nodes to another tree, by pointer or entirely by keyboard. Every committed drop is reported as a <span class="font-mono text-sm">TreeChange</span> you apply to your own data.</p>
    </header>

    <UsageBlock Example="typeof(TreeUsageExample)"
                Description="Bind Items plus a ValueSelector (and a ChildrenSelector for nesting). The tree renders the hierarchy itself; expansion, selection and checks are all bindable value lists. Every example below uses this TreeItem class and its File/Folder helpers." />

    <CompositionTree Root="Anatomy"
                     Description="One component, data-driven: each branch renders a focusable treeitem wrapping its row and children group; each leaf is a single row. The data-part attributes are the styling contract." />

    <ExamplesHeading />

    <Demo Title="Default" Description="A file explorer. Click a branch row (or its chevron) to expand it; click any row to select it. With the keyboard: Tab in, Up/Down move, Right expands and enters, Left collapses and climbs, Home/End jump, Enter selects, letters jump by name, * expands siblings." Example="typeof(TreeDefaultExample)" />

    <Demo Title="Expand on click" Description="By default clicking anywhere on a branch row both selects it and toggles its expansion. Set ExpandOnClick=false to reserve expansion for the chevron: clicking a row only selects it, so selecting and expanding stay two separate gestures. The keyboard splits the same way - Enter (and Space) only select, while ArrowRight and ArrowLeft still expand and collapse, so every node stays reachable without a pointer." Example="typeof(TreeExpandOnClickExample)" />

    <Demo Title="Multiple selection" Description="SelectionMode=Multiple: a plain click (or Enter) replaces the selection, Ctrl+Click toggles a node, Shift+Click selects the visible range, Ctrl+A grabs everything. Fully keyboard-driven non-adjacent selection: move with the arrows and press Space on each node you want to toggle in or out." Example="typeof(TreeMultipleExample)" />

    <Demo Title="Checkboxes" Description="Checkable adds a tri-state checkbox to every node. The bound list holds the checked LEAF values; a branch derives its state from its subtree (all / some / none) and checking a branch toggles the whole subtree. Keyboard: navigate with the arrows and press Space to toggle the focused node's check." Example="typeof(TreeCheckboxExample)" />

    <Demo Title="Custom node template" Description="NodeTemplate replaces the default text with your own row content - it receives the node's full state (item, depth, expansion, selection, check, loading). The chevron and checkbox stay put; everything after them is yours. Here each row gets a file icon, a Badge with the child count, and a per-node Dropdown Menu: shared actions for every node, plus items tailored to it (New file on folders, Download on files). The wrapper around the menu stops clicks and keys from reaching the row, so opening it never selects or moves focus in the tree." Example="typeof(TreeTemplateExample)" />

    <Demo Title="Lazy loading" Description="Mark unloaded branches with HasChildrenSelector and supply LoadChildren - it runs on first expansion (the chevron becomes a spinner, the row gets aria-busy) and the result is cached. Expand a planet - by click or ArrowRight - to fetch its moons." Example="typeof(TreeLazyExample)" />

    <Demo Title="Drag and drop" Description="Draggable=true lets any row be picked up. Pointer: drop on a row's top/bottom edge to place before/after it, or on the middle of a branch to drop inside (hovering a collapsed branch auto-expands it). Keyboard: Ctrl+Space grabs the focused node, Up/Down move it past its neighbours, Right drops it into the branch above, Left pulls it out to its parent's level, Ctrl+Space or Enter drop it, Escape releases. CanDrag pins index.html in place - note it shows no grab cursor and refuses the grab." Example="typeof(TreeDragExample)" />

    <Demo Title="Drag between trees" Description="Give two trees the same Group and drag nodes across (pointer). The source tree raises OnMove and the receiver raises OnReceive; each tree carries an Id so one handler can resolve both sides and apply the change with the two-list overload." Example="typeof(TreeCrossTreeExample)" />

    <Demo Title="Controlled expansion" Description="ExpandedValues is a bindable list, and the component exposes an imperative API (ExpandAllAsync, CollapseAllAsync, ExpandAsync, FocusNodeAsync, ...) via a component reference. The tree itself stays fully keyboard-operable; the buttons are just another way in." Example="typeof(TreeControlledExample)" />

    <Demo Title="Rename" Description="Renamable=true enables rename on every node - press F2 on a focused row, or double-click it: an inline input replaces the text; Enter (or clicking away) commits and raises OnRename, Escape cancels. CanRename carves out per-node exceptions - here the Inbox folder keeps its name (double-clicking it just toggles it open)." Example="typeof(TreeRenameExample)" />

    <Demo Title="Disabled nodes" Description="DisabledSelector pins individual nodes: they stay visible and focusable (arrow keys still reach them, so screen-reader users still hear them) but can't be selected, checked, dragged, or expanded. Disabled on the tree switches everything off." Example="typeof(TreeDisabledExample)" />

    <Demo Title="Search" Description="Searchable adds a filter box above the tree. As you type, it keeps only the matching nodes plus the folders leading to them, opens those folders automatically, and highlights the hits; clearing the box restores the tree and your own expansion. Filtering is a view over the data, so state survives it - here the checkboxes: tick a few files, search to hide them, and they are still ticked when you clear or when a branch's derived state is recomputed. Bind Search to drive it yourself, or pass SearchMatch for custom matching. Try 'razor' or 'program'." Example="typeof(TreeSearchExample)" />

    <Demo Title="Virtualization" Description="For very long trees, Virtualize renders only the rows in (and just around) the scroll viewport - roughly a couple of dozen - over spacer blocks that stand in for the rest, so the DOM stays tiny however many nodes there are. This tree holds 1,000 nodes; scroll it and the DOM row count barely moves. Keyboard navigation still reaches every node (the focused row is always rendered) and the search box filters the whole set. Give the tree a fixed height and overflow. Because the window drops off-screen rows, it enforces its constraints: it can't be combined with Draggable (that throws), rows must stay a uniform ItemSize (a mismatch throws once measured), and guides fall back to indentation automatically." Example="typeof(TreeVirtualExample)" />

    <Demo Title="Guide lines" Description="Guides picks how the hierarchy is drawn. None relies on indentation alone; Lines (the default) runs a straight vertical guide along each branch's children; Connectors completes the picture - the guide stops at the last child and each row gets a horizontal run off it, rounded at the joint and ending a small gap short of the row." Example="typeof(TreeGuidesExample)" />

    <Demo Title="Customization" Description="The look is not tied to the theme tokens - every part takes plain Tailwind classes. Here a neutral slate container carries one blue accent used consistently: a soft blue hover and keyboard-focus tint, a solid blue selected row, and slate guide lines. Indent widens the per-level offset. None of these colours come from the theme palette." Example="typeof(TreeCustomExample)" />

    <Demo Title="Marquee labels"
          Description="Marquee makes truncated labels reveal themselves: a name that overflows into an ellipsis slides its hidden tail into view while hovered, then slides back. Labels that fit are never touched, and reduced-motion users get an instant reveal instead of the slide."
          Example="typeof(TreeMarqueeExample)" />

    <Demo Title="RTL" Description="Set Dir=Rtl (or inherit it from an ancestor direction provider) and the whole tree mirrors: indentation grows from the right, the guide lines and chevron flip, and ArrowLeft/ArrowRight swap roles for expanding and collapsing. Templates mirror with it - the icons here need no extra work." Example="typeof(TreeRtlExample)" />
</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzTree",
        new CompositionNode("branch (treeitem)",
            new CompositionNode("branch-control (row)",
                new CompositionNode("indicator"),
                new CompositionNode("checkbox"),
                new CompositionNode("text / NodeTemplate")),
            new CompositionNode("branch-content (group)",
                new CompositionNode("… nested branches and items"))),
        new CompositionNode("item (leaf row)"));
}
