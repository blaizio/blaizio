    private const string CrossTreeCode = """
        <BzTree TItem="TreeItem" Id="workspace" Group="library" Items="_workspace"
                ValueSelector="@(n => n.Id)" TextSelector="@(n => n.Name)"
                ChildrenSelector="@(n => n.Children)" Draggable="true"
                DefaultExpandedValues="@(new[] { "campaign" })" OnMove="HandleLibraryMove" />

        <BzTree TItem="TreeItem" Id="archive" Group="library" Items="_archive"
                ValueSelector="@(n => n.Id)" TextSelector="@(n => n.Name)"
                ChildrenSelector="@(n => n.Children)" Draggable="true"
                DefaultExpandedValues="@(new[] { "old" })" OnMove="HandleLibraryMove" />

        @code {
            private readonly List<TreeItem> _workspace =
            [
                Folder("campaign", "Campaign 2026",
                    File("brief", "brief.docx"), File("hero", "hero.png"), File("social", "social.mp4")),
                File("logo", "logo.svg"),
            ];

            private readonly List<TreeItem> _archive =
            [
                Folder("old", "2025", File("retro", "retro-deck.pptx")),
            ];

            // The source tree raises OnMove for every drop; resolve both sides by id.
            private void HandleLibraryMove(TreeChange change)
            {
                var source = change.FromId == "workspace" ? _workspace : _archive;
                var target = change.ToId == "workspace" ? _workspace : _archive;
                change.Apply(source, target, n => n.Children, n => n.Id);
            }
        }
        """;

