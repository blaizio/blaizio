@page "/docs/components/pagination"
@using Blaizio.Docs.Examples.Pagination
<PageTitle>Pagination - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Pagination</h1>
        <p class="text-muted-foreground">
            Steps through pages of content. Compose the parts - <code class="bz-code">PaginationContent</code>,
            <code class="bz-code">PaginationItem</code>, <code class="bz-code">PaginationLink</code>,
            <code class="bz-code">PaginationFirst</code>/<code class="bz-code">Last</code>,
            <code class="bz-code">PaginationPrevious</code>/<code class="bz-code">Next</code> and
            <code class="bz-code">PaginationEllipsis</code> - and drive the page state yourself. Use
            <code class="bz-code">Href</code> for URL paging or <code class="bz-code">OnClick</code> for in-place paging.
            <code class="bz-code">BzDataTable&lt;TItem&gt;</code> wires this up for you via <code class="bz-code">PageSize</code>.
        </p>
    </header>

    <UsageBlock Example="typeof(PaginationUsageExample)"
                Description="Add the using once, then compose the content with items. Mark the current page with Active and stand a gap in with an ellipsis." />

    <CompositionTree Root="Anatomy"
                     Description="The full anatomy. Each control sits in its own item; PaginationPrevious/Next are PaginationLinks with a chevron and label, and the ellipsis fills a gap." />

    <ExamplesHeading />

    <Demo Title="Default" Description="The active page is marked with Active (aria-current=page) and gaps collapse to an ellipsis. Drive it in place with OnClick - or swap to Href for URL paging (e.g. products?page=2)."
          Example="typeof(PaginationDefaultExample)" />

    <Demo Title="Routed links (RenderAs)"
          Description="Render each link onto a Blazor NavLink via RenderAs, so the router owns navigation and the active styling."
          Example="typeof(PaginationRenderAsExample)" />

    <Demo Title="Simple" Description="A bare previous/next pager - no page-number links, just the two controls flanking a page indicator. Good for feeds and infinite-ish lists where the exact page count doesn't matter."
          Example="typeof(PaginationSimpleExample)" />

    <Demo Title="Icons only" Description="Drop the Previous/Next labels and let the chevrons stand alone - each is a PaginationLink with just an icon, so it renders as a square button. Keep an AriaLabel so the control is still announced."
          Example="typeof(PaginationIconsOnlyExample)" />

    <Demo Title="Controlled" Description="Drive the current page with state and OnClick (no navigation). Previous/Next disable at the ends; the window around the current page slides, with ellipses standing in for the gaps."
          Example="typeof(PaginationControlledExample)" />

    <Demo Title="First and last" Description="Add First and Last controls to jump straight to either end. Both carry a double-chevron that mirrors under RTL; First and Previous disable on the first page, Next and Last on the last."
          Example="typeof(PaginationFirstLastExample)" />

    <Demo Title="Rows per page" Description="A data-grid footer - a rows-per-page Select drives the page size and a previous/next pager steps through. The listbox uses item-aligned positioning, so it overlays the trigger like a native select. Changing the size returns to the first page."
          Example="typeof(PaginationRowsPerPageExample)" />

    <Demo Title="Custom labels" Description="Every bit of copy is a parameter - rename the rows-per-page label and pass Label (and AriaLabel) to Previous/Next. Use this to localize the pager or word it for your domain."
          Example="typeof(PaginationCustomLabelsExample)" />

    <Demo Title="Customization"
          Description="Restyle any part via Class - here the links become rounded-full pills with a wider gap and an indigo active page. Utilities win over the skin, so the data-active override takes effect."
          Example="typeof(PaginationCustomExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the bar lays out right-to-left and the previous/next chevrons mirror. Arabic uses the same 1 2 3 digits as English."
          Example="typeof(PaginationRtlExample)" />

</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzPagination",
        new CompositionNode("BzPaginationContent",
            new CompositionNode("BzPaginationItem",
                new CompositionNode("BzPaginationFirst")),
            new CompositionNode("BzPaginationItem",
                new CompositionNode("BzPaginationPrevious")),
            new CompositionNode("BzPaginationItem",
                new CompositionNode("BzPaginationLink")),
            new CompositionNode("BzPaginationItem",
                new CompositionNode("BzPaginationEllipsis")),
            new CompositionNode("BzPaginationItem",
                new CompositionNode("BzPaginationNext")),
            new CompositionNode("BzPaginationItem",
                new CompositionNode("BzPaginationLast"))));
}
