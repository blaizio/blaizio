@page "/docs/components/pagination"
@using Blaizio.Docs.Examples.Pagination
<PageTitle>Pagination - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Pagination</h1>
            <DocBadges Slug="pagination" />
        </div>
        <p>
            A set of composable parts for page navigation, where your page owns the current page
            and decides which links to show. Each link takes <code>Href</code> for URL paging or
            <code>OnClick</code> for paging in place. If you are paging a
            <code>BzDataTable&lt;TItem&gt;</code>, set its <code>PageSize</code> and the table
            wires up pagination for you.
        </p>
    </header>

    <UsageBlock Example="typeof(PaginationUsageExample)"
                Description="After importing `Blaizio.Ui`, compose the content from items. Mark the current page with `Active` and fill gaps with an ellipsis." />

    <CompositionTree Root="Anatomy"
                     Description="Every part of the pager. Each control sits in its own item. `PaginationPrevious` and `PaginationNext` are links with a chevron and a label, and the ellipsis fills a gap." />

    <ExamplesHeading />

    <Demo Title="Default" Description="`Active` marks the current page and sets `aria-current=&quot;page&quot;` on it. This example pages in place with `OnClick`; swap in `Href` for URL paging such as `products?page=2`."
          Example="typeof(PaginationDefaultExample)" />

    <Demo Title="Routed links (RenderAs)"
          Description="Use `RenderAs` to render each link as a Blazor `NavLink`, so the router handles navigation and the active styling."
          Example="typeof(PaginationRenderAsExample)" />

    <Demo Title="Simple" Description="A previous and next pager around a page indicator, with no page-number links. It suits feeds and open-ended lists where the exact page count doesn't matter."
          Example="typeof(PaginationSimpleExample)" />

    <Demo Title="Icons only" Description="Without their labels, the previous and next links render as square buttons holding only a chevron. Keep an `AriaLabel` on each so screen readers can still announce them."
          Example="typeof(PaginationIconsOnlyExample)" />

    <Demo Title="Controlled" Description="The current page lives in a field and changes through `OnClick`, with no navigation. Previous and next disable at the ends, and the window of page numbers slides along with ellipses standing in for the gaps."
          Example="typeof(PaginationControlledExample)" />

    <Demo Title="First and last" Description="Add `PaginationFirst` and `PaginationLast` to jump straight to either end. First and previous disable on the first page, next and last on the final one."
          Example="typeof(PaginationFirstLastExample)" />

    <Demo Title="Rows per page" Description="A data grid footer where a rows-per-page select sets the page size and a previous and next pager steps through the rows. Changing the size returns to the first page."
          Example="typeof(PaginationRowsPerPageExample)" />

    <Demo Title="Custom labels" Description="All of the pager's text comes from parameters, so you can localize it or word it for your domain. Here the rows-per-page label is renamed and previous and next receive their own `Label` and `AriaLabel`."
          Example="typeof(PaginationCustomLabelsExample)" />

    <Demo Title="Customization"
          Description="Every part accepts `Class`. This example turns the links into pills with a wider gap and gives the current page an indigo fill through a `data-active` utility."
          Example="typeof(PaginationCustomExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, the pages run from right to left and the previous and next chevrons flip to point the other way."
          Example="typeof(PaginationRtlExample)" />

</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzPagination",
        new CompositionNode("BzPaginationContent",
            new CompositionNode("BzPaginationItem",
                new CompositionNode("BzPaginationFirst")),
            new CompositionNode("BzPaginationItem",
                new CompositionNode("BzPaginationPrevious")),
            new CompositionNode("BzPaginationItem",
                new CompositionNode("BzPaginationLink")),
            new CompositionNode("BzPaginationItem",
                new CompositionNode("BzPaginationEllipsis")),
            new CompositionNode("BzPaginationItem",
                new CompositionNode("BzPaginationNext")),
            new CompositionNode("BzPaginationItem",
                new CompositionNode("BzPaginationLast"))));
}
