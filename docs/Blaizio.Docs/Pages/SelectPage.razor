@page "/docs/components/select"
@using Blaizio.Docs.Examples.Select
<PageTitle>Select - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Select</h1>
            <DocBadges Slug="select" />
        </div>
        <p>Pick a single value from a list, positioned with <a class="font-medium text-foreground" href="https://floating-ui.com" target="_blank" rel="noopener">Floating UI</a>. The listbox opens on the current choice and supports full keyboard control - arrow keys, Home/End, type-ahead, Enter/Space to pick, Escape to close. Bind the chosen value with <code>@@bind-Value</code>. It is <strong>non-modal</strong>: the rest of the page stays interactive while it is open.</p>
    </header>

    <UsageBlock Example="typeof(SelectUsageExample)"
                Description="Add the using once, then compose a trigger with a value placeholder and a content panel of items. Two-way bind the choice to a string. Name the trigger: a combobox takes no name from its value text, so give it an AriaLabel (what is being chosen), point AriaLabelledBy at a visible label, or pair it with a Label whose For matches the trigger id." />

    <CompositionTree Root="Anatomy"
                     Description="The full anatomy. Wrap items in a group under a label, separate sections with a separator, and show the chosen value in the trigger via BzSelectValue." />

    <ExamplesHeading />

    <Demo Title="Default" Description="A single group of options with a placeholder. Open it and pick a value with the pointer or the keyboard - the trigger then shows your choice." Example="typeof(SelectDefaultExample)" />

    <Demo Title="Grouped &amp; scrollable" Description="Options split into labelled groups with separators. A list taller than the room below the trigger caps its height to the viewport and scrolls (a thin scrollbar); type-ahead and the arrow keys still reach every option, scrolling it into view." Example="typeof(SelectScrollableExample)" />

    <Demo Title="Scroll buttons" Description="Scroll=Buttons swaps the scrollbar for an up and a down chevron - each hides at its end of the list, and hovering one auto-scrolls (the native select feel). The height is capped here so the buttons appear." Example="typeof(SelectScrollButtonsExample)" />

    <Demo Title="Sizes" Description="Two trigger heights via the Size parameter - the default and a more compact sm for dense layouts." Example="typeof(SelectSizesExample)" />

    <Demo Title="Disabled" Description="Disabled on an option skips it for pointer and keyboard; Disabled on the select itself renders the trigger inert and keeps the listbox closed." Example="typeof(SelectDisabledExample)" />

    <Demo Title="Preselected" Description="A value set up front (DefaultValue, or a bound value) shows in the trigger straight away - before the listbox has ever been opened - and is highlighted when you open it." Example="typeof(SelectPreselectedExample)" />

    <Demo Title="Controlled" Description="Drive the value yourself with two-way binding. The live selection is shown above, and a button clears it." Example="typeof(SelectControlledExample)" />

    <Demo Title="Validation in an EditForm" Description="Wrap the SelectTrigger in a FieldControl and it joins the Field's validation - the wrapper hands the trigger the field's id, aria-describedby, and (when invalid) aria-invalid, which turns it destructive. DataAnnotations here, validated on submit." Example="typeof(SelectValidationEditFormExample)" />

    <Demo Title="Validation without EditForm" Description="No EditForm needed - drive the Error string yourself and the field (and its trigger) turn destructive live as the value changes." Example="typeof(SelectValidationStandaloneExample)" />

    <Demo Title="Align item with trigger" Description="With Position=ItemAligned the listbox opens OVER the trigger so the selected option sits directly on top of it - the native select feel - and it appears instantly (no open animation) so it feels snappy. Popper instead floats in below or above with a fade. Flip the switch to compare; it is preselected, so opening lines the highlighted option up with the trigger (near a screen edge the list scrolls to keep it aligned). The trigger's chevron adapts too - an up/down selector for item-aligned, a chevron that rotates up-on-open for popper." Example="typeof(SelectItemAlignedExample)" />

    <Demo Title="Custom chevron" Description="Swap the trailing chevron with the trigger's Icon parameter, or replace it entirely with a Chevron template (pass an empty Chevron to hide it)." Example="typeof(SelectChevronExample)" />

    <Demo Title="Multiple" Description="Set SelectionMode to Multiple to pick several values, two-way bound as a list of values. Each choice shows as a removable badge in the trigger (the ✕ deselects it); picking toggles an option and leaves the listbox open, and the checks mark every chosen option." Example="typeof(SelectMultipleExample)" />

    <Demo Title="Token overflow" Description="When the badges outgrow the trigger, Overflow on SelectValue decides what happens. Count (the default) keeps the trigger one line tall and shows a +N counter before the chevron; Wrap lets the badges flow onto more lines, growing the trigger. Both fields below bind the same list, so a change in one shows in the other." Example="typeof(SelectOverflowExample)" />

    <Demo Title="Custom tokens" Description="Pass a Tokens template on SelectValue to render the selection your own way - here as outline badges with a status dot. The template receives the selected options and a remove callback to wire onto your own control." Example="typeof(SelectCustomTokensExample)" />

    <Demo Title="Looping" Description="Inside the open listbox the arrow keys wrap from the last option back to the first by default. Set Loop to false on the content to stop at the ends instead. Open it and hold an arrow key to compare with the selects above." Example="typeof(SelectLoopExample)" />

    <Demo Title="Customization"
          Description="Restyle any part via Class - a brand-tinted trigger, a content panel with a custom radius and tint, and a branded highlight on each option (focus:bg-indigo-600). Utilities win over the skin, so these take effect." Example="typeof(SelectCustomExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic or Hebrew copy - the trigger's icon and the option checkmarks mirror to the other side, and the listbox aligns from the right." Example="typeof(SelectRtlExample)" />

</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzSelect",
        new CompositionNode("BzSelectTrigger",
            new CompositionNode("BzSelectValue")),
        new CompositionNode("BzSelectContent",
            new CompositionNode("BzSelectGroup",
                new CompositionNode("BzSelectLabel"),
                new CompositionNode("BzSelectItem")),
            new CompositionNode("BzSelectSeparator")));
}
