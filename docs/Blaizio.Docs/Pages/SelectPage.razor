    private const string OverflowCode = """
        @* Count (default): one line tall, a +N counter before the chevron. *@
        <BzSelect Multiple @bind-Values="_langs">
            <BzSelectTrigger Class="w-60">
                <BzSelectValue Placeholder="Select languages" Overflow="SelectTokenOverflow.Count" />
            </BzSelectTrigger>
            <BzSelectContent>
                @foreach (var lang in _languages)
                {
                    <BzSelectItem Value="@lang">@lang</BzSelectItem>
                }
            </BzSelectContent>
        </BzSelect>

        @* Wrap: badges flow onto more lines, growing the trigger. *@
        <BzSelect Multiple @bind-Values="_langs">
            <BzSelectTrigger Class="w-60">
                <BzSelectValue Placeholder="Select languages" Overflow="SelectTokenOverflow.Wrap" />
            </BzSelectTrigger>
            <BzSelectContent>
                @foreach (var lang in _languages)
                {
                    <BzSelectItem Value="@lang">@lang</BzSelectItem>
                }
            </BzSelectContent>
        </BzSelect>

        @code {
            private IReadOnlyList<string> _langs = ["C#", "TypeScript", "Rust", "Go"];
            private static readonly string[] _languages =
                ["C#", "TypeScript", "Rust", "Go", "Python", "Java", "Kotlin", "Swift", "Ruby", "Elixir"];
