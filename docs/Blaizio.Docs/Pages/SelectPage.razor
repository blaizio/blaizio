@page "/docs/components/select"
@using Blaizio.Docs.Examples.Select
<PageTitle>Select - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Select</h1>
            <DocBadges Slug="select" />
        </div>
        <p>A styled listbox for one value or several, positioned with <a class="font-medium text-foreground" href="https://floating-ui.com" target="_blank" rel="noopener">Floating UI</a> and bound with <code>@@bind-Value</code>. It opens on the current choice and supports full keyboard control: arrow keys, Home and End, type-ahead, Enter or Space to pick, and Escape to close. It is <strong>non-modal</strong>, so the rest of the page stays interactive while it is open.</p>
    </header>

    <UsageBlock Example="typeof(SelectUsageExample)"
                Description="After importing `Blaizio.Ui`, compose a trigger with a value placeholder and a content panel of items, and bind the choice to a string. A combobox takes no name from its value text, so name the trigger with an `AriaLabel`, point `AriaLabelledBy` at a visible label, or pair it with a `Label` whose `For` matches the trigger id." />

    <CompositionTree Root="Anatomy"
                     Description="Every part of a select. Items go in groups under a label, a separator divides sections, and `BzSelectValue` shows the chosen value in the trigger." />

    <ExamplesHeading />

    <Demo Title="Default" Description="A single group of options with a placeholder. Pick a value with the pointer or the keyboard and the trigger shows your choice." Example="typeof(SelectDefaultExample)" />

    <Demo Title="Grouped &amp; scrollable" Description="Options split into labeled groups with separators. When the list is taller than the space available, its height is capped to the viewport and it scrolls, while type-ahead and the arrow keys still reach every option and scroll it into view." Example="typeof(SelectScrollableExample)" />

    <Demo Title="Scroll buttons" Description="Set `Scroll` to `Buttons` to replace the scrollbar with up and down chevrons, like a native select. Each one hides at its end of the list, and hovering it scrolls automatically. The height is capped here so the buttons appear." Example="typeof(SelectScrollButtonsExample)" />

    <Demo Title="Sizes" Description="`Size` offers two trigger heights: the default and a compact `Sm` for dense layouts." Example="typeof(SelectSizesExample)" />

    <Demo Title="Disabled" Description="Set `Disabled` on an option to skip it for pointer and keyboard. On the select itself, `Disabled` makes the trigger inert and keeps the listbox closed." Example="typeof(SelectDisabledExample)" />

    <Demo Title="Preselected" Description="A value set up front through `DefaultValue` or a binding shows in the trigger straight away, before the listbox has ever opened, and is highlighted when you open it." Example="typeof(SelectPreselectedExample)" />

    <Demo Title="Controlled" Description="Bind the value to a field when your page needs to read or change it. The current selection is shown above, and a button clears it." Example="typeof(SelectControlledExample)" />

    <Demo Title="Validation in an EditForm" Description="Wrap the trigger in a `FieldControl` to join the field's validation. The wrapper gives the trigger the field's id, `aria-describedby` and, when invalid, `aria-invalid`, which turns it destructive. This example validates data annotations on submit." Example="typeof(SelectValidationEditFormExample)" />

    <Demo Title="Validation without EditForm" Description="Without an `EditForm`, set the field's `Error` string yourself and the field and its trigger turn destructive as the value changes." Example="typeof(SelectValidationStandaloneExample)" />

    <Demo Title="Align item with trigger" Description="With `Position` set to `ItemAligned`, the listbox opens over the trigger without animation, so the selected option sits right on top of it like a native select. `Popper` fades in below or above instead. Flip the switch to compare the two, including the different chevrons." Example="typeof(SelectItemAlignedExample)" />

    <Demo Title="Custom chevron" Description="Swap the trailing chevron through the trigger's `Icon` parameter, or replace it entirely with a `Chevron` template. An empty `Chevron` hides it." Example="typeof(SelectChevronExample)" />

    <Demo Title="Multiple" Description="Set `SelectionMode` to `Multiple` to bind a list of values. Picking an option toggles it and leaves the listbox open, and each choice shows as a removable badge in the trigger." Example="typeof(SelectMultipleExample)" />

    <Demo Title="Token overflow" Description="When the badges outgrow the trigger, `Overflow` on `BzSelectValue` decides what happens. `Count`, the default, keeps the trigger one line tall with a +N counter, while `Wrap` lets the badges flow onto more lines. Both fields bind the same list, so a change in one shows in the other." Example="typeof(SelectOverflowExample)" />

    <Demo Title="Custom tokens" Description="Pass a `Tokens` template to `BzSelectValue` to render the selection your own way, here as outline badges with a status dot. The template receives the selected options and a remove callback for your own control." Example="typeof(SelectCustomTokensExample)" />

    <Demo Title="Looping" Description="By default the arrow keys wrap from the last option back to the first. Set `Loop` to `false` on the content to stop at the ends instead." Example="typeof(SelectLoopExample)" />

    <Demo Title="Customization"
          Description="Every part accepts `Class`. This example tints the trigger, gives the panel a custom radius and tint, and highlights options with `focus:bg-indigo-600`." Example="typeof(SelectCustomExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, the trigger's icon and the option checkmarks flip to the opposite side, and the listbox aligns from the right." Example="typeof(SelectRtlExample)" />

</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzSelect",
        new CompositionNode("BzSelectTrigger",
            new CompositionNode("BzSelectValue")),
        new CompositionNode("BzSelectContent",
            new CompositionNode("BzSelectGroup",
                new CompositionNode("BzSelectLabel"),
                new CompositionNode("BzSelectItem")),
            new CompositionNode("BzSelectSeparator")));
}
