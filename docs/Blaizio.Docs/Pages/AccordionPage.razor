@page "/components/accordion"
<PageTitle>Accordion - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Accordion</h1>
        <p class="text-muted-foreground">Vertically stacked sections that expand one (or many) at a time.</p>
    </header>

    <UsageBlock Setup="@UsageSetup" Code="@UsageMarkup"
                Description="Add the using once, then compose items - each pairs a trigger (the header) with content. Set DefaultValue and Collapsible to start one section open and let it close again." />

    <CompositionTree Root="_anatomy"
                     Description="The full anatomy. The accordion holds items; each item pairs a trigger (the heading button, with its built-in chevron) and a content panel." />

    <ExamplesHeading />

    <Demo Title="Default" Description="Single mode with Collapsible - pressing the open header closes it. Height animates to the measured content." Code="@DefaultCode">
        <BzAccordion DefaultValue="item-1" Collapsible Class="w-full max-w-md">
            <BzAccordionItem Value="item-1">
                <BzAccordionTrigger>Is it accessible?</BzAccordionTrigger>
                <BzAccordionContent>Yes. It follows the WAI-ARIA accordion pattern: a heading-wrapped button wired to its region.</BzAccordionContent>
            </BzAccordionItem>
            <BzAccordionItem Value="item-2">
                <BzAccordionTrigger>Is it styled?</BzAccordionTrigger>
                <BzAccordionContent>Yes. All eight Blaizio styles skin it - switch the style above to compare.</BzAccordionContent>
            </BzAccordionItem>
            <BzAccordionItem Value="item-3">
                <BzAccordionTrigger>Is it animated?</BzAccordionTrigger>
                <BzAccordionContent>Yes. The open and close animate to the panel's measured height.</BzAccordionContent>
            </BzAccordionItem>
        </BzAccordion>
    </Demo>

    <Demo Title="Multiple" Description="Any number of sections open at once." Code="@MultipleCode">
        <BzAccordion Type="AccordionType.Multiple" DefaultValues="@(["a", "b"])" Class="w-full max-w-md">
            <BzAccordionItem Value="a">
                <BzAccordionTrigger>First section</BzAccordionTrigger>
                <BzAccordionContent>Open by default, independently of the others.</BzAccordionContent>
            </BzAccordionItem>
            <BzAccordionItem Value="b">
                <BzAccordionTrigger>Second section</BzAccordionTrigger>
                <BzAccordionContent>Also open by default.</BzAccordionContent>
            </BzAccordionItem>
            <BzAccordionItem Value="c">
                <BzAccordionTrigger>Third section</BzAccordionTrigger>
                <BzAccordionContent>Closed until you open it.</BzAccordionContent>
            </BzAccordionItem>
        </BzAccordion>
    </Demo>

    <Demo Title="Disabled item" Code="@DisabledCode">
        <BzAccordion Collapsible Class="w-full max-w-md">
            <BzAccordionItem Value="open">
                <BzAccordionTrigger>Available</BzAccordionTrigger>
                <BzAccordionContent>This one works.</BzAccordionContent>
            </BzAccordionItem>
            <BzAccordionItem Value="locked" Disabled>
                <BzAccordionTrigger>Locked</BzAccordionTrigger>
                <BzAccordionContent>Unreachable.</BzAccordionContent>
            </BzAccordionItem>
        </BzAccordion>
    </Demo>
    <Demo Title="Customization"
          Description="Restyle any part via Class - here each item is a bordered card with an indigo expanded trigger and a tinted icon. The expanded recolor uses the aria-expanded variant; the icon is targeted through its data-slot."
          Code="@CustomCode">
        <BzAccordion DefaultValue="item-1" Collapsible Class="w-full max-w-md gap-2">
            <BzAccordionItem Value="item-1" Class="rounded-lg border border-border px-4">
                <BzAccordionTrigger Class="rounded-md aria-expanded:bg-indigo-600 aria-expanded:text-white aria-expanded:no-underline aria-expanded:**:data-[slot=accordion-trigger-icon]:text-white px-3">Branded section</BzAccordionTrigger>
                <BzAccordionContent>The expanded trigger turns indigo and the chevron follows via its data-slot.</BzAccordionContent>
            </BzAccordionItem>
            <BzAccordionItem Value="item-2" Class="rounded-lg border border-border px-4">
                <BzAccordionTrigger Class="rounded-md aria-expanded:bg-indigo-600 aria-expanded:text-white aria-expanded:no-underline aria-expanded:**:data-[slot=accordion-trigger-icon]:text-white px-3">Another section</BzAccordionTrigger>
                <BzAccordionContent>Each item is a self-contained bordered card with its own rounding.</BzAccordionContent>
            </BzAccordionItem>
        </BzAccordion>
    </Demo>
    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the chevron, padding and text all mirror to the right." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzAccordion DefaultValue="item-1" Collapsible Class="w-full max-w-md">
                <BzAccordionItem Value="item-1">
                    <BzAccordionTrigger>هل يدعم إمكانية الوصول؟</BzAccordionTrigger>
                    <BzAccordionContent>نعم. يتبع نمط الأكورديون في WAI-ARIA: زر داخل عنوان موصول بمنطقته.</BzAccordionContent>
                </BzAccordionItem>
                <BzAccordionItem Value="item-2">
                    <BzAccordionTrigger>هل هو منسّق؟</BzAccordionTrigger>
                    <BzAccordionContent>نعم. تكسوه جميع أنماط Blaizio الثمانية - بدّل النمط بالأعلى للمقارنة.</BzAccordionContent>
                </BzAccordionItem>
                <BzAccordionItem Value="item-3">
                    <BzAccordionTrigger>هل هو متحرّك؟</BzAccordionTrigger>
                    <BzAccordionContent>نعم. يتحرّك الفتح والإغلاق إلى الارتفاع المقاس للمحتوى.</BzAccordionContent>
                </BzAccordionItem>
            </BzAccordion>
        </BzDirectionProvider>
    </Demo>
</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode _anatomy = new CompositionNode("BzAccordion",
        new CompositionNode("BzAccordionItem",
            new CompositionNode("BzAccordionTrigger"),
            new CompositionNode("BzAccordionContent")));

    private const string UsageSetup = """
        @* _Imports.razor (or the top of the page) *@
        @using Blaizio.Ui
        """;

    private const string UsageMarkup = """
        <BzAccordion DefaultValue="item-1" Collapsible>
            <BzAccordionItem Value="item-1">
