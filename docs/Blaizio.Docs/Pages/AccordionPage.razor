@page "/docs/components/accordion"
@using Blaizio.Docs.Examples.Accordion
<PageTitle>Accordion - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Accordion</h1>
            <DocBadges Slug="accordion" />
        </div>
        <p class="text-muted-foreground">Vertically stacked sections that expand one (or many) at a time.</p>
    </header>

    <UsageBlock Example="typeof(AccordionUsageExample)"
                Description="Add the using once, then compose items - each pairs a trigger (the header) with content. Set DefaultValue and Collapsible to start one section open and let it close again." />

    <CompositionTree Root="Anatomy"
                     Description="The full anatomy. The accordion holds items; each item pairs a trigger (the heading button, with its built-in chevron) and a content panel." />

    <ExamplesHeading />

    <Demo Title="Default" Description="Single mode with Collapsible - pressing the open header closes it. Height animates to the measured content."
          Example="typeof(AccordionDefaultExample)" />

    <Demo Title="Multiple" Description="Any number of sections open at once."
          Example="typeof(AccordionMultipleExample)" />

    <Demo Title="Disabled item" Example="typeof(AccordionDisabledExample)" />

    <Demo Title="Heading level and regions"
          Description="Each trigger renders inside a heading - h3 by default. Set HeadingLevel to slot the accordion into the page outline; here the sections sit under an h2, so they render as h3s (set 2 if the accordion is the page's top level). Each open panel is a role=region landmark by default; set Region to false on accordions with many items, where a landmark per panel is more noise than help to screen-reader navigation."
          Example="typeof(AccordionHeadingLevelExample)" />

    <Demo Title="Customization"
          Description="Restyle any part via Class - here each item is a bordered card with an indigo expanded trigger and a tinted icon. The expanded recolor uses the aria-expanded variant; the icon is targeted through its data-slot."
          Example="typeof(AccordionCustomExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic or Hebrew copy - the chevron, padding and text all mirror to the right."
          Example="typeof(AccordionRtlExample)" />
</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzAccordion",
        new CompositionNode("BzAccordionItem",
            new CompositionNode("BzAccordionTrigger"),
            new CompositionNode("BzAccordionContent")));
}
