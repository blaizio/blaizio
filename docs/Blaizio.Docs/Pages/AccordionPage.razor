    private const string MultipleCode = """
        <BzAccordion Type="AccordionType.Multiple" DefaultValues="@(["a", "b"])">
            <BzAccordionItem Value="a">
                <BzAccordionTrigger>First section</BzAccordionTrigger>
                <BzAccordionContent>Open by default, independently of the others.</BzAccordionContent>
            </BzAccordionItem>
            <BzAccordionItem Value="b">
                <BzAccordionTrigger>Second section</BzAccordionTrigger>
