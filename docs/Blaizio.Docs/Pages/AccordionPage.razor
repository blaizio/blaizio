@page "/docs/components/accordion"
@using Blaizio.Docs.Examples.Accordion
<PageTitle>Accordion - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Accordion</h1>
            <DocBadges Slug="accordion" />
        </div>
        <p>Expanding sections that open one at a time or several at once, with the height animated to the measured content. Each trigger sits inside a real heading and each open panel is a labelled region, so screen-reader users can jump between sections the same way they move through the page outline.</p>
    </header>

    <UsageBlock Example="typeof(AccordionUsageExample)"
                Description="After importing `Blaizio.Ui`, compose items that each pair a trigger with its content. `DefaultValue` starts one section open, and `Collapsible` lets the user close it again." />

    <CompositionTree Root="Anatomy"
                     Description="Every part of an accordion. Each item pairs a trigger, the heading button with its built-in chevron, with the content panel it controls." />

    <ExamplesHeading />

    <Demo Title="Default" Description="In the default single mode, opening one section closes the others. With `Collapsible` set, pressing the open header closes it too."
          Example="typeof(AccordionDefaultExample)" />

    <Demo Title="Multiple" Description="Set `SelectionMode` to `SelectionMode.Multiple` so any number of sections can stay open, seeded here through `DefaultValues`."
          Example="typeof(AccordionMultipleExample)" />

    <Demo Title="Disabled item" Example="typeof(AccordionDisabledExample)" />

    <Demo Title="Heading level and regions"
          Description="Each trigger renders inside an `h3` by default. Set `HeadingLevel` to fit the page outline, and set `Region` to `false` on long accordions, where a landmark for every open panel adds noise to screen-reader navigation."
          Example="typeof(AccordionHeadingLevelExample)" />

    <Demo Title="Customization"
          Description="Every part accepts `Class`. This example turns each item into a bordered card, recolors the open trigger through the `aria-expanded` variant and tints the chevron through its `data-slot`."
          Example="typeof(AccordionCustomExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, the text aligns to the right and the chevron and its padding move to the left edge."
          Example="typeof(AccordionRtlExample)" />
</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzAccordion",
        new CompositionNode("BzAccordionItem",
            new CompositionNode("BzAccordionTrigger"),
            new CompositionNode("BzAccordionContent")));
}
