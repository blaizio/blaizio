@page "/docs/components/navigation-menu"
@using Blaizio.Docs.Examples.NavigationMenu
<PageTitle>Navigation Menu - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Navigation Menu</h1>
            <DocBadges Slug="navigation-menu" />
        </div>
        <p>A site navigation bar whose items can open rich dropdown panels, while plain items stay ordinary links. Hovering or clicking a trigger opens its content in a shared viewport that resizes smoothly from one panel to the next. Keyboard support is built in: the left and right arrow keys, Home and End move between the triggers, ArrowDown enters an open panel, and Escape closes it and returns focus to its trigger.</p>
    </header>

    <UsageBlock Example="typeof(NavigationMenuUsageExample)"
                Description="Put the items in a `BzNavigationMenuList`. An item with a dropdown pairs a `BzNavigationMenuTrigger` with a `BzNavigationMenuContent`, while a plain item holds a single `BzNavigationMenuLink`." />

    <CompositionTree Root="Anatomy"
                     Description="The menu is a list of items. A dropdown item is a trigger plus its content, and a link item is a single link." />

    <ExamplesHeading />

    <Demo Title="Default" Description="Hover a trigger to open its panel, or click it to toggle. Moving between triggers resizes the shared viewport to fit each panel, and the last item is a plain link."
          Example="typeof(NavigationMenuDefaultExample)" />

    <Demo Title="Without the viewport" Description="Set `Viewport` to `false` and each panel opens as a bordered dropdown directly under its own item, instead of in the shared viewport."
          Example="typeof(NavigationMenuInlineExample)" />

    <Demo Title="Two-pane menu (master / detail)" Description="A panel split into a list of audiences and a detail pane, built from the same parts with no extra component. Move through the audiences with the arrow keys or the mouse, and the detail pane follows the highlight."
          Example="typeof(NavigationMenuTwoPaneExample)" />

    <Demo Title="With an arrow" Description="Add a `BzNavigationMenuArrow` as the last item to show a small tail that slides under the open trigger. It is drawn the same way as the popover and tooltip arrows."
          Example="typeof(NavigationMenuArrowExample)" />

    <Demo Title="Customization" Description="Every part accepts `Class`, merged over the defaults. This example uses pill-shaped triggers with a branded open state and a tinted panel."
          Example="typeof(NavigationMenuCustomExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, the bar, the chevron spacing, the panels and the arrow all flip to the opposite side."
          Example="typeof(NavigationMenuRtlExample)" />

</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzNavigationMenu",
        new CompositionNode("BzNavigationMenuList",
            new CompositionNode("BzNavigationMenuItem",
                new CompositionNode("BzNavigationMenuTrigger"),
                new CompositionNode("BzNavigationMenuContent",
                    new CompositionNode("BzNavigationMenuLink"))),
            new CompositionNode("BzNavigationMenuItem",
                new CompositionNode("BzNavigationMenuLink")),
            new CompositionNode("BzNavigationMenuArrow")));
}
