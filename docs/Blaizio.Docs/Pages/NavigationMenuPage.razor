@page "/docs/components/navigation-menu"
@using Blaizio.Docs.Examples.NavigationMenu
<PageTitle>Navigation Menu - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Navigation Menu</h1>
        <p class="text-muted-foreground">A horizontal site-navigation bar whose items can open rich dropdown panels. Hovering (or clicking) a trigger opens its content in a shared viewport that morphs to fit; plain items are just links. Keyboard and screen-reader friendly.</p>
    </header>

    <UsageBlock Example="typeof(NavigationMenuUsageExample)"
                Description="Put items in a BzNavigationMenuList. An item with a dropdown pairs a BzNavigationMenuTrigger with a BzNavigationMenuContent; a plain item holds a single BzNavigationMenuLink." />

    <CompositionTree Root="Anatomy"
                     Description="A list of items. A dropdown item is a trigger plus content; a link item is a single link." />

    <ExamplesHeading />

    <Demo Title="Default" Description="Hover a trigger to open its panel in the shared viewport (it morphs between sizes); the last item is a plain link. Click a trigger to toggle it."
          Example="typeof(NavigationMenuDefaultExample)" />

    <Demo Title="Without the viewport" Description="With Viewport=false each panel drops as a bordered dropdown directly under its own item, instead of into a shared morphing viewport."
          Example="typeof(NavigationMenuInlineExample)" />

    <Demo Title="Two-pane menu (master / detail)" Description="A panel split into a list of audiences on the left and a detail pane on the right. Open with the trigger (or ArrowDown), then walk the audiences with the arrow keys - the highlight and the detail follow as you go; hover or click does the same with the mouse. Escape (or clicking outside) closes and returns focus to the trigger. It's a composition of the same parts, no new component."
          Example="typeof(NavigationMenuTwoPaneExample)" />

    <Demo Title="With an arrow" Description="Add a BzNavigationMenuArrow as the last item to show a little tail that slides under the open trigger - drawn like the Popover and Tooltip arrows."
          Example="typeof(NavigationMenuArrowExample)" />

    <Demo Title="Customization" Description="Restyle any part via Class - here pill-shaped triggers with a branded open state and a tinted panel - all merged over the defaults."
          Example="typeof(NavigationMenuCustomExample)" />

    <Demo Title="RTL" Description="Under a right-to-left DirectionProvider the bar, the chevron offset, the panels and the arrow all mirror; the same rich content as the Default example, in Arabic."
          Example="typeof(NavigationMenuRtlExample)" />

</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzNavigationMenu",
        new CompositionNode("BzNavigationMenuList",
            new CompositionNode("BzNavigationMenuItem",
                new CompositionNode("BzNavigationMenuTrigger"),
                new CompositionNode("BzNavigationMenuContent",
                    new CompositionNode("BzNavigationMenuLink"))),
            new CompositionNode("BzNavigationMenuItem",
                new CompositionNode("BzNavigationMenuLink")),
            new CompositionNode("BzNavigationMenuArrow")));
}
