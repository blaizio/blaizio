@page "/docs/components/item"
@using Blaizio.Docs.Examples.Item
<PageTitle>Item - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Item</h1>
            <DocBadges Slug="item" />
        </div>
        <p>A flex row that lays out optional media, a title and description, and actions. It is the building block for lists of files, people, notifications or settings entries, and it can render as a link when the whole row should navigate.</p>
    </header>

    <UsageBlock Example="typeof(ItemUsageExample)" />

    <CompositionTree Root="Anatomy"
                     Description="Media and actions are optional, while the header and footer are full-width bands above and below the row. Stack items in a `BzItemGroup` with a `BzItemSeparator` between them." />

    <section>
        <h2 data-toc class="scroll-mt-20">Item vs. Field</h2>
        <p>
            They look alike but serve different purposes. Use
            <a class="hover:text-foreground" href="docs/components/field">Field</a>
            when the row labels a form control such as a checkbox, input, radio or select, and you want
            the label, description and validation error wired to it. Use Item when the row only
            displays content: a title, a description and some actions.
        </p>
    </section>

    <ExamplesHeading />

    <Demo Title="Variants"
          Description="`Variant` sets the surface. `Default` is transparent and blends into the page, `Outline` adds a border and `Muted` a soft fill."
          Example="typeof(ItemVariantsExample)" />

    <Demo Title="Sizes" Description="`ItemSize.Sm` tightens the padding for dense lists." Example="typeof(ItemSizeExample)" />

    <Demo Title="Icon"
          Description="The `Icon` media variant puts a lone icon in a muted tile. When a description is present, the media aligns with the top of the title."
          Example="typeof(ItemIconExample)" />

    <Demo Title="Avatar"
          Description="The default media variant renders its content as is, which suits avatars and custom art."
          Example="typeof(ItemAvatarExample)" />

    <Demo Title="Image"
          Description="The `Image` media variant crops a thumbnail to a fixed tile."
          Example="typeof(ItemImageExample)" />

    <Demo Title="Group"
          Description="`BzItemGroup` stacks rows into a list and `BzItemSeparator` divides them. The container brings no border of its own, so this example adds a border and radius."
          Example="typeof(ItemGroupExample)" />

    <Demo Title="Header"
          Description="`BzItemHeader` is a full-width band above the row content, for status lines, timestamps or badges."
          Example="typeof(ItemHeaderExample)" />

    <Demo Title="Link (RenderAs)"
          Description="With `RenderAs` the whole item becomes an anchor, and link items get a hover tint."
          Example="typeof(ItemLinkExample)" />

    <Demo Title="RTL"
          Description="Inside a right-to-left `DirectionProvider`, media, content and actions swap to the opposite sides."
          Example="typeof(ItemRtlExample)" />
</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzItem",
        new CompositionNode("BzItemHeader"),
        new CompositionNode("BzItemMedia"),
        new CompositionNode("BzItemContent",
            new CompositionNode("BzItemTitle"),
            new CompositionNode("BzItemDescription")),
        new CompositionNode("BzItemActions"),
        new CompositionNode("BzItemFooter"));
}
