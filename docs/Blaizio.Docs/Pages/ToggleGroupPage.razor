@page "/docs/components/toggle-group"
@using Blaizio.Docs.Examples.ToggleGroup
<PageTitle>Toggle Group - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Toggle Group</h1>
        <p class="text-muted-foreground">A set of two-state buttons that can be toggled on or off.</p>
    </header>

    <UsageBlock Example="typeof(ToggleGroupUsageExample)"
                Description="Add the using once, then compose a group of items. Each item carries a Value and toggles on press." />

    <CompositionTree Root="Anatomy"
                     Description="A group wraps its items. Variant, Size and Spacing set on the group cascade to every item." />

    <ExamplesHeading />

    <Demo Title="Default" Description="Multiple mode - any number of items can be on at once." Example="typeof(ToggleGroupDefaultExample)" />

    <Demo Title="Items as links (RenderAs)"
          Description="Render group items onto your own elements via RenderAs - here anchors acting as a view switcher."
          Example="typeof(ToggleGroupRenderAsExample)" />

    <Demo Title="Outline" Description="The outline variant set on the group applies to every item." Example="typeof(ToggleGroupOutlineExample)" />

    <Demo Title="Single" Description="Single mode - at most one item is on; pressing it again clears it." Example="typeof(ToggleGroupSingleExample)" />

    <Demo Title="Sizes" Example="typeof(ToggleGroupSizesExample)" />

    <Demo Title="Disabled" Example="typeof(ToggleGroupDisabledExample)" />

    <Demo Title="Controlled" Description="Bind the single-mode value two-way; deselecting reports null." Example="typeof(ToggleGroupControlledExample)" />

    <Demo Title="Looping" Description="Arrow keys wrap from the last item back to the first by default. Set Loop to false to stop at the ends instead. Focus an item and hold the arrow key to feel the difference." Example="typeof(ToggleGroupLoopExample)" />

    <Demo Title="Customization" Description="A segmented group (Spacing 0) with a branded on-state: target the item slot and recolor data-[state=on]." Example="typeof(ToggleGroupCustomizationExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic aria-labels - the items lay out from the right." Example="typeof(ToggleGroupRtlExample)" />
</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzToggleGroup",
        new CompositionNode("BzToggleGroupItem"));
}
