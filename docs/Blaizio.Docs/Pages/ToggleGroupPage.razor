@page "/docs/components/toggle-group"
@using Blaizio.Docs.Examples.ToggleGroup
<PageTitle>Toggle Group - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Toggle Group</h1>
            <DocBadges Slug="toggle-group" />
        </div>
        <p>A set of toggles that work as one control, in single mode for a choice like text alignment or multiple mode for independent options like bold and italic. The group is a single tab stop, and the arrow keys move between its items, wrapping at the ends by default. Variant, size and spacing are set once on the group and apply to every item.</p>
    </header>

    <UsageBlock Example="typeof(ToggleGroupUsageExample)"
                Description="After importing `Blaizio.Ui`, place items inside a group. Each item has a `Value`, and pressing it turns that value on or off." />

    <CompositionTree Root="Anatomy"
                     Description="A group wraps its items. `Variant`, `Size` and `Spacing` set on the group apply to every item inside it." />

    <ExamplesHeading />

    <Demo Title="Default" Description="With `SelectionMode` set to `Multiple`, any number of items can be on at once." Example="typeof(ToggleGroupDefaultExample)" />

    <Demo Title="Items as links (RenderAs)"
          Description="Use `RenderAs` when an item should be your own element and apply the attributes it provides to it. Here the items are anchors that switch between views."
          Example="typeof(ToggleGroupRenderAsExample)" />

    <Demo Title="Outline" Description="Set `Variant` to `ToggleVariant.Outline` on the group and every item picks it up." Example="typeof(ToggleGroupOutlineExample)" />

    <Demo Title="Single" Description="In single mode, the default, at most one item is on. Pressing the active item again clears the selection." Example="typeof(ToggleGroupSingleExample)" />

    <Demo Title="Sizes" Example="typeof(ToggleGroupSizesExample)" />

    <Demo Title="Disabled" Example="typeof(ToggleGroupDisabledExample)" />

    <Demo Title="Controlled" Description="Bind `Value` in single mode to keep the selection in a field of your page. When the active item is pressed again, the bound value becomes `null`." Example="typeof(ToggleGroupControlledExample)" />

    <Demo Title="Looping" Description="By default the arrow keys wrap from the last item back to the first. Set `Loop` to `false` to stop at the ends instead. Focus an item and hold an arrow key to compare the two." Example="typeof(ToggleGroupLoopExample)" />

    <Demo Title="Customization" Description="Every part accepts `Class`. This example sets `Spacing` to 0 for a segmented look and recolors the on state by styling the item slot's `data-[state=on]` variant." Example="typeof(ToggleGroupCustomizationExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, the items lay out from the right and the Left and Right arrow keys swap direction to match." Example="typeof(ToggleGroupRtlExample)" />
</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzToggleGroup",
        new CompositionNode("BzToggleGroupItem"));
}
