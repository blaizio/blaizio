@page "/docs/components/badge"
@using Blaizio.Docs.Examples.Badge
<PageTitle>Badge - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Badge</h1>
            <DocBadges Slug="badge" />
        </div>
        <p class="text-muted-foreground">A small label for status, counts, or categories.</p>
    </header>

    <UsageBlock Example="typeof(BadgeUsageExample)" />

    <ExamplesHeading />

    <Demo Title="Variants" Example="typeof(BadgeVariantsExample)" />

    <Demo Title="With icon" Example="typeof(BadgeIconExample)" />

    <Demo Title="Counts" Description="Numeric badges, e.g. for notifications." Example="typeof(BadgeCountsExample)" />

    <Demo Title="As a link" Description="Use RenderAs to render the badge as an anchor." Example="typeof(BadgeRenderAsExample)" />

    <Demo Title="Customization"
          Description="Pass your own classes via Class - brand colors, status tints, or a gradient - over the variant defaults."
          Example="typeof(BadgeCustomExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the icon sits to the right of the label."
          Example="typeof(BadgeRtlExample)" />
</div>

