@page "/"
@layout Blaizio.Docs.Layout.LandingLayout
@implements IAsyncDisposable
@inject IDocsJs Js
<PageTitle>Blaizio - Blazor UI you own</PageTitle>

@*
    The marketing home page, in five beats:
      1. Hero: the poster headline, the install command beside its first line and the calls to
         action beside its second, then the stage (LandingStage): a live dashboard of real
         components over its unstyled Blaizio.Base twin, with the 128-look picker (a two-row
         bottom sheet on phones).
      2. Edit anything, keep it on update (LandingUpdateDemo): a clicked-through walkthrough.
      3. Built in, not bolted on: the keyboard panel (LandingKeyboardDemo; LandingA11yCard on
         touch-first devices) beside the direction card (LandingDirectionsDemo).
      4. Three commands, one line each (LandingCommand).
      5. The closing headline.
    The page sets its own type (font-landing-*: Bricolage Grotesque, Geist, Geist Mono, loaded on
    first render) while every color comes from the tokens, so a style or theme pick restyles it in
    place. Below the hero, each [data-reveal] block that starts off screen fades and rises in the
    first time it scrolls into view (docs.ts revealStart); reduced motion shows everything.
*@
<div class="overflow-x-clip font-landing" @ref="_root">
    <section class="mx-auto max-w-[82.5rem] px-5 pt-8 sm:px-7">
        <div class="flex flex-wrap items-end justify-between gap-x-11 gap-y-5">
            <div class="flex min-w-0 flex-col gap-4">
                <div class="flex flex-wrap gap-2">
                    <span class="rounded-full border px-3 py-1 font-landing-mono text-[11.5px] text-muted-foreground">v@(BuildVersions.Blaizio) · Blazor · .NET 10 · Tailwind v4</span>
                    <span class="rounded-full bg-accent px-3 py-1 font-landing-mono text-[11.5px] text-accent-foreground">MIT</span>
                </div>
                <h1 class="font-landing-display text-[clamp(2.5rem,5.4vw,4.75rem)] font-bold leading-[0.92] tracking-[-0.035em] [word-spacing:0.06em] sm:whitespace-nowrap">
                    <bdi>Own the source.</bdi><span class="sr-only"> Style it your way.</span>
                </h1>
            </div>
            <div class="flex min-w-0 flex-col items-start gap-2 pb-2">
                <span class="font-landing-mono text-[11px] uppercase tracking-[0.08em] text-muted-foreground">Install the CLI</span>
                <LandingCommand Command="dotnet tool install -g Blaizio.Cli" />
            </div>
        </div>
        <div class="mt-0.5 flex flex-wrap items-end justify-between gap-x-9 gap-y-5">
            <p aria-hidden="true" class="font-landing-display text-[clamp(2.5rem,5.4vw,4.75rem)] font-bold leading-[0.92] tracking-[-0.035em] [word-spacing:0.06em] text-primary-ink sm:whitespace-nowrap"><bdi>Style it your way.</bdi></p>
            <div class="flex flex-wrap gap-2.5 pb-2">
                <BzButton Size="ButtonSize.Lg" Class="h-12 rounded-xl px-6 text-base no-underline">
                    <RenderAs Context="p">
                        <a href="docs/installation" @attributes="p.Attributes">Get started <BzIcon Icon="@Tabler.Outline.ArrowRight" Class="size-4 rtl:-scale-x-100" /></a>
                    </RenderAs>
                </BzButton>
                <BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.Lg" Class="h-12 rounded-xl px-5 no-underline">
                    <RenderAs Context="p">
                        <a href="docs/components" @attributes="p.Attributes">Components</a>
                    </RenderAs>
                </BzButton>
            </div>
        </div>

        <div class="mt-8">
            <LandingStage />
        </div>
    </section>

    <section class="mx-auto max-w-[82.5rem] px-5 pt-14 sm:px-7 sm:pt-32" data-reveal>
        <LandingUpdateDemo />
    </section>

    <section class="mx-auto max-w-[82.5rem] px-5 pt-14 sm:px-7 sm:pt-32">
        <h2 class="mb-6 font-landing-display sm:mb-8 text-[clamp(2rem,3.4vw,3rem)] font-semibold leading-[1.02] tracking-[-0.03em]" data-reveal>
            <bdi>Built in.</bdi><br /><bdi class="text-primary-ink">Not bolted on.</bdi>
        </h2>
        <div class="grid gap-5 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)]" data-reveal style="--reveal-delay: 120ms">
            <LandingKeyboardDemo />
            <LandingA11yCard />
            <LandingDirectionsDemo />
        </div>
    </section>

    <section class="mx-auto max-w-[82.5rem] px-5 pt-14 sm:px-7 sm:pt-32">
        <h2 class="mb-6 font-landing-display sm:mb-8 text-[clamp(2rem,3.4vw,3rem)] font-semibold leading-[1.02] tracking-[-0.03em]" data-reveal><bdi>Three commands.</bdi></h2>
        <ol class="grid border-t md:grid-cols-3 md:gap-x-7">
            @foreach (var (step, i) in Steps.Select((s, i) => (s, i)))
            {
                <li class="flex min-w-0 flex-col gap-3 border-b py-5 sm:gap-4 md:py-7" data-reveal style="@($"--reveal-delay: {i * 120}ms")">
                    <span class="font-landing-display text-5xl font-bold leading-[0.8] md:text-6xl tracking-[-0.04em] text-primary-ink [-webkit-text-fill-color:transparent] [-webkit-text-stroke:1.5px_currentColor]" aria-hidden="true">@step.Number</span>
                    <LandingCommand Command="@step.Command" />
                    <div>
                        <h3 class="text-[17px] font-semibold"><bdi><span class="sr-only">Step @step.Number: </span>@step.Title</bdi></h3>
                        <p class="text-[15px] leading-relaxed text-muted-foreground"><bdi>@step.Body</bdi></p>
                    </div>
                </li>
            }
        </ol>
    </section>

    <section class="mx-auto flex max-w-[82.5rem] flex-col items-center gap-8 px-5 pb-16 pt-16 text-center sm:px-7 sm:pb-28 sm:pt-40" data-reveal>
        <h2 class="font-landing-display text-[clamp(2.25rem,4.8vw,4.25rem)] font-semibold leading-[0.98] tracking-[-0.035em] text-balance">
            <bdi>Read every line</bdi><br /><bdi class="text-primary-ink">before you ship it.</bdi>
        </h2>
        <div class="flex flex-wrap justify-center gap-3">
            <BzButton Size="ButtonSize.Lg" Class="h-[3.25rem] rounded-xl px-7 text-base no-underline">
                <RenderAs Context="p">
                    <a href="docs/installation" @attributes="p.Attributes">Get started</a>
                </RenderAs>
            </BzButton>
            <BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.Lg" Class="h-[3.25rem] rounded-xl px-7 text-base no-underline">
                <RenderAs Context="p">
                    <a href="docs" @attributes="p.Attributes">Read the docs</a>
                </RenderAs>
            </BzButton>
        </div>
    </section>

    <footer class="border-t">
        <div class="mx-auto flex max-w-[82.5rem] flex-wrap items-center justify-between gap-x-6 gap-y-3 px-5 py-6 text-[13px] text-muted-foreground sm:px-7">
            <span><span class="font-landing-display text-[17px] font-extrabold tracking-[-0.03em] text-foreground">Blaizio</span> · © @DateTime.Now.Year · MIT</span>
            <div class="flex flex-wrap gap-x-6 gap-y-2">
                <a href="https://github.com/blaizio/blaizio" target="_blank" rel="noreferrer" class="no-underline transition-colors hover:text-foreground">GitHub</a>
                <a href="https://x.com/blaizio_ui" target="_blank" rel="noreferrer" class="no-underline transition-colors hover:text-foreground">X</a>
                <a href="docs" class="no-underline transition-colors hover:text-foreground">Docs</a>
                <a href="community" class="no-underline transition-colors hover:text-foreground">Community</a>
                <a href="docs/changelog" class="no-underline transition-colors hover:text-foreground">Changelog</a>
            </div>
        </div>
    </footer>
</div>

@code {
    private sealed record Step(string Number, string Command, string Title, string Body);

    private static readonly Step[] Steps =
    [
        new("01", "dotnet tool install -g Blaizio.Cli", "Install the CLI",
            "One global tool. The runtime arrives as NuGet packages on your first add."),
        new("02", "blaizio add button card dialog", "Pick a style and theme",
            "The first add asks for namespace, folder, style and theme, then writes .razor source."),
        new("03", "blaizio apply comet --only theme", "Retheme whenever",
            "A theme swap rewrites only your CSS variables. Components stay as you left them."),
    ];

    private const string Fonts =
        "https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Geist:wght@400..700&family=Geist+Mono:wght@400..600&display=swap";

    private ElementReference _root;
    private IJSObjectReference? _reveal;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _reveal = await Js.RevealStartAsync(_root);
        try { await Js.LoadWebFontAsync(Fonts); }
        catch (JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        if (_reveal is null) return;
        try
        {
            await _reveal.InvokeVoidAsync("dispose");
            await _reveal.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit or page is already gone; nothing left to release.
        }
    }
}
