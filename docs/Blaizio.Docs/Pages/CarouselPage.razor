@page "/components/carousel"
@using Blaizio.Docs.Examples.Carousel
<PageTitle>Carousel - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Carousel</h1>
        <p class="text-muted-foreground">A slideshow of panels the user can page through - drag, swipe, click the arrows or dots, or use the arrow keys. Slides snap into place; show one or several at a time, horizontally or vertically, with optional looping and autoplay.</p>
    </header>

    <UsageBlock Example="typeof(CarouselUsageExample)"
                Description="Put BzCarouselItem slides inside a BzCarouselContent, then add BzCarouselPrevious / BzCarouselNext (and optionally BzCarouselDots) as siblings inside the BzCarousel. The arrows and dots sit just outside the slides, so leave a little room around the carousel." />

    <CompositionTree Root="Anatomy"
                     Description="The content holds the slides; the controls and dots are siblings pinned to the carousel's edges and driven by the same engine." />

    <ExamplesHeading />

    <Demo Title="Default" Description="One slide at a time with arrows and position dots. Drag with the mouse, focus a control and use the arrow keys, or click a dot." Example="typeof(CarouselDefaultExample)" />

    <Demo Title="Multiple slides" Description="Override a slide's basis to show several at once - here half a slide on small screens and a third on larger ones." Example="typeof(CarouselMultipleExample)" />

    <Demo Title="Vertical" Description="Set Orientation=Vertical to page up and down. The content needs a height." Example="typeof(CarouselVerticalExample)" />

    <Demo Title="Loop" Description="With Loop the arrows never disable - paging past either end wraps around." Example="typeof(CarouselLoopExample)" />

    <Demo Title="Autoplay" Description="Set AutoplayInterval (ms) to advance on a timer; it pauses while the pointer is over the carousel or a control is focused." Example="typeof(CarouselAutoplayExample)" />

    <Demo Title="Tracking the selected slide" Description="Handle OnSelectedIndexChanged to react as the slide changes - to sync a caption, fetch data, etc." Example="typeof(CarouselTrackingExample)" />

    <Demo Title="Customization" Description="Restyle the controls and dots with Class - here solid arrows tucked inside the slides and wider dots. Anything you put inside a control replaces its icon." Example="typeof(CarouselCustomExample)" />

    <Demo Title="RTL" Description="Under a right-to-left DirectionProvider the slides, arrows and drag direction mirror automatically." Example="typeof(CarouselRtlExample)" />

</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzCarousel",
        new CompositionNode("BzCarouselContent",
            new CompositionNode("BzCarouselItem")),
        new CompositionNode("BzCarouselPrevious"),
        new CompositionNode("BzCarouselNext"),
        new CompositionNode("BzCarouselDots"));
}
