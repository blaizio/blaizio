@page "/docs/components/carousel"
@using Blaizio.Docs.Examples.Carousel
<PageTitle>Carousel - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Carousel</h1>
            <DocBadges Slug="carousel" />
        </div>
        <p>A slideshow that responds to dragging, swiping, the arrow buttons, the dots and the arrow keys, with every slide snapping into place. You can show one slide or several at a time, page horizontally or vertically, and turn on looping. Autoplay is built to be accessible: it pauses on hover, stops on focus and never starts when the OS asks for reduced motion.</p>
    </header>

    <UsageBlock Example="typeof(CarouselUsageExample)"
                Description="Put `BzCarouselItem` slides inside a `BzCarouselContent`, then add `BzCarouselPrevious`, `BzCarouselNext` and optionally `BzCarouselDots` next to it. The arrows and dots sit just outside the slides, so leave a little room around the carousel. Set `AriaLabel` to say what the slides show, because screen readers announce the carousel as a named region and each slide as &quot;N of M&quot;." />

    <CompositionTree Root="Anatomy"
                     Description="Every part of a carousel. The content holds the slides, while the arrows and dots sit next to it, pinned to the carousel's edges and sharing its selected slide." />

    <ExamplesHeading />

    <Demo Title="Default" Description="One slide at a time with arrows and position dots. Drag with the mouse, click a dot, or focus a control and use the arrow keys." Example="typeof(CarouselDefaultExample)" />

    <Demo Title="Multiple slides" Description="Override a slide's basis with `Class` to show several at once. Here each slide takes half the width on small screens and a third on larger ones." Example="typeof(CarouselMultipleExample)" />

    <Demo Title="Vertical" Description="Set `Orientation` to `Orientation.Vertical` to page up and down. Give the content a fixed height so the slides have room to move." Example="typeof(CarouselVerticalExample)" />

    <Demo Title="Loop" Description="With `Loop` set, paging past either end wraps around, so the arrows never disable." Example="typeof(CarouselLoopExample)" />

    <Demo Title="Autoplay" Description="Set `AutoplayInterval` in milliseconds to advance on a timer, and add a `BzCarouselPlayPause` as the first tab stop so it can be stopped. Hovering pauses rotation, focus or a drag stops it until it is restarted, and it never starts on its own when the OS asks for reduced motion." Example="typeof(CarouselAutoplayExample)" />

    <Demo Title="Tracking the selected slide" Description="Handle `SelectedIndexChanged`, or bind `SelectedIndex` two-way, when something else on the page depends on the current slide, such as a caption or data to load." Example="typeof(CarouselTrackingExample)" />

    <Demo Title="Customization" Description="Every part accepts `Class`. This example tucks solid arrows inside the slides and widens the dots. Anything you put inside an arrow replaces its icon." Example="typeof(CarouselCustomExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, the slide order, the arrows and the drag direction all mirror." Example="typeof(CarouselRtlExample)" />

</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzCarousel",
        new CompositionNode("BzCarouselContent",
            new CompositionNode("BzCarouselItem")),
        new CompositionNode("BzCarouselPrevious"),
        new CompositionNode("BzCarouselNext"),
        new CompositionNode("BzCarouselDots"));
}
