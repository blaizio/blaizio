@page "/docs/components/skeleton"
@using Blaizio.Docs.Examples.Skeleton
<PageTitle>Skeleton - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Skeleton</h1>
            <DocBadges Slug="skeleton" />
        </div>
        <p class="text-muted-foreground">An animated placeholder while content loads. Shimmers left to right by default; honors the OS/browser reduced-motion setting.</p>
    </header>

    <UsageBlock Example="typeof(SkeletonUsageExample)" />

    <ExamplesHeading />

    <Demo Title="Default" Example="typeof(SkeletonDefaultExample)" />

    <Demo Title="Animations" Example="typeof(SkeletonAnimationsExample)" />

    <Demo Title="Card" Example="typeof(SkeletonCardExample)" />

    <Demo Title="Customization"
          Description="Skeletons are plain elements - set the size, shape, and tint with Class."
          Example="typeof(SkeletonCustomExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the avatar and lines mirror to the right." Example="typeof(SkeletonRtlExample)" />
</div>

