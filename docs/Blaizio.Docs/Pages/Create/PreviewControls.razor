@* Accordion FAQ + toggle group + tabs + pagination - the "navigation & disclosure" column. *@
<BzCard>
    <BzCardHeader>
        <BzCardTitle>FAQ</BzCardTitle>
        <BzCardDescription>Frequently asked questions.</BzCardDescription>
    </BzCardHeader>
    <BzCardContent>
        <BzAccordion DefaultValue="faq-1" Collapsible Class="w-full">
            <BzAccordionItem Value="faq-1">
                <BzAccordionTrigger>Is it accessible?</BzAccordionTrigger>
                <BzAccordionContent>Yes - WAI-ARIA patterns throughout, keyboard first.</BzAccordionContent>
            </BzAccordionItem>
            <BzAccordionItem Value="faq-2">
                <BzAccordionTrigger>Can I change styles later?</BzAccordionTrigger>
                <BzAccordionContent>Yes - the CLI re-skins in place; your edits stay yours.</BzAccordionContent>
            </BzAccordionItem>
            <BzAccordionItem Value="faq-3">
                <BzAccordionTrigger>Does RTL just work?</BzAccordionTrigger>
                <BzAccordionContent>Logical properties everywhere - flip the direction knob and see.</BzAccordionContent>
            </BzAccordionItem>
        </BzAccordion>
    </BzCardContent>
</BzCard>

<BzCard>
    <BzCardHeader>
        <BzCardTitle>Editor</BzCardTitle>
        <BzCardDescription>Toggle group, tabs and keys.</BzCardDescription>
    </BzCardHeader>
    <BzCardContent Class="space-y-4">
        <BzToggleGroup SelectionMode="SelectionMode.Multiple" Variant="ToggleVariant.Outline" DefaultValues="@(["bold"])">
            <BzToggleGroupItem Value="bold" aria-label="Toggle bold"><BzIcon Icon="@Icons.Outline.Bold" /></BzToggleGroupItem>
            <BzToggleGroupItem Value="italic" aria-label="Toggle italic"><BzIcon Icon="@Icons.Outline.Italic" /></BzToggleGroupItem>
            <BzToggleGroupItem Value="strike" aria-label="Toggle strikethrough"><BzIcon Icon="@Icons.Outline.Strikethrough" /></BzToggleGroupItem>
        </BzToggleGroup>
        <BzTabs DefaultValue="write">
            <BzTabsList Class="w-full">
                <BzTabsTrigger Value="write">Write</BzTabsTrigger>
                <BzTabsTrigger Value="preview">Preview</BzTabsTrigger>
            </BzTabsList>
            <BzTabsContent Value="write" Class="pt-2 text-sm text-muted-foreground">
                Draft your note here. Save with <BzKbd>Ctrl</BzKbd> <BzKbd>S</BzKbd>.
            </BzTabsContent>
            <BzTabsContent Value="preview" Class="pt-2 text-sm text-muted-foreground">
                Rendered markdown preview.
            </BzTabsContent>
        </BzTabs>
    </BzCardContent>
</BzCard>

<BzCard>
    <BzCardHeader>
        <BzCardTitle>Loading</BzCardTitle>
    </BzCardHeader>
    <BzCardContent Class="space-y-3">
        <div class="flex items-center gap-3">
            <BzSkeleton Class="size-10 rounded-full" />
            <div class="flex-1 space-y-2">
                <BzSkeleton Class="h-3 w-3/4" />
                <BzSkeleton Class="h-3 w-1/2" />
            </div>
        </div>
        <BzSkeleton Class="h-24 w-full rounded-lg" />
    </BzCardContent>
</BzCard>
