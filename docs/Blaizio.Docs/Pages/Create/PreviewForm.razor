@* A dense settings/sign-up card: text inputs, select, radio group, checkbox, switch, slider, buttons. *@
<BzCard>
    <BzCardHeader>
        <BzCardTitle>Create project</BzCardTitle>
        <BzCardDescription>Deploy your new project in one click.</BzCardDescription>
    </BzCardHeader>
    <BzCardContent>
        <BzFieldGroup>
            <BzField>
                <BzFieldLabel For="cp-name">Name</BzFieldLabel>
                <BzInputText id="cp-name" placeholder="my-app" @bind-Value="_name" />
            </BzField>
            <BzField>
                <BzFieldLabel For="cp-framework">Framework</BzFieldLabel>
                <BzSelect>
                    <BzSelectTrigger id="cp-framework" Class="w-full">
                        <BzSelectValue Placeholder="Select" />
                    </BzSelectTrigger>
                    <BzSelectContent>
                        <BzSelectItem Value="blazor">Blazor</BzSelectItem>
                        <BzSelectItem Value="maui">MAUI</BzSelectItem>
                        <BzSelectItem Value="aspnet">ASP.NET Core</BzSelectItem>
                    </BzSelectContent>
                </BzSelect>
            </BzField>
            <BzField>
                <BzFieldLabel>Visibility</BzFieldLabel>
                <BzRadioGroup @bind-Value="_visibility">
                    <div class="flex items-center gap-2"><BzRadioGroupItem id="cp-pub" Value="public" /><BzLabel For="cp-pub">Public</BzLabel></div>
                    <div class="flex items-center gap-2"><BzRadioGroupItem id="cp-priv" Value="private" /><BzLabel For="cp-priv">Private</BzLabel></div>
                </BzRadioGroup>
            </BzField>
            <BzField Orientation="FieldOrientation.Horizontal">
                <BzFieldControl Context="ctl">
                    <BzSwitch @attributes="ctl" @bind-Checked="_autoDeploy" />
                </BzFieldControl>
                <BzFieldContent>
                    <BzFieldLabel>Auto-deploy</BzFieldLabel>
                    <BzFieldDescription>Push to main deploys automatically.</BzFieldDescription>
                </BzFieldContent>
            </BzField>
            <BzField>
                <BzFieldLabel>Instances: @_instances</BzFieldLabel>
                <BzSlider @bind-Value="_instances" Max="10" Step="1" AriaLabel="Instances" />
            </BzField>
            <BzField Orientation="FieldOrientation.Horizontal">
                <BzFieldControl Context="ctl">
                    <BzCheckbox @attributes="ctl" DefaultChecked="CheckedState.Checked" />
                </BzFieldControl>
                <BzFieldContent>
                    <BzFieldLabel>Accept terms and conditions</BzFieldLabel>
                </BzFieldContent>
            </BzField>
        </BzFieldGroup>
    </BzCardContent>
    <BzCardFooter Class="gap-2">
        <BzButton Variant="ButtonVariant.Outline" Class="flex-1">Cancel</BzButton>
        <BzButton Class="flex-1">Deploy</BzButton>
    </BzCardFooter>
</BzCard>

<BzCard>
    <BzCardHeader>
        <BzCardTitle>Button variants</BzCardTitle>
    </BzCardHeader>
    <BzCardContent Class="flex flex-wrap gap-2">
        <BzButton>Default</BzButton>
        <BzButton Variant="ButtonVariant.Secondary">Secondary</BzButton>
        <BzButton Variant="ButtonVariant.Outline">Outline</BzButton>
        <BzButton Variant="ButtonVariant.Ghost">Ghost</BzButton>
        <BzButton Variant="ButtonVariant.Destructive">Destructive</BzButton>
        <BzButton Variant="ButtonVariant.Link">Link</BzButton>
    </BzCardContent>
</BzCard>

@code {
    private string? _name;
    private string _visibility = "public";
    private bool _autoDeploy = true;
    private double _instances = 3;
}
