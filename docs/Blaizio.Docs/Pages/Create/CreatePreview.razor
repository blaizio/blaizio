@*
    The live canvas: a strip of fixed-width columns of real components, intentionally wider than
    the viewport (w-max) so the page's overflow-x-auto container shows a horizontal scrollbar
    inside the visible viewport. Every column re-skins live as the rail's knobs flip html classes.
*@
<div class="flex w-max items-start gap-4 p-6">
    <div class="flex w-[340px] shrink-0 flex-col gap-4">
        <PreviewChart />
    </div>
    <div class="flex w-[340px] shrink-0 flex-col gap-4">
        <PreviewChat />
        <PreviewCookies />
    </div>
    <div class="flex w-[340px] shrink-0 flex-col gap-4">
        <PreviewForm />
    </div>
    <div class="flex w-[340px] shrink-0 flex-col gap-4">
        <PreviewPayment />
        <PreviewTeam />
    </div>
    <div class="flex w-[340px] shrink-0 flex-col gap-4">
        <PreviewStats />
    </div>
    <div class="flex w-[360px] shrink-0 flex-col gap-4">
        <PreviewTable />
        <PreviewOverlays />
    </div>
    <div class="flex w-[340px] shrink-0 flex-col gap-4">
        <PreviewCalendar />
        <PreviewNotifications />
    </div>
    <div class="flex w-[340px] shrink-0 flex-col gap-4">
        <PreviewAuth />
    </div>
    <div class="flex w-[340px] shrink-0 flex-col gap-4">
        <PreviewControls />
    </div>
</div>
