@*
    The Themes control rail - a dumb component: all state lives in CreatePage, every knob just
    raises its callback. One contained panel: a Menu of actions up top, then
    card-like selector rows grouped by section, each opening a dropdown of options to the
    inline-end (off the panel, over the canvas). Every option dropdown stays OPEN after a pick
    (OnSelect PreventDefault) so you can compare skins/palettes without reopening; only the Menu
    closes on select. Mode and direction live in the site header ("D" toggles light/dark).
*@
@* data-bz-portal-frame: the rail's dropdown surfaces body-portal on open - the frame keeps them
   pinned to the default look out there instead of picking up the previewed skin. *@
<div class="bz-theme-base flex flex-col rounded-2xl border border-primary/30 bg-card p-3 shadow-sm"
     data-bz-portal-frame="bz-theme-base">
    @* Mobile (Compact): every selector becomes a pill on ONE horizontal scroll row; the section
       separators hide and the groups dissolve (contents). Desktop keeps the vertical rail. *@
    <div class="max-md:flex max-md:items-stretch max-md:gap-2 max-md:overflow-x-auto max-md:pb-1 md:contents">
    <BzDropdownMenu>
        <BzDropdownMenuTrigger>
            <RenderAs Context="p">
                <button type="button" @attributes="p.Attributes" class="@RowClass">
                    <span class="text-sm font-semibold">Menu</span>
                    <BzIcon Icon="@Icons.Outline.Menu" Class="size-4.5 shrink-0 text-muted-foreground" />
                </button>
            </RenderAs>
        </BzDropdownMenuTrigger>
        <BzDropdownMenuContent Side="@OptionSide" Align="Align.Start" Class="w-56">
            <BzDropdownMenuItem OnSelect="_ => Navigate.InvokeAsync()">
                Search components... <BzDropdownMenuShortcut><BzKbd Key="c" /></BzDropdownMenuShortcut>
            </BzDropdownMenuItem>
            <BzDropdownMenuItem OnSelect="_ => OpenPreset.InvokeAsync()">
                Open Preset... <BzDropdownMenuShortcut><BzKbd Key="o" /></BzDropdownMenuShortcut>
            </BzDropdownMenuItem>
            <BzDropdownMenuItem OnSelect="_ => Shuffle.InvokeAsync()">
                Shuffle <BzDropdownMenuShortcut><BzKbd Key="s" /></BzDropdownMenuShortcut>
            </BzDropdownMenuItem>
            <BzDropdownMenuSeparator />
            <BzDropdownMenuItem Disabled="@(!CanUndo)" OnSelect="_ => Undo.InvokeAsync()">
                Undo <BzDropdownMenuShortcut><BzKbd Key="mod+z" /></BzDropdownMenuShortcut>
            </BzDropdownMenuItem>
            <BzDropdownMenuItem Disabled="@(!CanRedo)" OnSelect="_ => Redo.InvokeAsync()">
                Redo <BzDropdownMenuShortcut><BzKbd Key="mod+shift+z" /></BzDropdownMenuShortcut>
            </BzDropdownMenuItem>
            <BzDropdownMenuSeparator />
            <BzDropdownMenuItem Variant="DropdownMenuItemVariant.Destructive" OnSelect="_ => Reset.InvokeAsync()">
                Reset <BzDropdownMenuShortcut><BzKbd Key="r" /></BzDropdownMenuShortcut>
            </BzDropdownMenuItem>
        </BzDropdownMenuContent>
    </BzDropdownMenu>

    <BzSeparator Class="my-3 max-md:hidden" />

    <div class="flex items-center gap-1 max-md:shrink-0">
    @LockFor("style", "Style")
    <div class="min-w-0 flex-1">
    <BzDropdownMenu>
        <BzDropdownMenuTrigger>
            <RenderAs Context="p">
                <button type="button" @attributes="p.Attributes" class="@RowClass">
                    <span class="flex min-w-0 flex-col">
                        <span class="text-[0.7rem] text-muted-foreground">Style</span>
                        <span class="truncate text-sm font-medium">@DocsThemes.Label(DocsThemes.Styles, Style)</span>
                    </span>
                    <BzIcon Icon="@Icons.Outline.BorderStyle" Class="size-4 shrink-0 text-muted-foreground" />
                </button>
            </RenderAs>
        </BzDropdownMenuTrigger>
        <BzDropdownMenuContent Side="@OptionSide" Align="Align.Start" Class="w-52"
                               @onpointerleave='() => EndPreview("style")'>
            <BzDropdownMenuRadioGroup Value="@Style" ValueChanged="v => StyleChanged.InvokeAsync(v)">
                @foreach (var (value, label) in DocsThemes.Styles)
                {
                    var v = value;
                    <BzDropdownMenuRadioItem Value="@v" OnSelect="KeepOpen"
                                             @onpointerenter='() => Preview.InvokeAsync(("style", v))'>@label</BzDropdownMenuRadioItem>
                }
            </BzDropdownMenuRadioGroup>
        </BzDropdownMenuContent>
    </BzDropdownMenu>
    </div>
    </div>

    <BzSeparator Class="my-3 max-md:hidden" />

    <div class="flex flex-col gap-2 max-md:contents">
        <div class="flex items-center gap-1 max-md:shrink-0">
        @LockFor("preset", "Theme")
        <div class="min-w-0 flex-1">
        <BzDropdownMenu>
            <BzDropdownMenuTrigger>
                <RenderAs Context="p">
                    <button type="button" @attributes="p.Attributes" class="@RowClass">
                        <span class="flex min-w-0 flex-col">
                            <span class="text-[0.7rem] text-muted-foreground">Theme</span>
                            <span class="truncate text-sm font-medium">@SelectedPreset.Label</span>
                        </span>
                        <span class="flex shrink-0 -space-x-1">
                            @foreach (var color in SelectedPreset.Swatches)
                            {
                                <span class="size-3.5 rounded-full ring-1 ring-card" style="background:@color"></span>
                            }
                        </span>
                    </button>
                </RenderAs>
            </BzDropdownMenuTrigger>
            <BzDropdownMenuContent Side="@OptionSide" Align="Align.Start" Class="w-56"
                                   @onpointerleave='() => EndPreview("preset")'>
                <BzDropdownMenuRadioGroup Value="@Preset" ValueChanged="v => PresetChanged.InvokeAsync(v)">
                    @foreach (var p in Presets.All)
                    {
                        var name = p.Name;
                        <BzDropdownMenuRadioItem Value="@name" OnSelect="KeepOpen"
                                                 @onpointerenter='() => Preview.InvokeAsync(("preset", name))'>
                            <span class="flex -space-x-1">
                                @foreach (var color in p.Swatches)
                                {
                                    <span class="size-3.5 rounded-full ring-1 ring-popover" style="background:@color"></span>
                                }
                            </span>
                            @p.Label
                        </BzDropdownMenuRadioItem>
                    }
                </BzDropdownMenuRadioGroup>
            </BzDropdownMenuContent>
        </BzDropdownMenu>
        </div>
        </div>

        <div class="flex items-center gap-1 max-md:shrink-0">
        @LockFor("chart", "Chart Color")
        <div class="min-w-0 flex-1">
        <BzDropdownMenu>
            <BzDropdownMenuTrigger>
                <RenderAs Context="p">
                    <button type="button" @attributes="p.Attributes" class="@RowClass">
                        <span class="flex min-w-0 flex-col">
                            <span class="text-[0.7rem] text-muted-foreground">Chart Color</span>
                            <span class="truncate text-sm font-medium">@SelectedChart.Label</span>
                        </span>
                        <span class="flex shrink-0 -space-x-1">
                            @foreach (var color in SelectedChart.Colors)
                            {
                                <span class="size-3.5 rounded-full ring-1 ring-card" style="background:@color"></span>
                            }
                        </span>
                    </button>
                </RenderAs>
            </BzDropdownMenuTrigger>
            <BzDropdownMenuContent Side="@OptionSide" Align="Align.Start" Class="w-56"
                                   @onpointerleave='() => EndPreview("chart")'>
                <BzDropdownMenuRadioGroup Value="@Chart" ValueChanged="v => ChartChanged.InvokeAsync(v)">
                    @foreach (var p in DocsThemes.ChartPalettes)
                    {
                        var name = p.Name;
                        <BzDropdownMenuRadioItem Value="@name" OnSelect="KeepOpen"
                                                 @onpointerenter='() => Preview.InvokeAsync(("chart", name))'>
                            <span class="flex -space-x-1">
                                @foreach (var color in p.Colors)
                                {
                                    <span class="size-3.5 rounded-full ring-1 ring-popover" style="background:@color"></span>
                                }
                            </span>
                            @p.Label
                        </BzDropdownMenuRadioItem>
                    }
                </BzDropdownMenuRadioGroup>
            </BzDropdownMenuContent>
        </BzDropdownMenu>
        </div>
        </div>
    </div>

    <BzSeparator Class="my-3 max-md:hidden" />

    <div class="flex flex-col gap-2 max-md:contents">
        <div class="flex items-center gap-1 max-md:shrink-0">
        @LockFor("heading", "Heading")
        <div class="min-w-0 flex-1">
        <BzDropdownMenu>
            <BzDropdownMenuTrigger>
                <RenderAs Context="p">
                    <button type="button" @attributes="p.Attributes" class="@RowClass">
                        <span class="flex min-w-0 flex-col">
                            <span class="text-[0.7rem] text-muted-foreground">Heading</span>
                            <span class="truncate text-sm font-medium">@SelectedHeading.Label</span>
                        </span>
                        <span class="shrink-0 text-sm text-muted-foreground" style="font-family:@SelectedHeading.Stack">Aa</span>
                    </button>
                </RenderAs>
            </BzDropdownMenuTrigger>
            <BzDropdownMenuContent Side="@OptionSide" Align="Align.Start" Class="scrollbar-thin max-h-96 w-52 overflow-y-auto"
                                   @onpointerleave='() => EndPreview("heading")'>
                <BzDropdownMenuRadioGroup Value="@Heading" ValueChanged="v => HeadingChanged.InvokeAsync(v)">
                    @FontOptionsFor("heading")
                </BzDropdownMenuRadioGroup>
            </BzDropdownMenuContent>
        </BzDropdownMenu>
        </div>
        </div>

        <div class="flex items-center gap-1 max-md:shrink-0">
        @LockFor("font", "Font")
        <div class="min-w-0 flex-1">
        <BzDropdownMenu>
            <BzDropdownMenuTrigger>
                <RenderAs Context="p">
                    <button type="button" @attributes="p.Attributes" class="@RowClass">
                        <span class="flex min-w-0 flex-col">
                            <span class="text-[0.7rem] text-muted-foreground">Font</span>
                            <span class="truncate text-sm font-medium">@SelectedFont.Label</span>
                        </span>
                        <span class="shrink-0 text-sm text-muted-foreground" style="font-family:@SelectedFont.Stack">Aa</span>
                    </button>
                </RenderAs>
            </BzDropdownMenuTrigger>
            <BzDropdownMenuContent Side="@OptionSide" Align="Align.Start" Class="scrollbar-thin max-h-96 w-52 overflow-y-auto"
                                   @onpointerleave='() => EndPreview("font")'>
                <BzDropdownMenuRadioGroup Value="@Font" ValueChanged="v => FontChanged.InvokeAsync(v)">
                    @FontOptionsFor("font")
                </BzDropdownMenuRadioGroup>
            </BzDropdownMenuContent>
        </BzDropdownMenu>
        </div>
        </div>
    </div>

    <BzSeparator Class="my-3 max-md:hidden" />

    <div class="flex flex-col gap-2 max-md:contents">
        <BzDropdownMenu>
            <BzDropdownMenuTrigger>
                <RenderAs Context="p">
                    <button type="button" @attributes="p.Attributes" class="@RowClass">
                        <span class="flex min-w-0 flex-col">
                            <span class="text-[0.7rem] text-muted-foreground">Icon Library</span>
                            <span class="truncate text-sm font-medium">Tabler</span>
                        </span>
                        <BzIcon Icon="@Icons.Outline.Galaxy" Class="size-4 shrink-0 text-muted-foreground" />
                    </button>
                </RenderAs>
            </BzDropdownMenuTrigger>
            <BzDropdownMenuContent Side="@OptionSide" Align="Align.Start" Class="w-52">
                @* Blaizio ships one icon set today; the row keeps the slot visible (and honest). *@
                <BzDropdownMenuRadioGroup Value="tabler">
                    <BzDropdownMenuRadioItem Value="tabler" OnSelect="KeepOpen">Tabler Icons</BzDropdownMenuRadioItem>
                </BzDropdownMenuRadioGroup>
                <BzDropdownMenuItem Disabled>More coming soon</BzDropdownMenuItem>
            </BzDropdownMenuContent>
        </BzDropdownMenu>

        <div class="flex items-center gap-1 max-md:shrink-0">
        @LockFor("radius", "Radius")
        <div class="min-w-0 flex-1">
        <BzDropdownMenu>
            <BzDropdownMenuTrigger>
                <RenderAs Context="p">
                    <button type="button" @attributes="p.Attributes" class="@RowClass">
                        <span class="flex min-w-0 flex-col">
                            <span class="text-[0.7rem] text-muted-foreground">Radius</span>
                            <span class="truncate text-sm font-medium">@DocsThemes.Label(DocsThemes.Radii, Radius)</span>
                        </span>
                        <BzIcon Icon="@Icons.Outline.RadiusTopLeft" Class="size-4 shrink-0 text-muted-foreground" />
                    </button>
                </RenderAs>
            </BzDropdownMenuTrigger>
            <BzDropdownMenuContent Side="@OptionSide" Align="Align.Start" Class="w-52"
                                   @onpointerleave='() => EndPreview("radius")'>
                <BzDropdownMenuRadioGroup Value="@Radius" ValueChanged="v => RadiusChanged.InvokeAsync(v)">
                    @foreach (var (value, label) in DocsThemes.Radii)
                    {
                        var v = value;
                        <BzDropdownMenuRadioItem Value="@v" OnSelect="KeepOpen"
                                                 @onpointerenter='() => Preview.InvokeAsync(("radius", v))'>@label</BzDropdownMenuRadioItem>
                    }
                </BzDropdownMenuRadioGroup>
            </BzDropdownMenuContent>
        </BzDropdownMenu>
        </div>
        </div>
    </div>

    </div>

    <BzSeparator Class="my-3 max-md:hidden" />

    @* Actions: a vertical stack on desktop; on mobile a preset/Open/Shuffle row under the pills
       plus a full-width Get Code (the header's Get Code hides below md). *@
    <div class="flex flex-col gap-2 max-md:mt-2">
        <div class="flex flex-col gap-2 max-md:flex-row max-md:items-stretch">
            <BzTooltip>
                <BzTooltipTrigger>
                    <RenderAs Context="p">
                        <BzButton @attributes="p.Attributes" Variant="ButtonVariant.Outline" Class="max-md:min-w-0 max-md:flex-1" @onclick="CopyCode">
                            <BzIcon Icon="@Icons.Outline.Copy" Class="size-3.5 text-muted-foreground max-md:hidden" />
                            <span class="truncate font-mono text-xs">--preset @Code</span>
                        </BzButton>
                    </RenderAs>
                </BzTooltipTrigger>
                <BzTooltipContent>Copy this preset's code<BzTooltipArrow /></BzTooltipContent>
            </BzTooltip>
            <BzButton Variant="ButtonVariant.Outline" Class="max-md:shrink-0" @onclick="OpenPreset">
                <span class="md:hidden">Open</span><span class="max-md:hidden">Open Preset</span>
            </BzButton>
            <BzButton Variant="ButtonVariant.Outline" Class="max-md:shrink-0" @onclick="Shuffle">
                <BzIcon Icon="@Icons.Outline.ArrowsShuffle" Class="size-4 max-md:hidden" /> Shuffle
            </BzButton>
        </div>
        <BzButton @onclick="GetCode">Get Code</BzButton>
    </div>
</div>

@code {
    /// <summary>Mobile arrangement: the rail is a bottom bar, so the option dropdowns open UP
    /// (over the canvas) instead of to the inline-end. Driven by CreatePage's breakpoint watcher.</summary>
    [Parameter] public bool Compact { get; set; }

    private Side OptionSide => Compact ? Side.Top : Side.Right;

    [Parameter] public string Style { get; set; } = "ember";
    [Parameter] public string Preset { get; set; } = "nova";
    [Parameter] public string Chart { get; set; } = "default";
    [Parameter] public string Heading { get; set; } = "default";
    [Parameter] public string Font { get; set; } = "default";
    [Parameter] public string Radius { get; set; } = "default";
    [Parameter] public EventCallback<string> StyleChanged { get; set; }
    [Parameter] public EventCallback<string> PresetChanged { get; set; }
    [Parameter] public EventCallback<string> ChartChanged { get; set; }
    [Parameter] public EventCallback<string> HeadingChanged { get; set; }
    [Parameter] public EventCallback<string> FontChanged { get; set; }
    [Parameter] public EventCallback<string> RadiusChanged { get; set; }
    /// <summary>Knob names ("style", "preset", "chart", "heading", "font", "radius") the user has
    /// locked: Shuffle skips them and a theme pick leaves their pairing knobs alone.</summary>
    [Parameter] public IReadOnlySet<string> Locks { get; set; } = new HashSet<string>();
    [Parameter] public EventCallback<string> ToggleLock { get; set; }
    [Parameter] public EventCallback Navigate { get; set; }
    [Parameter] public EventCallback OpenPreset { get; set; }
    [Parameter] public EventCallback Shuffle { get; set; }
    [Parameter] public EventCallback Undo { get; set; }
    [Parameter] public EventCallback Redo { get; set; }
    [Parameter] public EventCallback Reset { get; set; }
    [Parameter] public EventCallback GetCode { get; set; }
    [Parameter] public EventCallback CopyCode { get; set; }
    [Parameter] public bool CanUndo { get; set; }
    [Parameter] public bool CanRedo { get; set; }

    /// <summary>The current selection's shareable code (computed by CreatePage - dir included).</summary>
    [Parameter] public string Code { get; set; } = "00";

    /// <summary>Hover preview: fires (knob, value) while an option is hovered and (knob, null)
    /// when the pointer leaves the menu - the page re-applies the recorded selection.</summary>
    [Parameter] public EventCallback<(string Knob, string? Value)> Preview { get; set; }

    private Task EndPreview(string knob) => Preview.InvokeAsync((knob, null));

    private PresetEntry SelectedPreset => Presets.Find(Preset) ?? Presets.All[0];
    private ChartPaletteEntry SelectedChart => DocsThemes.FindChart(Chart);
    private FontEntry SelectedHeading => DocsThemes.FindFont(Heading);
    private FontEntry SelectedFont => DocsThemes.FindFont(Font);

    /// <summary>The Heading and Font dropdowns share one option list: "Default" (leave the app's
    /// font alone) then the offered webfonts grouped by shape. Retired system stacks stay out -
    /// old preset codes still decode them, but no new pick can produce one.</summary>
    private static readonly (string Label, FontDefinition[] Fonts)[] FontGroups =
    [
        ("", [FontCatalog.All[0]]),
        ("Sans", [.. FontCatalog.All.Where(f => f is { Offered: true, Kind: FontKind.Sans })]),
        ("Serif", [.. FontCatalog.All.Where(f => f is { Offered: true, Kind: FontKind.Serif })]),
        ("Mono", [.. FontCatalog.All.Where(f => f is { Offered: true, Kind: FontKind.Mono })]),
    ];

    private RenderFragment FontOptionsFor(string knob) => __builder =>
    {
        foreach (var (label, fonts) in FontGroups)
        {
            if (label.Length > 0)
            {
                <BzDropdownMenuLabel>@label</BzDropdownMenuLabel>
            }
            foreach (var f in fonts)
            {
                var name = f.Name;
                <BzDropdownMenuRadioItem Value="@name" OnSelect="KeepOpen"
                                         @onpointerenter='() => Preview.InvokeAsync((knob, name))'>
                    <span style="font-family:@f.Stack">@f.Title</span>
                </BzDropdownMenuRadioItem>
            }
        }
    };

    // Every option dropdown keeps the menu open after a pick so several skins/palettes can be
    // compared without reopening; the value still updates (the group's ValueChanged fires first).
    private static void KeepOpen(MenuSelectEventArgs e) => e.PreventDefault();

    /// <summary>The lock toggle beside a selector row. Locked = Shuffle and theme pairings leave
    /// the knob alone; picking from its own dropdown still works (opening it is intentional).</summary>
    private RenderFragment LockFor(string knob, string label) => __builder =>
    {
        var locked = Locks.Contains(knob);
        @* A pressed/unpressed icon control is exactly BzToggle: it owns aria-pressed, the pressed
           fill and the focus ring, so the knob only says what it means. *@
        <BzToggle Size="ToggleSize.Sm" Pressed="locked"
                  PressedChanged="_ => ToggleLock.InvokeAsync(knob)"
                  aria-label="@($"{(locked ? "Unlock" : "Lock")} {label}")"
                  Class="@LockClass">
            <BzIcon Icon="@(locked ? Icons.Outline.Lock : Icons.Outline.LockOpen2)" Class="size-3.5" />
        </BzToggle>
    };

    // Only the bits BzToggle can't know: it sits in a row of its own size, and its resting ink is
    // quieter than a standalone toggle's. Pressed fill, hover and focus ring are the toggle's.
    private const string LockClass = "size-7 shrink-0 text-muted-foreground/60";

    // The selector rows are custom buttons, so they need an explicit theme-aware focus ring for
    // keyboard (Tab) users - --ring follows the active preset.
    private const string RowClass =
        "flex w-full items-center justify-between gap-2 rounded-xl border bg-background/50 px-3 py-2 text-start " +
        "max-md:w-auto max-md:min-w-32 max-md:shrink-0 " +
        "transition-colors hover:border-primary/50 aria-expanded:border-primary/60 " +
        "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-card";
}
