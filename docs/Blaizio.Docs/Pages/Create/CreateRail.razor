@*
    The Themes control dock - a dumb component pinned to the bottom of the viewport on every
    breakpoint: all state lives in CreatePage, every knob raises its callback. One horizontal
    bar: selector knobs (dropdowns opening UP over the canvas, each knob's lock INSIDE the row
    before its trailing icon), the token strip (every editable theme token as a swatch whose
    popover holds a live color picker with an AA/AAA readout), then the action cluster at the
    inline end - Shuffle beside the three-dot menu (which holds the meta actions and Undo/Redo),
    Get Code underneath. Every option dropdown stays OPEN after a pick (OnSelect PreventDefault)
    so looks can be compared without reopening. Mode and direction live in the site header.

    The dock is PINNED to the default look (bz-theme-base), so the token swatches cannot read
    var(--token) - inside the pin those resolve to the base palette, not the previewed theme.
    CreatePage feeds the real computed values through TokenValues after every document write.
*@
@* data-bz-portal-frame: the dock's dropdown/popover surfaces body-portal on open - the frame
   keeps them pinned to the default look out there instead of picking up the previewed skin.
   Below md the bar becomes ONE horizontally swipeable row (no wrapping): touch scroll covers
   what the desktop's width does, and the dock stays a single compact strip. *@
<div class="bz-theme-base scrollbar-hover flex flex-wrap items-end gap-x-4 gap-y-2
            max-md:flex-nowrap max-md:items-center max-md:overflow-x-auto max-md:pb-1 max-md:*:shrink-0"
     data-bz-portal-frame="bz-theme-base">

    <BzDropdownMenu>
        <div class="@RowShell">
            <BzDropdownMenuTrigger>
                <RenderAs Context="p">
                    <button type="button" @attributes="p.Attributes" class="@RowTrigger">
                        <span class="text-[0.7rem] text-muted-foreground">Theme</span>
                        <span class="truncate text-sm font-medium">@SelectedPreset.Label</span>
                    </button>
                </RenderAs>
            </BzDropdownMenuTrigger>
            <span class="flex shrink-0 -space-x-1">
                @foreach (var color in SelectedPreset.Swatches)
                {
                    <span class="size-3.5 rounded-full ring-1 ring-card" style="background:@color"></span>
                }
            </span>
        </div>
        <BzDropdownMenuContent Side="Side.Top" Align="Align.Start" Class="w-56"
                               @onpointerleave='() => EndPreview("preset")'>
            <BzDropdownMenuRadioGroup Value="@Preset" ValueChanged="v => PresetChanged.InvokeAsync(v)">
                @foreach (var p in Presets.All)
                {
                    var name = p.Name;
                    <BzDropdownMenuRadioItem Value="@name" OnSelect="KeepOpen"
                                             @onpointerenter='() => Preview.InvokeAsync(("preset", name))'>
                        <span class="flex -space-x-1">
                            @foreach (var color in p.Swatches)
                            {
                                <span class="size-3.5 rounded-full ring-1 ring-popover" style="background:@color"></span>
                            }
                        </span>
                        @p.Label
                    </BzDropdownMenuRadioItem>
                }
            </BzDropdownMenuRadioGroup>
        </BzDropdownMenuContent>
    </BzDropdownMenu>

    <div class="flex flex-col gap-1">
        <span class="flex items-center gap-1 text-[0.7rem] text-muted-foreground">
            @LockFor("colors", "Colors")
            Colors - click a token to edit
        </span>
        @* Width-capped so the 16 swatches wrap into two rows of 8 on desktop; on the mobile
           strip they stay a single swipeable run. *@
        <div class="flex max-w-56 flex-wrap gap-1 max-md:max-w-none max-md:flex-nowrap">
            @foreach (var token in ThemeTokens.All)
            {
                @TokenSwatch(token)
            }
        </div>
    </div>

    <BzDropdownMenu>
        <div class="@RowShell">
            <BzDropdownMenuTrigger>
                <RenderAs Context="p">
                    <button type="button" @attributes="p.Attributes" class="@RowTrigger">
                        <span class="text-[0.7rem] text-muted-foreground">Charts</span>
                        <span class="truncate text-sm font-medium">@SelectedChart.Label</span>
                    </button>
                </RenderAs>
            </BzDropdownMenuTrigger>
            @LockFor("chart", "Chart Color")
            <span class="flex shrink-0 -space-x-1">
                @foreach (var color in SelectedChart.Colors)
                {
                    <span class="size-3.5 rounded-full ring-1 ring-card" style="background:@color"></span>
                }
            </span>
        </div>
        <BzDropdownMenuContent Side="Side.Top" Align="Align.Start" Class="w-56"
                               @onpointerleave='() => EndPreview("chart")'>
            <BzDropdownMenuRadioGroup Value="@Chart" ValueChanged="v => ChartChanged.InvokeAsync(v)">
                @foreach (var p in DocsThemes.ChartPalettes)
                {
                    var name = p.Name;
                    <BzDropdownMenuRadioItem Value="@name" OnSelect="KeepOpen"
                                             @onpointerenter='() => Preview.InvokeAsync(("chart", name))'>
                        <span class="flex -space-x-1">
                            @foreach (var color in p.Colors)
                            {
                                <span class="size-3.5 rounded-full ring-1 ring-popover" style="background:@color"></span>
                            }
                        </span>
                        @p.Label
                    </BzDropdownMenuRadioItem>
                }
            </BzDropdownMenuRadioGroup>
        </BzDropdownMenuContent>
    </BzDropdownMenu>

    <BzDropdownMenu>
        <div class="@RowShell">
            <BzDropdownMenuTrigger>
                <RenderAs Context="p">
                    <button type="button" @attributes="p.Attributes" class="@RowTrigger">
                        <span class="text-[0.7rem] text-muted-foreground">Style</span>
                        <span class="truncate text-sm font-medium">@DocsThemes.Label(DocsThemes.Styles, Style)</span>
                    </button>
                </RenderAs>
            </BzDropdownMenuTrigger>
            @LockFor("style", "Style")
            <BzIcon Icon="@Icons.Outline.BorderStyle" Class="size-4 shrink-0 text-muted-foreground" />
        </div>
        <BzDropdownMenuContent Side="Side.Top" Align="Align.Start" Class="w-52"
                               @onpointerleave='() => EndPreview("style")'>
            <BzDropdownMenuRadioGroup Value="@Style" ValueChanged="v => StyleChanged.InvokeAsync(v)">
                @foreach (var (value, label) in DocsThemes.Styles)
                {
                    var v = value;
                    <BzDropdownMenuRadioItem Value="@v" OnSelect="KeepOpen"
                                             @onpointerenter='() => Preview.InvokeAsync(("style", v))'>@label</BzDropdownMenuRadioItem>
                }
            </BzDropdownMenuRadioGroup>
        </BzDropdownMenuContent>
    </BzDropdownMenu>

    <BzDropdownMenu>
        <div class="@RowShell">
            <BzDropdownMenuTrigger>
                <RenderAs Context="p">
                    <button type="button" @attributes="p.Attributes" class="@RowTrigger">
                        <span class="text-[0.7rem] text-muted-foreground">Heading</span>
                        <span class="truncate text-sm font-medium">@SelectedHeading.Label</span>
                    </button>
                </RenderAs>
            </BzDropdownMenuTrigger>
            @LockFor("heading", "Heading")
            <span class="shrink-0 text-sm text-muted-foreground" style="font-family:@SelectedHeading.Stack">Aa</span>
        </div>
        <BzDropdownMenuContent Side="Side.Top" Align="Align.Start" Class="scrollbar-thin max-h-96 w-52 overflow-y-auto"
                               @onpointerleave='() => EndPreview("heading")'>
            <BzDropdownMenuRadioGroup Value="@Heading" ValueChanged="v => HeadingChanged.InvokeAsync(v)">
                @FontOptionsFor("heading")
            </BzDropdownMenuRadioGroup>
        </BzDropdownMenuContent>
    </BzDropdownMenu>

    <BzDropdownMenu>
        <div class="@RowShell">
            <BzDropdownMenuTrigger>
                <RenderAs Context="p">
                    <button type="button" @attributes="p.Attributes" class="@RowTrigger">
                        <span class="text-[0.7rem] text-muted-foreground">Font</span>
                        <span class="truncate text-sm font-medium">@SelectedFont.Label</span>
                    </button>
                </RenderAs>
            </BzDropdownMenuTrigger>
            @LockFor("font", "Font")
            <span class="shrink-0 text-sm text-muted-foreground" style="font-family:@SelectedFont.Stack">Aa</span>
        </div>
        <BzDropdownMenuContent Side="Side.Top" Align="Align.Start" Class="scrollbar-thin max-h-96 w-52 overflow-y-auto"
                               @onpointerleave='() => EndPreview("font")'>
            <BzDropdownMenuRadioGroup Value="@Font" ValueChanged="v => FontChanged.InvokeAsync(v)">
                @FontOptionsFor("font")
            </BzDropdownMenuRadioGroup>
        </BzDropdownMenuContent>
    </BzDropdownMenu>

    <BzDropdownMenu>
        <div class="@RowShell">
            <BzDropdownMenuTrigger>
                <RenderAs Context="p">
                    <button type="button" @attributes="p.Attributes" class="@RowTrigger">
                        <span class="text-[0.7rem] text-muted-foreground">Radius</span>
                        <span class="truncate text-sm font-medium">@DocsThemes.Label(DocsThemes.Radii, Radius)</span>
                    </button>
                </RenderAs>
            </BzDropdownMenuTrigger>
            @LockFor("radius", "Radius")
            <BzIcon Icon="@Icons.Outline.RadiusTopLeft" Class="size-4 shrink-0 text-muted-foreground" />
        </div>
        <BzDropdownMenuContent Side="Side.Top" Align="Align.Start" Class="w-52"
                               @onpointerleave='() => EndPreview("radius")'>
            <BzDropdownMenuRadioGroup Value="@Radius" ValueChanged="v => RadiusChanged.InvokeAsync(v)">
                @foreach (var (value, label) in DocsThemes.Radii)
                {
                    var v = value;
                    <BzDropdownMenuRadioItem Value="@v" OnSelect="KeepOpen"
                                             @onpointerenter='() => Preview.InvokeAsync(("radius", v))'>@label</BzDropdownMenuRadioItem>
                }
            </BzDropdownMenuRadioGroup>
        </BzDropdownMenuContent>
    </BzDropdownMenu>

    @* Actions: the copy-code chip beside the three-dot menu (which holds the meta actions,
       Shuffle and Undo/Redo with their shortcuts), Get Code underneath. *@
    <div class="ms-auto flex flex-col items-stretch gap-1.5">
        <div class="flex gap-1.5">
            <BzTooltip>
                <BzTooltipTrigger>
                    <RenderAs Context="p">
                        <BzButton @attributes="p.Attributes" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                  Class="min-w-0 flex-1" @onclick="CopyCode">
                            <BzIcon Icon="@Icons.Outline.Copy" Class="size-3.5 shrink-0 text-muted-foreground" />
                            <span class="max-w-28 truncate font-mono text-xs">@Code</span>
                        </BzButton>
                    </RenderAs>
                </BzTooltipTrigger>
                <BzTooltipContent>Copy this preset's code<BzTooltipArrow /></BzTooltipContent>
            </BzTooltip>
            <BzDropdownMenu>
                <BzDropdownMenuTrigger>
                    <RenderAs Context="p">
                        <BzButton @attributes="p.Attributes" Variant="ButtonVariant.Outline" Size="ButtonSize.IconSm"
                                  aria-label="More actions">
                            <BzIcon Icon="@Icons.Outline.DotsVertical" Class="size-4" />
                        </BzButton>
                    </RenderAs>
                </BzDropdownMenuTrigger>
                <BzDropdownMenuContent Side="Side.Top" Align="Align.End" Class="w-56">
                    <BzDropdownMenuItem OnSelect="_ => Navigate.InvokeAsync()">
                        Search components... <BzDropdownMenuShortcut><BzKbd Key="c" /></BzDropdownMenuShortcut>
                    </BzDropdownMenuItem>
                    <BzDropdownMenuItem OnSelect="_ => OpenPreset.InvokeAsync()">
                        Open Preset... <BzDropdownMenuShortcut><BzKbd Key="o" /></BzDropdownMenuShortcut>
                    </BzDropdownMenuItem>
                    <BzDropdownMenuItem OnSelect="_ => Shuffle.InvokeAsync()">
                        Shuffle <BzDropdownMenuShortcut><BzKbd Key="s" /></BzDropdownMenuShortcut>
                    </BzDropdownMenuItem>
                    <BzDropdownMenuSeparator />
                    <BzDropdownMenuItem Disabled="@(!CanUndo)" OnSelect="_ => Undo.InvokeAsync()">
                        Undo <BzDropdownMenuShortcut><BzKbd Key="mod+z" /></BzDropdownMenuShortcut>
                    </BzDropdownMenuItem>
                    <BzDropdownMenuItem Disabled="@(!CanRedo)" OnSelect="_ => Redo.InvokeAsync()">
                        Redo <BzDropdownMenuShortcut><BzKbd Key="mod+shift+z" /></BzDropdownMenuShortcut>
                    </BzDropdownMenuItem>
                    <BzDropdownMenuSeparator />
                    <BzDropdownMenuItem Variant="DropdownMenuItemVariant.Destructive" OnSelect="_ => Reset.InvokeAsync()">
                        Reset <BzDropdownMenuShortcut><BzKbd Key="r" /></BzDropdownMenuShortcut>
                    </BzDropdownMenuItem>
                </BzDropdownMenuContent>
            </BzDropdownMenu>
        </div>
        <BzButton Size="ButtonSize.Sm" @onclick="GetCode">Get Code</BzButton>
    </div>
</div>

@code {
    [Parameter] public string Style { get; set; } = "ember";
    [Parameter] public string Preset { get; set; } = "nova";
    [Parameter] public string Chart { get; set; } = "default";
    [Parameter] public string Heading { get; set; } = "default";
    [Parameter] public string Font { get; set; } = "default";
    [Parameter] public string Radius { get; set; } = "default";
    [Parameter] public EventCallback<string> StyleChanged { get; set; }
    [Parameter] public EventCallback<string> PresetChanged { get; set; }
    [Parameter] public EventCallback<string> ChartChanged { get; set; }
    [Parameter] public EventCallback<string> HeadingChanged { get; set; }
    [Parameter] public EventCallback<string> FontChanged { get; set; }
    [Parameter] public EventCallback<string> RadiusChanged { get; set; }

    /// <summary>Knob names ("style", "colors", "chart", "heading", "font", "radius") the user has
    /// locked: Shuffle skips them and a theme pick leaves their pairing knobs alone.</summary>
    [Parameter] public IReadOnlySet<string> Locks { get; set; } = new HashSet<string>();
    [Parameter] public EventCallback<string> ToggleLock { get; set; }
    [Parameter] public EventCallback Navigate { get; set; }
    [Parameter] public EventCallback OpenPreset { get; set; }
    [Parameter] public EventCallback Shuffle { get; set; }
    [Parameter] public EventCallback Undo { get; set; }
    [Parameter] public EventCallback Redo { get; set; }
    [Parameter] public EventCallback Reset { get; set; }
    [Parameter] public EventCallback GetCode { get; set; }
    [Parameter] public EventCallback CopyCode { get; set; }
    [Parameter] public bool CanUndo { get; set; }
    [Parameter] public bool CanRedo { get; set; }

    /// <summary>The current selection's shareable code (computed by CreatePage - dir included).</summary>
    [Parameter] public string Code { get; set; } = "00";

    /// <summary>Hover preview: fires (knob, value) while an option is hovered and (knob, null)
    /// when the pointer leaves the menu - the page re-applies the recorded selection.</summary>
    [Parameter] public EventCallback<(string Knob, string? Value)> Preview { get; set; }

    // ---- Token editing ----

    /// <summary>The current edit set, so edited swatches can carry a marker.</summary>
    [Parameter] public IReadOnlyDictionary<(string Token, bool Dark), OklchColor> Overrides { get; set; } =
        new Dictionary<(string, bool), OklchColor>();

    /// <summary>The live computed value per token, fed by CreatePage after every document write -
    /// the dock is pinned to the base look, so var(--token) here would paint the WRONG palette.</summary>
    [Parameter] public IReadOnlyDictionary<string, string> TokenValues { get; set; } =
        new Dictionary<string, string>();

    /// <summary>Fetch the live edit context for a token (its computed value, the resolved mode
    /// and the background/foreground partners for the contrast readout).</summary>
    [Parameter] public Func<string, Task<TokenEditContext>>? TokenContext { get; set; }

    /// <summary>A committed pick in the token popover: (token, color, first commit since the
    /// popover opened - the page records history exactly once per editing session).</summary>
    [Parameter] public EventCallback<(string Token, OklchColor Color, bool FirstEdit)> TokenChanged { get; set; }

    /// <summary>Reset one token to the theme's own value (current mode).</summary>
    [Parameter] public EventCallback<string> TokenCleared { get; set; }

    private string? _editing;
    private TokenEditContext? _ctx;
    private string _seedValue = "";
    private bool _firstCommit;
    private OklchColor _current;

    private Task EndPreview(string knob) => Preview.InvokeAsync((knob, null));

    private PresetEntry SelectedPreset => Presets.Find(Preset) ?? Presets.All[0];
    private ChartPaletteEntry SelectedChart => DocsThemes.FindChart(Chart);
    private FontEntry SelectedHeading => DocsThemes.FindFont(Heading);
    private FontEntry SelectedFont => DocsThemes.FindFont(Font);

    private string SwatchFill(string token) =>
        TokenValues.TryGetValue(token, out var v) && v.Length > 0 ? v : $"var(--{token})";

    private RenderFragment TokenSwatch(string token) => __builder =>
    {
        var edited = Overrides.Keys.Any(k => k.Token == token);
        <BzPopover Open="@(_editing == token)" OpenChanged="open => OnPopoverChanged(token, open)">
            <BzPopoverTrigger>
                <RenderAs Context="p">
                    <button type="button" @attributes="p.Attributes" aria-label="@($"Edit --{token}")"
                            class="@($"size-6 rounded-md ring-inset transition-transform hover:scale-110 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring {(edited ? "ring-2 ring-primary" : "ring-1 ring-foreground/15")}")"
                            style="background: @SwatchFill(token)"></button>
                </RenderAs>
            </BzPopoverTrigger>
            <BzPopoverContent Side="Side.Top" Class="w-72 p-3">
                <div class="flex items-center justify-between pb-2">
                    <span class="font-mono text-xs">--@token</span>
                    <BzBadge Variant="BadgeVariant.Outline">@(_ctx?.IsDark == true ? "Dark" : "Light") mode</BzBadge>
                </div>
                @if (_ctx is { } ctx && _editing == token)
                {
                    @* Uncontrolled (DefaultValue, no Value feedback loop): live drags update only
                       the local contrast readout; the document write happens on commit (release),
                       so a drag is one URL/storage/stylesheet write instead of hundreds. *@
                    <BzColorPicker Format="ColorFormat.Oklch" DefaultValue="@_seedValue"
                                   ValueChanged="OnPickerChanged" OnValueCommit="OnPickerCommitted" />
                    <div class="flex items-center justify-between pt-2">
                        @ContrastBadge(token, ctx)
                        @if (edited)
                        {
                            <BzButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Xs" @onclick="() => ClearAsync(token)">
                                Reset token
                            </BzButton>
                        }
                    </div>
                }
                <BzPopoverArrow />
            </BzPopoverContent>
        </BzPopover>
    };

    // The AA/AAA readout: text-bearing surfaces grade their DERIVED label (which the edit also
    // writes); background/foreground grade against each other; border and the chart series grade
    // against the background under the 3:1 non-text rule.
    private RenderFragment ContrastBadge(string token, TokenEditContext ctx) => __builder =>
    {
        double ratio;
        double floor = 4.5;
        if (ThemeTokens.PairsWithForeground(token))
        {
            ratio = OklchColor.Contrast(_current, ThemeTokens.DeriveForeground(_current));
        }
        else if (token == "background")
        {
            ratio = OklchColor.Contrast(_current, ctx.Foreground);
        }
        else if (token == "foreground")
        {
            ratio = OklchColor.Contrast(_current, ctx.Background);
        }
        else
        {
            ratio = OklchColor.Contrast(_current, ctx.Background);
            floor = 3;
        }

        var label = ratio >= 7 && floor > 3 ? "AAA" : ratio >= floor ? (floor > 3 ? "AA" : "3:1") : "Low";
        var cls = ratio >= floor
            ? "bg-success/15 text-success"
            : "bg-destructive/15 text-destructive";
        <BzTooltip>
            <BzTooltipTrigger>
                <RenderAs Context="p">
                    <span @attributes="p.Attributes" tabindex="0"
                          class="@($"inline-flex items-center gap-1 rounded-full px-2 py-0.5 font-mono text-[11px] font-medium {cls}")">
                        @label @ratio.ToString("0.0")
                    </span>
                </RenderAs>
            </BzTooltipTrigger>
            <BzTooltipContent>@BadgeHint(token, floor)<BzTooltipArrow /></BzTooltipContent>
        </BzTooltip>
    };

    private static string BadgeHint(string token, double floor) => floor > 3
        ? ThemeTokens.PairsWithForeground(token)
            ? "Contrast of the auto-derived text on this fill (AA needs 4.5, AAA 7)"
            : "Contrast against the opposite text token (AA needs 4.5, AAA 7)"
        : "Non-text contrast against the background (needs 3:1)";

    private async Task OnPopoverChanged(string token, bool open)
    {
        if (!open)
        {
            if (_editing == token) (_editing, _ctx) = (null, null);
            return;
        }

        (_editing, _ctx, _firstCommit) = (token, null, true);
        StateHasChanged();
        if (TokenContext is not null)
        {
            _ctx = await TokenContext(token);
            _current = _ctx.Value;
            _seedValue = _ctx.Value.ToCss();
            StateHasChanged();
        }
    }

    // Live drag: only the local contrast readout follows. Nothing is written yet.
    private void OnPickerChanged(string value)
    {
        if (OklchColor.TryParseAny(value, out var color)) _current = color;
    }

    // Release / field commit: the one write per gesture.
    private async Task OnPickerCommitted(string value)
    {
        if (_editing is null || !OklchColor.TryParseAny(value, out var color)) return;
        _current = color;
        await TokenChanged.InvokeAsync((_editing, color, _firstCommit));
        _firstCommit = false;
    }

    private async Task ClearAsync(string token)
    {
        await TokenCleared.InvokeAsync(token);
        (_editing, _ctx) = (null, null);
    }

    /// <summary>The Heading and Font dropdowns share one option list: "Default" (leave the app's
    /// font alone) then the offered webfonts grouped by shape. Retired system stacks stay out -
    /// old preset codes still decode them, but no new pick can produce one.</summary>
    private static readonly (string Label, FontDefinition[] Fonts)[] FontGroups =
    [
        ("", [FontCatalog.All[0]]),
        ("Sans", [.. FontCatalog.All.Where(f => f is { Offered: true, Kind: FontKind.Sans })]),
        ("Serif", [.. FontCatalog.All.Where(f => f is { Offered: true, Kind: FontKind.Serif })]),
        ("Mono", [.. FontCatalog.All.Where(f => f is { Offered: true, Kind: FontKind.Mono })]),
    ];

    private RenderFragment FontOptionsFor(string knob) => __builder =>
    {
        foreach (var (label, fonts) in FontGroups)
        {
            if (label.Length > 0)
            {
                <BzDropdownMenuLabel>@label</BzDropdownMenuLabel>
            }
            foreach (var f in fonts)
            {
                var name = f.Name;
                <BzDropdownMenuRadioItem Value="@name" OnSelect="KeepOpen"
                                         @onpointerenter='() => Preview.InvokeAsync((knob, name))'>
                    <span style="font-family:@f.Stack">@f.Title</span>
                </BzDropdownMenuRadioItem>
            }
        }
    };

    // Every option dropdown keeps the menu open after a pick so several skins/palettes can be
    // compared without reopening; the value still updates (the group's ValueChanged fires first).
    private static void KeepOpen(MenuSelectEventArgs e) => e.PreventDefault();

    /// <summary>The lock toggle inside a knob row (before its trailing icon). Locked = Shuffle
    /// and theme pairings leave the knob alone; picking from its own dropdown still works.</summary>
    private RenderFragment LockFor(string knob, string label) => __builder =>
    {
        var locked = Locks.Contains(knob);
        <BzToggle Size="ToggleSize.Sm" Pressed="locked"
                  PressedChanged="_ => ToggleLock.InvokeAsync(knob)"
                  aria-label="@($"{(locked ? "Unlock" : "Lock")} {label}")"
                  Class="@LockClass">
            <BzIcon Icon="@(locked ? Icons.Outline.Lock : Icons.Outline.LockOpen2)" Class="size-3.5" />
        </BzToggle>
    };

    private const string LockClass = "size-6 shrink-0 text-muted-foreground/60";

    // The knob row: the shell div carries the border/hover look (aria-expanded styling keys off
    // the trigger inside via :has), the trigger button inside carries its own focus ring, and the
    // lock + trailing icon sit as siblings so the lock is INSIDE the control.
    private const string RowShell =
        "flex w-auto min-w-32 items-center gap-1.5 rounded-xl border bg-background/50 px-2.5 py-1.5 " +
        "transition-colors hover:border-primary/50 has-[button[aria-expanded=true]]:border-primary/60";

    private const string RowTrigger =
        "flex min-w-0 flex-1 flex-col text-start rounded-md " +
        "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-card";
}
