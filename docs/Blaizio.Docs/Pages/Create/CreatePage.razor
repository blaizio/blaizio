@page "/themes"
@* Legacy alias: shared ?preset= links predate the Themes rename; SyncUrl rewrites to /themes. *@
@page "/create"
@layout Blaizio.Docs.Layout.CreateLayout
@implements IAsyncDisposable
@inject IDocsJs Js
@inject IDialogService Dialogs
@inject IToastService Toasts
@inject NavigationManager Nav
@inject IJSRuntime JsRuntime
@inject ThemeComposerState State
@inject ThemeApplier Applier

<PageTitle>Themes - Blaizio</PageTitle>

@*
    The theme composer: pick a style (skin), a color preset, a chart palette, fonts and a radius
    scale, and watch every real component on the canvas re-skin live - the knobs write the same
    html classes / localStorage the rest of the site uses (theme.ts), so the choice follows you
    around the docs and survives reloads. Mode and direction live in the site header. Every
    selection round-trips through a compact preset code (PresetCode, shared with the CLI) that
    lives in the ?preset= query string, the rail's copy button and the Open Preset dialog.

    The rail Menu (and the matching global hotkeys wired below) drives the meta actions: Navigate
    (a command palette over the docs), Open Preset, Shuffle, Undo/Redo over the selection history,
    and Reset (a confirm dialog back to defaults).

    The canvas is paged (CreatePreview's floating pager) and only ever scrolls vertically inside
    its own container - never horizontally, and never the document itself.
*@
@* On mobile the rail is a bottom bar FIXED to the viewport (never rides the page scroll; the
   canvas gets matching bottom padding so nothing hides behind it) with a compact horizontal
   control arrangement (CreateRail Compact); from md up it's the fixed-height left sidebar. *@
<div class="flex flex-col-reverse md:h-[calc(100svh-3.5rem)] md:flex-row md:items-stretch">
    <aside class="scrollbar-hover w-full shrink-0 p-4 max-md:fixed max-md:inset-x-0 max-md:bottom-0 max-md:z-30 max-md:border-t max-md:border-border max-md:bg-background/95 max-md:p-3 max-md:backdrop-blur md:w-60 md:overflow-y-auto">
        <CreateRail Compact="@_isMobile"
                    Style="@State.Style" Preset="@State.Preset" Chart="@State.Chart" Heading="@State.Heading"
                    Font="@State.Font" Radius="@State.Radius" Code="@Code"
                    CanUndo="@State.CanUndo" CanRedo="@State.CanRedo"
                    Locks="State.Locks" ToggleLock="State.ToggleLock"
                    StyleChanged="SetStyleAsync"
                    PresetChanged="SetPresetAsync"
                    ChartChanged="SetChartAsync"
                    HeadingChanged="SetHeadingAsync"
                    FontChanged="SetFontAsync"
                    RadiusChanged="SetRadiusAsync"
                    Preview="PreviewAsync"
                    Navigate="OpenNavigateAsync"
                    OpenPreset="OpenPresetAsync"
                    Shuffle="ShuffleAsync"
                    Undo="UndoAsync"
                    Redo="RedoAsync"
                    Reset="ResetAsync"
                    GetCode="OpenGetCodeAsync"
                    CopyCode="CopyCodeAsync" />
    </aside>

    @* relative makes this the containing block for every absolutely-positioned descendant
       (sr-only inputs, calendar nav buttons) - without it their containing block chain skips this
       scroller and they spill document-level overflow: a SECOND horizontal/vertical scrollbar on
       the page itself. *@
    <div class="scrollbar-thin relative min-w-0 flex-1 max-md:pb-52 md:min-h-0 md:overflow-y-auto">
        <CreatePreview />
    </div>
</div>

@* The component palette behind "Search components..." (C): jump straight to any component's docs.
   Wrapped in a boxless pin ancestor so the palette keeps the default look on any skin;
   data-bz-portal-frame keeps that pin across the dialog's body portal. *@
<div class="bz-theme-base contents" data-bz-portal-frame="bz-theme-base">
<BzCommandDialog @bind-Open="_navOpen" Description="Jump to a component.">
    <BzCommandInput Placeholder="Search components..." />
    <BzCommandList>
        <BzCommandEmpty>No components found.</BzCommandEmpty>
        <BzCommandGroup Heading="Components">
            @foreach (var c in DocsNav.Components)
            {
                <BzCommandItem Value="@c.Label" OnSelect="@(_ => GoAsync(c.DocHref))">
                    <BzIcon Icon="@Icons.Outline.Components" /><span>@c.Label</span>
                </BzCommandItem>
            }
        </BzCommandGroup>
    </BzCommandList>
</BzCommandDialog>
</div>

@* Renderless global hotkeys - the Menu shortcuts, live anywhere on the page. Bare keys (c/o/s/r)
   are suppressed while typing by hotkeys.ts; the modified combos fire everywhere. *@
<BaseHotkey Combo="c" OnTrigger="OpenNavigateAsync" />
<BaseHotkey Combo="o" OnTrigger="OpenPresetAsync" />
<BaseHotkey Combo="s" OnTrigger="ShuffleAsync" />
<BaseHotkey Combo="mod+z" OnTrigger="UndoAsync" />
<BaseHotkey Combo="mod+shift+z" OnTrigger="RedoAsync" />
<BaseHotkey Combo="r" OnTrigger="ResetAsync" />

@code {
    // Selection, locks and undo/redo live in the scoped ThemeComposerState; document writes live
    // in ThemeApplier (theme.ts via IDocsJs) and the ?preset= contract in PresetUrl. This page is
    // the coordinator: every mutation flows RecordHistory -> Applier -> SyncUrl, so history and
    // the URL can never record different selections.
    private bool _navOpen;

    // Mobile breakpoint tracking (same sidebar.js matchMedia plumbing BzSidebarProvider uses) -
    // drives the rail's Compact bottom-bar arrangement and its upward-opening dropdowns.
    private bool _isMobile;
    private IJSObjectReference? _mobileModule;
    private IJSObjectReference? _mobileWatcher;
    private DotNetObjectReference<CreatePage>? _selfRef;

    [CascadingParameter] private Blaizio.Docs.Layout.CreateLayout Shell { get; set; } = default!;

    private string Code => PresetCode.Encode(State.Selection);

    protected override void OnInitialized()
    {
        // The direction knob lives in the header; track it so the code's `r` suffix stays live.
        Shell.DirectionUpdated += OnShellDirectionUpdated;
        // And the reverse: a direction the applier writes (undo, deep link) syncs the shell.
        Applier.DirectionApplied = rtl => Shell.SetDirection(rtl ? Direction.Rtl : Direction.Ltr);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Seed the mobile state and subscribe to breakpoint crossings (768px, the md breakpoint).
        try
        {
            _mobileModule = await JsRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./_content/blaizio.base/dist/sidebar.js");
            _selfRef = DotNetObjectReference.Create(this);
            _isMobile = await _mobileModule.InvokeAsync<bool>("matchesMobile", 768);
            _mobileWatcher = await _mobileModule.InvokeAsync<IJSObjectReference>("observeMobile", _selfRef, 768);
        }
        catch (JSDisconnectedException) { }

        State.Rtl = await Js.GetDirAsync() == "rtl";

        // Load every catalogue webfont in one combined css2 request so the rail's font dropdowns
        // preview real faces. Cheap: the stylesheet is small and the browser only fetches the
        // font files whose families actually render (i.e. when a dropdown opens).
        if (FontCatalog.CssUrl([.. FontCatalog.All.Select(f => f.Name)]) is { } allFonts)
            await Js.LoadWebFontAsync(allFonts);

        // A shared ?preset= link wins; otherwise a fresh visit always starts from the default
        // look - a selection lingering from a previous session would silently skew every color
        // and font the composer previews. Direction stays as persisted: it is a site preference,
        // not a composer knob. Neither seeding path records history.
        if (PresetUrl.TryReadCode(Nav, out var shared))
        {
            State.Seeded = true;
            await WriteAllAsync(shared);
        }
        else
        {
            State.Seeded = true;
            await WriteAllAsync(new PresetSelection("ember", "nova", Rtl: State.Rtl));
        }
        StateHasChanged();
    }

    private void OnShellDirectionUpdated(Direction dir)
    {
        var rtl = dir == Direction.Rtl;
        if (State.Rtl == rtl) return;
        // A direction flip from the header is a user action - make it undoable too.
        State.RecordHistory();
        State.Rtl = rtl;
        SyncUrl();
        StateHasChanged();
    }

    /// <summary>Reflect the current selection into ?preset= (the contract lives in PresetUrl).</summary>
    private void SyncUrl()
    {
        if (State.Seeded) PresetUrl.Sync(Nav, Code);
    }

    // ---- History (the stacks live in ThemeComposerState; this page applies what they pop) ----

    private async Task UndoAsync()
    {
        if (!State.TryUndo(out var previous)) return;
        await WriteAllAsync(previous);
        StateHasChanged();
    }

    private async Task RedoAsync()
    {
        if (!State.TryRedo(out var next)) return;
        await WriteAllAsync(next);
        StateHasChanged();
    }

    // ---- Document writes (ThemeApplier owns them; the page adds URL sync on top) ----

    private Task PreviewAsync((string Knob, string? Value) p) => Applier.PreviewAsync(p);

    /// <summary>Write a whole selection (undo/redo, open-preset, deep link, reset). Never records.</summary>
    private async Task WriteAllAsync(PresetSelection s)
    {
        await Applier.WriteAllAsync(s);
        SyncUrl();
    }

    // ---- Rail knob handlers (each one user action = one history entry) ----

    private async Task SetStyleAsync(string v) { State.RecordHistory(); await Applier.ApplyStyleAsync(v); SyncUrl(); }

    // A theme is a complete look: picking one also applies its designed companions (paired
    // heading/body face and chart series) into every knob the user hasn't locked. One history
    // entry: Undo reverts the theme and its pairing together.
    private async Task SetPresetAsync(string v)
    {
        State.RecordHistory();
        await Applier.ApplyPresetAsync(v);
        if (Presets.Find(v) is { } entry)
        {
            if (!State.Locks.Contains("heading")) await Applier.ApplyHeadingAsync(entry.PairedHeading);
            if (!State.Locks.Contains("font")) await Applier.ApplyFontAsync(entry.PairedFont);
            if (!State.Locks.Contains("chart")) await Applier.ApplyChartAsync(entry.PairedChart);
        }
        SyncUrl();
    }
    private async Task SetChartAsync(string v) { State.RecordHistory(); await Applier.ApplyChartAsync(v); SyncUrl(); }
    private async Task SetHeadingAsync(string v) { State.RecordHistory(); await Applier.ApplyHeadingAsync(v); SyncUrl(); }
    private async Task SetFontAsync(string v) { State.RecordHistory(); await Applier.ApplyFontAsync(v); SyncUrl(); }
    private async Task SetRadiusAsync(string v) { State.RecordHistory(); await Applier.ApplyRadiusAsync(v); SyncUrl(); }

    // ---- Menu actions ----

    private Task OpenNavigateAsync()
    {
        _navOpen = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task GoAsync(string href)
    {
        _navOpen = false;
        await Task.Yield();
        Nav.NavigateTo(href);
    }

    // All imperative dialogs are pinned to the default look by CreateLayout's .bz-theme-base
    // wrapper around the providers; Get Code just needs extra width for its tabs.
    private static readonly BzDialogOptions GetCodeDialogOptions = new() { ContentClass = "sm:max-w-lg" };

    private async Task OpenPresetAsync()
    {
        var result = await Dialogs.ShowAsync<OpenPresetDialog>();
        if (result is { Cancelled: false, Value: PresetSelection selection })
        {
            State.RecordHistory();
            await WriteAllAsync(selection);
            StateHasChanged();
        }
    }

    /// <summary>The Shuffle font pool: "Default" plus every offered face (retired stacks stay out).</summary>
    private static readonly string[] ShuffleFonts =
        [.. FontCatalog.All.Where(f => f.Offered).Select(f => f.Name)];

    // Randomize every UNLOCKED knob - always different from the current selection in at least one
    // of them. Knobs shuffle independently (no theme pairing here: Shuffle explores combinations;
    // picking a theme from the rail is what applies its curated pairing). All locked = no-op.
    private async Task ShuffleAsync()
    {
        bool Unlocked(string knob) => !State.Locks.Contains(knob);
        if (!Unlocked("style") && !Unlocked("preset") && !Unlocked("chart")
            && !Unlocked("heading") && !Unlocked("font") && !Unlocked("radius"))
            return;

        var (style, preset, chart) = (State.Style, State.Preset, State.Chart);
        var (heading, font, radius) = (State.Heading, State.Font, State.Radius);
        do
        {
            if (Unlocked("style")) style = DocsThemes.Styles[Random.Shared.Next(DocsThemes.Styles.Length)].Value;
            if (Unlocked("preset")) preset = Presets.All[Random.Shared.Next(Presets.All.Length)].Name;
            if (Unlocked("chart")) chart = DocsThemes.ChartPalettes[Random.Shared.Next(DocsThemes.ChartPalettes.Length)].Name;
            if (Unlocked("heading")) heading = ShuffleFonts[Random.Shared.Next(ShuffleFonts.Length)];
            if (Unlocked("font")) font = ShuffleFonts[Random.Shared.Next(ShuffleFonts.Length)];
            if (Unlocked("radius")) radius = DocsThemes.Radii[Random.Shared.Next(DocsThemes.Radii.Length)].Value;
        } while (style == State.Style && preset == State.Preset && chart == State.Chart
                 && heading == State.Heading && font == State.Font && radius == State.Radius);

        State.RecordHistory();
        await Applier.ApplyStyleAsync(style);
        await Applier.ApplyPresetAsync(preset);
        await Applier.ApplyChartAsync(chart);
        await Applier.ApplyHeadingAsync(heading);
        await Applier.ApplyFontAsync(font);
        await Applier.ApplyRadiusAsync(radius);
        SyncUrl();
        StateHasChanged();
    }

    private async Task ResetAsync()
    {
        var ok = await Dialogs.ConfirmAsync(
            "Reset to defaults?",
            "This will reset all customization options to their default values.",
            new BzDialogOptions { ConfirmText = "Reset" });
        if (!ok) return;
        // Reset is an undoable step like any other knob write - record the pre-reset selection so
        // Undo brings it back.
        State.RecordHistory();
        await WriteAllAsync(new PresetSelection("ember", "nova", Rtl: false));
        StateHasChanged();
    }

    private async Task CopyCodeAsync()
    {
        await Js.CopyAsync(Code);
        Toasts.Success("Preset code copied", new ToastOptions { Description = $"\"{Code}\" - paste it in Open Preset or share {Nav.BaseUri}create?preset={Code}" });
    }

    private async Task OpenGetCodeAsync() =>
        await Dialogs.ShowAsync<GetCodeDialog>(new Dictionary<string, object?>
        {
            [nameof(GetCodeDialog.Selection)] = State.Selection,
        }, GetCodeDialogOptions);

    [JSInvokable]
    public Task OnMobileChanged(bool isMobile)
    {
        _isMobile = isMobile;
        StateHasChanged();
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        Shell.DirectionUpdated -= OnShellDirectionUpdated;
        // Awaited JS cleanup (the framework awaits DisposeAsync on teardown) - no fire-and-forget
        // race between the watcher's dispose and the circuit going away.
        try
        {
            if (_mobileWatcher is not null)
            {
                await _mobileWatcher.InvokeVoidAsync("dispose");
                await _mobileWatcher.DisposeAsync();
            }
            if (_mobileModule is not null) await _mobileModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Runtime already gone - nothing left to clean on the client.
        }
        catch (JSException)
        {
            // The watcher's JS side was already torn down (e.g. a hard navigation).
        }
        finally
        {
            _mobileWatcher = null;
            _mobileModule = null;
            _selfRef?.Dispose();
        }
    }
}
