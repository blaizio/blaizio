@page "/docs/components/combobox"
@using Blaizio.Docs.Examples.Combobox
<PageTitle>Combobox - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Combobox</h1>
            <DocBadges Slug="combobox" />
        </div>
        <p>An input that filters a popup list as you type, while focus stays in the input and the arrow keys move the highlight. You pass the options as <code>Items</code> and render each one through a template, so plain strings, objects and grouped data all work the same way. Switch to multiple selection and each pick becomes a removable chip in the field.</p>
    </header>

    <UsageBlock Example="typeof(ComboboxUsageExample)"
                Description="After importing `Blaizio.Ui`, pass a flat `Items` list and compose an input with a content list." />

    <CompositionTree Root="Anatomy"
                     Description="Every part of a combobox. Use `BzComboboxInput` for a single select, or `BzComboboxChips` with `BzComboboxValue` and `BzComboboxChip` for `SelectionMode.Multiple`. For grouped items, nest a `BzComboboxCollection` inside each `BzComboboxGroup`." />

    <ExamplesHeading />

    <Demo Title="Basic" Description="A single select over a flat list. Typing fuzzy-filters the options, and picking one fills the input and closes the popup." Example="typeof(ComboboxBasicExample)" />

    <Demo Title="Multiple" Description="Set `SelectionMode` to `Multiple` and each pick becomes a chip. A chip's remove button, or Backspace in an empty input, removes it, and the popup stays open so you can choose several in one go." Example="typeof(ComboboxMultipleExample)" />

    <Demo Title="Clear button" Description="With `ShowClear` set, the trailing chevron becomes a clear button whenever a value is selected. Clearing empties the field and returns focus to the input." Example="typeof(ComboboxClearExample)" />

    <Demo Title="Controlled" Description="Bind the selection two-way when other code needs to set it. The input text follows the value whichever side changes it." Example="typeof(ComboboxControlledExample)" />

    <Demo Title="Groups" Description="When the items are groups, the list template receives each group, and a nested `BzComboboxCollection` renders its items. Groups with no matches disappear, along with their separators, as you filter." Example="typeof(ComboboxGroupsExample)" />

    <Demo Title="Custom items" Description="Items can be objects. Set `ItemToStringValue` so the combobox knows which text to filter on and display, then render whatever you like inside each `BzComboboxItem`." Example="typeof(ComboboxCustomItemsExample)" />

    <Demo Title="Auto highlight" Description="With `AutoHighlight` set, the first match stays highlighted as you type, so Enter picks it without an arrow press. Opening the list highlights the current selection instead of the first item, which here is Avalonia, the fourth option." Example="typeof(ComboboxAutoHighlightExample)" />

    <Demo Title="Input group" Description="Place a `BzInputGroupAddon` inside `BzComboboxInput` for a leading icon or any other affix. The field still looks and behaves as one control." Example="typeof(ComboboxInputGroupExample)" />

    <Demo Title="In a popup" Description="To open the combobox from a button, make the button the anchor and move the input inside the content. `BzComboboxValue` shows the current pick on the button, or a placeholder while nothing is selected." Example="typeof(ComboboxPopupExample)" />

    <Demo Title="Invalid" Description="Pass `aria-invalid` to mark the field invalid. The input group then shows the destructive ring." Example="typeof(ComboboxInvalidExample)" />

    <Demo Title="Disabled" Description="Set `Disabled` on the root to block interaction. The field and its addons are grayed out but still show the current value." Example="typeof(ComboboxDisabledExample)" />

    <Demo Title="Customization"
          Description="Every part accepts `Class`. This example gives the input a branded ring and radius, and recolors the highlighted row by targeting the `combobox-item` slot in its `data-highlighted` state."
          Example="typeof(ComboboxCustomizationExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, the field, the popup and the check mark all mirror, while highlighting and filtering behave the same." Example="typeof(ComboboxRtlExample)" />

</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzCombobox",
        new CompositionNode("BzComboboxInput"),
        new CompositionNode("BzComboboxChips",
            new CompositionNode("BzComboboxValue",
                new CompositionNode("BzComboboxChip",
                    new CompositionNode("BzComboboxChipRemove")),
                new CompositionNode("BzComboboxChipsInput"))),
        new CompositionNode("BzComboboxTrigger"),
        new CompositionNode("BzComboboxClear"),
        new CompositionNode("BzComboboxContent",
            new CompositionNode("BzComboboxEmpty"),
            new CompositionNode("BzComboboxList",
                new CompositionNode("BzComboboxItem"),
                new CompositionNode("BzComboboxGroup",
                    new CompositionNode("BzComboboxLabel"),
                    new CompositionNode("BzComboboxCollection")),
                new CompositionNode("BzComboboxSeparator"))));
}
