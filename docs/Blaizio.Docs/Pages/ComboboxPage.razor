@page "/docs/components/combobox"
@using Blaizio.Docs.Examples.Combobox
<PageTitle>Combobox - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Combobox</h1>
            <DocBadges Slug="combobox" />
        </div>
        <p class="text-muted-foreground">An autocomplete input with a popup list of suggestions. Type to filter; pick with the mouse or the arrow keys while focus stays in the input. Data-driven over <code>Items</code> with a render-prop list - single or multiple selection (with chips), groups, a clear button, and object items via <code>ItemToStringValue</code>.</p>
    </header>

    <UsageBlock Example="typeof(ComboboxUsageExample)"
                Description="Add the using once, then bind a flat Items list and compose an input with a content list." />

    <CompositionTree Root="Anatomy"
                     Description="The full anatomy. Use ComboboxInput for the single-select field (or ComboboxChips with ComboboxValue + ComboboxChip for SelectionMode.Multiple), and nest a ComboboxGroup with a ComboboxCollection for grouped items." />

    <ExamplesHeading />

    <Demo Title="Basic" Description="A single-select over a flat list. Typing fuzzy-filters the options; picking one fills the input and closes the popup." Example="typeof(ComboboxBasicExample)" />

    <Demo Title="Multiple" Description="Set SelectionMode to Multiple for chips. Each pick adds a token; the remove button or Backspace on an empty query removes one. The popup stays open so several can be chosen in one visit." Example="typeof(ComboboxMultipleExample)" />

    <Demo Title="Clear button" Description="Pass ShowClear and the trailing chevron swaps for a clear button whenever a value is selected. Clearing empties the field and returns focus to the input." Example="typeof(ComboboxClearExample)" />

    <Demo Title="Controlled" Description="Two-way bind the selection and drive it from outside - the input text follows the value either way." Example="typeof(ComboboxControlledExample)" />

    <Demo Title="Groups" Description="When the items are groups, the list render-prop yields each group; nest a ComboboxCollection for its items and a ComboboxSeparator between them. Empty groups (and their separators) drop out as you filter." Example="typeof(ComboboxGroupsExample)" />

    <Demo Title="Custom items" Description="Items can be objects. Give ItemToStringValue so the engine knows the filter + selection text, then render whatever you like inside each ComboboxItem." Example="typeof(ComboboxCustomItemsExample)" />

    <Demo Title="Auto highlight" Description="With AutoHighlight the first match stays highlighted as you type, so Enter picks it with no arrow press. Opening highlights the current selection instead (here Avalonia, the fourth option) - the highlight follows the value, never an unconditional first item." Example="typeof(ComboboxAutoHighlightExample)" />

    <Demo Title="Input group" Description="Drop an InputGroupAddon inside ComboboxInput for a leading icon (or any affix) - the field still reads as one control." Example="typeof(ComboboxInputGroupExample)" />

    <Demo Title="In a popup" Description="Trigger the combobox from a button by making it the anchor and moving the input inside the content. ComboboxValue shows the current pick on the button, with a Placeholder while nothing is selected." Example="typeof(ComboboxPopupExample)" />

    <Demo Title="Invalid" Description="Pass aria-invalid to mark the field invalid - the input group picks up the destructive ring." Example="typeof(ComboboxInvalidExample)" />

    <Demo Title="Disabled" Description="Disabled on the root greys the field and its addons and blocks interaction, while still showing the current value." Example="typeof(ComboboxDisabledExample)" />

    <Demo Title="Customization"
          Description="Restyle any part via Class. Here the input shell gets a branded ring and radius, and the highlighted row is recolored by targeting the combobox-item slot in its data-highlighted state. Utilities win over the skin, so these take effect."
          Example="typeof(ComboboxCustomizationExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left DirectionProvider the field, popup and check all mirror; the highlight and filtering behave the same." Example="typeof(ComboboxRtlExample)" />

</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzCombobox",
        new CompositionNode("BzComboboxInput"),
        new CompositionNode("BzComboboxChips",
            new CompositionNode("BzComboboxValue",
                new CompositionNode("BzComboboxChip",
                    new CompositionNode("BzComboboxChipRemove")),
                new CompositionNode("BzComboboxChipsInput"))),
        new CompositionNode("BzComboboxTrigger"),
        new CompositionNode("BzComboboxClear"),
        new CompositionNode("BzComboboxContent",
            new CompositionNode("BzComboboxEmpty"),
            new CompositionNode("BzComboboxList",
                new CompositionNode("BzComboboxItem"),
                new CompositionNode("BzComboboxGroup",
                    new CompositionNode("BzComboboxLabel"),
                    new CompositionNode("BzComboboxCollection")),
                new CompositionNode("BzComboboxSeparator"))));
}
