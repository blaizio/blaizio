@page "/docs/components/tooltip"
@using Blaizio.Docs.Examples.Tooltip
<PageTitle>Tooltip - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Tooltip</h1>
            <DocBadges Slug="tooltip" />
        </div>
        <p class="text-muted-foreground">A floating label that explains a control - shown on hover or keyboard focus, positioned against the trigger with <a class="font-medium text-foreground underline underline-offset-4" href="https://floating-ui.com" target="_blank" rel="noopener">Floating UI</a> so it always stays on screen. Wrap a region in a <code>TooltipProvider</code> to share the open delay across triggers.</p>
    </header>

    <UsageBlock Example="typeof(TooltipDefaultExample)"
                Description="Add the using once, then compose a trigger and content. Any element can be the trigger via RenderAs. Wrap a region in a BzTooltipProvider to share the open delay." />

    <CompositionTree Root="Anatomy"
                     Description="The full anatomy. Put the trigger and the content under one BzTooltip, drop an optional BzTooltipArrow inside the content, and wrap a region in a BzTooltipProvider to share the delay across triggers." />

    <ExamplesHeading />

    <Demo Title="Default" Description="Hover or focus the trigger - the tooltip opens after a short delay and points at it. No arrow unless you add one."
          Example="typeof(TooltipDefaultExample)" />

    <Demo Title="Custom trigger (RenderAs)" Description="Render the trigger onto your own element - here an anchor - instead of the default button, by splatting p.Attributes."
          Example="typeof(TooltipRenderAsTriggerExample)" />

    <Demo Title="Arrow" Description="Drop an optional TooltipArrow inside the content; it points at the trigger and follows the resolved side, even after a flip."
          Example="typeof(TooltipArrowExample)" />

    <Demo Title="Colors" Description="Variant sets the bubble's surface - the soft accent default, solid primary, or a status color - and a nested arrow always paints to match."
          Example="typeof(TooltipColorsExample)" />

    <Demo Title="With keyboard shortcut" Description="Tooltip content is just markup - pair a label with a Kbd chip. Inside the bubble the Kbd restyles itself to read on the surface."
          Example="typeof(TooltipKbdExample)" />

    <Demo Title="Sides" Description="Side sets the preferred edge; it flips to the opposite side when there isn't room, and the arrow follows."
          Example="typeof(TooltipSidesExample)" />

    <Demo Title="Shared delay across triggers" Description="Inside a TooltipProvider, once one tooltip has opened, moving to an adjacent trigger opens instantly - no waiting through the delay again."
          Example="typeof(TooltipProviderExample)" />

    <Demo Title="No delay" Description="DelayDuration is the hover wait in milliseconds; set it to 0 to open at once. Keyboard focus always opens immediately."
          Example="typeof(TooltipDelayExample)" />

    <Demo Title="Disabled trigger" Description="A disabled button emits no pointer events, so wrap it in a focusable span and put the trigger on that - the tooltip still opens on hover and keyboard focus."
          Example="typeof(TooltipDisabledExample)" />

    <Demo Title="Customization" Description="Restyle the bubble via Class - a brand-colored surface with a custom radius. Target the arrow's slot to recolor its triangle to match. Root-level utilities win over the skin, so these take effect."
          Example="typeof(TooltipCustomExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the tooltip positions against the trigger and the layout mirrors."
          Example="typeof(TooltipRtlExample)" />
</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzTooltipProvider",
        new CompositionNode("BzTooltip",
            new CompositionNode("BzTooltipTrigger"),
            new CompositionNode("BzTooltipContent",
                new CompositionNode("BzTooltipArrow"))));
}
