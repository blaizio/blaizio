@page "/components/tooltip"
<PageTitle>Tooltip - Blaizio بليزيو</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Tooltip</h1>
        <p class="text-muted-foreground">A floating label that explains a control - shown on hover or keyboard focus, positioned against the trigger with <a class="font-medium text-foreground underline underline-offset-4" href="https://floating-ui.com" target="_blank" rel="noopener">Floating UI</a> so it always stays on screen. Wrap a region in a <code>TooltipProvider</code> to share the open delay across triggers.</p>
    </header>

    <UsageBlock Setup="@UsageSetup" Code="@UsageMarkup"
                Description="Add the using once, then compose a trigger and content. Any element can be the trigger via RenderAs. Wrap a region in a BzTooltipProvider to share the open delay." />

    <CompositionTree Root="_anatomy"
                     Description="The full anatomy. Put the trigger and the content under one BzTooltip, drop an optional BzTooltipArrow inside the content, and wrap a region in a BzTooltipProvider to share the delay across triggers." />

    <ExamplesHeading />

    <Demo Title="Default" Description="Hover or focus the trigger - the tooltip opens after a short delay and points at it. No arrow unless you add one." Code="@DefaultCode">
        <BzTooltip>
            <BzTooltipTrigger>
                <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Hover me</BzButton></RenderAs>
            </BzTooltipTrigger>
            <BzTooltipContent>Add to library</BzTooltipContent>
        </BzTooltip>
    </Demo>

    <Demo Title="Custom trigger (RenderAs)" Description="Render the trigger onto your own element - here an anchor - instead of the default button, by splatting p.Attributes." Code="@RenderAsTriggerCode">
        <BzTooltip>
            <BzTooltipTrigger>
                <RenderAs Context="p">
                    <a href="#" @onclick:preventDefault @attributes="p.Attributes" class="text-sm font-medium text-indigo-600 underline-offset-4 hover:underline dark:text-indigo-400">Hover me</a>
                </RenderAs>
            </BzTooltipTrigger>
            <BzTooltipContent>Add to library</BzTooltipContent>
        </BzTooltip>
    </Demo>

    <Demo Title="Arrow" Description="Drop an optional TooltipArrow inside the content; it points at the trigger and follows the resolved side, even after a flip." Code="@ArrowCode">
        <BzTooltip>
            <BzTooltipTrigger>
                <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">With arrow</BzButton></RenderAs>
            </BzTooltipTrigger>
            <BzTooltipContent>
                Add to library
                <BzTooltipArrow />
            </BzTooltipContent>
        </BzTooltip>
    </Demo>

    <Demo Title="With keyboard shortcut" Description="Tooltip content is just markup - pair a label with a Kbd chip. Inside the bubble the Kbd restyles itself to read on the dark surface." Code="@KbdCode">
        <BzTooltip>
            <BzTooltipTrigger>
                <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Save</BzButton></RenderAs>
            </BzTooltipTrigger>
            <BzTooltipContent>
                <span class="flex items-center gap-2">Save changes <BzKbd>⌘S</BzKbd></span>
                <BzTooltipArrow />
            </BzTooltipContent>
        </BzTooltip>
    </Demo>

    <Demo Title="Sides" Description="Side sets the preferred edge; it flips to the opposite side when there isn't room, and the arrow follows." Code="@SidesCode">
        <BzTooltipProvider>
            <div class="flex items-center gap-2">
                <BzTooltip>
                    <BzTooltipTrigger><RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Top</BzButton></RenderAs></BzTooltipTrigger>
                    <BzTooltipContent Side="Side.Top">On top<BzTooltipArrow /></BzTooltipContent>
                </BzTooltip>
                <BzTooltip>
                    <BzTooltipTrigger><RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Right</BzButton></RenderAs></BzTooltipTrigger>
                    <BzTooltipContent Side="Side.Right">On the right<BzTooltipArrow /></BzTooltipContent>
                </BzTooltip>
                <BzTooltip>
                    <BzTooltipTrigger><RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Bottom</BzButton></RenderAs></BzTooltipTrigger>
                    <BzTooltipContent Side="Side.Bottom">On the bottom<BzTooltipArrow /></BzTooltipContent>
                </BzTooltip>
                <BzTooltip>
                    <BzTooltipTrigger><RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Left</BzButton></RenderAs></BzTooltipTrigger>
                    <BzTooltipContent Side="Side.Left">On the left<BzTooltipArrow /></BzTooltipContent>
                </BzTooltip>
            </div>
        </BzTooltipProvider>
    </Demo>

    <Demo Title="Shared delay across triggers" Description="Inside a TooltipProvider, once one tooltip has opened, moving to an adjacent trigger opens instantly - no waiting through the delay again." Code="@ProviderCode">
        <BzTooltipProvider>
            <div class="flex items-center gap-2">
                <BzTooltip>
                    <BzTooltipTrigger><RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSm" @attributes="p.Attributes"><BzIcon Icon="@Icons.Outline.Bold" /></BzButton></RenderAs></BzTooltipTrigger>
                    <BzTooltipContent>Bold<BzTooltipArrow /></BzTooltipContent>
                </BzTooltip>
                <BzTooltip>
                    <BzTooltipTrigger><RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSm" @attributes="p.Attributes"><BzIcon Icon="@Icons.Outline.Italic" /></BzButton></RenderAs></BzTooltipTrigger>
                    <BzTooltipContent>Italic<BzTooltipArrow /></BzTooltipContent>
                </BzTooltip>
                <BzTooltip>
                    <BzTooltipTrigger><RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSm" @attributes="p.Attributes"><BzIcon Icon="@Icons.Outline.Underline" /></BzButton></RenderAs></BzTooltipTrigger>
                    <BzTooltipContent>Underline<BzTooltipArrow /></BzTooltipContent>
                </BzTooltip>
            </div>
        </BzTooltipProvider>
    </Demo>

    <Demo Title="No delay" Description="DelayDuration is the hover wait in milliseconds; set it to 0 to open at once. Keyboard focus always opens immediately." Code="@DelayCode">
        <BzTooltip DelayDuration="0">
            <BzTooltipTrigger>
                <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">No delay</BzButton></RenderAs>
            </BzTooltipTrigger>
            <BzTooltipContent>Opens the instant you hover<BzTooltipArrow /></BzTooltipContent>
        </BzTooltip>
    </Demo>

    <Demo Title="Disabled trigger" Description="A disabled button emits no pointer events, so wrap it in a focusable span and put the trigger on that - the tooltip still opens on hover and keyboard focus." Code="@DisabledCode">
        <BzTooltip>
            <BzTooltipTrigger>
                <RenderAs Context="p">
                    <span tabindex="0" class="inline-block" @attributes="p.Attributes">
                        <BzButton Variant="ButtonVariant.Outline" Disabled="true">Disabled</BzButton>
                    </span>
                </RenderAs>
            </BzTooltipTrigger>
            <BzTooltipContent>You don't have permission to do this<BzTooltipArrow /></BzTooltipContent>
        </BzTooltip>
    </Demo>

    <Demo Title="Customization" Description="Restyle the bubble via Class - a brand-colored surface with a custom radius. Target the arrow's slot to recolor its triangle to match. Root-level utilities win over the skin, so these take effect." Code="@CustomCode">
        <BzTooltip>
            <BzTooltipTrigger>
                <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Hover me</BzButton></RenderAs>
            </BzTooltipTrigger>
            <BzTooltipContent Class="rounded-lg bg-indigo-600 text-white [&_[data-slot=tooltip-arrow]_svg]:fill-indigo-600">
                Add to library
                <BzTooltipArrow />
            </BzTooltipContent>
        </BzTooltip>
    </Demo>

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the tooltip positions against the trigger and the layout mirrors." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzTooltipProvider>
                <BzTooltip>
                    <BzTooltipTrigger>
                        <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">مرّر المؤشر</BzButton></RenderAs>
                    </BzTooltipTrigger>
                    <BzTooltipContent>أضِف إلى المكتبة<BzTooltipArrow /></BzTooltipContent>
                </BzTooltip>
            </BzTooltipProvider>
        </BzDirectionProvider>
    </Demo>
</div>

@code {
