@page "/docs/components/slider"
@using Blaizio.Docs.Examples.Slider
<PageTitle>Slider - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Slider</h1>
        <p class="text-muted-foreground">An input for selecting a value, or a range, from within a span.</p>
    </header>

    <UsageBlock Example="typeof(SliderDefaultExample)" />

    <ExamplesHeading />

    <Demo Title="Default" Description="A single thumb, uncontrolled - it manages its own value." Example="typeof(SliderDefaultExample)" />

    <Demo Title="Range" Description="Two thumbs select an interval. Bind a list, or seed one with DefaultValues." Example="typeof(SliderRangeExample)" />

    <Demo Title="Multiple thumbs" Description="Pass more values for more thumbs. MinStepsBetweenThumbs keeps them from crossing." Example="typeof(SliderMultipleExample)" />

    <Demo Title="Steps" Description="Step sets the granularity values snap to (here 10, over a 0-100 domain)." Example="typeof(SliderStepsExample)" />

    <Demo Title="Status colors" Description="Color repaints the range and thumb accent with a status token." Example="typeof(SliderColorsExample)" />

    <Demo Title="Vertical" Description="Set Orientation to Vertical; the thumb travels bottom (min) to top (max)." Example="typeof(SliderVerticalExample)" />

    <Demo Title="Controlled" Description="Bind the value two-way; the readout reacts as you drag or arrow." Example="typeof(SliderControlledExample)" />

    <Demo Title="Value tooltip" Description="Set Tooltip to float each thumb's value in a bubble - OnInteraction shows it on hover/drag, Always keeps it up. TooltipFormat customises the text." Example="typeof(SliderTooltipExample)" />

    <Demo Title="Disabled" Description="Disabled sliders dim and ignore pointer + keyboard input." Example="typeof(SliderDisabledExample)" />

    <Demo Title="Customization"
          Description="Recolor each part through its slot - [&_[data-slot=slider-range]] for the fill and [&_[data-slot=slider-thumb]] for the handle's border + ring."
          Example="typeof(SliderCustomExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the track, fill and arrow keys mirror." Example="typeof(SliderRtlExample)" />

</div>

