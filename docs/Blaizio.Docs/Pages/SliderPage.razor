@page "/docs/components/slider"
@using Blaizio.Docs.Examples.Slider
<PageTitle>Slider - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Slider</h1>
            <DocBadges Slug="slider" />
        </div>
        <p>One component covers a single value, a range, or any number of thumbs, horizontal or vertical. Every thumb is keyboard operable: the arrow keys step, Shift with an arrow or Page Up and Page Down move ten steps, and Home and End jump to the limits.</p>
    </header>

    <UsageBlock Example="typeof(SliderDefaultExample)" />

    <ExamplesHeading />

    <Demo Title="Default" Description="With no binding, the slider keeps track of its own value." Example="typeof(SliderDefaultExample)" />

    <Demo Title="Range" Description="Two thumbs select an interval. Bind `Values` to a list, or seed the starting interval with `DefaultValues`." Example="typeof(SliderRangeExample)" />

    <Demo Title="Multiple thumbs" Description="Each extra value adds a thumb, and `MinStepsBetweenThumbs` keeps neighboring thumbs at least that many steps apart." Example="typeof(SliderMultipleExample)" />

    <Demo Title="Steps" Description="`Step` sets the increment values snap to. Here it is 10 across a range of 0 to 100." Example="typeof(SliderStepsExample)" />

    <Demo Title="Status colors" Description="`Color` paints the filled range and the thumb accent with a status color." Example="typeof(SliderColorsExample)" />

    <Demo Title="Vertical" Description="Set `Orientation` to `Vertical` and the slider runs from its minimum at the bottom to its maximum at the top." Example="typeof(SliderVerticalExample)" />

    <Demo Title="Controlled" Description="Bind `Value` when the page needs it. The readout updates while you drag or press the arrow keys." Example="typeof(SliderControlledExample)" />

    <Demo Title="Value tooltip" Description="`TooltipMode` shows each thumb's value in a bubble. `OnInteraction` shows it on hover and while dragging, `Always` keeps it visible, and `TooltipFormat` controls the text." Example="typeof(SliderTooltipExample)" />

    <Demo Title="Disabled" Description="`Disabled` dims the slider and ignores pointer and keyboard input." Example="typeof(SliderDisabledExample)" />

    <Demo Title="Customization"
          Description="Target the parts from `Class` through their slots: `[&_[data-slot=slider-range]]` for the fill and `[&_[data-slot=slider-thumb]]` for the thumb's border and ring."
          Example="typeof(SliderCustomExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, the fill grows from the right edge and the left and right arrow keys swap, so Left increases the value." Example="typeof(SliderRtlExample)" />

</div>

