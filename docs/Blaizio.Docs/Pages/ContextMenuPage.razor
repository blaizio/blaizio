@page "/components/context-menu"
@using Blaizio.Docs.Examples.ContextMenu
<PageTitle>Context Menu - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Context Menu</h1>
        <p class="text-muted-foreground">A menu of actions triggered by a right-click, opening at the pointer and positioned with <a class="font-medium text-foreground underline underline-offset-4" href="https://floating-ui.com" target="_blank" rel="noopener">Floating UI</a>. It shares the dropdown menu's surface - the same keyboard support (arrow keys, Home/End, type-ahead, Enter/Space, Escape), checkbox and radio items, labels, separators, and nested submenus. It is <strong>non-modal</strong>: the rest of the page stays interactive while it is open.</p>
    </header>

    <UsageBlock Example="typeof(ContextMenuUsageExample)"
                Description="Add the using once, then wrap a trigger area and content. Right-clicking anywhere inside the trigger opens the menu at the pointer." />

    <CompositionTree Root="Anatomy"
                     Description="The full anatomy. Group items under labels, separate sections with a separator, and nest a BzContextMenuSub for submenus." />

    <ExamplesHeading />

    <Demo Title="Default" Description="Right-click the area to open the menu at the pointer. It carries items with shortcuts, a nested submenu, a disabled item, checkbox and radio sections, and a destructive action. Navigate with the arrow keys or by typing; Escape closes it."
          Example="typeof(ContextMenuDefaultExample)" />

    <Demo Title="Item as a link (RenderAs)" Description="Render a menu item onto your own element - here an anchor - so it navigates like a real link."
          Example="typeof(ContextMenuItemAsLinkExample)" />

    <Demo Title="Items with icons" Description="A clipboard menu where each action leads with an icon on the inline-start and a keyboard shortcut on the inline-end, closing with a destructive Delete."
          Example="typeof(ContextMenuIconsExample)" />

    <Demo Title="Inset items" Description="Inset adds the leading indent that lines an item up under a label or an icon column - use it on items that have no leading icon so their text still aligns with those that do."
          Example="typeof(ContextMenuInsetExample)" />

    <Demo Title="Nested submenus" Description="A submenu opens to the side on hover or the inline-end arrow and can nest as deep as you need. With the pointer, a short grace delay lets you cross the gap to the panel without it snapping shut."
          Example="typeof(ContextMenuSubmenusExample)" />

    <Demo Title="Checkbox &amp; radio items" Description="Toggle settings without the menu closing - each checkbox's OnSelect calls PreventDefault to keep it open - and pick one option from a radio group. Both states are two-way bound."
          Example="typeof(ContextMenuCheckboxRadioExample)" />

    <Demo Title="Looping" Description="Inside the open menu the arrow keys wrap from the last item back to the first by default. Set Loop to false on the content to stop at the ends instead. Right-click, then hold an arrow key to compare with the menus above."
          Example="typeof(ContextMenuLoopExample)" />

    <Demo Title="Customization"
          Description="Restyle any part via Class - a branded dashed trigger and a content panel with a custom width, radius, and tint. Utilities win over the skin, so these take effect."
          Example="typeof(ContextMenuCustomExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the menu anchors at the pointer and mirrors: shortcuts sit on the left and the submenu opens to the left with its chevron flipped."
          Example="typeof(ContextMenuRtlExample)" />

</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzContextMenu",
        new CompositionNode("BzContextMenuTrigger"),
        new CompositionNode("BzContextMenuContent",
            new CompositionNode("BzContextMenuGroup",
                new CompositionNode("BzContextMenuLabel"),
                new CompositionNode("BzContextMenuItem",
                    new CompositionNode("BzContextMenuShortcut")),
                new CompositionNode("BzContextMenuCheckboxItem"),
                new CompositionNode("BzContextMenuRadioGroup",
                    new CompositionNode("BzContextMenuRadioItem"))),
            new CompositionNode("BzContextMenuSeparator"),
            new CompositionNode("BzContextMenuSub",
                new CompositionNode("BzContextMenuSubTrigger"),
                new CompositionNode("BzContextMenuSubContent"))));
}
