@page "/docs/components/context-menu"
@using Blaizio.Docs.Examples.ContextMenu
<PageTitle>Context Menu - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Context Menu</h1>
            <DocBadges Slug="context-menu" />
        </div>
        <p>A right-click menu that opens at the pointer, positioned with <a class="font-medium text-foreground" href="https://floating-ui.com" target="_blank" rel="noopener">Floating UI</a>. It shares the dropdown menu's surface, so you get the same arrow-key and type-ahead navigation, checkbox and radio items, and nested submenus. The menu is <strong>non-modal</strong>, which means the rest of the page stays interactive while it is open.</p>
    </header>

    <UsageBlock Example="typeof(ContextMenuUsageExample)"
                Description="After importing `Blaizio.Ui`, wrap the area you want in a trigger and add the content. A right-click anywhere inside the trigger opens the menu at the pointer." />

    <CompositionTree Root="Anatomy"
                     Description="Every part of a context menu. Group items under labels, divide sections with a separator, and nest a `BzContextMenuSub` for each submenu." />

    <ExamplesHeading />

    <Demo Title="Default" Description="Right-click the area to open the menu. Use the arrow keys or type the start of an item's name to move through it, and press Escape to close."
          Example="typeof(ContextMenuDefaultExample)" />

    <Demo Title="Item as a link (RenderAs)" Description="Use `RenderAs` to render a menu item as your own element. Here it is an anchor, so the item navigates like a real link."
          Example="typeof(ContextMenuItemAsLinkExample)" />

    <Demo Title="Items with icons" Description="Icons sit at the inline start of each item and keyboard shortcuts at the inline end, so both mirror in right-to-left layouts."
          Example="typeof(ContextMenuIconsExample)" />

    <Demo Title="Inset items" Description="Set `Inset` on items without a leading icon. It adds the indent that lines their text up with labels and with items that do have an icon."
          Example="typeof(ContextMenuInsetExample)" />

    <Demo Title="Nested submenus" Description="A submenu opens to the side on hover or with the inline-end arrow key, and submenus can nest as deep as you need. A short grace delay lets the pointer cross the gap to the panel without it closing."
          Example="typeof(ContextMenuSubmenusExample)" />

    <Demo Title="Checkbox &amp; radio items" Description="To keep the menu open while toggling, call `PreventDefault` in each checkbox's `OnSelect`. Checkbox and radio states are both two-way bound."
          Example="typeof(ContextMenuCheckboxRadioExample)" />

    <Demo Title="Looping" Description="By default the arrow keys wrap from the last item back to the first. Set `Loop` to `false` on the content to stop at the ends instead, then hold an arrow key to compare it with the menus above."
          Example="typeof(ContextMenuLoopExample)" />

    <Demo Title="Customization"
          Description="Every part accepts `Class`. This example gives the trigger a branded dashed border and the content panel a custom width, radius and tint."
          Example="typeof(ContextMenuCustomExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, the menu still opens at the pointer but its layout mirrors: shortcuts sit on the left, and submenus open to the left with a flipped chevron."
          Example="typeof(ContextMenuRtlExample)" />

</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzContextMenu",
        new CompositionNode("BzContextMenuTrigger"),
        new CompositionNode("BzContextMenuContent",
            new CompositionNode("BzContextMenuGroup",
                new CompositionNode("BzContextMenuLabel"),
                new CompositionNode("BzContextMenuItem",
                    new CompositionNode("BzContextMenuShortcut")),
                new CompositionNode("BzContextMenuCheckboxItem"),
                new CompositionNode("BzContextMenuRadioGroup",
                    new CompositionNode("BzContextMenuRadioItem"))),
            new CompositionNode("BzContextMenuSeparator"),
            new CompositionNode("BzContextMenuSub",
                new CompositionNode("BzContextMenuSubTrigger"),
                new CompositionNode("BzContextMenuSubContent"))));
}
