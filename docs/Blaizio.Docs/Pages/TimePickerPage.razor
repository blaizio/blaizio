@page "/components/time-picker"
<PageTitle>Time Picker - Blaizio بليزيو</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Time Picker</h1>
        <p class="text-muted-foreground">An inline time field binding a <code>TimeOnly</code>. You edit the hour, minute and optional seconds segments in place - type or step them - and the browser shows 12- or 24-hour by its own locale. Pairs with <a class="underline underline-offset-4" href="/components/calendar">Calendar</a> for a date-and-time picker.</p>
    </header>

    <UsageBlock Setup="@UsageSetup" Code="@UsageMarkup"
                Description="Add the using once, then two-way bind a nullable TimeOnly to Value." />

    <ExamplesHeading />

    <Demo Title="Basic" Description="An hour:minute field with a leading clock icon. 12- or 24-hour follows the browser's locale." Code="@BasicCode">
        <BzTimePicker @bind-Value="_time" />
    </Demo>

    <Demo Title="With seconds" Description="ShowSeconds adds the seconds segment (the native step becomes one second)." Code="@SecondsCode">
        <BzTimePicker @bind-Value="_timeSeconds" ShowSeconds />
    </Demo>

    <Demo Title="Minute step" Description="MinuteStep coarsens the stepper increment - here to 15-minute jumps when you use the arrows." Code="@StepCode">
        <BzTimePicker @bind-Value="_timeStep" MinuteStep="15" />
    </Demo>

    <Demo Title="No icon" Description="ShowIcon=false drops the leading clock for a bare field. Pass Icon to swap in your own." Code="@NoIconCode">
        <BzTimePicker @bind-Value="_timeBare" ShowIcon="false" />
    </Demo>

    <Demo Title="Disabled" Description="Disabled greys the field and blocks editing." Code="@DisabledCode">
        <BzTimePicker @bind-Value="_timeDisabled" Disabled />
    </Demo>

    <Demo Title="Customization"
          Description="Pass your own classes via Class - width, radius, brand focus ring - merged over the field defaults, and swap the leading glyph through the Icon slot."
          Code="@CustomCode">
        <div class="flex flex-wrap items-center gap-3">
            <BzTimePicker @bind-Value="_timeCustom" Class="w-44 rounded-full px-4" />
            <BzTimePicker @bind-Value="_timeCustomAccent" Class="border-indigo-500/60 focus-within:border-indigo-500 focus-within:ring-indigo-500/40">
                <Icon><BzIcon Icon="@Icons.Outline.Clock" Class="size-4 text-indigo-500" /></Icon>
            </BzTimePicker>
        </div>
    </Demo>

    <Demo Title="RTL"
          Description="Under a right-to-left DirectionProvider the field mirrors - the clock icon moves to the inline-end edge - while the native time segments stay numeric."
          Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzTimePicker @bind-Value="_timeRtl" />
        </BzDirectionProvider>
    </Demo>

</div>

@code {
    private TimeOnly? _time = new(9, 30);
    private TimeOnly? _timeSeconds = new(14, 5, 30);
    private TimeOnly? _timeStep = new(9, 0);
    private TimeOnly? _timeBare = new(9, 30);
    private TimeOnly? _timeDisabled = new(12, 0);
    private TimeOnly? _timeCustom = new(9, 30);
    private TimeOnly? _timeCustomAccent = new(18, 15);
    private TimeOnly? _timeRtl = new(9, 30);

    private const string UsageSetup = """
        @* _Imports.razor (or the top of the page) *@
        @using Blaizio.Ui
        """;

    private const string UsageMarkup = """
        <BzTimePicker @bind-Value="_time" />

        @code {
            private TimeOnly? _time = new(9, 30);
        }
        """;

    private const string BasicCode = """
        <BzTimePicker @bind-Value="_time" />

        @code {
            private TimeOnly? _time = new(9, 30);
        }
        """;

    private const string SecondsCode = """
        <BzTimePicker @bind-Value="_time" ShowSeconds />

        @code {
            private TimeOnly? _time = new(14, 5, 30);
        }
        """;

    private const string StepCode = """
        <BzTimePicker @bind-Value="_time" MinuteStep="15" />

        @code {
            private TimeOnly? _time = new(9, 0);
        }
        """;

    private const string NoIconCode = """
        <BzTimePicker @bind-Value="_time" ShowIcon="false" />

        @code {
            private TimeOnly? _time = new(9, 30);
        }
        """;

    private const string DisabledCode = """
        <BzTimePicker @bind-Value="_time" Disabled />

        @code {
            private TimeOnly? _time = new(12, 0);
        }
        """;

    private const string CustomCode = """
        <BzTimePicker @bind-Value="_time" Class="w-44 rounded-full px-4" />

        <BzTimePicker @bind-Value="_time" Class="border-indigo-500/60 focus-within:border-indigo-500 focus-within:ring-indigo-500/40">
            <Icon><BzIcon Icon="@Icons.Outline.Clock" Class="size-4 text-indigo-500" /></Icon>
        </BzTimePicker>

        @code {
            private TimeOnly? _time = new(9, 30);
        }
        """;

    private const string RtlCode = """
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzTimePicker @bind-Value="_time" />
        </BzDirectionProvider>

        @code {
            private TimeOnly? _time = new(9, 30);
        }
        """;
}
