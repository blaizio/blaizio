@page "/docs/components/sortable"
@using Blaizio.Docs.Examples.Sortable
<PageTitle>Sortable - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Sortable</h1>
            <DocBadges Slug="sortable" />
        </div>
        <p class="text-muted-foreground">Drag to reorder a list - or swap two items - with a pointer or the keyboard. Items shift out of the way as you drag (or trade places in swap mode), and every committed move is reported as a <span class="font-mono text-sm">SortableChange</span> you apply to your own data. Works as a vertical column, a horizontal row, or a wrapping grid, and lists that share a group can hand items to one another.</p>
    </header>

    <UsageBlock Example="typeof(SortableUsageExample)"
                Description="Bind a list to BzSortableList and give it an item template, or compose BzSortableItem children under BzSortable. Handle OnReorder (or bind Items) to persist the new order." />

    <CompositionTree Root="Anatomy"
                     Description="A sortable list of items; an optional handle inside an item restricts dragging to a grip." />

    <ExamplesHeading />

    <Demo Title="Default" Description="A vertical list. Drag an item to reorder - or focus one (Tab) and press Space to pick it up, arrow keys to move, Space to drop." Example="typeof(SortableDefaultExample)" />

    <Demo Title="Drag handle" Description="Put a BzSortableHandle inside an item and only the grip starts a drag - the rest of the item stays clickable, and only the grip shows the grab cursor." Example="typeof(SortableHandleExample)" />

    <Demo Title="Data-driven" Description="BzSortableList renders one keyed item per element and applies the move for you - bind a list and go." Example="typeof(SortableDataExample)" />

    <Demo Title="Horizontal" Description="Set Orientation=Horizontal to lay items out in a row. Chips of different widths reflow exactly - each item stacks by its own size. LockAxis keeps the drag on the row's axis. Arrow Left/Right reorder when grabbed." Example="typeof(SortableHorizontalExample)" />

    <Demo Title="Grid" Description="Orientation=Grid hit-tests in two dimensions; pass Columns so Up/Down keyboard moves jump a whole row." Example="typeof(SortableGridExample)" />

    <Demo Title="Swap" Description="Strategy=Swap trades the dragged item with the one you drop it on. SwapMode picks the preview: Swap (default) trades live as you hover; Drop holds everything still until release - pair it with ShowPlaceholder so the target stays visible." Example="typeof(SortableSwapExample)" />

    <Demo Title="Mixed-size grid" Description="Cards can span columns and rows. As you drag, every card previews its true landing position - the candidate order is laid out for real (in a hidden measurement pass), so spanning cards reflow exactly, and the placeholder marks the dragged card's landing rect." Example="typeof(SortableMixedGridExample)" />

    <Demo Title="Animations" Description="Animation picks the motion: Dynamic (a quick glide, the default), Spring (a bouncy overshoot) or None (instant). Whatever you choose, users whose OS asks for reduced motion get instant snaps." Example="typeof(SortableAnimationsExample)" />

    <Demo Title="Cross-list groups" Description="Give two lists the same Group and drag items between them. Each list carries an Id so the handler knows which side is source and which is target." Example="typeof(SortableCrossExample)" />

    <Demo Title="Transfer control" Description="AllowTransferOut / AllowTransferIn gate cross-list moves per side, and AllowSorting=false stops reordering within a list. Here the palette only gives (nothing can be dropped back or reordered), and the canvas receives via its own OnReceive handler." Example="typeof(SortableTransferExample)" />

    <Demo Title="Custom cursors" Description="Cursor and GrabbingCursor take any CSS cursor value; BzCursor.From turns a Blaizio icon into one - here the Tabler open and closed hands. Set them once on the list and every item (and handle) follows. The grabbing hand shows from the moment you press, before any movement." Example="typeof(SortableCursorsExample)" />

    <Demo Title="Keyboard & accessibility" Description="Every sortable is keyboard-operable: Tab to an item, Space to pick it up (it highlights and announces via a live region), arrow keys to move, Space to drop, Escape to cancel. Try it without a mouse." Example="typeof(SortableKeyboardExample)" />
</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzSortable",
        new CompositionNode("BzSortableItem",
            new CompositionNode("BzSortableHandle")),
        new CompositionNode("BzSortableItem"));
}
