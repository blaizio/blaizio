@page "/docs/components/scroll-area"
@using Blaizio.Docs.Examples.ScrollArea
<PageTitle>Scroll Area - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Scroll Area</h1>
        <p class="text-muted-foreground">A scrollable region with a custom overlay scrollbar. The native scrollbar is hidden and a slim, theme-aware thumb is drawn over the content - sized and positioned from the live scroll, draggable, and shown on demand. Give the root a size and drop in any content.</p>
    </header>

    <UsageBlock Example="typeof(ScrollAreaUsageExample)"
                Description="Add the using once, then wrap content in a BzScrollArea and size the root via Class. The vertical scrollbar appears when the content overflows." />

    <ExamplesHeading />

    <Demo Title="Default" Description="A fixed-height region that scrolls vertically. The overlay scrollbar appears whenever the content overflows." Example="typeof(ScrollAreaDefaultExample)" />

    <Demo Title="Horizontal" Description="Set Orientation to Horizontal for a row that scrolls sideways. Lay the content out as a non-wrapping row (here a w-max flex)." Example="typeof(ScrollAreaHorizontalExample)" />

    <Demo Title="Both axes" Description="Orientation=Both renders a scrollbar on each axis, with a corner where they meet. Use it for wide, tall content like a data grid." Example="typeof(ScrollAreaBothExample)" />

    <Demo Title="Visibility" Description="Type controls when the scrollbar shows: Auto (whenever content overflows), Always, Hover (on pointer-over or while scrolling), or Scroll (only while scrolling, then fades)." Example="typeof(ScrollAreaTypeExample)" />

    <Demo Title="Customization" Description="Size the region with Class on the root, and restyle the thumb by targeting its data-slot. Here a wider, indigo thumb and a tinted surface." Example="typeof(ScrollAreaCustomExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the vertical scrollbar mirrors to the left edge and the content flows right-to-left." Example="typeof(ScrollAreaRtlExample)" />

</div>

