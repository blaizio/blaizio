@page "/docs/components/input-date"
@using Blaizio.Docs.Examples.InputDate
<PageTitle>Input Date - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Input Date</h1>
            <DocBadges Slug="input-date" />
        </div>
        <p class="text-muted-foreground">An inline date field binding a <code>DateOnly</code>. <code>Format</code> drives the segment order and separators; you type or arrow-step the day, month and year in place, and an optional trailing button opens a <a class="underline underline-offset-4" href="/docs/components/calendar">Calendar</a> popup. Pairs with <a class="underline underline-offset-4" href="/docs/components/input-time">Input Time</a> for a full date-and-time entry.</p>
    </header>

    <UsageBlock Example="typeof(InputDateUsageExample)"
                Description="Add the using once, then two-way bind a nullable DateOnly to Value. Type digits - the focus hops to the next segment - or step with the arrows." />

    <ExamplesHeading />

    <Demo Title="Basic" Description="The default yyyy-MM-dd layout with a leading calendar icon."
          Example="typeof(InputDateBasicExample)" />

    <Demo Title="Format" Description="Format reorders the segments and sets the separators - any mix of d / M / y runs with literals between them."
          Example="typeof(InputDateFormatExample)" />

    <Demo Title="With calendar popup" Description="ShowCalendar adds a trailing button that opens the Calendar - picking a day fills the segments and closes the popup. Min/Max and Culture flow through to it."
          Example="typeof(InputDateCalendarExample)" />

    <Demo Title="No icon" Description="ShowIcon=false drops the leading glyph for a bare field. Pass Icon to swap in your own."
          Example="typeof(InputDateNoIconExample)" />

    <Demo Title="Disabled" Description="Disabled greys the field and blocks editing."
          Example="typeof(InputDateDisabledExample)" />

    <Demo Title="Date and time" Description="Compose with Input Time for a compact date-and-time row - each binds its own value."
          Example="typeof(InputDateDateTimeExample)" />

    <Demo Title="Customization"
          Description="Pass your own classes via Class - width, radius, brand focus ring - and swap the leading glyph through the Icon slot (hide it entirely with ShowIcon=false)."
          Example="typeof(InputDateCustomExample)" />
</div>

