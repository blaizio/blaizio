@page "/docs/components/drawer"
@using Blaizio.Docs.Examples.Drawer
<PageTitle>Drawer - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Drawer</h1>
            <DocBadges Slug="drawer" />
        </div>
        <p>A panel anchored to an edge of the screen that you can drag back toward that edge to dismiss, which makes it a good fit for touch screens. It is built on the same foundation as Dialog, so focus stays inside, the page stops scrolling, and Escape or a backdrop click closes it. On top of that, bottom drawers get a grab handle, and any drawer can rest at snap points between open and closed.</p>
    </header>

    <UsageBlock Example="typeof(DrawerUsageExample)"
                Description="After importing `Blaizio.Ui`, add a trigger and a content panel. Drag the panel or its handle toward the edge to dismiss it. A short drag springs back." />

    <CompositionTree Root="Anatomy"
                     Description="Every part of a drawer. Bottom drawers add the grab handle for you, and `BzDrawerClose` dismisses the panel from inside." />

    <ExamplesHeading />

    <Demo Title="Default" Description="A bottom drawer with a grab handle. Drag or flick it down to dismiss it, or press Escape or click the backdrop."
          Example="typeof(DrawerDefaultExample)" />

    <Demo Title="Snap points"
          Description="`SnapPoints` takes fractions of the panel's height, and the drawer can rest at each one. Drag the handle between them, or flick or drag below the lowest to dismiss. Bind `SnapPoint` to read the active one."
          Example="typeof(DrawerSnapPointsExample)" />

    <Demo Title="Custom trigger element (RenderAs)"
          Description="If the trigger should be your own element rather than the default button, use `RenderAs` and apply the attributes it provides to that element."
          Example="typeof(DrawerRenderAsTriggerExample)" />

    <Demo Title="Background scaling"
          Description="Wrap the page content in a `BzDrawerProvider` and set `ScaleBackground` on the drawer content. When the drawer opens, the wrapped content scales down and rounds its corners against whatever surface sits behind it. The demo keeps the effect inside its own panel."
          Example="typeof(DrawerScaleExample)" />

    <Demo Title="Sides" Description="Set `Side` to anchor the drawer to any edge. Each one is dismissed by dragging toward its own edge, and only the bottom drawer shows the handle by default."
          Example="typeof(DrawerDirectionsExample)" />

    <Demo Title="Controlled" Description="Bind the open state to a field in your page when other code needs to open or close the drawer. In this example, every change shows a toast so you can follow it."
          Example="typeof(DrawerControlledExample)" />

    <Demo Title="Scrollable content" Description="Content taller than the drawer scrolls inside it. Dragging to dismiss waits for the inner scroll, so the panel only moves once the list reaches its edge."
          Example="typeof(DrawerScrollableExample)" />

    <Demo Title="Non-dismissible" Description="Set `PreventDismiss` when the user must make a choice. Drags spring back, Escape and backdrop clicks are ignored and the corner close button is hidden, so only a `BzDrawerClose` or your own code can close it."
          Example="typeof(DrawerLockedExample)" />

    <Demo Title="Form" Description="On mobile, a drawer works well for a short form. Bind the fields, submit from a footer button, and dismiss with `BzDrawerClose` on success."
          Example="typeof(DrawerFormExample)" />

    <Demo Title="Async content" Description="To load content when the drawer opens, handle `OpenChanged`, start the fetch and show skeletons from your own flag until the data arrives. No extra service is involved."
          Example="typeof(DrawerAsyncExample)" />

    <Demo Title="Customization"
          Description="Every part accepts `Class`, and the backdrop takes `OverlayClass` for both its tint and its blur. Here `OverlayClass` replaces the default light tint with a deeper indigo and a stronger `backdrop-blur-md`."
          Example="typeof(DrawerCustomExample)" />

    <Demo Title="RTL" Description="`Left` and `Right` are logical sides, so they mirror inside a right-to-left `DirectionProvider`. This `Right` drawer opens on the left, is dragged toward the left edge to dismiss, and its content flows right to left."
          Example="typeof(DrawerRtlExample)" />

</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzDrawer",
        new CompositionNode("BzDrawerTrigger"),
        new CompositionNode("BzDrawerContent",
            new CompositionNode("BzDrawerHeader",
                new CompositionNode("BzDrawerTitle"),
                new CompositionNode("BzDrawerDescription")),
            new CompositionNode("BzDrawerFooter",
                new CompositionNode("BzDrawerClose"))));
}
