@page "/docs/components/drawer"
@using Blaizio.Docs.Examples.Drawer
<PageTitle>Drawer - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Drawer</h1>
            <DocBadges Slug="drawer" />
        </div>
        <p class="text-muted-foreground">An edge-anchored panel you can drag toward its edge to dismiss. Built on the Dialog machinery - focus traps inside, page scroll locks, Escape or a backdrop click closes it - with a touch-friendly drag gesture and a grab handle on bottom drawers.</p>
    </header>

    <UsageBlock Example="typeof(DrawerUsageExample)"
                Description="Add the using once, then compose a trigger and a content panel. Drag the panel (or its handle) toward the edge to dismiss; a short drag springs back." />

    <CompositionTree Root="Anatomy"
                     Description="The full anatomy. The grab handle is added automatically on bottom drawers; BzDrawerClose dismisses the panel from inside." />

    <ExamplesHeading />

    <Demo Title="Default" Description="A bottom drawer with a grab handle. Drag it down (or flick) to dismiss, or press Escape or the backdrop."
          Example="typeof(DrawerDefaultExample)" />

    <Demo Title="Snap points"
          Description="Give SnapPoints (fractions of the panel's height that are visible) and the drawer rests at each. Drag the handle between them; a flick or a drag below the lowest snap dismisses. Bind SnapPoint to read the active one."
          Example="typeof(DrawerSnapPointsExample)" />

    <Demo Title="Custom trigger element (RenderAs)"
          Description="When the trigger should be your own element rather than the default button, use RenderAs and splat the behaviour onto it."
          Example="typeof(DrawerRenderAsTriggerExample)" />

    <Demo Title="Background scaling"
          Description="Wrap the content that should recede in a BzDrawerProvider and set ScaleBackground on the content - when the drawer opens the page scales down, rounds, and settles back onto the surface behind it (the vaul indent). It recedes onto whatever the wrapped content sits on - here the muted app surface, not a forced colour. Shown in a self-contained panel so the effect stays inside the demo."
          Example="typeof(DrawerScaleExample)" />

    <Demo Title="Sides" Description="Anchor the drawer to any edge with Side. Each one drags toward its own edge to dismiss; only the bottom drawer shows the handle by default."
          Example="typeof(DrawerDirectionsExample)" />

    <Demo Title="Controlled" Description="Bind the open state two-way - here each change raises a toast."
          Example="typeof(DrawerControlledExample)" />

    <Demo Title="Scrollable content" Description="A drawer taller than its content scrolls inside. The drag-to-dismiss yields to the inner scroll - you can only drag the panel away once the list is scrolled to its edge."
          Example="typeof(DrawerScrollableExample)" />

    <Demo Title="Non-dismissible" Description="DismissOnOutsideClick=false pins the drawer: dragging springs back, Escape and the backdrop do nothing, and the corner close button is hidden. Only an explicit DrawerClose (or your code) closes it."
          Example="typeof(DrawerLockedExample)" />

    <Demo Title="Form" Description="A drawer is a natural host for a short form on mobile. Bind the fields and submit from a footer button; DrawerClose dismisses on success."
          Example="typeof(DrawerFormExample)" />

    <Demo Title="Async content" Description="No service is needed to load content on open - render a loading state from your own flag. Handle OpenChanged, start the fetch, show skeletons, then swap in the content when it arrives."
          Example="typeof(DrawerAsyncExample)" />

    <Demo Title="Customization"
          Description="Restyle any part via Class, and the backdrop via OverlayClass - both its tint and its blur. The default backdrop is a light tint with a hairline blur; here OverlayClass sets a deeper indigo tint and a stronger backdrop-blur-md. Root-level utilities win over the skin, so these take effect."
          Example="typeof(DrawerCustomExample)" />

    <Demo Title="RTL" Description="Left/Right are logical (inline start/end), so they mirror under a DirectionProvider. This Right (inline-end) drawer therefore opens on the LEFT in RTL, drags toward the left edge to dismiss, and the content flows right-to-left."
          Example="typeof(DrawerRtlExample)" />

</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzDrawer",
        new CompositionNode("BzDrawerTrigger"),
        new CompositionNode("BzDrawerContent",
            new CompositionNode("BzDrawerHeader",
                new CompositionNode("BzDrawerTitle"),
                new CompositionNode("BzDrawerDescription")),
            new CompositionNode("BzDrawerFooter",
                new CompositionNode("BzDrawerClose"))));
}
