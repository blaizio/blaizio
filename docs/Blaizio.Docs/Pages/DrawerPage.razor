                <div class="mx-auto w-full max-w-sm">
                    <BzDrawerHeader>
                        <BzDrawerTitle>Send feedback</BzDrawerTitle>
                        <BzDrawerDescription>Tell us what's working and what isn't.</BzDrawerDescription>
                    </BzDrawerHeader>
                    <div class="grid gap-4 px-4">
                        <div class="grid gap-2">
                            <BzLabel for="fb-name">Name</BzLabel>
                            <BzInputText id="fb-name" @bind-Value="_name" placeholder="Ada Lovelace" />
                        </div>
                        <div class="grid gap-2">
                            <BzLabel for="fb-email">Email</BzLabel>
                            <BzInputText id="fb-email" @bind-Value="_email" Type="email" placeholder="ada@example.com" />
                        </div>
                        <div class="grid gap-2">
                            <BzLabel for="fb-msg">Message</BzLabel>
                            <BzInputText id="fb-msg" @bind-Value="_message" Rows="3" placeholder="What's on your mind?" />
                        </div>
                    </div>
                    <BzDrawerFooter>
                        <BzButton @onclick="@(() => _open = false)">Submit</BzButton>
                        <BzDrawerClose Variant="ButtonVariant.Outline">Cancel</BzDrawerClose>
                    </BzDrawerFooter>
                </div>
            </BzDrawerContent>
        </BzDrawer>

        @code {
            private bool _open;
            private string? _name, _email, _message;
        }
        """;

    private const string AsyncCode = """
        <BzDrawer Open="_open" OpenChanged="OnOpenChanged">
            <BzDrawerTrigger Variant="ButtonVariant.Outline">Load profile</BzDrawerTrigger>
            <BzDrawerContent>
                <div class="mx-auto w-full max-w-sm">
                    <BzDrawerHeader>
                        <BzDrawerTitle>Profile</BzDrawerTitle>
                        <BzDrawerDescription>Fetched when the drawer opens.</BzDrawerDescription>
                    </BzDrawerHeader>
                    <div class="p-4">
                        @if (_profile is null)
                        {
                            <div class="flex items-center gap-4">
                                <BzSkeleton Class="size-12 rounded-full" />
                                <div class="grid flex-1 gap-2">
                                    <BzSkeleton Class="h-4 w-3/4" />
                                    <BzSkeleton Class="h-4 w-1/2" />
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="font-medium">@_profile</p>
                        }
                    </div>
                </div>
            </BzDrawerContent>
        </BzDrawer>

        @code {
            private bool _open;
            private string? _profile;

            // No service needed: load on open, render a loading state from your own flag.
            private async Task OnOpenChanged(bool open)
            {
                _open = open;
                if (!open) return;
                _profile = null;                 // show the skeletons
                await Task.Delay(1200);          // stand-in for an API call
                if (_open) _profile = "Ada Lovelace";
            }
        }
        """;

