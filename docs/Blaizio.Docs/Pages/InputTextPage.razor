@page "/docs/components/input-text"
@using Blaizio.Docs.Examples.InputText
<PageTitle>Input Text - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Input Text</h1>
            <DocBadges Slug="input-text" />
        </div>
        <p class="text-muted-foreground">One text field for both single- and multi-line input: it is a single-line <code class="font-mono text-sm">&lt;input&gt;</code> by default, and becomes a multi-line <code class="font-mono text-sm">&lt;textarea&gt;</code> the moment you set <code class="font-mono text-sm">Rows</code>. <code class="font-mono text-sm">@@bind-Value</code> updates live as you type.</p>
    </header>

    <UsageBlock Example="typeof(InputTextUsageExample)" Description="One control for both single- and multi-line text; the value updates live as you type." />

    <ExamplesHeading />

    <Demo Title="Default" Example="typeof(InputTextDefaultExample)" />

    <Demo Title="Multiline" Description="Set Rows to render a textarea. It still grows with its content above that height."
          Example="typeof(InputTextMultilineExample)" />

    <Demo Title="With Field" Description="Field wires the label, description, and ids; the field stays validation-agnostic."
          Example="typeof(InputTextFieldExample)" />

    <Demo Title="Multiline with Field" Description="The same Field wiring works for the multi-line mode."
          Example="typeof(InputTextMultilineFieldExample)" />

    <Demo Title="Invalid" Description="aria-invalid drives the destructive ring - here forced, normally set by FieldControl."
          Example="typeof(InputTextInvalidExample)" />

    <Demo Title="Disabled" Example="typeof(InputTextDisabledExample)" />

    <Demo Title="States"
          Description="ReadOnly keeps the value selectable but not editable; Required feeds native form validation; MaxLength caps the input."
          Example="typeof(InputTextStatesExample)" />

    <Demo Title="Focus and key events"
          Description="KeyDown for submit-on-Enter, Blur for validate-on-leave, Focus for the mirror case."
          Example="typeof(InputTextEventsExample)" />

    <Demo Title="File" Description="Type is single-line only (a textarea has no type), so it is ignored once Rows is set."
          Example="typeof(InputTextFileExample)" />

    <Demo Title="Live binding" Description="The label mirrors the value on every keystroke."
          Example="typeof(InputTextBindingExample)" />

    <Demo Title="Debounced search"
          Description="Set DebounceDelay (milliseconds) and ValueChanged waits for a typing pause instead of firing per keystroke - a burst of typing lands as one change. The second field also waits for at least 3 characters before it searches."
          Example="typeof(InputTextDebounceExample)" />

    <Demo Title="Customization"
          Description="Brand the field with unconditional border / radius and a focus ring utility - they merge over the bz-input defaults."
          Example="typeof(InputTextCustomExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic or Hebrew copy - the labels, placeholders, and descriptions all mirror to the right."
          Example="typeof(InputTextRtlExample)" />
</div>

