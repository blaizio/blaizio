@page "/docs/components/attachment"
@using Blaizio.Docs.Examples.Attachment
<PageTitle>Attachment - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Attachment</h1>
            <DocBadges Slug="attachment" />
        </div>
        <p class="text-muted-foreground">File cards with upload states, and a drag-and-drop zone to collect them. The dropzone needs no JS: a native file input stretched across it takes clicks, keyboard and OS drops, and validates type, size and count. Compose cards from Media, Content (Title + Description), Actions and an optional full-card Trigger; line several up in a Group.</p>
    </header>

    <UsageBlock Example="typeof(AttachmentDefaultExample)" />

    <ExamplesHeading />

    <Demo Title="Dropzone" Description="Drag files onto the dashed zone (it highlights) or click it to browse. Accepted files are listed as attachment cards; refused ones (wrong type, over 5 MB, more than 4) are reported via OnFilesRejected."
          Example="typeof(AttachmentDropzoneExample)" />

    <Demo Title="Image" Description="Vertical orientation turns the card into a stacked preview - the image media becomes the hero."
          Example="typeof(AttachmentImageExample)" />

    <Demo Title="States" Description="The upload lifecycle on data-state: uploading and processing pulse the media and mute the title, error paints the border and description destructive, done is at rest."
          Example="typeof(AttachmentStatesExample)" />

    <Demo Title="Sizes" Description="Three densities - default, sm, and the chip-like xs."
          Example="typeof(AttachmentSizesExample)" />

    <Demo Title="Group" Description="A horizontally scrollable row for composers and upload trays."
          Example="typeof(AttachmentGroupExample)" />

    <Demo Title="Trigger" Description="An invisible overlay makes the whole card clickable - here it opens a preview dialog - while the actions stay independently clickable above it."
          Example="typeof(AttachmentTriggerExample)" />

    <ApiReference Types="ApiFamilies.Attachment" />
</div>
