@page "/components/collapsible"
@using Blaizio.Docs.Examples.Collapsible
<PageTitle>Collapsible - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Collapsible</h1>
        <p class="text-muted-foreground">An expandable section with a trigger you style yourself.</p>
    </header>

    <UsageBlock Example="typeof(CollapsibleUsageExample)"
                Description="Add the using once, then compose a trigger and content. The trigger is usually a Button via RenderAs; the panel animates open and closed." />

    <CompositionTree Root="Anatomy"
                     Description="The full anatomy. The collapsible holds a trigger (your own element, via RenderAs) and a content panel that animates open and closed." />

    <ExamplesHeading />

    <Demo Title="Default" Description="The trigger is usually a Button via RenderAs. The panel animates open and closed." Example="typeof(CollapsibleDefaultExample)" />

    <Demo Title="Custom trigger (RenderAs)" Description="Render the trigger onto your own element - here an anchor - instead of the default button, by splatting p.Attributes." Example="typeof(CollapsibleRenderAsTriggerExample)" />

    <Demo Title="Open by default" Description="Start expanded with DefaultOpen." Example="typeof(CollapsibleDefaultOpenExample)" />

    <Demo Title="Disabled" Description="Disabled blocks toggling and dims the trigger." Example="typeof(CollapsibleDisabledExample)" />

    <Demo Title="Custom indicator" Description="Swap an icon off the trigger's expanded state, the way the accordion does." Example="typeof(CollapsibleIndicatorExample)" />

    <Demo Title="Controlled" Description="Bind the open state two-way." Example="typeof(CollapsibleControlledExample)" />

    <Demo Title="Customization"
          Description="Restyle the parts via Class - here the trigger is a full-width indigo pill and the panel rows pick up a tinted border. The trigger is your own Button, so style it directly."
          Example="typeof(CollapsibleCustomExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the trigger, padding and rows all mirror to the right." Example="typeof(CollapsibleRtlExample)" />
</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzCollapsible",
        new CompositionNode("BzCollapsibleTrigger"),
        new CompositionNode("BzCollapsibleContent"));
}
