@page "/docs/components/tabs"
@using Blaizio.Docs.Examples.Tabs
<PageTitle>Tabs - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Tabs</h1>
            <DocBadges Slug="tabs" />
        </div>
        <p>Tabs follow the WAI-ARIA tabs pattern: the arrow keys move focus between triggers, and Enter or Space activates the focused one. Activation is manual by default, so arrowing past a tab does not switch panels until you choose it, and <code>ActivationMode</code> makes selection follow focus when you prefer that.</p>
    </header>

    <UsageBlock Example="typeof(TabsUsageExample)"
                Description="Import `Blaizio.Ui` once, then list the triggers and match each one to a content panel by `Value`. Give the `BzTabsList` an `AriaLabel` that names what the tabs switch between." />

    <CompositionTree Root="Anatomy"
                     Description="A `BzTabs` root holds one `BzTabsList` of triggers and a `BzTabsContent` panel per tab. Each trigger's `Value` pairs it with the matching panel." />

    <ExamplesHeading />

    <Demo Title="Default" Description="The default look is a filled pill strip. Arrow keys move focus between tabs and Enter or Space activates the focused one, or set `ActivationMode` to `Automatic` to make selection follow focus." Example="typeof(TabsDefaultExample)" />

    <Demo Title="Line" Description="The `Line` variant drops the strip's background and marks the active tab with an underline." Example="typeof(TabsLineExample)" />

    <Demo Title="Vertical" Description="Set `Orientation` to `Vertical` to place the list beside the content. The Up and Down arrow keys then move between tabs." Example="typeof(TabsVerticalExample)" />

    <Demo Title="Disabled tab" Example="typeof(TabsDisabledExample)" />

    <Demo Title="Controlled" Description="Bind `Value` when other code needs the active tab. The label below updates as you switch." Example="typeof(TabsControlledExample)" />

    <Demo Title="Looping" Description="By default the arrow keys wrap from the last tab back to the first. Set `Loop` to `false` on the `BzTabsList` to stop at the ends instead." Example="typeof(TabsLoopExample)" />

    <Demo Title="Panel focus" Description="Each panel is a tab stop by default, so keyboard users land on it right after the tab list even when it holds nothing focusable. When a panel starts with a focusable control, like these inputs, set `PanelFocusable` to `false` on the root and Tab goes straight into the field." Example="typeof(TabsPanelFocusExample)" />

    <Demo Title="Customization" Description="Every part accepts `Class`. This example gives the strip an indigo tint and extra radius, and styles the active tab through `data-active`." Example="typeof(TabsCustomExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, the tabs start from the right and the left and right arrow keys swap. The panels follow too: labels sit on the right and the card footer's action moves to the other edge." Example="typeof(TabsRtlExample)" />
</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzTabs",
        new CompositionNode("BzTabsList",
            new CompositionNode("BzTabsTrigger")),
        new CompositionNode("BzTabsContent"));
}
