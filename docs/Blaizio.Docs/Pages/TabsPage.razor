@page "/docs/components/tabs"
@using Blaizio.Docs.Examples.Tabs
<PageTitle>Tabs - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Tabs</h1>
            <DocBadges Slug="tabs" />
        </div>
        <p>Layered panels, one visible at a time. Arrow keys move between tabs; Enter or Space activates.</p>
    </header>

    <UsageBlock Example="typeof(TabsUsageExample)"
                Description="Add the using once, then list triggers and match each to a content panel by Value. Give the TabsList an AriaLabel naming what the tabs switch between." />

    <CompositionTree Root="Anatomy"
                     Description="The full anatomy. A BzTabs root holds one BzTabsList of triggers and a BzTabsContent panel per tab; each trigger's Value pairs it with the matching content." />

    <ExamplesHeading />

    <Demo Title="Default" Description="The filled pill strip. Arrow keys move focus between tabs and Enter or Space activates the focused one; set ActivationMode to Automatic if you want selection to follow focus instead." Example="typeof(TabsDefaultExample)" />

    <Demo Title="Line" Description="The transparent strip - the active tab gets an underline." Example="typeof(TabsLineExample)" />

    <Demo Title="Vertical" Description="Orientation Vertical puts the list beside the content; Up/Down arrows navigate." Example="typeof(TabsVerticalExample)" />

    <Demo Title="Disabled tab" Example="typeof(TabsDisabledExample)" />

    <Demo Title="Controlled" Description="Bind the value two-way; the label reacts to it." Example="typeof(TabsControlledExample)" />

    <Demo Title="Looping" Description="Arrow keys wrap from the last tab back to the first by default. Set Loop to false on the TabsList to stop at the ends instead. Focus a tab and hold the arrow key to feel the difference." Example="typeof(TabsLoopExample)" />

    <Demo Title="Panel focus" Description="By default each panel is a tab stop (tabindex 0), so keyboard users land on it right after the tablist even when its content has nothing focusable - the APG tabs pattern. When a panel's first element is itself focusable, like these inputs, set PanelFocusable to false on the root to skip the extra stop. Tab from a trigger to feel it: focus goes straight into the field." Example="typeof(TabsPanelFocusExample)" />

    <Demo Title="Customization" Description="Restyle with utilities via Class. Here a tinted indigo strip with extra radius, and the active tab recolors to a branded indigo - the active look keys off data-active." Example="typeof(TabsCustomExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic or Hebrew copy - the pill strip, arrow-key navigation and the cards under it all mirror: labels sit right, fields read right to left, and the card footer's action lands on the inline-start edge." Example="typeof(TabsRtlExample)" />
</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzTabs",
        new CompositionNode("BzTabsList",
            new CompositionNode("BzTabsTrigger")),
        new CompositionNode("BzTabsContent"));
}
