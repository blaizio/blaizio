@page "/docs/components/trace"
@using Blaizio.Docs.Examples.Trace
<PageTitle>Trace - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Trace</h1>
            <DocBadges Slug="trace" />
        </div>
        <p>The steps an agent takes, one line each: calling a tool, reading a file, searching, running a command. A line has an icon, a title, an optional description and a status, and it can expand, link out, or open a dialog or sheet. Use Message for the agent's reply and Marker for notes between turns.</p>
    </header>

    <UsageBlock Example="typeof(TraceUsageExample)" />

    <CompositionTree Root="Anatomy"
                     Description="BzTraceLine is always the line. To make a line do something, wrap it: in BzTraceCollapsibleTrigger to expand it, in an anchor to link out, or in a dialog or sheet trigger (through its RenderAs, onto a plain button) to open one. A BzTraceIcon after the title is the indicator, such as an arrow on a link." />

    <section>
        <h2 data-toc class="scroll-mt-20">Status</h2>
        <p>Set Status on BzTraceLine for work that is running, has failed or has not started. Status shows as color and motion, so say it in the title too.</p>
        <table>
            <thead>
                <tr><th>Status</th><th>Use for</th></tr>
            </thead>
            <tbody>
                <tr><td>Done (the default)</td><td>Work that is finished: "Ran dotnet restore".</td></tr>
                <tr><td>Running</td><td>Work in progress, with the title in the present tense: "Running dotnet build". The title shimmers.</td></tr>
                <tr><td>Error</td><td>Work that failed, saying so in the title: "Failed to run dotnet test". The line turns destructive.</td></tr>
                <tr><td>Pending</td><td>Work that has not started, such as a plan step: "Run dotnet publish". The line dims.</td></tr>
            </tbody>
        </table>
    </section>

    <section>
        <h2 data-toc class="scroll-mt-20">Accessibility</h2>
        <ul>
            <li>BzTrace adds no roles of its own. Each line takes its semantics from the element that wraps it.</li>
            <li>A BzTraceLine on its own is a <code>span</code>: read as text, never a tab stop. Inside BzTraceCollapsibleTrigger it is part of a button with <code>aria-expanded</code>; inside a link or a dialog trigger it takes that element's keyboard and focus behaviour.</li>
            <li>Icons are hidden from screen readers, so the title is the accessible name. Write it as a sentence that says what happened, "Edited Program.cs", not just "Program.cs".</li>
            <li>A link that opens a new tab says so in the title with visually hidden text: "(opens in a new tab)".</li>
            <li>The shimmer on a running title stops for readers who prefer reduced motion. The title still says what is happening.</li>
            <li>Inside a Message Scroller each line is announced once, when it is added.</li>
            <li>BzTraceCollapsibleContent mutes its text. Give a block with a muted background <code>text-foreground</code> to keep its contrast; BzCodeBlock sets its own color.</li>
        </ul>
    </section>

    <ExamplesHeading />

    <Demo Title="Trace line"
          Description="A BzTraceLine on its own is a step with no detail to show. It reads as plain text."
          Example="typeof(TraceLineExample)" />

    <Demo Title="Status"
          Description="Status sets the look of the line and BzTraceStatusIcon draws it: a check once done, a spinner while running, an alert on error, a dashed circle while pending. It reads the status of the line it sits in."
          Example="typeof(TraceStatusExample)" />

    <Demo Title="Description"
          Description="BzTraceDescription after the title holds a diff stat, a duration or a count. It never truncates; a long title gives way instead."
          Example="typeof(TraceDescriptionExample)" />

    <Demo Title="Collapsible"
          Description="Wrap the line in BzTraceCollapsibleTrigger and put the detail in BzTraceCollapsibleContent. The trigger is a button with aria-expanded and a chevron that turns when the row opens."
          Example="typeof(TraceCollapsibleExample)" />

    <Demo Title="Open state"
          Description="@OpenStateDescription"
          Example="typeof(TraceOpenExample)" />

    <Demo Title="Link"
          Description="Wrap the line in an anchor. A link to a new tab gets an arrow and says so to screen readers."
          Example="typeof(TraceLinkExample)" />

    <Demo Title="Dialog"
          Description="The dialog trigger renders a styled button by default, so RenderAs puts a plain button around the line instead, and the trace styles that button. The dialog owns its open state, Escape and focus return."
          Example="typeof(TraceDialogExample)" />

    <Demo Title="Sheet"
          Description="The same shape as the dialog. Drawer and Popover triggers work the same way."
          Example="typeof(TraceSheetExample)" />

    <Demo Title="Group"
          Description="Rows that sit next to each other go in one BzTrace: plain lines, rows that expand and links share one rhythm and one focus ring."
          Example="typeof(TraceGroupExample)" />

    <Demo Title="Sources"
          Description="A row whose detail is a BzTrace of link rows."
          Example="typeof(TraceSourcesExample)" />

    <Demo Title="Chain of thought"
          Description="A summary row with the steps inside. KeepRendered keeps the steps in the render tree while the summary is closed, so a step you opened stays open, and find-in-page reaches text inside closed rows and opens them."
          Example="typeof(TraceStepsExample)" />

    <Demo Title="Commit"
          Description="A row with a line per changed file. The title says what changed (Added, Edited, Deleted), the description carries the line counts, and each file opens its diff in a sheet."
          Example="typeof(TraceCommitExample)" />

    <Demo Title="Whole turn"
          Description="Three levels: the turn, a summary row, and the steps. Text written between steps sits between two BzTrace lists."
          Example="typeof(TraceTurnExample)" />

    <Demo Title="Reasoning"
          Description="Thinking as it streams: a plain line until the first text arrives, then a row that stays open while the text streams in and closes when it is done."
          Example="typeof(TraceReasoningExample)" />

    <Demo Title="Tool calls"
          Description="Tool calls moving through their states. A running call opens on its output, a failed one stays open on its error, and each title changes with its status."
          Example="typeof(TraceToolCallsExample)" />

    <Demo Title="RTL"
          Description="Wrapped in a DirectionProvider with Arabic or Hebrew copy: icons lead from the right, the rail sits under them, and a closed row's chevron points along the reading direction."
          Example="typeof(TraceRtlExample)" />
</div>

@code {
    // A C# string: Razor reads "@bind-Open" inside a component attribute as code.
    private const string OpenStateDescription =
        "Rows start closed. DefaultOpen starts one open, and @bind-Open controls it. AutoOpen is for " +
        "streaming work: the row opens while it is true and closes when it turns false, until the " +
        "reader opens or closes the row themselves - from then on their choice wins.";

    private static readonly CompositionNode Anatomy = new("BzTrace",
        new CompositionNode("BzTraceLine",
            new CompositionNode("BzTraceIcon (or BzTraceStatusIcon)"),
            new CompositionNode("BzTraceTitle"),
            new CompositionNode("BzTraceDescription"),
            new CompositionNode("BzTraceIcon")),
        new CompositionNode("BzTraceCollapsible",
            new CompositionNode("BzTraceCollapsibleTrigger",
                new CompositionNode("BzTraceLine")),
            new CompositionNode("BzTraceCollapsibleContent")));
}
