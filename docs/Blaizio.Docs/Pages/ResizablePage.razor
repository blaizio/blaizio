@page "/docs/components/resizable"
@using Blaizio.Docs.Examples.Resizable
<PageTitle>Resizable - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Resizable</h1>
            <DocBadges Slug="resizable" />
        </div>
        <p>Panels the user can resize by dragging the handle between them - horizontally or vertically, nested, and keyboard-accessible. Each panel takes a percentage of the group; drag (or focus a handle and use the arrow keys) to shift space between neighbours, within each panel's min/max.</p>
    </header>

    <UsageBlock Example="typeof(ResizableUsageExample)"
                Description="Put alternating BzResizablePanel and BzResizableHandle inside a BzResizablePanelGroup. Give panels a DefaultSize (percent); the group fills its container, so size that container. Give each handle an AriaLabel saying what it resizes - it is a keyboard-focusable separator, and screen readers announce that name with the current position." />

    <CompositionTree Root="Anatomy"
                     Description="A group of panels separated by handles. The handle resizes the two panels it sits between." />

    <ExamplesHeading />

    <Demo Title="Default" Description="Two panels with a grip handle. Drag the handle, or focus it (Tab) and use the arrow keys." Example="typeof(ResizableDefaultExample)" />

    <Demo Title="Handle styles" Description="Pick a grip with Handle - None (just the line), Grip, Dots, Knob or Pill. Each keeps the same drag/keyboard behaviour; pass your own content to replace it entirely." Example="typeof(ResizableHandleStylesExample)" />

    <Demo Title="Vertical" Description="Set Direction=Vertical to stack panels and resize their heights." Example="typeof(ResizableVerticalExample)" />

    <Demo Title="Three panels" Description="Any number of panels; each handle resizes only the two it sits between." Example="typeof(ResizableThreeExample)" />

    <Demo Title="Nested" Description="A panel can hold another group - here a vertical split inside the right panel, the classic app layout." Example="typeof(ResizableNestedExample)" />

    <Demo Title="Collapsible" Description="A collapsible panel snaps shut when you drag it past its MinSize, and pops back open when you drag it out." Example="typeof(ResizableCollapsibleExample)" />

    <Demo Title="Tracking the layout" Description="Handle OnLayout to read the panel sizes as they change - to persist them, sync a preview, etc." Example="typeof(ResizableLayoutExample)" />

    <Demo Title="Customization" Description="Restyle the handle with Class - here a thicker indigo bar - or replace the grip entirely by passing your own content to BzResizableHandle. The drag and keyboard behaviour stay intact." Example="typeof(ResizableCustomExample)" />

    <Demo Title="RTL" Description="Under a right-to-left DirectionProvider the panels and the drag direction mirror automatically." Example="typeof(ResizableRtlExample)" />

</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzResizablePanelGroup",
        new CompositionNode("BzResizablePanel"),
        new CompositionNode("BzResizableHandle"),
        new CompositionNode("BzResizablePanel"));
}
