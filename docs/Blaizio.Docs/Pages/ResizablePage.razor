@page "/docs/components/resizable"
@using Blaizio.Docs.Examples.Resizable
<PageTitle>Resizable - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Resizable</h1>
            <DocBadges Slug="resizable" />
        </div>
        <p>Split a region into panels that resize horizontally or vertically, and nest groups for full application layouts. Each panel takes a percentage of the group, and dragging a handle shifts space between its two neighbors within their minimum and maximum sizes. Every handle is also a focusable separator, so the arrow keys resize it from the keyboard.</p>
    </header>

    <UsageBlock Example="typeof(ResizableUsageExample)"
                Description="Alternate `BzResizablePanel` and `BzResizableHandle` inside a `BzResizablePanelGroup`, and give each panel a `DefaultSize` in percent. The group fills its container, so size the container. Give each handle an `AriaLabel` that says what it resizes, which screen readers announce along with the current position." />

    <CompositionTree Root="Anatomy"
                     Description="A group of panels separated by handles. Each handle resizes the two panels it sits between." />

    <ExamplesHeading />

    <Demo Title="Default" Description="Two panels with a grip handle. Drag it, or Tab to it and use the arrow keys." Example="typeof(ResizableDefaultExample)" />

    <Demo Title="Handle styles" Description="`Handle` picks the affordance. `None` leaves a bare hairline, `Line` highlights it on hover and while dragging, and `Grip`, `Dots`, `Knob` and `Pill` add a grip on top of that line. All of them drag and respond to the keyboard the same way." Example="typeof(ResizableHandleStylesExample)" />

    <Demo Title="Vertical" Description="Set `Orientation` to `Vertical` to stack the panels and resize their heights." Example="typeof(ResizableVerticalExample)" />

    <Demo Title="Three panels" Description="A group can hold any number of panels, and each handle resizes only the two it sits between." Example="typeof(ResizableThreeExample)" />

    <Demo Title="Showing and hiding a panel" Description="Render a panel and its handle inside an `if`. A panel that appears takes its `DefaultSize` out of the others, one that leaves gives its space back, and each handle keeps resizing the two panels it sits between, wherever in the group the panel is." Example="typeof(ResizableConditionalExample)" />

    <Demo Title="Nested" Description="A panel can hold another group. Here the right panel contains a vertical split, a common application layout." Example="typeof(ResizableNestedExample)" />

    <Demo Title="Collapsible" Description="A collapsible panel snaps shut when you drag it past its `MinSize`, and opens again when you drag it back out." Example="typeof(ResizableCollapsibleExample)" />

    <Demo Title="Tracking the layout" Description="Handle `OnLayout` to read the panel sizes as they change, for example to persist them or keep a preview in sync." Example="typeof(ResizableLayoutExample)" />

    <Demo Title="Customization" Description="The handle accepts `Class` and your own grip content without losing its drag and keyboard behavior. Here it rests as a hairline, thickens into an indigo bar on hover or drag, and `RevealOnHover` fades the custom grip in with it." Example="typeof(ResizableCustomExample)" />

    <Demo Title="Custom cursor" Description="The handle uses the OS resize arrows by default. `Cursor` and `DragCursor` take any CSS cursor value, and `BzCursor.From` turns a Blaizio icon into one with the OS arrows as the fallback." Example="typeof(ResizableCursorExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, the panel order and the drag direction flip to the opposite side." Example="typeof(ResizableRtlExample)" />

</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzResizablePanelGroup",
        new CompositionNode("BzResizablePanel"),
        new CompositionNode("BzResizableHandle"),
        new CompositionNode("BzResizablePanel"));
}
