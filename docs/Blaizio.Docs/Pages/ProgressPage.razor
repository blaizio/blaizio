@page "/docs/components/progress"
@using Blaizio.Docs.Examples.Progress
<PageTitle>Progress - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Progress</h1>
            <DocBadges Slug="progress" />
        </div>
        <p>Displays an indicator showing the completion progress of a task.</p>
    </header>

    <UsageBlock Example="typeof(ProgressUsageExample)"
                Description="Set Value (and optionally Max). Add an AriaLabel saying what is progressing - screen readers otherwise announce a bare percentage - or AriaLabelledBy pointing at a visible label." />

    <ExamplesHeading />

    <Demo Title="Default" Example="typeof(ProgressDefaultExample)" />

    <Demo Title="Values" Example="typeof(ProgressValuesExample)" />

    <Demo Title="Status colors" Description="Color repaints the fill with a status token - success / warning / info / destructive." Example="typeof(ProgressColorsExample)" />

    <Demo Title="Custom max" Description="Value is relative to Max - 7 of 10 here."
          Example="typeof(ProgressMaxExample)" />

    <Demo Title="Animated" Description="A realistic run: a PeriodicTimer drives staged progress with jittered increments and the occasional stall. The current stage reads on the left, the percentage on the right, and the fill transitions smoothly between values."
          Example="typeof(ProgressAnimatedExample)" />

    <Demo Title="Indeterminate" Description="Set Indeterminate for work of unknown length - the fill becomes an endless sweeping band (no Value needed) until you swap a real value back in."
          Example="typeof(ProgressIndeterminateExample)" />

    <Demo Title="Inline label" Description="ChildContent overlays the relative track - pin it with absolute inset-0 to put the value (or any copy) inside the bar."
          Example="typeof(ProgressLabelExample)" />

    <Demo Title="Vertical" Description="Orientation switches the axis - a vertical bar fills bottom-up (the indeterminate band sweeps top to bottom). Give the wrapper a height; the skin keeps the same thickness."
          Example="typeof(ProgressVerticalExample)" />

    <Demo Title="Circular" Description="BzCircularProgress draws the same progressbar semantics as a ring - size it with Class, tune the stroke with Thickness, and center a label in ChildContent."
          Example="typeof(ProgressCircularExample)" />

    <Demo Title="Circular indeterminate" Description="Set Indeterminate and a quarter arc spins endlessly - the circular counterpart of the sweeping band."
          Example="typeof(ProgressCircularIndeterminateExample)" />

    <Demo Title="Partial circle" Description="Sweep trims the ring to an arc with the gap centered on the bottom - 270 makes a dashboard gauge, 180 a half circle."
          Example="typeof(ProgressCircularArcExample)" />

    <Demo Title="Customization"
          Description="Set height and track color on the root; recolor the fill through the progress-indicator slot."
          Example="typeof(ProgressCustomExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider - the bar fills from the right and the value column leads on the right, where reading begins."
          Example="typeof(ProgressRtlExample)" />
</div>

