@page "/docs/components/progress"
@using Blaizio.Docs.Examples.Progress
<PageTitle>Progress - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Progress</h1>
            <DocBadges Slug="progress" />
        </div>
        <p>A progress bar, plus <code>BzCircularProgress</code> for a ring or gauge, both with progressbar semantics for assistive technology. Either one can switch to an indeterminate animation when the length of the work is unknown, and the bar also runs vertically.</p>
    </header>

    <UsageBlock Example="typeof(ProgressUsageExample)"
                Description="Set `Value`, and `Max` if the scale is not 100. Add an `AriaLabel` that says what is progressing, or point `AriaLabelledBy` at a visible label, because otherwise screen readers announce a bare percentage." />

    <ExamplesHeading />

    <Demo Title="Default" Example="typeof(ProgressDefaultExample)" />

    <Demo Title="Values" Example="typeof(ProgressValuesExample)" />

    <Demo Title="Status colors" Description="`Color` paints the fill with a status token: success, warning, info or destructive." Example="typeof(ProgressColorsExample)" />

    <Demo Title="Custom max" Description="`Value` is measured against `Max`, so this bar shows 7 of 10."
          Example="typeof(ProgressMaxExample)" />

    <Demo Title="Animated" Description="The fill transitions smoothly whenever `Value` changes. Here a `PeriodicTimer` drives staged progress with uneven steps and the occasional stall, with the current stage on the left and the percentage on the right."
          Example="typeof(ProgressAnimatedExample)" />

    <Demo Title="Indeterminate" Description="Set `Indeterminate` for work of unknown length. The fill becomes a band that sweeps across the track, with no `Value` needed, until you turn it off again."
          Example="typeof(ProgressIndeterminateExample)" />

    <Demo Title="Inline label" Description="`ChildContent` renders inside the track, which is positioned relative. Pin it with `absolute inset-0` to put the value or any other text inside the bar."
          Example="typeof(ProgressLabelExample)" />

    <Demo Title="Vertical" Description="Set `Orientation` to vertical and the bar fills from the bottom up, while the indeterminate band sweeps from top to bottom. Give the wrapper a height; the thickness stays the same."
          Example="typeof(ProgressVerticalExample)" />

    <Demo Title="Circular" Description="`BzCircularProgress` offers the same progressbar semantics as a ring. Size it with `Class`, set the stroke width with `Thickness`, and center a label in `ChildContent`."
          Example="typeof(ProgressCircularExample)" />

    <Demo Title="Circular indeterminate" Description="With `Indeterminate` set, a quarter arc spins around the ring until real progress is available."
          Example="typeof(ProgressCircularIndeterminateExample)" />

    <Demo Title="Partial circle" Description="`Sweep` trims the ring to an arc with the gap centered at the bottom. A value of 270 makes a dashboard gauge, and 180 makes a half circle."
          Example="typeof(ProgressCircularArcExample)" />

    <Demo Title="Customization"
          Description="Set the height and track color through `Class` on the root, and recolor the fill through the `progress-indicator` slot."
          Example="typeof(ProgressCustomExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, the bar fills from the right and the value sits on the right, where reading begins."
          Example="typeof(ProgressRtlExample)" />
</div>

