@page "/docs/components/alert-dialog"
@using Blaizio.Docs.Examples.AlertDialog
<PageTitle>Alert Dialog - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Alert Dialog</h1>
            <DocBadges Slug="alert-dialog" />
        </div>
        <p>A confirmation modal for decisions that need an explicit answer. Unlike a dialog, clicking the backdrop does nothing, so it closes only through Cancel, the action, or Escape.</p>
    </header>

    <UsageBlock Example="typeof(AlertDialogDefaultExample)"
                Description="After importing `Blaizio.Ui`, compose a trigger, content, header and footer. `BzAlertDialogCancel` dismisses the dialog, while `BzAlertDialogAction` runs your click handler and then closes it." />

    <CompositionTree Root="Anatomy"
                     Description="Every part of an alert dialog. The header holds the title and description, and the footer pairs a cancel button with the confirming action." />

    <ExamplesHeading />

    <Demo Title="Default" Example="typeof(AlertDialogDefaultExample)" />

    <Demo Title="Custom trigger element (RenderAs)"
          Description="If the trigger should be a link, a card or one of your own components, use `RenderAs` and apply the attributes it provides to that element. It then opens the alert dialog and carries the right ARIA state."
          Example="typeof(AlertDialogRenderAsTriggerExample)" />

    <Demo Title="Destructive action"
          Description="To confirm a delete, set `Variant` to `Destructive` on the action. Your handler runs first, then the dialog closes."
          Example="typeof(AlertDialogDestructiveExample)" />

    <Demo Title="Compact"
          Description='Set `Size` to `Sm` for a narrower surface. Its footer then splits the two buttons into equal columns.'
          Example="typeof(AlertDialogCompactExample)" />

    <Demo Title="Customization"
          Description="Every part accepts `Class`. This example gives the surface a custom radius, a tinted border and background, and an indigo title."
          Example="typeof(AlertDialogCustomExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, the text aligns to the right and the footer actions move to the left edge."
          Example="typeof(AlertDialogRtlExample)" />
</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzAlertDialog",
        new CompositionNode("BzAlertDialogTrigger"),
        new CompositionNode("BzAlertDialogContent",
            new CompositionNode("BzAlertDialogHeader",
                new CompositionNode("BzAlertDialogTitle"),
                new CompositionNode("BzAlertDialogDescription")),
            new CompositionNode("BzAlertDialogFooter",
                new CompositionNode("BzAlertDialogCancel"),
                new CompositionNode("BzAlertDialogAction"))));
}
