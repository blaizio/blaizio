@page "/docs/components/marker"
@using Blaizio.Docs.Examples.Marker
<PageTitle>Marker - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Marker</h1>
            <DocBadges Slug="marker" />
        </div>
        <p>A quiet inline row between conversation turns for status updates, system notes, tool activity and labeled separators. It sits alongside Bubble and Message in a thread, and an in-progress marker can announce itself to screen readers with <code>role="status"</code>.</p>
    </header>

    <UsageBlock Example="typeof(MarkerUsageExample)" />

    <CompositionTree Root="Anatomy"
                     Description="The icon is decorative and hidden from assistive technology, so the content carries the meaning." />

    <ExamplesHeading />

    <Demo Title="Status"
          Description="An in-progress marker with a `BzSpinner` in the icon slot and `role=&quot;status&quot;`, so screen readers announce the update. The pulse hints at text that is still streaming."
          Example="typeof(MarkerStatusExample)" />

    <Demo Title="Separator"
          Description="A centered label with a divider line on each side, for date breaks and section boundaries."
          Example="typeof(MarkerSeparatorExample)" />

    <Demo Title="Border"
          Description="A bottom border turns stacked markers into an activity list."
          Example="typeof(MarkerBorderExample)" />

    <Demo Title="Link (RenderAs)"
          Description="With `RenderAs` the whole row becomes an anchor that underlines and brightens on hover and shows the shared focus ring."
          Example="typeof(MarkerLinkExample)" />

    <Demo Title="Stacked"
          Description="Adding `flex-col` through `Class` stacks the icon over the label for a centered milestone."
          Example="typeof(MarkerStackedExample)" />

    <Demo Title="In a thread"
          Description="Here markers sit between bubbles, with a date separator above the conversation and a live status at its end."
          Example="typeof(MarkerThreadExample)" />

    <Demo Title="RTL"
          Description="Inside a right-to-left `DirectionProvider`, the icon, dividers and text swap to the opposite sides."
          Example="typeof(MarkerRtlExample)" />
</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzMarker",
        new CompositionNode("BzMarkerIcon"),
        new CompositionNode("BzMarkerContent"));
}
