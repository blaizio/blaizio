@page "/components/dropdown-menu"
<PageTitle>Dropdown Menu - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Dropdown Menu</h1>
        <p class="text-muted-foreground">A menu of actions or options triggered by a button, positioned with <a class="font-medium text-foreground underline underline-offset-4" href="https://floating-ui.com" target="_blank" rel="noopener">Floating UI</a>. Full keyboard support - arrow keys, Home/End, type-ahead, Enter/Space to activate, Escape to close - plus checkbox and radio items, labels, separators, and nested submenus. It is <strong>non-modal</strong>: the rest of the page stays interactive while it is open.</p>
    </header>

    <UsageBlock Setup="@UsageSetup" Code="@UsageMarkup"
                Description="Add the using once, then compose a trigger and content. Any element can be the trigger via RenderAs." />

    <CompositionTree Root="_anatomy"
                     Description="The full anatomy. Group items under labels, separate sections with a separator, and nest a BzDropdownMenuSub for submenus." />

    <ExamplesHeading />

    <Demo Title="Default" Description="An account menu: items with leading icons and trailing shortcuts, grouped under labels, a nested submenu, a disabled item, and a destructive action. Open it and navigate with the arrow keys or by typing." Code="@DefaultCode">
        <BzDropdownMenu>
            <BzDropdownMenuTrigger>
                <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Open</BzButton></RenderAs>
            </BzDropdownMenuTrigger>
            <BzDropdownMenuContent Class="w-56">
                <BzDropdownMenuLabel>My Account</BzDropdownMenuLabel>
                <BzDropdownMenuGroup>
                    <BzDropdownMenuItem>
                        <BzIcon Icon="@Icons.Outline.User" />
                        Profile
                        <BzDropdownMenuShortcut>⇧⌘P</BzDropdownMenuShortcut>
                    </BzDropdownMenuItem>
                    <BzDropdownMenuItem>
                        <BzIcon Icon="@Icons.Outline.CreditCard" />
                        Billing
                        <BzDropdownMenuShortcut>⌘B</BzDropdownMenuShortcut>
                    </BzDropdownMenuItem>
                    <BzDropdownMenuItem>
                        <BzIcon Icon="@Icons.Outline.Settings" />
                        Settings
                        <BzDropdownMenuShortcut>⌘S</BzDropdownMenuShortcut>
                    </BzDropdownMenuItem>
                    <BzDropdownMenuItem>
                        <BzIcon Icon="@Icons.Outline.Keyboard" />
                        Keyboard shortcuts
                        <BzDropdownMenuShortcut>⌘K</BzDropdownMenuShortcut>
                    </BzDropdownMenuItem>
                </BzDropdownMenuGroup>
                <BzDropdownMenuSeparator />
                <BzDropdownMenuGroup>
                    <BzDropdownMenuItem>
                        <BzIcon Icon="@Icons.Outline.Users" />
                        Team
                    </BzDropdownMenuItem>
                    <BzDropdownMenuSub>
                        <BzDropdownMenuSubTrigger>
                            <BzIcon Icon="@Icons.Outline.UserPlus" />
                            Invite users
                        </BzDropdownMenuSubTrigger>
                        <BzDropdownMenuSubContent>
                            <BzDropdownMenuItem>
                                <BzIcon Icon="@Icons.Outline.Mail" />
                                Email
                            </BzDropdownMenuItem>
                            <BzDropdownMenuItem>
                                <BzIcon Icon="@Icons.Outline.MessageCircle" />
                                Message
                            </BzDropdownMenuItem>
                            <BzDropdownMenuSeparator />
                            <BzDropdownMenuItem>
                                <BzIcon Icon="@Icons.Outline.Plus" />
                                More...
                            </BzDropdownMenuItem>
                        </BzDropdownMenuSubContent>
                    </BzDropdownMenuSub>
                    <BzDropdownMenuItem>
                        <BzIcon Icon="@Icons.Outline.Plus" />
                        New Team
                        <BzDropdownMenuShortcut>⌘+T</BzDropdownMenuShortcut>
                    </BzDropdownMenuItem>
                </BzDropdownMenuGroup>
                <BzDropdownMenuSeparator />
                <BzDropdownMenuItem>
                    <BzIcon Icon="@Icons.Outline.MessageCircle" />
                    Support
                </BzDropdownMenuItem>
                <BzDropdownMenuItem Disabled>
                    <BzIcon Icon="@Icons.Outline.Cloud" />
                    API
                </BzDropdownMenuItem>
                <BzDropdownMenuSeparator />
                <BzDropdownMenuItem Variant="DropdownMenuItemVariant.Destructive">
                    <BzIcon Icon="@Icons.Outline.Logout" />
                    Log out
                    <BzDropdownMenuShortcut>⇧⌘Q</BzDropdownMenuShortcut>
                </BzDropdownMenuItem>
            </BzDropdownMenuContent>
        </BzDropdownMenu>
    </Demo>

    <Demo Title="Item as a link (RenderAs)" Description="Render a menu item onto your own element - here an anchor - so it navigates like a real link." Code="@ItemAsLinkCode">
        <BzDropdownMenu>
            <BzDropdownMenuTrigger>
                <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Open</BzButton></RenderAs>
            </BzDropdownMenuTrigger>
            <BzDropdownMenuContent Class="w-56">
                <BzDropdownMenuLabel>My Account</BzDropdownMenuLabel>
                <BzDropdownMenuItem>
                    <RenderAs Context="p">
                        <a href="/account" @attributes="p.Attributes">
                            <BzIcon Icon="@Icons.Outline.User" />
                            Account
                        </a>
                    </RenderAs>
                </BzDropdownMenuItem>
                <BzDropdownMenuItem>
                    <RenderAs Context="p">
                        <a href="/settings" @attributes="p.Attributes">
                            <BzIcon Icon="@Icons.Outline.Settings" />
                            Settings
                        </a>
                    </RenderAs>
                </BzDropdownMenuItem>
                <BzDropdownMenuSeparator />
                <BzDropdownMenuItem>
                    <BzIcon Icon="@Icons.Outline.Logout" />
                    Log out
                </BzDropdownMenuItem>
            </BzDropdownMenuContent>
        </BzDropdownMenu>
    </Demo>

    <Demo Title="Account switcher" Description="Any element can be the trigger via RenderAs - here an avatar button opens an account menu, the way an app's user menu usually works." Code="@AvatarCode">
        <BzDropdownMenu>
            <BzDropdownMenuTrigger>
                <RenderAs Context="p">
                    <button @attributes="p.Attributes" class="rounded-full outline-none focus-visible:ring-ring/50 focus-visible:ring-3">
                        <BzAvatar>
                            <BzAvatarImage Src="https://i.pravatar.cc/120?img=12" Alt="User" />
                            <BzAvatarFallback>CN</BzAvatarFallback>
                        </BzAvatar>
                    </button>
                </RenderAs>
            </BzDropdownMenuTrigger>
            <BzDropdownMenuContent Class="w-56">
                <BzDropdownMenuLabel>
                    <div class="flex flex-col">
                        <span class="text-foreground text-sm font-medium">Jane Doe</span>
                        <span class="text-muted-foreground text-xs font-normal">Pro plan</span>
                    </div>
                </BzDropdownMenuLabel>
                <BzDropdownMenuGroup>
                    <BzDropdownMenuItem>
                        <BzIcon Icon="@Icons.Outline.User" />
                        Profile
                    </BzDropdownMenuItem>
                    <BzDropdownMenuItem>
                        <BzIcon Icon="@Icons.Outline.CreditCard" />
                        Billing
                    </BzDropdownMenuItem>
                    <BzDropdownMenuItem>
                        <BzIcon Icon="@Icons.Outline.Settings" />
                        Settings
                    </BzDropdownMenuItem>
                </BzDropdownMenuGroup>
                <BzDropdownMenuSeparator />
                <BzDropdownMenuItem Variant="DropdownMenuItemVariant.Destructive">
                    <BzIcon Icon="@Icons.Outline.Logout" />
                    Log out
                </BzDropdownMenuItem>
            </BzDropdownMenuContent>
        </BzDropdownMenu>
    </Demo>

    <Demo Title="Nested submenus" Description="Submenus nest as deep as you need - a submenu can hold its own submenu. The inline-end arrow opens each level and the inline-start arrow closes it; with the pointer, a short grace delay lets you cross the gap without the panel snapping shut." Code="@NestedCode">
        <BzDropdownMenu>
            <BzDropdownMenuTrigger>
                <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Share</BzButton></RenderAs>
            </BzDropdownMenuTrigger>
            <BzDropdownMenuContent Class="w-52">
                <BzDropdownMenuItem>
                    <BzIcon Icon="@Icons.Outline.Link" />
                    Copy link
                </BzDropdownMenuItem>
                <BzDropdownMenuSub>
                    <BzDropdownMenuSubTrigger>
                        <BzIcon Icon="@Icons.Outline.UserPlus" />
                        Invite people
                    </BzDropdownMenuSubTrigger>
                    <BzDropdownMenuSubContent>
                        <BzDropdownMenuItem>
                            <BzIcon Icon="@Icons.Outline.Mail" />
                            Email
                        </BzDropdownMenuItem>
                        <BzDropdownMenuSub>
                            <BzDropdownMenuSubTrigger>
                                <BzIcon Icon="@Icons.Outline.MessageCircle" />
                                Send to device
                            </BzDropdownMenuSubTrigger>
                            <BzDropdownMenuSubContent>
                                <BzDropdownMenuItem>Phone</BzDropdownMenuItem>
                                <BzDropdownMenuItem>Tablet</BzDropdownMenuItem>
                                <BzDropdownMenuItem>Laptop</BzDropdownMenuItem>
                            </BzDropdownMenuSubContent>
                        </BzDropdownMenuSub>
                    </BzDropdownMenuSubContent>
                </BzDropdownMenuSub>
            </BzDropdownMenuContent>
        </BzDropdownMenu>
    </Demo>

    <Demo Title="Long menu" Description="A menu taller than the room below its trigger caps its height to what's on screen and scrolls (a thin scrollbar) rather than running off the viewport. Arrow keys, Home/End, and type-ahead still reach every item, scrolling it into view." Code="@LongCode">
        <BzDropdownMenu>
            <BzDropdownMenuTrigger>
                <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Set timezone</BzButton></RenderAs>
            </BzDropdownMenuTrigger>
            <BzDropdownMenuContent Class="w-56">
                <BzDropdownMenuLabel>Timezone</BzDropdownMenuLabel>
                @foreach (var zone in _zones)
                {
                    <BzDropdownMenuItem>@zone</BzDropdownMenuItem>
                }
            </BzDropdownMenuContent>
        </BzDropdownMenu>
    </Demo>

    <Demo Title="Checkbox items" Description="Toggle several options without the menu closing - each item's OnSelect calls PreventDefault to keep it open. The checked state is two-way bound." Code="@CheckboxCode">
        <BzDropdownMenu>
            <BzDropdownMenuTrigger>
                <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Appearance</BzButton></RenderAs>
            </BzDropdownMenuTrigger>
            <BzDropdownMenuContent Class="w-56">
                <BzDropdownMenuLabel>Appearance</BzDropdownMenuLabel>
                <BzDropdownMenuCheckboxItem @bind-Checked="_statusBar" OnSelect="KeepOpen">Status Bar</BzDropdownMenuCheckboxItem>
                <BzDropdownMenuCheckboxItem @bind-Checked="_activityBar" OnSelect="KeepOpen" Disabled>Activity Bar</BzDropdownMenuCheckboxItem>
                <BzDropdownMenuCheckboxItem @bind-Checked="_panel" OnSelect="KeepOpen">Panel</BzDropdownMenuCheckboxItem>
            </BzDropdownMenuContent>
        </BzDropdownMenu>
    </Demo>

    <Demo Title="Checkbox items with icons" Description="Each item leads with an icon on the inline-start; the check sits at the inline-end. Toggling keeps the menu open (PreventDefault)." Code="@CheckboxIconsCode">
        <BzDropdownMenu>
            <BzDropdownMenuTrigger>
                <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Notifications</BzButton></RenderAs>
            </BzDropdownMenuTrigger>
            <BzDropdownMenuContent Class="w-56">
                <BzDropdownMenuLabel>Notification preferences</BzDropdownMenuLabel>
                <BzDropdownMenuCheckboxItem @bind-Checked="_emailNotif" OnSelect="KeepOpen">
                    <BzIcon Icon="@Icons.Outline.Mail" />
                    Email notifications
                </BzDropdownMenuCheckboxItem>
                <BzDropdownMenuCheckboxItem @bind-Checked="_smsNotif" OnSelect="KeepOpen">
                    <BzIcon Icon="@Icons.Outline.MessageCircle" />
                    SMS notifications
                </BzDropdownMenuCheckboxItem>
                <BzDropdownMenuCheckboxItem @bind-Checked="_pushNotif" OnSelect="KeepOpen">
                    <BzIcon Icon="@Icons.Outline.Bell" />
                    Push notifications
                </BzDropdownMenuCheckboxItem>
            </BzDropdownMenuContent>
        </BzDropdownMenu>
    </Demo>

    <Demo Title="Radio group" Description="A single-select set of options. Picking one updates the bound value and closes the menu; reopen it to see the check on the current choice." Code="@RadioCode">
        <div class="flex flex-col items-center gap-4">
            <span class="text-muted-foreground text-sm">Position: @_position</span>
            <BzDropdownMenu>
                <BzDropdownMenuTrigger>
                    <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Panel position</BzButton></RenderAs>
                </BzDropdownMenuTrigger>
                <BzDropdownMenuContent Class="w-56">
                    <BzDropdownMenuLabel>Panel position</BzDropdownMenuLabel>
                    <BzDropdownMenuRadioGroup @bind-Value="_position">
                        <BzDropdownMenuRadioItem Value="top">Top</BzDropdownMenuRadioItem>
                        <BzDropdownMenuRadioItem Value="bottom">Bottom</BzDropdownMenuRadioItem>
                        <BzDropdownMenuRadioItem Value="right">Right</BzDropdownMenuRadioItem>
                    </BzDropdownMenuRadioGroup>
                </BzDropdownMenuContent>
            </BzDropdownMenu>
        </div>
    </Demo>

    <Demo Title="Radio items with icons" Description="A single-select set where each option leads with an icon; the check marks the current choice at the inline-end." Code="@RadioIconsCode">
        <div class="flex flex-col items-center gap-4">
            <span class="text-muted-foreground text-sm">Method: @_payment</span>
            <BzDropdownMenu>
                <BzDropdownMenuTrigger>
                    <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Payment method</BzButton></RenderAs>
                </BzDropdownMenuTrigger>
                <BzDropdownMenuContent Class="w-56">
                    <BzDropdownMenuLabel>Select payment method</BzDropdownMenuLabel>
                    <BzDropdownMenuRadioGroup @bind-Value="_payment">
                        <BzDropdownMenuRadioItem Value="card">
                            <BzIcon Icon="@Icons.Outline.CreditCard" />
                            Credit Card
                        </BzDropdownMenuRadioItem>
                        <BzDropdownMenuRadioItem Value="paypal">
                            <BzIcon Icon="@Icons.Outline.Wallet" />
                            PayPal
                        </BzDropdownMenuRadioItem>
                        <BzDropdownMenuRadioItem Value="bank">
                            <BzIcon Icon="@Icons.Outline.BuildingBank" />
                            Bank Transfer
                        </BzDropdownMenuRadioItem>
                    </BzDropdownMenuRadioGroup>
                </BzDropdownMenuContent>
            </BzDropdownMenu>
        </div>
    </Demo>

    <Demo Title="Controlled" Description="Drive the open state yourself with two-way binding. A separate button opens the menu (it disables while the menu is open), and the live state stays in sync however you dismiss it - pick an item, press Escape, or click outside." Code="@ControlledCode">
        <div class="flex flex-col items-center gap-4">
            <span class="text-muted-foreground text-sm">Open: @_open</span>
            <div class="flex items-center gap-4">
                <BzDropdownMenu @bind-Open="_open">
                    <BzDropdownMenuTrigger>
                        <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Menu</BzButton></RenderAs>
                    </BzDropdownMenuTrigger>
                    <BzDropdownMenuContent Class="w-56">
                        <BzDropdownMenuLabel>Actions</BzDropdownMenuLabel>
                        <BzDropdownMenuItem>Cut</BzDropdownMenuItem>
                        <BzDropdownMenuItem>Copy</BzDropdownMenuItem>
                        <BzDropdownMenuItem>Paste</BzDropdownMenuItem>
                    </BzDropdownMenuContent>
                </BzDropdownMenu>
                <BzButton Variant="ButtonVariant.Secondary" Disabled="_open" @onclick="() => _open = true">Open menu</BzButton>
            </div>
        </div>
    </Demo>

    <Demo Title="Looping" Description="Inside an open menu the arrow keys wrap from the last item back to the first by default. Set Loop to false on the content to stop at the ends instead - ArrowDown then rests on the last item and ArrowUp on the first. Open it and hold an arrow key to compare with the menus above." Code="@LoopCode">
        <BzDropdownMenu>
            <BzDropdownMenuTrigger>
                <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Open</BzButton></RenderAs>
            </BzDropdownMenuTrigger>
            <BzDropdownMenuContent Class="w-44" Loop="false">
                <BzDropdownMenuItem>Cut</BzDropdownMenuItem>
                <BzDropdownMenuItem>Copy</BzDropdownMenuItem>
                <BzDropdownMenuItem>Paste</BzDropdownMenuItem>
                <BzDropdownMenuItem>Delete</BzDropdownMenuItem>
            </BzDropdownMenuContent>
        </BzDropdownMenu>
    </Demo>

    <Demo Title="Customization"
          Description="Restyle any part via Class - a brand-colored trigger and a content panel with a custom width, radius, and tint. Utilities win over the skin, so these take effect."
          Code="@CustomCode">
        <BzDropdownMenu>
            <BzDropdownMenuTrigger>
                <RenderAs Context="p"><BzButton Class="bg-indigo-600 text-white hover:bg-indigo-700" @attributes="p.Attributes">Options</BzButton></RenderAs>
            </BzDropdownMenuTrigger>
            <BzDropdownMenuContent Class="w-56 rounded-xl border-indigo-200 bg-indigo-50/60 dark:border-indigo-900 dark:bg-indigo-950/50">
                <BzDropdownMenuLabel>Workspace</BzDropdownMenuLabel>
                <BzDropdownMenuItem>
                    <BzIcon Icon="@Icons.Outline.User" />
                    Profile
                </BzDropdownMenuItem>
                <BzDropdownMenuItem>
                    <BzIcon Icon="@Icons.Outline.Settings" />
                    Settings
                </BzDropdownMenuItem>
                <BzDropdownMenuItem>
                    <BzIcon Icon="@Icons.Outline.CreditCard" />
                    Billing
                </BzDropdownMenuItem>
            </BzDropdownMenuContent>
        </BzDropdownMenu>
    </Demo>
    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the menu anchors and aligns mirrored, shortcuts sit on the left, and the submenu opens to the left with its chevron flipped." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzDropdownMenu>
                <BzDropdownMenuTrigger>
                    <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">القائمة</BzButton></RenderAs>
                </BzDropdownMenuTrigger>
                <BzDropdownMenuContent Class="w-56">
                    <BzDropdownMenuLabel>حسابي</BzDropdownMenuLabel>
                    <BzDropdownMenuItem>
                        <BzIcon Icon="@Icons.Outline.User" />
                        الملف الشخصي
                        <BzDropdownMenuShortcut>⇧⌘P</BzDropdownMenuShortcut>
                    </BzDropdownMenuItem>
                    <BzDropdownMenuItem>
                        <BzIcon Icon="@Icons.Outline.Settings" />
                        الإعدادات
                    </BzDropdownMenuItem>
                    <BzDropdownMenuSub>
                        <BzDropdownMenuSubTrigger>
                            <BzIcon Icon="@Icons.Outline.UserPlus" />
                            دعوة المستخدمين
                        </BzDropdownMenuSubTrigger>
                        <BzDropdownMenuSubContent>
                            <BzDropdownMenuItem>
                                <BzIcon Icon="@Icons.Outline.Mail" />
                                بريد إلكتروني
                            </BzDropdownMenuItem>
                            <BzDropdownMenuItem>
                                <BzIcon Icon="@Icons.Outline.MessageCircle" />
                                رسالة
                            </BzDropdownMenuItem>
                        </BzDropdownMenuSubContent>
                    </BzDropdownMenuSub>
                    <BzDropdownMenuSeparator />
                    <BzDropdownMenuItem Variant="DropdownMenuItemVariant.Destructive">
                        <BzIcon Icon="@Icons.Outline.Logout" />
                        تسجيل الخروج
                    </BzDropdownMenuItem>
                </BzDropdownMenuContent>
            </BzDropdownMenu>
        </BzDirectionProvider>
    </Demo>

</div>

@code {
    private bool _statusBar = true;
    private bool _activityBar;
    private bool _panel;
    private string _position = "bottom";
    private bool _open;
    private bool _emailNotif = true;
    private bool _smsNotif;
    private bool _pushNotif = true;
    private string _payment = "card";

    // A deliberately long list so the menu outgrows the viewport and scrolls (see the "Long menu" demo).
    private static readonly string[] _zones =
    [
        "Honolulu", "Anchorage", "Los Angeles", "Denver", "Chicago", "New York", "Toronto",
        "São Paulo", "London", "Lisbon", "Madrid", "Paris", "Berlin", "Rome", "Athens", "Cairo",
        "Istanbul", "Nairobi", "Moscow", "Dubai", "Karachi", "Mumbai", "Dhaka", "Bangkok",
        "Singapore", "Hong Kong", "Shanghai", "Tokyo", "Seoul", "Sydney", "Auckland",
    ];

    // Selecting a checkbox item closes the menu by default; PreventDefault keeps it open so several
    // can be toggled in one visit.
    private static void KeepOpen(MenuSelectEventArgs e) => e.PreventDefault();

    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode _anatomy = new CompositionNode("BzDropdownMenu",
        new CompositionNode("BzDropdownMenuTrigger"),
        new CompositionNode("BzDropdownMenuContent",
            new CompositionNode("BzDropdownMenuGroup",
                new CompositionNode("BzDropdownMenuLabel"),
                new CompositionNode("BzDropdownMenuItem",
                    new CompositionNode("BzDropdownMenuShortcut")),
                new CompositionNode("BzDropdownMenuCheckboxItem"),
                new CompositionNode("BzDropdownMenuRadioGroup",
                    new CompositionNode("BzDropdownMenuRadioItem"))),
            new CompositionNode("BzDropdownMenuSeparator"),
            new CompositionNode("BzDropdownMenuSub",
                new CompositionNode("BzDropdownMenuSubTrigger"),
                new CompositionNode("BzDropdownMenuSubContent"))));

    private const string UsageSetup = """
        @* _Imports.razor (or the top of the page) *@
        @using Blaizio.Ui
        """;

    private const string UsageMarkup = """
        <BzDropdownMenu>
            <BzDropdownMenuTrigger>
                <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Open</BzButton></RenderAs>
            </BzDropdownMenuTrigger>
            <BzDropdownMenuContent>
                <BzDropdownMenuGroup>
                    <BzDropdownMenuLabel>My Account</BzDropdownMenuLabel>
                    <BzDropdownMenuItem>Profile</BzDropdownMenuItem>
                    <BzDropdownMenuItem>Billing</BzDropdownMenuItem>
                </BzDropdownMenuGroup>
                <BzDropdownMenuSeparator />
                <BzDropdownMenuGroup>
                    <BzDropdownMenuItem>Team</BzDropdownMenuItem>
                    <BzDropdownMenuItem>Subscription</BzDropdownMenuItem>
                </BzDropdownMenuGroup>
            </BzDropdownMenuContent>
        </BzDropdownMenu>
        """;

    private const string CustomCode = """
        <BzDropdownMenu>
            <BzDropdownMenuTrigger>
                <RenderAs Context="p"><BzButton Class="bg-indigo-600 text-white hover:bg-indigo-700" @attributes="p.Attributes">Options</BzButton></RenderAs>
            </BzDropdownMenuTrigger>
            <BzDropdownMenuContent Class="w-56 rounded-xl border-indigo-200 bg-indigo-50/60 dark:border-indigo-900 dark:bg-indigo-950/50">
                <BzDropdownMenuLabel>Workspace</BzDropdownMenuLabel>
                <BzDropdownMenuItem><BzIcon Icon="@Icons.Outline.User" /> Profile</BzDropdownMenuItem>
                <BzDropdownMenuItem><BzIcon Icon="@Icons.Outline.Settings" /> Settings</BzDropdownMenuItem>
                <BzDropdownMenuItem><BzIcon Icon="@Icons.Outline.CreditCard" /> Billing</BzDropdownMenuItem>
            </BzDropdownMenuContent>
        </BzDropdownMenu>
        """;

    private const string AvatarCode = """
        <BzDropdownMenu>
            <BzDropdownMenuTrigger>
                <RenderAs Context="p">
                    <button @attributes="p.Attributes" class="rounded-full outline-none focus-visible:ring-ring/50 focus-visible:ring-3">
                        <BzAvatar>
                            <BzAvatarImage Src="https://i.pravatar.cc/120?img=12" Alt="User" />
                            <BzAvatarFallback>CN</BzAvatarFallback>
                        </BzAvatar>
                    </button>
                </RenderAs>
            </BzDropdownMenuTrigger>
            <BzDropdownMenuContent Class="w-56">
                <BzDropdownMenuLabel>
                    <div class="flex flex-col">
                        <span class="text-foreground text-sm font-medium">Jane Doe</span>
                        <span class="text-muted-foreground text-xs font-normal">Pro plan</span>
                    </div>
                </BzDropdownMenuLabel>
                <BzDropdownMenuGroup>
                    <BzDropdownMenuItem><BzIcon Icon="@Icons.Outline.User" /> Profile</BzDropdownMenuItem>
                    <BzDropdownMenuItem><BzIcon Icon="@Icons.Outline.CreditCard" /> Billing</BzDropdownMenuItem>
                    <BzDropdownMenuItem><BzIcon Icon="@Icons.Outline.Settings" /> Settings</BzDropdownMenuItem>
                </BzDropdownMenuGroup>
                <BzDropdownMenuSeparator />
                <BzDropdownMenuItem Variant="DropdownMenuItemVariant.Destructive">
                    <BzIcon Icon="@Icons.Outline.Logout" /> Log out
                </BzDropdownMenuItem>
            </BzDropdownMenuContent>
        </BzDropdownMenu>
        """;

    private const string ControlledCode = """
        <BzDropdownMenu @bind-Open="_open">
            <BzDropdownMenuTrigger>
                <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Menu</BzButton></RenderAs>
            </BzDropdownMenuTrigger>
            <BzDropdownMenuContent Class="w-56">
                <BzDropdownMenuLabel>Actions</BzDropdownMenuLabel>
                <BzDropdownMenuItem>Cut</BzDropdownMenuItem>
                <BzDropdownMenuItem>Copy</BzDropdownMenuItem>
                <BzDropdownMenuItem>Paste</BzDropdownMenuItem>
