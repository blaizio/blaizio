@page "/docs/components/dropdown-menu"
@using Blaizio.Docs.Examples.DropdownMenu
<PageTitle>Dropdown Menu - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Dropdown Menu</h1>
            <DocBadges Slug="dropdown-menu" />
        </div>
        <p>A menu of actions or options opened from a trigger and positioned with <a class="font-medium text-foreground" href="https://floating-ui.com" target="_blank" rel="noopener">Floating UI</a>. Keyboard support covers arrow keys, Home and End, type-ahead, Enter or Space to activate and Escape to close, and checkbox items, radio groups and nested submenus are built in. The menu is <strong>non-modal</strong>, which means the rest of the page stays interactive while it is open.</p>
    </header>

    <UsageBlock Example="typeof(DropdownMenuUsageExample)"
                Description="After importing `Blaizio.Ui`, add a trigger and the content. With `RenderAs`, any element can act as the trigger." />

    <CompositionTree Root="Anatomy"
                     Description="Every part of a dropdown menu. Group items under labels, divide sections with a separator, and nest a `BzDropdownMenuSub` for each submenu." />

    <ExamplesHeading />

    <Demo Title="Default" Description="An account menu with icons, shortcuts, labeled groups, a submenu, a disabled item and a destructive action. Open it and move through it with the arrow keys or by typing the start of an item's name."
          Example="typeof(DropdownMenuDefaultExample)" />

    <Demo Title="Item as a link (RenderAs)" Description="Use `RenderAs` to render a menu item as your own element. Here it is an anchor, so the item navigates like a real link."
          Example="typeof(DropdownMenuItemAsLinkExample)" />

    <Demo Title="Account switcher" Description="Through `RenderAs`, an avatar button becomes the trigger, which is the usual shape of an app's user menu."
          Example="typeof(DropdownMenuAvatarExample)" />

    <Demo Title="Nested submenus" Description="Submenus can nest as deep as you need. The inline-end arrow key opens each level and the inline-start arrow key closes it, while a short grace delay lets the pointer cross the gap without the panel closing."
          Example="typeof(DropdownMenuNestedExample)" />

    <Demo Title="Long menu" Description="When a menu is taller than the space below its trigger, it caps its height to the viewport and scrolls. Arrow keys, Home, End and type-ahead still reach every item and scroll it into view."
          Example="typeof(DropdownMenuLongExample)" />

    <Demo Title="Checkbox items" Description="To keep the menu open while toggling several options, call `PreventDefault` in each item's `OnSelect`. The checked state is two-way bound."
          Example="typeof(DropdownMenuCheckboxExample)" />

    <Demo Title="Checkbox items with icons" Description="An icon can lead each checkbox item at the inline start, and the check then moves to the inline end. These items also call `PreventDefault` to stay open on toggle."
          Example="typeof(DropdownMenuCheckboxIconsExample)" />

    <Demo Title="Radio group" Description="A radio group picks one option from a set. Choosing an option updates the bound value and closes the menu, and the check marks the current choice when you reopen it."
          Example="typeof(DropdownMenuRadioExample)" />

    <Demo Title="Radio items with icons" Description="Radio items can lead with an icon too. The check marking the current choice then sits at the inline end."
          Example="typeof(DropdownMenuRadioIconsExample)" />

    <Demo Title="Controlled" Description="Bind the open state when other code needs to open the menu, like the separate button here, which is disabled while the menu is open. The bound value stays in sync however the menu closes: by choosing an item, pressing Escape or clicking outside."
          Example="typeof(DropdownMenuControlledExample)" />

    <Demo Title="Focus on dismissal"
          Description="Closing the menu returns focus to the trigger, but after an outside click only when nothing else took focus. If the trigger sits inside something that reacts to focus arriving, such as an editor that activates on focus, set `RestoreFocusOnPointerDismiss` to `false` on the content. Escape and item selection still return focus to the trigger for keyboard users."
          Example="typeof(DropdownMenuDismissFocusExample)" />

    <Demo Title="Looping" Description="By default the arrow keys wrap from the last item back to the first. Set `Loop` to `false` on the content to stop at the ends instead, then hold an arrow key to compare it with the menus above."
          Example="typeof(DropdownMenuLoopExample)" />

    <Demo Title="Customization"
          Description="Every part accepts `Class`. This example gives the trigger a brand color and the content panel a custom width, radius and tint."
          Example="typeof(DropdownMenuCustomExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, the menu aligns to the mirrored edge of its trigger, shortcuts sit on the left, and submenus open to the left with a flipped chevron."
          Example="typeof(DropdownMenuRtlExample)" />

</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzDropdownMenu",
        new CompositionNode("BzDropdownMenuTrigger"),
        new CompositionNode("BzDropdownMenuContent",
            new CompositionNode("BzDropdownMenuGroup",
                new CompositionNode("BzDropdownMenuLabel"),
                new CompositionNode("BzDropdownMenuItem",
                    new CompositionNode("BzDropdownMenuShortcut")),
                new CompositionNode("BzDropdownMenuCheckboxItem"),
                new CompositionNode("BzDropdownMenuRadioGroup",
                    new CompositionNode("BzDropdownMenuRadioItem"))),
            new CompositionNode("BzDropdownMenuSeparator"),
            new CompositionNode("BzDropdownMenuSub",
                new CompositionNode("BzDropdownMenuSubTrigger"),
                new CompositionNode("BzDropdownMenuSubContent"))));
}
