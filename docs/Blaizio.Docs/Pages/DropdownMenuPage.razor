@page "/docs/components/dropdown-menu"
@using Blaizio.Docs.Examples.DropdownMenu
<PageTitle>Dropdown Menu - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Dropdown Menu</h1>
            <DocBadges Slug="dropdown-menu" />
        </div>
        <p class="text-muted-foreground">A menu of actions or options triggered by a button, positioned with <a class="font-medium text-foreground underline underline-offset-4" href="https://floating-ui.com" target="_blank" rel="noopener">Floating UI</a>. Full keyboard support - arrow keys, Home/End, type-ahead, Enter/Space to activate, Escape to close - plus checkbox and radio items, labels, separators, and nested submenus. It is <strong>non-modal</strong>: the rest of the page stays interactive while it is open.</p>
    </header>

    <UsageBlock Example="typeof(DropdownMenuUsageExample)"
                Description="Add the using once, then compose a trigger and content. Any element can be the trigger via RenderAs." />

    <CompositionTree Root="Anatomy"
                     Description="The full anatomy. Group items under labels, separate sections with a separator, and nest a BzDropdownMenuSub for submenus." />

    <ExamplesHeading />

    <Demo Title="Default" Description="An account menu: items with leading icons and trailing shortcuts, grouped under labels, a nested submenu, a disabled item, and a destructive action. Open it and navigate with the arrow keys or by typing."
          Example="typeof(DropdownMenuDefaultExample)" />

    <Demo Title="Item as a link (RenderAs)" Description="Render a menu item onto your own element - here an anchor - so it navigates like a real link."
          Example="typeof(DropdownMenuItemAsLinkExample)" />

    <Demo Title="Account switcher" Description="Any element can be the trigger via RenderAs - here an avatar button opens an account menu, the way an app's user menu usually works."
          Example="typeof(DropdownMenuAvatarExample)" />

    <Demo Title="Nested submenus" Description="Submenus nest as deep as you need - a submenu can hold its own submenu. The inline-end arrow opens each level and the inline-start arrow closes it; with the pointer, a short grace delay lets you cross the gap without the panel snapping shut."
          Example="typeof(DropdownMenuNestedExample)" />

    <Demo Title="Long menu" Description="A menu taller than the room below its trigger caps its height to what's on screen and scrolls (a thin scrollbar) rather than running off the viewport. Arrow keys, Home/End, and type-ahead still reach every item, scrolling it into view."
          Example="typeof(DropdownMenuLongExample)" />

    <Demo Title="Checkbox items" Description="Toggle several options without the menu closing - each item's OnSelect calls PreventDefault to keep it open. The checked state is two-way bound."
          Example="typeof(DropdownMenuCheckboxExample)" />

    <Demo Title="Checkbox items with icons" Description="Each item leads with an icon on the inline-start; the check sits at the inline-end. Toggling keeps the menu open (PreventDefault)."
          Example="typeof(DropdownMenuCheckboxIconsExample)" />

    <Demo Title="Radio group" Description="A single-select set of options. Picking one updates the bound value and closes the menu; reopen it to see the check on the current choice."
          Example="typeof(DropdownMenuRadioExample)" />

    <Demo Title="Radio items with icons" Description="A single-select set where each option leads with an icon; the check marks the current choice at the inline-end."
          Example="typeof(DropdownMenuRadioIconsExample)" />

    <Demo Title="Controlled" Description="Drive the open state yourself with two-way binding. A separate button opens the menu (it disables while the menu is open), and the live state stays in sync however you dismiss it - pick an item, press Escape, or click outside."
          Example="typeof(DropdownMenuControlledExample)" />

    <Demo Title="Looping" Description="Inside an open menu the arrow keys wrap from the last item back to the first by default. Set Loop to false on the content to stop at the ends instead - ArrowDown then rests on the last item and ArrowUp on the first. Open it and hold an arrow key to compare with the menus above."
          Example="typeof(DropdownMenuLoopExample)" />

    <Demo Title="Customization"
          Description="Restyle any part via Class - a brand-colored trigger and a content panel with a custom width, radius, and tint. Utilities win over the skin, so these take effect."
          Example="typeof(DropdownMenuCustomExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic or Hebrew copy - the menu anchors and aligns mirrored, shortcuts sit on the left, and the submenu opens to the left with its chevron flipped."
          Example="typeof(DropdownMenuRtlExample)" />

</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzDropdownMenu",
        new CompositionNode("BzDropdownMenuTrigger"),
        new CompositionNode("BzDropdownMenuContent",
            new CompositionNode("BzDropdownMenuGroup",
                new CompositionNode("BzDropdownMenuLabel"),
                new CompositionNode("BzDropdownMenuItem",
                    new CompositionNode("BzDropdownMenuShortcut")),
                new CompositionNode("BzDropdownMenuCheckboxItem"),
                new CompositionNode("BzDropdownMenuRadioGroup",
                    new CompositionNode("BzDropdownMenuRadioItem"))),
            new CompositionNode("BzDropdownMenuSeparator"),
            new CompositionNode("BzDropdownMenuSub",
                new CompositionNode("BzDropdownMenuSubTrigger"),
                new CompositionNode("BzDropdownMenuSubContent"))));
}
