@page "/docs/components"
<PageTitle>Components - Blaizio</PageTitle>

@*
    The components index: every documented component as a BzCard link, straight from
    DocsNav.Components so the grid and the sidebar can never drift, with a live search filter and
    category chips. Built from the same copied Ui layer it advertises - the page is its own demo.
*@
<div class="docs-page-header space-y-2">
    <h1 class="font-heading text-3xl font-bold tracking-tight">Components</h1>
    <p class="text-muted-foreground">
        Accessible, styled building blocks - copied into your project by the CLI, yours to edit.
        @DocsNav.Components.Length components and counting.
    </p>
</div>

<div class="mt-6 space-y-3">
    <div class="max-w-sm">
        <BzInputGroup>
            <BzInputGroupInput Placeholder="Search components..." @bind-Value="_query" aria-label="Search components" />
            <BzInputGroupAddon>
                <BzIcon Icon="@Tabler.Outline.Search" />
            </BzInputGroupAddon>
        </BzInputGroup>
    </div>
    @* Category chips: one click narrows the grid; clicking the active chip clears it again. *@
    <div class="flex flex-wrap gap-1.5">
        <BzBadge Variant="@(_category is null ? BadgeVariant.Default : BadgeVariant.Outline)"
                 Class="cursor-pointer transition-colors hover:border-primary/50">
            <RenderAs Context="p">
                <button type="button" @attributes="p.Attributes" @onclick="() => _category = null">All (@DocsNav.Components.Length)</button>
            </RenderAs>
        </BzBadge>
        @foreach (var (category, count) in Categories)
        {
            var current = category;
            <BzBadge Variant="@(_category == current ? BadgeVariant.Default : BadgeVariant.Outline)"
                     Class="cursor-pointer transition-colors hover:border-primary/50">
                <RenderAs Context="p">
                    <button type="button" @attributes="p.Attributes" @onclick="() => _category = _category == current ? null : current">@category (@count)</button>
                </RenderAs>
            </BzBadge>
        }
    </div>
</div>

@if (!Filtered.Any())
{
    <BzAlert Class="mt-8">
        <BzIcon Icon="@Tabler.Outline.Search" />
        <BzAlertTitle>No matches</BzAlertTitle>
        <BzAlertDescription>No component matches the current search and category.</BzAlertDescription>
    </BzAlert>
}
else
{
    <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        @foreach (var c in Filtered)
        {
            <a href="@c.DocHref" class="group no-underline">
                <BzCard Class="h-full gap-1 py-5 transition-colors group-hover:border-primary/50">
                    <BzCardHeader Class="px-5">
                        <BzCardTitle Class="flex items-center justify-between gap-2 transition-colors group-hover:text-primary">
                            @c.Label
                            <BzBadge Variant="BadgeVariant.Outline" Class="shrink-0 font-normal text-muted-foreground">@c.Category</BzBadge>
                        </BzCardTitle>
                        <BzCardDescription>@c.Blurb</BzCardDescription>
                    </BzCardHeader>
                </BzCard>
            </a>
        }
    </div>
}

@code {
    private string? _query;
    private string? _category;

    /// <summary>Distinct categories in registry order, with their component counts.</summary>
    private static readonly (string Category, int Count)[] Categories =
    [
        .. DocsNav.Components
            .GroupBy(c => c.Category)
            .Select(g => (g.Key, g.Count())),
    ];

    private IEnumerable<DocEntry> Filtered => DocsNav.Components
        .Where(c => _category is null || c.Category == _category)
        .Where(c => string.IsNullOrWhiteSpace(_query)
            || c.Label.Contains(_query, StringComparison.OrdinalIgnoreCase)
            || c.Blurb.Contains(_query, StringComparison.OrdinalIgnoreCase));
}
