@page "/docs/components/alert"
@using Blaizio.Docs.Examples.Alert
<PageTitle>Alert - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Alert</h1>
            <DocBadges Slug="alert" />
        </div>
        <p>A static callout for messages that belong in the page flow rather than a toast. Put an icon first and the alert aligns it beside the title and description, with no extra markup.</p>
    </header>

    <UsageBlock Example="typeof(AlertDefaultExample)"
                Description="After importing `Blaizio.Ui`, place an optional leading icon, a title and a description inside the alert." />

    <CompositionTree Root="Anatomy"
                     Description="Every part of an alert. The leading icon, the description and the top-right `BzAlertAction` are all optional." />

    <ExamplesHeading />

    <Demo Title="Default" Example="typeof(AlertDefaultExample)" />

    <Demo Title="Title only" Description="Leave out `BzAlertDescription` for a one-line alert." Example="typeof(AlertTitleOnlyExample)" />

    <Demo Title="Without icon" Example="typeof(AlertNoIconExample)" />

    <Demo Title="Destructive" Example="typeof(AlertDestructiveExample)" />

    <Demo Title="Success, warning & info" Description="`Success`, `Warning` and `Info` use the same soft treatment as `Destructive`, each drawn from its own status color token." Example="typeof(AlertStatusExample)" />

    <Demo Title="Customization"
          Description="Classes passed through `Class` are merged over the variant defaults. This example recolors the whole callout in emerald and enlarges the radius."
          Example="typeof(AlertCustomExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, the icon moves to the right edge and the text and padding mirror with it."
          Example="typeof(AlertRtlExample)" />
</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzAlert",
        new CompositionNode("BzIcon"),
        new CompositionNode("BzAlertTitle"),
        new CompositionNode("BzAlertDescription"),
        new CompositionNode("BzAlertAction"));
}
