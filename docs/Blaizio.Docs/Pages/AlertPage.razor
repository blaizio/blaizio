@page "/docs/components/alert"
@using Blaizio.Docs.Examples.Alert
<PageTitle>Alert - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Alert</h1>
            <DocBadges Slug="alert" />
        </div>
        <p>A callout for short, important messages. A leading <code>&lt;svg&gt;</code> aligns automatically.</p>
    </header>

    <UsageBlock Example="typeof(AlertDefaultExample)"
                Description="Add the using once, then compose an optional leading icon, a title, and a description inside the alert." />

    <CompositionTree Root="Anatomy"
                     Description="The full anatomy. The leading icon is optional; the description and a top-right action are optional too." />

    <ExamplesHeading />

    <Demo Title="Default" Example="typeof(AlertDefaultExample)" />

    <Demo Title="Title only" Description="A description is optional." Example="typeof(AlertTitleOnlyExample)" />

    <Demo Title="Without icon" Example="typeof(AlertNoIconExample)" />

    <Demo Title="Destructive" Example="typeof(AlertDestructiveExample)" />

    <Demo Title="Success, warning & info" Description="The status variants - same soft treatment as destructive, on the success / warning / info tokens." Example="typeof(AlertStatusExample)" />

    <Demo Title="Customization"
          Description="Recolor the whole callout via Class - an emerald tint, border, text, and a larger radius. Utilities win over the skin, so these take effect."
          Example="typeof(AlertCustomExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic or Hebrew copy - the icon, padding and text all mirror to the right."
          Example="typeof(AlertRtlExample)" />
</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzAlert",
        new CompositionNode("BzIcon"),
        new CompositionNode("BzAlertTitle"),
        new CompositionNode("BzAlertDescription"),
        new CompositionNode("BzAlertAction"));
}
