@page "/components/switch"
@using Blaizio.Docs.Examples.Switch
<PageTitle>Switch - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Switch</h1>
        <p class="text-muted-foreground">A control that toggles between on and off.</p>
    </header>

    <UsageBlock Example="typeof(SwitchDefaultExample)" />

    <ExamplesHeading />

    <Demo Title="Default" Description="Uncontrolled - manages its own checked state." Example="typeof(SwitchDefaultExample)" />

    <Demo Title="With label" Description="Pair with a Label, associated by id." Example="typeof(SwitchLabelExample)" />

    <Demo Title="Checked by default" Example="typeof(SwitchCheckedExample)" />

    <Demo Title="Disabled" Example="typeof(SwitchDisabledExample)" />

    <Demo Title="Status colors" Description="Color repaints the checked track with a status token." Example="typeof(SwitchColorsExample)" />

    <Demo Title="Controlled" Description="Bind the checked state two-way; the text reacts to it." Example="typeof(SwitchControlledExample)" />

    <Demo Title="Customization"
          Description="Recolor the checked track with a data-checked: utility - it wins over the variant default."
          Example="typeof(SwitchCustomExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the switch and its label mirror to the right." Example="typeof(SwitchRtlExample)" />
</div>

