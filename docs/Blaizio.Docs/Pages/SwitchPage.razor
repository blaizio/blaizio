@page "/components/switch"
<PageTitle>Switch - Blaizio بليزيو</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Switch</h1>
        <p class="text-muted-foreground">A control that toggles between on and off.</p>
    </header>

    <UsageBlock Setup="@UsageSetup" Code="@UsageMarkup" />

    <ExamplesHeading />

    <Demo Title="Default" Description="Uncontrolled - manages its own checked state." Code="@DefaultCode">
        <BzSwitch aria-label="Toggle" />
    </Demo>

    <Demo Title="With label" Description="Pair with a Label, associated by id." Code="@LabelCode">
        <div class="flex items-center gap-2">
            <BzSwitch id="airplane" />
            <BzLabel For="airplane">Airplane Mode</BzLabel>
        </div>
    </Demo>

    <Demo Title="Checked by default" Code="@CheckedCode">
        <BzSwitch DefaultChecked="true" aria-label="On by default" />
    </Demo>

    <Demo Title="Disabled" Code="@DisabledCode">
        <div class="flex items-center gap-6">
            <div class="flex items-center gap-2">
                <BzSwitch id="d-off" Disabled />
                <BzLabel For="d-off">Off</BzLabel>
            </div>
            <div class="flex items-center gap-2">
                <BzSwitch id="d-on" Disabled DefaultChecked="true" />
                <BzLabel For="d-on">On</BzLabel>
            </div>
        </div>
    </Demo>

    <Demo Title="Controlled" Description="Bind the checked state two-way; the text reacts to it." Code="@ControlledCode">
        <div class="flex flex-col items-center gap-3">
            <div class="flex items-center gap-2">
                <BzSwitch id="wifi" @bind-Checked="_wifi" />
                <BzLabel For="wifi">Wi-Fi</BzLabel>
            </div>
            <p class="text-sm text-muted-foreground">Wi-Fi is <span class="font-mono">@(_wifi ? "on" : "off")</span></p>
        </div>
    </Demo>
    <Demo Title="Customization"
          Description="Recolor the checked track with a data-checked: utility - it wins over the variant default."
          Code="@CustomCode">
        <div class="flex items-center gap-4">
            <BzSwitch DefaultChecked="true" Class="data-checked:bg-emerald-600" aria-label="Emerald" />
            <BzSwitch DefaultChecked="true" Class="data-checked:bg-indigo-600" aria-label="Indigo" />
            <BzSwitch DefaultChecked="true" Class="data-checked:bg-rose-600" aria-label="Rose" />
        </div>
    </Demo>
    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the switch and its label mirror to the right." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <div class="flex items-center gap-2">
                <BzSwitch id="rtl-airplane" />
                <BzLabel For="rtl-airplane">وضع الطائرة</BzLabel>
            </div>
        </BzDirectionProvider>
    </Demo>
</div>

@code {
    private bool _wifi = true;

    private const string UsageSetup = """
        @* _Imports.razor (or the top of the page) *@
        @using Blaizio.Ui
        """;

    private const string UsageMarkup = """
        <BzSwitch aria-label="Toggle" />
        """;

    private const string CustomCode = """
        <BzSwitch DefaultChecked="true" Class="data-checked:bg-emerald-600" aria-label="Emerald" />
        <BzSwitch DefaultChecked="true" Class="data-checked:bg-indigo-600" aria-label="Indigo" />
        <BzSwitch DefaultChecked="true" Class="data-checked:bg-rose-600" aria-label="Rose" />
        """;

    private const string DefaultCode = """
        <BzSwitch aria-label="Toggle" />
        """;

    private const string LabelCode = """
        <BzSwitch id="airplane" />
        <BzLabel For="airplane">Airplane Mode</BzLabel>
        """;

    private const string CheckedCode = """
        <BzSwitch DefaultChecked="true" aria-label="On by default" />
        """;

    private const string DisabledCode = """
        <div class="flex items-center gap-2">
            <BzSwitch id="d-off" Disabled />
            <BzLabel For="d-off">Off</BzLabel>
        </div>
        <div class="flex items-center gap-2">
            <BzSwitch id="d-on" Disabled DefaultChecked="true" />
            <BzLabel For="d-on">On</BzLabel>
        </div>
        """;

    private const string ControlledCode = """
        <BzSwitch id="wifi" @bind-Checked="_wifi" />
        <BzLabel For="wifi">Wi-Fi</BzLabel>

        @code { private bool _wifi = true; }
        """;

    private const string RtlCode = """
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzSwitch id="rtl-airplane" />
            <BzLabel For="rtl-airplane">وضع الطائرة</BzLabel>
        </BzDirectionProvider>
        """;
}
