@page "/docs/components/switch"
@using Blaizio.Docs.Examples.Switch
<PageTitle>Switch - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Switch</h1>
            <DocBadges Slug="switch" />
        </div>
        <p>A native button with <code>role="switch"</code>, so Space and Enter toggle it and screen readers announce it as on or off. Three sizes, status colors and optional icons on the track and the knob cover most settings screens without custom styling.</p>
    </header>

    <UsageBlock Example="typeof(SwitchDefaultExample)"
                Description="A switch renders no text of its own, so give it a name. Pair it with a `BzLabel` whose `For` matches its `id`, or set `AriaLabel` when it stands alone." />

    <ExamplesHeading />

    <Demo Title="Default" Description="With no binding, the switch keeps track of its own checked state." Example="typeof(SwitchDefaultExample)" />

    <Demo Title="With label" Description="A `BzLabel` whose `For` points at the switch's `id` names it, and clicking the label toggles it." Example="typeof(SwitchLabelExample)" />

    <Demo Title="Sizes" Description="`Size` offers `Sm`, `Default` and `Lg`. The large size leaves room for icons." Example="typeof(SwitchSizesExample)" />

    <Demo Title="Icons"
          Description="`CheckedIcon` and `UncheckedIcon` draw on the track, while `ThumbCheckedIcon` and `ThumbUncheckedIcon` sit inside the knob. Each pair cross-fades as the state changes."
          Example="typeof(SwitchIconsExample)" />

    <Demo Title="Checked by default" Description="Set `DefaultChecked` to start an unbound switch in the on state." Example="typeof(SwitchCheckedExample)" />

    <Demo Title="Disabled" Example="typeof(SwitchDisabledExample)" />

    <Demo Title="Status colors" Description="`Color` paints the checked track with a status color." Example="typeof(SwitchColorsExample)" />

    <Demo Title="Controlled" Description="Bind `Checked` when the page needs the state. The text next to it updates as you toggle." Example="typeof(SwitchControlledExample)" />

    <Demo Title="Customization"
          Description="Pass a `data-checked:` utility through `Class` to recolor the checked track. It is merged over the default, so your color wins."
          Example="typeof(SwitchCustomExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, the switch and its label trade places and the knob travels in the opposite direction." Example="typeof(SwitchRtlExample)" />
</div>

