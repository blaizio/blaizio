@page "/components/input-number"
@using Blaizio.Docs.Examples.InputNumber
<PageTitle>Input Number - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Input Number</h1>
        <p class="text-muted-foreground">A numeric field with step buttons, over the WAI-ARIA spinbutton pattern. Type a value, use the arrow keys (Shift for the large step, Home / End for the bounds), or press-and-hold a button to spin. Bind with <code>@@bind-Value</code> and set <code>Min</code> / <code>Max</code> / <code>Step</code>; a .NET <code>Format</code> string dresses the resting display while the editable text stays a plain number.</p>
    </header>

    <UsageBlock Example="typeof(InputNumberUsageExample)" Description="Two-way bind the number and bound it with Min / Max / Step." />

    <ExamplesHeading />

    <Demo Title="Basic" Description="A plain number field. Type a value, step it with the arrow keys, or press and hold a button to spin. The default step is 1."
          Example="typeof(InputNumberBasicExample)" />

    <Demo Title="Min and max" Description="Bound the value with Min and Max - it clamps on blur, and the step button at a reached edge disables itself."
          Example="typeof(InputNumberMinMaxExample)" />

    <Demo Title="Step and large step" Description="Step sets the grid the value snaps to and the amount one arrow / button press moves. Hold Shift with an arrow key (or PageUp / PageDown) for the LargeStep jump."
          Example="typeof(InputNumberStepExample)" />

    <Demo Title="Formatted" Description="Pass a .NET Format string for the resting display - currency, percent, fixed decimals. While focused the field shows the plain editable number so you type digits, not symbols."
          Example="typeof(InputNumberFormatExample)" />

    <Demo Title="Controlled" Description="Drive the value yourself with two-way binding. The live value is shown above, and a button resets it."
          Example="typeof(InputNumberControlledExample)" />

    <Demo Title="Disabled" Description="Disabled greys the field and its buttons and blocks every interaction, while still showing the value."
          Example="typeof(InputNumberDisabledExample)" />

    <Demo Title="Read only" Description="ReadOnly shows the value and lets it be focused and copied, but blocks typing and the steppers."
          Example="typeof(InputNumberReadOnlyExample)" />

    <Demo Title="Without steppers" Description="Set Buttons to false to drop the +/- buttons, leaving just the styled numeric field. Typing and the arrow keys still work."
          Example="typeof(InputNumberNoButtonsExample)" />

    <Demo Title="Invalid" Description="Pass aria-invalid to mark the field invalid - the group picks up the destructive ring, like the other inputs."
          Example="typeof(InputNumberInvalidExample)" />

    <Demo Title="Customization"
          Description="Recolor the group with unconditional border / ring utilities and tint the step buttons by targeting their slot - both win over the skin."
          Example="typeof(InputNumberCustomExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left DirectionProvider the step buttons swap sides (logical borders) and the field mirrors; the math is unchanged."
          Example="typeof(InputNumberRtlExample)" />

</div>

