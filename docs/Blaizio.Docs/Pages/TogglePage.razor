@page "/docs/components/toggle"
@using Blaizio.Docs.Examples.Toggle
<PageTitle>Toggle - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Toggle</h1>
            <DocBadges Slug="toggle" />
        </div>
        <p>A two-state button that can be on or off.</p>
    </header>

    <UsageBlock Example="typeof(ToggleDefaultExample)" Description="Wrap an icon (or text); it toggles its own pressed state." />

    <ExamplesHeading />

    <Demo Title="Default" Description="Uncontrolled - manages its own pressed state." Example="typeof(ToggleDefaultExample)" />

    <Demo Title="Custom element (RenderAs)"
          Description="Render the toggle behaviour onto your own element via RenderAs - here an anchor - by splatting p.Attributes."
          Example="typeof(ToggleRenderAsExample)" />

    <Demo Title="Outline" Example="typeof(ToggleOutlineExample)" />

    <Demo Title="With text" Example="typeof(ToggleTextExample)" />

    <Demo Title="Sizes" Example="typeof(ToggleSizesExample)" />

    <Demo Title="Disabled" Example="typeof(ToggleDisabledExample)" />

    <Demo Title="Controlled" Description="Bind the pressed state two-way; the label reacts to it." Example="typeof(ToggleControlledExample)" />

    <Demo Title="Customization"
          Description="Recolor the pressed state with aria-pressed: utilities - they win over the variant default."
          Example="typeof(ToggleCustomExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic or Hebrew copy - the icon sits on the leading (right) edge of the text." Example="typeof(ToggleRtlExample)" />
</div>

