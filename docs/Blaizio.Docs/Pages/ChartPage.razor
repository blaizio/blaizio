@page "/docs/components/chart"
@using Blaizio.Docs.Examples.Chart
<PageTitle>Chart - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Chart</h1>
            <DocBadges Slug="chart" />
        </div>
        <p>Charts drawn as plain SVG by Blazor components, with no JavaScript chart library behind them. You declare series, axes, the tooltip and the legend as child components, and colors come from the <code>--chart-1</code> to <code>--chart-5</code> theme tokens, so every chart follows the active theme. Entry animations are pure CSS and respect reduced motion, while the hover tooltip needs an interactive render mode.</p>
        <div class="flex items-center gap-2 text-sm">
            <a href="charts" class="bg-muted text-foreground hover:bg-muted/70 rounded-md px-2 py-0.5 font-medium no-underline">Charts gallery</a>
        </div>
    </header>

    <UsageBlock Example="typeof(ChartUsageExample)" />

    <CompositionTree Root="Anatomy"
                     Description="The parts of a cartesian chart. Mix any number of bar, line and area series, and leave out any of the other children you don't need. `BzPieChart`, `BzRadarChart` with `BzRadarSeries`, and `BzRadialBarChart` are separate roots that share `BzChartTooltip` and `BzChartLegend`." />

    <ExamplesHeading />

    <Demo Title="Bar"
          Description="Several bar series render as groups, side by side in each category."
          Example="typeof(ChartBarExample)" />

    <Demo Title="Stacked bars"
          Description="Set `Stacked` on the chart to stack bar and area series instead of grouping them."
          Example="typeof(ChartBarStackedExample)" />

    <Demo Title="Line"
          Description="`Curved` draws a monotone curve, which is smooth but never overshoots the data."
          Example="typeof(ChartLineExample)" />

    <Demo Title="Area"
          Description="With `Stacked` and `Curved` together, each layer's curve follows the layer below it, so the layers never leave a gap or overlap."
          Example="typeof(ChartAreaExample)" />

    <Demo Title="Scatter"
          Description="`XValue` switches the x axis from category bands to a linear scale. Hovering snaps the tooltip to the nearest point."
          Example="typeof(ChartScatterExample)" />

    <Demo Title="Composed"
          Description="Different series kinds share one scale. Here bars show the actual values and a line shows the target."
          Example="typeof(ChartComposedExample)" />

    <Demo Title="Pie / Donut"
          Description="`BzPieChart` takes the same tooltip and legend children. Set `InnerRadius` to turn it into a donut, and use `CenterContent` to fill the hole."
          Example="typeof(ChartPieExample)" />

    <Demo Title="Radar"
          Description="Each item gets a spoke, and each `BzRadarSeries` draws one translucent polygon across them."
          Example="typeof(ChartRadarExample)" />

    <Demo Title="Radial bar"
          Description="Concentric arcs over a muted track. A CSS stroke animation draws them in on first render."
          Example="typeof(ChartRadialBarExample)" />

    <Demo Title="RTL"
          Description="Inside a right-to-left `DirectionProvider`, the categories run from right to left and the value axis moves to the right edge."
          Example="typeof(ChartRtlExample)" />
</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzChart",
        new CompositionNode("BzChartGrid"),
        new CompositionNode("BzChartXAxis"),
        new CompositionNode("BzChartYAxis"),
        new CompositionNode("BzChartBarSeries"),
        new CompositionNode("BzChartLineSeries"),
        new CompositionNode("BzChartAreaSeries"),
        new CompositionNode("BzChartScatterSeries"),
        new CompositionNode("BzChartTooltip"),
        new CompositionNode("BzChartLegend"));
}
