@page "/docs/components/table"
@using Blaizio.Docs.Examples.Table
<PageTitle>Table - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Table</h1>
            <DocBadges Slug="table" />
        </div>
        <p>
            Compose the styled primitives for a plain, responsive table, or hand your rows to
            <code>BzDataTable&lt;TItem&gt;</code> for sorting, search, selection, spreadsheet-style editing, column sizing, pinning and
            moving, pagination and virtualization. Rows scroll with the page by default, or inside a fixed-height box when you set
            <code>MaxHeight</code>, and server-side data plugs in by swapping <code>Items</code> for an
            async <code>ItemsProvider</code>.
        </p>
    </header>

    <UsageBlock Example="typeof(TableUsageExample)"
                Description="Import `Blaizio.Ui` once, then compose the styled primitives yourself, or hand your rows to `BzDataTable&lt;TItem&gt;` for sorting, search and the rest." />

    <CompositionTree Root="Anatomy"
                     Description="A `BzTable` wraps an optional caption, a header of head cells, a body of rows and an optional footer. `BzDataTable` builds the same structure for you." />

    <ExamplesHeading />

    <Demo Title="Basic" Description="The styled primitives composed by hand: `BzTable`, `BzTableHeader`, `BzTableBody`, `BzTableRow`, `BzTableHead`, `BzTableCell` and `BzTableCaption`." Example="typeof(TableBasicExample)" />

    <Demo Title="Data table"
          Description="`BzDataTable` connects its columns to sorting (click a header), search, a column visibility menu and row selection. Declare columns as `BzPropertyColumn` or `BzTemplateColumn` children, and because `TItem` cascades you usually only pass the property."
          Example="typeof(TableDataTableExample)" />

    <Demo Title="Columns as data"
          Description="Pass a `Columns` list instead of child components when the columns come from data. `SortBy` makes a column sortable and `Text` includes it in search."
          Example="typeof(TableColumnsAsDataExample)" />

    <Demo Title="Empty state"
          Description="When the filter matches nothing, the body shows a single row with `EmptyContent`, which defaults to &quot;No results.&quot;"
          Example="typeof(TableEmptyExample)" />

    <Demo Title="Virtualized rows (fixed height)"
          Description="`Virtualize` renders only the rows in view. Here 10,000 rows scroll inside a `MaxHeight` box with its own scrollbar, and the page takes over at the top or bottom. Every row is exactly `ItemSize` tall, so placement is plain index math, the fastest option for uniform rows. Omit `MaxHeight` to virtualize against the page instead. The table warns in the browser console when an unpaged, non-virtualized list passes 2,000 rows, as a hint to set `Virtualize` or `PageSize`."
          Example="typeof(TableVirtualFixedExample)" />

    <Demo Title="Virtualized rows (dynamic height)"
          Description="Add `DynamicRowHeight` and the virtualizer measures each rendered row instead of assuming `ItemSize`, so rows of different heights, here notes that wrap, land in the right place. `ItemSize` then only serves as the estimate until a row is measured."
          Example="typeof(TableVirtualDynamicExample)" />

    <Demo Title="Row class"
          Description="`RowClass` returns a CSS class for each row from its data and styles the whole row, independent of the columns. Here suspended members are dimmed and struck through, and admins get a subtle tint."
          Example="typeof(TableRowClassExample)" />

    <Demo Title="Tie-breaker sort"
          Description="A column's `Sort` can chain keys. This Role column sorts by role and then by name, so rows with the same role stay together in alphabetical order. Clicking the header reverses the whole chain."
          Example="typeof(TableTieBreakerExample)" />

    <Demo Title="Pagination"
          Description="Set `PageSize` to split moderate data into pages instead of virtualizing it. A pager appears below the table, a search goes back to the first page, and sorting applies across all pages."
          Example="typeof(TablePaginationExample)" />

    <Demo Title="Async data (ItemsProvider)"
          Description="For server-side data, give an `ItemsProvider` instead of `Items`. It receives the page window, sort and filter, and returns that page with the total count, so sorting, search and paging all happen at the source. Here it queries 10,000 rows with a simulated 300ms delay: skeleton rows hold the shape during the first load (`LoadingContent` replaces them), and stale requests are canceled as you click. When rows change at the source, keep a reference to the table and call `RefreshDataAsync()` to load the current page again."
          Example="typeof(TableProviderExample)" />

    <Demo Title="Editing cells"
          Description="Mark a `BzPropertyColumn` `Editable` and the table becomes a spreadsheet-style grid that edits with Blaizio's own controls, picked from each property's type: a text box for Name, a pick list for the Category enum, number fields for Price and Stock, a date field for Restock and a time field for Cut-off. `Editor` picks the switch for Listed. A click selects a cell, and a double-click edits it in place with the control ready: the caret where you clicked, the list or calendar open, the time part under the pointer. With `EditOnClick` (the switch in this demo) a single click does that, and a click on another cell commits and opens that one. The chevron and calendar marks on a hovered cell open the list or calendar too, and a click on a switch flips it at once. On the keyboard, type over a cell to replace it (an arrow then commits and moves), press F2 to edit it in place, or press Alt+ArrowDown to open a list or calendar. Enter commits and moves down, Escape puts the old value back (with a list open, one Escape closes it and cancels), Delete clears a cell, and a block copied from a spreadsheet pastes across cells. The cursor's ring shows while you use the keyboard, while with the mouse the cell under the pointer is tinted instead. Values pass the property's DataAnnotations (Stock's `Range`, Name's `Required`) and the column's `Validate` (Price) before they are written into the row, and `OnEdit` hears every change once per action."
          Example="typeof(TableEditCellExample)" />

    <Demo Title="Custom cells"
          Description="A cell can render any template while its column keeps sorting, search and its editor. `ChildContent` gets the row, so here Status shows a badge and still edits with its pick list. `CellContent` gets the cell instead: the row (`context.Item`), the value and its formatted text (`context.Value`, `context.Text`), whether the row has an edit open (`context.IsEditing`), and `context.Error` and `context.Pending`, which Progress uses to dim its bar while a save runs. `EdgeToEdge` removes the cell's padding and stretches the template to the full cell height, so a background tints the whole cell, as Open issues does from ten up, and the template pads itself. The keyboard cursor lives in the browser rather than in the context: an editable table's cells carry `data-active` while they hold it, along with `group/table-cell`, so a template can follow it in CSS, here with `group-data-active/table-cell` on the bar."
          Example="typeof(TableCustomCellsExample)" />

    <Demo Title="Editing rows"
          Description="Set `EditMode` to `Row` to edit the whole row in place. Enter, F2 or a double-click opens an editor in every editable cell (a pick list for Room, date fields for the stay, a checkbox for Paid), focused on the cell you were on and ready the way a cell editor is: a double-click on Room opens its list, and typing over a cell replaces it. Tab moves through the fields, Enter commits the row as one change, and Escape cancels it. The row is already written when `OnEdit` runs, so a rule can check several fields at once: here a check-out before the check-in is refused with `Reject`, which puts the old values back and keeps the row open with the message under the field."
          Example="typeof(TableEditRowExample)" />

    <Demo Title="Edit actions column"
          Description="`BzEditActionsColumn` gives every row an Edit button, which turns into Save and Cancel while the row edits in place (in Dialog and Drawer modes, Edit opens the form). The buttons are icons named by `EditLabel`, `SaveLabel` and `CancelLabel`, each with a tooltip, and the column takes `Pinned`, `Width` and `Align` like any other; here it stays at the end edge. It is as wide as Save and Cancel from the start, because columns keep their widths while a row edits. The buttons belong to the row's edit: a press on Cancel cancels without saving first, Tab from the row's last field reaches Save and then Cancel, and Enter or Space presses them. While `OnEdit` runs, Save shows a spinner and both buttons wait. The column only appears when rows edit as a whole, so it is hidden in Cell mode. `ChildContent` replaces the buttons and receives the row's actions as its context: `Item`, `IsEditing`, `Busy`, `BeginAsync`, `SaveAsync` and `CancelAsync`."
          Example="typeof(TableEditActionsExample)" />

    <Demo Title="Your own actions column"
          Description="Any column can hold your own buttons, because the table's `BeginEditAsync`, `CommitEditAsync`, `CancelEditAsync` and `IsEditing` are public and a template column renders again when an edit opens or closes. Set `EditActions` on that `BzTemplateColumn` so its controls belong to the row's edit as the built-in ones do: a press on Cancel cancels, and Tab from the row's last field reaches Save and Cancel. Columns keep their widths while a row edits, so give the cell room for the wider set of buttons from the start. Here both sets share one grid cell, with the one not in use invisible and inert. Edit amount opens the row on its Amount field, since `BeginEditAsync` takes a column key."
          Example="typeof(TableEditOwnActionsExample)" />

    <Demo Title="Editing in a dialog"
          Description="Set `EditMode` to `Dialog` to edit the row as a form. Enter on a row, a double-click, or `BeginEditAsync` from a row action opens it on the field of the column you were on, with a field for every editable column, including the hidden Started, Active and Notes columns. When the fields outgrow the dialog, they scroll between the title and the buttons. Closing a changed form with Escape, a press outside or Cancel asks first, with Discard and Keep editing in the footer. `Options` turns Team's strings into a pick list, `Editor` makes Active a switch, and `EditorContent` swaps in any control, here a multi-line text box for Notes; it binds `context.Value` and serves the cell, row and form editors alike. The rows are records with no setters, so `OnEdit` applies the change by replacing the row."
          Example="typeof(TableEditDialogExample)" />

    <Demo Title="Editing in your own dialog"
          Description="`EditDialogContent` replaces the built-in dialog with your own. Bind its `Open` and `OpenChanged` to the context and save with `context.SaveAsync`. `context.Field` renders a column's built-in field (label, editor and message), so the fields behave as they do in the built-in form while the layout is yours, here two to a row. Closing a changed ticket asks first: while `context.ConfirmingDiscard` is true the footer shows your own question, with `context.DiscardAsync` and `context.KeepEditing` as the answers. For controls of your own, `context.GetValue` and `SetValue` reach the draft values, and `ErrorFor` and `Message` explain why a save was refused."
          Example="typeof(TableEditCustomDialogExample)" />

    <Demo Title="Editing in a drawer"
          Description="Set `EditMode` to `Drawer` to put the same form in a sheet at the inline-end edge, full width on a phone. Its title and buttons stay put while the fields scroll, and it opens on the field of the column you were on. Previous and Next in the header save the row (a refused value keeps you on it) and open the row before or after it in the table's current order, so sort or search first to step through a subset; they are disabled at the ends. A changed form asks before it closes, as the dialog does. While the drawer is open its row is marked in the table, and when it closes, focus returns to the row it showed last."
          Example="typeof(TableEditDrawerExample)" />

    <Demo Title="Editing in your own drawer"
          Description="`EditDrawerContent` replaces the built-in drawer with your own and gets the same context as `EditDialogContent`. Here the sheet shows the order number in its header, the fields in two sections and its own Previous and Next buttons (`context.HasPrevious`, `context.PreviousAsync` and `context.NextAsync`), while `context.Actions` renders the built-in footer buttons, including the Discard or Keep editing question."
          Example="typeof(TableEditCustomDrawerExample)" />

    <Demo Title="Editing large tables"
          Description="Editing works with `Virtualize`: here 10,000 rows sit in a scroll box with only the visible rows rendered. Moving the cursor never calls .NET, and PageDown, Ctrl+End or an arrow past the edge scrolls the box to bring the row in. Only one editor is open at a time, and starting or committing an edit renders only the rows in view again. Total follows Quantity and Unit price as you commit."
          Example="typeof(TableEditVirtualExample)" />

    <Demo Title="Column sizing"
          Description="`Width`, `MinWidth` and `MaxWidth` size a column in pixels, and `Fill` gives one column the room the others leave, here Customer. With `ResizableColumns`, drag the edge between two headers to resize, double-click it to fit the content, or focus a header and press Alt+Shift+Left or Right (Alt+Shift+Enter fits). Columns before the one you resize keep their widths, while a filling column after it absorbs the difference. Bind `ColumnWidths` to keep what users choose: it holds the widths they set by column key, and setting it to `null` restores the columns' own widths."
          Example="typeof(TableColumnSizingExample)" />

    <Demo Title="Pinned columns"
          Description="`Pinned` keeps a column in place while the rows scroll sideways. `Start` columns sit at the start edge, joined by the selection column, and `End` columns at the end edge, each group in its own order with a divider on its inner edge. Pinned cells take the row's hover and selection tint, and they work with `StickyHeader`, a `MaxHeight` scroll box, resizing (the offsets follow the widths), `Virtualize` and editing."
          Example="typeof(TableColumnPinningExample)" />

    <Demo Title="Moving columns"
          Description="With `ReorderableColumns`, drag a header to move its column, or focus one and press Ctrl+Shift+Left or Right, and focus moves with it. A header that can move shows the grab cursor. While you drag, a label follows the pointer and a line marks where the column will land. With `LiveReorder` (the switch) the column itself follows the pointer and the others slide out of its way. Either way the order is reported once, on release, and Escape puts everything back. A column moves only within its pinned group, and one with `Reorderable` off stays put and blocks the others from crossing it, here the # column. A plain click still sorts. Bind `ColumnOrder` to keep the order: it lists every column key, hidden ones included, and a column missing from a saved order keeps its declared place."
          Example="typeof(TableColumnReorderExample)" />

    <Demo Title="Columns in a large editable table"
          Description="Every column feature at once on 10,000 virtualized, editable rows: # and Item pinned to the start, Total to the end, and the columns between them resizable and movable with `LiveReorder`. Rows the virtualizer adds mid-drag shift with the rest. Widths live in a `colgroup`, so rows added as you scroll pick them up automatically and an editor never changes a column's width. Moving the cursor still never calls .NET, and it scrolls a cell out from under the pinned columns."
          Example="typeof(TableColumnsVirtualExample)" />

    <Demo Title="Customization"
          Description="Each column of a `BzDataTable` can draw its own cells and keep its sort and search. `CellContent` gets the row (`context.Item`) and the property's value (`context.Value`, formatted as `context.Text`): here an avatar beside two lines of text, a status badge, and a `BzProgress` bar colored by the health score. MRR keeps the column's formatted text and only adds `CellClass`. `Width` fixes the narrow columns, and `Fill` gives Account the rest of the row. `EdgeToEdge` lets Change tint its whole cell; the template pads itself, and `HeaderClass` gives the header the same padding. `HeaderContent` puts an info tooltip beside the Health label, in place of the sort button. `Toolbar` adds the status filter beside the search box, which `SearchColumn` limits to Account."
          Example="typeof(TableCustomExample)" />

    <Demo Title="RTL"
          Description="Inside a right-to-left `DirectionProvider`, with the headers and rows in Arabic or Hebrew, text alignment, the selection column and the sort indicator all move to the opposite side. Text the table writes itself has parameters too: `SelectionSummaryContent` words the selection line from `context.Selected` and `context.Total`, and `SelectAllAriaLabel` and `SelectRowAriaLabel` name the checkboxes."
          Example="typeof(TableRtlExample)" />

    <Demo Title="Columns, right to left"
          Description="Pinning, resizing and moving follow the direction. The start edge is on the right, so the pinned Name column and the selection column stay there, each resize handle sits on its header's left edge, and Alt+Shift+Left widens a column. Ctrl+Shift+Left still moves a column to the left on screen. `ColumnAnnouncement` words what screen readers hear after each of those keys, here in Arabic or Hebrew."
          Example="typeof(TableColumnsRtlExample)" />

    <section class="space-y-3">
        <h2 id="keyboard" data-toc class="scroll-mt-20 text-xl font-semibold tracking-tight">Pointer and keyboard</h2>
        <p>
            An editable table is one tab stop: Tab moves into it and the arrow keys move between cells.
            The pointer and the keyboard start an edit differently. A click only selects (with
            <code>EditOnClick</code> it edits); a double-click edits in place with the control ready.
            On the keyboard, typing replaces a cell and F2 edits it in place. The cursor's ring shows
            while you use the keyboard: after Tab brings you in, or after a key pressed once you
            clicked. A click alone draws no ring. Moving the cursor never calls .NET; only starting
            and committing an edit do. In right-to-left pages the left and right arrows swap.
        </p>
        <h3 id="pointer" data-toc class="scroll-mt-20 pt-2">Pointer</h3>
        <BzTable>
            <BzTableHeader>
                <BzTableRow>
                    <BzTableHead>Pointer</BzTableHead>
                    <BzTableHead>On a cell</BzTableHead>
                    <BzTableHead>While editing</BzTableHead>
                </BzTableRow>
            </BzTableHeader>
            <BzTableBody>
                @foreach (var (action, onCell, editing) in PointerRows)
                {
                    <BzTableRow>
                        <BzTableCell><div class="min-w-28 whitespace-normal font-medium">@action</div></BzTableCell>
                        <BzTableCell><div class="min-w-48 max-w-md whitespace-normal">@onCell</div></BzTableCell>
                        <BzTableCell><div class="min-w-48 max-w-md whitespace-normal">@editing</div></BzTableCell>
                    </BzTableRow>
                }
            </BzTableBody>
        </BzTable>
        <h3 id="keys" data-toc class="scroll-mt-20 pt-2">Keyboard</h3>
        <BzTable>
            <BzTableHeader>
                <BzTableRow>
                    <BzTableHead>Key</BzTableHead>
                    <BzTableHead>On a cell</BzTableHead>
                    <BzTableHead>While editing</BzTableHead>
                </BzTableRow>
            </BzTableHeader>
            <BzTableBody>
                @foreach (var (keys, onCell, editing) in KeyboardRows)
                {
                    <BzTableRow>
                        <BzTableCell>
                            <span class="inline-flex flex-wrap gap-1">
                                @foreach (var key in keys)
                                {
                                    <BzKbd>@key</BzKbd>
                                }
                            </span>
                        </BzTableCell>
                        <BzTableCell><div class="min-w-48 max-w-md whitespace-normal">@onCell</div></BzTableCell>
                        <BzTableCell><div class="min-w-48 max-w-md whitespace-normal">@editing</div></BzTableCell>
                    </BzTableRow>
                }
            </BzTableBody>
        </BzTable>
        <h3 id="how-editors-open" data-toc class="scroll-mt-20 pt-2">How each editor opens</h3>
        <p>
            What the control looks like when its edit starts. With <code>EditOnClick</code> a single
            click acts as a double-click. Row mode follows the same rules for the cell you were on;
            the Dialog and Drawer forms focus that column's field and never open a list or calendar by
            themselves.
        </p>
        @* Wider than a phone: the box scrolls sideways, so it is a stop the keyboard can scroll. *@
        <BzTable ContainerFocusable ContainerAriaLabel="How each editor opens">
            <BzTableHeader>
                <BzTableRow>
                    <BzTableHead>Editor</BzTableHead>
                    <BzTableHead>Double-click or tap</BzTableHead>
                    <BzTableHead>Typing</BzTableHead>
                    <BzTableHead>F2</BzTableHead>
                    <BzTableHead>Alt+ArrowDown, Space</BzTableHead>
                </BzTableRow>
            </BzTableHeader>
            <BzTableBody>
                @foreach (var (editor, pointer, typing, f2, open) in EditorRows)
                {
                    <BzTableRow>
                        <BzTableCell><div class="min-w-24 whitespace-normal font-medium">@editor</div></BzTableCell>
                        <BzTableCell><div class="min-w-28 max-w-48 whitespace-normal">@pointer</div></BzTableCell>
                        <BzTableCell><div class="min-w-28 max-w-48 whitespace-normal">@typing</div></BzTableCell>
                        <BzTableCell><div class="min-w-28 max-w-48 whitespace-normal">@f2</div></BzTableCell>
                        <BzTableCell><div class="min-w-28 max-w-48 whitespace-normal">@open</div></BzTableCell>
                    </BzTableRow>
                }
            </BzTableBody>
        </BzTable>
        <p>
            A column's own editor (<code>EditorContent</code>) can follow the same rules: its context
            says how the edit started. <code>context.StartedBy</code> is <code>Pointer</code>,
            <code>Key</code>, <code>Typing</code> or <code>Code</code> (<code>BeginEditAsync</code>),
            <code>context.TypedText</code> holds what was typed over the cell (an empty string after
            Backspace), and <code>context.OpenPopup</code> asks for your control's popup open from the
            start. Only the editor the edit started in gets the typed text and the popup.
        </p>
        <p>
            Column keys work on a focused header in any table, editable or not: Tab reaches a header
            through its sort button (or the header itself), and an editable table's cursor reaches it
            with the arrows. Each resize or move is reported to .NET once, when it is done.
        </p>
        <BzTable>
            <BzTableHeader>
                <BzTableRow>
                    <BzTableHead>Key</BzTableHead>
                    <BzTableHead>On a header</BzTableHead>
                </BzTableRow>
            </BzTableHeader>
            <BzTableBody>
                @foreach (var (keys, onHeader) in HeaderKeyboardRows)
                {
                    <BzTableRow>
                        <BzTableCell>
                            <span class="inline-flex flex-wrap gap-1">
                                @foreach (var key in keys)
                                {
                                    <BzKbd>@key</BzKbd>
                                }
                            </span>
                        </BzTableCell>
                        <BzTableCell><div class="min-w-48 max-w-xl whitespace-normal">@onHeader</div></BzTableCell>
                    </BzTableRow>
                }
            </BzTableBody>
        </BzTable>
    </section>

</div>

@code {
    // How the pointer acts on an editable table's cells, and inside an open editor.
    private static readonly (string Action, string OnCell, string Editing)[] PointerRows =
    [
        ("Click", "Select the cell, with no ring until a key is pressed. A click on a checkbox or switch flips it at once. With EditOnClick: edit in place, as a double-click does.", "Inside the editor: the control's own. On another cell: commit and select that cell, without opening its editor (with EditOnClick, commit and open it). Outside the table: commit."),
        ("Double-click", "Edit in place with the control ready: the caret at the clicked character, a list or calendar open, the time part under the pointer.", "Selects a word in a text box."),
        ("Hover", "Cell mode: the cell under the pointer takes the row's hover tint too. A pick list's or date's cell shows its mark.", "-"),
        ("Chevron or calendar mark", "On a pick list's or date's cell (shown on hover, and on the cursor's cell while you use the keyboard): open the editor with its list or calendar.", "-"),
        ("Tap", "With touch or a pen: select the cell. A tap on the selected cell edits it in place, as a double-click does. With EditOnClick the first tap does.", "As a click."),
        ("Pick", "-", "A click on an option or a day: commit and close the editor, staying on the cell."),
        ("Edit, Save, Cancel", "In an edit actions column (or your own column with EditActions): Edit opens the row's editors or its form.", "Save commits the row and Cancel puts it back; the press never commits the row on its way."),
    ];

    // The editable table's keys: what each does on a cell, and inside an open editor.
    private static readonly (string[] Keys, string OnCell, string Editing)[] KeyboardRows =
    [
        (["Arrows"], "Move one cell. Up from the first row reaches the header.", "After typing over a cell: commit and move. After F2 or a double-click they stay in the editor: they move the caret, step a number or a date or time part, and move an open list's highlight."),
        (["Ctrl", "Arrow"], "Jump to the first or last row or column.", "Moves the caret."),
        (["Home", "End"], "First or last cell of the row. With Ctrl, of the table.", "Moves the caret."),
        (["PageUp", "PageDown"], "Move a screenful of rows.", "-"),
        (["Tab"], "Next cell, wrapping to the next row. Leaves the table after the last cell. With Shift, back.", "The editor's next part (a date's day, month and year; a row's fields, then the row's Save and Cancel), then commit and move right. With Shift, left. In an open list: pick the highlighted option and move right."),
        (["Enter"], "Cell mode: move down, back to the column where a run of Tabs started. With Shift, up. Row mode: edit the row. Dialog and Drawer modes: open the form.", "Commit and move down, back to the column where a run of Tabs started. With Shift, up. In an open list: pick the highlighted option and commit, staying on the cell. On Save or Cancel: press it."),
        (["A", "1"], "Typing replaces the cell: the editor opens holding only the typed character. A number cell starts on a digit, a sign or the decimal separator, a date or time cell on a digit; a pick list opens with the highlight on the first option the keys begin. A checkbox or switch ignores it.", "Types. In an open list: moves the highlight to the first option the keys begin."),
        (["F2"], "Edit the cell in place, caret at the end. A pick list opens its list.", "Switch between moving on with the arrows (after typing over a cell) and editing in place."),
        (["Alt", "ArrowDown"], "Open a pick list's list or a date's calendar.", "Opens the list or the calendar."),
        (["Ctrl", "Enter"], "-", "Commit and stay."),
        (["Escape"], "-", "Cancel and put the old value back. With a list or calendar open, one Escape closes it and cancels."),
        (["Space"], "Flip a checkbox or switch cell, or open a pick list. With Shift, select the row.", "Types a space, picks in an open list, or presses Save or Cancel."),
        (["Delete"], "Clear the cell.", "Deletes text."),
        (["Backspace"], "A text, number, date or time cell: clear it and start typing. Any other cell: clear it, as Delete does.", "Deletes text."),
        (["Ctrl", "C"], "Copy the cell's text.", "Copies the selected text."),
        (["Ctrl", "V"], "Paste one value, or a block copied from a spreadsheet.", "Pastes text."),
    ];

    // How each built-in editor arrives, by what started its edit.
    private static readonly (string Editor, string Pointer, string Typing, string F2, string Open)[] EditorRows =
    [
        ("Text box", "Caret at the clicked character.", "Holds the typed character.", "Caret at the end.", "-"),
        ("Number field", "Caret at the clicked character when the cell shows the plain number, else at the end.", "A digit, a sign or the decimal separator starts it.", "Caret at the end; Up and Down step the number.", "-"),
        ("Pick list", "List open, on the current option.", "List open, the highlight on the first option the keys begin.", "List open.", "List open."),
        ("Date field", "Calendar open, on the current date.", "A digit starts the first part, the calendar closed.", "In place; Up and Down change the focused part.", "Alt+ArrowDown: calendar open."),
        ("Time field", "The part under the pointer, else the hour.", "A digit starts the first part.", "In place; Up and Down change the focused part.", "-"),
        ("Checkbox, switch", "A click flips it at once; a double-click adds nothing.", "Ignored.", "-", "Space flips it."),
        ("Your own (EditorContent)", "StartedBy Pointer, OpenPopup true.", "StartedBy Typing, the keys in TypedText.", "StartedBy Key.", "Alt+ArrowDown: OpenPopup true."),
    ];

    // The column keys (ResizableColumns, ReorderableColumns), on a focused header of any table.
