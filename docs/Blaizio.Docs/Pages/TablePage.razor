@page "/components/table"
@using Blaizio.Docs.Examples.Table
<PageTitle>Table - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Table</h1>
        <p class="text-muted-foreground">
            A responsive data table. Compose the styled primitives directly, or hand rows to
            <code class="bz-code">BzDataTable&lt;TItem&gt;</code> for sorting, search, column visibility, selection,
            pagination and virtualization - inside a fixed-height scroll box (<code class="bz-code">MaxHeight</code>)
            or, by default, against the page itself with no height restriction. For server-side data, swap
            <code class="bz-code">Items</code> for an async <code class="bz-code">ItemsProvider</code>.
        </p>
    </header>

    <UsageBlock Example="typeof(TableUsageExample)"
                Description="Add the using once, then compose the styled primitives - or hand rows to BzDataTable&lt;TItem&gt; for sorting, search and more." />

    <CompositionTree Root="Anatomy"
                     Description="The styled-primitive anatomy: a Table wraps an optional Caption, a Header of head cells, a Body of rows, and an optional Footer. BzDataTable composes these for you." />

    <ExamplesHeading />

    <Demo Title="Basic" Description="The styled primitives - Table, TableHeader, TableBody, TableRow, TableHead, TableCell, TableCaption - composed by hand." Example="typeof(TableBasicExample)" />

    <Demo Title="Data table"
          Description="BzDataTable wires the columns to sorting (click a header), search, a column-visibility menu and row selection. Define columns as BzPropertyColumn / BzTemplateColumn children - TItem cascades, so you usually only pass the property."
          Example="typeof(TableDataTableExample)" />

    <Demo Title="Columns as data"
          Description="The data-driven alternative: pass a Columns list instead of child components. SortBy makes a column sortable; Text adds it to search."
          Example="typeof(TableColumnsAsDataExample)" />

    <Demo Title="Empty state"
          Description="When the filter matches nothing, the body collapses to a single EmptyContent row (defaulting to 'No results.')."
          Example="typeof(TableEmptyExample)" />

    <Demo Title="Virtualized rows (fixed height)"
          Description="Virtualize mounts only the rows in view. Here 10,000 rows scroll inside a fixed-height box (MaxHeight) with its own scrollbar - reach the top or bottom and the page takes over. Fixed height means every row is exactly RowHeight, so placement is pure index math (fastest; best for uniform rows). Omit MaxHeight to virtualize against the page instead, with no height cap."
          Example="typeof(TableVirtualFixedExample)" />

    <Demo Title="Virtualized rows (dynamic height)"
          Description="Add DynamicRowHeight and the virtualizer measures each rendered row instead of assuming RowHeight - so rows of different heights (here, notes that wrap) place correctly. Same fixed-height scroll box, its own scrollbar; RowHeight is just the estimate used until a row is measured."
          Example="typeof(TableVirtualDynamicExample)" />

    <Demo Title="Row class"
          Description="RowClass returns a CSS class per row from its data - here suspended members are dimmed and struck through, and admins get a subtle tint. It styles the whole row, independent of the columns."
          Example="typeof(TableRowClassExample)" />

    <Demo Title="Tie-breaker sort"
          Description="A column's Sort can chain keys. This Role column sorts by Role, then by Name within each role - so equal roles stay grouped and alphabetical inside the group instead of arbitrary order. Click the Role header; the toggle flips the whole chain."
          Example="typeof(TableTieBreakerExample)" />

    <Demo Title="Pagination"
          Description="Set PageSize to page the rows instead of showing them all - a pager renders below the table, searching resets to the first page, and sorting carries across pages. An alternative to Virtualize for moderate data."
          Example="typeof(TablePaginationExample)" />

    <Demo Title="Async data (ItemsProvider)"
          Description="For server-side data, give an ItemsProvider instead of Items: it receives the page window + sort + filter and returns that page plus the total count, so sorting, search and paging all happen at the source. Here it queries 10,000 rows behind a simulated 300ms latency (watch the Loading... row); stale requests are cancelled as you click."
          Example="typeof(TableProviderExample)" />

    <Demo Title="Customization"
          Description="Restyle the primitives via Class - here the header row gets an indigo tint and white text, and the caption an indigo accent. Root utilities win over the skin, so the recolor takes effect."
          Example="typeof(TableCustomExample)" />

    <Demo Title="RTL"
          Description="Wrapped in a DirectionProvider with Arabic copy - alignment, the select column and the sort affordance all mirror."
          Example="typeof(TableRtlExample)" />

</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzTable",
        new CompositionNode("BzTableCaption"),
        new CompositionNode("BzTableHeader",
            new CompositionNode("BzTableRow",
                new CompositionNode("BzTableHead"))),
        new CompositionNode("BzTableBody",
            new CompositionNode("BzTableRow",
                new CompositionNode("BzTableCell"))),
        new CompositionNode("BzTableFooter",
            new CompositionNode("BzTableRow",
                new CompositionNode("BzTableCell"))));
}
