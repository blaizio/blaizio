@page "/docs/components/field"
@using Blaizio.Docs.Examples.Field
<PageTitle>Field - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Field</h1>
            <DocBadges Slug="field" />
        </div>
        <p>
            Layout, label, description and validation error for a form control. Inside an
            <code class="font-mono text-sm">EditForm</code> it reads validity from the form, and
            outside one you set the error yourself. If a row only displays content such as a title,
            description and actions, with no control to label, use
            <a class="hover:text-foreground" href="docs/components/item">Item</a> instead.
        </p>
    </header>

    <UsageBlock Example="typeof(FieldUsageExample)"
                Description="After importing `Blaizio.Ui`, wrap a control in a `BzField` with a label, an optional description and a slot for the error." />

    <CompositionTree Root="Anatomy"
                     Description="Every part of a field layout. Stack fields in a `BzFieldGroup` and gather related ones under a `BzFieldSet` with a `BzFieldLegend`. In horizontal layouts, `BzFieldControl` and `BzFieldContent` pair the control with its label, description and error." />

    <ExamplesHeading />

    <Demo Title="Inside an EditForm"
          Description="Inside an `EditForm`, the field reads validity from the surrounding `EditContext`, which uses DataAnnotations here. Submit without ticking the terms checkbox to see the error."
          Example="typeof(FieldEditFormExample)" />

    <Demo Title="Standalone (no EditForm)"
          Description="Without an `EditContext`, you set the error yourself. The field then switches to its destructive styling and shows the message."
          Example="typeof(FieldStandaloneExample)" />

    <Demo Title="Text inputs"
          Description="The everyday layout: a label above each control, a description or error below it, and the fields stacked in a `BzFieldGroup`."
          Example="typeof(FieldInputsExample)" />

    <Demo Title="Select & slider"
          Description="Any control works inside a field. A select gets the same label and description wiring, and a slider can show its live value in the label row."
          Example="typeof(FieldSelectSliderExample)" />

    <Demo Title="Choice cards"
          Description="Wrap a whole field in a `BzFieldLabel` to turn it into a clickable card. These use checkboxes, so several can be picked, and each card highlights from the control's `data-checked` state."
          Example="typeof(FieldChoiceCardsExample)" />

    <Demo Title="Responsive orientation"
          Description="With `Orientation` set to `Responsive`, fields stack vertically in narrow containers and move the label beside the control once the `BzFieldGroup` is wide enough. Resize the window to see it switch."
          Example="typeof(FieldResponsiveExample)" />

    <Demo Title="Field set"
          Description="`BzFieldSet` and `BzFieldLegend` group related fields, and `BzFieldSeparator` divides the sections."
          Example="typeof(FieldFieldSetExample)" />

    <Demo Title="Customization"
          Description="Every part accepts `Class`. This example wraps the field in a branded card with an emerald title and a custom error color."
          Example="typeof(FieldCustomExample)" />

    <Demo Title="RTL"
          Description="Inside a right-to-left `DirectionProvider`, legends, labels and controls all align to the right."
          Example="typeof(FieldRtlExample)" />
</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzFieldGroup",
        new CompositionNode("BzFieldSet",
            new CompositionNode("BzFieldLegend"),
            new CompositionNode("BzFieldGroup")),
        new CompositionNode("BzFieldSeparator"),
        new CompositionNode("BzField",
            new CompositionNode("BzFieldControl"),
            new CompositionNode("BzFieldContent",
                new CompositionNode("BzFieldLabel"),
                new CompositionNode("BzFieldTitle"),
                new CompositionNode("BzFieldDescription"),
                new CompositionNode("BzFieldError"))));
}
