@page "/components/field"
@using Blaizio.Docs.Examples.Field
<PageTitle>Field - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Field</h1>
        <p class="text-muted-foreground">
            Field layout, labels, descriptions, and validation errors - working both inside an
            <code class="font-mono text-sm">EditForm</code> and standalone.
        </p>
    </header>

    <UsageBlock Example="typeof(FieldUsageExample)"
                Description="Add the using once, then wrap a control in a Field with a label, an optional description, and an error slot." />

    <CompositionTree Root="Anatomy"
                     Description="The full anatomy. Stack fields in a FieldGroup, group related ones under a FieldSet/FieldLegend, and pair a control with its label, description, and error - via FieldControl/FieldContent in horizontal layouts." />

    <ExamplesHeading />

    <Demo Title="Inside an EditForm"
          Description="Validity is read from the ambient EditContext (DataAnnotations here). Submitting without accepting populates the error."
          Example="typeof(FieldEditFormExample)" />

    <Demo Title="Standalone (no EditForm)"
          Description="Drive the error yourself - the field turns destructive and the error shows, with no EditContext."
          Example="typeof(FieldStandaloneExample)" />

    <Demo Title="Text inputs"
          Description="The everyday shape: label above the control, a description (or error) below, fields stacked in a FieldGroup."
          Example="typeof(FieldInputsExample)" />

    <Demo Title="Select & slider"
          Description="Any control slots in - a Select picks up the same label/description wiring, and a Slider pairs naturally with a live value in the label row."
          Example="typeof(FieldSelectSliderExample)" />

    <Demo Title="Choice cards"
          Description="Wrap a whole Field in a FieldLabel for clickable cards - here checkboxes, so several can be picked; the card lights up off the control's data-checked state."
          Example="typeof(FieldChoiceCardsExample)" />

    <Demo Title="Responsive orientation"
          Description="Orientation Responsive lays the field out vertically in narrow containers and flips the label beside the control when the FieldGroup is wide enough - resize the window to see it."
          Example="typeof(FieldResponsiveExample)" />

    <Demo Title="Field set"
          Description="FieldSet + FieldLegend group related fields; FieldSeparator divides sections."
          Example="typeof(FieldFieldSetExample)" />

    <Demo Title="Customization"
          Description="Restyle the Field via Class - a branded card around the field, an emerald title, and a custom error color. Utilities win over the skin, so these take effect."
          Example="typeof(FieldCustomExample)" />

    <Demo Title="RTL"
          Description="Wrapped in a DirectionProvider with Arabic copy - the legends, labels, and controls all mirror to the right."
          Example="typeof(FieldRtlExample)" />
</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzFieldGroup",
        new CompositionNode("BzFieldSet",
            new CompositionNode("BzFieldLegend"),
            new CompositionNode("BzFieldGroup")),
        new CompositionNode("BzFieldSeparator"),
        new CompositionNode("BzField",
            new CompositionNode("BzFieldControl"),
            new CompositionNode("BzFieldContent",
                new CompositionNode("BzFieldLabel"),
                new CompositionNode("BzFieldTitle"),
                new CompositionNode("BzFieldDescription"),
                new CompositionNode("BzFieldError"))));
}
