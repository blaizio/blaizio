@page "/components/field"
@using System.ComponentModel.DataAnnotations
<PageTitle>Field - Blaizio بليزيو</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Field</h1>
        <p class="text-muted-foreground">
            Field layout, labels, descriptions, and validation errors - working both inside an
            <code class="font-mono text-sm">EditForm</code> and standalone.
        </p>
    </header>

    <UsageBlock Setup="@UsageSetup" Code="@UsageMarkup"
                Description="Add the using once, then wrap a control in a Field with a label, an optional description, and an error slot." />

    <CompositionTree Root="_anatomy"
                     Description="The full anatomy. Stack fields in a FieldGroup, group related ones under a FieldSet/FieldLegend, and pair a control with its label, description, and error - via FieldControl/FieldContent in horizontal layouts." />

    <ExamplesHeading />

    <Demo Title="Inside an EditForm"
          Description="Validity is read from the ambient EditContext (DataAnnotations here). Submitting without accepting populates the error."
          Code="@EditFormCode">
        <EditForm Model="@_signup" OnValidSubmit="@OnValidSubmit" OnInvalidSubmit="@(() => _submitted = false)" class="w-full max-w-sm">
            <DataAnnotationsValidator />
            <BzFieldGroup>
                <BzField Orientation="FieldOrientation.Horizontal" Name="@nameof(SignupModel.AcceptTerms)">
                    <BzFieldControl Context="ctl">
                        <BzSwitch @attributes="ctl" @bind-Checked="_signup.AcceptTerms" />
                    </BzFieldControl>
                    <BzFieldContent>
                        <BzFieldLabel>Accept terms and conditions</BzFieldLabel>
                        <BzFieldDescription>You agree to our Terms of Service and Privacy Policy.</BzFieldDescription>
                        <BzFieldError />
                    </BzFieldContent>
                </BzField>
                <BzField>
                    <BzButton Type="submit">Create account</BzButton>
                </BzField>
                @if (_submitted)
                {
                    <p class="text-sm font-medium text-emerald-600">Account created 🎉</p>
                }
            </BzFieldGroup>
        </EditForm>
    </Demo>

    <Demo Title="Standalone (no EditForm)"
          Description="Drive the error yourself - the field turns destructive and the error shows, with no EditContext."
          Code="@StandaloneCode">
        <div class="w-full max-w-sm">
            <BzField Orientation="FieldOrientation.Horizontal"
                   Error="@(_subscribe == CheckedState.Checked ? null : "Please confirm to continue.")">
                <BzFieldControl Context="ctl">
                    <BzCheckbox @attributes="ctl" @bind-Checked="_subscribe" />
                </BzFieldControl>
                <BzFieldContent>
                    <BzFieldLabel>Subscribe to the newsletter</BzFieldLabel>
                    <BzFieldError />
                </BzFieldContent>
            </BzField>
        </div>
    </Demo>

    <Demo Title="Field set"
          Description="FieldSet + FieldLegend group related fields; FieldSeparator divides sections."
          Code="@FieldSetCode">
        <div class="w-full max-w-sm">
            <BzFieldGroup>
                <BzFieldSet>
                    <BzFieldLegend>Notifications</BzFieldLegend>
                    <BzFieldDescription>How should we reach you?</BzFieldDescription>
                    <BzFieldGroup>
                        <BzField Orientation="FieldOrientation.Horizontal">
                            <BzCheckbox id="notif-email" DefaultChecked="CheckedState.Checked" />
                            <BzFieldLabel Class="!w-auto" For="notif-email">Email</BzFieldLabel>
                        </BzField>
                        <BzField Orientation="FieldOrientation.Horizontal">
                            <BzCheckbox id="notif-sms" />
                            <BzFieldLabel Class="!w-auto" For="notif-sms">SMS</BzFieldLabel>
                        </BzField>
                    </BzFieldGroup>
                </BzFieldSet>
                <BzFieldSeparator>Or</BzFieldSeparator>
                <BzField Orientation="FieldOrientation.Horizontal">
                    <BzFieldControl Context="ctl">
                        <BzSwitch @attributes="ctl" @bind-Checked="_mute" />
                    </BzFieldControl>
                    <BzFieldContent>
                        <BzFieldTitle>Mute everything</BzFieldTitle>
                        <BzFieldDescription>No notifications at all, anywhere.</BzFieldDescription>
                    </BzFieldContent>
                </BzField>
            </BzFieldGroup>
        </div>
    </Demo>

    <Demo Title="Customization"
          Description="Restyle the Field via Class - a branded card around the field, an emerald title, and a custom error color. Utilities win over the skin, so these take effect."
          Code="@CustomCode">
        <div class="w-full max-w-sm">
            <BzField Orientation="FieldOrientation.Horizontal"
                   Class="rounded-xl border border-emerald-200 bg-emerald-50/60 p-4 dark:border-emerald-900 dark:bg-emerald-950/40"
                   Error="@(_optIn ? null : "Turn this on to continue.")">
                <BzFieldControl Context="ctl">
                    <BzSwitch @attributes="ctl" @bind-Checked="_optIn" />
                </BzFieldControl>
                <BzFieldContent>
                    <BzFieldLabel Class="text-emerald-700 dark:text-emerald-300">Enable beta features</BzFieldLabel>
                    <BzFieldDescription>Get early access to in-progress work.</BzFieldDescription>
                    <BzFieldError Class="text-amber-600 dark:text-amber-400" />
                </BzFieldContent>
            </BzField>
        </div>
    </Demo>

    <Demo Title="RTL"
          Description="Wrapped in a DirectionProvider with Arabic copy - the legends, labels, and controls all mirror to the right."
          Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <div class="w-full max-w-sm">
                <BzFieldGroup>
                    <BzFieldSet>
                        <BzFieldLegend>الإشعارات</BzFieldLegend>
                        <BzFieldDescription>كيف يمكننا التواصل معك؟</BzFieldDescription>
                        <BzFieldGroup>
                            <BzField Orientation="FieldOrientation.Horizontal">
                                <BzCheckbox id="notif-email-rtl" DefaultChecked="CheckedState.Checked" />
                                <BzFieldLabel Class="!w-auto" For="notif-email-rtl">البريد الإلكتروني</BzFieldLabel>
                            </BzField>
                            <BzField Orientation="FieldOrientation.Horizontal">
                                <BzCheckbox id="notif-sms-rtl" />
                                <BzFieldLabel Class="!w-auto" For="notif-sms-rtl">الرسائل النصية</BzFieldLabel>
                            </BzField>
                        </BzFieldGroup>
                    </BzFieldSet>
                    <BzFieldSeparator>أو</BzFieldSeparator>
                    <BzField Orientation="FieldOrientation.Horizontal">
                        <BzFieldControl Context="ctl">
                            <BzSwitch @attributes="ctl" @bind-Checked="_mute" />
                        </BzFieldControl>
                        <BzFieldContent>
                            <BzFieldTitle>كتم كل شيء</BzFieldTitle>
                            <BzFieldDescription>لا إشعارات على الإطلاق، في أي مكان.</BzFieldDescription>
                        </BzFieldContent>
                    </BzField>
                </BzFieldGroup>
            </div>
        </BzDirectionProvider>
    </Demo>
</div>

@code {
    private SignupModel _signup = new();
    private bool _submitted;
    private bool _mute;
    private bool _optIn;
    private CheckedState _subscribe = CheckedState.Unchecked;

    private void OnValidSubmit() => _submitted = true;

    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode _anatomy = new CompositionNode("BzFieldGroup",
        new CompositionNode("BzFieldSet",
            new CompositionNode("BzFieldLegend"),
            new CompositionNode("BzFieldGroup")),
        new CompositionNode("BzFieldSeparator"),
        new CompositionNode("BzField",
            new CompositionNode("BzFieldControl"),
            new CompositionNode("BzFieldContent",
                new CompositionNode("BzFieldLabel"),
                new CompositionNode("BzFieldTitle"),
                new CompositionNode("BzFieldDescription"),
                new CompositionNode("BzFieldError"))));

    private const string UsageSetup = """
        @* _Imports.razor (or the top of the page) *@
        @using Blaizio.Ui
        """;

    private const string UsageMarkup = """
        <BzField Orientation="FieldOrientation.Horizontal" Error="@(_optIn ? null : "Turn this on to continue.")">
            <BzFieldControl Context="ctl">
                <BzSwitch @attributes="ctl" @bind-Checked="_optIn" />
            </BzFieldControl>
            <BzFieldContent>
                <BzFieldLabel>Enable beta features</BzFieldLabel>
                <BzFieldDescription>Get early access to in-progress work.</BzFieldDescription>
                <BzFieldError />
            </BzFieldContent>
        </BzField>

        @code { private bool _optIn; }
        """;

    private const string CustomCode = """
        <BzField Orientation="FieldOrientation.Horizontal"
               Class="rounded-xl border border-emerald-200 bg-emerald-50/60 p-4 dark:border-emerald-900 dark:bg-emerald-950/40"
               Error="@(_optIn ? null : "Turn this on to continue.")">
            <BzFieldControl Context="ctl">
                <BzSwitch @attributes="ctl" @bind-Checked="_optIn" />
            </BzFieldControl>
            <BzFieldContent>
                <BzFieldLabel Class="text-emerald-700 dark:text-emerald-300">Enable beta features</BzFieldLabel>
                <BzFieldDescription>Get early access to in-progress work.</BzFieldDescription>
                <BzFieldError Class="text-amber-600 dark:text-amber-400" />
            </BzFieldContent>
        </BzField>

        @code { private bool _optIn; }
        """;

    public class SignupModel
    {
        [Range(typeof(bool), "true", "true", ErrorMessage = "You must accept the terms to continue.")]
        public bool AcceptTerms { get; set; }
    }

    private const string EditFormCode = """
        <EditForm Model="@_signup" OnValidSubmit="@OnValidSubmit">
            <DataAnnotationsValidator />
            <BzFieldGroup>
                <BzField Orientation="FieldOrientation.Horizontal" Name="@nameof(SignupModel.AcceptTerms)">
                    <BzFieldControl Context="ctl">
                        <BzSwitch @attributes="ctl" @bind-Checked="_signup.AcceptTerms" />
                    </BzFieldControl>
                    <BzFieldContent>
                        <BzFieldLabel>Accept terms and conditions</BzFieldLabel>
                        <BzFieldDescription>You agree to our Terms of Service and Privacy Policy.</BzFieldDescription>
                        <BzFieldError />
                    </BzFieldContent>
                </BzField>
                <BzField>
                    <BzButton Type="submit">Create account</BzButton>
                </BzField>
            </BzFieldGroup>
        </EditForm>

        @code {
            private SignupModel _signup = new();

            public class SignupModel
            {
                [Range(typeof(bool), "true", "true", ErrorMessage = "You must accept the terms to continue.")]
                public bool AcceptTerms { get; set; }
            }
        }
        """;

    private const string StandaloneCode = """
        <BzField Orientation="FieldOrientation.Horizontal"
               Error="@(_subscribe == CheckedState.Checked ? null : "Please confirm to continue.")">
            <BzFieldControl Context="ctl">
                <BzCheckbox @attributes="ctl" @bind-Checked="_subscribe" />
            </BzFieldControl>
            <BzFieldContent>
                <BzFieldLabel>Subscribe to the newsletter</BzFieldLabel>
                <BzFieldError />
            </BzFieldContent>
        </BzField>

        @code { private CheckedState _subscribe = CheckedState.Unchecked; }
        """;

    private const string FieldSetCode = """
        <BzFieldGroup>
            <BzFieldSet>
                <BzFieldLegend>Notifications</BzFieldLegend>
                <BzFieldDescription>How should we reach you?</BzFieldDescription>
                <BzFieldGroup>
                    <BzField Orientation="FieldOrientation.Horizontal">
                        <BzCheckbox id="notif-email" DefaultChecked="CheckedState.Checked" />
                        <BzFieldLabel Class="!w-auto" For="notif-email">Email</BzFieldLabel>
                    </BzField>
                    <BzField Orientation="FieldOrientation.Horizontal">
                        <BzCheckbox id="notif-sms" />
                        <BzFieldLabel Class="!w-auto" For="notif-sms">SMS</BzFieldLabel>
                    </BzField>
                </BzFieldGroup>
            </BzFieldSet>
            <BzFieldSeparator>Or</BzFieldSeparator>
            <BzField Orientation="FieldOrientation.Horizontal">
                <BzFieldControl Context="ctl">
                    <BzSwitch @attributes="ctl" @bind-Checked="_mute" />
                </BzFieldControl>
                <BzFieldContent>
                    <BzFieldTitle>Mute everything</BzFieldTitle>
                    <BzFieldDescription>No notifications at all, anywhere.</BzFieldDescription>
                </BzFieldContent>
            </BzField>
        </BzFieldGroup>
        """;

    private const string RtlCode = """
        <BzDirectionProvider Direction="Direction.Rtl">
            <BzFieldGroup>
                <BzFieldSet>
                    <BzFieldLegend>الإشعارات</BzFieldLegend>
                    <BzFieldDescription>كيف يمكننا التواصل معك؟</BzFieldDescription>
                    <BzFieldGroup>
                        <BzField Orientation="FieldOrientation.Horizontal">
                            <BzCheckbox id="notif-email-rtl" DefaultChecked="CheckedState.Checked" />
                            <BzFieldLabel Class="!w-auto" For="notif-email-rtl">البريد الإلكتروني</BzFieldLabel>
                        </BzField>
                        <BzField Orientation="FieldOrientation.Horizontal">
                            <BzCheckbox id="notif-sms-rtl" />
                            <BzFieldLabel Class="!w-auto" For="notif-sms-rtl">الرسائل النصية</BzFieldLabel>
                        </BzField>
                    </BzFieldGroup>
                </BzFieldSet>
                <BzFieldSeparator>أو</BzFieldSeparator>
                <BzField Orientation="FieldOrientation.Horizontal">
                    <BzFieldControl Context="ctl">
                        <BzSwitch @attributes="ctl" @bind-Checked="_mute" />
                    </BzFieldControl>
                    <BzFieldContent>
                        <BzFieldTitle>كتم كل شيء</BzFieldTitle>
                        <BzFieldDescription>لا إشعارات على الإطلاق، في أي مكان.</BzFieldDescription>
                    </BzFieldContent>
                </BzField>
            </BzFieldGroup>
        </BzDirectionProvider>
        """;
}
