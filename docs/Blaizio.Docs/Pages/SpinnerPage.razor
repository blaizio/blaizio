@page "/docs/components/spinner"
@using Blaizio.Docs.Examples.Spinner
<PageTitle>Spinner - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Spinner</h1>
            <DocBadges Slug="spinner" />
        </div>
        <p class="text-muted-foreground">The one loading indicator - a spinning icon announced as a status to assistive tech. Drop it in buttons, input-group addons, badges, or empty states so busy looks the same everywhere.</p>
    </header>

    <UsageBlock Example="typeof(SpinnerUsageExample)" />

    <ExamplesHeading />

    <Demo Title="Size"
          Description="Size it with a size-* class - the default is size-4."
          Example="typeof(SpinnerSizeExample)" />

    <Demo Title="Color"
          Description="It inherits currentColor - tint it with a text-* class."
          Example="typeof(SpinnerColorExample)" />

    <Demo Title="Button"
          Description="Mark it with data-icon so the button tightens the padding on that edge; disable the button while busy."
          Example="typeof(SpinnerButtonExample)" />

    <Demo Title="Badge" Example="typeof(SpinnerBadgeExample)" />

    <Demo Title="Input group"
          Description="An inline-end addon while the value is being checked."
          Example="typeof(SpinnerInputGroupExample)" />

    <Demo Title="Empty"
          Description="A whole-region busy state, composed with Empty."
          Example="typeof(SpinnerEmptyExample)" />

    <Demo Title="RTL"
          Description="Wrapped in a DirectionProvider with Arabic or Hebrew copy - the data-icon edges flip to the mirrored side."
          Example="typeof(SpinnerRtlExample)" />
</div>
