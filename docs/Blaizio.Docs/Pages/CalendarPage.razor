@page "/docs/components/calendar"
@using Blaizio.Docs.Examples.Calendar
<PageTitle>Calendar - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Calendar</h1>
            <DocBadges Slug="calendar" />
        </div>
        <p>A date-grid field for picking a day, several days, or a range. Driven by <code>DateOnly</code> with full keyboard navigation (arrows, Home/End, PageUp/PageDown), month paging, optional month/year dropdowns, bounds, per-day disabling, multiple months, and locale-aware layout - the grid follows the culture's own calendar (Gregorian, Persian, Hijri).</p>
    </header>

    <UsageBlock Example="typeof(CalendarBasicExample)"
                Description="Add the using once, then two-way bind a nullable DateOnly to Value. Bind ValueFormatted to read the chosen day back as a string in the calendar's own culture." />

    <ExamplesHeading />

    <Demo Title="Basic" Description="A single-date picker. Click a day to select it; clicking it again clears it. Tab into the grid and use the arrow keys to move, Enter or Space to pick. The readout reads the bound ValueFormatted - the day in the calendar's own culture - so there's no separate formatting call." Example="typeof(CalendarBasicExample)" />

    <Demo Title="Multiple" Description="Set Mode to Multiple to toggle any number of independent days on and off, two-way bound to a list via Values. ValueFormatted is single-only, so format each day with BzCalendar.FormatValue." Example="typeof(CalendarMultipleExample)" />

    <Demo Title="Range" Description="Mode Range picks a contiguous span in two clicks - the first sets the start, the second the end; a third starts over. The days between fill in as a band. A range carries two dates, so format each edge with BzCalendar.FormatValue." Example="typeof(CalendarRangeExample)" />

    <Demo Title="Formatting the value" Description="For a single value, two-way binding ValueFormatted is the easy path - it gives the day in the calendar's own Culture with no extra call. When you need it in some OTHER culture (or for a range edge), call BzCalendar.FormatValue(date, culture) - it renders the day in that culture's own calendar with native month names and digits, exactly like the grid (so fa-IR yields the Persian year 1405, not 2026). Plain DateOnly.ToString stays on the Gregorian calendar and, on WebAssembly, romanizes non-Gregorian month names - shown here for contrast." Example="typeof(CalendarFormattingExample)" />

    <Demo Title="Month & year dropdowns" Description="CaptionLayout swaps the caption label for dropdowns so you can jump straight to a month or year - handy for far-off dates. Use Dropdown (both), DropdownMonths, or DropdownYears. The year list defaults to roughly a century back through ten years ahead." Example="typeof(CalendarDropdownExample)" />

    <Demo Title="Custom year range" Description="Set FromYear and ToYear to bound the year dropdown to your own span - here a date-of-birth picker reaching back to 1925." Example="typeof(CalendarYearRangeExample)" />

    <Demo Title="Multiple months" Description="NumberOfMonths renders several months side by side; the nav pages all of them together." Example="typeof(CalendarMonthsExample)" />

    <Demo Title="Bounds" Description="Min and Max clamp the selectable window - earlier and later days grey out and the nav stops at the edge months." Example="typeof(CalendarBoundsExample)" />

    <Demo Title="Disabled days" Description="Pass DisabledSelector to grey out and block individual days - here every weekend - while leaving the rest selectable." Example="typeof(CalendarDisabledDaysExample)" />

    <Demo Title="Hide outside days" Description="ShowOutsideDays=false drops the greyed leading/trailing days from adjacent months, leaving a ragged grid." Example="typeof(CalendarOutsideExample)" />

    <Demo Title="Date picker" Description="Drop the calendar inside a Popover to build a date-picker field: the button shows the chosen date and the popup closes on pick." Example="typeof(CalendarPickerExample)" />

    <Demo Title="Localization" Description="Pass a Culture and the month names, weekday names and first day of week follow it. Here German (de-DE) - the week starts on Monday. Read the value back by binding ValueFormatted - it follows the calendar's Culture automatically - and write the label in the same language." Example="typeof(CalendarLocalizationExample)" />

    <Demo Title="Arabic (Gregorian)" Description="Not every Arabic locale is Hijri. ar-AE keeps the Gregorian calendar but renders Arabic month and weekday names and Arabic-Indic digits, inside an RTL provider. Binding ValueFormatted renders the value to match the calendar's culture, and the label is Arabic." Example="typeof(CalendarArabicGregExample)" />

    <Demo Title="Arabic (Hijri)" Description="A culture whose calendar is non-Gregorian lays out its own months and years. Arabic (ar-SA) uses the Umm al-Qura (Hijri) calendar; inside an RTL DirectionProvider the whole grid mirrors. Binding ValueFormatted gives the Hijri year (1448), not the Gregorian one." Example="typeof(CalendarArabicExample)" />

    <Demo Title="Latin digits" Description="Numbers default to the culture's native digits (Arabic ١٢٣, Persian ۱۲۳). Set NativeDigits=false to keep Latin numerals while still using the localized calendar, month and weekday names. Binding ValueFormatted follows the calendar's NativeDigits, so the readout matches." Example="typeof(CalendarLatinDigitsExample)" />

    <Demo Title="Persian / Farsi (Jalali)" Description="Farsi (fa-IR) uses the Persian (Jalali) calendar - different months (Farvardin, Ordibehesht, ...) and a different year (1405, not 2026). The value is still a normal DateOnly; only the display changes. Binding ValueFormatted renders it in the Persian calendar, following the Culture you set." Example="typeof(CalendarPersianExample)" />

    <Demo Title="Week numbers" Description="ShowWeekNumber adds a leading column with the week-of-year for each row, in the culture's week rule." Example="typeof(CalendarWeekNumberExample)" />

    <Demo Title="Custom cell size" Description="Bigger cells make room for content under each day. Override --cell-size and supply DayContent - here a nightly price, dearer at weekends - for a booking-style calendar." Example="typeof(CalendarCellSizeExample)" />

    <Demo Title="Booked dates" Description="Mark certain days as taken with DisabledSelector, then style the disabled day slot - here a strike-through - so booked days read clearly." Example="typeof(CalendarBookedExample)" />

    <Demo Title="Presets" Description="Pair the calendar with quick-pick buttons inside the popover for a date picker with presets." Example="typeof(CalendarPresetExample)" />

    <Demo Title="Date and time" Description="Compose the calendar with the inline BzInputTime for a date-and-time picker - the two bind independently; combine them when you read the value." Example="typeof(CalendarDateTimeExample)" />

    <Demo Title="Date and time range" Description="Pair the calendar with two time pickers for a start and end time - a booking-style slot. Each binds its own TimeOnly." Example="typeof(CalendarDateTimeRangeExample)" />

    <Demo Title="Disabled" Description="Disabled greys the whole calendar and blocks selection and navigation, while still showing the current value." Example="typeof(CalendarDisabledExample)" />

    <Demo Title="Customization"
          Description="Restyle any part via Class. Here the selected day swaps the primary fill for a branded indigo by targeting the calendar-day-button slot in its data-selected-single state, and the hover fill gets a matching indigo tint. Utilities win over the skin, so it takes effect."
          Example="typeof(CalendarCustomizationExample)" />

</div>

