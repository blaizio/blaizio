@page "/docs/components/hover-card"
@using Blaizio.Docs.Examples.HoverCard
<PageTitle>Hover Card - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Hover Card</h1>
            <DocBadges Slug="hover-card" />
        </div>
        <p class="text-muted-foreground">A card that previews rich content when you hover or focus a trigger - usually a link or avatar - positioned with <a class="font-medium text-foreground underline underline-offset-4" href="https://floating-ui.com" target="_blank" rel="noopener">Floating UI</a>. It opens after a short delay and, unlike a tooltip, the card is <strong>interactive</strong>: a close delay lets you move the pointer onto it without it snapping shut. It is <strong>non-modal</strong> - the rest of the page stays interactive, and Escape or a click outside dismisses it.</p>
    </header>

    <UsageBlock Example="typeof(HoverCardUsageExample)"
                Description="Add the using once, then compose a trigger and a content card. Any element can be the trigger via RenderAs." />

    <CompositionTree Root="Anatomy"
                     Description="The full anatomy. Put the trigger and the content under one BzHoverCard root, and drop an optional BzHoverCardArrow inside the content to point back at the trigger." />

    <ExamplesHeading />

    <Demo Title="Default" Description="A profile preview behind a username link. Hover or focus the trigger; move onto the card to interact with it, or leave to dismiss it after a short delay."
          Example="typeof(HoverCardDefaultExample)" />

    <Demo Title="Custom trigger (RenderAs)" Description="Render the trigger onto your own element - here an anchor - instead of the default button, by splatting p.Attributes."
          Example="typeof(HoverCardRenderAsTriggerExample)" />

    <Demo Title="Arrow" Description="Drop an optional HoverCardArrow inside the content to point back at the trigger. It is filled with the card surface and shares the card's hairline ring and shadow, so it reads as the card's tail rather than a flat sticker - and it rotates to whichever side the card resolves to."
          Example="typeof(HoverCardArrowExample)" />

    <Demo Title="Alignment" Description="Align sets where the card sits along the trigger's edge - start, center, or end."
          Example="typeof(HoverCardAlignExample)" />

    <Demo Title="Sides" Description="Side sets the preferred edge the card opens from - left, top, bottom, or right - and it flips to the opposite side when there isn't room. Drop in an optional HoverCardArrow to point back at the trigger."
          Example="typeof(HoverCardSideExample)" />

    <Demo Title="Open &amp; close delays" Description="OpenDelay is how long the pointer must rest before the card opens; CloseDelay how long it lingers after you leave (long enough to move onto the card). One here opens instantly, the other takes its time."
          Example="typeof(HoverCardDelayExample)" />

    <Demo Title="Controlled" Description="Drive the open state with a two-way Open binding - the live state is shown above and stays in sync as you hover the trigger, move onto the card, or dismiss it."
          Example="typeof(HoverCardControlledExample)" />

    <Demo Title="Customization" Description="Restyle any part via Class - a brand-colored trigger link and a card with a custom width, radius, tint, and ring. Root-level utilities win over the skin, so these take effect."
          Example="typeof(HoverCardCustomExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic or Hebrew copy - the card anchors and aligns mirrored to the right."
          Example="typeof(HoverCardRtlExample)" />

</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzHoverCard",
        new CompositionNode("BzHoverCardTrigger"),
        new CompositionNode("BzHoverCardContent",
            new CompositionNode("BzHoverCardArrow")));
}
