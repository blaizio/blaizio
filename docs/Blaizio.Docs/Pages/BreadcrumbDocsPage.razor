@page "/docs/components/breadcrumb"
@using Blaizio.Docs.Examples.Breadcrumb
@* Class is BreadcrumbDocsPage, not the usual *Page convention, to avoid colliding with the
   Blaizio.Ui.BzBreadcrumbPage sub-component this page references by tag (both _Imports'd -> ambiguous). *@
<PageTitle>Breadcrumb - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Breadcrumb</h1>
            <DocBadges Slug="breadcrumb" />
        </div>
        <p>A navigation trail labelled for screen readers, with the current page marked by <code>aria-current</code>. The divider between steps follows the active Blaizio style, so each style draws its own glyph (a chevron, slash, dot, dash, pipe or arrow), and you can supply your own instead.</p>
    </header>

    <UsageBlock Example="typeof(BreadcrumbUsageExample)"
                Description="After importing `Blaizio.Ui`, nest a list of items with separators between them. The last step is the current page." />

    <CompositionTree Root="Anatomy"
                     Description="Every part of a breadcrumb. Each item holds a link, or a page label when it is `Active`, and separators divide the items. `BzBreadcrumbEllipsis` stands in for the hidden middle of a long trail." />

    <ExamplesHeading />

    <Demo Title="Default" Example="typeof(BreadcrumbDefaultExample)" />

    <Demo Title="Routed link (RenderAs)" Description="Use `RenderAs` to render a step as your own element instead of the default anchor. Here it is a `NavLink` that receives the provided attributes, so navigation goes through the router."
          Example="typeof(BreadcrumbRenderAsTriggerExample)" />

    <Demo Title="Current page" Description="Set `Active` on the item for the current step. It renders as a plain label with `aria-current=&quot;page&quot;` instead of a link, which is shorthand for nesting a `BzBreadcrumbPage`."
          Example="typeof(BreadcrumbCurrentExample)" />

    <Demo Title="Custom separator" Description="Any content inside `BzBreadcrumbSeparator` replaces the style's default glyph. This example uses a slash icon."
          Example="typeof(BreadcrumbCustomSeparatorExample)" />

    <Demo Title="Collapsed" Description="When a trail gets long, collapse the middle into an ellipsis. It opens a dropdown menu listing the hidden steps."
          Example="typeof(BreadcrumbCollapsedExample)" />

    <Demo Title="Routed trail" Description="Every link in the trail is a `NavLink`. Setting `Match` to `NavLinkMatch.All` on the first step stops it from matching every page beneath it."
          Example="typeof(BreadcrumbRoutedExample)" />

    <Demo Title="Customization" Description="Every part accepts `Class`. This example colors the links, tints the current page and recolors the separators."
          Example="typeof(BreadcrumbCustomExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, the trail runs from right to left and directional separators such as chevrons and arrows mirror."
          Example="typeof(BreadcrumbRtlExample)" />

</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzBreadcrumb",
        new CompositionNode("BzBreadcrumbList",
            new CompositionNode("BzBreadcrumbItem",
                new CompositionNode("BzBreadcrumbLink"),
                new CompositionNode("BzBreadcrumbPage"),
                new CompositionNode("BzBreadcrumbEllipsis")),
            new CompositionNode("BzBreadcrumbSeparator")));
}
