@page "/docs/components/breadcrumb"
@using Blaizio.Docs.Examples.Breadcrumb
@* Class is BreadcrumbDocsPage, not the usual *Page convention, to avoid colliding with the
   Blaizio.Ui.BzBreadcrumbPage sub-component this page references by tag (both _Imports'd -> ambiguous). *@
<PageTitle>Breadcrumb - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Breadcrumb</h1>
            <DocBadges Slug="breadcrumb" />
        </div>
        <p class="text-muted-foreground">Shows the path to the current page and lets you step back up the hierarchy. The divider between steps is <strong>style-aware</strong> - each Blaizio style draws its own glyph (chevron, slash, dot, dash, pipe, arrow...) - or you can supply your own.</p>
    </header>

    <UsageBlock Example="typeof(BreadcrumbUsageExample)"
                Description="Add the using once, then nest a list of items with separators between them; the last step is the current page." />

    <CompositionTree Root="Anatomy"
                     Description="The full anatomy. Items hold a link (or, when Current, a page label) and are divided by separators; collapse a long trail with an ellipsis." />

    <ExamplesHeading />

    <Demo Title="Default" Example="typeof(BreadcrumbDefaultExample)" />

    <Demo Title="Routed link (RenderAs)" Description="Render a step onto your own routed element - here a NavLink - instead of the default anchor, by splatting p.Attributes so navigation goes through the router."
          Example="typeof(BreadcrumbRenderAsTriggerExample)" />

    <Demo Title="Current page" Description="Mark the active step with Current on the item - it renders as a non-interactive label (aria-current=page), not a link. Shorthand for nesting a BreadcrumbPage."
          Example="typeof(BreadcrumbCurrentExample)" />

    <Demo Title="Custom separator" Description="Put any content inside a separator - here a slash icon - to override the style's default glyph."
          Example="typeof(BreadcrumbCustomSeparatorExample)" />

    <Demo Title="Collapsed" Description="When a trail is long, collapse the middle into an ellipsis that opens a menu of the hidden steps. Reuses the Dropdown Menu."
          Example="typeof(BreadcrumbCollapsedExample)" />

    <Demo Title="Routed links" Description="Use RenderAs to render a step onto your own routed element (here a NavLink) instead of a plain anchor - so navigation goes through the router."
          Example="typeof(BreadcrumbRoutedExample)" />

    <Demo Title="Customization" Description="Restyle any part via Class - here brand-colored links, a tinted current page, and a custom separator color. Utilities win over the skin, so these take effect."
          Example="typeof(BreadcrumbCustomExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic or Hebrew copy - the trail lays out right-to-left and any directional separator mirrors."
          Example="typeof(BreadcrumbRtlExample)" />

</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzBreadcrumb",
        new CompositionNode("BzBreadcrumbList",
            new CompositionNode("BzBreadcrumbItem",
                new CompositionNode("BzBreadcrumbLink"),
                new CompositionNode("BzBreadcrumbPage"),
                new CompositionNode("BzBreadcrumbEllipsis")),
            new CompositionNode("BzBreadcrumbSeparator")));
}
