@page "/docs/components/radio-group"
@using Blaizio.Docs.Examples.RadioGroup
<PageTitle>Radio Group - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Radio Group</h1>
            <DocBadges Slug="radio-group" />
        </div>
        <p>A single-choice group with full keyboard support: the arrow keys move between items and select them as they go, skipping disabled ones and wrapping at the ends. It works with <code>Field</code> for labels, descriptions and errors, and the same parts make selectable choice cards.</p>
    </header>

    <UsageBlock Example="typeof(RadioGroupUsageExample)"
                Description="After importing `Blaizio.Ui`, add the items and pair each one with a `Label` whose `For` matches the item id. Name the group itself with an `AriaLabel` that states the question, or point `AriaLabelledBy` at a visible heading." />

    <CompositionTree Root="Anatomy"
                     Description="The group wraps its items, and each item renders its own indicator. Pair every item with a `Label` whose `For` is the item id." />

    <ExamplesHeading />

    <Demo Title="Default" Description="The group tracks its own selection, starting from an initial value."
          Example="typeof(RadioGroupDefaultExample)" />

    <Demo Title="Disabled" Description="A disabled item is skipped by keyboard navigation."
          Example="typeof(RadioGroupDisabledExample)" />

    <Demo Title="Horizontal" Description="Set `Orientation` to horizontal to lay the items out in a row and move between them with the left and right arrow keys."
          Example="typeof(RadioGroupHorizontalExample)" />

    <Demo Title="Controlled" Description="Bind the value to a field when your page needs to read or set the selection. The text below follows it."
          Example="typeof(RadioGroupControlledExample)" />

    <Demo Title="With Field" Description="Pair each item with a `Field` to give it a label and a description. The field parts handle the layout and spacing."
          Example="typeof(RadioGroupFieldExample)" />

    <Demo Title="Choice cards" Description="Wrap the whole `Field` in a `FieldLabel` to make the card clickable. The card highlights from the item's `data-checked` state."
          Example="typeof(RadioGroupCardsExample)" />

    <Demo Title="Invalid" Description="Set `aria-invalid` on the items to show the destructive ring, and add a field error to explain why. The state clears once an option is picked."
          Example="typeof(RadioGroupInvalidExample)" />

    <Demo Title="Looping" Description="By default the arrow keys wrap from the last item back to the first. Set `Loop` to `false` to stop at the ends instead."
          Example="typeof(RadioGroupLoopExample)" />

    <Demo Title="Customization" Description="To recolor the checked state, target the item slot and override the background and border under `data-checked`."
          Example="typeof(RadioGroupCustomizationExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, the indicator, the gap and the labels all flip to the opposite side."
          Example="typeof(RadioGroupRtlExample)" />
</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzRadioGroup",
        new CompositionNode("BzRadioGroupItem"),
        new CompositionNode("BzLabel"));
}
