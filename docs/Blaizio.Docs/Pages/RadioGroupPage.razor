@page "/docs/components/radio-group"
@using Blaizio.Docs.Examples.RadioGroup
<PageTitle>Radio Group - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Radio Group</h1>
            <DocBadges Slug="radio-group" />
        </div>
        <p class="text-muted-foreground">A set of checkable buttons where only one can be selected. Arrow keys navigate and select.</p>
    </header>

    <UsageBlock Example="typeof(RadioGroupUsageExample)"
                Description="Add the using once, then compose items, pairing each with a Label whose For matches the item id. Name the group itself with AriaLabel (the question the radios answer), or AriaLabelledBy pointing at a visible heading." />

    <CompositionTree Root="Anatomy"
                     Description="A group wraps its items; each item renders an indicator. Pair every item with a Label (For = the item id)." />

    <ExamplesHeading />

    <Demo Title="Default" Description="Uncontrolled, with an initial selection."
          Example="typeof(RadioGroupDefaultExample)" />

    <Demo Title="Disabled" Description="A disabled item is skipped by keyboard navigation."
          Example="typeof(RadioGroupDisabledExample)" />

    <Demo Title="Horizontal" Description="Set Orientation to navigate with Left/Right arrows."
          Example="typeof(RadioGroupHorizontalExample)" />

    <Demo Title="Controlled" Description="Bind the value two-way; the text reflects the selection."
          Example="typeof(RadioGroupControlledExample)" />

    <Demo Title="With Field" Description="Pair each item with a Field for a label plus description - the Field parts handle the layout and gap."
          Example="typeof(RadioGroupFieldExample)" />

    <Demo Title="Choice cards" Description="Wrap the whole Field in a FieldLabel for a clickable card - the card lights up off the item's data-checked state."
          Example="typeof(RadioGroupCardsExample)" />

    <Demo Title="Invalid" Description="aria-invalid on the items drives the destructive ring; a Field error explains why. The state clears once something is picked."
          Example="typeof(RadioGroupInvalidExample)" />

    <Demo Title="Looping" Description="Arrow keys wrap from the last item back to the first by default. Set Loop to false to stop at the ends instead. Focus an item and hold the arrow key to feel the difference."
          Example="typeof(RadioGroupLoopExample)" />

    <Demo Title="Customization" Description="Recolor the checked state: target the item slot and override data-checked's background and border."
          Example="typeof(RadioGroupCustomizationExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic or Hebrew copy - the indicator, gap and labels all mirror to the right."
          Example="typeof(RadioGroupRtlExample)" />
</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzRadioGroup",
        new CompositionNode("BzRadioGroupItem"),
        new CompositionNode("BzLabel"));
}
