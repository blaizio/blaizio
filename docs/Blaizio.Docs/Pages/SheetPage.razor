@page "/docs/components/sheet"
@using Blaizio.Docs.Examples.Sheet
<PageTitle>Sheet - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Sheet</h1>
            <DocBadges Slug="sheet" />
        </div>
        <p class="text-muted-foreground">A panel that slides in from an edge of the screen. Built on the Dialog machinery: focus is trapped inside, page scroll locks, and Escape or a backdrop click dismisses it.</p>
    </header>

    <UsageBlock Example="typeof(SheetUsageExample)"
                Description="Add the using once, then compose a trigger and a content panel. Any element can be the trigger via RenderAs." />

    <CompositionTree Root="Anatomy"
                     Description="The full anatomy. Wrap the header and footer around the body; BzSheetClose dismisses the panel from inside." />

    <ExamplesHeading />

    <Demo Title="Default" Description="Slides in from the right by default." Example="typeof(SheetDefaultExample)" />

    <Demo Title="Custom trigger element (RenderAs)"
          Description="When you need the trigger to be something other than a button - a link, a card, your own component - use RenderAs and splat the behaviour onto your element."
          Example="typeof(SheetRenderAsTriggerExample)" />

    <Demo Title="Sides" Description="Anchor the sheet to any edge with Side." Example="typeof(SheetSidesExample)" />

    <Demo Title="Controlled" Description="Bind the open state two-way." Example="typeof(SheetControlledExample)" />

    <Demo Title="Scrollable content" Description="A sheet taller than the viewport scrolls its body while the header and footer stay put." Example="typeof(SheetScrollableExample)" />

    <Demo Title="Non-dismissible" Description="DismissOnOutsideClick=false pins the sheet: Escape and the backdrop do nothing and the corner close button is hidden. Only an explicit SheetClose (or your code) closes it - useful mid-task." Example="typeof(SheetLockedExample)" />

    <Demo Title="Async content" Description="No service is needed to load content on open - render a loading state from your own flag. Handle OpenChanged, start the fetch, show skeletons, then swap in the content." Example="typeof(SheetAsyncExample)" />

    <Demo Title="Customization"
          Description="Restyle any part via Class, and the backdrop via OverlayClass. Here: a brand-indigo trigger, a tinted content surface with an accented inline-start border, and an indigo-blurred backdrop. Root-level utilities win over the skin, so these take effect." Example="typeof(SheetCustomExample)" />

    <Demo Title="RTL" Description="Side is logical (inline start/end), so it mirrors under a DirectionProvider. This default (Right = inline-end) sheet therefore opens on the LEFT in RTL, and the content flows right-to-left." Example="typeof(SheetRtlExample)" />
</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzSheet",
        new CompositionNode("BzSheetTrigger"),
        new CompositionNode("BzSheetContent",
            new CompositionNode("BzSheetHeader",
                new CompositionNode("BzSheetTitle"),
                new CompositionNode("BzSheetDescription")),
            new CompositionNode("BzSheetFooter",
                new CompositionNode("BzSheetClose"))));
}
