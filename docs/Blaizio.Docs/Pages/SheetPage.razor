@page "/docs/components/sheet"
@using Blaizio.Docs.Examples.Sheet
<PageTitle>Sheet - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Sheet</h1>
            <DocBadges Slug="sheet" />
        </div>
        <p>A modal panel that slides in from any edge of the screen. It shares the dialog's behavior, so focus is trapped inside, the page stops scrolling, and Escape or a backdrop click dismisses it. When the rest of the page should stay interactive, use the <a href="docs/components/panel">Panel</a> instead.</p>
    </header>

    <UsageBlock Example="typeof(SheetUsageExample)"
                Description="After importing `Blaizio.Ui`, a trigger and a content panel are all you need. With `RenderAs`, any element can be the trigger." />

    <CompositionTree Root="Anatomy"
                     Description="Every part of a sheet. The header and footer frame the body, and `BzSheetClose` dismisses the sheet from inside." />

    <ExamplesHeading />

    <Demo Title="Default" Description="The sheet slides in from the inline end, which is the right edge in left-to-right layouts." Example="typeof(SheetDefaultExample)" />

    <Demo Title="Custom trigger element (RenderAs)"
          Description="If the trigger should be a link, a card or one of your own components, use `RenderAs` and apply the attributes it provides to that element."
          Example="typeof(SheetRenderAsTriggerExample)" />

    <Demo Title="Sides" Description="`Side` anchors the sheet to any edge of the screen." Example="typeof(SheetSidesExample)" />

    <Demo Title="Controlled" Description="Bind the open state to a field when other code needs to open or close the sheet." Example="typeof(SheetControlledExample)" />

    <Demo Title="Scrollable content" Description="When the content is taller than the viewport, the body scrolls while the header and footer stay in place." Example="typeof(SheetScrollableExample)" />

    <Demo Title="Non-dismissible" Description="Set `DismissOnOutsideClick` to `false` when the user must finish or cancel a task. Escape and backdrop clicks are ignored and the corner close button is hidden, so only a `BzSheetClose` or your own code can close it." Example="typeof(SheetLockedExample)" />

    <Demo Title="Async content" Description="To load content when the sheet opens, handle `OpenChanged`, start the fetch and show skeletons from your own loading flag until the data arrives. No service is needed." Example="typeof(SheetAsyncExample)" />

    <Demo Title="Via the dialog service"
          Description="When a sheet opens from C#, such as from a grid row or a command, `ShowSheetAsync` shows a service dialog as a sheet with no markup on the page. Pass a component or a template, pick the edge and await the result, just like any other dialog service call."
          Example="typeof(SheetServiceExample)" />

    <Demo Title="Customization"
          Description="Every part accepts `Class`, and the backdrop takes `OverlayClass`. This example uses an indigo trigger, a tinted surface with an accent border on its inline-start edge, and a blurred indigo backdrop." Example="typeof(SheetCustomExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, `Side` mirrors because it is logical. The default `End` sheet opens from the left edge, and its content flows from right to left." Example="typeof(SheetRtlExample)" />
</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzSheet",
        new CompositionNode("BzSheetTrigger"),
        new CompositionNode("BzSheetContent",
            new CompositionNode("BzSheetHeader",
                new CompositionNode("BzSheetTitle"),
                new CompositionNode("BzSheetDescription")),
            new CompositionNode("BzSheetFooter",
                new CompositionNode("BzSheetClose"))));
}
