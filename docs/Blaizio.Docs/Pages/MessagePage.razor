@page "/docs/components/message"
@using Blaizio.Docs.Examples.Message
<PageTitle>Message - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Message</h1>
            <DocBadges Slug="message" />
        </div>
        <p>One turn of a conversation: an avatar beside a column of header, bubbles and footer. It is the layout shell around Bubble for chat and AI interfaces, and setting <code>Align</code> to <code>End</code> moves the whole turn to the current user's side.</p>
    </header>

    <UsageBlock Example="typeof(MessageUsageExample)" />

    <CompositionTree Root="Anatomy"
                     Description="Avatar, header and footer are optional. The avatar anchors to the bottom and lifts clear of a footer, and `BzMessageGroup` stacks consecutive turns from one sender." />

    <ExamplesHeading />

    <Demo Title="Alignment"
          Description="`MessageAlign.End` flips the row and puts the content on the current user's side. Bubbles inside follow automatically."
          Example="typeof(MessageAlignExample)" />

    <Demo Title="Header and footer"
          Description="The header carries the sender and time above the bubbles. The footer carries delivery state below them and follows the message's side."
          Example="typeof(MessageHeaderFooterExample)" />

    <Demo Title="Group"
          Description="`BzMessageGroup` stacks whole turns from one sender. The first message carries the avatar and header, and the rest keep an empty `BzMessageAvatar` as a spacer so the bubbles stay aligned."
          Example="typeof(MessageGroupExample)" />

    <Demo Title="Actions"
          Description="The footer holds icon actions such as copy, retry and feedback. Each is a ghost icon button with an `aria-label`."
          Example="typeof(MessageActionsExample)" />

    <Demo Title="Attachments"
          Description="A turn can hold rich content. Here an image bubble uses `p-0` in `Class` so the image fills to the radius, and a `BzAttachment` file card sits in the content column."
          Example="typeof(MessageAttachmentExample)" />

    <Demo Title="AI chat"
          Description="An assistant turn with a tinted icon avatar, a `BzMarker` for tool activity, a `Ghost` bubble for the prose and labeled icon actions in the footer."
          Example="typeof(MessageAiChatExample)" />

    <Demo Title="Typeset prose"
          Description="A wrapper with the `typeset` and `typeset-chat` classes styles rendered markdown inside the ghost bubble. Paragraphs, lists, inline code and code blocks need no classes of their own, and the prose inherits the bubble's type scale. See the Typeset guide for the stylesheet."
          Example="typeof(MessageTypesetExample)" />

    <Demo Title="RTL"
          Description="Inside a right-to-left `DirectionProvider`, the avatar, alignment and footers swap to the opposite side."
          Example="typeof(MessageRtlExample)" />
</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzMessage",
        new CompositionNode("BzMessageAvatar"),
        new CompositionNode("BzMessageContent",
            new CompositionNode("BzMessageHeader"),
            new CompositionNode("BzBubble"),
            new CompositionNode("BzMessageFooter")));
}
