@page "/components/sidebar"
@using Blaizio.Docs.Examples.Sidebar
<PageTitle>Sidebar - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Sidebar</h1>
        <p class="text-muted-foreground">A composable application sidebar. Wrap your layout in a BzSidebarProvider, then build the panel from a header, scrollable content (groups and menus), and a footer. It collapses to an icon rail or slides off-canvas, becomes a Sheet on mobile, persists its state to a cookie, and toggles with Ctrl/Cmd+B.</p>
    </header>

    <UsageBlock Example="typeof(SidebarUsageExample)"
                Description="Wrap the page in a BzSidebarProvider, put a BzSidebar (header / content / footer) beside a BzSidebarInset, and drop a BzSidebarTrigger in the inset to toggle it." />

    <CompositionTree Root="Anatomy"
                     Description="The provider owns the state; the sidebar holds a header, a scrollable content area of groups and menus, and a footer; the inset is the page beside it." />

    <ExamplesHeading />

    <Demo Title="Default" Description="An off-canvas sidebar: the trigger (or Ctrl/Cmd+B) collapses it fully off the edge and the inset reclaims the space. Click a row to make it the active page. The demos are framed in a contained box; in your app the provider wraps the whole screen." Example="typeof(SidebarDefaultExample)" />

    <Demo Title="Collapse to icons" Description="With Collapsible=Icon the sidebar shrinks to a narrow rail of icons instead of vanishing - labels hide, rows become square, and each row reveals its label as a tooltip on hover (set Tooltip on the menu button). Toggle it to see the rail." Example="typeof(SidebarIconExample)" />

    <Demo Title="Variants" Description="Three surfaces. Sidebar is flush to the edge; Floating detaches into a rounded, bordered card; Inset pairs a flush sidebar with a lifted content card (collapse to icons here too)." Example="typeof(SidebarVariantsExample)" />

    <Demo Title="Submenus, actions and badges" Description="Nest a BzSidebarMenuSub under a row for child links, pin a BzSidebarMenuBadge (e.g. a count) to a row, and add a BzSidebarMenuAction for a trailing button. A group can carry a BzSidebarGroupAction in its corner." Example="typeof(SidebarRichExample)" />

    <Demo Title="Loading state" Description="Render a stack of BzSidebarMenuSkeleton while the menu data loads - each gets a randomised text width so the placeholder reads naturally. Set ShowIcon for a leading icon block." Example="typeof(SidebarSkeletonExample)" />

    <Demo Title="End side" Description="Anchor the sidebar to the inline-end edge with Side=End - the panel, its border and its collapse direction all flip to the other side." Example="typeof(SidebarEndExample)" />

    <Demo Title="Controlled" Description="Bind the open state two-way to drive the sidebar from your own state, or read it. The keyboard shortcut and the trigger update the same value." Example="typeof(SidebarControlledExample)" />

    <Demo Title="Customization" Description="The whole surface is themable: set the panel width on the provider, and restyle any part via Class - here a branded gradient header and an indigo active row - merged over the defaults." Example="typeof(SidebarCustomExample)" />

    <Demo Title="RTL" Description="Side is logical (Start/End), so under a right-to-left DirectionProvider a Start sidebar mirrors to the right edge and the content flows right-to-left - no extra configuration." Example="typeof(SidebarRtlExample)" />

</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzSidebarProvider",
        new CompositionNode("BzSidebar",
            new CompositionNode("BzSidebarHeader"),
            new CompositionNode("BzSidebarContent",
                new CompositionNode("BzSidebarGroup",
                    new CompositionNode("BzSidebarGroupLabel"),
                    new CompositionNode("BzSidebarGroupContent",
                        new CompositionNode("BzSidebarMenu",
                            new CompositionNode("BzSidebarMenuItem",
                                new CompositionNode("BzSidebarMenuButton")))))),
            new CompositionNode("BzSidebarFooter"),
            new CompositionNode("BzSidebarRail")),
        new CompositionNode("BzSidebarInset",
            new CompositionNode("BzSidebarTrigger")));
}
