@page "/docs/components/sidebar"
@using Blaizio.Docs.Examples.Sidebar
<PageTitle>Sidebar - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Sidebar</h1>
            <DocBadges Slug="sidebar" />
        </div>
        <p>An application shell sidebar built from small parts: a provider that owns the open state, the panel itself, and an inset for the page beside it. On desktop it collapses off-canvas or down to an icon rail, and below the mobile breakpoint it becomes a sheet instead. Ctrl+B (Cmd+B on a Mac) toggles it from anywhere, and when you leave the state unbound the provider remembers it in a cookie, so the sidebar comes back the way the user left it.</p>
    </header>

    <UsageBlock Example="typeof(SidebarUsageExample)"
                Description="Wrap the page in a `BzSidebarProvider`, then place a `BzSidebar` beside a `BzSidebarInset`. A `BzSidebarTrigger` in the inset toggles the panel." />

    <CompositionTree Root="Anatomy"
                     Description="The provider owns the open state. The sidebar holds a header, a scrollable content area of groups and menus, and a footer, while the inset is the page next to it." />

    <ExamplesHeading />

    <Demo Title="Default" Description="A complete shell with a logo, a navigation group, a footer user menu and a content surface. The trigger or Ctrl/Cmd+B slides the sidebar off-canvas and the inset takes back the space. These demos sit in a framed box, while in your app the provider wraps the whole screen." Example="typeof(SidebarDefaultExample)" />

    <Demo Title="Collapse to icons" Description="Set `CollapseMode` to `SidebarCollapsible.Icon` and the sidebar shrinks to a rail of icons instead of disappearing. Labels hide and rows turn square, and a row with `Tooltip` set on its menu button shows its label on hover." Example="typeof(SidebarIconExample)" />

    <Demo Title="Trigger in the sidebar header" Description="A `BzSidebarTrigger` works anywhere under the provider, including the sidebar's own header. Here it sits next to the logo and hides when the sidebar collapses to the rail, where a click on the logo expands it again." Example="typeof(SidebarHeaderTriggerExample)" />

    <Demo Title="Variants" Description="`Variant` picks the surface, one per tab. `Sidebar` sits flush against the edge, `Floating` detaches into a rounded, bordered card, and `Inset` pairs a flush sidebar with the page content lifted into a card." Example="typeof(SidebarVariantsExample)" />

    <Demo Title="Submenus, actions and badges" Description="Nest a `BzSidebarMenuSub` under a row for child links, add a `BzSidebarMenuBadge` for a count, and use `BzSidebarMenuAction` for a trailing button. A whole group can also carry a `BzSidebarGroupAction` in its corner." Example="typeof(SidebarRichExample)" />

    <Demo Title="Collapsible sections" Description="Wrap a menu row in a `BzCollapsible` and use `RenderAs` to make the menu button its trigger, so the row expands and collapses a nested `BzSidebarMenuSub`. The chevron rotates with the open state." Example="typeof(SidebarCollapsibleExample)" />

    <Demo Title="User menu" Description="The footer user row opens a `BzDropdownMenu`. `RenderAs` applies the menu trigger's attributes to the `BzSidebarMenuButton`, and `data-state` lets you style the row while the menu is open." Example="typeof(SidebarUserMenuExample)" />

    <Demo Title="Loading state" Description="Render a stack of `BzSidebarMenuSkeleton` while the menu data loads. Each one picks a random text width so the placeholder looks like real labels, and `ShowIcon` adds a leading icon block." Example="typeof(SidebarSkeletonExample)" />

    <Demo Title="End side" Description="Set `Side` to `End` to anchor the sidebar to the inline-end edge. The panel, its border and its collapse direction all move to that side, and here the trigger's `ChildContent` swaps in a matching arrow." Example="typeof(SidebarEndExample)" />

    <Demo Title="Controlled" Description="Bind `Open` on the provider when your own code needs to read or set the state. The keyboard shortcut and the trigger update the same value." Example="typeof(SidebarControlledExample)" />

    <Demo Title="Customization" Description="Every part accepts `Class`, merged over the defaults, and the provider sets the panel `Width`. This example adds a gradient header and an indigo active row." Example="typeof(SidebarCustomExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, a `Start` sidebar moves to the right edge and its contents flow right to left, because `Side` is logical rather than physical." Example="typeof(SidebarRtlExample)" />

</div>

@code {
    private static readonly CompositionNode Anatomy = new("BzSidebarProvider",
        new CompositionNode("BzSidebar",
            new CompositionNode("BzSidebarHeader"),
            new CompositionNode("BzSidebarContent",
                new CompositionNode("BzSidebarGroup",
                    new CompositionNode("BzSidebarGroupLabel"),
                    new CompositionNode("BzSidebarGroupContent",
                        new CompositionNode("BzSidebarMenu",
                            new CompositionNode("BzSidebarMenuItem",
                                new CompositionNode("BzSidebarMenuButton")))))),
            new CompositionNode("BzSidebarFooter"),
            new CompositionNode("BzSidebarRail")),
        new CompositionNode("BzSidebarInset",
            new CompositionNode("BzSidebarTrigger")));
}
