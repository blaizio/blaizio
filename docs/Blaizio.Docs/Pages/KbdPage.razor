@page "/docs/components/kbd"
@using Blaizio.Docs.Examples.Kbd
<PageTitle>Kbd - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Kbd</h1>
            <DocBadges Slug="kbd" />
        </div>
        <p class="text-muted-foreground">Keyboard-key chips, for shortcuts and hints.</p>
    </header>

    <UsageBlock Example="typeof(KbdUsageExample)" />

    <ExamplesHeading />

    <Demo Title="Default" Example="typeof(KbdDefaultExample)" />

    <Demo Title="Group" Description="A KbdGroup rows up several shortcuts - here alternative combos side by side."
          Example="typeof(KbdGroupExample)" />

    <Demo Title="Platform-aware"
          Description="Key renders the combo in the visitor's convention - ⌘⇧K on macOS, Ctrl+Shift+K elsewhere ('mod' is the platform primary modifier)."
          Example="typeof(KbdPlatformExample)" />

    <Demo Title="Bound"
          Description="With OnTrigger the chip is live: pressing the combo anywhere on the page fires the callback."
          Example="typeof(KbdBoundExample)" />

    <Demo Title="In a button" Description="Drop a Kbd after the label to advertise the shortcut on the button itself."
          Example="typeof(KbdButtonExample)" />

    <Demo Title="In a tooltip" Description="Kbd restyles itself inside a TooltipContent, so the hint and its shortcut read as one."
          Example="typeof(KbdTooltipExample)" />

    <Demo Title="In an input group" Description="A Kbd in a trailing addon hints at the shortcut that focuses the field."
          Example="typeof(KbdInputGroupExample)" />

    <Demo Title="Customization"
          Description="The chip is a single element, so root utilities apply directly - recolor and reshape the key with bg-*, text-*, border-* and rounded-* on Class."
          Example="typeof(KbdCustomExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic or Hebrew copy - the chip stays in its key convention while the sentence flows right-to-left."
          Example="typeof(KbdRtlExample)" />
</div>

