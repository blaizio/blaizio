@page "/docs/components/kbd"
@using Blaizio.Docs.Examples.Kbd
<PageTitle>Kbd - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Kbd</h1>
            <DocBadges Slug="kbd" />
        </div>
        <p>Keyboard key chips for shortcuts and hints. Pass <code>Key</code> and the chip writes the combination in the visitor's platform convention, then add <code>OnTrigger</code> to make the shortcut work anywhere on the page.</p>
    </header>

    <UsageBlock Example="typeof(KbdUsageExample)" />

    <ExamplesHeading />

    <Demo Title="Default" Example="typeof(KbdDefaultExample)" />

    <Demo Title="Group" Description="`BzKbdGroup` lines up several keys in one row. Here it shows alternative combinations side by side."
          Example="typeof(KbdGroupExample)" />

    <Demo Title="Platform-aware"
          Description="`Key` renders the combination in the visitor's convention: ⌘⇧K on macOS and Ctrl+Shift+K elsewhere. Write `mod` for the platform's primary modifier."
          Example="typeof(KbdPlatformExample)" />

    <Demo Title="Bound"
          Description="With `OnTrigger` set, pressing the combination anywhere on the page fires the callback."
          Example="typeof(KbdBoundExample)" />

    <Demo Title="In a button" Description="Place a `BzKbd` after the label to show the shortcut on the button itself."
          Example="typeof(KbdButtonExample)" />

    <Demo Title="In a tooltip" Description="Inside a `BzTooltipContent` the chip restyles itself, so the hint and its shortcut read as one."
          Example="typeof(KbdTooltipExample)" />

    <Demo Title="In an input group" Description="A `BzKbd` in a trailing addon hints at the shortcut that focuses the field."
          Example="typeof(KbdInputGroupExample)" />

    <Demo Title="Customization"
          Description="The chip is a single element, so `bg-*`, `text-*`, `border-*` and `rounded-*` utilities on `Class` recolor and reshape it directly."
          Example="typeof(KbdCustomExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, the sentence flows from right to left while each chip keeps its key order."
          Example="typeof(KbdRtlExample)" />
</div>

