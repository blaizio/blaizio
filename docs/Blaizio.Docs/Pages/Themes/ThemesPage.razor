@page "/themes"
@layout Blaizio.Docs.Layout.ComposerLayout
@implements IAsyncDisposable
@inject IDocsJs Js
@inject IDialogService Dialogs
@inject IToastService Toasts
@inject NavigationManager Nav
@inject ThemeComposerState State
@inject ThemeApplier Applier

<PageTitle>Themes - Blaizio</PageTitle>

@*
    The theme composer: pick a style (skin), a color preset, a chart palette, fonts and a radius
    scale, and watch every real component on the canvas re-skin live - the knobs write the same
    html classes / localStorage the rest of the site uses (theme.ts), so the choice follows you
    around the docs and survives reloads. Mode and direction live in the site header. Every
    selection round-trips through a compact preset code (PresetCode, shared with the CLI) that
    lives in the ?preset= query string, the rail's copy button and the Open Preset dialog.

    The rail Menu (and the matching global hotkeys wired below) drives the meta actions: Navigate
    (a command palette over the docs), Open Preset, Shuffle, Undo/Redo over the selection history,
    and Reset (a confirm dialog back to defaults).

    The canvas is paged (ThemesPreview's floating pager) and only ever scrolls vertically inside
    its own container - never horizontally, and never the document itself.
*@
@* The dock is a bottom bar FIXED to the viewport on EVERY breakpoint (never rides the page
   scroll) - the canvas takes the full width above it and gets matching bottom padding so nothing
   hides behind the bar. *@
<div class="flex flex-col md:h-[calc(100svh-3.5rem)]">
    @* relative makes this the containing block for every absolutely-positioned descendant
       (sr-only inputs, calendar nav buttons) - without it their containing block chain skips this
       scroller and they spill document-level overflow: a SECOND horizontal/vertical scrollbar on
       the page itself. *@
    @* overflow-x-clip: setting overflow-y alone silently computes overflow-x to auto, and a
       transient masonry reflow mid-resize then grows a horizontal scrollbar on the canvas. *@
    <div class="scrollbar-thin relative min-w-0 flex-1 overflow-x-clip pb-40 md:min-h-0 md:overflow-y-auto">
        <ThemesPreview />
    </div>

    @* The upward shadow (plus the border) separates the dock plane from the canvas scrolling
       underneath it - the border alone disappears against busy preview content. A black shadow
       is invisible on a dark page, so dark mode separates by ELEVATION instead: the dock sits on
       the lighter card surface with a brighter hairline. *@
    @* Same single-row arrangement at every width - the row scrolls horizontally when it does not fit. *@
    @* The dock slides up from the bottom edge on load, so the page reads as canvas-first and the
       bar arrives as the control surface. motion-safe only: reduced-motion users get it in place.
       The duration outruns the canvas' own fade so the two do not land together. *@
    <aside class="fixed inset-x-0 bottom-0 z-30 border-t border-border bg-background/95 p-3 backdrop-blur
                  shadow-[0_-12px_32px_-16px_rgb(0_0_0/0.4)]
                  dark:border-foreground/15 dark:bg-card/95 dark:shadow-none
                  motion-safe:animate-in motion-safe:slide-in-from-bottom-8 motion-safe:fade-in
                  motion-safe:duration-500 motion-safe:ease-out">
        <ThemesRail Style="@EffStyle" Preset="@EffPreset" Chart="@EffChart" Heading="@EffHeading"
                    Font="@EffFont" Radius="@EffRadius" Code="@Code"
                    CanUndo="@State.CanUndo" CanRedo="@State.CanRedo"
                    Locks="State.Locks" ToggleLock="State.ToggleLock"
                    Overrides="State.TokenOverrides"
                    TokenValues="_tokenValues"
                    TokenContext="GetTokenContextAsync"
                    TokenChanged="OnTokenChangedAsync"
                    TokenCleared="OnTokenClearedAsync"
                    StyleChanged="SetStyleAsync"
                    PresetChanged="SetPresetAsync"
                    ChartChanged="SetChartAsync"
                    HeadingChanged="SetHeadingAsync"
                    FontChanged="SetFontAsync"
                    RadiusChanged="SetRadiusAsync"
                    Preview="PreviewAsync"
                    Navigate="OpenNavigateAsync"
                    OpenPreset="OpenPresetAsync"
                    Shuffle="ShuffleAsync"
                    Undo="UndoAsync"
                    Redo="RedoAsync"
                    Reset="ResetAsync"
                    GetCode="OpenGetCodeAsync"
                    CopyCode="CopyCodeAsync" />
    </aside>
</div>

@* The component palette behind "Search components..." (C): jump straight to any component's docs.
   Wrapped in a boxless pin ancestor so the palette keeps the default look on any skin;
   data-bz-portal-frame keeps that pin across the dialog's body portal. *@
<div class="bz-theme-base contents" data-bz-portal-frame="bz-theme-base">
<BzCommandDialog @bind-Open="_navOpen" Description="Jump to a component.">
    <BzCommandInput Placeholder="Search components..." />
    <BzCommandList>
        <BzCommandEmpty>No components found.</BzCommandEmpty>
        <BzCommandGroup Heading="Components">
            @foreach (var c in DocsNav.Components)
            {
                <BzCommandItem Value="@c.Label" OnSelect="@(_ => GoAsync(c.DocHref))">
                    <BzIcon Icon="@Icons.Outline.Components" /><span>@c.Label</span>
                </BzCommandItem>
            }
        </BzCommandGroup>
    </BzCommandList>
</BzCommandDialog>
</div>

@* Renderless global hotkeys - the Menu shortcuts, live anywhere on the page. Bare keys (c/o/s/r)
   are suppressed while typing by hotkeys.ts; the modified combos fire everywhere. *@
<BaseHotkey Combo="c" OnTrigger="OpenNavigateAsync" />
<BaseHotkey Combo="o" OnTrigger="OpenPresetAsync" />
<BaseHotkey Combo="s" OnTrigger="ShuffleAsync" />
<BaseHotkey Combo="mod+z" OnTrigger="UndoAsync" />
<BaseHotkey Combo="mod+shift+z" OnTrigger="RedoAsync" />
<BaseHotkey Combo="r" OnTrigger="ResetAsync" />

@code {
    // Selection, locks and undo/redo live in the scoped ThemeComposerState; document writes live
    // in ThemeApplier (theme.ts via IDocsJs) and the ?preset= contract in PresetUrl. This page is
    // the coordinator: every mutation flows RecordHistory -> Applier -> SyncUrl, so history and
    // the URL can never record different selections.
    private bool _navOpen;

    // The mode the open token popover edits - captured when its context is fetched, so a mid-edit
    // header mode flip can't write a light pick into the dark block.
    private bool _editIsDark;

    // The dock's swatch fills: it is pinned to the base look, so var(--token) inside it resolves
    // to the WRONG palette - the real computed values are read here after every document write.
    private Dictionary<string, string> _tokenValues = [];

    /// <summary>Re-read every token's live computed value for the dock's swatches.</summary>
    private async Task RefreshTokenValuesAsync()
    {
        try { _tokenValues = await Js.GetTokenValuesAsync(ThemeTokens.All); }
        catch (JSDisconnectedException) { }
    }

    [CascadingParameter] private Blaizio.Docs.Layout.ComposerLayout Shell { get; set; } = default!;

    private string Code => PresetCode.Encode(State.Selection);

    protected override void OnInitialized()
    {
        // The direction knob lives in the header; track it so the code's `r` suffix stays live.
        Shell.DirectionUpdated += OnShellDirectionUpdated;
        // And the reverse: a direction the applier writes (undo, deep link) syncs the shell.
        Applier.DirectionApplied = rtl => Shell.SetDirection(rtl ? Direction.Rtl : Direction.Ltr);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        State.Rtl = await Js.GetDirAsync() == "rtl";

        // Load every catalogue webfont in one combined css2 request so the rail's font dropdowns
        // preview real faces. Cheap: the stylesheet is small and the browser only fetches the
        // font files whose families actually render (i.e. when a dropdown opens).
        if (FontCatalog.CssUrl([.. FontCatalog.All.Select(f => f.Name)]) is { } allFonts)
            await Js.LoadWebFontAsync(allFonts);

        // A shared ?preset= link wins; otherwise a fresh visit always starts from the default
        // look - a selection lingering from a previous session would silently skew every color
        // and font the composer previews. Direction stays as persisted: it is a site preference,
        // not a composer knob. Neither seeding path records history.
        if (PresetUrl.TryReadCode(Nav, out var shared))
        {
            State.Seeded = true;
            await WriteAllAsync(shared);
        }
        else
        {
            State.Seeded = true;
            await WriteAllAsync(new PresetSelection("ember", "nova", Rtl: State.Rtl));
        }
        StateHasChanged();
    }

    private void OnShellDirectionUpdated(Direction dir)
    {
        var rtl = dir == Direction.Rtl;
        if (State.Rtl == rtl) return;
        // A direction flip from the header is a user action - make it undoable too.
        State.RecordHistory();
        State.Rtl = rtl;
        SyncUrl();
        StateHasChanged();
    }

    /// <summary>Reflect the current selection into ?preset= (the contract lives in PresetUrl).</summary>
    private void SyncUrl()
    {
        if (State.Seeded) PresetUrl.Sync(Nav, Code);
    }

    // ---- History (the stacks live in ThemeComposerState; this page applies what they pop) ----

    private async Task UndoAsync()
    {
        if (!State.TryUndo(out var previous)) return;
        await WriteAllAsync(previous);
        StateHasChanged();
    }

    private async Task RedoAsync()
    {
        if (!State.TryRedo(out var next)) return;
        await WriteAllAsync(next);
        StateHasChanged();
    }

    // ---- Document writes (ThemeApplier owns them; the page adds URL sync on top) ----

    // The live hover preview, mirrored into the dock's knob labels: the document writes happen in
    // ThemeApplier, and these effective values keep the rows honest about what the canvas shows.
    private string? _previewKnob;
    private string? _previewValue;

    private string EffStyle => _previewKnob == "style" && _previewValue is { } v ? v : State.Style;
    private string EffPreset => _previewKnob == "preset" && _previewValue is { } v ? v : State.Preset;
    private string EffRadius => _previewKnob == "radius" && _previewValue is { } v ? v : State.Radius;
    private string EffChart =>
        _previewKnob == "chart" && _previewValue is { } v ? v
        : PreviewedPairing is { } e && !State.Locks.Contains("chart") ? e.PairedChart : State.Chart;
    private string EffHeading =>
        _previewKnob == "heading" && _previewValue is { } v ? v
        : PreviewedPairing is { } e && !State.Locks.Contains("heading") ? e.PairedHeading : State.Heading;
    private string EffFont =>
        _previewKnob == "font" && _previewValue is { } v ? v
        : PreviewedPairing is { } e && !State.Locks.Contains("font") ? e.PairedFont : State.Font;

    /// <summary>A hovered theme previews its whole pairing - the display follows the same rule.</summary>
    private PresetEntry? PreviewedPairing =>
        _previewKnob == "preset" && _previewValue is { } name ? Presets.Find(name) : null;

    private async Task PreviewAsync((string Knob, string? Value) p)
    {
        (_previewKnob, _previewValue) = p.Value is null ? (null, null) : (p.Knob, p.Value);
        await Applier.PreviewAsync(p);
        await RefreshTokenValuesAsync();
        StateHasChanged();
    }

    /// <summary>Write a whole selection (undo/redo, open-preset, deep link, reset). Never records.</summary>
    private async Task WriteAllAsync(PresetSelection s)
    {
        await Applier.WriteAllAsync(s);
        await RefreshTokenValuesAsync();
        SyncUrl();
    }

    // ---- Rail knob handlers (each one user action = one history entry) ----

    private async Task SetStyleAsync(string v) { State.RecordHistory(); await Applier.ApplyStyleAsync(v); SyncUrl(); }

    // A theme is a complete look: picking one also applies its designed companions (paired
    // heading/body face and chart series) into every knob the user hasn't locked, and clears any
    // direct token edits - the theme is a fresh curated starting point, not a layer under stale
    // overrides. One history entry: Undo reverts all of it together.
    private async Task SetPresetAsync(string v)
    {
        State.RecordHistory();
        await Applier.ApplyPresetAsync(v);
        await Applier.ApplyOverridesAsync([]);
        if (Presets.Find(v) is { } entry)
        {
            if (!State.Locks.Contains("heading")) await Applier.ApplyHeadingAsync(entry.PairedHeading);
            if (!State.Locks.Contains("font")) await Applier.ApplyFontAsync(entry.PairedFont);
            if (!State.Locks.Contains("chart")) await Applier.ApplyChartAsync(entry.PairedChart);
        }
        await RefreshTokenValuesAsync();
        SyncUrl();
    }

    // ---- Direct token edits (the dock's swatch popovers) ----

    /// <summary>The dock asks for this when a token popover opens: resolved mode, the token's
    /// live value and the background/foreground partners for the contrast readout.</summary>
    private async Task<TokenEditContext> GetTokenContextAsync(string token)
    {
        _editIsDark = await Js.IsDarkAsync();
        // A *-foreground token grades against the surface it labels, so fetch that partner too.
        OklchColor? partner = token.EndsWith("-foreground", StringComparison.Ordinal)
            ? await LiveTokenAsync(token[..^"-foreground".Length])
            : null;
        return new TokenEditContext(token, _editIsDark,
            await LiveTokenAsync(token), await LiveTokenAsync("background"), await LiveTokenAsync("foreground"),
            partner);
    }

    /// <summary>A token's effective color: the recorded override for the mode being edited, else
    /// the live computed value (theme, chart overlay and injected overrides all resolved).</summary>
    private async Task<OklchColor> LiveTokenAsync(string token)
    {
        if (State.TokenOverrides.TryGetValue((token, _editIsDark), out var overridden)) return overridden;
        return OklchColor.TryParseAny(await Js.GetTokenValueAsync(token), out var parsed)
            ? parsed
            : new OklchColor(0.5, 0.1, 300);
    }

    private async Task OnTokenChangedAsync((string Token, OklchColor Color, bool FirstEdit) e)
    {
        // One history entry per popover session: the first commit records the pre-edit selection,
        // the commits that follow just keep applying.
        if (e.FirstEdit) State.RecordHistory();
        await Applier.ApplyTokenAsync(e.Token, _editIsDark, e.Color);
        await RefreshTokenValuesAsync();
        SyncUrl();
    }

    private async Task OnTokenClearedAsync(string token)
    {
        State.RecordHistory();
        await Applier.ClearTokenAsync(token, _editIsDark);
        await RefreshTokenValuesAsync();
        SyncUrl();
        StateHasChanged();
    }
    private async Task SetChartAsync(string v) { State.RecordHistory(); await Applier.ApplyChartAsync(v); await RefreshTokenValuesAsync(); SyncUrl(); }
    private async Task SetHeadingAsync(string v) { State.RecordHistory(); await Applier.ApplyHeadingAsync(v); SyncUrl(); }
    private async Task SetFontAsync(string v) { State.RecordHistory(); await Applier.ApplyFontAsync(v); SyncUrl(); }
    private async Task SetRadiusAsync(string v) { State.RecordHistory(); await Applier.ApplyRadiusAsync(v); SyncUrl(); }

    // ---- Menu actions ----

    private Task OpenNavigateAsync()
    {
        _navOpen = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task GoAsync(string href)
    {
        _navOpen = false;
        await Task.Yield();
        Nav.NavigateTo(href);
    }

    // All imperative dialogs are pinned to the default look by ComposerLayout's .bz-theme-base
    // wrapper around the providers; Get Code just needs extra width for its tabs.
    private static readonly BzDialogOptions GetCodeDialogOptions = new() { ContentClass = "sm:max-w-lg" };

    private async Task OpenPresetAsync()
    {
        var result = await Dialogs.ShowAsync<OpenPresetDialog>();
        if (result is { Cancelled: false, Value: PresetSelection selection })
        {
            State.RecordHistory();
            await WriteAllAsync(selection);
            StateHasChanged();
        }
    }

    /// <summary>The Shuffle font pool: "Default" plus every offered face (retired stacks stay out).</summary>
    private static readonly string[] ShuffleFonts =
        [.. FontCatalog.All.Where(f => f.Offered).Select(f => f.Name)];

    // Randomize every UNLOCKED knob. Themes are deliberately NOT in the pool - they are curated
    // complete looks; Shuffle explores raw combinations instead: a random primary pair (light
    // mid-tone, dark bright - the inverted pattern the authored palettes use, with the AA
    // foreground derived on write), plus chart, faces and radius. All locked = no-op.
    private async Task ShuffleAsync()
    {
        bool Unlocked(string knob) => !State.Locks.Contains(knob);
        if (!Unlocked("style") && !Unlocked("colors") && !Unlocked("chart")
            && !Unlocked("heading") && !Unlocked("font") && !Unlocked("radius"))
            return;

        var (style, chart) = (State.Style, State.Chart);
        var (heading, font, radius) = (State.Heading, State.Font, State.Radius);
        var changed = false;
        do
        {
            if (Unlocked("style")) style = DocsThemes.Styles[Random.Shared.Next(DocsThemes.Styles.Length)].Value;
            if (Unlocked("chart")) chart = DocsThemes.ChartPalettes[Random.Shared.Next(DocsThemes.ChartPalettes.Length)].Name;
            if (Unlocked("heading")) heading = ShuffleFonts[Random.Shared.Next(ShuffleFonts.Length)];
            if (Unlocked("font")) font = ShuffleFonts[Random.Shared.Next(ShuffleFonts.Length)];
            if (Unlocked("radius")) radius = DocsThemes.Radii[Random.Shared.Next(DocsThemes.Radii.Length)].Value;
            changed = style != State.Style || chart != State.Chart || heading != State.Heading
                || font != State.Font || radius != State.Radius;
        } while (Unlocked("colors") is false && !changed);

        State.RecordHistory();
        await Applier.ApplyStyleAsync(style);
        await Applier.ApplyChartAsync(chart);
        await Applier.ApplyHeadingAsync(heading);
        await Applier.ApplyFontAsync(font);
        await Applier.ApplyRadiusAsync(radius);
        if (Unlocked("colors"))
            await Applier.ApplyOverridesAsync(ShufflePalette());
        await RefreshTokenValuesAsync();
        SyncUrl();
        StateHasChanged();
    }

    /// <summary>
    /// A full random palette, shaped like the authored presets: a brand hue for primary and the
    /// accent tint, plus hue-tinted neutrals for the surface scaffold (background/foreground,
    /// card+popover, secondary, muted, border, input) in both modes. The light primary is a
    /// mid-tone under a derived light label; the dark primary is bright under a derived dark
    /// label - the inverted pairing the palette work standardized. muted-foreground is written
    /// explicitly: its derived value would be full-contrast text, which defeats "muted".
    /// </summary>
    private static List<TokenOverride> ShufflePalette()
    {
        var rnd = Random.Shared;
        var hue = rnd.Next(360);
        // The neutral tint sits on or near the brand hue, like the authored palettes do.
        var tint = (hue + (rnd.Next(3) - 1) * 20 + 360) % 360;
        var lightNc = 0.004 + rnd.NextDouble() * 0.008;
        var darkNc = 0.012 + rnd.NextDouble() * 0.014;

        List<TokenOverride> palette = [];
        void Light(string token, double l, double c) =>
            palette.Add(new TokenOverride(token, Dark: false, new OklchColor(l, c, token is "primary" or "accent" ? hue : tint)));
        void Dark(string token, double l, double c) =>
            palette.Add(new TokenOverride(token, Dark: true, new OklchColor(l, c, token is "primary" or "accent" ? hue : tint)));

        Light("primary", 0.44 + rnd.NextDouble() * 0.14, 0.12 + rnd.NextDouble() * 0.10);
        Light("background", 0.975 + rnd.NextDouble() * 0.015, lightNc);
        Light("foreground", 0.20 + rnd.NextDouble() * 0.03, lightNc * 3);
        Light("card", 0.99, lightNc * 0.6);
        Light("popover", 0.99, lightNc * 0.6);
        Light("secondary", 0.94 + rnd.NextDouble() * 0.02, lightNc * 1.5);
        Light("muted", 0.935 + rnd.NextDouble() * 0.015, lightNc * 1.2);
        Light("muted-foreground", 0.43 + rnd.NextDouble() * 0.05, lightNc * 3);
        Light("accent", 0.90 + rnd.NextDouble() * 0.025, 0.03 + rnd.NextDouble() * 0.02);
        Light("border", 0.885 + rnd.NextDouble() * 0.02, lightNc * 1.5);
        Light("input", 0.855 + rnd.NextDouble() * 0.02, lightNc * 1.5);

        Dark("primary", 0.70 + rnd.NextDouble() * 0.08, 0.11 + rnd.NextDouble() * 0.06);
        var darkBg = 0.17 + rnd.NextDouble() * 0.025;
        Dark("background", darkBg, darkNc);
        Dark("foreground", 0.955 + rnd.NextDouble() * 0.02, darkNc * 0.4);
        Dark("card", darkBg + 0.04, darkNc * 1.1);
        Dark("popover", darkBg + 0.04, darkNc * 1.1);
        Dark("secondary", 0.26 + rnd.NextDouble() * 0.03, darkNc * 1.4);
        Dark("muted", 0.24 + rnd.NextDouble() * 0.02, darkNc * 1.1);
        Dark("muted-foreground", 0.76 + rnd.NextDouble() * 0.03, darkNc);
        Dark("accent", 0.30 + rnd.NextDouble() * 0.04, 0.035 + rnd.NextDouble() * 0.015);
        Dark("border", 0.29 + rnd.NextDouble() * 0.02, darkNc * 1.3);
        Dark("input", 0.35 + rnd.NextDouble() * 0.02, darkNc * 1.3);

        return palette;
    }

    private async Task ResetAsync()
    {
        var ok = await Dialogs.ConfirmAsync(
            "Reset to defaults?",
            "This will reset all customization options to their default values.",
            new BzDialogOptions { ConfirmText = "Reset" });
        if (!ok) return;
        // Reset is an undoable step like any other knob write - record the pre-reset selection so
        // Undo brings it back.
        State.RecordHistory();
        await WriteAllAsync(new PresetSelection("ember", "nova", Rtl: false));
        StateHasChanged();
    }

    private async Task CopyCodeAsync()
    {
        await Js.CopyAsync(Code);
        Toasts.Success("Preset code copied", new ToastOptions { Description = $"\"{Code}\" - paste it in Open Preset or share {Nav.BaseUri}create?preset={Code}" });
    }

    private async Task OpenGetCodeAsync() =>
        await Dialogs.ShowAsync<GetCodeDialog>(new Dictionary<string, object?>
        {
            [nameof(GetCodeDialog.Selection)] = State.Selection,
        }, GetCodeDialogOptions);

    public ValueTask DisposeAsync()
    {
        Shell.DirectionUpdated -= OnShellDirectionUpdated;
        return ValueTask.CompletedTask;
    }
}
