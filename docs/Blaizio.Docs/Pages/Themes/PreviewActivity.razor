@* An activity feed - a timeline of events with tinted icon chips, avatars, badges and times. *@
<BzCard>
    <BzCardHeader>
        <BzCardTitle>Activity</BzCardTitle>
        <BzCardDescription>What happened this week.</BzCardDescription>
    </BzCardHeader>
    <BzCardContent>
        <ol class="relative space-y-5 border-s ps-5">
            @foreach (var (icon, tint, title, detail, when, tag) in Events)
            {
                <li class="relative">
                    <span class="@($"absolute -start-[1.9rem] top-0 flex size-6 items-center justify-center rounded-full ring-4 ring-card {tint}")">
                        <BzIcon Icon="@icon" Class="size-3.5" />
                    </span>
                    <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                        <span class="text-sm font-medium">@title</span>
                        @if (tag is not null)
                        {
                            <BzBadge Variant="BadgeVariant.Secondary">@tag</BzBadge>
                        }
                        <span class="text-muted-foreground ms-auto text-xs tabular-nums">@when</span>
                    </div>
                    <p class="text-muted-foreground mt-0.5 text-xs">@detail</p>
                </li>
            }
        </ol>
    </BzCardContent>
    <BzCardFooter>
        <BzButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="w-full">
            Show older <BzIcon Icon="@Icons.Outline.ChevronDown" data-icon="inline-end" />
        </BzButton>
    </BzCardFooter>
</BzCard>

@code {
    private static readonly (Icon Icon, string Tint, string Title, string Detail, string When, string? Tag)[] Events =
    [
        (Icons.Outline.GitMerge, "bg-primary text-primary-foreground", "Merged #482", "Sidebar rail alignment on RTL layouts.", "2h", "release"),
        (Icons.Outline.MessageCircle, "bg-secondary text-secondary-foreground", "New comment", "Isabella replied on the typography proposal.", "5h", null),
        (Icons.Outline.Rocket, "bg-accent text-accent-foreground", "Deployed", "v0.1.0 went out to production.", "1d", "prod"),
        (Icons.Outline.AlertTriangle, "bg-destructive text-white", "Incident resolved", "Elevated error rate on the registry, 12 minutes.", "2d", null),
    ];
}
