@* Real BzChart/BzPieChart dogfood - the series paint from the --chart-* tokens, so the Chart
   Color knob (and every skin/preset) previews live on actual chart components. *@
<BzCard>
    <BzCardHeader>
        <BzCardTitle>Contribution history</BzCardTitle>
        <BzCardDescription>Last 6 months of activity.</BzCardDescription>
    </BzCardHeader>
    <BzCardContent>
        <BzChart Data="Activity" Label="d => d.Month" Height="220">
            <BzChartGrid />
            <BzChartXAxis />
            <BzChartTooltip />
            <BzChartBarSeries Name="Commits" Value="d => d.Commits" />
            <BzChartBarSeries Name="Reviews" Value="d => d.Reviews" />
        </BzChart>
    </BzCardContent>
    <BzCardFooter>
        <BzButton Variant="ButtonVariant.Outline" Class="w-full">View full report</BzButton>
    </BzCardFooter>
</BzCard>

<BzCard>
    <BzCardHeader>
        <BzCardTitle>Traffic sources</BzCardTitle>
        <BzCardDescription>Where listeners come from.</BzCardDescription>
    </BzCardHeader>
    <BzCardContent Class="flex items-center gap-5">
        <BzPieChart Data="Sources" Label="d => d.Name" Value="d => d.Share" InnerRadius="0.62"
                    Class="w-24 shrink-0">
            <ChildContent>
                <BzChartTooltip />
            </ChildContent>
            <CenterContent>
                <span class="text-sm font-bold tabular-nums">@Sources.Sum(d => d.Share)%</span>
            </CenterContent>
        </BzPieChart>
        <div class="flex min-w-0 flex-1 flex-col gap-1.5">
            @foreach (var (label, share, series) in Sources)
            {
                <div class="flex items-center gap-2 text-xs">
                    <span class="size-2.5 shrink-0 rounded-full" style="background:var(--chart-@series)"></span>
                    <span class="min-w-0 flex-1 truncate">@label</span>
                    <span class="tabular-nums text-muted-foreground">@share%</span>
                </div>
            }
        </div>
    </BzCardContent>
</BzCard>

<BzCard>
    <BzCardHeader>
        <BzCardDescription>Upcoming payout</BzCardDescription>
        <BzCardTitle Class="text-3xl tabular-nums">$1,000</BzCardTitle>
        <BzCardAction><BzBadge Variant="BadgeVariant.Secondary">May 25</BzBadge></BzCardAction>
    </BzCardHeader>
    <BzCardContent Class="space-y-2">
        <BzProgress Value="72" AriaLabel="Payout threshold progress" />
        <p class="text-xs text-muted-foreground">72% of the $1,400 threshold reached.</p>
    </BzCardContent>
</BzCard>

@code {
    private sealed record Point(string Month, double Commits, double Reviews);

    private static readonly Point[] Activity =
    [
        new("Dec", 45, 22), new("Jan", 70, 31), new("Feb", 55, 18),
        new("Mar", 90, 44), new("Apr", 40, 26), new("May", 100, 52),
    ];

    private sealed record Source(string Name, double Share, int Series);

    private static readonly Source[] Sources =
    [
        new("Spotify", 35, 1), new("Apple Music", 25, 2), new("YouTube", 18, 3),
        new("Tidal", 13, 4), new("Other", 9, 5),
    ];
}
