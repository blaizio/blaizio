@* The calendar - a dense grid that shows off accent/muted/ring tokens at once. *@
<BzCard>
    <BzCardHeader>
        <BzCardTitle>Calendar</BzCardTitle>
    </BzCardHeader>
    <BzCardContent Class="flex justify-center">
        <BzCalendar @bind-Value="_date" />
    </BzCardContent>
</BzCard>

@code {
    private DateOnly? _date = new(2026, 7, 9);
}
