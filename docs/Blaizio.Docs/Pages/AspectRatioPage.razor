@page "/docs/components/aspect-ratio"
@using Blaizio.Docs.Examples.AspectRatio
<PageTitle>Aspect Ratio - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Aspect Ratio</h1>
        <p class="text-muted-foreground">Constrains content to a width:height ratio - even before it loads.</p>
    </header>

    <UsageBlock Example="typeof(AspectRatioDefaultExample)" Description="Wrap any content; it reserves the ratio's box before the content paints." />

    <ExamplesHeading />

    <Demo Title="16 : 9" Example="typeof(AspectRatioDefaultExample)" />

    <Demo Title="Square" Example="typeof(AspectRatioSquareExample)" />

    <Demo Title="Customization"
          Description="The ratio box is a plain container - dress it through Class: gradient, ring, and a larger radius."
          Example="typeof(AspectRatioCustomExample)" />
</div>

