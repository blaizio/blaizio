@page "/docs/components/aspect-ratio"
@using Blaizio.Docs.Examples.AspectRatio
<PageTitle>Aspect Ratio - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Aspect Ratio</h1>
            <DocBadges Slug="aspect-ratio" />
        </div>
        <p>Holds content to a fixed width-to-height ratio. The box reserves its space before images or embeds load, so the layout does not shift when they arrive.</p>
    </header>

    <UsageBlock Example="typeof(AspectRatioDefaultExample)" Description="Wrap any content and set `Ratio`. The box takes its full size immediately, before the content paints." />

    <ExamplesHeading />

    <Demo Title="16 : 9" Example="typeof(AspectRatioDefaultExample)" />

    <Demo Title="Square" Example="typeof(AspectRatioSquareExample)" />

    <Demo Title="Customization"
          Description="The ratio box is a plain container that accepts `Class`. This example adds a gradient, a ring and a larger radius."
          Example="typeof(AspectRatioCustomExample)" />
</div>

