@page "/components/separator"
<PageTitle>Separator - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Separator</h1>
        <p class="text-muted-foreground">Visually or semantically separates content.</p>
    </header>

    <UsageBlock Setup="@UsageSetup" Code="@UsageMarkup" />

    <ExamplesHeading />

    <Demo Title="Horizontal" Code="@HorizontalCode">
        <div class="w-full max-w-xs">
            <div class="space-y-1">
                <h4 class="text-sm font-medium leading-none">Blaizio</h4>
                <p class="text-sm text-muted-foreground">Headless Blazor primitives.</p>
            </div>
            <BzSeparator Class="my-4" />
            <div class="flex h-5 items-center gap-4 text-sm">
                <span>Docs</span>
                <BzSeparator Orientation="Orientation.Vertical" />
                <span>Source</span>
                <BzSeparator Orientation="Orientation.Vertical" />
                <span>About</span>
            </div>
        </div>
    </Demo>

    <Demo Title="Vertical" Code="@VerticalCode">
        <div class="flex h-8 items-center gap-4 text-sm">
            <span>One</span>
            <BzSeparator Orientation="Orientation.Vertical" />
            <span>Two</span>
            <BzSeparator Orientation="Orientation.Vertical" />
            <span>Three</span>
        </div>
    </Demo>

    <Demo Title="Semantic vs. decorative"
          Description="Decorative (default) renders role=none; set Decorative=false for a meaningful role=separator exposed to assistive tech."
          Code="@SemanticCode">
        <div class="flex h-8 items-center gap-4 text-sm">
            <span>Section A</span>
            <BzSeparator Orientation="Orientation.Vertical" Decorative="false" />
            <span>Section B</span>
        </div>
    </Demo>

    <Demo Title="Customization"
          Description="Recolor the rule with Class - a solid tint, a gradient, or a translucent shade."
          Code="@CustomCode">
        <div class="w-full max-w-xs space-y-5">
            <BzSeparator Class="bg-indigo-500" />
            <BzSeparator Class="bg-gradient-to-r from-fuchsia-500 to-violet-500" />
            <BzSeparator Class="bg-emerald-500/60" />
        </div>
    </Demo>
    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the row order and spacing mirror to the right." Code="@RtlCode">
        <BzDirectionProvider Direction="Direction.Rtl">
            <div class="w-full max-w-xs">
                <div class="space-y-1">
                    <h4 class="text-sm font-medium leading-none">Blaizio</h4>
                    <p class="text-sm text-muted-foreground">أساسيات Blazor بلا واجهة.</p>
                </div>
                <BzSeparator Class="my-4" />
                <div class="flex h-5 items-center gap-4 text-sm">
                    <span>الملف الشخصي</span>
                    <BzSeparator Orientation="Orientation.Vertical" />
                    <span>الإعدادات</span>
                    <BzSeparator Orientation="Orientation.Vertical" />
                    <span>تسجيل الخروج</span>
                </div>
            </div>
        </BzDirectionProvider>
    </Demo>
</div>

@code {
    private const string UsageSetup = """
        @* _Imports.razor (or the top of the page) *@
        @using Blaizio.Ui
        """;

    private const string UsageMarkup = """
        <BzSeparator />
        <BzSeparator Orientation="Orientation.Vertical" />
        """;

    private const string CustomCode = """
        <BzSeparator Class="bg-indigo-500" />
        <BzSeparator Class="bg-gradient-to-r from-fuchsia-500 to-violet-500" />
        <BzSeparator Class="bg-emerald-500/60" />
        """;

    private const string HorizontalCode = """
        <div class="space-y-1">
            <h4 class="text-sm font-medium leading-none">Blaizio</h4>
            <p class="text-sm text-muted-foreground">Headless Blazor primitives.</p>
        </div>
        <BzSeparator Class="my-4" />
        <div class="flex h-5 items-center gap-4 text-sm">
            <span>Docs</span>
            <BzSeparator Orientation="Orientation.Vertical" />
            <span>Source</span>
            <BzSeparator Orientation="Orientation.Vertical" />
            <span>About</span>
        </div>
        """;

    private const string VerticalCode = """
        <div class="flex h-8 items-center gap-4 text-sm">
            <span>One</span>
            <BzSeparator Orientation="Orientation.Vertical" />
            <span>Two</span>
            <BzSeparator Orientation="Orientation.Vertical" />
            <span>Three</span>
        </div>
        """;

    private const string SemanticCode = """
        <div class="flex h-8 items-center gap-4 text-sm">
            <span>Section A</span>
            <BzSeparator Orientation="Orientation.Vertical" Decorative="false" />
            <span>Section B</span>
        </div>
        """;

    private const string RtlCode = """
        <BzDirectionProvider Direction="Direction.Rtl">
            <div class="space-y-1">
                <h4 class="text-sm font-medium leading-none">Blaizio</h4>
                <p class="text-sm text-muted-foreground">أساسيات Blazor بلا واجهة.</p>
            </div>
            <BzSeparator Class="my-4" />
            <div class="flex h-5 items-center gap-4 text-sm">
                <span>الملف الشخصي</span>
                <BzSeparator Orientation="Orientation.Vertical" />
                <span>الإعدادات</span>
                <BzSeparator Orientation="Orientation.Vertical" />
                <span>تسجيل الخروج</span>
            </div>
        </BzDirectionProvider>
        """;
}
