@page "/docs/components/separator"
@using Blaizio.Docs.Examples.Separator
<PageTitle>Separator - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Separator</h1>
            <DocBadges Slug="separator" />
        </div>
        <p>Visually or semantically separates content.</p>
    </header>

    <UsageBlock Example="typeof(SeparatorUsageExample)" />

    <ExamplesHeading />

    <Demo Title="Horizontal" Example="typeof(SeparatorHorizontalExample)" />

    <Demo Title="Vertical" Example="typeof(SeparatorVerticalExample)" />

    <Demo Title="Semantic vs. decorative"
          Description="Decorative (default) renders role=none; set Decorative=false for a meaningful role=separator exposed to assistive tech."
          Example="typeof(SeparatorSemanticExample)" />

    <Demo Title="Customization"
          Description="Recolor the rule with Class - a solid tint, a gradient, or a translucent shade."
          Example="typeof(SeparatorCustomExample)" />
    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic or Hebrew copy - the row order and spacing mirror to the right." Example="typeof(SeparatorRtlExample)" />
</div>

