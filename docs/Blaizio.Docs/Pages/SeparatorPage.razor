@page "/docs/components/separator"
@using Blaizio.Docs.Examples.Separator
<PageTitle>Separator - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Separator</h1>
            <DocBadges Slug="separator" />
        </div>
        <p>A thin rule between pieces of content, horizontal or vertical. It is decorative by default and hidden from assistive technology, and you can switch it to a real separator role when the division carries meaning.</p>
    </header>

    <UsageBlock Example="typeof(SeparatorUsageExample)" />

    <ExamplesHeading />

    <Demo Title="Horizontal" Example="typeof(SeparatorHorizontalExample)" />

    <Demo Title="Vertical" Example="typeof(SeparatorVerticalExample)" />

    <Demo Title="Semantic vs. decorative"
          Description="By default the separator is decorative and renders `role=&quot;none&quot;`. Set `Decorative` to `false` when the division matters, and it exposes `role=&quot;separator&quot;` to assistive technology."
          Example="typeof(SeparatorSemanticExample)" />

    <Demo Title="Customization"
          Description="Recolor the rule through `Class`, with a solid tint, a gradient or a translucent shade."
          Example="typeof(SeparatorCustomExample)" />
    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, the row order and spacing flip to the opposite side." Example="typeof(SeparatorRtlExample)" />
</div>

