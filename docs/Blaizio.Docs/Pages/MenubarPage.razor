@page "/components/menubar"
@using Blaizio.Docs.Examples.Menubar
<PageTitle>Menubar - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <h1 class="text-2xl font-bold tracking-tight">Menubar</h1>
        <p class="text-muted-foreground">A horizontal bar of menus - an application menu bar (File, Edit, View, ...) - positioned with <a class="font-medium text-foreground underline underline-offset-4" href="https://floating-ui.com" target="_blank" rel="noopener">Floating UI</a>. The inline arrow keys (and Home/End) move between the menus with a single tab stop; click a trigger to open its menu, and once any menu is open, hovering or clicking another switches to it. Each menu is a full dropdown - items, shortcuts, checkboxes, radios, labels, separators, and submenus. It is <strong>non-modal</strong>: the rest of the page stays interactive while it is open.</p>
    </header>

    <UsageBlock Example="typeof(MenubarUsageExample)"
                Description="Add the using once, then list a BzMenubarMenu per top-level menu, each a trigger plus its content." />

    <CompositionTree Root="Anatomy"
                     Description="The full anatomy. Each BzMenubarMenu pairs a trigger with content; inside, group items under labels, separate sections, and nest a BzMenubarSub for submenus." />

    <ExamplesHeading />

    <Demo Title="Default" Description="A complete menu bar. Open a menu, then move along the bar with the pointer or ArrowLeft/Right; ArrowDown/Up open the focused menu. Escape closes and returns focus to the trigger."
          Example="typeof(MenubarDefaultExample)" />

    <Demo Title="Item as a link (RenderAs)" Description="Render a menu item onto your own element - here an anchor - so it navigates like a real link."
          Example="typeof(MenubarItemAsLinkExample)" />

    <Demo Title="Controlled" Description="Bind which menu is open two-way - give each MenubarMenu a Value, and the bar's Value is the open one (or null when all are closed). The live state is shown above and updates however the menu is dismissed."
          Example="typeof(MenubarControlledExample)" />

    <Demo Title="Looping" Description="The inline arrow keys move between the menu triggers and wrap from the last back to the first by default. Set Loop to false to stop at the ends instead - ArrowRight on the last trigger (or ArrowLeft on the first) then goes nowhere. Tab to the bar and hold an arrow key to feel it."
          Example="typeof(MenubarLoopExample)" />

    <Demo Title="Customization"
          Description="Restyle any part via Class - a branded bar, triggers that tint indigo when their menu is open (the data-[state=open] variant), and a content panel with a custom radius and tint. Utilities win over the skin, so these take effect."
          Example="typeof(MenubarCustomExample)" />

    <Demo Title="RTL" Description="Wrapped in a DirectionProvider with Arabic copy - the bar lays out right-to-left, each menu anchors and aligns mirrored, the submenu opens to the left, and the inline arrows swap."
          Example="typeof(MenubarRtlExample)" />

</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzMenubar",
        new CompositionNode("BzMenubarMenu",
            new CompositionNode("BzMenubarTrigger"),
            new CompositionNode("BzMenubarContent",
                new CompositionNode("BzMenubarGroup",
                    new CompositionNode("BzMenubarLabel"),
                    new CompositionNode("BzMenubarItem",
                        new CompositionNode("BzMenubarShortcut")),
                    new CompositionNode("BzMenubarCheckboxItem"),
                    new CompositionNode("BzMenubarRadioGroup",
                        new CompositionNode("BzMenubarRadioItem"))),
                new CompositionNode("BzMenubarSeparator"),
                new CompositionNode("BzMenubarSub",
                    new CompositionNode("BzMenubarSubTrigger"),
                    new CompositionNode("BzMenubarSubContent")))));
}
