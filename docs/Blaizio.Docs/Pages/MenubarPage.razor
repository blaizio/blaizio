@page "/docs/components/menubar"
@using Blaizio.Docs.Examples.Menubar
<PageTitle>Menubar - Blaizio</PageTitle>

<div class="typeset typeset-docs space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Menubar</h1>
            <DocBadges Slug="menubar" />
        </div>
        <p>An application menu bar (File, Edit, View and so on) whose menus are positioned with <a class="font-medium text-foreground" href="https://floating-ui.com" target="_blank" rel="noopener">Floating UI</a>. The bar is a single tab stop: the inline arrow keys and Home/End move between menus, and once one menu is open, hovering or clicking another switches to it. Each menu is a full dropdown with shortcuts, checkboxes, radios, labels, separators and submenus, and the bar is <strong>non-modal</strong>, so the rest of the page stays interactive while a menu is open.</p>
    </header>

    <UsageBlock Example="typeof(MenubarUsageExample)"
                Description="Import `Blaizio.Ui` once, then add a `BzMenubarMenu` per top-level menu, each holding a trigger and its content. Give the bar an `AriaLabel` such as Application so screen readers can tell it apart from any other menubar on the page." />

    <CompositionTree Root="Anatomy"
                     Description="Each `BzMenubarMenu` pairs a trigger with content. Inside, group items under labels, divide sections with separators, and nest a `BzMenubarSub` for submenus." />

    <ExamplesHeading />

    <Demo Title="Default" Description="Open a menu, then move along the bar with the pointer or with ArrowLeft and ArrowRight. ArrowDown and ArrowUp open the focused menu, and Escape closes it and returns focus to the trigger."
          Example="typeof(MenubarDefaultExample)" />

    <Demo Title="Item as a link (RenderAs)" Description="`RenderAs` renders a menu item as your own element. Here it is an anchor, so the item navigates like a real link."
          Example="typeof(MenubarItemAsLinkExample)" />

    <Demo Title="Controlled" Description="Give each `BzMenubarMenu` a `Value` and bind the bar's `Value` two-way to track which menu is open, or `null` when all are closed. The live state above updates however the menu is dismissed."
          Example="typeof(MenubarControlledExample)" />

    <Demo Title="Looping" Description="By default the inline arrow keys wrap from the last trigger back to the first. Set `Loop` to `false` to stop at the ends instead. Tab to the bar and hold an arrow key to try it."
          Example="typeof(MenubarLoopExample)" />

    <Demo Title="Customization"
          Description="Every part accepts `Class`. This example brands the bar, tints a trigger indigo while its menu is open with the `data-[state=open]` variant, and gives the content panel its own radius and tint."
          Example="typeof(MenubarCustomExample)" />

    <Demo Title="RTL" Description="Inside a right-to-left `DirectionProvider`, the bar lays out from the right, each menu aligns from the opposite edge, submenus open to the left and the inline arrow keys swap direction."
          Example="typeof(MenubarRtlExample)" />

</div>

@code {
    // The anatomy drawn by the Composition section - CompositionTree computes the connectors.
    private static readonly CompositionNode Anatomy = new("BzMenubar",
        new CompositionNode("BzMenubarMenu",
            new CompositionNode("BzMenubarTrigger"),
            new CompositionNode("BzMenubarContent",
                new CompositionNode("BzMenubarGroup",
                    new CompositionNode("BzMenubarLabel"),
                    new CompositionNode("BzMenubarItem",
                        new CompositionNode("BzMenubarShortcut")),
                    new CompositionNode("BzMenubarCheckboxItem"),
                    new CompositionNode("BzMenubarRadioGroup",
                        new CompositionNode("BzMenubarRadioItem"))),
                new CompositionNode("BzMenubarSeparator"),
                new CompositionNode("BzMenubarSub",
                    new CompositionNode("BzMenubarSubTrigger"),
                    new CompositionNode("BzMenubarSubContent")))));
}
