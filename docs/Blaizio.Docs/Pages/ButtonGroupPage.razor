@page "/docs/components/button-group"
@using Blaizio.Docs.Examples.ButtonGroup
<PageTitle>Button Group - Blaizio</PageTitle>

<div class="space-y-10">
    <header class="docs-page-header space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight">Button Group</h1>
            <DocBadges Slug="button-group" />
        </div>
        <p class="text-muted-foreground">Joins related buttons into one segmented control - inner corners square off and adjacent borders collapse. For grouping ACTIONS; reach for Toggle Group when the buttons carry on/off state.</p>
    </header>

    <UsageBlock Example="typeof(ButtonGroupUsageExample)" />

    <ExamplesHeading />

    <Demo Title="Sizes"
          Description="Segments of any button size merge the same way - keep one size per group."
          Example="typeof(ButtonGroupSizesExample)" />

    <Demo Title="Vertical"
          Description="Orientation Vertical stacks the segments - a zoom rail."
          Example="typeof(ButtonGroupVerticalExample)" />

    <Demo Title="Split button"
          Description="A primary action plus a dropdown of alternatives, divided by a ButtonGroupSeparator - use it between segments of the same filled variant."
          Example="typeof(ButtonGroupSplitExample)" />

    <Demo Title="Text"
          Description="ButtonGroupText is a static segment - a label, unit, or prefix sitting flush with the buttons."
          Example="typeof(ButtonGroupTextExample)" />

    <Demo Title="With input"
          Description="An Input as a segment - it stretches to fill the group while the button keeps its size."
          Example="typeof(ButtonGroupInputExample)" />

    <Demo Title="With select"
          Description="A Select trigger and an Input merge like any other segment - a currency amount row."
          Example="typeof(ButtonGroupSelectExample)" />

    <Demo Title="With popover"
          Description="The trailing segment triggers a Popover via RenderAs - richer than a menu, still one control."
          Example="typeof(ButtonGroupPopoverExample)" />

    <Demo Title="Nested"
          Description="Two groups inside a group read as one spaced cluster - each keeps its own merged edges."
          Example="typeof(ButtonGroupNestedExample)" />

    <Demo Title="RTL"
          Description="Wrapped in a DirectionProvider with Arabic or Hebrew copy - the merged edges and corner rounding mirror to the right."
          Example="typeof(ButtonGroupRtlExample)" />
</div>
