node_modules/
# Stray NuGet restore folder if RestorePackagesPath ever resolves to a flattened relative name;
# the real per-checkout cache lives at artifacts/pkg-cache (ignored by the root .gitignore).
*pkg-cache/
# Tailwind output is generated from Styles/app.css.
wwwroot/app.css
# esbuild output, generated from lib/ts/docs.ts.
wwwroot/js/docs.js
wwwroot/js/docs.js.map
# Generated by tools/make-pin-base.mjs: donut-scoped skin copies + the .bz-theme-base pin skin.
Styles/skins/
Styles/pin-base.css
# API reference XML is copied from Blaizio.Ui's build output.
wwwroot/api/
# Materialized Blaizio contract (copied from Blaizio.Base at build, like obj/).
.blaizio/
