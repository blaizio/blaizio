{
  "name": "blaizio-docs",
  "private": true,
  "description": "Tailwind v4 build for the Blaizio docs site (the reference consumer).",
  "scripts": {
    "build:css": "node tools/make-pin-base.mjs && tailwindcss -i Styles/app.css -o wwwroot/app.css --minify",
    "watch:css": "node tools/make-pin-base.mjs && tailwindcss -i Styles/app.css -o wwwroot/app.css --watch",
    "build:js": "esbuild lib/ts/docs.ts --bundle --format=esm --external:../_content/* --outfile=wwwroot/js/docs.js --minify --sourcemap",
    "watch:js": "esbuild lib/ts/docs.ts --bundle --format=esm --external:../_content/* --outfile=wwwroot/js/docs.js --sourcemap --watch",
    "validate:community": "node tools/validate-community.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "@parcel/watcher",
      "esbuild"
    ]
  }
}
