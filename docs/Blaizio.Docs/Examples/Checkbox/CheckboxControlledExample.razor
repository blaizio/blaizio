<div class="flex flex-col items-center gap-3">
    <div class="flex items-center gap-2">
        <BzCheckbox id="news" @bind-Checked="_state" />
        <BzLabel For="news">Subscribe to the newsletter</BzLabel>
    </div>
    <div class="flex items-center gap-3">
        <p class="text-sm text-muted-foreground">State: <span class="font-mono">@_state</span></p>
        <BzButton Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" @onclick="@(() => _state = CheckedState.Indeterminate)">
            Set indeterminate
        </BzButton>
    </div>
</div>

@code {
    private CheckedState _state = CheckedState.Unchecked;
}
