<div class="flex h-48 items-stretch justify-center gap-8">
    @foreach (var v in new[] { 25, 50, 75, 100 })
    {
        <div class="flex flex-col items-center gap-2">
            <BzProgress Orientation="Orientation.Vertical" Value="@v" />
            <span class="text-xs tabular-nums text-muted-foreground">@v%</span>
        </div>
    }
    <div class="flex flex-col items-center gap-2">
        <BzProgress Orientation="Orientation.Vertical" Indeterminate />
        <span class="text-xs text-muted-foreground">busy</span>
    </div>
</div>
