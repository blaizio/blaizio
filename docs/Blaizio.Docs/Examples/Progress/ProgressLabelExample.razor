<div class="flex w-full max-w-sm flex-col gap-4">
    @* ChildContent overlays the relative track - pin it with absolute inset-0 and flex it anywhere. *@
    <BzProgress Value="62" Class="h-6 rounded-md">
        <span class="absolute inset-0 flex items-center justify-center text-xs font-medium">62%</span>
    </BzProgress>

    <BzProgress Value="35" Color="StatusColor.Success" Class="h-6 rounded-md">
        <span class="absolute inset-0 flex items-center px-3 text-xs font-medium">Uploading - 35%</span>
    </BzProgress>

    <BzProgress Value="80" Class="h-6 rounded-md bg-primary/15">
        <span class="absolute inset-0 flex items-center justify-end px-3 text-xs font-semibold tabular-nums text-primary-foreground">80%</span>
    </BzProgress>
</div>
