<div class="flex w-full max-w-sm flex-col gap-4">
    @* ChildContent overlays the relative track - pin it with absolute inset-0 and flex it anywhere.
       The label is read against what lies under it, so keep it over the fill and give it the
       fill's foreground color. *@
    <BzProgress Value="62" AriaLabel="Import" Class="h-6 rounded-md">
        <span class="absolute inset-0 flex items-center justify-center text-xs font-medium text-primary-foreground">62%</span>
    </BzProgress>

    <BzProgress Value="50" Color="StatusColor.Success" AriaLabel="Upload" Class="h-6 rounded-md">
        <span class="absolute inset-0 flex items-center px-3 text-xs font-medium text-success-foreground">Uploading - 50%</span>
    </BzProgress>

    @* A label at the end of the fill: a box as wide as the value, with its text at the far edge. *@
    <BzProgress Value="80" AriaLabel="Sync" Class="h-6 rounded-md bg-primary/15">
        <span class="absolute inset-y-0 start-0 flex w-4/5 items-center justify-end px-3 text-xs font-semibold tabular-nums text-primary-foreground">80%</span>
    </BzProgress>
</div>
