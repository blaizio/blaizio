<div class="w-full max-w-sm space-y-4">
    <BzProgress Indeterminate />

    @* Style the sweeping band like any fill - here a soft gradient comet on a tinted track. *@
    <BzProgress Indeterminate
                Class="h-2.5 bg-indigo-500/15
                       [&_[data-slot=progress-indicator]]:rounded-full
                       [&_[data-slot=progress-indicator]]:bg-gradient-to-r
                       [&_[data-slot=progress-indicator]]:from-transparent
                       [&_[data-slot=progress-indicator]]:via-indigo-500
                       [&_[data-slot=progress-indicator]]:to-transparent" />
</div>
