<div class="flex flex-wrap items-center gap-10">
    @* Sweep < 360 leaves a gap centered on the bottom - a gauge. *@
    <BzCircularProgress Value="70" Sweep="270" Class="size-24" Thickness="5">
        <div class="text-center">
            <div class="text-lg font-semibold tabular-nums">70%</div>
            <div class="text-[10px] uppercase tracking-wide text-muted-foreground">cpu</div>
        </div>
    </BzCircularProgress>

    <BzCircularProgress Value="40" Sweep="270" Color="StatusColor.Info" Class="size-24" Thickness="5">
        <div class="text-center">
            <div class="text-lg font-semibold tabular-nums">2.1<span class="text-xs text-muted-foreground">GB</span></div>
            <div class="text-[10px] uppercase tracking-wide text-muted-foreground">memory</div>
        </div>
    </BzCircularProgress>

    <BzCircularProgress Value="88" Sweep="180" Color="StatusColor.Destructive" Class="size-24" Thickness="5">
        <div class="text-center">
            <div class="text-lg font-semibold tabular-nums">88%</div>
            <div class="text-[10px] uppercase tracking-wide text-muted-foreground">disk</div>
        </div>
    </BzCircularProgress>
</div>
