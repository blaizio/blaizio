<RtlDemo Context="t">
    <BzDirectionProvider Direction="Direction.Rtl">
        <div class="w-full max-w-sm space-y-4">
            @foreach (var v in new[] { 0, 25, 50, 75, 100 })
            {
                @* First in reading order = the right side under RTL: the value leads, the bar follows. *@
                <div class="flex items-center gap-3">
                    <span class="w-10 text-end text-sm tabular-nums text-muted-foreground">@v%</span>
                    <BzProgress Value="@v" />
                </div>
            }
        </div>
    </BzDirectionProvider>
</RtlDemo>
