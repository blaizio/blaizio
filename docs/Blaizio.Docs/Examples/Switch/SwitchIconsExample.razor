<div class="flex flex-wrap items-center gap-6">
    @* Track icons - the active side's glyph is revealed as the thumb slides away. *@
    <BzSwitch Size="SwitchSize.Lg" DefaultChecked aria-label="Toggle theme">
        <CheckedIcon><BzIcon Icon="@Icons.Outline.Sun" /></CheckedIcon>
        <UncheckedIcon><BzIcon Icon="@Icons.Outline.Moon" /></UncheckedIcon>
    </BzSwitch>

    @* Thumb icons - cross-fade with a quarter-turn inside the knob. *@
    <BzSwitch Size="SwitchSize.Lg" aria-label="Toggle notifications">
        <ThumbCheckedIcon><BzIcon Icon="@Icons.Outline.Check" /></ThumbCheckedIcon>
        <ThumbUncheckedIcon><BzIcon Icon="@Icons.Outline.X" /></ThumbUncheckedIcon>
    </BzSwitch>

    @* Both at once. *@
    <BzSwitch Size="SwitchSize.Lg" DefaultChecked aria-label="Toggle Wi-Fi">
        <CheckedIcon><BzIcon Icon="@Icons.Outline.Wifi" /></CheckedIcon>
        <UncheckedIcon><BzIcon Icon="@Icons.Outline.WifiOff" /></UncheckedIcon>
        <ThumbCheckedIcon><BzIcon Icon="@Icons.Outline.Check" /></ThumbCheckedIcon>
        <ThumbUncheckedIcon><BzIcon Icon="@Icons.Outline.X" /></ThumbUncheckedIcon>
    </BzSwitch>
</div>
