<div class="flex flex-col items-center gap-3">
    <div class="flex items-center gap-2">
        <BzSwitch id="wifi" @bind-Checked="_wifi" />
        <BzLabel For="wifi">Wi-Fi</BzLabel>
    </div>
    <p class="text-sm text-muted-foreground">Wi-Fi is <span class="font-mono">@(_wifi ? "on" : "off")</span></p>
</div>

@code {
    private bool _wifi = true;
}
