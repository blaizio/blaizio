<BzDropdownMenu>
    <BzDropdownMenuTrigger>
        <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">
            <BzIcon Icon="@Icons.Outline.User" />
            Account
        </BzButton></RenderAs>
    </BzDropdownMenuTrigger>
    <BzDropdownMenuContent Class="w-48">
        <BzDropdownMenuItem>
            <BzIcon Icon="@Icons.Outline.Settings" />
            Settings
        </BzDropdownMenuItem>
        <BzDropdownMenuSeparator />
        <BzDropdownMenuLabel>Theme</BzDropdownMenuLabel>
        @* The whole theme picker is one component - drop it into any menu. *@
        <BzThemeMenu />
        <BzDropdownMenuSeparator />
        <BzDropdownMenuItem>
            <BzIcon Icon="@Icons.Outline.Logout" />
            Sign out
        </BzDropdownMenuItem>
    </BzDropdownMenuContent>
</BzDropdownMenu>
