@* AutoFocus: the field focuses itself when it MOUNTS - here it appears on demand, the way a code
   prompt does after "we sent you a code", and the keyboard is already in it. Native autofocus
   cannot do this: browsers only honor it during document load, never for markup Blazor renders
   later. (Rendered on demand here so the demo does not steal the page's focus on every visit.) *@
<div class="flex w-full max-w-sm flex-col items-start gap-4">
    @if (!_shown)
    {
        <BzButton Variant="ButtonVariant.Outline" @onclick="@(() => _shown = true)">Send code</BzButton>
    }
    else
    {
        <BzInputOtp @bind-Value="_code" AutoFocus MaxLength="6" Pattern="@InputOtpPatterns.Digits" AriaLabel="One-time code">
            <BzInputOtpGroup>
                <BzInputOtpSlot Index="0" />
                <BzInputOtpSlot Index="1" />
                <BzInputOtpSlot Index="2" />
            </BzInputOtpGroup>
            <BzInputOtpSeparator />
            <BzInputOtpGroup>
                <BzInputOtpSlot Index="3" />
                <BzInputOtpSlot Index="4" />
                <BzInputOtpSlot Index="5" />
            </BzInputOtpGroup>
        </BzInputOtp>
        <p class="text-muted-foreground text-xs">The field mounted focused - just type the code.</p>
    }
</div>

@code {
    private bool _shown;
    private string? _code;
}
