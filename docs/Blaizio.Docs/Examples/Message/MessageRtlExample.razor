<RtlDemo Context="t">
    <BzDirectionProvider Dir="Direction.Rtl">
        <div class="flex w-full max-w-md flex-col gap-4">
            <BzMessage>
                <BzMessageAvatar>
                    <BzAvatar>
                        <BzAvatarImage Src="https://i.pravatar.cc/120?img=12" Alt='@t["رانية", "רניה"]' />
                        <BzAvatarFallback>@t["ر", "ר"]</BzAvatarFallback>
                    </BzAvatar>
                </BzMessageAvatar>
                <BzMessageContent>
                    <BzMessageHeader>@t["رانية", "רניה"]</BzMessageHeader>
                    <BzBubble Variant="BubbleVariant.Secondary" Tail="BubbleTail.Bottom">
                        <BzBubbleContent>@t["أرسلت لك التصميم النهائي.", "שלחתי לך את העיצוב הסופי."]</BzBubbleContent>
                    </BzBubble>
                </BzMessageContent>
            </BzMessage>
            <BzMessage Align="MessageAlign.End">
                <BzMessageContent>
                    <BzBubble Tail="BubbleTail.Bottom">
                        <BzBubbleContent>@t["رائع، سألقي نظرة الآن.", "מעולה, אסתכל עכשיו."]</BzBubbleContent>
                    </BzBubble>
                    <BzMessageFooter>@t["تمت المشاهدة", "נראתה"]</BzMessageFooter>
                </BzMessageContent>
            </BzMessage>
        </div>
    </BzDirectionProvider>
</RtlDemo>
