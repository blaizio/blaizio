@* Icon actions in the footer - each a ghost icon button with an aria-label. The row only shows
   affordances; wire the handlers to your own state. *@
<BzMessage Class="max-w-md">
    <BzMessageContent>
        <BzBubble Variant="BubbleVariant.Ghost">
            <BzBubbleContent>
                The flaky test was a race between the carousel's scroll-snap settling and the
                assertion reading the active dot. Waiting for scrollend fixed it.
            </BzBubbleContent>
        </BzBubble>
        <BzMessageFooter>
            <BzButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" aria-label="Copy">
                <BzIcon Icon="@Tabler.Outline.Copy" />
            </BzButton>
            <BzButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" aria-label="Retry">
                <BzIcon Icon="@Tabler.Outline.Refresh" />
            </BzButton>
            <BzButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" aria-label="Good response">
                <BzIcon Icon="@Tabler.Outline.ThumbUp" />
            </BzButton>
            <BzButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" aria-label="Bad response">
                <BzIcon Icon="@Tabler.Outline.ThumbDown" />
            </BzButton>
        </BzMessageFooter>
    </BzMessageContent>
</BzMessage>
