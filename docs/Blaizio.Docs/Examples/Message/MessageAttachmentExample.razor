@* Rich content in a turn: an image bubble (the content clips to the bubble radius) and a file
   card - an Attachment dropped straight into the content column. *@
<div class="flex w-full max-w-md flex-col gap-4">
    <BzMessage Align="MessageAlign.End">
        <BzMessageContent>
            <BzBubble>
                <BzBubbleContent Class="p-0">
                    <img src="https://picsum.photos/seed/blaizio-chat/480/280" alt="Marina at sunset"
                         class="block max-w-full" width="480" height="280" />
                </BzBubbleContent>
            </BzBubble>
            <BzBubble>
                <BzBubbleContent>The venue from yesterday. Full brief attached.</BzBubbleContent>
            </BzBubble>
            <BzAttachment Class="self-end">
                <BzAttachmentMedia>
                    <BzIcon Icon="@Icons.Outline.FileText" />
                </BzAttachmentMedia>
                <BzAttachmentContent>
                    <BzAttachmentTitle>event-brief.pdf</BzAttachmentTitle>
                    <BzAttachmentDescription>PDF · 1.2 MB</BzAttachmentDescription>
                </BzAttachmentContent>
                <BzAttachmentActions>
                    <BzAttachmentAction aria-label="Download">
                        <BzIcon Icon="@Icons.Outline.Download" />
                    </BzAttachmentAction>
                </BzAttachmentActions>
            </BzAttachment>
            <BzMessageFooter>Delivered 18:42</BzMessageFooter>
        </BzMessageContent>
    </BzMessage>
</div>
