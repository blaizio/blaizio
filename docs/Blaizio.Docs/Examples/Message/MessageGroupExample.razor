@* MessageGroup stacks whole turns from one sender: the first message carries the avatar and
   header, the rest keep an empty MessageAvatar so their bubbles stay column-aligned. *@
<BzMessageGroup Class="max-w-md">
    <BzMessage>
        <BzMessageAvatar>
            <BzAvatar>
                <BzAvatarImage Src="https://i.pravatar.cc/120?img=12" Alt="Rania" />
                <BzAvatarFallback>RA</BzAvatarFallback>
            </BzAvatar>
        </BzMessageAvatar>
        <BzMessageContent>
            <BzMessageHeader>Rania</BzMessageHeader>
            <BzBubbleGroup Connected="true">
                <BzBubble Variant="BubbleVariant.Secondary">
                    <BzBubbleContent>Three quick things.</BzBubbleContent>
                </BzBubble>
                <BzBubble Variant="BubbleVariant.Secondary">
                    <BzBubbleContent>The registry build is fixed.</BzBubbleContent>
                </BzBubble>
            </BzBubbleGroup>
        </BzMessageContent>
    </BzMessage>
    <BzMessage>
        <BzMessageAvatar />
        <BzMessageContent>
            <BzBubble Variant="BubbleVariant.Secondary" Tail="BubbleTail.Bottom">
                <BzBubbleContent>And the docs preview is back up.</BzBubbleContent>
            </BzBubble>
        </BzMessageContent>
    </BzMessage>
</BzMessageGroup>
