@* One avatar, one header, a run of bubbles: MessageGroup keeps the sender's turn together. *@
<BzMessage Class="max-w-md">
    <BzMessageAvatar>
        <BzAvatar>
            <BzAvatarImage Src="https://i.pravatar.cc/120?img=12" Alt="Rania" />
            <BzAvatarFallback>RA</BzAvatarFallback>
        </BzAvatar>
    </BzMessageAvatar>
    <BzMessageContent>
        <BzMessageHeader>Rania</BzMessageHeader>
        <BzMessageGroup Class="gap-0.5">
            <BzBubble Variant="BubbleVariant.Secondary">
                <BzBubbleContent>Three quick things.</BzBubbleContent>
            </BzBubble>
            <BzBubble Variant="BubbleVariant.Secondary">
                <BzBubbleContent>The registry build is fixed.</BzBubbleContent>
            </BzBubble>
            <BzBubble Variant="BubbleVariant.Secondary" Tail="true">
                <BzBubbleContent>And the docs preview is back up.</BzBubbleContent>
            </BzBubble>
        </BzMessageGroup>
    </BzMessageContent>
</BzMessage>
