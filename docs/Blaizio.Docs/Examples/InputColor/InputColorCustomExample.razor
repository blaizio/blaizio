<div class="flex flex-wrap items-center justify-center gap-4">
    <BzInputColor @bind-Value="_color"
                  Class="rounded-full border-indigo-500/60 px-4 focus-within:border-indigo-500 focus-within:ring-indigo-500/40" />

    @* A root width lets the text field grow into it. *@
    <BzInputColor @bind-Value="_wide" Format="ColorFormat.Hsl" Class="w-72" />
</div>

@code {
    private string? _color = "#6366f1";
    private string? _wide = "hsl(239 84% 67%)";
}
