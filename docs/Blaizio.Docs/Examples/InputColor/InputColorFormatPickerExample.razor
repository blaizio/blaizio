<div class="flex flex-col items-center gap-3">
    <BzInputColor @bind-Value="_color" @bind-Format="_format" ShowFormatPicker />
    <p class="text-sm text-muted-foreground">Format: <span class="font-mono">@_format</span></p>
</div>

@code {
    private string? _color = "#2563eb";
    private ColorFormat _format = ColorFormat.Hex;
}
