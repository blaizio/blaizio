@* Type any color: hex without the #, a bare channel list, any color function - the field converts
   it into its format on blur or Enter. Text that does not parse stays flagged invalid. *@
<div class="flex flex-col items-center gap-3">
    <BzInputColor @bind-Value="_color" ShowPicker="false" />
    <p class="text-sm text-muted-foreground">Try <span class="font-mono">f80</span>, <span class="font-mono">37 99 235</span> or <span class="font-mono">hsl(330 80% 50%)</span>.</p>
</div>

@code {
    private string? _color = "#2563eb";
}
