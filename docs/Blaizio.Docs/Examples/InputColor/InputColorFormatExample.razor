<div class="flex flex-wrap items-center justify-center gap-4">
    <BzInputColor @bind-Value="_rgb" Format="ColorFormat.Rgb" />
    <BzInputColor @bind-Value="_hsl" Format="ColorFormat.Hsl" />
    <BzInputColor @bind-Value="_oklch" Format="ColorFormat.Oklch" />
</div>

@code {
    private string? _rgb = "rgb(37 99 235)";
    private string? _hsl = "hsl(217 91% 60%)";
    private string? _oklch = "oklch(0.55 0.19 262)";
}
