<div class="w-full max-w-sm">
    <BzFieldGroup>
        <BzField>
            <BzFieldLabel For="fld-username">Username</BzFieldLabel>
            <BzInputText id="fld-username" Placeholder="blaizio" @bind-Value="_username" />
            <BzFieldDescription>Choose a unique username for your account.</BzFieldDescription>
        </BzField>
        <BzField>
            <BzFieldLabel For="fld-password">Password</BzFieldLabel>
            <BzInputText id="fld-password" Type="password" Placeholder="********" @bind-Value="_password" />
            <BzFieldDescription>Must be at least 8 characters long.</BzFieldDescription>
        </BzField>
        <BzField>
            <BzFieldLabel For="fld-feedback">Feedback</BzFieldLabel>
            <BzInputText id="fld-feedback" Rows="3" Placeholder="Your feedback helps us improve…" @bind-Value="_feedback" />
            <BzFieldDescription>Share what's working and what isn't.</BzFieldDescription>
        </BzField>
    </BzFieldGroup>
</div>

@code {
    private string? _username;
    private string? _password;
    private string? _feedback;
}
