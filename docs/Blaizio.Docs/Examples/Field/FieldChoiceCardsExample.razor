@* The label wraps the whole card, so clicking anywhere toggles the checkbox. *@
<div class="w-full max-w-sm">
    <BzFieldGroup Class="gap-3">
        <BzFieldLabel Class="cursor-pointer rounded-xl border p-4 transition-colors hover:bg-accent/40 has-[[data-state=checked]]:border-primary has-[[data-state=checked]]:bg-primary/5">
            <BzField Orientation="FieldOrientation.Horizontal">
                <BzCheckbox DefaultChecked="CheckedState.Checked" />
                <BzFieldContent>
                    <BzFieldTitle>Nightly builds</BzFieldTitle>
                    <BzFieldDescription>Get the freshest bits every morning.</BzFieldDescription>
                </BzFieldContent>
            </BzField>
        </BzFieldLabel>
        <BzFieldLabel Class="cursor-pointer rounded-xl border p-4 transition-colors hover:bg-accent/40 has-[[data-state=checked]]:border-primary has-[[data-state=checked]]:bg-primary/5">
            <BzField Orientation="FieldOrientation.Horizontal">
                <BzCheckbox />
                <BzFieldContent>
                    <BzFieldTitle>Release notes</BzFieldTitle>
                    <BzFieldDescription>A digest email when a stable version ships.</BzFieldDescription>
                </BzFieldContent>
            </BzField>
        </BzFieldLabel>
    </BzFieldGroup>
</div>
