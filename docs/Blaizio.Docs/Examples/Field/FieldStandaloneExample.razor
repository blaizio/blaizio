<div class="w-full max-w-sm">
    <BzField Orientation="FieldOrientation.Horizontal"
           Error="@(_subscribe == CheckedState.Checked ? null : "Please confirm to continue.")">
        <BzFieldControl Context="ctl">
            <BzCheckbox @attributes="ctl" @bind-Checked="_subscribe" />
        </BzFieldControl>
        <BzFieldContent>
            <BzFieldLabel>Subscribe to the newsletter</BzFieldLabel>
            <BzFieldError />
        </BzFieldContent>
    </BzField>
</div>

@code {
    private CheckedState _subscribe = CheckedState.Unchecked;
}
