<RtlDemo Context="t">
    <BzDirectionProvider Dir="Direction.Rtl">
        <div class="w-full max-w-sm">
            <BzFieldGroup>
                <BzFieldSet>
                    <BzFieldLegend>@t["الإشعارات", "התראות"]</BzFieldLegend>
                    <BzFieldDescription>@t["كيف يمكننا التواصل معك؟", "איך נוכל ליצור איתך קשר?"]</BzFieldDescription>
                    <BzFieldGroup>
                        <BzField Orientation="FieldOrientation.Horizontal">
                            <BzCheckbox id="notif-email-rtl" DefaultChecked="CheckedState.Checked" />
                            <BzFieldLabel Class="!w-auto" For="notif-email-rtl">@t["البريد الإلكتروني", "אימייל"]</BzFieldLabel>
                        </BzField>
                        <BzField Orientation="FieldOrientation.Horizontal">
                            <BzCheckbox id="notif-sms-rtl" />
                            <BzFieldLabel Class="!w-auto" For="notif-sms-rtl">@t["الرسائل النصية", "מסרונים"]</BzFieldLabel>
                        </BzField>
                    </BzFieldGroup>
                </BzFieldSet>
                <BzFieldSeparator>@t["أو", "או"]</BzFieldSeparator>
                <BzField Orientation="FieldOrientation.Horizontal">
                    <BzFieldControl Context="ctl">
                        <BzSwitch @attributes="ctl" @bind-Checked="_mute" />
                    </BzFieldControl>
                    <BzFieldContent>
                        <BzFieldTitle>@t["كتم كل شيء", "השתק הכל"]</BzFieldTitle>
                        <BzFieldDescription>@t["لا إشعارات على الإطلاق، في أي مكان.", "בלי התראות בכלל, בשום מקום."]</BzFieldDescription>
                    </BzFieldContent>
                </BzField>
            </BzFieldGroup>
        </div>
    </BzDirectionProvider>
</RtlDemo>

@code {
    private bool _mute;
}
