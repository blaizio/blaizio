@* Vertical when narrow; the label flips beside the control when the group is wide. *@
<div class="w-full max-w-2xl">
    <BzFieldGroup>
        <BzField Orientation="FieldOrientation.Responsive">
            <BzFieldContent>
                <BzFieldLabel For="resp-name">Display name</BzFieldLabel>
                <BzFieldDescription>Shown on your public profile.</BzFieldDescription>
            </BzFieldContent>
            <BzInputText id="resp-name" placeholder="Ada Lovelace" Class="sm:max-w-xs" />
        </BzField>
        <BzFieldSeparator />
        <BzField Orientation="FieldOrientation.Responsive">
            <BzFieldContent>
                <BzFieldLabel For="resp-bio">Bio</BzFieldLabel>
                <BzFieldDescription>A short line about you.</BzFieldDescription>
            </BzFieldContent>
            <BzInputText id="resp-bio" placeholder="Mathematician & programmer" Class="sm:max-w-xs" />
        </BzField>
    </BzFieldGroup>
</div>
