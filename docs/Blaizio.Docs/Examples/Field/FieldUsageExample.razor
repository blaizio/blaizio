<BzField Orientation="FieldOrientation.Horizontal" Error="@(_optIn ? null : "Turn this on to continue.")">
    <BzFieldControl Context="ctl">
        <BzSwitch @attributes="ctl" @bind-Checked="_optIn" />
    </BzFieldControl>
    <BzFieldContent>
        <BzFieldLabel>Enable beta features</BzFieldLabel>
        <BzFieldDescription>Get early access to in-progress work.</BzFieldDescription>
        <BzFieldError />
    </BzFieldContent>
</BzField>

@code {
    private bool _optIn;
}
