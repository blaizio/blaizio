@* Bind the picked color to anything - here a card restyles itself live. *@
<div class="flex flex-wrap items-center gap-8">
    <BzColorPicker @bind-Value="_accent" ShowPreview="false" ShowInput="false" />

    <div class="w-56 rounded-xl border p-4 shadow-sm" style="border-color:@_accent">
        <div class="mb-2 size-8 rounded-md" style="background:@_accent"></div>
        <p class="text-sm font-semibold">Brand accent</p>
        <p class="text-muted-foreground text-xs">Every element on this card reads the picked color.</p>
        <button type="button" class="mt-3 h-8 w-full rounded-md text-xs font-medium text-white" style="background:@_accent">
            Continue
        </button>
    </div>
</div>

@code {
    private string? _accent = "#7c3aed";
}
