<div class="flex flex-wrap items-start gap-6">
    <div class="flex flex-col items-center gap-2">
        <BzColorPicker @bind-Value="_hex" Size="ColorPickerSize.Sm" ShowPreview="false" />
        <span class="text-muted-foreground font-mono text-xs">@_hex</span>
    </div>
    <div class="flex flex-col items-center gap-2">
        <BzColorPicker @bind-Value="_hwb" Format="ColorFormat.Hwb" Size="ColorPickerSize.Sm" ShowPreview="false" />
        <span class="text-muted-foreground font-mono text-xs">@_hwb</span>
    </div>
    <div class="flex flex-col items-center gap-2">
        <BzColorPicker @bind-Value="_oklch" Format="ColorFormat.Oklch" Size="ColorPickerSize.Sm" ShowPreview="false" />
        <span class="text-muted-foreground font-mono text-xs">@_oklch</span>
    </div>
</div>

@code {
    private string? _hex = "#0d9488";
    private string? _hwb = "hwb(175 5% 42%)";
    private string? _oklch = "oklch(0.585 0.106 183.5)";
}
