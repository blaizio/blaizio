<div class="flex flex-wrap items-start gap-6">
    <div class="flex flex-col items-center gap-2">
        <BzColorPicker @bind-Value="_hex" Size="ColorPickerSize.Sm" ShowPreview="false" />
        <span class="text-muted-foreground font-mono text-xs">@_hex</span>
    </div>
    <div class="flex flex-col items-center gap-2">
        <BzColorPicker @bind-Value="_rgb" Format="ColorFormat.Rgb" Size="ColorPickerSize.Sm" ShowPreview="false" />
        <span class="text-muted-foreground font-mono text-xs">@_rgb</span>
    </div>
    <div class="flex flex-col items-center gap-2">
        <BzColorPicker @bind-Value="_hsl" Format="ColorFormat.Hsl" Size="ColorPickerSize.Sm" ShowPreview="false" />
        <span class="text-muted-foreground font-mono text-xs">@_hsl</span>
    </div>
</div>

@code {
    private string? _hex = "#0d9488";
    private string? _rgb = "rgb(13 148 136)";
    private string? _hsl = "hsl(175 84% 32%)";
}
