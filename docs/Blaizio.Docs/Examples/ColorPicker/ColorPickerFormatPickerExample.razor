<div class="flex flex-col items-center gap-3">
    <BzColorPicker @bind-Value="_color" @bind-Format="_format" ShowFormatPicker ShowAlpha />
    <p class="text-muted-foreground text-sm">
        <span class="font-mono">@_format</span> · <span class="font-mono">@_color</span>
    </p>
</div>

@code {
    private string? _color = "#7c3aed";
    private ColorFormat _format = ColorFormat.Hex;
}
