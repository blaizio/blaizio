@* Opacity on its own: a fixed brand color, only its transparency is up for editing. *@
<BzColorPicker @bind-Value="_color" ShowAlpha Format="ColorFormat.Rgb">
    <div class="flex items-center gap-2">
        <BzColorAlphaSlider Class="min-w-0 grow" />
        <BzColorOpacityInput />
    </div>
</BzColorPicker>

@code {
    private string? _color = "rgba(37, 99, 235, 0.6)";
}
