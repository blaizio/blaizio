@* The plus banks the current color; click a saved swatch to apply, the corner x removes.
   Bind SavedColors to persist the list wherever you like (here it just echoes). *@
<div class="flex flex-col items-center gap-3">
    <BzColorPicker @bind-Value="_color" @bind-SavedColors="_saved" ShowSaved />
    <p class="text-muted-foreground text-xs">@_saved.Count saved</p>
</div>

@code {
    private string? _color = "#0d9488";
    private IReadOnlyList<string> _saved = ["#ef4444", "#2563eb"];
}
