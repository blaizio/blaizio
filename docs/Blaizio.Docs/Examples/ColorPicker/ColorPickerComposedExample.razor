@* Compose the parts yourself - here a minimal area + hue pair, and swatches with custom labels. *@
<BzColorPicker @bind-Value="_color">
    <BzColorArea />
    <BzColorHueSlider />
    <BzColorSwatches>
        <BzColorSwatch Color="#0d9488" AriaLabel="Teal" />
        <BzColorSwatch Color="#2563eb" AriaLabel="Blue" />
        <BzColorSwatch Color="#7c3aed" AriaLabel="Violet" />
    </BzColorSwatches>
</BzColorPicker>

@code {
    private string? _color = "#0d9488";
}
