@* The matching swatch marks itself selected as the color changes. *@
<BzColorPicker @bind-Value="_color" Swatches="_brand" />

@code {
    private string? _color = "#2563eb";

    private static readonly string[] _brand =
    [
        "#ef4444", "#f97316", "#eab308", "#22c55e", "#0d9488",
        "#2563eb", "#7c3aed", "#db2777", "#78716c", "#1c1917",
    ];
}
