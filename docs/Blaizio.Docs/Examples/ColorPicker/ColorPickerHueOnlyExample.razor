@* Hue on its own: the root stays the state owner, the slider is the only surface. *@
<div class="flex flex-col items-center gap-3">
    <BzColorPicker @bind-Value="_color">
        <BzColorHueSlider />
    </BzColorPicker>
    <div class="size-10 rounded-full border" style="background:@_color"></div>
</div>

@code {
    private string? _color = "#e11d48";
}
