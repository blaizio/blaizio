<div class="flex flex-col items-center gap-4">
    <BzRadioGroup @bind-Value="_plan">
        <div class="flex items-center gap-2"><BzRadioGroupItem id="p-free" Value="free" /><BzLabel For="p-free">Free</BzLabel></div>
        <div class="flex items-center gap-2"><BzRadioGroupItem id="p-pro" Value="pro" /><BzLabel For="p-pro">Pro</BzLabel></div>
        <div class="flex items-center gap-2"><BzRadioGroupItem id="p-team" Value="team" /><BzLabel For="p-team">Team</BzLabel></div>
    </BzRadioGroup>
    <p class="text-sm text-muted-foreground">Selected: <span class="font-mono">@(_plan ?? "(none)")</span></p>
</div>

@code { private string? _plan = "pro"; }
