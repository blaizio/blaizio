<BzRadioGroup DefaultValue="comfortable" Class="w-full max-w-sm gap-4">
    <BzField Orientation="FieldOrientation.Horizontal">
        <BzRadioGroupItem id="fd-standard" Value="default" />
        <BzFieldContent>
            <BzFieldLabel For="fd-standard">Standard</BzFieldLabel>
            <BzFieldDescription>The default spacing for most interfaces.</BzFieldDescription>
        </BzFieldContent>
    </BzField>
    <BzField Orientation="FieldOrientation.Horizontal">
        <BzRadioGroupItem id="fd-comfortable" Value="comfortable" />
        <BzFieldContent>
            <BzFieldLabel For="fd-comfortable">Comfortable</BzFieldLabel>
            <BzFieldDescription>More breathing room between rows.</BzFieldDescription>
        </BzFieldContent>
    </BzField>
    <BzField Orientation="FieldOrientation.Horizontal">
        <BzRadioGroupItem id="fd-compact" Value="compact" />
        <BzFieldContent>
            <BzFieldLabel For="fd-compact">Compact</BzFieldLabel>
            <BzFieldDescription>Dense rows for data-heavy screens.</BzFieldDescription>
        </BzFieldContent>
    </BzField>
</BzRadioGroup>
