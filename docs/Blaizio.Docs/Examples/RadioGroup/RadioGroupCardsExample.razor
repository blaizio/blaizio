<BzRadioGroup AriaLabel="Plan" DefaultValue="pro" Class="w-full max-w-sm gap-3">
    @foreach (var (value, name, blurb) in _plans)
    {
        @* The label wraps the whole card, so clicking anywhere picks the plan. *@
        <BzFieldLabel Class="cursor-pointer rounded-xl border p-4 transition-colors hover:bg-accent/40 has-[[data-state=checked]]:border-primary has-[[data-state=checked]]:bg-primary/5">
            <BzField Orientation="FieldOrientation.Horizontal">
                <BzRadioGroupItem Value="@value" aria-label="@name" />
                <BzFieldContent>
                    <BzFieldTitle>@name</BzFieldTitle>
                    <BzFieldDescription>@blurb</BzFieldDescription>
                </BzFieldContent>
            </BzField>
        </BzFieldLabel>
    }
</BzRadioGroup>

@code {
    private static readonly (string Value, string Name, string Blurb)[] _plans =
    [
        ("plus", "Plus", "For personal projects and hobby work."),
        ("pro", "Pro", "Team seats, priority builds, advanced analytics."),
        ("enterprise", "Enterprise", "SSO, audit logs, and a dedicated contact."),
    ];
}
