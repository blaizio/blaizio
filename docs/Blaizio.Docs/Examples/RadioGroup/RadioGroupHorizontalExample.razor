<BzRadioGroup AriaLabel="Payment method" DefaultValue="card" Orientation="Orientation.Horizontal" Class="flex gap-6">
    <div class="flex items-center gap-2">
        <BzRadioGroupItem id="h-card" Value="card" />
        <BzLabel For="h-card">Card</BzLabel>
    </div>
    <div class="flex items-center gap-2">
        <BzRadioGroupItem id="h-wallet" Value="wallet" />
        <BzLabel For="h-wallet">Wallet</BzLabel>
    </div>
    <div class="flex items-center gap-2">
        <BzRadioGroupItem id="h-bank" Value="bank" />
        <BzLabel For="h-bank">Bank transfer</BzLabel>
    </div>
</BzRadioGroup>
