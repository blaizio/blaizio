<RtlDemo Context="t">
    <BzDirectionProvider Direction="Direction.Rtl">
        <BzRadioGroup DefaultValue="comfortable">
            <div class="flex items-center gap-2">
                <BzRadioGroupItem id="rtl-default" Value="default" />
                <BzLabel For="rtl-default">@t["افتراضي", "ברירת מחדל"]</BzLabel>
            </div>
            <div class="flex items-center gap-2">
                <BzRadioGroupItem id="rtl-comfortable" Value="comfortable" />
                <BzLabel For="rtl-comfortable">@t["مريح", "נוח"]</BzLabel>
            </div>
            <div class="flex items-center gap-2">
                <BzRadioGroupItem id="rtl-compact" Value="compact" />
                <BzLabel For="rtl-compact">@t["مضغوط", "קומפקטי"]</BzLabel>
            </div>
        </BzRadioGroup>
    </BzDirectionProvider>
</RtlDemo>
