<BzField Error="@(_notify is null ? "Pick how you want to be notified." : null)" Class="w-full max-w-sm">
    <BzFieldLabel>Notify me about</BzFieldLabel>
    <BzRadioGroup @bind-Value="_notify" Class="gap-3 pt-1">
        <div class="flex items-center gap-2">
            <BzRadioGroupItem id="inv-all" Value="all" aria-invalid="@(_notify is null ? "true" : null)" />
            <BzLabel For="inv-all">All new messages</BzLabel>
        </div>
        <div class="flex items-center gap-2">
            <BzRadioGroupItem id="inv-mentions" Value="mentions" aria-invalid="@(_notify is null ? "true" : null)" />
            <BzLabel For="inv-mentions">Direct messages and mentions</BzLabel>
        </div>
        <div class="flex items-center gap-2">
            <BzRadioGroupItem id="inv-none" Value="none" aria-invalid="@(_notify is null ? "true" : null)" />
            <BzLabel For="inv-none">Nothing</BzLabel>
        </div>
    </BzRadioGroup>
    <BzFieldError />
</BzField>

@code { private string? _notify; }
