@implements IDisposable
@* While the reader is at the bottom the transcript follows the streamed reply; scrolling up
   disengages it, and the button (or reaching the bottom) re-engages. *@
<div class="flex w-full max-w-md flex-col items-center gap-3">
    <BzMessageScroller Class="h-80 rounded-xl border">
        <BzMessageScrollerViewport aria-label="Streaming conversation" Class="p-4">
            <BzMessageScrollerContent Class="gap-4">
                @foreach (var message in _messages)
                {
                    <BzMessageScrollerItem @key="message.Id" MessageId="@message.Id">
                        <BzBubble Align="@(message.Mine ? BubbleAlign.End : BubbleAlign.Start)"
                                  Variant="@(message.Mine ? BubbleVariant.Default : BubbleVariant.Ghost)">
                            <BzBubbleContent>@message.Text</BzBubbleContent>
                        </BzBubble>
                    </BzMessageScrollerItem>
                }
            </BzMessageScrollerContent>
        </BzMessageScrollerViewport>
        <BzMessageScrollerButton />
    </BzMessageScroller>
    <div class="flex items-center gap-2">
        <BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Disabled="@_streaming" @onclick="Stream">
            Stream a reply
        </BzButton>
        <BzTooltip>
            <BzTooltipTrigger>
                <RenderAs Context="p">
                    <BzButton @attributes="p.Attributes" Variant="ButtonVariant.Outline" Size="ButtonSize.IconSm" aria-label="Start over" @onclick="Reset">
                        <BzIcon Icon="@Tabler.Outline.RotateClockwise" />
                    </BzButton>
                </RenderAs>
            </BzTooltipTrigger>
            <BzTooltipContent>
                Start over
                <BzTooltipArrow />
            </BzTooltipContent>
        </BzTooltip>
    </div>
</div>

@code {
    private sealed class Msg(string id, bool mine, string text)
    {
        public string Id { get; } = id;
        public bool Mine { get; } = mine;
        public string Text { get; set; } = text;
    }

    private const string Reply =
        "Streaming keeps the transcript glued to the live edge, but only while you are already " +
        "reading it. Scroll up mid-stream and the view stays put so you can finish the earlier " +
        "message; the scroll button drops you back onto the live edge whenever you are ready.";

    private readonly List<Msg> _messages = [new("1", true, "Explain how auto-scroll behaves while streaming?")];
    private CancellationTokenSource _cts = new();
    private bool _streaming;
    private int _next = 2;

    private async Task Stream()
    {
        _streaming = true;
        var token = _cts.Token;
        var reply = new Msg($"{_next++}", false, "");
        _messages.Add(reply);
        try
        {
            foreach (var word in Reply.Split(' '))
            {
                await Task.Delay(70, token);
                reply.Text = reply.Text.Length == 0 ? word : $"{reply.Text} {word}";
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) { }
        _streaming = false;
    }

    private void Reset()
    {
        _cts.Cancel();
        _cts = new();
        _messages.Clear();
        _messages.Add(new("1", true, "Explain how auto-scroll behaves while streaming?"));
        _next = 2;
    }

    public void Dispose() => _cts.Cancel();
}
