<div class="space-y-3">
    <p class="text-muted-foreground text-sm">Selected: <span class="text-foreground font-medium tabular-nums">@(_dateText ?? "None")</span></p>
    @* No wrapper opacity: dimming the whole calendar drags its header text under AA contrast;
       the component's own disabled styling already communicates the state. *@
    <BzCalendar @bind-Value="_date" @bind-ValueFormatted="_dateText" Disabled Class="rounded-md border p-3 shadow-sm" />
</div>

@code {
    private DateOnly? _date = DateOnly.FromDateTime(DateTime.Today);
    private string? _dateText;
}
