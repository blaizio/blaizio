@using System.Globalization

<BzDirectionProvider Dir="Direction.Rtl">
    <div class="space-y-3">
        <p class="text-muted-foreground text-sm">الإختيار: <span class="text-foreground font-medium tabular-nums">@(_dateText ?? "لا شيء")</span></p>
        <BzCalendar @bind-Value="_date" @bind-ValueFormatted="_dateText" Culture="_arabic" NativeDigits="false" Class="rounded-md border p-3 shadow-sm" />
    </div>
</BzDirectionProvider>

@code {
    // Umm al-Qura, named outright. A bare "ar-SA" starts in the calendar the platform's culture
    // data gives it, and on a Linux server with recent data that is the Gregorian one.
    private static readonly CultureInfo _arabic = Hijri();

    private static CultureInfo Hijri()
    {
        var culture = new CultureInfo("ar-SA");
        culture.DateTimeFormat.Calendar = new UmAlQuraCalendar();
        return culture;
    }
    private DateOnly? _date = DateOnly.FromDateTime(DateTime.Today);
    private string? _dateText;
}
