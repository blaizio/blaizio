@using System.Globalization

<BzDirectionProvider Dir="Direction.Rtl">
    <div class="space-y-3">
        <p class="text-muted-foreground text-sm">الإختيار: <span class="text-foreground font-medium tabular-nums">@(_dateText ?? "لا شيء")</span></p>
        <BzCalendar @bind-Value="_date" @bind-ValueFormatted="_dateText" Culture="_arabic" Class="rounded-md border p-3 shadow-sm" />
    </div>
</BzDirectionProvider>

@code {
    private static readonly CultureInfo _arabic = new("ar-SA");
    private DateOnly? _date = DateOnly.FromDateTime(DateTime.Today);
    private string? _dateText;
}
