@using System.Globalization

<div class="space-y-3">
    <p class="text-muted-foreground text-sm">Ausgewählt: <span class="text-foreground font-medium tabular-nums">@(_dateText ?? "Keine")</span></p>
    <BzCalendar @bind-Value="_date" @bind-ValueFormatted="_dateText" Culture="_german" Class="rounded-md border p-3 shadow-sm" />
</div>

@code {
    private static readonly CultureInfo _german = new("de-DE");
    private DateOnly? _date = DateOnly.FromDateTime(DateTime.Today);
    private string? _dateText;
}
