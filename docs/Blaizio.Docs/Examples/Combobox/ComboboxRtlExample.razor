<BzDirectionProvider Direction="Direction.Rtl">
    <BzCombobox Items="_arabicCities">
        <BzComboboxInput Placeholder="اختر مدينة" Class="w-64" />
        <BzComboboxContent>
            <BzComboboxEmpty>لا توجد نتائج.</BzComboboxEmpty>
            <BzComboboxList Context="item">
                <BzComboboxItem Value="@item">@item</BzComboboxItem>
            </BzComboboxList>
        </BzComboboxContent>
    </BzCombobox>
</BzDirectionProvider>

@code {
    private static readonly string[] _arabicCities =
        ["دبي", "أبوظبي", "الرياض", "جدة", "القاهرة", "عمّان", "بيروت", "الدوحة"];
}
