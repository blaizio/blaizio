<RtlDemo Context="t">
    <BzDirectionProvider Dir="Direction.Rtl">
        <BzCombobox Items="_cities" ItemToStringValue="@(c => t[c.Ar, c.He])">
            <BzComboboxInput Placeholder='@t["اختر مدينة", "בחר עיר"]' Class="w-64" />
            <BzComboboxContent>
                <BzComboboxEmpty>@t["لا توجد نتائج.", "אין תוצאות."]</BzComboboxEmpty>
                <BzComboboxList Context="item">
                    <BzComboboxItem Value="@item">@t[item.Ar, item.He]</BzComboboxItem>
                </BzComboboxList>
            </BzComboboxContent>
        </BzCombobox>
    </BzDirectionProvider>
</RtlDemo>

@code {
    private static readonly (string Ar, string He)[] _cities =
    [
        ("دبي", "דובאי"), ("أبوظبي", "אבו דאבי"), ("الرياض", "ריאד"), ("جدة", "ג׳דה"),
        ("القاهرة", "קהיר"), ("عمّان", "עמאן"), ("بيروت", "ביירות"), ("الدوحة", "דוחה"),
    ];
}
