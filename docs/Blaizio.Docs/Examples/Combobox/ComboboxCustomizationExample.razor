<BzCombobox Items="_frameworks" AutoHighlight>
    <BzComboboxInput Placeholder="Select a framework"
                     Class="w-64 rounded-lg border-indigo-300 focus-within:ring-indigo-500/40 dark:border-indigo-800" />
    <BzComboboxContent Class="rounded-lg [&_[data-slot=combobox-item][data-highlighted]]:bg-indigo-600 [&_[data-slot=combobox-item][data-highlighted]]:text-white">
        <BzComboboxEmpty>No framework found.</BzComboboxEmpty>
        <BzComboboxList Context="item">
            <BzComboboxItem Value="@item">@item</BzComboboxItem>
        </BzComboboxList>
    </BzComboboxContent>
</BzCombobox>

@code {
    private static readonly string[] _frameworks =
        ["ASP.NET Core", "Blazor", "MAUI", "Avalonia", "Uno Platform"];
}
