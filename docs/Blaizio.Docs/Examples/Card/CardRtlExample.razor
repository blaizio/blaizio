<RtlDemo Context="t">
    <BzDirectionProvider Direction="Direction.Rtl">
        <BzCard Class="w-full max-w-sm">
            <BzCardHeader>
                <BzCardTitle>@t["انشر مشروعك", "פרסם את הפרויקט שלך"]</BzCardTitle>
                <BzCardDescription>@t["ادفع إلى شبكة الحافة العالمية بنقرة واحدة.", "דחוף אל רשת הקצה העולמית בלחיצה אחת."]</BzCardDescription>
                <BzCardAction>
                    <BzBadge Variant="BadgeVariant.Secondary">@t["احترافي", "מקצועי"]</BzBadge>
                </BzCardAction>
            </BzCardHeader>
            <BzCardContent>
                <p class="text-sm text-muted-foreground">
                    @t["سيُبنى مشروعك ويُقدَّم من أقرب موقع لكل زائر.", "הפרויקט שלך ייבנה ויוגש מהמיקום הקרוב ביותר לכל מבקר."]
                </p>
            </BzCardContent>
            <BzCardFooter Class="justify-between border-t">
                <BzButton Variant="ButtonVariant.Outline">@t["إلغاء", "ביטול"]</BzButton>
                <BzButton>@t["نشر", "פרסום"]</BzButton>
            </BzCardFooter>
        </BzCard>
    </BzDirectionProvider>
</RtlDemo>
