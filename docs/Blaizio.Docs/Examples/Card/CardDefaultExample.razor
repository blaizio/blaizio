<BzCard Class="w-full max-w-sm">
    <BzCardHeader>
        <BzCardTitle>Deploy your project</BzCardTitle>
        <BzCardDescription>Push to the global edge network in one click.</BzCardDescription>
        <BzCardAction>
            <BzBadge Variant="BadgeVariant.Secondary">Pro</BzBadge>
        </BzCardAction>
    </BzCardHeader>
    <BzCardContent>
        <p class="text-sm text-muted-foreground">
            Your project will be built and served from the location closest to each visitor.
        </p>
    </BzCardContent>
    <BzCardFooter Class="justify-between border-t">
        <BzButton Variant="ButtonVariant.Outline">Cancel</BzButton>
        <BzButton>Deploy</BzButton>
    </BzCardFooter>
</BzCard>
