<div class="flex w-full flex-wrap justify-center gap-6">
    @* Kebab menu at the top - drop the dropdown in the header's BzCardAction. *@
    <BzCard Class="w-full max-w-sm">
        <BzCardHeader>
            <BzCardTitle>Q3 Marketing Site</BzCardTitle>
            <BzCardDescription>Updated 2 days ago by Sarah.</BzCardDescription>
            <BzCardAction>
                <BzDropdownMenu>
                    <BzDropdownMenuTrigger>
                        <RenderAs Context="p">
                            <BzButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8" @attributes="p.Attributes">
                                <BzIcon Icon="@Icons.Outline.DotsVertical" />
                                <span class="sr-only">Open menu</span>
                            </BzButton>
                        </RenderAs>
                    </BzDropdownMenuTrigger>
                    <BzDropdownMenuContent Align="Align.End">
                        <BzDropdownMenuItem>Edit</BzDropdownMenuItem>
                        <BzDropdownMenuItem>Duplicate</BzDropdownMenuItem>
                        <BzDropdownMenuSeparator />
                        <BzDropdownMenuItem Variant="DropdownMenuItemVariant.Destructive">Delete</BzDropdownMenuItem>
                    </BzDropdownMenuContent>
                </BzDropdownMenu>
            </BzCardAction>
        </BzCardHeader>
        <BzCardContent>
            <p class="text-sm text-muted-foreground">The landing pages and campaign assets for the autumn launch.</p>
        </BzCardContent>
    </BzCard>

    @* Kebab menu at the bottom - put it in the footer and open it upward with Side. *@
    <BzCard Class="w-full max-w-sm">
        <BzCardHeader>
            <BzCardTitle>Design System</BzCardTitle>
            <BzCardDescription>Shared tokens and components.</BzCardDescription>
        </BzCardHeader>
        <BzCardContent>
            <p class="text-sm text-muted-foreground">The single source of truth for product UI.</p>
        </BzCardContent>
        <BzCardFooter Class="justify-between border-t">
            <p class="text-xs text-muted-foreground">12 contributors</p>
            <BzDropdownMenu>
                <BzDropdownMenuTrigger>
                    <RenderAs Context="p">
                        <BzButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8" @attributes="p.Attributes">
                            <BzIcon Icon="@Icons.Outline.DotsVertical" />
                            <span class="sr-only">Open menu</span>
                        </BzButton>
                    </RenderAs>
                </BzDropdownMenuTrigger>
                <BzDropdownMenuContent Align="Align.End" Side="Side.Top">
                    <BzDropdownMenuItem>Share</BzDropdownMenuItem>
                    <BzDropdownMenuItem>Export</BzDropdownMenuItem>
                    <BzDropdownMenuSeparator />
                    <BzDropdownMenuItem Variant="DropdownMenuItemVariant.Destructive">Archive</BzDropdownMenuItem>
                </BzDropdownMenuContent>
            </BzDropdownMenu>
        </BzCardFooter>
    </BzCard>
</div>
