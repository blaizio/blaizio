<BzButtonGroup>
    <BzSelect @bind-Value="_currency">
        <BzSelectTrigger Class="w-24" aria-label="Currency">
            <BzSelectValue />
        </BzSelectTrigger>
        <BzSelectContent>
            <BzSelectItem Value="usd">$ USD</BzSelectItem>
            <BzSelectItem Value="eur">&euro; EUR</BzSelectItem>
            <BzSelectItem Value="gbp">&pound; GBP</BzSelectItem>
        </BzSelectContent>
    </BzSelect>
    <BzInputText @bind-Value="_amount" Placeholder="10.00" aria-label="Amount" Class="w-28" />
    <BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" aria-label="Send payment">
        <BzIcon Icon="@Icons.Outline.ArrowRight" />
    </BzButton>
</BzButtonGroup>

@code {
    private string? _currency = "usd";
    private string? _amount;
}
