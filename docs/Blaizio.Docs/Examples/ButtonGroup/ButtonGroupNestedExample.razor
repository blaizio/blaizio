<BzButtonGroup>
    <BzButtonGroup>
        <BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSm" aria-label="Undo">
            <BzIcon Icon="@Tabler.Outline.ArrowBackUp" />
        </BzButton>
        <BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSm" aria-label="Redo">
            <BzIcon Icon="@Tabler.Outline.ArrowForwardUp" />
        </BzButton>
    </BzButtonGroup>
    <BzButtonGroup>
        <BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSm" aria-label="Bold">
            <BzIcon Icon="@Tabler.Outline.Bold" />
        </BzButton>
        <BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSm" aria-label="Italic">
            <BzIcon Icon="@Tabler.Outline.Italic" />
        </BzButton>
        <BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSm" aria-label="Underline">
            <BzIcon Icon="@Tabler.Outline.Underline" />
        </BzButton>
    </BzButtonGroup>
</BzButtonGroup>
