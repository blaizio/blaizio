<BzButtonGroup Orientation="Orientation.Vertical">
    <BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSm" aria-label="Zoom in">
        <BzIcon Icon="@Icons.Outline.Plus" />
    </BzButton>
    <BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSm" aria-label="Zoom out">
        <BzIcon Icon="@Icons.Outline.Minus" />
    </BzButton>
    <BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSm" aria-label="Reset zoom">
        <BzIcon Icon="@Icons.Outline.Maximize" />
    </BzButton>
</BzButtonGroup>
