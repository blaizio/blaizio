<BzButtonGroup>
    <BzButton Variant="ButtonVariant.Outline">
        <BzIcon Icon="@Icons.Outline.Clock" /> Schedule
    </BzButton>
    <BzPopover>
        <BzPopoverTrigger>
            <RenderAs Context="p">
                <BzButton @attributes="p.Attributes" Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" aria-label="Schedule options">
                    <BzIcon Icon="@Icons.Outline.ChevronDown" />
                </BzButton>
            </RenderAs>
        </BzPopoverTrigger>
        <BzPopoverContent Align="Align.End" Class="w-72">
            <BzPopoverHeader>
                <BzPopoverTitle>Schedule for later</BzPopoverTitle>
                <BzPopoverDescription>Pick when the message should go out.</BzPopoverDescription>
            </BzPopoverHeader>
            <div class="mt-3 flex justify-end">
                <BzPopoverClose Size="ButtonSize.Sm">Done</BzPopoverClose>
            </div>
        </BzPopoverContent>
    </BzPopover>
</BzButtonGroup>
