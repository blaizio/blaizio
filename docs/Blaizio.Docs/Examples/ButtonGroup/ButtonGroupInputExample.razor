<BzButtonGroup Class="w-full max-w-xs">
    <BzInputText @bind-Value="_query" placeholder="Search the docs..." aria-label="Search" />
    <BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" aria-label="Run search">
        <BzIcon Icon="@Icons.Outline.Search" />
    </BzButton>
</BzButtonGroup>

@code {
    private string? _query;
}
