<div class="flex flex-col items-center gap-4">
    <div class="flex flex-wrap items-center justify-center gap-4">
        @* int: whole numbers only - typing "2.7" is invalid, not a truncated 2. *@
        <div class="flex flex-col items-center gap-1.5">
            <BzInputNumber @bind-Value="_seats" Min="1" Max="12" Class="w-36" Label="Seats" />
            <span class="text-muted-foreground text-xs">int - @_seats</span>
        </div>
        @* decimal: exact money math - steps of 0.05 never pick up float drift. *@
        <div class="flex flex-col items-center gap-1.5">
            <BzInputNumber @bind-Value="_price" Min="0" Step="0.05" Format="C" Class="w-36" Label="Price" />
            <span class="text-muted-foreground text-xs">decimal - @_price.ToString(System.Globalization.CultureInfo.InvariantCulture)</span>
        </div>
        @* int?: nullable, so the field may rest empty - clearing it binds null. *@
        <div class="flex flex-col items-center gap-1.5">
            <BzInputNumber @bind-Value="_guests" Min="0" Max="20" Class="w-36" Label="Guests" />
            <span class="text-muted-foreground text-xs">int? - @(_guests?.ToString() ?? "(null)")</span>
        </div>
    </div>
</div>

@code {
    private int _seats = 4;
    private decimal _price = 19.95m;
    private int? _guests;
}
