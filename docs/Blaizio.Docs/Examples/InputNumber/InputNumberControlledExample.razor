<div class="flex flex-col items-center gap-4">
    <span class="text-muted-foreground text-sm">Quantity: @(_quantity?.ToString() ?? "(empty)")</span>
    <div class="flex items-center gap-4">
        <BzInputNumber @bind-Value="_quantity" Min="0" Max="99" Class="w-44" />
        <BzButton Variant="ButtonVariant.Secondary" @onclick="@(() => _quantity = 1)">Reset</BzButton>
    </div>
</div>

@code {
    private double? _quantity = 1;
}
