@* AutoSelect: focusing the field (click or Tab) selects the whole number, so typing replaces it
   outright - the pattern for amounts the user usually overwrites rather than edits in place. *@
<div class="grid w-full max-w-3xs gap-1.5">
    <BzInputNumber @bind-Value="_amount" AutoSelect Format="C" Min="0" />
    <p class="text-muted-foreground text-xs">Focus the field: the value arrives selected.</p>
</div>

@code {
    private decimal _amount = 249.99m;
}
