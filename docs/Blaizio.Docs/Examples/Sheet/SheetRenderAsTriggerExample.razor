<BzSheet>
    <BzSheetTrigger>
        <RenderAs Context="p">
            <a href="#" @onclick:preventDefault @attributes="p.Attributes" class="text-sm font-medium text-indigo-600 underline-offset-4 hover:underline dark:text-indigo-400">Open as a link</a>
        </RenderAs>
    </BzSheetTrigger>
    <BzSheetContent>
        <BzSheetHeader>
            <BzSheetTitle>Custom trigger</BzSheetTitle>
            <BzSheetDescription>This sheet was opened by an anchor, not a button.</BzSheetDescription>
        </BzSheetHeader>
        <BzSheetFooter>
            <BzSheetClose>Close</BzSheetClose>
        </BzSheetFooter>
    </BzSheetContent>
</BzSheet>
