<RtlDemo Context="t">
    <BzDirectionProvider Dir="Direction.Rtl">
        <BzSheet>
            <BzSheetTrigger Variant="ButtonVariant.Outline">@t["تعديل الملف الشخصي", "עריכת פרופיל"]</BzSheetTrigger>
            <BzSheetContent>
                <BzSheetHeader>
                    <BzSheetTitle>@t["تعديل الملف الشخصي", "עריכת פרופיל"]</BzSheetTitle>
                    <BzSheetDescription>@t["حدّث بياناتك. احفظ عند الانتهاء.", "עדכן את הפרטים שלך. שמור בסיום."]</BzSheetDescription>
                </BzSheetHeader>
                <div class="grid gap-4 px-4">
                    <div class="grid gap-2">
                        <BzLabel for="sheet-name-rtl">@t["الاسم", "שם"]</BzLabel>
                        <BzInputText id="sheet-name-rtl" Value='@t["آدا لوفلايس", "עדה לאבלייס"]' />
                    </div>
                    <div class="grid gap-2">
                        <BzLabel for="sheet-email-rtl">@t["البريد الإلكتروني", "אימייל"]</BzLabel>
                        <BzInputText id="sheet-email-rtl" Value="ada@example.com" />
                    </div>
                </div>
                <BzSheetFooter>
                    <BzSheetClose>@t["حفظ التغييرات", "שמירת שינויים"]</BzSheetClose>
                    <BzSheetClose Variant="ButtonVariant.Outline">@t["إلغاء", "ביטול"]</BzSheetClose>
                </BzSheetFooter>
            </BzSheetContent>
        </BzSheet>
    </BzDirectionProvider>
</RtlDemo>
