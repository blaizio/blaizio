@* The footer user row doubles as a dropdown trigger - compose via RenderAs so the menu button carries the trigger behaviour. *@
<div class="relative h-[480px] w-full overflow-hidden rounded-xl border [transform:translateZ(0)]">
    <BzSidebarProvider Class="h-full min-h-0">
        <BzSidebar Class="h-full">
            <BzSidebarHeader>
                <div class="flex items-center gap-2 px-1 py-1.5">
                    <div class="bg-sidebar-primary text-sidebar-primary-foreground flex aspect-square size-8 items-center justify-center rounded-lg">
                        <BzIcon Icon="@Icons.Outline.LayoutDashboard" />
                    </div>
                    <div class="grid flex-1 text-start text-sm leading-tight">
                        <span class="truncate font-semibold">Acme Inc</span>
                        <span class="text-muted-foreground truncate text-xs">Enterprise</span>
                    </div>
                </div>
            </BzSidebarHeader>
            <BzSidebarContent>
                <BzSidebarGroup>
                    <BzSidebarGroupLabel>Platform</BzSidebarGroupLabel>
                    <BzSidebarGroupContent>
                        <BzSidebarMenu>
                            @foreach (var (label, icon) in _nav)
                            {
                                <BzSidebarMenuItem>
                                    <BzSidebarMenuButton Active="@(_active == label)" @onclick="@(() => _active = label)">
                                        <BzIcon Icon="@icon" />
                                        <span>@label</span>
                                    </BzSidebarMenuButton>
                                </BzSidebarMenuItem>
                            }
                        </BzSidebarMenu>
                    </BzSidebarGroupContent>
                </BzSidebarGroup>
            </BzSidebarContent>
            <BzSidebarFooter>
                <BzSidebarMenu>
                    <BzSidebarMenuItem>
                        <BzDropdownMenu>
                            <BzDropdownMenuTrigger>
                                <RenderAs Context="p">
                                    <BzSidebarMenuButton Size="SidebarMenuButtonSize.Lg"
                                                         Class="data-[state=open]:bg-sidebar-accent data-[state=open]:text-sidebar-accent-foreground"
                                                         @attributes="p.Attributes">
                                        <BzAvatar Class="size-8 rounded-lg after:rounded-lg">
                                            <BzAvatarImage Src="avatars/benolimits.png" Alt="Beno Limits" Class="rounded-lg" />
                                            <BzAvatarFallback Class="rounded-lg">BL</BzAvatarFallback>
                                        </BzAvatar>
                                        <div class="grid flex-1 text-start text-sm leading-tight">
                                            <span class="truncate font-medium">Beno Limits</span>
                                            <span class="text-muted-foreground truncate text-xs">beno@@example.com</span>
                                        </div>
                                        <BzIcon Icon="@Icons.Outline.DotsVertical" Class="ms-auto" />
                                    </BzSidebarMenuButton>
                                </RenderAs>
                            </BzDropdownMenuTrigger>
                            <BzDropdownMenuContent Side="Side.Right" Align="Align.End" Class="w-56">
                                <BzDropdownMenuLabel>
                                    <div class="flex items-center gap-2">
                                        <BzAvatar Class="size-8 rounded-lg after:rounded-lg">
                                            <BzAvatarImage Src="avatars/benolimits.png" Alt="Beno Limits" Class="rounded-lg" />
                                            <BzAvatarFallback Class="rounded-lg">BL</BzAvatarFallback>
                                        </BzAvatar>
                                        <div class="grid flex-1 leading-tight">
                                            <span class="text-foreground truncate text-sm font-medium">Beno Limits</span>
                                            <span class="text-muted-foreground truncate text-xs font-normal">beno@@example.com</span>
                                        </div>
                                    </div>
                                </BzDropdownMenuLabel>
                                <BzDropdownMenuSeparator />
                                <BzDropdownMenuGroup>
                                    <BzDropdownMenuItem><BzIcon Icon="@Icons.Outline.UserCircle" />Account</BzDropdownMenuItem>
                                    <BzDropdownMenuItem><BzIcon Icon="@Icons.Outline.CreditCard" />Billing</BzDropdownMenuItem>
                                    <BzDropdownMenuItem><BzIcon Icon="@Icons.Outline.Bell" />Notifications</BzDropdownMenuItem>
                                </BzDropdownMenuGroup>
                                <BzDropdownMenuSeparator />
                                <BzDropdownMenuItem><BzIcon Icon="@Icons.Outline.Logout" />Log out</BzDropdownMenuItem>
                            </BzDropdownMenuContent>
                        </BzDropdownMenu>
                    </BzSidebarMenuItem>
                </BzSidebarMenu>
            </BzSidebarFooter>
            <BzSidebarRail />
        </BzSidebar>
        <BzSidebarInset>
            <header class="flex h-12 items-center gap-2 border-b px-3">
                <BzSidebarTrigger />
                <BzSeparator Orientation="Orientation.Vertical" />
                <span class="text-sm font-medium">@_active</span>
            </header>
            <div class="text-muted-foreground p-4 text-sm">Open the user menu from the footer row.</div>
        </BzSidebarInset>
    </BzSidebarProvider>
</div>

@code {
    private string _active = "Home";

    private static readonly (string Label, Icon Icon)[] _nav =
    [
        ("Home", Icons.Outline.Home),
        ("Inbox", Icons.Outline.Mail),
        ("Calendar", Icons.Outline.Calendar),
        ("Settings", Icons.Outline.Settings),
    ];
}
