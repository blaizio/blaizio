<RtlDemo Context="t">
    <BzDirectionProvider Direction="Direction.Rtl">
        <div class="relative h-[440px] w-full overflow-hidden rounded-xl border [transform:translateZ(0)]">
            <BzSidebarProvider Class="h-full min-h-0">
                <BzSidebar Class="h-full">
                    <BzSidebarHeader>
                        <div class="px-2 py-1.5 text-sm font-semibold">@t["القائمة", "תפריט"]</div>
                    </BzSidebarHeader>
                    <BzSidebarContent>
                        <BzSidebarGroup>
                            <BzSidebarGroupLabel>@t["التنقل", "ניווט"]</BzSidebarGroupLabel>
                            <BzSidebarGroupContent>
                                <BzSidebarMenu>
                                    <BzSidebarMenuItem><BzSidebarMenuButton Active="true"><BzIcon Icon="@Icons.Outline.Home" /><span>@t["الرئيسية", "בית"]</span></BzSidebarMenuButton></BzSidebarMenuItem>
                                    <BzSidebarMenuItem><BzSidebarMenuButton><BzIcon Icon="@Icons.Outline.Mail" /><span>@t["الرسائل", "הודעות"]</span></BzSidebarMenuButton></BzSidebarMenuItem>
                                    <BzSidebarMenuItem><BzSidebarMenuButton><BzIcon Icon="@Icons.Outline.Settings" /><span>@t["الإعدادات", "הגדרות"]</span></BzSidebarMenuButton></BzSidebarMenuItem>
                                </BzSidebarMenu>
                            </BzSidebarGroupContent>
                        </BzSidebarGroup>
                    </BzSidebarContent>
                </BzSidebar>
                <BzSidebarInset>
                    <header class="flex h-12 items-center gap-2 border-b px-3"><BzSidebarTrigger /><span class="text-sm font-medium">@t["لوحة التحكم", "לוח בקרה"]</span></header>
                </BzSidebarInset>
            </BzSidebarProvider>
        </div>
    </BzDirectionProvider>
</RtlDemo>
