<div class="relative h-[480px] w-full overflow-hidden rounded-xl border [transform:translateZ(0)]">
    <BzSidebarProvider Class="h-full min-h-0">
        <BzSidebar Class="h-full">
            <BzSidebarContent>
                <BzSidebarGroup>
                    <BzSidebarGroupLabel>Projects</BzSidebarGroupLabel>
                    <BzTooltip>
                        <BzTooltipTrigger>
                            <RenderAs Context="p"><BzSidebarGroupAction @attributes="p.Attributes" aria-label="Add project"><BzIcon Icon="@Icons.Outline.Plus" /></BzSidebarGroupAction></RenderAs>
                        </BzTooltipTrigger>
                        <BzTooltipContent>Add project<BzTooltipArrow /></BzTooltipContent>
                    </BzTooltip>
                    <BzSidebarGroupContent>
                        <BzSidebarMenu>
                            <BzSidebarMenuItem>
                                <BzSidebarMenuButton Active="true"><BzIcon Icon="@Icons.Outline.Folder" /><span>Design system</span></BzSidebarMenuButton>
                                <BzSidebarMenuBadge>12</BzSidebarMenuBadge>
                                <BzSidebarMenuSub>
                                    <BzSidebarMenuSubItem><BzSidebarMenuSubButton Active="true">Foundations</BzSidebarMenuSubButton></BzSidebarMenuSubItem>
                                    <BzSidebarMenuSubItem><BzSidebarMenuSubButton>Components</BzSidebarMenuSubButton></BzSidebarMenuSubItem>
                                    <BzSidebarMenuSubItem><BzSidebarMenuSubButton>Tokens</BzSidebarMenuSubButton></BzSidebarMenuSubItem>
                                </BzSidebarMenuSub>
                            </BzSidebarMenuItem>
                            <BzSidebarMenuItem>
                                <BzSidebarMenuButton><BzIcon Icon="@Icons.Outline.ChartBar" /><span>Analytics</span></BzSidebarMenuButton>
                                <BzTooltip>
                                    <BzTooltipTrigger>
                                        <RenderAs Context="p"><BzSidebarMenuAction @attributes="p.Attributes" ShowOnHover="true" aria-label="More"><BzIcon Icon="@Icons.Outline.DotsVertical" /></BzSidebarMenuAction></RenderAs>
                                    </BzTooltipTrigger>
                                    <BzTooltipContent>More<BzTooltipArrow /></BzTooltipContent>
                                </BzTooltip>
                            </BzSidebarMenuItem>
                            <BzSidebarMenuItem>
                                <BzSidebarMenuButton><BzIcon Icon="@Icons.Outline.FileText" /><span>Reports</span></BzSidebarMenuButton>
                                <BzSidebarMenuBadge>3</BzSidebarMenuBadge>
                            </BzSidebarMenuItem>
                        </BzSidebarMenu>
                    </BzSidebarGroupContent>
                </BzSidebarGroup>
            </BzSidebarContent>
        </BzSidebar>
        <BzSidebarInset>
            <header class="flex h-12 items-center gap-2 border-b px-3"><BzSidebarTrigger /><span class="text-sm font-medium">Projects</span></header>
        </BzSidebarInset>
    </BzSidebarProvider>
</div>
