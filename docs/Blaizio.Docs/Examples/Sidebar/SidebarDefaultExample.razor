@* The provider wraps the whole screen; here it's framed in a contained box for the demo. *@
<div class="relative h-[480px] w-full overflow-hidden rounded-xl border [transform:translateZ(0)]">
    <BzSidebarProvider Class="h-full min-h-0">
        <BzSidebar CollapseMode="SidebarCollapsible.Offcanvas" Class="h-full">
            <BzSidebarHeader>
                <div class="flex items-center gap-2 px-1 py-1.5">
                    <div class="bg-sidebar-primary text-sidebar-primary-foreground flex aspect-square size-8 items-center justify-center rounded-lg">
                        <BzIcon Icon="@Tabler.Outline.LayoutDashboard" />
                    </div>
                    <div class="grid flex-1 text-start text-sm leading-tight">
                        <span class="truncate font-semibold">Acme Inc</span>
                        <span class="text-muted-foreground truncate text-xs">Enterprise</span>
                    </div>
                </div>
            </BzSidebarHeader>
            <BzSidebarContent>
                <BzSidebarGroup>
                    <BzSidebarGroupLabel>Platform</BzSidebarGroupLabel>
                    <BzSidebarGroupContent>
                        <BzSidebarMenu>
                            @foreach (var (label, icon) in _nav)
                            {
                                <BzSidebarMenuItem>
                                    <BzSidebarMenuButton Active="@(_active == label)" @onclick="@(() => _active = label)">
                                        <BzIcon Icon="@icon" />
                                        <span>@label</span>
                                    </BzSidebarMenuButton>
                                    @if (label == "Inbox")
                                    {
                                        <BzSidebarMenuBadge>12</BzSidebarMenuBadge>
                                    }
                                </BzSidebarMenuItem>
                            }
                        </BzSidebarMenu>
                    </BzSidebarGroupContent>
                </BzSidebarGroup>
            </BzSidebarContent>
            <BzSidebarFooter>
                <BzSidebarMenu>
                    <BzSidebarMenuItem>
                        <BzDropdownMenu>
                            <BzDropdownMenuTrigger>
                                <RenderAs Context="p">
                                    <BzSidebarMenuButton Size="SidebarMenuButtonSize.Lg"
                                                         Class="data-[state=open]:bg-sidebar-accent data-[state=open]:text-sidebar-accent-foreground"
                                                         @attributes="p.Attributes">
                                        <BzAvatar Class="size-8 rounded-lg after:rounded-lg">
                                            <BzAvatarImage Src="avatars/benolimits.png" Alt="Beno Limits" Class="rounded-lg" />
                                            <BzAvatarFallback Class="rounded-lg">BL</BzAvatarFallback>
                                        </BzAvatar>
                                        <div class="grid flex-1 text-start text-sm leading-tight">
                                            <span class="truncate font-medium">Beno Limits</span>
                                            <span class="text-muted-foreground truncate text-xs">beno@@example.com</span>
                                        </div>
                                        <BzIcon Icon="@Tabler.Outline.DotsVertical" Class="ms-auto" />
                                    </BzSidebarMenuButton>
                                </RenderAs>
                            </BzDropdownMenuTrigger>
                            <BzDropdownMenuContent Side="Side.Right" Align="Align.End" Class="w-56">
                                <BzDropdownMenuItem><BzIcon Icon="@Tabler.Outline.UserCircle" />Account</BzDropdownMenuItem>
                                <BzDropdownMenuItem><BzIcon Icon="@Tabler.Outline.CreditCard" />Billing</BzDropdownMenuItem>
                                <BzDropdownMenuSeparator />
                                <BzDropdownMenuItem><BzIcon Icon="@Tabler.Outline.Logout" />Log out</BzDropdownMenuItem>
                            </BzDropdownMenuContent>
                        </BzDropdownMenu>
                    </BzSidebarMenuItem>
                </BzSidebarMenu>
            </BzSidebarFooter>
            <BzSidebarRail />
        </BzSidebar>
        <BzSidebarInset>
            <header class="flex h-12 shrink-0 items-center gap-2 px-3">
                <BzSidebarTrigger />
                <BzSeparator Orientation="Orientation.Vertical" Class="h-4 self-center!" />
                <span class="text-sm font-medium">@_active</span>
            </header>
            <div class="bg-muted/50 mx-2 mb-2 flex-1 rounded-xl p-4">
                <span class="text-muted-foreground text-sm">Selected: <span class="text-foreground font-medium">@_active</span></span>
            </div>
        </BzSidebarInset>
    </BzSidebarProvider>
</div>

@code {
    private string _active = "Home";

    private static readonly (string Label, Icon Icon)[] _nav =
    [
        ("Home", Tabler.Outline.Home),
        ("Inbox", Tabler.Outline.Mail),
        ("Calendar", Tabler.Outline.Calendar),
        ("Search", Tabler.Outline.Search),
        ("Settings", Tabler.Outline.Settings),
    ];
}
