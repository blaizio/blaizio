@* The trigger lives in the sidebar header itself. Collapsed to the rail it hides, and the logo button re-expands. *@
<div class="relative h-[480px] w-full overflow-hidden rounded-xl border [transform:translateZ(0)]">
    <BzSidebarProvider @bind-Open="_open" PersistState="false" Class="h-full min-h-0">
        <BzSidebar CollapseMode="SidebarCollapsible.Icon" Class="h-full">
            <BzSidebarHeader>
                <div class="flex items-center gap-2 px-1 py-1.5 group-data-[collapsible=icon]:px-0">
                    @* A plain tile while expanded; only the collapsed rail turns it into the expand button. *@
                    @if (_open)
                    {
                        <div class="bg-sidebar-primary text-sidebar-primary-foreground flex aspect-square size-8 items-center justify-center rounded-lg">
                            <BzIcon Icon="@Icons.Outline.LayoutDashboard" />
                        </div>
                    }
                    else
                    {
                        <button type="button"
                                class="bg-sidebar-primary text-sidebar-primary-foreground focus-visible:ring-sidebar-ring flex aspect-square size-8 items-center justify-center rounded-lg outline-hidden focus-visible:ring-2"
                                aria-label="Expand sidebar"
                                @onclick="@(() => _open = true)">
                            <BzIcon Icon="@Icons.Outline.LayoutDashboard" />
                        </button>
                    }
                    <div class="grid flex-1 text-start text-sm leading-tight group-data-[collapsible=icon]:hidden">
                        <span class="truncate font-semibold">Acme Inc</span>
                        <span class="text-muted-foreground truncate text-xs">Enterprise</span>
                    </div>
                    <BzSidebarTrigger Class="group-data-[collapsible=icon]:hidden" />
                </div>
            </BzSidebarHeader>
            <BzSidebarContent>
                <BzSidebarGroup>
                    <BzSidebarGroupLabel>Platform</BzSidebarGroupLabel>
                    <BzSidebarGroupContent>
                        <BzSidebarMenu>
                            @foreach (var (label, icon) in _nav)
                            {
                                <BzSidebarMenuItem>
                                    <BzSidebarMenuButton Active="@(_active == label)"
                                                         Tooltip="@label"
                                                         @onclick="@(() => _active = label)">
                                        <BzIcon Icon="@icon" />
                                        <span>@label</span>
                                    </BzSidebarMenuButton>
                                </BzSidebarMenuItem>
                            }
                        </BzSidebarMenu>
                    </BzSidebarGroupContent>
                </BzSidebarGroup>
            </BzSidebarContent>
            <BzSidebarRail />
        </BzSidebar>
        <BzSidebarInset>
            <header class="flex h-12 items-center gap-2 border-b px-3">
                <span class="text-sm font-medium">@_active</span>
            </header>
            <div class="text-muted-foreground p-4 text-sm">Collapse from the sidebar header; expand by clicking the logo.</div>
        </BzSidebarInset>
    </BzSidebarProvider>
</div>

@code {
    private bool _open = true;
    private string _active = "Home";

    private static readonly (string Label, Icon Icon)[] _nav =
    [
        ("Home", Icons.Outline.Home),
        ("Inbox", Icons.Outline.Mail),
        ("Calendar", Icons.Outline.Calendar),
        ("Search", Icons.Outline.Search),
        ("Settings", Icons.Outline.Settings),
    ];
}
