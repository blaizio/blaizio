@* A service dialog follows the app's direction; its body can also opt into RTL itself. *@
@inject IDialogService Dialogs

<RtlDemo Context="t">
    @{ _t = t; }
    <div class="flex flex-col items-center gap-4">
        <span class="text-sm text-muted-foreground">Result: <span class="font-mono">@_rtlResult</span></span>
        <BzButton Variant="ButtonVariant.Outline" @onclick="RunRtl">@t["حذف المشروع", "מחיקת פרויקט"]</BzButton>
    </div>
</RtlDemo>

@code {
    private RtlLang _t;
    private string _rtlResult = "-";

    private async Task RunRtl()
    {
        RenderFragment<DialogInstance> body = dialog =>
            @<text>
                <BzDirectionProvider Dir="Direction.Rtl">
                    <BzDialogHeader>
                        <BzDialogTitle>@_t["حذف المشروع؟", "למחוק את הפרויקט?"]</BzDialogTitle>
                        <BzDialogDescription>@_t["سيؤدي هذا إلى حذف المشروع وكل بياناته نهائيًا. لا يمكن التراجع عن هذا الإجراء.", "פעולה זו תמחק את הפרויקט ואת כל נתוניו לצמיתות. לא ניתן לבטל פעולה זו."]</BzDialogDescription>
                    </BzDialogHeader>
                    <BzDialogFooter>
                        <BzButton Variant="ButtonVariant.Outline" @onclick="() => dialog.Cancel()">@_t["إلغاء", "ביטול"]</BzButton>
                        <BzButton Variant="ButtonVariant.Destructive" @onclick="() => dialog.Close(DialogResult.Ok(true))">@_t["حذف", "מחק"]</BzButton>
                    </BzDialogFooter>
                </BzDirectionProvider>
            </text>;

        var result = await Dialogs.ShowAsync(body);
        _rtlResult = result.Cancelled ? "cancelled" : "deleted";
    }
}
