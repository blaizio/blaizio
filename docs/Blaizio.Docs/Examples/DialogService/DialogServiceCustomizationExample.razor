@* An inline template gives you the whole body - brand it however you like. *@
@inject IDialogService Dialogs

<div class="flex flex-col items-center gap-4">
    <span class="text-sm text-muted-foreground">Result: <span class="font-mono">@_customResult</span></span>
    <BzButton Variant="ButtonVariant.Outline" @onclick="RunCustom">Upgrade plan</BzButton>
</div>

@code {
    private string _customResult = "-";

    private async Task RunCustom()
    {
        RenderFragment<DialogInstance> body = dialog =>
            @<text>
                <div class="flex flex-col items-center gap-3 text-center">
                    <span class="inline-flex size-12 items-center justify-center rounded-full bg-indigo-500/10 text-indigo-600 dark:text-indigo-400">
                        <BzIcon Icon="@Icons.Outline.Star" Class="size-6" />
                    </span>
                    <BzDialogHeader>
                        <BzDialogTitle>Upgrade to Pro</BzDialogTitle>
                        <BzDialogDescription>Unlock unlimited projects, priority support and advanced analytics.</BzDialogDescription>
                    </BzDialogHeader>
                </div>
                <BzDialogFooter>
                    <BzButton Variant="ButtonVariant.Outline" @onclick="() => dialog.Cancel()">Maybe later</BzButton>
                    <BzButton Class="bg-indigo-600 text-white hover:bg-indigo-700" @onclick="() => dialog.Close(DialogResult.Ok(true))">Upgrade</BzButton>
                </BzDialogFooter>
            </text>;

        var result = await Dialogs.ShowAsync(body);
        _customResult = result.Cancelled ? "cancelled" : "upgraded";
    }
}
