@* Once one opens, hovering an adjacent trigger opens instantly. *@
<BzTooltipProvider>
    <div class="flex items-center gap-2">
        <BzTooltip>
            <BzTooltipTrigger><RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSm" @attributes="p.Attributes"><BzIcon Icon="@Tabler.Outline.Bold" /></BzButton></RenderAs></BzTooltipTrigger>
            <BzTooltipContent>Bold<BzTooltipArrow /></BzTooltipContent>
        </BzTooltip>
        <BzTooltip>
            <BzTooltipTrigger><RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSm" @attributes="p.Attributes"><BzIcon Icon="@Tabler.Outline.Italic" /></BzButton></RenderAs></BzTooltipTrigger>
            <BzTooltipContent>Italic<BzTooltipArrow /></BzTooltipContent>
        </BzTooltip>
        <BzTooltip>
            <BzTooltipTrigger><RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSm" @attributes="p.Attributes"><BzIcon Icon="@Tabler.Outline.Underline" /></BzButton></RenderAs></BzTooltipTrigger>
            <BzTooltipContent>Underline<BzTooltipArrow /></BzTooltipContent>
        </BzTooltip>
    </div>
</BzTooltipProvider>
