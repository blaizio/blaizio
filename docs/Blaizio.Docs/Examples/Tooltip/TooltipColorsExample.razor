<div class="flex flex-wrap items-center gap-3">
    @foreach (var variant in Enum.GetValues<TooltipVariant>())
    {
        <BzTooltip>
            <BzTooltipTrigger>
                <BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">@variant</BzButton>
            </BzTooltipTrigger>
            <BzTooltipContent Variant="@variant">
                @variant tooltip
                <BzTooltipArrow />
            </BzTooltipContent>
        </BzTooltip>
    }
</div>
