<BzTooltipProvider>
    <div class="flex items-center gap-2">
        <BzTooltip>
            <BzTooltipTrigger><RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Top</BzButton></RenderAs></BzTooltipTrigger>
            <BzTooltipContent Side="Side.Top">On top<BzTooltipArrow /></BzTooltipContent>
        </BzTooltip>
        <BzTooltip>
            <BzTooltipTrigger><RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Right</BzButton></RenderAs></BzTooltipTrigger>
            <BzTooltipContent Side="Side.Right">On the right<BzTooltipArrow /></BzTooltipContent>
        </BzTooltip>
        <BzTooltip>
            <BzTooltipTrigger><RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Bottom</BzButton></RenderAs></BzTooltipTrigger>
            <BzTooltipContent Side="Side.Bottom">On the bottom<BzTooltipArrow /></BzTooltipContent>
        </BzTooltip>
        <BzTooltip>
            <BzTooltipTrigger><RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Left</BzButton></RenderAs></BzTooltipTrigger>
            <BzTooltipContent Side="Side.Left">On the left<BzTooltipArrow /></BzTooltipContent>
        </BzTooltip>
    </div>
</BzTooltipProvider>
