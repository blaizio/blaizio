@* A disabled button emits no pointer events, so the trigger goes on a focusable wrapper. *@
<BzTooltip>
    <BzTooltipTrigger>
        <RenderAs Context="p">
            <span tabindex="0" class="inline-block" @attributes="p.Attributes">
                <BzButton Variant="ButtonVariant.Outline" Disabled="true">Disabled</BzButton>
            </span>
        </RenderAs>
    </BzTooltipTrigger>
    <BzTooltipContent>You don't have permission to do this<BzTooltipArrow /></BzTooltipContent>
</BzTooltip>
