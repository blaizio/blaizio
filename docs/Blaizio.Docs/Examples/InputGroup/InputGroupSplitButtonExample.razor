<div class="flex flex-col items-center gap-3">
    <BzInputGroup Class="w-fit">
        @* Segments fill their whole half: no gap, flush against the separator, and only the OUTER
           corners keep the container's radius - so hover / focus paint the entire segment. *@
        <BzInputGroupAddon Class="h-full cursor-default gap-0 rounded-[inherit] p-0 has-[>button]:ms-0 has-[>button]:me-0">
            <BzInputGroupButton Size="InputGroupButtonSize.Sm" Class="h-full rounded-s-[inherit] rounded-e-none px-3"
                                OnClick='@(() => _action = "Merged")'>
                <BzIcon Icon="@Icons.Outline.GitMerge" /> Merge
            </BzInputGroupButton>
            <BzSeparator Orientation="Orientation.Vertical" />
            <BzDropdownMenu>
                <BzDropdownMenuTrigger>
                    <RenderAs Context="p">
                        <BzInputGroupButton @attributes="p.Attributes" Size="InputGroupButtonSize.IconSm"
                                            Class="h-full w-8 rounded-s-none rounded-e-[inherit]" aria-label="More merge options">
                            <BzIcon Icon="@Icons.Outline.ChevronDown" />
                        </BzInputGroupButton>
                    </RenderAs>
                </BzDropdownMenuTrigger>
                <BzDropdownMenuContent Align="Align.End">
                    <BzDropdownMenuItem OnSelect='@(() => _action = "Merged")'>Merge</BzDropdownMenuItem>
                    <BzDropdownMenuItem OnSelect='@(() => _action = "Squashed and merged")'>Squash and merge</BzDropdownMenuItem>
                    <BzDropdownMenuItem OnSelect='@(() => _action = "Rebased and merged")'>Rebase and merge</BzDropdownMenuItem>
                </BzDropdownMenuContent>
            </BzDropdownMenu>
        </BzInputGroupAddon>
    </BzInputGroup>

    <p class="text-muted-foreground text-xs">@(_action is null ? "Pick an action." : $"{_action}.")</p>
</div>

@code {
    private string? _action;
}
