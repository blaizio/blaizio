@* A chat composer against a real transcript (MessageScroller + Bubble). PreventKeys="enter"
   suppresses the browser's newline for a bare Enter JS-side (a C# handler runs too late to
   cancel it), so the keydown handler can send with nothing racing the clear - Shift+Enter
   still inserts a line natively, and Ctrl+Enter appends one by hand. The composer sits at
   the bottom of a fixed-height column, so growth reads as expanding upward, capped at ten
   lines by max-h with a thin scrollbar past it. *@
<div class="flex h-[420px] w-full max-w-md flex-col gap-3">
    <BzMessageScroller Class="min-h-0 flex-1 rounded-xl border">
        <BzMessageScrollerViewport aria-label="Conversation" Class="p-4">
            <BzMessageScrollerContent Class="gap-4">
                @foreach (var message in _messages)
                {
                    <BzMessageScrollerItem @key="message.Id" MessageId="@message.Id">
                        <BzBubble Align="@(message.Mine ? BubbleAlign.End : BubbleAlign.Start)"
                                  Variant="@(message.Mine ? BubbleVariant.Default : BubbleVariant.Ghost)">
                            <BzBubbleContent Class="whitespace-pre-wrap">@message.Text</BzBubbleContent>
                        </BzBubble>
                    </BzMessageScrollerItem>
                }
            </BzMessageScrollerContent>
        </BzMessageScrollerViewport>
        <BzMessageScrollerButton />
    </BzMessageScroller>
    <BzInputGroup>
        <BzInputGroupInput Rows="1"
                           @bind-Value="_draft"
                           Placeholder="Ask anything... (Enter sends, Shift+Enter adds a line)"
                           PreventKeys="enter"
                           OnKeyDown="OnComposerKeyDown"
                           Class="max-h-[calc(10lh+1.25rem)] scrollbar-thin" />
        <BzInputGroupAddon Align="InputGroupAddonAlign.InlineEnd" Class="self-end pb-1">
            <BzInputGroupButton Variant="ButtonVariant.Default"
                                Size="InputGroupButtonSize.IconSm"
                                Class="rounded-full"
                                aria-label="Send message"
                                OnClick="SendAsync">
                <BzIcon Icon="@Icons.Outline.ArrowUp" />
            </BzInputGroupButton>
        </BzInputGroupAddon>
    </BzInputGroup>
</div>

@code {
    private sealed class Msg(string id, bool mine, string text)
    {
        public string Id { get; } = id;
        public bool Mine { get; } = mine;
        public string Text { get; } = text;
    }

    private static readonly string[] _replies =
    [
        "Happy to help - what are you building?",
        "Good question. The composer grows with its content and the transcript keeps to the live edge.",
        "That is what Ctrl+Enter is for: a new line without sending.",
    ];

    private string? _draft;
    private int _next = 1;
    private int _reply;
    private readonly List<Msg> _messages = [new("0", false, "Hi! Ask me anything.")];

    private async Task OnComposerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        if (e.CtrlKey || e.MetaKey) _draft += "\n";
        else if (!e.ShiftKey) await SendAsync();
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_draft)) { _draft = null; return; }
        _messages.Add(new($"{_next++}", true, _draft.Trim()));
        _draft = null;
        StateHasChanged();
        await Task.Delay(500);
        _messages.Add(new($"{_next++}", false, _replies[_reply++ % _replies.Length]));
    }
}
