@using System.ComponentModel.DataAnnotations

<EditForm Model="@_signup" OnValidSubmit="@(() => _submitted = true)" OnInvalidSubmit="@(() => _submitted = false)" class="w-full max-w-sm">
    <DataAnnotationsValidator />
    <BzFieldGroup>
        <BzField Name="@nameof(SignupModel.Email)">
            <BzFieldLabel>Email</BzFieldLabel>
            <BzFieldControl Context="ctl">
                <BzInputGroup>
                    <BzInputGroupAddon>
                        <BzIcon Icon="@Icons.Outline.Mail" />
                    </BzInputGroupAddon>
                    <BzInputGroupInput @attributes="ctl" Type="email" Placeholder="you@example.com" @bind-Value="_signup.Email" />
                </BzInputGroup>
            </BzFieldControl>
            <BzFieldError />
        </BzField>
        <BzField>
            <BzButton Type="ButtonType.Submit">Subscribe</BzButton>
        </BzField>
        @if (_submitted)
        {
            <p class="text-sm font-medium text-emerald-600">Subscribed 🎉</p>
        }
    </BzFieldGroup>
</EditForm>

@code {
    private SignupModel _signup = new();
    private bool _submitted;

    public class SignupModel
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string? Email { get; set; }
    }
}
