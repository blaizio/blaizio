<BzInputGroup Class="max-w-sm">
    <BzInputGroupInput Rows="3" Placeholder="Write a comment..." />
    <BzInputGroupAddon Align="InputGroupAddonAlign.BlockEnd">
        <BzInputGroupButton Size="InputGroupButtonSize.IconXs" aria-label="Bold"><BzIcon Icon="@Tabler.Outline.Bold" /></BzInputGroupButton>
        <BzInputGroupButton Size="InputGroupButtonSize.IconXs" aria-label="Italic"><BzIcon Icon="@Tabler.Outline.Italic" /></BzInputGroupButton>
        <BzInputGroupButton Size="InputGroupButtonSize.IconXs" aria-label="Underline"><BzIcon Icon="@Tabler.Outline.Underline" /></BzInputGroupButton>
        <BzSeparator Orientation="Orientation.Vertical" Class="h-4 self-center!" />
        <BzInputGroupButton Size="InputGroupButtonSize.IconXs" aria-label="Insert link"><BzIcon Icon="@Tabler.Outline.Link" /></BzInputGroupButton>
        <BzInputGroupButton Size="InputGroupButtonSize.IconXs" aria-label="Bullet list"><BzIcon Icon="@Tabler.Outline.List" /></BzInputGroupButton>
        <BzInputGroupButton Variant="ButtonVariant.Default" Size="InputGroupButtonSize.Sm" Class="ms-auto">Post</BzInputGroupButton>
    </BzInputGroupAddon>
</BzInputGroup>
