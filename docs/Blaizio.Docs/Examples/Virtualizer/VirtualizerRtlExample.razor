<RtlDemo Context="t">
    <BzDirectionProvider Dir="Direction.Rtl">
        <div class="w-full max-w-md overflow-hidden rounded-lg border">
            <BzVirtualizer TItem="Row" Items="_rows" ItemSize="44" MaxHeight="20rem" Context="row">
                <div @attributes="row.Attributes" class="flex items-center gap-3 border-b px-4 text-sm">
                    <span class="w-14 shrink-0 text-end font-mono text-xs text-muted-foreground tabular-nums">@row.Index</span>
                    <span class="font-medium">@row.Item.Name</span>
                    <span class="ms-auto truncate text-muted-foreground">@row.Item.Email</span>
                </div>
            </BzVirtualizer>
        </div>
    </BzDirectionProvider>
</RtlDemo>

@code {
    public sealed record Row(int Id, string Name, string Email);

    private static readonly string[] First =
        ["Olivia", "Jackson", "Isabella", "William", "Sofia", "Liam", "Emma", "Noah", "Ava", "Lucas", "Mia", "Ethan"];

    private static readonly string[] Last =
        ["Martin", "Lee", "Nguyen", "Kim", "Davis", "Johnson", "Wilson", "Brown", "Garcia", "Miller", "Jones", "Khan"];

    // Computed per index rather than materialized - see the Fixed example.
    private readonly IReadOnlyList<Row> _rows = DemoRows.Lazy(100_000, i =>
    {
        var id = i + 1;
        var name = $"{First[DemoRows.Pick(i, 1, First.Length)]} {Last[DemoRows.Pick(i, 2, Last.Length)]}";
        return new Row(id, name, $"{name.ToLowerInvariant().Replace(' ', '.')}{id}@example.com");
    });
}
