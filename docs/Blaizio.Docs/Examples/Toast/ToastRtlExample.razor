@inject IToastService Toasts

<RtlDemo Context="t">
    @{ _t = t; }
    <BzButton Variant="ButtonVariant.Outline" @onclick="ShowRtl">@t["إظهار الإشعار", "הצגת ההתראה"]</BzButton>
</RtlDemo>

@code {
    private RtlLang _t;

    // Toasts inherit the app's DirectionProvider; a single toast can also opt into RTL
    // with Direction - icon, buttons and text mirror even on an LTR page.
    private void ShowRtl() =>
        Toasts.Success(_t["تم حفظ التغييرات", "השינויים נשמרו"], new ToastOptions
        {
            Description = _t["تمت مزامنة مشروعك بنجاح.", "הפרויקט שלך סונכרן בהצלחה."],
            CloseButton = true,
            Direction = Direction.Rtl,
        });
}
