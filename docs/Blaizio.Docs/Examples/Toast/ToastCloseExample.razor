@inject IToastService Toasts

<BzButton Variant="ButtonVariant.Outline" @onclick="ShowClose">Show toast</BzButton>

@code {
    // Per toast - or default it on for every toast: <BzToastProvider CloseButton="true" />
    private void ShowClose() =>
        Toasts.Show("Event created", new ToastOptions { CloseButton = true });
}
