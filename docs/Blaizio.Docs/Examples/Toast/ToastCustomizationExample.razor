@inject IToastService Toasts

<BzButton Variant="ButtonVariant.Outline" @onclick="ShowBranded">Branded toast</BzButton>

@code {
    // Compose the options to brand a toast - custom Icon, rich colours and a description.
    private void ShowBranded() =>
        Toasts.Success("Payment received", new ToastOptions
        {
            Icon = @<BzIcon Icon="@Tabler.Outline.Star" />,
            RichColors = true,
            Description = "Your invoice has been marked as paid.",
        });
}
