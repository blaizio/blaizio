@* Arrow keys wrap within the menu by default; Loop="false" stops at the ends. *@
<BzContextMenu>
    <BzContextMenuTrigger Class="border-border text-muted-foreground flex h-40 w-full max-w-md items-center justify-center rounded-md border border-dashed text-sm">
        Right-click here
    </BzContextMenuTrigger>
    <BzContextMenuContent Class="w-44" Loop="false">
        <BzContextMenuItem>Cut</BzContextMenuItem>
        <BzContextMenuItem>Copy</BzContextMenuItem>
        <BzContextMenuItem>Paste</BzContextMenuItem>
        <BzContextMenuItem>Delete</BzContextMenuItem>
    </BzContextMenuContent>
</BzContextMenu>
