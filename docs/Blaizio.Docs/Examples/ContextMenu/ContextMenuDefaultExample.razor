<BzContextMenu>
    <BzContextMenuTrigger Class="border-border text-muted-foreground flex h-40 w-full max-w-md items-center justify-center rounded-md border border-dashed text-sm">
        Right-click here
    </BzContextMenuTrigger>
    <BzContextMenuContent Class="w-52">
        <BzContextMenuItem>
            Open
            <BzContextMenuShortcut>⌘O</BzContextMenuShortcut>
        </BzContextMenuItem>
        <BzContextMenuItem Disabled>
            Paste
            <BzContextMenuShortcut>⌘V</BzContextMenuShortcut>
        </BzContextMenuItem>
        <BzContextMenuItem>
            Duplicate
            <BzContextMenuShortcut>⌘D</BzContextMenuShortcut>
        </BzContextMenuItem>
        <BzContextMenuSub>
            <BzContextMenuSubTrigger>Share</BzContextMenuSubTrigger>
            <BzContextMenuSubContent Class="w-48">
                <BzContextMenuItem>
                    Copy link
                    <BzContextMenuShortcut>⇧⌘C</BzContextMenuShortcut>
                </BzContextMenuItem>
                <BzContextMenuItem>Send by email...</BzContextMenuItem>
                <BzContextMenuItem>Export as PDF...</BzContextMenuItem>
                <BzContextMenuSeparator />
                <BzContextMenuItem>Manage access</BzContextMenuItem>
            </BzContextMenuSubContent>
        </BzContextMenuSub>
        <BzContextMenuSeparator />
        <BzContextMenuCheckboxItem @bind-Checked="_hiddenFiles" OnSelect="KeepOpen">
            Show hidden files
            <BzContextMenuShortcut>⌘⇧.</BzContextMenuShortcut>
        </BzContextMenuCheckboxItem>
        <BzContextMenuCheckboxItem @bind-Checked="_extensions" OnSelect="KeepOpen">Show file extensions</BzContextMenuCheckboxItem>
        <BzContextMenuSeparator />
        <BzContextMenuLabel>Sort by</BzContextMenuLabel>
        <BzContextMenuRadioGroup @bind-Value="_sort">
            <BzContextMenuRadioItem Value="name">Name</BzContextMenuRadioItem>
            <BzContextMenuRadioItem Value="modified">Date modified</BzContextMenuRadioItem>
        </BzContextMenuRadioGroup>
        <BzContextMenuSeparator />
        <BzContextMenuItem Variant="ContextMenuItemVariant.Destructive">
            Delete
            <BzContextMenuShortcut>⌫</BzContextMenuShortcut>
        </BzContextMenuItem>
    </BzContextMenuContent>
</BzContextMenu>

@code {
    private bool _hiddenFiles = true;
    private bool _extensions;
    private string _sort = "name";

    // Keep the menu open so several boxes can be toggled in one visit.
    private static void KeepOpen(MenuSelectEventArgs e) => e.PreventDefault();
}
