<BzContextMenu>
    <BzContextMenuTrigger Class="border-border text-muted-foreground flex h-40 w-full max-w-md items-center justify-center rounded-md border border-dashed text-sm">
        Right-click here
    </BzContextMenuTrigger>
    <BzContextMenuContent Class="w-52">
        <BzContextMenuItem>
            <BzIcon Icon="@Icons.Outline.Scissors" />
            Cut
            <BzContextMenuShortcut>⌘X</BzContextMenuShortcut>
        </BzContextMenuItem>
        <BzContextMenuItem>
            <BzIcon Icon="@Icons.Outline.Copy" />
            Copy
            <BzContextMenuShortcut>⌘C</BzContextMenuShortcut>
        </BzContextMenuItem>
        <BzContextMenuItem>
            <BzIcon Icon="@Icons.Outline.Clipboard" />
            Paste
            <BzContextMenuShortcut>⌘V</BzContextMenuShortcut>
        </BzContextMenuItem>
        <BzContextMenuSeparator />
        <BzContextMenuItem Variant="ContextMenuItemVariant.Destructive">
            <BzIcon Icon="@Icons.Outline.Trash" />
            Delete
            <BzContextMenuShortcut>⌫</BzContextMenuShortcut>
        </BzContextMenuItem>
    </BzContextMenuContent>
</BzContextMenu>
