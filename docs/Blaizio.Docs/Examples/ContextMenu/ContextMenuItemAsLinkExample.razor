<BzContextMenu>
    <BzContextMenuTrigger Class="border-border text-muted-foreground flex h-40 w-full max-w-md items-center justify-center rounded-md border border-dashed text-sm">
        Right-click here
    </BzContextMenuTrigger>
    <BzContextMenuContent Class="w-52">
        @* Render the item onto your own <a> so it is a true navigable link. *@
        <BzContextMenuItem>
            <RenderAs Context="p">
                <a href="/account" @attributes="p.Attributes">
                    <BzIcon Icon="@Icons.Outline.User" />
                    Account
                </a>
            </RenderAs>
        </BzContextMenuItem>
        <BzContextMenuItem>
            <RenderAs Context="p">
                <a href="/settings" @attributes="p.Attributes">
                    <BzIcon Icon="@Icons.Outline.Settings" />
                    Settings
                </a>
            </RenderAs>
        </BzContextMenuItem>
        <BzContextMenuSeparator />
        <BzContextMenuItem>
            <BzIcon Icon="@Icons.Outline.Logout" />
            Log out
        </BzContextMenuItem>
    </BzContextMenuContent>
</BzContextMenu>
