<BzContextMenu>
    <BzContextMenuTrigger Class="border-border text-muted-foreground flex h-40 w-full max-w-md items-center justify-center rounded-md border border-dashed text-sm">
        Right-click here
    </BzContextMenuTrigger>
    <BzContextMenuContent Class="w-56">
        <BzContextMenuLabel Inset>Page</BzContextMenuLabel>
        <BzContextMenuItem Inset>
            Back
            <BzContextMenuShortcut>⌘[</BzContextMenuShortcut>
        </BzContextMenuItem>
        <BzContextMenuItem Inset>
            Forward
            <BzContextMenuShortcut>⌘]</BzContextMenuShortcut>
        </BzContextMenuItem>
        <BzContextMenuItem Inset>
            Reload
            <BzContextMenuShortcut>⌘R</BzContextMenuShortcut>
        </BzContextMenuItem>
        <BzContextMenuSeparator />
        <BzContextMenuItem>
            <BzIcon Icon="@Tabler.Outline.Bookmark" />
            Add bookmark
        </BzContextMenuItem>
    </BzContextMenuContent>
</BzContextMenu>
