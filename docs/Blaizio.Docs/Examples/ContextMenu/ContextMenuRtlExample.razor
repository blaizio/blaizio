<RtlDemo Context="t">
    <BzDirectionProvider Dir="Direction.Rtl">
        <BzContextMenu>
            <BzContextMenuTrigger Class="border-border text-muted-foreground flex h-40 w-full max-w-md items-center justify-center rounded-md border border-dashed text-sm">
                @t["انقر هنا بزر الفأرة الأيمن", "לחץ כאן עם לחצן העכבר הימני"]
            </BzContextMenuTrigger>
            <BzContextMenuContent Class="w-52">
                <BzContextMenuItem>
                    @t["رجوع", "אחורה"]
                    <BzContextMenuShortcut>⌘[</BzContextMenuShortcut>
                </BzContextMenuItem>
                <BzContextMenuItem>
                    @t["إعادة تحميل", "טען מחדש"]
                    <BzContextMenuShortcut>⌘R</BzContextMenuShortcut>
                </BzContextMenuItem>
                <BzContextMenuSub>
                    <BzContextMenuSubTrigger>@t["أدوات أخرى", "כלים נוספים"]</BzContextMenuSubTrigger>
                    <BzContextMenuSubContent Class="w-48">
                        <BzContextMenuItem>@t["حفظ الصفحة باسم…", "שמור את הדף בשם…"]</BzContextMenuItem>
                        <BzContextMenuItem>@t["أدوات المطور", "כלי מפתחים"]</BzContextMenuItem>
                    </BzContextMenuSubContent>
                </BzContextMenuSub>
                <BzContextMenuSeparator />
                <BzContextMenuItem Variant="ContextMenuItemVariant.Destructive">@t["حذف", "מחק"]</BzContextMenuItem>
            </BzContextMenuContent>
        </BzContextMenu>
    </BzDirectionProvider>
</RtlDemo>
