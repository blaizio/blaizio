@* The scroll surface ships `scrollbar-thin`. To hand it back to the browser, pass
   `scrollbar-auto` - the class merge drops ours, so nothing is left to fight. Add a class of
   your own next to it (`scrollbar-auto my-bar`) when you want to style the bar yourself. *@
<BzContextMenu>
    <BzContextMenuTrigger Class="flex h-40 w-full max-w-md items-center justify-center rounded-xl border border-dashed border-indigo-300 text-sm text-indigo-600 dark:border-indigo-800 dark:text-indigo-300">
        Right-click here
    </BzContextMenuTrigger>
    <BzContextMenuContent Class="scrollbar-auto w-56 rounded-xl border-indigo-200 bg-indigo-50/60 dark:border-indigo-900 dark:bg-indigo-950/50">
        <BzContextMenuLabel>Workspace</BzContextMenuLabel>
        <BzContextMenuSeparator />
        <BzContextMenuItem>
            <BzIcon Icon="@Icons.Outline.User" />
            Profile
        </BzContextMenuItem>
        <BzContextMenuItem>
            <BzIcon Icon="@Icons.Outline.Settings" />
            Settings
        </BzContextMenuItem>
        <BzContextMenuItem>
            <BzIcon Icon="@Icons.Outline.CreditCard" />
            Billing
        </BzContextMenuItem>
    </BzContextMenuContent>
</BzContextMenu>
