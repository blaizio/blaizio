<div class="w-full max-w-sm">
    <BzField>
        <BzFieldLabel>Email</BzFieldLabel>
        <BzFieldControl Context="ctl">
            <BzInputText @attributes="ctl" Type="email" placeholder="m@example.com" @bind-Value="_email" />
        </BzFieldControl>
        <BzFieldDescription>We'll never share it.</BzFieldDescription>
    </BzField>
</div>

@code {
    private string? _email;
}
