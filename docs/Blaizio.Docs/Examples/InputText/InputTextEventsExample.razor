<div class="grid w-full max-w-sm gap-1.5">
    <BzInputText @bind-Value="_message"
                 Placeholder="Type and press Enter…"
                 OnKeyDown="OnKeyDown"
                 OnBlur="OnBlur" />
    <p class="text-muted-foreground text-xs">@_status</p>
</div>

@code {
    private string? _message;
    private string _status = "Waiting…";

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_message))
        {
            _status = $"Sent: {_message}";
            _message = null;
        }
    }

    private void OnBlur() => _status = "Left the field.";
}
