<div class="grid w-full max-w-sm gap-4">
    @* The other two are named by their placeholder; a read-only field has none, so it says what it
       is out loud. *@
    <BzInputText Value="Read-only value" ReadOnly aria-label="Read-only field" />
    <BzInputText Placeholder="Required field" Required />
    <div class="grid gap-1.5">
        <BzInputText @bind-Value="_bio" Placeholder="Max 40 characters" MaxLength="40" />
        <p class="text-muted-foreground text-end text-xs">@(_bio?.Length ?? 0)/40</p>
    </div>
</div>

@code {
    private string? _bio;
}
