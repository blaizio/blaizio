<div class="w-full max-w-sm">
    <BzField>
        <BzFieldLabel>Your message</BzFieldLabel>
        <BzFieldControl Context="ctl">
            <BzInputText @attributes="ctl" Rows="4" Placeholder="Type your message here." @bind-Value="_message" />
        </BzFieldControl>
        <BzFieldDescription>It will be sent to the team.</BzFieldDescription>
    </BzField>
</div>

@code {
    private string? _message;
}
