<RtlDemo Context="t">
    <BzDirectionProvider Direction="Direction.Rtl">
        <div class="w-full max-w-sm space-y-4">
            <BzField>
                <BzFieldLabel>@t["البريد الإلكتروني", "אימייל"]</BzFieldLabel>
                <BzFieldControl Context="ctl">
                    <BzInputText @attributes="ctl" Type="email" placeholder="m@example.com" @bind-Value="_email" />
                </BzFieldControl>
                <BzFieldDescription>@t["لن نشاركه مع أحد أبدًا.", "לעולם לא נשתף אותו עם אף אחד."]</BzFieldDescription>
            </BzField>
            <BzField>
                <BzFieldLabel>@t["رسالتك", "ההודעה שלך"]</BzFieldLabel>
                <BzFieldControl Context="ctl">
                    <BzInputText @attributes="ctl" Rows="4" placeholder='@t["اكتب رسالتك هنا.", "כתוב את ההודעה שלך כאן."]' @bind-Value="_message" />
                </BzFieldControl>
                <BzFieldDescription>@t["ستُرسل إلى الفريق.", "היא תישלח לצוות."]</BzFieldDescription>
            </BzField>
        </div>
    </BzDirectionProvider>
</RtlDemo>

@code {
    private string? _email;
    private string? _message;
}
