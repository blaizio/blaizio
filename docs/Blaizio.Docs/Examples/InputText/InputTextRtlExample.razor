<BzDirectionProvider Direction="Direction.Rtl">
    <div class="w-full max-w-sm space-y-4">
        <BzField>
            <BzFieldLabel>البريد الإلكتروني</BzFieldLabel>
            <BzFieldControl Context="ctl">
                <BzInputText @attributes="ctl" Type="email" placeholder="m@example.com" @bind-Value="_email" />
            </BzFieldControl>
            <BzFieldDescription>لن نشاركه مع أحد أبدًا.</BzFieldDescription>
        </BzField>
        <BzField>
            <BzFieldLabel>رسالتك</BzFieldLabel>
            <BzFieldControl Context="ctl">
                <BzInputText @attributes="ctl" Rows="4" placeholder="اكتب رسالتك هنا." @bind-Value="_message" />
            </BzFieldControl>
            <BzFieldDescription>ستُرسل إلى الفريق.</BzFieldDescription>
        </BzField>
    </div>
</BzDirectionProvider>

@code {
    private string? _email;
    private string? _message;
}
