<div class="flex items-center justify-center gap-3 py-12">
    <BzHoverCard>
        <BzHoverCardTrigger><RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Left</BzButton></RenderAs></BzHoverCardTrigger>
        <BzHoverCardContent Side="Side.Left" Class="w-auto">Opens to the left.<BzHoverCardArrow /></BzHoverCardContent>
    </BzHoverCard>
    <BzHoverCard>
        <BzHoverCardTrigger><RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Top</BzButton></RenderAs></BzHoverCardTrigger>
        <BzHoverCardContent Side="Side.Top" Class="w-auto">Opens above the trigger.<BzHoverCardArrow /></BzHoverCardContent>
    </BzHoverCard>
    <BzHoverCard>
        <BzHoverCardTrigger><RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Bottom</BzButton></RenderAs></BzHoverCardTrigger>
        <BzHoverCardContent Side="Side.Bottom" Class="w-auto">Opens below the trigger.<BzHoverCardArrow /></BzHoverCardContent>
    </BzHoverCard>
    <BzHoverCard>
        <BzHoverCardTrigger><RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Right</BzButton></RenderAs></BzHoverCardTrigger>
        <BzHoverCardContent Side="Side.Right" Class="w-auto">Opens to the right.<BzHoverCardArrow /></BzHoverCardContent>
    </BzHoverCard>
</div>
