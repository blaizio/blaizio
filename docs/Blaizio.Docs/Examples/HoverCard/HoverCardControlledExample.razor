<div class="flex flex-col items-center gap-4">
    <span class="text-muted-foreground text-sm">Open: @_open</span>
    <BzHoverCard @bind-Open="_open">
        <BzHoverCardTrigger>
            <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Hover me</BzButton></RenderAs>
        </BzHoverCardTrigger>
        <BzHoverCardContent>The open state lives in the page via @@bind-Open.</BzHoverCardContent>
    </BzHoverCard>
</div>

@code {
    private bool _open;
}
