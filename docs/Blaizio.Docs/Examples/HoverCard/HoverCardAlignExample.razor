<div class="flex items-center gap-2">
    <BzHoverCard>
        <BzHoverCardTrigger><RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Start</BzButton></RenderAs></BzHoverCardTrigger>
        <BzHoverCardContent Align="Align.Start">Aligned to the start edge.</BzHoverCardContent>
    </BzHoverCard>
    <BzHoverCard>
        <BzHoverCardTrigger><RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Center</BzButton></RenderAs></BzHoverCardTrigger>
        <BzHoverCardContent Align="Align.Center">Centered on the trigger.</BzHoverCardContent>
    </BzHoverCard>
    <BzHoverCard>
        <BzHoverCardTrigger><RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">End</BzButton></RenderAs></BzHoverCardTrigger>
        <BzHoverCardContent Align="Align.End">Aligned to the end edge.</BzHoverCardContent>
    </BzHoverCard>
</div>
