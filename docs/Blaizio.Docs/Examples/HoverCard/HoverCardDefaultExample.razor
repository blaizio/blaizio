<BzHoverCard>
    <BzHoverCardTrigger>
        <RenderAs Context="p"><BzButton Variant="ButtonVariant.Link" @attributes="p.Attributes">@@janedoe</BzButton></RenderAs>
    </BzHoverCardTrigger>
    <BzHoverCardContent Class="w-80">
        <div class="flex gap-4">
            <BzAvatar>
                <BzAvatarImage Src="https://i.pravatar.cc/120?img=47" Alt="Jane Doe" />
                <BzAvatarFallback>JD</BzAvatarFallback>
            </BzAvatar>
            <div class="space-y-1">
                <h4 class="text-sm font-semibold">Jane Doe</h4>
                <p class="text-sm text-muted-foreground">Product designer. Building accessible component libraries and writing about design systems.</p>
                <div class="flex items-center gap-1.5 pt-1 text-xs text-muted-foreground">
                    <BzIcon Icon="@Tabler.Outline.Calendar" Class="size-3.5" />
                    Joined March 2024
                </div>
            </div>
        </div>
    </BzHoverCardContent>
</BzHoverCard>
