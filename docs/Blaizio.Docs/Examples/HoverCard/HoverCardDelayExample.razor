<div class="flex items-center gap-6">
    @* Opens the instant you hover. *@
    <BzHoverCard OpenDelay="0">
        <BzHoverCardTrigger><RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Instant</BzButton></RenderAs></BzHoverCardTrigger>
        <BzHoverCardContent>Opens the moment you hover (OpenDelay 0).</BzHoverCardContent>
    </BzHoverCard>

    @* Waits to open, then lingers before closing. *@
    <BzHoverCard OpenDelay="700" CloseDelay="600">
        <BzHoverCardTrigger><RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Relaxed</BzButton></RenderAs></BzHoverCardTrigger>
        <BzHoverCardContent>Waits to open, then lingers before closing.</BzHoverCardContent>
    </BzHoverCard>
</div>
