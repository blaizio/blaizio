<BzDirectionProvider Direction="Direction.Rtl">
    <BzHoverCard>
        <BzHoverCardTrigger>
            <RenderAs Context="p"><BzButton Variant="ButtonVariant.Link" @attributes="p.Attributes">@@جين</BzButton></RenderAs>
        </BzHoverCardTrigger>
        <BzHoverCardContent Class="w-80">
            <div class="flex gap-4">
                <BzAvatar>
                    <BzAvatarImage Src="https://i.pravatar.cc/120?img=47" Alt="جين دو" />
                    <BzAvatarFallback>ج</BzAvatarFallback>
                </BzAvatar>
                <div class="space-y-1">
                    <h4 class="text-sm font-semibold">جين دو</h4>
                    <p class="text-sm text-muted-foreground">مصممة منتجات. تبني مكتبات مكونات سهلة الوصول وتكتب عن أنظمة التصميم.</p>
                </div>
            </div>
        </BzHoverCardContent>
    </BzHoverCard>
</BzDirectionProvider>
