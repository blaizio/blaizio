<RtlDemo Context="t">
    <BzDirectionProvider Dir="Direction.Rtl">
        <BzHoverCard>
            <BzHoverCardTrigger>
                <RenderAs Context="p"><BzButton Variant="ButtonVariant.Link" @attributes="p.Attributes">@t["@جين", "@ג׳יין"]</BzButton></RenderAs>
            </BzHoverCardTrigger>
            <BzHoverCardContent Class="w-80">
                <div class="flex gap-4">
                    <BzAvatar>
                        <BzAvatarImage Src="https://i.pravatar.cc/120?img=47" Alt='@t["جين دو", "ג׳יין דו"]' />
                        <BzAvatarFallback>@t["ج", "ג"]</BzAvatarFallback>
                    </BzAvatar>
                    <div class="space-y-1">
                        <h4 class="text-sm font-semibold">@t["جين دو", "ג׳יין דו"]</h4>
                        <p class="text-sm text-muted-foreground">@t["مصممة منتجات. تبني مكتبات مكونات سهلة الوصول وتكتب عن أنظمة التصميم.", "מעצבת מוצר. בונה ספריות רכיבים נגישות וכותבת על מערכות עיצוב."]</p>
                    </div>
                </div>
            </BzHoverCardContent>
        </BzHoverCard>
    </BzDirectionProvider>
</RtlDemo>
