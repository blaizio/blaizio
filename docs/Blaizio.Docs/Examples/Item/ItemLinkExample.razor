@* The whole row is one anchor - RenderAs puts the item styling onto it, and the a: hover
   tint from the skin kicks in. *@
<BzItem Variant="ItemVariant.Outline" Class="max-w-md">
    <RenderAs Context="p">
        <a href="docs/components/item" @attributes="p.Attributes">
            <BzItemMedia Variant="ItemMediaVariant.Icon">
                <BzIcon Icon="@Icons.Outline.FileText" />
            </BzItemMedia>
            <BzItemContent>
                <BzItemTitle>Release notes</BzItemTitle>
                <BzItemDescription>Everything that shipped in 2.4 - opens the changelog.</BzItemDescription>
            </BzItemContent>
            <BzItemActions>
                <BzIcon Icon="@Icons.Outline.ChevronRight" Class="text-muted-foreground size-4 rtl:rotate-180" />
            </BzItemActions>
        </a>
    </RenderAs>
</BzItem>
