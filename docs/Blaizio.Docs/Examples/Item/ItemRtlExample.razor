<RtlDemo Context="t">
    <BzDirectionProvider Dir="Direction.Rtl">
        <BzItem Variant="ItemVariant.Outline" Class="max-w-md">
            <BzItemMedia Variant="ItemMediaVariant.Icon">
                <BzIcon Icon="@Icons.Outline.ShieldCheck" />
            </BzItemMedia>
            <BzItemContent>
                <BzItemTitle>@t["المصادقة الثنائية", "אימות דו-שלבי"]</BzItemTitle>
                <BzItemDescription>@t["حسابك محمي بتطبيق المصادقة.", "החשבון שלך מוגן באמצעות אפליקציית אימות."]</BzItemDescription>
            </BzItemContent>
            <BzItemActions>
                <BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">@t["إدارة", "ניהול"]</BzButton>
            </BzItemActions>
        </BzItem>
    </BzDirectionProvider>
</RtlDemo>
