<BzItem Variant="ItemVariant.Muted" Class="max-w-md">
    <BzItemMedia Variant="ItemMediaVariant.Icon">
        <BzIcon Icon="@Tabler.Outline.InfoCircle" />
    </BzItemMedia>
    <BzItemContent>
        <BzItemTitle>Scheduled maintenance</BzItemTitle>
        <BzItemDescription>The dashboard will be read-only on Saturday from 02:00 to 04:00 UTC.</BzItemDescription>
    </BzItemContent>
    <BzItemActions>
        <BzButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" aria-label="Dismiss">
            <BzIcon Icon="@Tabler.Outline.X" />
        </BzButton>
    </BzItemActions>
</BzItem>
