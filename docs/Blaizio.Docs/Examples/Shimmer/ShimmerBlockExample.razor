@* shimmer-block paints the sweep over the element's own fill instead of clipping it to text - the
   same band and the same knobs. Skeleton's shimmer animation is exactly this class. *@
<div class="w-full max-w-md space-y-6">
    <div class="space-y-2">
        <p class="text-muted-foreground text-xs font-medium">shimmer-block on plain surfaces</p>
        <div class="flex items-center gap-3">
            <div class="bg-muted shimmer-block size-12 rounded-full"></div>
            <div class="flex-1 space-y-2">
                <div class="bg-muted shimmer-block h-3 w-full rounded"></div>
                <div class="bg-muted shimmer-block h-3 w-3/5 rounded"></div>
            </div>
        </div>
    </div>

    <div class="space-y-2">
        <p class="text-muted-foreground text-xs font-medium">The same class, tuned</p>
        <div class="bg-muted shimmer-block shimmer-duration-900 shimmer-spread-25 h-8 w-full rounded"></div>
        <div class="bg-muted shimmer-block shimmer-color-primary h-8 w-full rounded"></div>
    </div>

    <div class="space-y-2">
        <p class="text-muted-foreground text-xs font-medium">Skeleton, which ships it</p>
        <BzSkeleton Class="h-8 w-full" />
    </div>
</div>
