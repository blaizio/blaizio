@* shimmer-color-* replaces the band while the text keeps its own colour - a theme token, or any
   colour you like. *@
<div class="w-fit space-y-4">
    <p class="shimmer text-muted-foreground">Derived from the text colour (default)</p>
    <p class="shimmer shimmer-color-primary text-muted-foreground">shimmer-color-primary</p>
    <p class="shimmer shimmer-color-destructive text-muted-foreground">shimmer-color-destructive</p>
    <p class="shimmer shimmer-color-[oklch(0.8_0.18_85)] text-muted-foreground">shimmer-color-[oklch(0.8_0.18_85)]</p>
</div>
