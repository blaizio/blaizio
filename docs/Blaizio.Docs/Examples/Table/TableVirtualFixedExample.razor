@* 10,000 rows in a 24rem scroll box - only the visible band is ever in the DOM.
   Drop MaxHeight to virtualize against the page instead (no height cap). *@
<div class="w-full max-w-3xl [&_[data-slot=table]]:table-fixed">
    <BzDataTable TItem="Member" Items="_bigData" RowKey="@(m => m.Id)"
               Virtualize ItemSize="49" MaxHeight="24rem" StickyHeader
               Searchable SearchPlaceholder="Search 10,000 rows...">
        <BzPropertyColumn Title="#" Property="@(m => m.Id)" Align="end" HeaderClass="w-16" CellClass="text-muted-foreground tabular-nums" Sortable />
        <BzPropertyColumn Property="@(m => m.Name)" HeaderClass="w-44" Sortable />
        <BzPropertyColumn Property="@(m => m.Email)" Sortable />
        <BzPropertyColumn Property="@(m => m.Role)" HeaderClass="w-28" Sortable />
        <BzTemplateColumn Title="Status" SortBy="@(m => m.Status)" HeaderClass="w-32" Sortable>
            <BzBadge Variant="@StatusVariant(context.Status)">@context.Status</BzBadge>
        </BzTemplateColumn>
        <BzPropertyColumn Title="Balance" Property="@(m => m.Balance)" Format="C" Align="end" HeaderClass="w-32" Sortable />
    </BzDataTable>
</div>

@code {
    private sealed record Member(int Id, string Name, string Email, string Role, string Status, decimal Balance);

    // Built once per session, not on every visit: unlike a plain virtualizer, a data table reads
    // every row to search and sort, so this set genuinely has to exist.
    private readonly IReadOnlyList<Member> _bigData = DemoRows.Cached<Member, Member>(() =>
    {
        var first = new[] { "Olivia", "Jackson", "Isabella", "William", "Sofia", "Liam", "Emma", "Noah", "Ava", "Lucas", "Mia", "Ethan" };
        var last = new[] { "Martin", "Lee", "Nguyen", "Kim", "Davis", "Johnson", "Wilson", "Brown", "Garcia", "Miller", "Jones", "Khan" };
        var roles = new[] { "Owner", "Admin", "Member", "Viewer" };
        var statuses = new[] { "Active", "Invited", "Suspended" };
        var rng = new Random(42);

        // The 144 name combinations and their email stems are built once instead of per row -
        // formatting and lower-casing ten thousand names is what made this page stall on load.
        var names = new string[first.Length * last.Length];
        var stems = new string[names.Length];
        for (var f = 0; f < first.Length; f++)
        {
            for (var l = 0; l < last.Length; l++)
            {
                var n = $"{first[f]} {last[l]}";
                names[(f * last.Length) + l] = n;
                stems[(f * last.Length) + l] = n.ToLowerInvariant().Replace(' ', '.');
            }
        }

        var rows = new List<Member>(10_000);
        for (var i = 1; i <= 10_000; i++)
        {
            var n = rng.Next(names.Length);
            rows.Add(new Member(i, names[n], string.Concat(stems[n], i.ToString(), "@example.com"),
                roles[rng.Next(roles.Length)], statuses[rng.Next(statuses.Length)],
                Math.Round((decimal)(rng.NextDouble() * 2000), 2)));
        }
        return rows;
    });

    private static BadgeVariant StatusVariant(string status) => status switch
    {
        "Active" => BadgeVariant.Default,
        "Suspended" => BadgeVariant.Destructive,
        _ => BadgeVariant.Secondary,
    };
}
