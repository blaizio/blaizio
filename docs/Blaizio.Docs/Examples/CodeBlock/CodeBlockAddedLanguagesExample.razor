@* Python comes from Blaizio.Syntax.Languages, and "log" is a SyntaxGrammar of this site's own
   (LogGrammar.cs, written as in Your own language). Both are added in Program.cs:

       builder.Services.AddBlaizio(options => options.Syntax
           .Add(SyntaxLanguages.Python)
           .Add(LogGrammar.Instance));

   Once added, a language is just a Language value. Without that line the code shows plain. *@
<div class="w-full max-w-2xl">
    <BzTabs DefaultValue="python">
        <BzTabsList AriaLabel="Files">
            <BzTabsTrigger Value="python">orders.py</BzTabsTrigger>
            <BzTabsTrigger Value="log">shop.log</BzTabsTrigger>
        </BzTabsList>
        <BzTabsContent Value="python">
            <BzCodeBlock>
                <BzCodeBlockActions>
                    <BzCodeBlockCopyButton />
                </BzCodeBlockActions>
                <BzCodeBlockContent Code="@Python" Language="python" />
            </BzCodeBlock>
        </BzTabsContent>
        <BzTabsContent Value="log">
            <BzCodeBlock>
                <BzCodeBlockActions>
                    <BzCodeBlockWrapButton />
                    <BzCodeBlockCopyButton />
                </BzCodeBlockActions>
                <BzCodeBlockContent Code="@Log" Language="log" />
            </BzCodeBlock>
        </BzTabsContent>
    </BzTabs>
</div>

@code {
    private const string Python = """"
        from dataclasses import dataclass

        @dataclass(frozen=True)
        class Order:
            id: int
            total: float = 0.0

        def summarize(orders: list[Order]) -> str:
            """Totals the orders, skipping refunds."""
            paid = [o for o in orders if o.total > 0]
            return f"{len(paid)} orders, {sum(o.total for o in paid):.2f} EUR"
        """";

