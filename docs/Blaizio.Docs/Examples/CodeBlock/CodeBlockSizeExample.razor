@* Size Sm tightens the padding and drops the code to text-xs - for tool output in a Trace. *@
<div class="flex w-full max-w-md flex-col gap-4">
    <BzCodeBlock>
        <BzCodeBlockHeader>
            <BzCodeBlockTitle>Default</BzCodeBlockTitle>
        </BzCodeBlockHeader>
        <BzCodeBlockContent Code="@Output" />
    </BzCodeBlock>
    <BzCodeBlock Size="CodeBlockSize.Sm">
        <BzCodeBlockHeader>
            <BzCodeBlockTitle>Sm</BzCodeBlockTitle>
        </BzCodeBlockHeader>
        <BzCodeBlockContent Code="@Output" />
    </BzCodeBlock>
</div>

@code {
    private const string Output = """
        dotnet ef migrations add AddOrderLines
        Build started...
        Build succeeded.
        Done. To undo this action, use 'ef migrations remove'
        """;
}
