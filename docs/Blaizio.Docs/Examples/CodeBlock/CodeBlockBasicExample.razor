@* A Code string renders as one text node, so it stays cheap while output streams in. *@
<div class="w-full max-w-lg">
    <BzCodeBlock>
        <BzCodeBlockContent Code="@Output" />
    </BzCodeBlock>
</div>

@code {
    private const string Output = """
        $ dotnet build
          Determining projects to restore...
          All projects are up-to-date for restore.
          Shop.Api -> /src/Shop.Api/bin/Debug/net10.0/Shop.Api.dll

        Build succeeded.
            0 Warning(s)
            0 Error(s)
        """;
}
