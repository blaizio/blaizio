@* A title with an icon, and a title wrapped in a link to its file. A long title truncates. *@
<div class="flex w-full max-w-md flex-col gap-4">
    <BzCodeBlock>
        <BzCodeBlockHeader>
            <BzCodeBlockTitle>
                <BzIcon Icon="@Tabler.Outline.Settings" />
                appsettings.json
            </BzCodeBlockTitle>
            <BzCodeBlockActions>
                <BzCodeBlockCopyButton />
            </BzCodeBlockActions>
        </BzCodeBlockHeader>
        <BzCodeBlockContent Code="@Settings" Language="json" />
    </BzCodeBlock>

    <BzCodeBlock>
        <BzCodeBlockHeader>
            <a href="#" @onclick:preventDefault class="min-w-0 hover:underline">
                <BzCodeBlockTitle>src/Shop.Web/Components/Pages/Checkout/OrderSummary.razor</BzCodeBlockTitle>
            </a>
            <BzCodeBlockActions>
                <BzCodeBlockCopyButton />
            </BzCodeBlockActions>
        </BzCodeBlockHeader>
        <BzCodeBlockContent Code="@Summary" Language="razor" />
    </BzCodeBlock>
</div>

@code {
    private const string Settings = """
        {
          "ConnectionStrings": {
            "Shop": "Host=localhost;Database=shop"
          }
        }
        """;

    private const string Summary = """
        <BzCard>
            <BzCardTitle>Order summary</BzCardTitle>
        </BzCard>
        """;
}
