@preservewhitespace true
@* Render BzCodeBlockLine children yourself for tokens of your own - output from a highlighter, or
   spans you color by hand - and for a variant on any line. preservewhitespace keeps each line's
   leading indentation, which Razor otherwise trims from child content. *@
<div class="w-full max-w-md">
    <BzCodeBlock>
        <BzCodeBlockHeader>
            <BzCodeBlockTitle>Counter.razor</BzCodeBlockTitle>
            <BzCodeBlockActions>
                <BzCodeBlockCopyButton />
            </BzCodeBlockActions>
        </BzCodeBlockHeader>
        <BzCodeBlockContent LineNumbers>
            <BzCodeBlockLine><span class="text-sky-700 dark:text-sky-300">&lt;BzButton</span> <span class="text-violet-700 dark:text-violet-300">OnClick</span>=<span class="text-emerald-700 dark:text-emerald-300">"Increment"</span><span class="text-sky-700 dark:text-sky-300">&gt;</span></BzCodeBlockLine>
            <BzCodeBlockLine>    Clicked @@_count times</BzCodeBlockLine>
            <BzCodeBlockLine><span class="text-sky-700 dark:text-sky-300">&lt;/BzButton&gt;</span></BzCodeBlockLine>
            <BzCodeBlockLine />
            <BzCodeBlockLine><span class="text-violet-700 dark:text-violet-300">@@code</span> {</BzCodeBlockLine>
            <BzCodeBlockLine Variant="CodeBlockLineVariant.Highlighted">    <span class="text-sky-700 dark:text-sky-300">private int</span> _count;</BzCodeBlockLine>
            <BzCodeBlockLine>    <span class="text-sky-700 dark:text-sky-300">private void</span> Increment() =&gt; _count++;</BzCodeBlockLine>
            <BzCodeBlockLine>}</BzCodeBlockLine>
        </BzCodeBlockContent>
    </BzCodeBlock>
</div>
