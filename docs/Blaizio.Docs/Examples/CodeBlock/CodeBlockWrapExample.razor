@* Long lines scroll by default; Wrap wraps them, which suits tool output and error messages. *@
<div class="w-full max-w-md">
    <BzCodeBlock>
        <BzCodeBlockContent Code="@Warning" Wrap />
    </BzCodeBlock>
</div>

@code {
    private const string Warning = """
        warn: Microsoft.EntityFrameworkCore.Query[10102] Query uses a row limiting operator ('Skip'/'Take') without an 'OrderBy' operator. This may lead to unpredictable results. If the 'Distinct' operator is used after 'OrderBy', make sure to use the 'OrderBy' operator after 'Distinct' as the ordering would otherwise get erased.
        """;
}
