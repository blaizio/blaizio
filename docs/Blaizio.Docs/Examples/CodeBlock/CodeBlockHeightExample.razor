@* A max-h-* class on the content caps it; the code scrolls inside the block. *@
<div class="w-full max-w-2xl">
    <BzCodeBlock>
        <BzCodeBlockHeader>
            <BzCodeBlockTitle>appsettings.json</BzCodeBlockTitle>
            <BzCodeBlockActions>
                <BzCodeBlockCopyButton />
            </BzCodeBlockActions>
        </BzCodeBlockHeader>
        <BzCodeBlockContent Code="@Settings" Language="json" LineNumbers Class="max-h-56" />
    </BzCodeBlock>
</div>

@code {
    private const string Settings = """
        {
          "Logging": {
            "LogLevel": {
              "Default": "Information",
              "Microsoft.AspNetCore": "Warning",
              "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
            }
          },
          "ConnectionStrings": {
            "Shop": "Host=localhost;Database=shop;Username=shop"
          },
          "Checkout": {
            "Currency": "USD",
            "TaxRate": 0.07,
            "FreeShippingOver": 50
          },
          "AllowedHosts": "*"
        }
        """;
}
