@* No header: the actions float at the top end corner. They show when the block is hovered or holds
   focus (tab into the code to see them), and always on touch screens. *@
<div class="w-full max-w-md">
    <BzCodeBlock>
        <BzCodeBlockActions>
            <BzCodeBlockCopyButton />
        </BzCodeBlockActions>
        <BzCodeBlockContent Code="@Command" Language="bash" />
    </BzCodeBlock>
</div>

@code {
    private const string Command = "dotnet add package Blaizio.Base";
}
