<div class="flex w-full max-w-sm flex-col gap-12 pt-10">
    <BzSlider DefaultValue="60" Max="100" Step="1" AriaLabel="Brightness"
              TooltipMode="SliderTooltip.OnInteraction" TooltipFormat="@(v => $"{v}%")" />
    <BzSlider DefaultValues="@([20, 80])" Max="100" Step="1"
              AriaLabels="@(["Range start", "Range end"])"
              TooltipMode="SliderTooltip.Always" />
</div>
