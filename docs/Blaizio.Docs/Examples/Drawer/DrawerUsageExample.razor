<BzDrawer>
    <BzDrawerTrigger Variant="ButtonVariant.Outline">Open drawer</BzDrawerTrigger>
    <BzDrawerContent>
        <div class="mx-auto w-full max-w-sm">
            <BzDrawerHeader>
                <BzDrawerTitle>Move goal</BzDrawerTitle>
                <BzDrawerDescription>Set your daily activity goal.</BzDrawerDescription>
            </BzDrawerHeader>
            <BzDrawerFooter>
                <BzButton>Submit</BzButton>
                <BzDrawerClose Variant="ButtonVariant.Outline">Cancel</BzDrawerClose>
            </BzDrawerFooter>
        </div>
    </BzDrawerContent>
</BzDrawer>
