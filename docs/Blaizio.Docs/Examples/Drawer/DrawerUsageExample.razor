<BzDrawer>
    <BzDrawerTrigger Variant="ButtonVariant.Outline">Open drawer</BzDrawerTrigger>
    <BzDrawerContent>
        <div class="mx-auto w-full max-w-sm">
            <BzDrawerHeader>
                <BzDrawerTitle>Writing goal</BzDrawerTitle>
                <BzDrawerDescription>How many words you aim to write each day.</BzDrawerDescription>
            </BzDrawerHeader>
            <BzDrawerFooter>
                <BzButton>Save goal</BzButton>
                <BzDrawerClose Variant="ButtonVariant.Outline">Cancel</BzDrawerClose>
            </BzDrawerFooter>
        </div>
    </BzDrawerContent>
</BzDrawer>
