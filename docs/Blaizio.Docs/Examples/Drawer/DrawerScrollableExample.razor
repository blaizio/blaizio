<BzDrawer>
    <BzDrawerTrigger Variant="ButtonVariant.Outline">Browse</BzDrawerTrigger>
    <BzDrawerContent>
        <div class="mx-auto flex w-full max-w-sm flex-col overflow-hidden">
            <BzDrawerHeader>
                <BzDrawerTitle>Notifications</BzDrawerTitle>
                <BzDrawerDescription>Your recent activity.</BzDrawerDescription>
            </BzDrawerHeader>
            <div class="scrollbar-thin overflow-y-auto px-4">
                @for (var i = 1; i <= 20; i++)
                {
                    <div class="border-b py-3 text-sm last:border-0">Activity item @i</div>
                }
            </div>
            <BzDrawerFooter>
                <BzDrawerClose>Close</BzDrawerClose>
            </BzDrawerFooter>
        </div>
    </BzDrawerContent>
</BzDrawer>
