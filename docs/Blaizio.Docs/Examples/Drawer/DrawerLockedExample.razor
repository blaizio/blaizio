<BzDrawer DismissOnOutsideClick="false">
    <BzDrawerTrigger Variant="ButtonVariant.Outline">Confirm action</BzDrawerTrigger>
    <BzDrawerContent>
        <div class="mx-auto w-full max-w-sm">
            <BzDrawerHeader>
                <BzDrawerTitle>Delete project?</BzDrawerTitle>
                <BzDrawerDescription>This can't be undone. Choose an option to continue.</BzDrawerDescription>
            </BzDrawerHeader>
            <BzDrawerFooter>
                <BzDrawerClose Variant="ButtonVariant.Destructive">Delete</BzDrawerClose>
                <BzDrawerClose Variant="ButtonVariant.Outline">Keep</BzDrawerClose>
            </BzDrawerFooter>
        </div>
    </BzDrawerContent>
</BzDrawer>
