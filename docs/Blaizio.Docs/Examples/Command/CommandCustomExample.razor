@* The scroll surface ships `scrollbar-thin`. To hand it back to the browser, pass
   `scrollbar-auto` - the class merge drops ours, so nothing is left to fight. Add a class of
   your own next to it (`scrollbar-auto my-bar`) when you want to style the bar yourself. *@
<BzCommand Class="w-full max-w-md rounded-xl border-2 border-indigo-500/40 shadow-md [&_[data-slot=command-input-wrapper]]:border-indigo-500/40 [&_[data-slot=command-input]]:placeholder:text-indigo-400 [&_[data-bz-command-group-heading]]:text-indigo-500 [&_[data-slot=command-item]]:data-selected:bg-indigo-600 [&_[data-slot=command-item]]:data-selected:text-white [&_[data-slot=command-item][data-selected]_svg]:!text-white">
    <BzCommandInput Placeholder="Search the brand palette..." />
    <BzCommandList Class="scrollbar-auto">
        <BzCommandEmpty>No results found.</BzCommandEmpty>
        <BzCommandGroup Heading="Actions">
            <BzCommandItem Value="New project"><BzIcon Icon="@Tabler.Outline.Plus" /><span>New project</span></BzCommandItem>
            <BzCommandItem Value="Invite teammate"><BzIcon Icon="@Tabler.Outline.UserPlus" /><span>Invite teammate</span></BzCommandItem>
            <BzCommandItem Value="Open settings"><BzIcon Icon="@Tabler.Outline.Settings" /><span>Open settings</span></BzCommandItem>
        </BzCommandGroup>
    </BzCommandList>
</BzCommand>
