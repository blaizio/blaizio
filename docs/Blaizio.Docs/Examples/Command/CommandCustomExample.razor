@* The scroll surface ships `scrollbar-thin`. Swap it by passing another scrollbar utility -
   `scrollbar-hover` (fades in while scrolling), `scrollbar-activity` or `scrollbar-none` -
   and the class merge drops the default for you. *@
<BzCommand Class="w-full max-w-md rounded-xl border-2 border-indigo-500/40 shadow-md [&_[data-slot=command-input-wrapper]]:border-indigo-500/40 [&_[data-slot=command-input]]:placeholder:text-indigo-400 [&_[data-bz-command-group-heading]]:text-indigo-500 [&_[data-slot=command-item]]:data-selected:bg-indigo-600 [&_[data-slot=command-item]]:data-selected:text-white [&_[data-slot=command-item][data-selected]_svg]:!text-white">
    <BzCommandInput Placeholder="Search the brand palette..." />
    <BzCommandList Class="scrollbar-hover">
        <BzCommandEmpty>No results found.</BzCommandEmpty>
        <BzCommandGroup Heading="Actions">
            <BzCommandItem Value="New project"><BzIcon Icon="@Icons.Outline.Plus" /><span>New project</span></BzCommandItem>
            <BzCommandItem Value="Invite teammate"><BzIcon Icon="@Icons.Outline.UserPlus" /><span>Invite teammate</span></BzCommandItem>
            <BzCommandItem Value="Open settings"><BzIcon Icon="@Icons.Outline.Settings" /><span>Open settings</span></BzCommandItem>
        </BzCommandGroup>
    </BzCommandList>
</BzCommand>
