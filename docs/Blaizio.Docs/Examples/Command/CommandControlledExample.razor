<div class="flex w-full max-w-md flex-col items-center gap-3">
    <BzCommand @bind-Search="_search" Class="w-full rounded-lg border shadow-md">
        <BzCommandInput Placeholder="Search fruit..." />
        <BzCommandList>
            <BzCommandEmpty>No fruit found.</BzCommandEmpty>
            <BzCommandGroup Heading="Fruit">
                <BzCommandItem Value="Apple">Apple</BzCommandItem>
                <BzCommandItem Value="Banana">Banana</BzCommandItem>
                <BzCommandItem Value="Blueberry">Blueberry</BzCommandItem>
                <BzCommandItem Value="Grapes">Grapes</BzCommandItem>
                <BzCommandItem Value="Pineapple">Pineapple</BzCommandItem>
            </BzCommandGroup>
        </BzCommandList>
    </BzCommand>
    <p class="text-sm text-muted-foreground">Search: <span class="font-mono">@(string.IsNullOrEmpty(_search) ? "(empty)" : _search)</span></p>
</div>

@code {
    private string _search = "";
}
