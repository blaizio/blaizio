<div class="flex flex-col items-center gap-3">
    <BzButton Variant="ButtonVariant.Outline" Class="w-64 justify-between text-muted-foreground" @onclick="@(() => _paletteOpen = true)">
        <span class="flex items-center gap-2"><BzIcon Icon="@Tabler.Outline.Search" />Search...</span>
        <BzKbd Key="mod+k" OnTrigger="@(() => _paletteOpen = true)" />
    </BzButton>
    <p class="text-sm text-muted-foreground">Last run: <span class="font-mono">@(_lastRun ?? "-")</span></p>
</div>
<BzCommandDialog @bind-Open="_paletteOpen" Description="Find a page or an action and press Enter to run it.">
    <BzCommandInput Placeholder="Run a command or jump to a page..." />
    <BzCommandList>
        <BzCommandEmpty>Nothing matches. Try a shorter word.</BzCommandEmpty>
        <BzCommandGroup Heading="Jump to">
            <BzCommandItem Value="Dashboard" OnSelect="RunCommand"><BzIcon Icon="@Tabler.Outline.LayoutDashboard" /><span>Dashboard</span></BzCommandItem>
            <BzCommandItem Value="Inbox" OnSelect="RunCommand"><BzIcon Icon="@Tabler.Outline.Mail" /><span>Inbox</span></BzCommandItem>
            <BzCommandItem Value="Deploy" OnSelect="RunCommand"><BzIcon Icon="@Tabler.Outline.Rocket" /><span>Deploy</span></BzCommandItem>
        </BzCommandGroup>
        <BzCommandSeparator />
        <BzCommandGroup Heading="Account">
            <BzCommandItem Value="Profile" OnSelect="RunCommand"><BzIcon Icon="@Tabler.Outline.User" /><span>Profile</span><BzCommandShortcut>⌘P</BzCommandShortcut></BzCommandItem>
            <BzCommandItem Value="Settings" OnSelect="RunCommand"><BzIcon Icon="@Tabler.Outline.Settings" /><span>Settings</span><BzCommandShortcut>⌘S</BzCommandShortcut></BzCommandItem>
        </BzCommandGroup>
    </BzCommandList>
</BzCommandDialog>

@code {
    private bool _paletteOpen;
    private string? _lastRun;

    private void RunCommand(string value)
    {
        _lastRun = value;
        _paletteOpen = false;
    }
}
