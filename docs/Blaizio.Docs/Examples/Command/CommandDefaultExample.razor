<BzCommand Class="w-full max-w-md rounded-lg border shadow-md">
    <BzCommandInput Placeholder="Run a command or jump to a page..." />
    <BzCommandList>
        <BzCommandEmpty>Nothing matches. Try a shorter word.</BzCommandEmpty>
        <BzCommandGroup Heading="Jump to">
            <BzCommandItem Value="Dashboard"><BzIcon Icon="@Tabler.Outline.LayoutDashboard" /><span>Dashboard</span></BzCommandItem>
            <BzCommandItem Value="Inbox" Keywords="@(new[] { "email", "messages" })"><BzIcon Icon="@Tabler.Outline.Mail" /><span>Inbox</span></BzCommandItem>
            <BzCommandItem Value="Reports" Disabled><BzIcon Icon="@Tabler.Outline.ChartBar" /><span>Reports</span></BzCommandItem>
        </BzCommandGroup>
        <BzCommandSeparator />
        <BzCommandGroup Heading="Account">
            <BzCommandItem Value="Profile"><BzIcon Icon="@Tabler.Outline.User" /><span>Profile</span><BzCommandShortcut>⌘P</BzCommandShortcut></BzCommandItem>
            <BzCommandItem Value="Billing"><BzIcon Icon="@Tabler.Outline.CreditCard" /><span>Billing</span><BzCommandShortcut>⌘B</BzCommandShortcut></BzCommandItem>
            <BzCommandItem Value="Settings"><BzIcon Icon="@Tabler.Outline.Settings" /><span>Settings</span><BzCommandShortcut>⌘S</BzCommandShortcut></BzCommandItem>
        </BzCommandGroup>
    </BzCommandList>
</BzCommand>
