<BzCommand Class="w-full max-w-md rounded-lg border shadow-md">
    <BzCommandInput Placeholder="Search a city..." />
    <BzCommandList Class="max-h-48">
        <BzCommandEmpty>No city found.</BzCommandEmpty>
        <BzCommandGroup Heading="Cities">
            @foreach (var city in _cities)
            {
                <BzCommandItem Value="@city">@city</BzCommandItem>
            }
        </BzCommandGroup>
    </BzCommandList>
</BzCommand>

@code {
    private static readonly string[] _cities =
    [
        "Abu Dhabi", "Amsterdam", "Athens", "Berlin", "Cairo", "Chicago", "Dubai", "Istanbul",
        "London", "Madrid", "Nairobi", "New York", "Paris", "Riyadh", "Singapore", "Sydney",
        "Tokyo", "Toronto", "Vienna", "Zurich",
    ];
}
