<RtlDemo Context="t">
    <BzDirectionProvider Dir="Direction.Rtl">
        <BzCommand Class="w-full max-w-md rounded-lg border shadow-md">
            <BzCommandInput Placeholder='@t["اكتب أمرًا أو ابحث...", "הקלד פקודה או חפש..."]' />
            <BzCommandList>
                <BzCommandEmpty>@t["لا توجد نتائج.", "אין תוצאות."]</BzCommandEmpty>
                <BzCommandGroup Heading='@t["اقتراحات", "הצעות"]'>
                    <BzCommandItem Value='@t["التقويم", "לוח שנה"]'><BzIcon Icon="@Tabler.Outline.Calendar" /><span>@t["التقويم", "לוח שנה"]</span></BzCommandItem>
                    <BzCommandItem Value='@t["البريد", "דואר"]'><BzIcon Icon="@Tabler.Outline.Mail" /><span>@t["البريد", "דואר"]</span></BzCommandItem>
                    <BzCommandItem Value='@t["الملف الشخصي", "פרופיל"]'><BzIcon Icon="@Tabler.Outline.User" /><span>@t["الملف الشخصي", "פרופיל"]</span><BzCommandShortcut>⌘P</BzCommandShortcut></BzCommandItem>
                </BzCommandGroup>
            </BzCommandList>
        </BzCommand>
    </BzDirectionProvider>
</RtlDemo>
