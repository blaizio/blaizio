<div class="flex w-full max-w-xs flex-col gap-2">
    @foreach (var size in new[] { AttachmentSize.Default, AttachmentSize.Sm, AttachmentSize.Xs })
    {
        <BzAttachment Size="@size">
            <BzAttachmentMedia><BzIcon Icon="@Tabler.Outline.FileText" /></BzAttachmentMedia>
            <BzAttachmentContent>
                <BzAttachmentTitle>notes-@(size.ToString().ToLowerInvariant()).md</BzAttachmentTitle>
                <BzAttachmentDescription>Markdown · 4 KB</BzAttachmentDescription>
            </BzAttachmentContent>
            <BzAttachmentActions>
                <BzAttachmentAction aria-label="Remove">
                    <BzIcon Icon="@Tabler.Outline.X" />
                </BzAttachmentAction>
            </BzAttachmentActions>
        </BzAttachment>
    }
</div>
