<div class="flex w-full max-w-xs flex-col gap-2">
    <BzAttachment State="AttachmentState.Uploading">
        <BzAttachmentMedia><BzIcon Icon="@Icons.Outline.FileText" /></BzAttachmentMedia>
        <BzAttachmentContent>
            <BzAttachmentTitle>slides.pptx</BzAttachmentTitle>
            <BzAttachmentDescription>Uploading… 45%</BzAttachmentDescription>
        </BzAttachmentContent>
    </BzAttachment>
    <BzAttachment State="AttachmentState.Processing">
        <BzAttachmentMedia><BzIcon Icon="@Icons.Outline.Photo" /></BzAttachmentMedia>
        <BzAttachmentContent>
            <BzAttachmentTitle>team-photo.png</BzAttachmentTitle>
            <BzAttachmentDescription>Processing…</BzAttachmentDescription>
        </BzAttachmentContent>
    </BzAttachment>
    <BzAttachment State="AttachmentState.Error">
        <BzAttachmentMedia><BzIcon Icon="@Icons.Outline.FileZip" /></BzAttachmentMedia>
        <BzAttachmentContent>
            <BzAttachmentTitle>backup.zip</BzAttachmentTitle>
            <BzAttachmentDescription>Upload failed - file too large</BzAttachmentDescription>
        </BzAttachmentContent>
        <BzAttachmentActions>
            <BzAttachmentAction aria-label="Retry">
                <BzIcon Icon="@Icons.Outline.Refresh" />
            </BzAttachmentAction>
        </BzAttachmentActions>
    </BzAttachment>
    <BzAttachment State="AttachmentState.Done">
        <BzAttachmentMedia><BzIcon Icon="@Icons.Outline.FileSpreadsheet" /></BzAttachmentMedia>
        <BzAttachmentContent>
            <BzAttachmentTitle>budget.xlsx</BzAttachmentTitle>
            <BzAttachmentDescription>XLSX · 88 KB · Done</BzAttachmentDescription>
        </BzAttachmentContent>
        <BzAttachmentActions>
            <BzAttachmentAction aria-label="Remove">
                <BzIcon Icon="@Icons.Outline.X" />
            </BzAttachmentAction>
        </BzAttachmentActions>
    </BzAttachment>
</div>
