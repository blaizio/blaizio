<BzDialog>
    <BzAttachment>
        <BzAttachmentMedia Variant="AttachmentMediaVariant.Image">
            <img src="https://picsum.photos/seed/bz-trigger/80/80" alt="" />
        </BzAttachmentMedia>
        <BzAttachmentContent>
            <BzAttachmentTitle>beach.jpg</BzAttachmentTitle>
            <BzAttachmentDescription>Click the card to preview</BzAttachmentDescription>
        </BzAttachmentContent>
        <BzAttachmentActions>
            <BzAttachmentAction aria-label="Remove">
                <BzIcon Icon="@Tabler.Outline.X" />
            </BzAttachmentAction>
        </BzAttachmentActions>
        @* The overlay makes the whole card open the dialog; the Remove action above stays clickable. *@
        <BzDialogTrigger>
            <RenderAs Context="p">
                <BzAttachmentTrigger @attributes="p.Attributes">
                    <span class="sr-only">Preview beach.jpg</span>
                </BzAttachmentTrigger>
            </RenderAs>
        </BzDialogTrigger>
    </BzAttachment>
    <BzDialogContent Class="sm:max-w-md">
        <BzDialogHeader>
            <BzDialogTitle>beach.jpg</BzDialogTitle>
            <BzDialogDescription>JPG · 1.4 MB</BzDialogDescription>
        </BzDialogHeader>
        <img src="https://picsum.photos/seed/bz-trigger/640/420" alt="Beach preview" class="w-full rounded-lg" />
    </BzDialogContent>
</BzDialog>
