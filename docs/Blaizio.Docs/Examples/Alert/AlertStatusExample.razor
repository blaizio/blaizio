<div class="flex w-full max-w-md flex-col gap-3">
    <BzAlert Variant="AlertVariant.Accent">
        <BzIcon Icon="@Tabler.Outline.Sparkles" />
        <BzAlertTitle>New in this release</BzAlertTitle>
        <BzAlertDescription>Tags input, tooltip colors, and an accent variant across the library.</BzAlertDescription>
    </BzAlert>
    <BzAlert Variant="AlertVariant.Success">
        <BzIcon Icon="@Tabler.Outline.CircleCheck" />
        <BzAlertTitle>Deployment complete</BzAlertTitle>
        <BzAlertDescription>Your site is live on the new version.</BzAlertDescription>
    </BzAlert>
    <BzAlert Variant="AlertVariant.Warning">
        <BzIcon Icon="@Tabler.Outline.AlertTriangle" />
        <BzAlertTitle>Certificate expires soon</BzAlertTitle>
        <BzAlertDescription>Renew the TLS certificate within 7 days.</BzAlertDescription>
    </BzAlert>
    <BzAlert Variant="AlertVariant.Info">
        <BzIcon Icon="@Tabler.Outline.InfoCircle" />
        <BzAlertTitle>Scheduled maintenance</BzAlertTitle>
        <BzAlertDescription>The API will be read-only on Sunday 02:00-03:00 UTC.</BzAlertDescription>
    </BzAlert>
</div>
