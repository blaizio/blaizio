@* BzImageSource children turn the img into a <picture>: the browser takes the first matching
   candidate (art direction), falling back to the img's own Src. Resize the window to swap. *@
<div class="w-full max-w-md">
    <BzImage Src="https://picsum.photos/seed/bz-mobile/600/600" Alt="Art-directed landscape" Ratio="16.0 / 9">
        <BzImageSource Media="(min-width: 1024px)" SrcSet="https://picsum.photos/seed/bz-desktop/1200/675" />
        <BzImageSource Media="(min-width: 640px)" SrcSet="https://picsum.photos/seed/bz-tablet/800/450" />
    </BzImage>
</div>
