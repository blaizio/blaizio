@* loading="lazy" defers each request until the image nears the viewport - scroll the list. *@
<div tabindex="0" role="region" aria-label="Lazy images"
     class="scrollbar-thin h-64 w-full max-w-md space-y-3 overflow-y-auto rounded-lg border p-3 outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50">
    @for (var i = 1; i <= 8; i++)
    {
        var seed = i;
        <BzImage Src="@($"https://picsum.photos/seed/bz-lazy-{seed}/640/360")"
                 Alt="@($"Lazy image {seed}")" Ratio="16.0 / 9"
                 Loading="ImageLoading.Lazy" MediaClass="rounded-md" />
    }
</div>
