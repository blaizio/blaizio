<div class="w-full max-w-md space-y-2">
    <BzImage Src="https://picsum.photos/seed/bz-status/800/450" Alt="A random landscape" Ratio="16.0 / 9"
             StatusChanged="s => _status = s" />
    <p class="text-sm text-muted-foreground">Status: <span class="font-medium text-foreground">@_status</span></p>
</div>

@code {
    private ImageStatus _status = ImageStatus.Loading;
}
