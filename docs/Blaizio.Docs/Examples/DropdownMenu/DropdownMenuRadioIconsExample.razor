<div class="flex flex-col items-center gap-4">
    <span class="text-muted-foreground text-sm">Method: @_payment</span>
    <BzDropdownMenu>
        <BzDropdownMenuTrigger>
            <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Payment method</BzButton></RenderAs>
        </BzDropdownMenuTrigger>
        <BzDropdownMenuContent Class="w-56">
            <BzDropdownMenuLabel>Select payment method</BzDropdownMenuLabel>
            <BzDropdownMenuRadioGroup @bind-Value="_payment">
                <BzDropdownMenuRadioItem Value="card">
                    <BzIcon Icon="@Icons.Outline.CreditCard" />
                    Credit Card
                </BzDropdownMenuRadioItem>
                <BzDropdownMenuRadioItem Value="paypal">
                    <BzIcon Icon="@Icons.Outline.Wallet" />
                    PayPal
                </BzDropdownMenuRadioItem>
                <BzDropdownMenuRadioItem Value="bank">
                    <BzIcon Icon="@Icons.Outline.BuildingBank" />
                    Bank Transfer
                </BzDropdownMenuRadioItem>
            </BzDropdownMenuRadioGroup>
        </BzDropdownMenuContent>
    </BzDropdownMenu>
</div>

@code {
    private string _payment = "card";
}
