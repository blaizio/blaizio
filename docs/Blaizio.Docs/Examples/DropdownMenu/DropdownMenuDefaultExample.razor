<BzDropdownMenu>
    <BzDropdownMenuTrigger>
        <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Open</BzButton></RenderAs>
    </BzDropdownMenuTrigger>
    <BzDropdownMenuContent Class="w-56">
        <BzDropdownMenuLabel>My Account</BzDropdownMenuLabel>
        <BzDropdownMenuGroup>
            <BzDropdownMenuItem>
                <BzIcon Icon="@Tabler.Outline.User" />
                Profile
                <BzDropdownMenuShortcut>⇧⌘P</BzDropdownMenuShortcut>
            </BzDropdownMenuItem>
            <BzDropdownMenuItem>
                <BzIcon Icon="@Tabler.Outline.CreditCard" />
                Billing
                <BzDropdownMenuShortcut>⌘B</BzDropdownMenuShortcut>
            </BzDropdownMenuItem>
            <BzDropdownMenuItem>
                <BzIcon Icon="@Tabler.Outline.Settings" />
                Settings
                <BzDropdownMenuShortcut>⌘S</BzDropdownMenuShortcut>
            </BzDropdownMenuItem>
            <BzDropdownMenuItem>
                <BzIcon Icon="@Tabler.Outline.Keyboard" />
                Keyboard shortcuts
                <BzDropdownMenuShortcut>⌘K</BzDropdownMenuShortcut>
            </BzDropdownMenuItem>
        </BzDropdownMenuGroup>
        <BzDropdownMenuSeparator />
        <BzDropdownMenuGroup>
            <BzDropdownMenuItem>
                <BzIcon Icon="@Tabler.Outline.Users" />
                Team
            </BzDropdownMenuItem>
            <BzDropdownMenuSub>
                <BzDropdownMenuSubTrigger>
                    <BzIcon Icon="@Tabler.Outline.UserPlus" />
                    Invite users
                </BzDropdownMenuSubTrigger>
                <BzDropdownMenuSubContent>
                    <BzDropdownMenuItem>
                        <BzIcon Icon="@Tabler.Outline.Mail" />
                        Email
                    </BzDropdownMenuItem>
                    <BzDropdownMenuItem>
                        <BzIcon Icon="@Tabler.Outline.MessageCircle" />
                        Message
                    </BzDropdownMenuItem>
                    <BzDropdownMenuSeparator />
                    <BzDropdownMenuItem>
                        <BzIcon Icon="@Tabler.Outline.Plus" />
                        More...
                    </BzDropdownMenuItem>
                </BzDropdownMenuSubContent>
            </BzDropdownMenuSub>
            <BzDropdownMenuItem>
                <BzIcon Icon="@Tabler.Outline.Plus" />
                New Team
                <BzDropdownMenuShortcut>⌘+T</BzDropdownMenuShortcut>
            </BzDropdownMenuItem>
        </BzDropdownMenuGroup>
        <BzDropdownMenuSeparator />
        <BzDropdownMenuItem>
            <BzIcon Icon="@Tabler.Outline.MessageCircle" />
            Support
        </BzDropdownMenuItem>
        <BzDropdownMenuItem Disabled>
            <BzIcon Icon="@Tabler.Outline.Cloud" />
            API
        </BzDropdownMenuItem>
        <BzDropdownMenuSeparator />
        <BzDropdownMenuItem Variant="DropdownMenuItemVariant.Destructive">
            <BzIcon Icon="@Tabler.Outline.Logout" />
            Log out
            <BzDropdownMenuShortcut>⇧⌘Q</BzDropdownMenuShortcut>
        </BzDropdownMenuItem>
    </BzDropdownMenuContent>
</BzDropdownMenu>
