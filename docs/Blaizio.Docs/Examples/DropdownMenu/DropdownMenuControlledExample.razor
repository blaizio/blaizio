<div class="flex flex-col items-center gap-4">
    <span class="text-muted-foreground text-sm">Open: @_open</span>
    <div class="flex items-center gap-4">
        <BzDropdownMenu @bind-Open="_open">
            <BzDropdownMenuTrigger>
                <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Menu</BzButton></RenderAs>
            </BzDropdownMenuTrigger>
            <BzDropdownMenuContent Class="w-56">
                <BzDropdownMenuLabel>Actions</BzDropdownMenuLabel>
                <BzDropdownMenuItem>Cut</BzDropdownMenuItem>
                <BzDropdownMenuItem>Copy</BzDropdownMenuItem>
                <BzDropdownMenuItem>Paste</BzDropdownMenuItem>
            </BzDropdownMenuContent>
        </BzDropdownMenu>
        <BzButton Variant="ButtonVariant.Secondary" Disabled="_open" @onclick="() => _open = true">Open menu</BzButton>
    </div>
</div>

@code {
    private bool _open;
}
