<BzDropdownMenu>
    <BzDropdownMenuTrigger>
        <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Set timezone</BzButton></RenderAs>
    </BzDropdownMenuTrigger>
    <BzDropdownMenuContent Class="w-56">
        <BzDropdownMenuLabel>Timezone</BzDropdownMenuLabel>
        @foreach (var zone in _zones)
        {
            <BzDropdownMenuItem>@zone</BzDropdownMenuItem>
        }
    </BzDropdownMenuContent>
</BzDropdownMenu>

@code {
    // A deliberately long list so the menu outgrows the viewport and scrolls.
    private static readonly string[] _zones =
    [
        "Honolulu", "Anchorage", "Los Angeles", "Denver", "Chicago", "New York", "Toronto",
        "São Paulo", "London", "Lisbon", "Madrid", "Paris", "Berlin", "Rome", "Athens", "Cairo",
        "Istanbul", "Nairobi", "Moscow", "Dubai", "Karachi", "Mumbai", "Dhaka", "Bangkok",
        "Singapore", "Hong Kong", "Shanghai", "Tokyo", "Seoul", "Sydney", "Auckland",
    ];
}
