<BzDropdownMenu>
    <BzDropdownMenuTrigger>
        <RenderAs Context="p">
            <button @attributes="p.Attributes" class="rounded-full outline-none focus-visible:ring-ring/50 focus-visible:ring-3">
                <BzAvatar>
                    <BzAvatarImage Src="https://i.pravatar.cc/120?img=12" Alt="User" />
                    <BzAvatarFallback>CN</BzAvatarFallback>
                </BzAvatar>
            </button>
        </RenderAs>
    </BzDropdownMenuTrigger>
    <BzDropdownMenuContent Class="w-56">
        <BzDropdownMenuLabel>
            <div class="flex flex-col">
                <span class="text-foreground text-sm font-medium">Jane Doe</span>
                <span class="text-muted-foreground text-xs font-normal">Pro plan</span>
            </div>
        </BzDropdownMenuLabel>
        <BzDropdownMenuGroup>
            <BzDropdownMenuItem>
                <BzIcon Icon="@Icons.Outline.User" />
                Profile
            </BzDropdownMenuItem>
            <BzDropdownMenuItem>
                <BzIcon Icon="@Icons.Outline.CreditCard" />
                Billing
            </BzDropdownMenuItem>
            <BzDropdownMenuItem>
                <BzIcon Icon="@Icons.Outline.Settings" />
                Settings
            </BzDropdownMenuItem>
        </BzDropdownMenuGroup>
        <BzDropdownMenuSeparator />
        <BzDropdownMenuItem Variant="DropdownMenuItemVariant.Destructive">
            <BzIcon Icon="@Icons.Outline.Logout" />
            Log out
        </BzDropdownMenuItem>
    </BzDropdownMenuContent>
</BzDropdownMenu>
