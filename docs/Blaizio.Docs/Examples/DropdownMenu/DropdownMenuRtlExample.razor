<BzDirectionProvider Direction="Direction.Rtl">
    <BzDropdownMenu>
        <BzDropdownMenuTrigger>
            <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">القائمة</BzButton></RenderAs>
        </BzDropdownMenuTrigger>
        <BzDropdownMenuContent Class="w-56">
            <BzDropdownMenuLabel>حسابي</BzDropdownMenuLabel>
            <BzDropdownMenuItem>
                <BzIcon Icon="@Icons.Outline.User" />
                الملف الشخصي
                <BzDropdownMenuShortcut>⇧⌘P</BzDropdownMenuShortcut>
            </BzDropdownMenuItem>
            <BzDropdownMenuItem>
                <BzIcon Icon="@Icons.Outline.Settings" />
                الإعدادات
            </BzDropdownMenuItem>
            <BzDropdownMenuSub>
                <BzDropdownMenuSubTrigger>
                    <BzIcon Icon="@Icons.Outline.UserPlus" />
                    دعوة المستخدمين
                </BzDropdownMenuSubTrigger>
                <BzDropdownMenuSubContent>
                    <BzDropdownMenuItem>
                        <BzIcon Icon="@Icons.Outline.Mail" />
                        بريد إلكتروني
                    </BzDropdownMenuItem>
                    <BzDropdownMenuItem>
                        <BzIcon Icon="@Icons.Outline.MessageCircle" />
                        رسالة
                    </BzDropdownMenuItem>
                </BzDropdownMenuSubContent>
            </BzDropdownMenuSub>
            <BzDropdownMenuSeparator />
            <BzDropdownMenuItem Variant="DropdownMenuItemVariant.Destructive">
                <BzIcon Icon="@Icons.Outline.Logout" />
                تسجيل الخروج
            </BzDropdownMenuItem>
        </BzDropdownMenuContent>
    </BzDropdownMenu>
</BzDirectionProvider>
