<RtlDemo Context="t">
    <BzDirectionProvider Dir="Direction.Rtl">
        <BzDropdownMenu>
            <BzDropdownMenuTrigger>
                <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">@t["القائمة", "תפריט"]</BzButton></RenderAs>
            </BzDropdownMenuTrigger>
            <BzDropdownMenuContent Class="w-56">
                <BzDropdownMenuLabel>@t["حسابي", "החשבון שלי"]</BzDropdownMenuLabel>
                <BzDropdownMenuItem>
                    <BzIcon Icon="@Tabler.Outline.User" />
                    @t["الملف الشخصي", "פרופיל"]
                    <BzDropdownMenuShortcut>⇧⌘P</BzDropdownMenuShortcut>
                </BzDropdownMenuItem>
                <BzDropdownMenuItem>
                    <BzIcon Icon="@Tabler.Outline.Settings" />
                    @t["الإعدادات", "הגדרות"]
                </BzDropdownMenuItem>
                <BzDropdownMenuSub>
                    <BzDropdownMenuSubTrigger>
                        <BzIcon Icon="@Tabler.Outline.UserPlus" />
                        @t["دعوة المستخدمين", "הזמנת משתמשים"]
                    </BzDropdownMenuSubTrigger>
                    <BzDropdownMenuSubContent>
                        <BzDropdownMenuItem>
                            <BzIcon Icon="@Tabler.Outline.Mail" />
                            @t["بريد إلكتروني", "אימייל"]
                        </BzDropdownMenuItem>
                        <BzDropdownMenuItem>
                            <BzIcon Icon="@Tabler.Outline.MessageCircle" />
                            @t["رسالة", "הודעה"]
                        </BzDropdownMenuItem>
                    </BzDropdownMenuSubContent>
                </BzDropdownMenuSub>
                <BzDropdownMenuSeparator />
                <BzDropdownMenuItem Variant="DropdownMenuItemVariant.Destructive">
                    <BzIcon Icon="@Tabler.Outline.Logout" />
                    @t["تسجيل الخروج", "התנתקות"]
                </BzDropdownMenuItem>
            </BzDropdownMenuContent>
        </BzDropdownMenu>
    </BzDirectionProvider>
</RtlDemo>
