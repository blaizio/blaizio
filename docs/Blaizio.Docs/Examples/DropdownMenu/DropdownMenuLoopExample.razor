@* Arrow keys wrap within the menu by default; Loop="false" stops at the ends. *@
<BzDropdownMenu>
    <BzDropdownMenuTrigger>
        <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Open</BzButton></RenderAs>
    </BzDropdownMenuTrigger>
    <BzDropdownMenuContent Class="w-44" Loop="false">
        <BzDropdownMenuItem>Cut</BzDropdownMenuItem>
        <BzDropdownMenuItem>Copy</BzDropdownMenuItem>
        <BzDropdownMenuItem>Paste</BzDropdownMenuItem>
        <BzDropdownMenuItem>Delete</BzDropdownMenuItem>
    </BzDropdownMenuContent>
</BzDropdownMenu>
