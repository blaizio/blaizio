<BzDropdownMenu>
    <BzDropdownMenuTrigger>
        <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Share</BzButton></RenderAs>
    </BzDropdownMenuTrigger>
    <BzDropdownMenuContent Class="w-52">
        <BzDropdownMenuItem>
            <BzIcon Icon="@Tabler.Outline.Link" />
            Copy link
        </BzDropdownMenuItem>
        <BzDropdownMenuSub>
            <BzDropdownMenuSubTrigger>
                <BzIcon Icon="@Tabler.Outline.UserPlus" />
                Invite people
            </BzDropdownMenuSubTrigger>
            <BzDropdownMenuSubContent>
                <BzDropdownMenuItem>
                    <BzIcon Icon="@Tabler.Outline.Mail" />
                    Email
                </BzDropdownMenuItem>
                <BzDropdownMenuSub>
                    <BzDropdownMenuSubTrigger>
                        <BzIcon Icon="@Tabler.Outline.MessageCircle" />
                        Send to device
                    </BzDropdownMenuSubTrigger>
                    <BzDropdownMenuSubContent>
                        <BzDropdownMenuItem>Phone</BzDropdownMenuItem>
                        <BzDropdownMenuItem>Tablet</BzDropdownMenuItem>
                        <BzDropdownMenuItem>Laptop</BzDropdownMenuItem>
                    </BzDropdownMenuSubContent>
                </BzDropdownMenuSub>
            </BzDropdownMenuSubContent>
        </BzDropdownMenuSub>
    </BzDropdownMenuContent>
</BzDropdownMenu>
