<BzDropdownMenu>
    <BzDropdownMenuTrigger>
        <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">View options</BzButton></RenderAs>
    </BzDropdownMenuTrigger>
    <BzDropdownMenuContent Class="w-56">
        <BzDropdownMenuLabel>Editor</BzDropdownMenuLabel>
        <BzDropdownMenuCheckboxItem @bind-Checked="_wordCount" OnSelect="KeepOpen">Word count</BzDropdownMenuCheckboxItem>
        <BzDropdownMenuCheckboxItem @bind-Checked="_lineNumbers" OnSelect="KeepOpen" Disabled>Line numbers</BzDropdownMenuCheckboxItem>
        <BzDropdownMenuCheckboxItem @bind-Checked="_spellCheck" OnSelect="KeepOpen">Spell check</BzDropdownMenuCheckboxItem>
    </BzDropdownMenuContent>
</BzDropdownMenu>

@code {
    private bool _wordCount = true;
    private bool _lineNumbers;
    private bool _spellCheck;

    // Selecting a checkbox item closes the menu by default; PreventDefault keeps it open so several
    // can be toggled in one visit.
    private static void KeepOpen(MenuSelectEventArgs e) => e.PreventDefault();
}
