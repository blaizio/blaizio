@* The scroll surface ships `scrollbar-thin`. Swap it by passing another scrollbar utility -
   `scrollbar-hover` (fades in while scrolling), `scrollbar-activity` or `scrollbar-none` -
   and the class merge drops the default for you. *@
<BzDropdownMenu>
    <BzDropdownMenuTrigger>
        <RenderAs Context="p"><BzButton Class="bg-indigo-600 text-white hover:bg-indigo-700" @attributes="p.Attributes">Options</BzButton></RenderAs>
    </BzDropdownMenuTrigger>
    <BzDropdownMenuContent Class="scrollbar-hover w-56 rounded-xl border-indigo-200 bg-indigo-50/60 dark:border-indigo-900 dark:bg-indigo-950/50">
        <BzDropdownMenuLabel>Workspace</BzDropdownMenuLabel>
        <BzDropdownMenuItem>
            <BzIcon Icon="@Icons.Outline.User" />
            Profile
        </BzDropdownMenuItem>
        <BzDropdownMenuItem>
            <BzIcon Icon="@Icons.Outline.Settings" />
            Settings
        </BzDropdownMenuItem>
        <BzDropdownMenuItem>
            <BzIcon Icon="@Icons.Outline.CreditCard" />
            Billing
        </BzDropdownMenuItem>
    </BzDropdownMenuContent>
</BzDropdownMenu>
