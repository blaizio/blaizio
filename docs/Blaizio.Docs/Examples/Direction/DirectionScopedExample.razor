<BzDirectionProvider Dir="Direction.Rtl">
    <div class="w-full max-w-md space-y-4">
        <BzAlert>
            <BzIcon Icon="@Icons.Outline.InfoCircle" />
            <BzAlertTitle>تنبيه</BzAlertTitle>
            <BzAlertDescription>تظهر الأيقونة والنص والمسافات على الجانب الأيمن.</BzAlertDescription>
        </BzAlert>
        <BzTabs DefaultValue="account" Class="w-full">
            <BzTabsList AriaLabel="إعدادات الحساب">
                <BzTabsTrigger Value="account">الحساب</BzTabsTrigger>
                <BzTabsTrigger Value="password">كلمة المرور</BzTabsTrigger>
                <BzTabsTrigger Value="team">الفريق</BzTabsTrigger>
            </BzTabsList>
        </BzTabs>
        <BzButton>متابعة <BzIcon Icon="@Icons.Outline.ArrowRight" data-icon="inline-end" /></BzButton>
    </div>
</BzDirectionProvider>
