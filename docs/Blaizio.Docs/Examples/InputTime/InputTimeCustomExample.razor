<div class="flex flex-wrap items-center gap-3">
    <BzInputTime @bind-Value="_time" Class="w-44 rounded-full px-4" />
    <BzInputTime @bind-Value="_timeAccent" Class="border-indigo-500/60 focus-within:border-indigo-500 focus-within:ring-indigo-500/40">
        <Icon><BzIcon Icon="@Tabler.Outline.Clock" Class="size-4 text-indigo-500" /></Icon>
    </BzInputTime>
</div>

@code {
    private TimeOnly? _time = new(9, 30);
    private TimeOnly? _timeAccent = new(18, 15);
}
