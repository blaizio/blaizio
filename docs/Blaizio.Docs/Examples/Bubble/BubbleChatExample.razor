@* A WhatsApp-style thread: Connected runs with squared inner corners, a tail on each sender's
   last bubble, a date chip, and delivery state (time + ticks) tucked into the bubble's corner. *@
<div class="w-full max-w-sm rounded-xl border bg-background p-4">
    <div class="flex flex-col gap-4">
        <div class="bg-muted text-muted-foreground mx-auto w-fit rounded-full px-2.5 py-0.5 text-xs">Today</div>

        <BzBubbleGroup Connected="true">
            <BzBubble Variant="BubbleVariant.Secondary">
                <BzBubbleContent>Salam! Are we still on for lunch?</BzBubbleContent>
            </BzBubble>
            <BzBubble Variant="BubbleVariant.Secondary" Tail="true">
                <BzBubbleContent>
                    I found a new Emirati place near the marina.
                    <span class="text-muted-foreground ms-2 inline-block translate-y-0.5 text-[10px] leading-none">12:04</span>
                </BzBubbleContent>
            </BzBubble>
            <BzBubble Align="BubbleAlign.End">
                <BzBubbleContent>
                    Absolutely, I'm starving.
                    <span class="ms-2 inline-flex translate-y-0.5 items-center gap-0.5 text-[10px] leading-none opacity-70">
                        12:05
                        <BzIcon Icon="@Icons.Outline.Checks" Class="size-3.5" aria-label="Read" />
                    </span>
                </BzBubbleContent>
            </BzBubble>
            <BzBubble Align="BubbleAlign.End" Tail="true">
                <BzBubbleContent>
                    Send me the location pin?
                    <span class="ms-2 inline-flex translate-y-0.5 items-center gap-0.5 text-[10px] leading-none opacity-70">
                        12:05
                        <BzIcon Icon="@Icons.Outline.Check" Class="size-3.5" aria-label="Sent" />
                    </span>
                </BzBubbleContent>
            </BzBubble>
        </BzBubbleGroup>
    </div>
</div>
