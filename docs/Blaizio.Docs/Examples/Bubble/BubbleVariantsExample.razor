<div class="flex w-full max-w-md flex-col gap-3">
    <BzBubble>
        <BzBubbleContent>Default: a strong primary bubble for the current user.</BzBubbleContent>
    </BzBubble>
    <BzBubble Variant="BubbleVariant.Secondary">
        <BzBubbleContent>Secondary: the standard neutral bubble for incoming messages.</BzBubbleContent>
    </BzBubble>
    <BzBubble Variant="BubbleVariant.Muted">
        <BzBubbleContent>Muted: lower emphasis for quiet content.</BzBubbleContent>
    </BzBubble>
    <BzBubble Variant="BubbleVariant.Tinted">
        <BzBubbleContent>Tinted: a subtle primary-tinted bubble.</BzBubbleContent>
    </BzBubble>
    <BzBubble Variant="BubbleVariant.Outline">
        <BzBubbleContent>Outline: a bordered bubble on the page background.</BzBubbleContent>
