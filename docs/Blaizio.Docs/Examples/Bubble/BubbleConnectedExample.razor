@* Connected squares the corners between same-side neighbours - each sender's run reads as one
   block, WhatsApp/Telegram style. The tail finishes the last bubble of a run. *@
<BzBubbleGroup Connected="true" Class="w-full max-w-md">
    <BzBubble Variant="BubbleVariant.Secondary">
        <BzBubbleContent>Three quick things.</BzBubbleContent>
    </BzBubble>
    <BzBubble Variant="BubbleVariant.Secondary">
        <BzBubbleContent>The registry build is fixed.</BzBubbleContent>
    </BzBubble>
    <BzBubble Variant="BubbleVariant.Secondary" Tail="true">
        <BzBubbleContent>And the docs preview is back up.</BzBubbleContent>
    </BzBubble>
    <BzBubble Align="BubbleAlign.End">
        <BzBubbleContent>You are on fire today.</BzBubbleContent>
    </BzBubble>
    <BzBubble Align="BubbleAlign.End" Tail="true">
        <BzBubbleContent>Coffee is working.</BzBubbleContent>
    </BzBubble>
</BzBubbleGroup>
