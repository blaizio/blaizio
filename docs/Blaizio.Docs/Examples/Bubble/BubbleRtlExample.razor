<RtlDemo Context="t">
    <BzDirectionProvider Direction="Direction.Rtl">
        <BzBubbleGroup Class="w-full max-w-md">
            <BzBubble Variant="BubbleVariant.Secondary" Tail="BubbleTail.Bottom">
                <BzBubbleContent>@t["أهلًا! هل انتهيت من التصميم الجديد؟", "היי! סיימת את העיצוב החדש?"]</BzBubbleContent>
            </BzBubble>
            <BzBubble Align="BubbleAlign.End" Tail="BubbleTail.Bottom">
                <BzBubbleContent>@t["نعم، أرسلته للتو. أخبرني برأيك!", "כן, שלחתי אותו הרגע. ספר לי מה דעתך!"]</BzBubbleContent>
                <BzBubbleReactions role="img" aria-label="@t["تفاعل واحد: إعجاب", "תגובה אחת: לייק"]">
                    <span>👍</span>
                </BzBubbleReactions>
            </BzBubble>
        </BzBubbleGroup>
    </BzDirectionProvider>
</RtlDemo>
