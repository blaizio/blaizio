@* A quoted reply: the original message rides inside the bubble as a bordered strip. *@
<div class="flex w-full max-w-md flex-col gap-3">
    <BzBubble Variant="BubbleVariant.Secondary" Tail="BubbleTail.Bottom">
        <BzBubbleContent>Can you send the final logo pack?</BzBubbleContent>
    </BzBubble>
    <BzBubble Align="BubbleAlign.End" Tail="BubbleTail.Bottom">
        <BzBubbleContent>
            <div class="border-primary-foreground/40 mb-1.5 border-s-2 ps-2">
                <div class="text-xs font-semibold">Rami</div>
                <div class="line-clamp-1 text-xs">Can you send the final logo pack?</div>
            </div>
            Sure, uploading it now.
        </BzBubbleContent>
    </BzBubble>
</div>
