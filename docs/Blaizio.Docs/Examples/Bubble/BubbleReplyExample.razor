@* A Telegram-style reply: the quoted message rides inside the bubble as a bordered strip. *@
<div class="flex w-full max-w-md flex-col gap-3">
    <BzBubble Variant="BubbleVariant.Secondary" Tail="BubbleTail.Bottom">
        <BzBubbleContent>Can you send the final logo pack?</BzBubbleContent>
    </BzBubble>
    <BzBubble Align="BubbleAlign.End" Tail="BubbleTail.Bottom">
        <BzBubbleContent>
            <div class="border-primary-foreground/40 bg-primary-foreground/10 mb-1.5 rounded-md border-s-2 px-2 py-1">
                <div class="text-xs font-semibold">Rania</div>
                <div class="line-clamp-1 text-xs opacity-80">Can you send the final logo pack?</div>
            </div>
            Sure, uploading it now.
        </BzBubbleContent>
    </BzBubble>
</div>
