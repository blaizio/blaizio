<div class="flex w-full max-w-md flex-col gap-4">
    <BzBubble Variant="BubbleVariant.Secondary" Tail="BubbleTail.Top">
        <BzBubbleContent>Tail Top points at the avatar, on the FIRST bubble of a run.</BzBubbleContent>
    </BzBubble>
    <BzBubble Variant="BubbleVariant.Secondary" Tail="BubbleTail.Bottom">
        <BzBubbleContent>Tail Bottom finishes the LAST bubble of a run.</BzBubbleContent>
    </BzBubble>
    <BzBubble Align="BubbleAlign.End" Tail="BubbleTail.Top" TailShape="BubbleTailShape.Curved">
        <BzBubbleContent>TailShape Curved swaps the triangle for a rounded wedge. Both mirror to the end side.</BzBubbleContent>
    </BzBubble>
    <BzBubble Align="BubbleAlign.End" Variant="BubbleVariant.Tinted" Tail="BubbleTail.Bottom" TailShape="BubbleTailShape.Curved">
        <BzBubbleContent>And the tail always matches the variant's fill.</BzBubbleContent>
    </BzBubble>
</div>
