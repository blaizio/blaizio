@* Keep BOTH stops dark - a light stop (pastels, yellows, cyans) washes out half the symbol
   and scanners lose it. *@
<div class="flex flex-wrap items-start gap-4">
    <BzQrCode Value="https://blaiz.io"
              Foreground="#7c3aed" ForegroundEnd="#db2777"
              Label="QR code linking to blaiz.io" />

    <BzQrCode Value="https://blaiz.io"
              Foreground="#0f766e" ForegroundEnd="#1d4ed8" GradientAngle="90"
              ModuleStyle="QrCodeModuleStyle.Rounded" EyeStyle="QrCodeEyeStyle.Rounded"
              Label="QR code linking to blaiz.io" />

    <BzQrCode Value="https://blaiz.io"
              Foreground="var(--primary)" ForegroundEnd="var(--chart-2)" GradientAngle="135"
              ModuleStyle="QrCodeModuleStyle.Dots" EyeStyle="QrCodeEyeStyle.Circle"
              Label="QR code linking to blaiz.io" />
</div>
