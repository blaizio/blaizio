<BzAccordion Collapsible Class="w-full max-w-md">
    <BzAccordionItem Value="open">
        <BzAccordionTrigger>Available</BzAccordionTrigger>
        <BzAccordionContent>This one works.</BzAccordionContent>
    </BzAccordionItem>
    <BzAccordionItem Value="locked" Disabled>
        <BzAccordionTrigger>Locked</BzAccordionTrigger>
        <BzAccordionContent>Unreachable.</BzAccordionContent>
    </BzAccordionItem>
</BzAccordion>
