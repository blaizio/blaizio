        <BzAccordionItem Value="shipping">
            <BzAccordionTrigger>How long does shipping take?</BzAccordionTrigger>
            <BzAccordionContent>Three to five business days for domestic orders.</BzAccordionContent>
        </BzAccordionItem>
        <BzAccordionItem Value="returns">
            <BzAccordionTrigger>What is the return policy?</BzAccordionTrigger>
            <BzAccordionContent>Thirty days, no questions asked.</BzAccordionContent>
        </BzAccordionItem>
        <BzAccordionItem Value="warranty">
            <BzAccordionTrigger>Is there a warranty?</BzAccordionTrigger>
            <BzAccordionContent>Two years on every product.</BzAccordionContent>
        </BzAccordionItem>
    </BzAccordion>
</section>
