<RtlDemo Context="t">
    <BzDirectionProvider Dir="Direction.Rtl">
        <BzAccordion DefaultValue="item-1" Collapsible Class="w-full max-w-md">
            <BzAccordionItem Value="item-1">
                <BzAccordionTrigger>@t["هل يدعم إمكانية الوصول؟", "האם הוא תומך בנגישות?"]</BzAccordionTrigger>
                <BzAccordionContent>@t["نعم. يتبع نمط الأكورديون في WAI-ARIA: زر داخل عنوان موصول بمنطقته.", "כן. הוא עוקב אחר דפוס האקורדיון של WAI-ARIA: כפתור בתוך כותרת המחובר לאזור שלו."]</BzAccordionContent>
            </BzAccordionItem>
            <BzAccordionItem Value="item-2">
                <BzAccordionTrigger>@t["هل هو منسّق؟", "האם הוא מעוצב?"]</BzAccordionTrigger>
                <BzAccordionContent>@t["نعم. تكسوه جميع أنماط Blaizio الثمانية - بدّل النمط بالأعلى للمقارنة.", "כן. כל שמונת הסגנונות של Blaizio מעצבים אותו - החליפו את הסגנון למעלה להשוואה."]</BzAccordionContent>
            </BzAccordionItem>
            <BzAccordionItem Value="item-3">
                <BzAccordionTrigger>@t["هل هو متحرّك؟", "האם הוא מונפש?"]</BzAccordionTrigger>
                <BzAccordionContent>@t["نعم. يتحرّك الفتح والإغلاق إلى الارتفاع المقاس للمحتوى.", "כן. הפתיחה והסגירה מונפשות אל הגובה הנמדד של התוכן."]</BzAccordionContent>
            </BzAccordionItem>
        </BzAccordion>
    </BzDirectionProvider>
</RtlDemo>
