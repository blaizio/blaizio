<RtlDemo Context="t">
    <BzDirectionProvider Direction="Direction.Rtl">
        <div class="grid w-full grid-cols-[1fr_12rem] gap-8">
            <div id="toc-scroll-rtl" class="scrollbar-thin h-72 overflow-y-auto rounded-md border p-4">
                <article id="toc-article-rtl" class="space-y-6">
                    <section class="space-y-2">
                        <h2 class="text-lg font-semibold">@t["مقدمة", "מבוא"]</h2>
                        <p class="text-sm text-muted-foreground">@Lorem</p>
                        <p class="text-sm text-muted-foreground">@Lorem</p>
                    </section>
                    <section class="space-y-2">
                        <h2 class="text-lg font-semibold">@t["التثبيت", "התקנה"]</h2>
                        <p class="text-sm text-muted-foreground">@Lorem</p>
                        <h3 class="text-base font-medium">@t["المتطلّبات المسبقة", "דרישות מקדימות"]</h3>
                        <p class="text-sm text-muted-foreground">@Lorem</p>
                        <h3 class="text-base font-medium">@t["من المصدر", "מהמקור"]</h3>
                        <p class="text-sm text-muted-foreground">@Lorem</p>
                    </section>
                    <section class="space-y-2">
                        <h2 class="text-lg font-semibold">@t["الاستخدام", "שימוש"]</h2>
                        <p class="text-sm text-muted-foreground">@Lorem</p>
                        <p class="text-sm text-muted-foreground">@Lorem</p>
                    </section>
                    <section class="space-y-2">
                        <h2 class="text-lg font-semibold">@t["الأسئلة الشائعة", "שאלות נפוצות"]</h2>
                        <p class="text-sm text-muted-foreground">@Lorem</p>
                        <p class="text-sm text-muted-foreground">@Lorem</p>
                    </section>
                </article>
            </div>
            <BzTableOfContents Title="@t["في هذه الصفحة", "בעמוד זה"]" ContentSelector="#toc-article-rtl" RootSelector="#toc-scroll-rtl" TopOffset="8" Class="sticky top-20 self-start" />
        </div>
    </BzDirectionProvider>
</RtlDemo>

@code {
    private const string Lorem =
        "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt " +
        "ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation.";
}
