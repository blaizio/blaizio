@* A tick takes its length from its heading's level, so a page whose sections are all one level
   draws a column of equal lines on an even gap - the cleanest surface for the wave to swell
   against, and what a step list or a timeline looks like anyway. PeekContent then carries
   everything the ticks cannot: the step's name, what it does, and a line of metadata. *@
<div class="relative w-full">
    <div id="toc-scroll-wave" tabindex="0" class="scrollbar-thin scroll-fade-y h-80 overflow-y-auto rounded-md border p-4 ps-16 outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50">
        <article id="toc-article-wave" class="space-y-6">
            @foreach (var step in Steps)
            {
                <section class="space-y-2">
                    <h2 class="text-lg font-semibold">@step.Title</h2>
                    <p class="text-sm text-muted-foreground">@step.Body</p>
                </section>
            }
        </article>
    </div>

    @* MarkWidth pulls the resting lines under Wave's stock scale (1rem) for a quieter column;
       WaveAmplitude makes the swell half a rem more dramatic than the default (1rem). *@
    <BzTableOfContents Variant="TocVariant.Peek"
                       Wave
                       MarkWidth="0.75"
                       WaveAmplitude="1.5"
                       Position="TocPosition.StartCenter"
                       ContentSelector="#toc-article-wave"
                       RootSelector="#toc-scroll-wave"
                       TopOffset="8"
                       UpdateHash="false"
                       Class="absolute start-3 inset-y-3">
        <PeekContent Context="heading">
            @{
                var step = Find(heading.Text);
            }
            <span class="block font-medium">@heading.Text</span>
            <span class="mt-0.5 block text-muted-foreground">@step.Summary</span>
            <span class="mt-1.5 flex items-center gap-1.5 text-muted-foreground">
                <BzIcon Icon="@step.Icon" Class="size-3.5 shrink-0" />
                @step.Meta
            </span>
        </PeekContent>
    </BzTableOfContents>
</div>

@code {
    // Whatever your page already knows about a section travels into the card: a summary, a
    // duration, an owner, a status. The ticks stay uniform; the card carries the difference.
    private sealed record Step(string Title, string Summary, string Meta, Icon Icon, string Body);

    private static readonly Step[] Steps =
    [
        new("Provision", "Claim the runner and mount the build cache", "~40s", Tabler.Outline.Clock,
            "The job leases a clean runner, restores the layer cache and pins the toolchain versions the rest of the pipeline assumes."),
        new("Restore", "Resolve every package from the locked graph", "~1m", Tabler.Outline.Clock,
            "Dependencies come from the lockfile only. A resolution that drifts from it fails here rather than surfacing as a mismatch three steps later."),
        new("Build", "Compile with warnings promoted to errors", "~2m", Tabler.Outline.Clock,
            "Release configuration, deterministic output, no incremental state carried over from a previous run."),
        new("Unit tests", "Run the fast suite across both runtimes", "1,284 tests", Tabler.Outline.CircleCheck,
            "The suite that needs nothing but the assembly under test. Anything requiring a socket or a disk belongs to the integration stage."),
        new("Integration", "Exercise the real database and queue", "38 tests", Tabler.Outline.CircleCheck,
            "Containers come up per run and are torn down with the job, so a leaked row can never influence the next build."),
        new("Package", "Produce the artifacts a release consumes", "6 artifacts", Tabler.Outline.CircleDot,
            "One artifact per target, each stamped with the commit it came from so a deployed binary can always be traced back."),
        new("Sign", "Stamp the artifacts with the release identity", "~15s", Tabler.Outline.Clock,
            "Signing happens once, here, on outputs nothing downstream is allowed to rewrite."),
        new("Stage", "Publish to the staging environment", "~50s", Tabler.Outline.GitCommit,
            "The staging slot takes the signed artifacts verbatim. No rebuild, no configuration edit that production will not also see."),
        new("Smoke", "Prove the deployment answers", "12 checks", Tabler.Outline.CircleCheck,
            "A handful of requests against the paths that break loudest: health, auth, the primary read, the primary write."),
        new("Canary", "Send a slice of live traffic", "5% for 10m", Tabler.Outline.CircleDot,
            "Error rate and latency are compared against the previous release over the window. A regression rolls back without waiting for a human."),
        new("Promote", "Shift the remaining traffic across", "~2m", Tabler.Outline.GitCommit,
            "Traffic moves in steps rather than at once, so the previous release stays warm and reachable until the last slice lands."),
        new("Verify", "Confirm the release is the one intended", "3 checks", Tabler.Outline.CircleCheck,
            "The deployed commit, the artifact digest and the migration state are read back from production and compared with what the pipeline built."),
        new("Announce", "Publish the notes and notify the channels", "~10s", Tabler.Outline.GitCommit,
            "Release notes are assembled from the commits in the range and posted alongside the version tag."),
        new("Archive", "Retain the artifacts and the logs", "90 days", Tabler.Outline.CircleDot,
            "Everything needed to reproduce or roll back the release is kept for the retention window, then dropped on schedule."),
    ];

    private static Step Find(string title) =>
        Steps.FirstOrDefault(s => s.Title == title) ?? Steps[0];
}
