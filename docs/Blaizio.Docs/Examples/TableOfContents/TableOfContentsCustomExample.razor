<div class="grid w-full grid-cols-[1fr_auto] gap-8">
    <div id="toc-scroll-custom" tabindex="0" class="scrollbar-thin h-72 overflow-y-auto rounded-md border p-4 outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50">
        <article id="toc-article-custom" class="space-y-6">
            <section class="space-y-2">
                <h2 class="text-lg font-semibold">Overview</h2>
                <p class="text-sm text-muted-foreground">@Lorem</p>
                <p class="text-sm text-muted-foreground">@Lorem</p>
            </section>
            <section class="space-y-2">
                <h2 class="text-lg font-semibold">Installation</h2>
                <p class="text-sm text-muted-foreground">@Lorem</p>
                <h3 class="text-base font-medium">Requirements</h3>
                <p class="text-sm text-muted-foreground">@Lorem</p>
            </section>
            <section class="space-y-2">
                <h2 class="text-lg font-semibold">Usage</h2>
                <p class="text-sm text-muted-foreground">@Lorem</p>
                <p class="text-sm text-muted-foreground">@Lorem</p>
            </section>
            <section class="space-y-2">
                <h2 class="text-lg font-semibold">FAQ</h2>
                <p class="text-sm text-muted-foreground">@Lorem</p>
                <p class="text-sm text-muted-foreground">@Lorem</p>
            </section>
        </article>
    </div>

    @* The panel draws no surface of its own, floating or not; these five classes are the card, and
       they work the same on a Position panel that sits over the page. *@
    <BzTableOfContents ContentSelector="#toc-article-custom"
                       RootSelector="#toc-scroll-custom"
                       TopOffset="8"
                       UpdateHash="false"
                       Sticky
                       Class="bg-popover text-popover-foreground w-56 rounded-lg border p-3 shadow-md"
                       LinkClass="ps-3 border-s-2 border-transparent rounded-e-md transition-colors hover:bg-muted/40 data-active:border-primary data-active:bg-primary/5 data-active:text-foreground">
        <TitleContent>
            <p class="mb-2 flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                <BzIcon Icon="@Icons.Outline.List" Class="size-3.5" />
                On this page
            </p>
        </TitleContent>
    </BzTableOfContents>
</div>

@code {
    private const string Lorem =
        "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt " +
        "ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation.";
}
