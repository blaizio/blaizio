<BzToggleGroup DefaultValue="grid" Variant="ToggleVariant.Outline">
    <BzToggleGroupItem Value="grid" aria-label="Grid view">
        <RenderAs Context="p"><a href="#grid" @onclick:preventDefault @attributes="p.Attributes">Grid</a></RenderAs>
    </BzToggleGroupItem>
    <BzToggleGroupItem Value="list" aria-label="List view">
        <RenderAs Context="p"><a href="#list" @onclick:preventDefault @attributes="p.Attributes">List</a></RenderAs>
    </BzToggleGroupItem>
</BzToggleGroup>
