<div class="flex flex-col items-center gap-4">
    <BzToggleGroup SelectionMode="SelectionMode.Multiple" Variant="ToggleVariant.Outline" Size="ToggleSize.Sm">
        <BzToggleGroupItem Value="bold" aria-label="Toggle bold"><BzIcon Icon="@Icons.Outline.Bold" /></BzToggleGroupItem>
        <BzToggleGroupItem Value="italic" aria-label="Toggle italic"><BzIcon Icon="@Icons.Outline.Italic" /></BzToggleGroupItem>
    </BzToggleGroup>
    <BzToggleGroup SelectionMode="SelectionMode.Multiple" Variant="ToggleVariant.Outline" Size="ToggleSize.Lg">
        <BzToggleGroupItem Value="bold" aria-label="Toggle bold"><BzIcon Icon="@Icons.Outline.Bold" /></BzToggleGroupItem>
        <BzToggleGroupItem Value="italic" aria-label="Toggle italic"><BzIcon Icon="@Icons.Outline.Italic" /></BzToggleGroupItem>
    </BzToggleGroup>
</div>
