<div class="flex flex-col items-start gap-8 sm:flex-row sm:items-center sm:gap-16">
    <div class="space-y-2">
        <p class="text-sm font-medium">Loops (default)</p>
        <BzToggleGroup SelectionMode="SelectionMode.Multiple" Variant="ToggleVariant.Outline">
            <BzToggleGroupItem Value="bold" aria-label="Toggle bold"><BzIcon Icon="@Tabler.Outline.Bold" /></BzToggleGroupItem>
            <BzToggleGroupItem Value="italic" aria-label="Toggle italic"><BzIcon Icon="@Tabler.Outline.Italic" /></BzToggleGroupItem>
            <BzToggleGroupItem Value="strike" aria-label="Toggle strikethrough"><BzIcon Icon="@Tabler.Outline.Strikethrough" /></BzToggleGroupItem>
        </BzToggleGroup>
    </div>
    <div class="space-y-2">
        <p class="text-sm font-medium">Stops (Loop = false)</p>
        <BzToggleGroup SelectionMode="SelectionMode.Multiple" Variant="ToggleVariant.Outline" Loop="false">
            <BzToggleGroupItem Value="bold" aria-label="Toggle bold"><BzIcon Icon="@Tabler.Outline.Bold" /></BzToggleGroupItem>
            <BzToggleGroupItem Value="italic" aria-label="Toggle italic"><BzIcon Icon="@Tabler.Outline.Italic" /></BzToggleGroupItem>
            <BzToggleGroupItem Value="strike" aria-label="Toggle strikethrough"><BzIcon Icon="@Tabler.Outline.Strikethrough" /></BzToggleGroupItem>
        </BzToggleGroup>
    </div>
</div>
