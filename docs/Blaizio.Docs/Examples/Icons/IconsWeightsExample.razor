@* Phosphor ships six weights as six families - the weight is part of the member, not a parameter. *@
<div class="flex flex-wrap items-end justify-center gap-5 text-foreground">
    <div class="flex flex-col items-center gap-2">
        <BzIcon Icon="@Phosphor.Thin.Heart" Class="size-8" />
        <span class="text-xs text-muted-foreground">Thin</span>
    </div>
    <div class="flex flex-col items-center gap-2">
        <BzIcon Icon="@Phosphor.Light.Heart" Class="size-8" />
        <span class="text-xs text-muted-foreground">Light</span>
    </div>
    <div class="flex flex-col items-center gap-2">
        <BzIcon Icon="@Phosphor.Regular.Heart" Class="size-8" />
        <span class="text-xs text-muted-foreground">Regular</span>
    </div>
    <div class="flex flex-col items-center gap-2">
        <BzIcon Icon="@Phosphor.Bold.Heart" Class="size-8" />
        <span class="text-xs text-muted-foreground">Bold</span>
    </div>
    <div class="flex flex-col items-center gap-2">
        <BzIcon Icon="@Phosphor.Fill.Heart" Class="size-8 text-rose-500" />
        <span class="text-xs text-muted-foreground">Fill</span>
    </div>
    <div class="flex flex-col items-center gap-2">
        <BzIcon Icon="@Phosphor.Duotone.Heart" Class="size-8 text-rose-500" />
        <span class="text-xs text-muted-foreground">Duotone</span>
    </div>
</div>
