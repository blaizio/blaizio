@* One tooltip per icon; the focusable span is the trigger via RenderAs. *@
<BzTooltipProvider>
    <div class="flex items-center gap-4 text-muted-foreground">
        <BzTooltip>
            <BzTooltipTrigger>
                <RenderAs Context="p">
                    <span tabindex="0" class="hover:text-foreground inline-flex rounded-sm outline-none focus-visible:ring-2 focus-visible:ring-ring/50" @attributes="p.Attributes">
                        <BzIcon Icon="@Tabler.Outline.Bell" Class="size-5" />
                    </span>
                </RenderAs>
            </BzTooltipTrigger>
            <BzTooltipContent>Notifications<BzTooltipArrow /></BzTooltipContent>
        </BzTooltip>
        <BzTooltip>
            <BzTooltipTrigger>
                <RenderAs Context="p">
                    <span tabindex="0" class="hover:text-foreground inline-flex rounded-sm outline-none focus-visible:ring-2 focus-visible:ring-ring/50" @attributes="p.Attributes">
                        <BzIcon Icon="@Tabler.Outline.Settings" Class="size-5" />
                    </span>
                </RenderAs>
            </BzTooltipTrigger>
            <BzTooltipContent>Settings<BzTooltipArrow /></BzTooltipContent>
        </BzTooltip>
        <BzTooltip>
            <BzTooltipTrigger>
                <RenderAs Context="p">
                    <span tabindex="0" class="hover:text-foreground inline-flex rounded-sm outline-none focus-visible:ring-2 focus-visible:ring-ring/50" @attributes="p.Attributes">
                        <BzIcon Icon="@Tabler.Outline.Help" Class="size-5" />
                    </span>
                </RenderAs>
            </BzTooltipTrigger>
            <BzTooltipContent>Help & support<BzTooltipArrow /></BzTooltipContent>
        </BzTooltip>
    </div>
</BzTooltipProvider>
