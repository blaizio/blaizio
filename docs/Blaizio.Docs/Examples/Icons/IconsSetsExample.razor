@* The same "house" from each set, side by side: every Icon carries its own grid and stroke width,
   so one BzIcon renders all five at their true weight - Phosphor's 256 grid, Hugeicons' 1.5 stroke. *@
<div class="flex flex-wrap items-end justify-center gap-6 text-foreground">
    <div class="flex flex-col items-center gap-2">
        <BzIcon Icon="@Tabler.Outline.Home" Class="size-8" />
        <span class="text-xs text-muted-foreground">Tabler</span>
    </div>
    <div class="flex flex-col items-center gap-2">
        <BzIcon Icon="@Lucide.Outline.House" Class="size-8" />
        <span class="text-xs text-muted-foreground">Lucide</span>
    </div>
    <div class="flex flex-col items-center gap-2">
        <BzIcon Icon="@Phosphor.Regular.House" Class="size-8" />
        <span class="text-xs text-muted-foreground">Phosphor</span>
    </div>
    <div class="flex flex-col items-center gap-2">
        <BzIcon Icon="@Remix.Line.Home" Class="size-8" />
        <span class="text-xs text-muted-foreground">Remix</span>
    </div>
    <div class="flex flex-col items-center gap-2">
        <BzIcon Icon="@HugeIcons.StrokeRounded.Home01" Class="size-8" />
        <span class="text-xs text-muted-foreground">Hugeicons</span>
    </div>
</div>
