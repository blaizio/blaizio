@* pill = rounded-full; the active page recolors via the data-[active=true] variant. *@
<BzPagination>
    <BzPaginationContent Class="gap-2">
        <BzPaginationItem><BzPaginationPrevious Disabled="@(_page == 1)" Click="@(() => _page -= 1)" Class="rounded-full" /></BzPaginationItem>
        <BzPaginationItem><BzPaginationLink Active="@(_page == 1)" Click="@(() => _page = 1)" Class="rounded-full data-[active=true]:border-indigo-600 data-[active=true]:bg-indigo-600 data-[active=true]:text-white">1</BzPaginationLink></BzPaginationItem>
        <BzPaginationItem><BzPaginationLink Active="@(_page == 2)" Click="@(() => _page = 2)" Class="rounded-full data-[active=true]:border-indigo-600 data-[active=true]:bg-indigo-600 data-[active=true]:text-white">2</BzPaginationLink></BzPaginationItem>
        <BzPaginationItem><BzPaginationLink Active="@(_page == 3)" Click="@(() => _page = 3)" Class="rounded-full data-[active=true]:border-indigo-600 data-[active=true]:bg-indigo-600 data-[active=true]:text-white">3</BzPaginationLink></BzPaginationItem>
        <BzPaginationItem><BzPaginationNext Disabled="@(_page == 3)" Click="@(() => _page += 1)" Class="rounded-full" /></BzPaginationItem>
    </BzPaginationContent>
</BzPagination>

@code { private int _page = 2; }
