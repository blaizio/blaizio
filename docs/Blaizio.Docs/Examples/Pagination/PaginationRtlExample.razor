<RtlDemo Context="t">
    <BzDirectionProvider Dir="Direction.Rtl">
        <BzPagination>
            <BzPaginationContent>
                <BzPaginationItem><BzPaginationPrevious Disabled="@(_page == 1)" Click="@(() => _page -= 1)" Label='@t["السابق", "הקודם"]' AriaLabel='@t["الصفحة السابقة", "העמוד הקודם"]' /></BzPaginationItem>
                <BzPaginationItem><BzPaginationLink Active="@(_page == 1)" Click="@(() => _page = 1)">1</BzPaginationLink></BzPaginationItem>
                <BzPaginationItem><BzPaginationLink Active="@(_page == 2)" Click="@(() => _page = 2)">2</BzPaginationLink></BzPaginationItem>
                <BzPaginationItem><BzPaginationLink Active="@(_page == 3)" Click="@(() => _page = 3)">3</BzPaginationLink></BzPaginationItem>
                <BzPaginationItem><BzPaginationNext Disabled="@(_page == 3)" Click="@(() => _page += 1)" Label='@t["التالي", "הבא"]' AriaLabel='@t["الصفحة التالية", "העמוד הבא"]' /></BzPaginationItem>
            </BzPaginationContent>
        </BzPagination>
    </BzDirectionProvider>
</RtlDemo>

@code { private int _page = 2; }
