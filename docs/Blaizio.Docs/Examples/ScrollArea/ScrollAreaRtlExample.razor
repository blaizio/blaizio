<RtlDemo Context="t">
    <BzDirectionProvider Dir="Direction.Rtl">
        <BzScrollArea Class="h-72 w-56 rounded-md border">
            <div class="p-4">
                <h4 class="mb-4 text-sm font-medium leading-none">@t["القائمة", "הרשימה"]</h4>
                @foreach (var item in _rtlItems)
                {
                    <div class="text-sm">@t[item.Ar, item.He]</div>
                    <BzSeparator Class="my-2" />
                }
            </div>
        </BzScrollArea>
    </BzDirectionProvider>
</RtlDemo>

@code {
    private static readonly (string Ar, string He)[] _rtlItems =
        Enumerable.Range(1, 30).Select(i => ($"العنصر رقم {i}", $"פריט מספר {i}")).ToArray();
}
