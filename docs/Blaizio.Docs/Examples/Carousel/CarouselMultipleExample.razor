<div class="mx-auto w-full max-w-2xl">
    <BzCarousel AriaLabel="Sample slides">
        <BzCarouselContent>
            @foreach (var i in Enumerable.Range(1, 8))
            {
                <BzCarouselItem Class="basis-1/2 md:basis-1/3">@Slide(i)</BzCarouselItem>
            }
        </BzCarouselContent>
        <BzCarouselPrevious />
        <BzCarouselNext />
    </BzCarousel>
</div>

@code {
    // A simple numbered slide.
    private RenderFragment Slide(int n) =>
        @<div class="flex aspect-square items-center justify-center rounded-xl border bg-muted">
            <span class="text-4xl font-semibold">@n</span>
        </div>;
}
