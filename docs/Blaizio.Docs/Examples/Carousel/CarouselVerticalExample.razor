<div class="mx-auto w-full max-w-xs py-2">
    <BzCarousel AriaLabel="Sample slides" Orientation="Orientation.Vertical">
        <BzCarouselContent Class="h-[300px]">
            @foreach (var i in Enumerable.Range(1, 5))
            {
                <BzCarouselItem Class="basis-1/2">@Slide(i)</BzCarouselItem>
            }
        </BzCarouselContent>
        <BzCarouselPrevious />
        <BzCarouselNext />
    </BzCarousel>
</div>

@code {
    // A simple numbered slide.
    private RenderFragment Slide(int n) =>
        @<div class="flex aspect-square items-center justify-center rounded-xl border bg-muted">
            <span class="text-4xl font-semibold">@n</span>
        </div>;
}
