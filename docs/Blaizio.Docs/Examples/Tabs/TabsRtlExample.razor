<RtlDemo Context="t">
    <BzDirectionProvider Dir="Direction.Rtl">
        <BzTabs DefaultValue="account" Class="w-full max-w-sm">
            <BzTabsList AriaLabel="@(t["إعدادات الحساب", "הגדרות חשבון"])">
                <BzTabsTrigger Value="account">@t["الحساب", "חשבון"]</BzTabsTrigger>
                <BzTabsTrigger Value="password">@t["كلمة المرور", "סיסמה"]</BzTabsTrigger>
            </BzTabsList>
            <BzTabsContent Value="account">
                <BzCard>
                    <BzCardHeader>
                        <BzCardTitle>@t["الحساب", "חשבון"]</BzCardTitle>
                        <BzCardDescription>@t["قم بتعديل بيانات حسابك هنا.", "ערוך את פרטי החשבון שלך כאן."]</BzCardDescription>
                    </BzCardHeader>
                    <BzCardContent Class="space-y-4">
                        <div class="space-y-2">
                            <BzLabel For="rtl-tabs-name">@t["الاسم", "שם"]</BzLabel>
                            <BzInputText id="rtl-tabs-name" Placeholder="@t["ليلى أحمد", "נועה כהן"]" />
                        </div>
                        <div class="space-y-2">
                            <BzLabel For="rtl-tabs-email">@t["البريد الإلكتروني", "אימייל"]</BzLabel>
                            <BzInputText id="rtl-tabs-email" Type="email" Placeholder="you@example.com" />
                        </div>
                    </BzCardContent>
                    <BzCardFooter>
                        <BzButton>@t["حفظ التغييرات", "שמירת שינויים"]</BzButton>
                    </BzCardFooter>
                </BzCard>
            </BzTabsContent>
            <BzTabsContent Value="password">
                <BzCard>
                    <BzCardHeader>
                        <BzCardTitle>@t["كلمة المرور", "סיסמה"]</BzCardTitle>
                        <BzCardDescription>@t["غيّر كلمة المرور الخاصة بك هنا.", "שנה את הסיסמה שלך כאן."]</BzCardDescription>
                    </BzCardHeader>
                    <BzCardContent Class="space-y-4">
                        <div class="space-y-2">
                            <BzLabel For="rtl-tabs-current">@t["كلمة المرور الحالية", "סיסמה נוכחית"]</BzLabel>
                            <BzInputText id="rtl-tabs-current" Type="password" />
                        </div>
                        <div class="space-y-2">
                            <BzLabel For="rtl-tabs-new">@t["كلمة المرور الجديدة", "סיסמה חדשה"]</BzLabel>
                            <BzInputText id="rtl-tabs-new" Type="password" />
                        </div>
                    </BzCardContent>
                    <BzCardFooter>
                        <BzButton>@t["تغيير كلمة المرور", "שינוי סיסמה"]</BzButton>
                    </BzCardFooter>
                </BzCard>
            </BzTabsContent>
        </BzTabs>
    </BzDirectionProvider>
</RtlDemo>
