<RtlDemo Context="t">
    <BzDirectionProvider Dir="Direction.Rtl">
        <BzTabs DefaultValue="overview" Class="w-full max-w-sm">
            <BzTabsList AriaLabel="@(t["أقسام المشروع", "מקטעי הפרויקט"])" Variant="TabsListVariant.Line">
                <BzTabsTrigger Value="overview">@t["نظرة عامة", "סקירה כללית"]</BzTabsTrigger>
                <BzTabsTrigger Value="analytics">@t["التحليلات", "אנליטיקה"]</BzTabsTrigger>
                <BzTabsTrigger Value="reports">@t["التقارير", "דוחות"]</BzTabsTrigger>
            </BzTabsList>
            <BzTabsContent Value="overview"><p class="p-2 text-sm text-muted-foreground">@t["نظرة شاملة على المشروع.", "סקירה מקיפה של הפרויקט."]</p></BzTabsContent>
            <BzTabsContent Value="analytics"><p class="p-2 text-sm text-muted-foreground">@t["الرسوم البيانية والأرقام.", "התרשימים והמספרים."]</p></BzTabsContent>
            <BzTabsContent Value="reports"><p class="p-2 text-sm text-muted-foreground">@t["التصدير والملخّصات.", "ייצוא וסיכומים."]</p></BzTabsContent>
        </BzTabs>
    </BzDirectionProvider>
</RtlDemo>
