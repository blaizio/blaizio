<BzTabs DefaultValue="name" PanelFocusable="false" Class="w-full max-w-sm">
    <BzTabsList AriaLabel="Profile fields">
        <BzTabsTrigger Value="name">Name</BzTabsTrigger>
        <BzTabsTrigger Value="email">Email</BzTabsTrigger>
    </BzTabsList>
    <BzTabsContent Value="name" Class="pt-3">
        <BzInputText placeholder="Display name" aria-label="Display name" />
    </BzTabsContent>
    <BzTabsContent Value="email" Class="pt-3">
        <BzInputText Type="email" placeholder="you@example.com" aria-label="Email address" />
    </BzTabsContent>
</BzTabs>
