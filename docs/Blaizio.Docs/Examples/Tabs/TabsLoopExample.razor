<div class="flex flex-col gap-8 sm:flex-row sm:gap-12">
    <div class="space-y-2">
        <p class="text-sm font-medium">Loops (default)</p>
        <BzTabs DefaultValue="a" Class="w-full max-w-xs">
            <BzTabsList AriaLabel="Looping tabs">
                <BzTabsTrigger Value="a">First</BzTabsTrigger>
                <BzTabsTrigger Value="b">Second</BzTabsTrigger>
                <BzTabsTrigger Value="c">Third</BzTabsTrigger>
            </BzTabsList>
            <BzTabsContent Value="a"><p class="p-2 text-sm text-muted-foreground">Past the last tab returns to the first.</p></BzTabsContent>
            <BzTabsContent Value="b"><p class="p-2 text-sm text-muted-foreground">Second panel.</p></BzTabsContent>
            <BzTabsContent Value="c"><p class="p-2 text-sm text-muted-foreground">Third panel.</p></BzTabsContent>
        </BzTabs>
    </div>
    <div class="space-y-2">
        <p class="text-sm font-medium">Stops (Loop = false)</p>
        <BzTabs DefaultValue="a" Class="w-full max-w-xs">
            <BzTabsList AriaLabel="Non-looping tabs" Loop="false">
                <BzTabsTrigger Value="a">First</BzTabsTrigger>
                <BzTabsTrigger Value="b">Second</BzTabsTrigger>
                <BzTabsTrigger Value="c">Third</BzTabsTrigger>
            </BzTabsList>
            <BzTabsContent Value="a"><p class="p-2 text-sm text-muted-foreground">The last tab is the end of the line.</p></BzTabsContent>
            <BzTabsContent Value="b"><p class="p-2 text-sm text-muted-foreground">Second panel.</p></BzTabsContent>
            <BzTabsContent Value="c"><p class="p-2 text-sm text-muted-foreground">Third panel.</p></BzTabsContent>
        </BzTabs>
    </div>
</div>
