<div class="flex w-full max-w-sm flex-col items-center gap-3">
    <BzTabs @bind-Value="_tab" Class="w-full">
        <BzTabsList>
            <BzTabsTrigger Value="one">One</BzTabsTrigger>
            <BzTabsTrigger Value="two">Two</BzTabsTrigger>
        </BzTabsList>
        <BzTabsContent Value="one"><p class="p-2 text-sm text-muted-foreground">First panel.</p></BzTabsContent>
        <BzTabsContent Value="two"><p class="p-2 text-sm text-muted-foreground">Second panel.</p></BzTabsContent>
    </BzTabs>
    <p class="text-sm text-muted-foreground">Selected: <span class="font-mono">@_tab</span></p>
</div>

@code {
    private string? _tab = "one";
}
