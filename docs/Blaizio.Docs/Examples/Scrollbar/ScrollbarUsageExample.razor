@* Opt in per container. Nothing is styled globally, so a page you did not ask about keeps its
   native scrollbars. *@
<div tabindex="0" class="scrollbar-thin h-40 overflow-y-auto rounded-md border p-4 outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50">
    @foreach (var row in Enumerable.Range(1, 14))
    {
        <p class="py-1 text-sm">Row @row</p>
    }
</div>
