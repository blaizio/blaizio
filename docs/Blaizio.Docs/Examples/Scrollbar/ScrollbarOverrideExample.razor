@* Components that ship a scrollbar take the override through their Class: every scrollbar-* utility
   is one class group, so the class you pass REPLACES the default rather than fighting it. Open the
   select - its list keeps the browser's own bar. *@
<div class="flex w-full flex-wrap items-start gap-6">
    <BzSelect>
        <BzSelectTrigger AriaLabel="City" Class="w-56">
            <BzSelectValue Placeholder="Pick a city" />
        </BzSelectTrigger>
        <BzSelectContent Class="scrollbar-auto max-h-52">
            @foreach (var city in Cities)
            {
                <BzSelectItem Value="@city.ToLowerInvariant()">@city</BzSelectItem>
            }
        </BzSelectContent>
    </BzSelect>

    <div class="space-y-2">
        <p class="text-muted-foreground text-xs font-medium">scrollbar-thin scrollbar-auto</p>
        <div tabindex="0" class="@Tw.Merge("scrollbar-thin h-32 w-56 overflow-y-auto rounded-md border p-4", "scrollbar-auto")">
            @foreach (var row in Enumerable.Range(1, 12))
            {
                <p class="py-1 text-sm">Row @row</p>
            }
        </div>
    </div>
</div>

@code {
    private static readonly string[] Cities =
        ["Abu Dhabi", "Amsterdam", "Berlin", "Cairo", "Dubai", "Lisbon", "Nairobi", "Osaka", "Riyadh", "Tokyo"];
}
