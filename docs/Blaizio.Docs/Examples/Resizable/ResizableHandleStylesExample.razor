@* Handle = None | Grip | Dots | Knob | Pill (or pass ChildContent to replace the grip). *@
<div class="grid w-full gap-6 sm:grid-cols-2 lg:grid-cols-3">
    @foreach (var v in HandleVariants)
    {
        <div class="space-y-2">
            <p class="text-muted-foreground text-center text-xs font-medium">@v</p>
            <div class="h-[140px] w-full">
                <BzResizablePanelGroup Orientation="Orientation.Horizontal" Class="rounded-lg border">
                    <BzResizablePanel DefaultSize="50">
                        <div class="flex h-full items-center justify-center p-4"><span class="text-sm font-semibold">One</span></div>
                    </BzResizablePanel>
                    <BzResizableHandle Handle="v" />
                    <BzResizablePanel DefaultSize="50">
                        <div class="flex h-full items-center justify-center p-4"><span class="text-sm font-semibold">Two</span></div>
                    </BzResizablePanel>
                </BzResizablePanelGroup>
            </div>
        </div>
    }
</div>

@code {
    private static readonly ResizableHandleVariant[] HandleVariants =
        Enum.GetValues<ResizableHandleVariant>();
}
