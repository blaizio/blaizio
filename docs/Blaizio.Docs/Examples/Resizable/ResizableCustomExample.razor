<div class="h-[260px] w-full max-w-2xl">
    <BzResizablePanelGroup Orientation="Orientation.Horizontal" Class="rounded-lg border">
        <BzResizablePanel DefaultSize="50">
            <div class="flex h-full items-center justify-center p-6"><span class="font-semibold">One</span></div>
        </BzResizablePanel>
        @* At rest this is the stock hairline. Hovering (or dragging - the data attribute the drag
           stamps) paints the centered line indigo, and RevealOnHover fades the custom grip in with
           it. Colour the line through after:, not the strip: the strip is the full-height hit area,
           and its own background would wash the whole thing. *@
        <BzResizableHandle AriaLabel="Resize panels" RevealOnHover="true"
                           Class="hover:after:bg-indigo-400 data-[resize-handle-active]:after:bg-indigo-400 dark:hover:after:bg-indigo-600 dark:data-[resize-handle-active]:after:bg-indigo-600">
            <div class="z-10 flex h-8 w-5 items-center justify-center rounded-md bg-indigo-500 text-white shadow-sm transition-colors duration-200">
                <BzIcon Icon="@Icons.Outline.GripVertical" Class="size-3.5" />
            </div>
        </BzResizableHandle>
        <BzResizablePanel DefaultSize="50">
            <div class="flex h-full items-center justify-center p-6"><span class="font-semibold">Two</span></div>
        </BzResizablePanel>
    </BzResizablePanelGroup>
</div>
