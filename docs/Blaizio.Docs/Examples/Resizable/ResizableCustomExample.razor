<div class="h-[260px] w-full max-w-2xl">
    <BzResizablePanelGroup Orientation="Orientation.Horizontal" Class="rounded-lg border">
        <BzResizablePanel DefaultSize="50">
            <div class="flex h-full items-center justify-center p-6"><span class="font-semibold">One</span></div>
        </BzResizablePanel>
        @* Class restyles the bar; ChildContent replaces the default grip. *@
        <BzResizableHandle AriaLabel="Resize panels" Class="w-1 bg-indigo-200 transition-colors duration-200 hover:bg-indigo-300 dark:bg-indigo-900 dark:hover:bg-indigo-800">
            <div class="z-10 flex h-8 w-5 items-center justify-center rounded-md bg-indigo-500 text-white shadow-sm transition-colors duration-200">
                <BzIcon Icon="@Icons.Outline.GripVertical" Class="size-3.5" />
            </div>
        </BzResizableHandle>
        <BzResizablePanel DefaultSize="50">
            <div class="flex h-full items-center justify-center p-6"><span class="font-semibold">Two</span></div>
        </BzResizablePanel>
    </BzResizablePanelGroup>
</div>
