<div class="w-full space-y-3">
    <div class="h-[200px] w-full">
        <BzResizablePanelGroup Orientation="Orientation.Horizontal" OnLayout="OnLayoutChanged" Class="rounded-lg border">
            <BzResizablePanel DefaultSize="40">
                <div class="flex h-full items-center justify-center p-6"><span class="font-semibold">Left</span></div>
            </BzResizablePanel>
            <BzResizableHandle AriaLabel="Resize panels" Handle="ResizableHandleVariant.Grip" />
            <BzResizablePanel DefaultSize="60">
                <div class="flex h-full items-center justify-center p-6"><span class="font-semibold">Right</span></div>
            </BzResizablePanel>
        </BzResizablePanelGroup>
    </div>
    <p class="text-muted-foreground text-sm">Sizes: <span class="text-foreground font-mono">@_sizesText</span></p>
</div>

@code {
    private string _sizesText = "40, 60";

    private void OnLayoutChanged(IReadOnlyList<double> sizes) =>
        _sizesText = string.Join(", ", sizes.Select(s => s.ToString("0")));
}
