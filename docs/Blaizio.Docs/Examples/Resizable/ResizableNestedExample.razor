<div class="h-[320px] w-full">
    <BzResizablePanelGroup Orientation="Orientation.Horizontal" Class="rounded-lg border">
        <BzResizablePanel DefaultSize="40" MinSize="20">
            <div class="flex h-full items-center justify-center p-6"><span class="font-semibold">Sidebar</span></div>
        </BzResizablePanel>
        <BzResizableHandle AriaLabel="Resize sidebar" Handle="ResizableHandleVariant.Grip" />
        <BzResizablePanel DefaultSize="60">
            <BzResizablePanelGroup Orientation="Orientation.Vertical">
                <BzResizablePanel DefaultSize="30">
                    <div class="flex h-full items-center justify-center p-6"><span class="font-semibold">Header</span></div>
                </BzResizablePanel>
                <BzResizableHandle AriaLabel="Resize header" Handle="ResizableHandleVariant.Grip" />
                <BzResizablePanel DefaultSize="70">
                    <div class="flex h-full items-center justify-center p-6"><span class="font-semibold">Main</span></div>
                </BzResizablePanel>
            </BzResizablePanelGroup>
        </BzResizablePanel>
    </BzResizablePanelGroup>
</div>
