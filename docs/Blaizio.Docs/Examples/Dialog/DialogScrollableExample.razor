<BzDialog>
    <BzDialogTrigger Variant="ButtonVariant.Outline">Scrollable content</BzDialogTrigger>
    <BzDialogContent>
        <BzDialogHeader>
            <BzDialogTitle>Terms of service</BzDialogTitle>
            <BzDialogDescription>The body scrolls; the page behind stays locked.</BzDialogDescription>
        </BzDialogHeader>
        <div class="scrollbar-thin -mx-6 max-h-[50vh] overflow-y-auto px-6">
            @for (var i = 0; i < 8; i++)
            {
                <p class="mb-4 leading-normal">@LoremText</p>
            }
        </div>
    </BzDialogContent>
</BzDialog>

@code {
    private const string LoremText =
        "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut " +
        "labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco " +
        "laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in " +
        "voluptate velit esse cillum dolore eu fugiat nulla pariatur.";
}
