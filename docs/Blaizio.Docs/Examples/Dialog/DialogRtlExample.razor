<RtlDemo Context="t">
    <BzDirectionProvider Direction="Direction.Rtl">
        <BzDialog>
            <BzDialogTrigger Variant="ButtonVariant.Outline">@t["تعديل الملف الشخصي", "עריכת פרופיל"]</BzDialogTrigger>
            <BzDialogContent>
                <BzDialogHeader>
                    <BzDialogTitle>@t["تعديل الملف الشخصي", "עריכת פרופיל"]</BzDialogTitle>
                    <BzDialogDescription>@t["أجرِ تغييرات على ملفك الشخصي هنا. اضغط على حفظ عند الانتهاء.", "בצע שינויים בפרופיל שלך כאן. לחץ על שמירה בסיום."]</BzDialogDescription>
                </BzDialogHeader>
                <div class="grid gap-4">
                    <div class="grid gap-2">
                        <BzLabel for="dialog-name-rtl">@t["الاسم", "שם"]</BzLabel>
                        <BzInputText id="dialog-name-rtl" Value='@t["آدا لوفلايس", "עדה לאבלייס"]' />
                    </div>
                    <div class="grid gap-2">
                        <BzLabel for="dialog-username-rtl">@t["اسم المستخدم", "שם משתמש"]</BzLabel>
                        <BzInputText id="dialog-username-rtl" Value="@("@ada")" />
                    </div>
                </div>
                <BzDialogFooter>
                    <BzDialogClose Variant="ButtonVariant.Outline">@t["إلغاء", "ביטול"]</BzDialogClose>
                    <BzDialogClose>@t["حفظ التغييرات", "שמור שינויים"]</BzDialogClose>
                </BzDialogFooter>
            </BzDialogContent>
        </BzDialog>
    </BzDirectionProvider>
</RtlDemo>
