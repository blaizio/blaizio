@* Depth on the spacing scale, or any length. Scroll each box to compare how far the dissolve runs. *@
<div class="grid w-full gap-6 sm:grid-cols-2 lg:grid-cols-4">
    @foreach (var cls in Depths)
    {
        <div class="space-y-2">
            <p class="text-muted-foreground text-xs font-medium">@cls</p>
            <div tabindex="0" class="@($"scroll-fade {cls} scrollbar-thin h-36 overflow-y-auto rounded-md border p-4 outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50")">
                @foreach (var row in Enumerable.Range(1, 12))
                {
                    <p class="py-1 text-sm">Row @row</p>
                }
            </div>
        </div>
    }
</div>

@code {
    private static readonly string[] Depths =
        ["scroll-fade-2", "scroll-fade-8", "scroll-fade-16", "scroll-fade-[25%]"];
}
