<div class="grid w-full gap-6 sm:grid-cols-2">
    <div class="space-y-2">
        <p class="text-muted-foreground text-xs font-medium">Overflowing: scroll it</p>
        <div tabindex="0" class="scroll-fade scrollbar-thin h-40 overflow-y-auto rounded-md border p-4 outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50">
            @foreach (var row in Enumerable.Range(1, 14))
            {
                <p class="py-1 text-sm">Row @row</p>
            }
        </div>
    </div>
    <div class="space-y-2">
        <p class="text-muted-foreground text-xs font-medium">Same class, content fits: no fade</p>
        <div tabindex="0" class="scroll-fade scrollbar-thin h-40 overflow-y-auto rounded-md border p-4 outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50">
            @foreach (var row in Enumerable.Range(1, 3))
            {
                <p class="py-1 text-sm">Row @row</p>
            }
        </div>
    </div>
</div>
