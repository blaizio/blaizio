@* A deep top edge over a shallow bottom one - the depths are set per edge, the tracking stays on both. *@
<div class="grid w-full gap-6 sm:grid-cols-2">
    <div class="space-y-2">
        <p class="text-muted-foreground text-xs font-medium">scroll-fade scroll-fade-t-16 scroll-fade-b-2</p>
        <div tabindex="0" class="scroll-fade scroll-fade-t-16 scroll-fade-b-2 scrollbar-thin h-40 overflow-y-auto rounded-md border p-4 outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50">
            @foreach (var row in Enumerable.Range(1, 14))
            {
                <p class="py-1 text-sm">Row @row</p>
            }
        </div>
    </div>
    <div class="space-y-2">
        <p class="text-muted-foreground text-xs font-medium">scroll-fade scroll-fade-reveal-8 <span class="font-normal">- the ease is over almost at once</span></p>
        <div tabindex="0" class="scroll-fade scroll-fade-reveal-8 scrollbar-thin h-40 overflow-y-auto rounded-md border p-4 outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50">
            @foreach (var row in Enumerable.Range(1, 14))
            {
                <p class="py-1 text-sm">Row @row</p>
            }
        </div>
    </div>
</div>
