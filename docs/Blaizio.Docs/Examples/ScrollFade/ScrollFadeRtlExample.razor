@* scroll-fade-s tracks the edge the content scrolls AWAY from, which is the right-hand one here. *@
<RtlDemo Context="t">
    <BzDirectionProvider Dir="Direction.Rtl">
        <div class="w-full space-y-2">
            <p class="text-muted-foreground text-xs font-medium">scroll-fade-s</p>
            <div tabindex="0" class="scroll-fade-s scrollbar-thin flex gap-3 overflow-x-auto rounded-md border p-4 outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50">
                @foreach (var card in Enumerable.Range(1, 14))
                {
                    <div class="bg-muted text-muted-foreground flex size-20 shrink-0 items-center justify-center rounded-md text-sm">
                        @t[$"بطاقة {card}", $"כרטיס {card}"]
                    </div>
                }
            </div>
        </div>
    </BzDirectionProvider>
</RtlDemo>
