<div class="w-full space-y-2">
    <p class="text-muted-foreground text-xs font-medium">scroll-fade-x</p>
    <div tabindex="0" class="scroll-fade-x scrollbar-thin flex gap-3 overflow-x-auto rounded-md border p-4">
        @foreach (var card in Enumerable.Range(1, 14))
        {
            <div class="bg-muted text-muted-foreground flex size-20 shrink-0 items-center justify-center rounded-md text-sm">
                @card
            </div>
        }
    </div>
</div>
