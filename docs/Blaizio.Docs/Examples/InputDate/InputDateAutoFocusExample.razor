@* AutoFocus: the field focuses its FIRST segment when it mounts, ready for digits; each segment
   already selects itself on focus, so typing overwrites. BzInputTime has the same parameter.
   (Rendered on demand so the demo does not steal the page's focus on every visit.) *@
<div class="flex w-full max-w-sm flex-col items-start gap-4">
    @if (!_shown)
    {
        <BzButton Variant="ButtonVariant.Outline" @onclick="@(() => _shown = true)">Pick a date</BzButton>
    }
    else
    {
        <BzInputDate @bind-Value="_date" AutoFocus />
    }
</div>

@code {
    private bool _shown;
    private DateOnly? _date;
}
