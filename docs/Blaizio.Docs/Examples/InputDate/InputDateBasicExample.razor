<div class="flex flex-col items-center gap-3">
    <BzInputDate @bind-Value="_date" />
    <p class="text-sm text-muted-foreground">Selected: <span class="font-mono">@(_date?.ToString("yyyy-MM-dd") ?? "None")</span></p>
</div>

@code {
    private DateOnly? _date = DateOnly.FromDateTime(DateTime.Today);
}
