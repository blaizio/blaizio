<div class="flex flex-wrap items-center justify-center gap-3">
    <BzInputDate @bind-Value="_date" Format="dd/MM/yyyy" ShowCalendar />
    <BzInputTime @bind-Value="_time" />
</div>

@code {
    private DateOnly? _date = DateOnly.FromDateTime(DateTime.Today);
    private TimeOnly? _time = new(9, 30);
}
