<div class="flex flex-wrap items-center justify-center gap-4">
    <BzInputDate @bind-Value="_date" Format="dd/MM/yyyy"
                 Class="rounded-full border-indigo-500/60 px-4 focus-within:border-indigo-500 focus-within:ring-indigo-500/40" />

    @* Swap the leading glyph through the Icon slot. *@
    <BzInputDate @bind-Value="_dateIcon" Format="dd/MM/yyyy">
        <Icon><BzIcon Icon="@Icons.Outline.CalendarEvent" Class="size-4 text-indigo-500" /></Icon>
    </BzInputDate>
</div>

@code {
    private DateOnly? _date = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? _dateIcon = DateOnly.FromDateTime(DateTime.Today);
}
