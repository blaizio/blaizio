<RtlDemo Context="t">
    <BzDirectionProvider Dir="Direction.Rtl">
        <BzEmpty Class="max-w-md border border-dashed">
            <BzEmptyHeader>
                <BzEmptyMedia Variant="EmptyMediaVariant.Icon">
                    <BzIcon Icon="@Tabler.Outline.FolderOpen" />
                </BzEmptyMedia>
                <BzEmptyTitle>@t["لا توجد مشاريع بعد", "אין פרויקטים עדיין"]</BzEmptyTitle>
                <BzEmptyDescription>@t["أنشئ مشروعك الأول للبدء.", "צור את הפרויקט הראשון שלך כדי להתחיל."]</BzEmptyDescription>
            </BzEmptyHeader>
            <BzEmptyContent>
                <div class="flex gap-2">
                    <BzButton>@t["إنشاء مشروع", "צור פרויקט"]</BzButton>
                    <BzButton Variant="ButtonVariant.Outline">@t["استيراد", "ייבוא"]</BzButton>
                </div>
            </BzEmptyContent>
        </BzEmpty>
    </BzDirectionProvider>
</RtlDemo>
