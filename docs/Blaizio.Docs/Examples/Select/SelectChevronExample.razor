<div class="flex items-center gap-4">
    @* Swap the glyph via the Icon parameter... *@
    <BzSelect>
        <BzSelectTrigger AriaLabel="Option" Class="w-44" Icon="@Tabler.Outline.CaretDown">
            <BzSelectValue Placeholder="Caret" />
        </BzSelectTrigger>
        <BzSelectContent>
            <BzSelectItem Value="a">Option A</BzSelectItem>
            <BzSelectItem Value="b">Option B</BzSelectItem>
        </BzSelectContent>
    </BzSelect>
    @* ...or replace it entirely via the Chevron template. *@
    <BzSelect>
        <BzSelectTrigger AriaLabel="Option" Class="w-44">
            <ChildContent>
                <BzSelectValue Placeholder="Template" />
            </ChildContent>
            <Chevron>
                <BzIcon Icon="@Tabler.Outline.Filter" Class="size-4 opacity-50" />
            </Chevron>
        </BzSelectTrigger>
        <BzSelectContent>
            <BzSelectItem Value="a">Option A</BzSelectItem>
            <BzSelectItem Value="b">Option B</BzSelectItem>
        </BzSelectContent>
    </BzSelect>
</div>
