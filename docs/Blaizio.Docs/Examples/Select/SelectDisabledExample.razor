<div class="flex flex-wrap items-start gap-6">
    @* Per-option: the sold-out sizes are skipped by pointer and keyboard. *@
    <BzSelect>
        <BzSelectTrigger Class="w-48">
            <BzSelectValue Placeholder="Select a size" />
        </BzSelectTrigger>
        <BzSelectContent>
            <BzSelectItem Value="xs">Extra Small</BzSelectItem>
            <BzSelectItem Value="sm" Disabled>Small (sold out)</BzSelectItem>
            <BzSelectItem Value="md">Medium</BzSelectItem>
            <BzSelectItem Value="lg" Disabled>Large (sold out)</BzSelectItem>
            <BzSelectItem Value="xl">Extra Large</BzSelectItem>
        </BzSelectContent>
    </BzSelect>

    @* Whole select: the trigger renders inert and the listbox cannot open. *@
    <BzSelect DefaultValue="md" Disabled>
        <BzSelectTrigger Class="w-48">
            <BzSelectValue />
        </BzSelectTrigger>
        <BzSelectContent>
            <BzSelectItem Value="md">Medium</BzSelectItem>
        </BzSelectContent>
    </BzSelect>
</div>
