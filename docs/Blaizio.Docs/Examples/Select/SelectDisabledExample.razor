<BzSelect>
    <BzSelectTrigger Class="w-48">
        <BzSelectValue Placeholder="Select a size" />
    </BzSelectTrigger>
    <BzSelectContent>
        <BzSelectItem Value="xs">Extra Small</BzSelectItem>
        <BzSelectItem Value="sm" Disabled>Small (sold out)</BzSelectItem>
        <BzSelectItem Value="md">Medium</BzSelectItem>
        <BzSelectItem Value="lg" Disabled>Large (sold out)</BzSelectItem>
        <BzSelectItem Value="xl">Extra Large</BzSelectItem>
    </BzSelectContent>
</BzSelect>
