<div class="flex flex-col items-center gap-4">
    <span class="text-muted-foreground text-sm">Value: @(_fruit ?? "(none)")</span>
    <div class="flex items-center gap-4">
        <BzSelect @bind-Value="_fruit">
            <BzSelectTrigger Class="w-48">
                <BzSelectValue Placeholder="Select a fruit" />
            </BzSelectTrigger>
            <BzSelectContent>
                <BzSelectItem Value="apple">Apple</BzSelectItem>
                <BzSelectItem Value="banana">Banana</BzSelectItem>
                <BzSelectItem Value="blueberry">Blueberry</BzSelectItem>
                <BzSelectItem Value="grapes">Grapes</BzSelectItem>
            </BzSelectContent>
        </BzSelect>
        <BzButton Variant="ButtonVariant.Secondary" @onclick="() => _fruit = null">Clear</BzButton>
    </div>
</div>

@code {
    private string? _fruit;
}
