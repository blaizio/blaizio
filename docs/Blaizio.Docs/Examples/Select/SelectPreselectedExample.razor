<BzSelect DefaultValue="banana">
    <BzSelectTrigger Class="w-48">
        <BzSelectValue Placeholder="Select a fruit" />
    </BzSelectTrigger>
    <BzSelectContent>
        <BzSelectItem Value="apple">Apple</BzSelectItem>
        <BzSelectItem Value="banana">Banana</BzSelectItem>
        <BzSelectItem Value="blueberry">Blueberry</BzSelectItem>
        <BzSelectItem Value="grapes">Grapes</BzSelectItem>
    </BzSelectContent>
</BzSelect>
