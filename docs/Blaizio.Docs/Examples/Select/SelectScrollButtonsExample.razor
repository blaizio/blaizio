<BzSelect>
    <BzSelectTrigger AriaLabel="Timezone" Class="w-64">
        <BzSelectValue Placeholder="Select a timezone" />
    </BzSelectTrigger>
    <BzSelectContent Scroll="SelectScrollMode.Buttons" Class="max-h-72">
        <BzSelectGroup>
            <BzSelectLabel>North America</BzSelectLabel>
            <BzSelectItem Value="est">Eastern Standard Time (EST)</BzSelectItem>
            <BzSelectItem Value="cst">Central Standard Time (CST)</BzSelectItem>
            <BzSelectItem Value="mst">Mountain Standard Time (MST)</BzSelectItem>
            <BzSelectItem Value="pst">Pacific Standard Time (PST)</BzSelectItem>
            <BzSelectItem Value="akst">Alaska Standard Time (AKST)</BzSelectItem>
            <BzSelectItem Value="hst">Hawaii Standard Time (HST)</BzSelectItem>
        </BzSelectGroup>
        <BzSelectSeparator />
        <BzSelectGroup>
            <BzSelectLabel>Europe &amp; Africa</BzSelectLabel>
            <BzSelectItem Value="gmt">Greenwich Mean Time (GMT)</BzSelectItem>
            <BzSelectItem Value="cet">Central European Time (CET)</BzSelectItem>
            <BzSelectItem Value="eet">Eastern European Time (EET)</BzSelectItem>
            <BzSelectItem Value="cat">Central Africa Time (CAT)</BzSelectItem>
        </BzSelectGroup>
        <BzSelectSeparator />
        <BzSelectGroup>
            <BzSelectLabel>Asia</BzSelectLabel>
            <BzSelectItem Value="ist">India Standard Time (IST)</BzSelectItem>
            <BzSelectItem Value="jst">Japan Standard Time (JST)</BzSelectItem>
            <BzSelectItem Value="gst">Gulf Standard Time (GST)</BzSelectItem>
        </BzSelectGroup>
    </BzSelectContent>
</BzSelect>
