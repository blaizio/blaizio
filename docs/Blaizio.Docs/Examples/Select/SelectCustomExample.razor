@* The scroll surface ships `scrollbar-thin`. To hand it back to the browser, pass
   `scrollbar-auto` - the class merge drops ours, so nothing is left to fight. Add a class of
   your own next to it (`scrollbar-auto my-bar`) when you want to style the bar yourself. *@
<BzSelect DefaultValue="banana">
    <BzSelectTrigger AriaLabel="Fruit" Class="w-48 rounded-lg border-indigo-300 text-indigo-700 dark:border-indigo-800 dark:text-indigo-300">
        <BzSelectValue Placeholder="Select a fruit" />
    </BzSelectTrigger>
    <BzSelectContent Class="scrollbar-auto max-h-52 rounded-xl border-indigo-200 bg-indigo-50/70 dark:border-indigo-900 dark:bg-indigo-950/60">
        <BzSelectItem Class="focus:bg-indigo-600 focus:text-white" Value="apple">Apple</BzSelectItem>
        <BzSelectItem Class="focus:bg-indigo-600 focus:text-white" Value="banana">Banana</BzSelectItem>
        <BzSelectItem Class="focus:bg-indigo-600 focus:text-white" Value="blueberry">Blueberry</BzSelectItem>
        <BzSelectItem Class="focus:bg-indigo-600 focus:text-white" Value="grapes">Grapes</BzSelectItem>
        <BzSelectItem Class="focus:bg-indigo-600 focus:text-white" Value="kiwi">Kiwi</BzSelectItem>
        <BzSelectItem Class="focus:bg-indigo-600 focus:text-white" Value="lychee">Lychee</BzSelectItem>
        <BzSelectItem Class="focus:bg-indigo-600 focus:text-white" Value="mango">Mango</BzSelectItem>
        <BzSelectItem Class="focus:bg-indigo-600 focus:text-white" Value="nectarine">Nectarine</BzSelectItem>
        <BzSelectItem Class="focus:bg-indigo-600 focus:text-white" Value="orange">Orange</BzSelectItem>
        <BzSelectItem Class="focus:bg-indigo-600 focus:text-white" Value="papaya">Papaya</BzSelectItem>
        <BzSelectItem Class="focus:bg-indigo-600 focus:text-white" Value="peach">Peach</BzSelectItem>
        <BzSelectItem Class="focus:bg-indigo-600 focus:text-white" Value="pear">Pear</BzSelectItem>
    </BzSelectContent>
</BzSelect>
