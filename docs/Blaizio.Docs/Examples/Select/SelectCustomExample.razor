<BzSelect DefaultValue="banana">
    <BzSelectTrigger AriaLabel="Fruit" Class="w-48 rounded-lg border-indigo-300 text-indigo-700 dark:border-indigo-800 dark:text-indigo-300">
        <BzSelectValue Placeholder="Select a fruit" />
    </BzSelectTrigger>
    <BzSelectContent Class="rounded-xl border-indigo-200 bg-indigo-50/70 dark:border-indigo-900 dark:bg-indigo-950/60">
        <BzSelectItem Class="focus:bg-indigo-600 focus:text-white" Value="apple">Apple</BzSelectItem>
        <BzSelectItem Class="focus:bg-indigo-600 focus:text-white" Value="banana">Banana</BzSelectItem>
        <BzSelectItem Class="focus:bg-indigo-600 focus:text-white" Value="blueberry">Blueberry</BzSelectItem>
        <BzSelectItem Class="focus:bg-indigo-600 focus:text-white" Value="grapes">Grapes</BzSelectItem>
    </BzSelectContent>
</BzSelect>
