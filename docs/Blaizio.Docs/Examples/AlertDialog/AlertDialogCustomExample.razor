<BzAlertDialog>
    <BzAlertDialogTrigger Class="bg-indigo-600 text-white hover:bg-indigo-700">Show dialog</BzAlertDialogTrigger>
    <BzAlertDialogContent Class="rounded-2xl border-indigo-200 bg-indigo-50/80 dark:border-indigo-900 dark:bg-indigo-950/70">
        <BzAlertDialogHeader>
            <BzAlertDialogTitle Class="text-indigo-700 dark:text-indigo-300">Are you absolutely sure?</BzAlertDialogTitle>
            <BzAlertDialogDescription>This action cannot be undone. This will permanently delete your account and remove your data from our servers.</BzAlertDialogDescription>
        </BzAlertDialogHeader>
        <BzAlertDialogFooter>
            <BzAlertDialogCancel>Cancel</BzAlertDialogCancel>
            <BzAlertDialogAction Class="bg-indigo-600 text-white hover:bg-indigo-700">Continue</BzAlertDialogAction>
        </BzAlertDialogFooter>
    </BzAlertDialogContent>
</BzAlertDialog>
