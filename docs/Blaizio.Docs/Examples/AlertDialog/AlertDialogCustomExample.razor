<BzAlertDialog>
    <BzAlertDialogTrigger Class="bg-indigo-600 text-white hover:bg-indigo-700">Show dialog</BzAlertDialogTrigger>
    <BzAlertDialogContent Class="rounded-2xl border-indigo-200 bg-indigo-50/80 dark:border-indigo-900 dark:bg-indigo-950/70">
        <BzAlertDialogHeader>
            <BzAlertDialogTitle Class="text-indigo-700 dark:text-indigo-300">Delete this project?</BzAlertDialogTitle>
            <BzAlertDialogDescription>The project, its files and its history go for good. Nobody on the team can restore them.</BzAlertDialogDescription>
        </BzAlertDialogHeader>
        <BzAlertDialogFooter>
            <BzAlertDialogCancel>Cancel</BzAlertDialogCancel>
            <BzAlertDialogAction Class="bg-indigo-600 text-white hover:bg-indigo-700">Delete project</BzAlertDialogAction>
        </BzAlertDialogFooter>
    </BzAlertDialogContent>
</BzAlertDialog>
