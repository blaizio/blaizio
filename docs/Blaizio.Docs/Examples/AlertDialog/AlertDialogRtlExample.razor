<RtlDemo Context="t">
    <BzDirectionProvider Direction="Direction.Rtl">
        <BzAlertDialog>
            <BzAlertDialogTrigger Variant="ButtonVariant.Outline">@t["عرض النافذة", "הצג חלון"]</BzAlertDialogTrigger>
            <BzAlertDialogContent>
                <BzAlertDialogHeader>
                    <BzAlertDialogTitle>@t["هل أنت متأكد تمامًا؟", "האם אתה בטוח לחלוטין?"]</BzAlertDialogTitle>
                    <BzAlertDialogDescription>@t["لا يمكن التراجع عن هذا الإجراء. سيؤدي ذلك إلى حذف حسابك نهائيًا وإزالة بياناتك من خوادمنا.", "לא ניתן לבטל פעולה זו. פעולה זו תמחק את חשבונך לצמיתות ותסיר את הנתונים שלך מהשרתים שלנו."]</BzAlertDialogDescription>
                </BzAlertDialogHeader>
                <BzAlertDialogFooter>
                    <BzAlertDialogCancel>@t["إلغاء", "ביטול"]</BzAlertDialogCancel>
                    <BzAlertDialogAction>@t["متابعة", "המשך"]</BzAlertDialogAction>
                </BzAlertDialogFooter>
            </BzAlertDialogContent>
        </BzAlertDialog>
    </BzDirectionProvider>
</RtlDemo>
