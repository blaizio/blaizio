<RtlDemo Context="t">
    <BzDirectionProvider Dir="Direction.Rtl">
        <BzAlertDialog>
            <BzAlertDialogTrigger Variant="ButtonVariant.Outline">@t["عرض النافذة", "הצג חלון"]</BzAlertDialogTrigger>
            <BzAlertDialogContent>
                <BzAlertDialogHeader>
                    <BzAlertDialogTitle>@t["حذف هذا المشروع؟", "למחוק את הפרויקט הזה?"]</BzAlertDialogTitle>
                    <BzAlertDialogDescription>@t["سيُحذف المشروع وملفاته وسجله نهائيًا، ولن يتمكن أحد في الفريق من استعادتها.", "הפרויקט, הקבצים וההיסטוריה שלו יימחקו לצמיתות, ואף אחד בצוות לא יוכל לשחזר אותם."]</BzAlertDialogDescription>
                </BzAlertDialogHeader>
                <BzAlertDialogFooter>
                    <BzAlertDialogCancel>@t["إلغاء", "ביטול"]</BzAlertDialogCancel>
                    <BzAlertDialogAction>@t["حذف المشروع", "מחק פרויקט"]</BzAlertDialogAction>
                </BzAlertDialogFooter>
            </BzAlertDialogContent>
        </BzAlertDialog>
    </BzDirectionProvider>
</RtlDemo>
