<BzAlertDialog>
    <BzAlertDialogTrigger Variant="ButtonVariant.Outline">Show dialog</BzAlertDialogTrigger>
    <BzAlertDialogContent>
        <BzAlertDialogHeader>
            <BzAlertDialogTitle>Delete this project?</BzAlertDialogTitle>
            <BzAlertDialogDescription>The project, its files and its history go for good. Nobody on the team can restore them.</BzAlertDialogDescription>
        </BzAlertDialogHeader>
        <BzAlertDialogFooter>
            <BzAlertDialogCancel>Cancel</BzAlertDialogCancel>
            <BzAlertDialogAction>Delete project</BzAlertDialogAction>
        </BzAlertDialogFooter>
    </BzAlertDialogContent>
</BzAlertDialog>
