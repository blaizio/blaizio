@* The scroll surface ships `scrollbar-thin`. To hand it back to the browser, pass
   `scrollbar-auto` - the class merge drops ours, so nothing is left to fight. Add a class of
   your own next to it (`scrollbar-auto my-bar`) when you want to style the bar yourself. *@
<BzMenubar AriaLabel="Application" Class="rounded-xl border-indigo-200 bg-indigo-50/60 dark:border-indigo-900 dark:bg-indigo-950/50">
    <BzMenubarMenu>
        <BzMenubarTrigger Class="data-[state=open]:bg-indigo-600 data-[state=open]:text-white">File</BzMenubarTrigger>
        <BzMenubarContent Class="scrollbar-auto rounded-xl border-indigo-200 bg-indigo-50 dark:border-indigo-900 dark:bg-indigo-950">
            <BzMenubarItem>New Tab</BzMenubarItem>
            <BzMenubarItem>New Window</BzMenubarItem>
        </BzMenubarContent>
    </BzMenubarMenu>
    <BzMenubarMenu>
        <BzMenubarTrigger Class="data-[state=open]:bg-indigo-600 data-[state=open]:text-white">Edit</BzMenubarTrigger>
        <BzMenubarContent Class="scrollbar-auto rounded-xl border-indigo-200 bg-indigo-50 dark:border-indigo-900 dark:bg-indigo-950">
            <BzMenubarItem>Undo</BzMenubarItem>
            <BzMenubarItem>Redo</BzMenubarItem>
        </BzMenubarContent>
    </BzMenubarMenu>
</BzMenubar>
