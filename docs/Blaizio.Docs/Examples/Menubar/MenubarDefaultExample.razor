<BzMenubar>
    <BzMenubarMenu>
        <BzMenubarTrigger>File</BzMenubarTrigger>
        <BzMenubarContent>
            <BzMenubarItem>New Tab <BzMenubarShortcut>⌘T</BzMenubarShortcut></BzMenubarItem>
            <BzMenubarItem>New Window <BzMenubarShortcut>⌘N</BzMenubarShortcut></BzMenubarItem>
            <BzMenubarItem Disabled>New Incognito Window</BzMenubarItem>
            <BzMenubarSeparator />
            <BzMenubarSub>
                <BzMenubarSubTrigger>Share</BzMenubarSubTrigger>
                <BzMenubarSubContent>
                    <BzMenubarItem>Email link</BzMenubarItem>
                    <BzMenubarItem>Messages</BzMenubarItem>
                    <BzMenubarItem>Notes</BzMenubarItem>
                </BzMenubarSubContent>
            </BzMenubarSub>
            <BzMenubarSeparator />
            <BzMenubarItem>Print <BzMenubarShortcut>⌘P</BzMenubarShortcut></BzMenubarItem>
        </BzMenubarContent>
    </BzMenubarMenu>
    <BzMenubarMenu>
        <BzMenubarTrigger>Edit</BzMenubarTrigger>
        <BzMenubarContent>
            <BzMenubarItem>Undo <BzMenubarShortcut>⌘Z</BzMenubarShortcut></BzMenubarItem>
            <BzMenubarItem>Redo <BzMenubarShortcut>⇧⌘Z</BzMenubarShortcut></BzMenubarItem>
            <BzMenubarSeparator />
            <BzMenubarSub>
                <BzMenubarSubTrigger>Find</BzMenubarSubTrigger>
                <BzMenubarSubContent>
                    <BzMenubarItem>Search the web</BzMenubarItem>
                    <BzMenubarSeparator />
                    <BzMenubarItem>Find</BzMenubarItem>
                    <BzMenubarItem>Find Next</BzMenubarItem>
                    <BzMenubarItem>Find Previous</BzMenubarItem>
                </BzMenubarSubContent>
            </BzMenubarSub>
            <BzMenubarSeparator />
            <BzMenubarItem>Cut</BzMenubarItem>
            <BzMenubarItem>Copy</BzMenubarItem>
            <BzMenubarItem>Paste</BzMenubarItem>
        </BzMenubarContent>
    </BzMenubarMenu>
    <BzMenubarMenu>
        <BzMenubarTrigger>View</BzMenubarTrigger>
        <BzMenubarContent>
            <BzMenubarCheckboxItem @bind-Checked="_bookmarks" OnSelect="KeepOpen">Always Show Bookmarks Bar</BzMenubarCheckboxItem>
            <BzMenubarCheckboxItem @bind-Checked="_fullUrls" OnSelect="KeepOpen">Always Show Full URLs</BzMenubarCheckboxItem>
            <BzMenubarSeparator />
            <BzMenubarItem>Reload <BzMenubarShortcut>⌘R</BzMenubarShortcut></BzMenubarItem>
            <BzMenubarItem Disabled>Force Reload <BzMenubarShortcut>⇧⌘R</BzMenubarShortcut></BzMenubarItem>
            <BzMenubarSeparator />
            <BzMenubarItem>Toggle Fullscreen</BzMenubarItem>
        </BzMenubarContent>
    </BzMenubarMenu>
    <BzMenubarMenu>
        <BzMenubarTrigger>Profiles</BzMenubarTrigger>
        <BzMenubarContent>
            <BzMenubarRadioGroup @bind-Value="_profile">
                <BzMenubarRadioItem Value="jane">Jane Doe</BzMenubarRadioItem>
                <BzMenubarRadioItem Value="john">John Smith</BzMenubarRadioItem>
                <BzMenubarRadioItem Value="alex">Alex Park</BzMenubarRadioItem>
            </BzMenubarRadioGroup>
            <BzMenubarSeparator />
            <BzMenubarItem>Edit</BzMenubarItem>
            <BzMenubarItem>Add Profile</BzMenubarItem>
        </BzMenubarContent>
    </BzMenubarMenu>
</BzMenubar>

@code {
    private bool _bookmarks = true;
    private bool _fullUrls;
    private string _profile = "jane";

    // Toggling a checkbox item keeps the menu open (PreventDefault), so several can be flipped at once.
    private static void KeepOpen(MenuSelectEventArgs e) => e.PreventDefault();
}
