<BzMenubar>
    <BzMenubarMenu>
        <BzMenubarTrigger>Account</BzMenubarTrigger>
        <BzMenubarContent>
            <BzMenubarItem>
                <RenderAs Context="p">
                    <a href="/account" @attributes="p.Attributes">Profile</a>
                </RenderAs>
            </BzMenubarItem>
            <BzMenubarItem>
                <RenderAs Context="p">
                    <a href="/settings" @attributes="p.Attributes">Settings</a>
                </RenderAs>
            </BzMenubarItem>
            <BzMenubarSeparator />
            <BzMenubarItem>Log out</BzMenubarItem>
        </BzMenubarContent>
    </BzMenubarMenu>
    <BzMenubarMenu>
        <BzMenubarTrigger>Help</BzMenubarTrigger>
        <BzMenubarContent>
            <BzMenubarItem>
                <RenderAs Context="p">
                    <a href="/docs" @attributes="p.Attributes">Documentation</a>
                </RenderAs>
            </BzMenubarItem>
            <BzMenubarItem>About</BzMenubarItem>
        </BzMenubarContent>
    </BzMenubarMenu>
</BzMenubar>
