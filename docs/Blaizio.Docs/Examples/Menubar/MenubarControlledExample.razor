<div class="flex flex-col items-center gap-4">
    <span class="text-muted-foreground text-sm">Open: @(_open ?? "(none)")</span>
    <BzMenubar AriaLabel="Application" @bind-Value="_open">
        <BzMenubarMenu Value="file">
            <BzMenubarTrigger>File</BzMenubarTrigger>
            <BzMenubarContent>
                <BzMenubarItem>New Tab</BzMenubarItem>
                <BzMenubarItem>New Window</BzMenubarItem>
            </BzMenubarContent>
        </BzMenubarMenu>
        <BzMenubarMenu Value="edit">
            <BzMenubarTrigger>Edit</BzMenubarTrigger>
            <BzMenubarContent>
                <BzMenubarItem>Undo</BzMenubarItem>
                <BzMenubarItem>Redo</BzMenubarItem>
            </BzMenubarContent>
        </BzMenubarMenu>
    </BzMenubar>
</div>

@code {
    private string? _open;
}
