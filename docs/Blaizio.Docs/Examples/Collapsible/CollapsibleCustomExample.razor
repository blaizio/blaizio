@* The trigger is your own Button, so style it directly; the content rows take a tinted border. *@
<BzCollapsible Class="flex w-full max-w-sm flex-col gap-2">
    <BzCollapsibleTrigger>
        <RenderAs Context="p">
            <BzButton Class="w-full justify-between rounded-full bg-indigo-600 text-white hover:bg-indigo-600/90" @attributes="p.Attributes">
                Release notes
                <BzIcon Icon="@Icons.Outline.Selector" />
            </BzButton>
        </RenderAs>
    </BzCollapsibleTrigger>
    <BzCollapsibleContent Class="flex flex-col gap-2">
        <div class="rounded-md border border-indigo-600/40 px-4 py-2 text-sm">Added two-way binding</div>
        <div class="rounded-md border border-indigo-600/40 px-4 py-2 text-sm">Fixed the open animation</div>
    </BzCollapsibleContent>
</BzCollapsible>
