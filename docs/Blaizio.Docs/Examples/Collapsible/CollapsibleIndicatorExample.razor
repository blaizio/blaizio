<BzCollapsible Class="w-full max-w-sm">
    <BzCollapsibleTrigger>
        <RenderAs Context="p">
            <BzButton Variant="ButtonVariant.Outline" Class="group/collapsible w-full justify-between" @attributes="p.Attributes">
                Show details
                <BzIcon Icon="@Tabler.Outline.ChevronDown" Class="size-4 shrink-0 group-aria-expanded/collapsible:hidden" />
                <BzIcon Icon="@Tabler.Outline.ChevronUp" Class="hidden size-4 shrink-0 group-aria-expanded/collapsible:inline" />
            </BzButton>
        </RenderAs>
    </BzCollapsibleTrigger>
    <BzCollapsibleContent>
        <p class="mt-2 rounded-md border px-4 py-3 text-sm text-muted-foreground">
            The up/down chevron swaps when the panel opens, driven by the trigger's expanded state.
        </p>
    </BzCollapsibleContent>
</BzCollapsible>
