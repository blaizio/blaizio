<BzCollapsible Disabled="true" Class="flex w-full max-w-sm flex-col gap-2">
    <div class="flex items-center justify-between gap-4">
        <h4 class="text-sm font-semibold">Locked section</h4>
        <BzCollapsibleTrigger>
            <RenderAs Context="p">
                <BzButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" aria-label="Toggle" Disabled="true" @attributes="p.Attributes">
                    <BzIcon Icon="@Tabler.Outline.Selector" />
                </BzButton>
            </RenderAs>
        </BzCollapsibleTrigger>
    </div>
    <div class="rounded-md border px-4 py-2 font-mono text-sm">Always visible</div>
    <BzCollapsibleContent Class="flex flex-col gap-2">
        <div class="rounded-md border px-4 py-2 font-mono text-sm">Hidden while disabled</div>
    </BzCollapsibleContent>
</BzCollapsible>
