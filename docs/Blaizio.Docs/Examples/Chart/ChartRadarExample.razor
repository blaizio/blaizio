<BzRadarChart Data="Skills" Label="d => d.Area" Class="max-w-sm">
    <BzRadarSeries Name="This year" Value="d => d.Current" />
    <BzRadarSeries Name="Last year" Value="d => d.Previous" />
    <BzChartTooltip />
    <BzChartLegend />
</BzRadarChart>

@code {
    private sealed record Point(string Area, double Current, double Previous);

    private static readonly Point[] Skills =
    [
        new("Speed", 86, 70), new("Reliability", 92, 84), new("Comfort", 68, 74),
        new("Safety", 95, 88), new("Efficiency", 78, 60), new("Style", 82, 79),
    ];
}
