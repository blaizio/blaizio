<BzChart Data="Visits" Label="d => d.Month" Class="max-w-xl">
    <BzChartGrid />
    <BzChartXAxis />
    <BzChartTooltip />
    <BzChartBarSeries Name="Desktop" Value="d => d.Desktop" />
</BzChart>

@code {
    private sealed record Point(string Month, double Desktop);

    private static readonly Point[] Visits =
    [
        new("Jan", 186), new("Feb", 305), new("Mar", 237),
        new("Apr", 73), new("May", 209), new("Jun", 214),
    ];
}
