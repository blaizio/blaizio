<BzPieChart Data="Devices" Label="d => d.Name" Value="d => d.Users" InnerRadius="0.62" Class="max-w-xs">
    <ChildContent>
        <BzChartTooltip />
        <BzChartLegend />
    </ChildContent>
    <CenterContent>
        <span class="text-2xl font-bold tabular-nums">@Devices.Sum(d => d.Users).ToString("N0")</span>
        <span class="text-muted-foreground">Users</span>
    </CenterContent>
</BzPieChart>

@code {
    private sealed record Slice(string Name, double Users);

    private static readonly Slice[] Devices =
    [
        new("Desktop", 275), new("Mobile", 200), new("Tablet", 187),
        new("Smart TV", 173), new("Other", 90),
    ];
}
