<BzDirectionProvider Direction="Direction.Rtl">
    <BzChart Data="Sales" Label="d => d.Month" Class="max-w-xl">
        <BzChartGrid />
        <BzChartXAxis />
        <BzChartYAxis />
        <BzChartTooltip />
        <BzChartLegend />
        <BzChartBarSeries Name="المتجر" Value="d => d.Store" />
        <BzChartLineSeries Name="الهدف" Value="d => d.Target" Color="var(--chart-4)" Curved />
    </BzChart>
</BzDirectionProvider>

@code {
    private sealed record Point(string Month, double Store, double Target);

    private static readonly Point[] Sales =
    [
        new("يناير", 4200, 4000), new("فبراير", 3800, 4200), new("مارس", 5100, 4400),
        new("أبريل", 4600, 4600), new("مايو", 5900, 4800), new("يونيو", 6400, 5000),
    ];
}
