<BzChart Data="Traffic" Label="d => d.Month" Stacked Class="max-w-xl">
    <BzChartGrid />
    <BzChartXAxis />
    <BzChartTooltip />
    <BzChartLegend />
    <BzChartAreaSeries Name="Organic" Value="d => d.Organic" Curved />
    <BzChartAreaSeries Name="Referral" Value="d => d.Referral" Curved />
</BzChart>

@code {
    private sealed record Point(string Month, double Organic, double Referral);

    private static readonly Point[] Traffic =
    [
        new("Jan", 2100, 900), new("Feb", 2600, 1100), new("Mar", 2400, 1300),
        new("Apr", 3100, 1200), new("May", 3600, 1700), new("Jun", 3300, 1900),
    ];
}
