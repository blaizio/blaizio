<BzChart Data="Visits" Label="d => d.Month" Class="max-w-xl">
    <BzChartGrid />
    <BzChartXAxis />
    <BzChartYAxis />
    <BzChartTooltip />
    <BzChartLegend />
    <BzChartBarSeries Name="Desktop" Value="d => d.Desktop" />
    <BzChartBarSeries Name="Mobile" Value="d => d.Mobile" />
</BzChart>

@code {
    private sealed record Point(string Month, double Desktop, double Mobile);

    private static readonly Point[] Visits =
    [
        new("Jan", 186, 80), new("Feb", 305, 200), new("Mar", 237, 120),
        new("Apr", 73, 190), new("May", 209, 130), new("Jun", 214, 140),
    ];
}
