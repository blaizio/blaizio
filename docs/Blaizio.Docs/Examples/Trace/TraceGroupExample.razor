@* Rows that sit next to each other go in one BzTrace: plain lines, rows that expand, and links
   share one rhythm and one focus treatment. *@
<div class="w-full max-w-md">
    <BzTrace>
        <BzTraceLine>
            <BzTraceIcon>
                <BzIcon Icon="@Tabler.Outline.Search" />
            </BzTraceIcon>
            <BzTraceTitle>Searched for CheckoutAsync</BzTraceTitle>
            <BzTraceDescription>3 results</BzTraceDescription>
        </BzTraceLine>
        <BzTraceCollapsible>
            <BzTraceCollapsibleTrigger>
                <BzTraceLine>
                    <BzTraceIcon>
                        <BzIcon Icon="@Tabler.Outline.FileText" />
                    </BzTraceIcon>
                    <BzTraceTitle>Read CheckoutPage.razor</BzTraceTitle>
                </BzTraceLine>
            </BzTraceCollapsibleTrigger>
            <BzTraceCollapsibleContent>
                The page calls CheckoutAsync from its submit handler and awaits the payment gateway
                before showing the confirmation.
            </BzTraceCollapsibleContent>
        </BzTraceCollapsible>
        <a href="#" @onclick:preventDefault>
            <BzTraceLine>
                <BzTraceIcon>
                    <BzIcon Icon="@Tabler.Outline.Bug" />
                </BzTraceIcon>
                <BzTraceTitle>Opened issue 418: double charge on retry</BzTraceTitle>
                <BzTraceIcon>
                    <BzIcon Icon="@Tabler.Outline.ChevronRight" Class="rtl:-scale-x-100" />
                </BzTraceIcon>
            </BzTraceLine>
        </a>
    </BzTrace>
</div>
