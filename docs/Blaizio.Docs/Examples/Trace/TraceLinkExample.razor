@* Wrap the line in an anchor and it takes the link's keyboard and focus behaviour. A link that opens
   a new tab gets an arrow and says so to screen readers. *@
<div class="w-full max-w-md">
    <BzTrace>
        <a href="https://learn.microsoft.com/aspnet/core/blazor/components/render-modes" target="_blank" rel="noreferrer">
            <BzTraceLine>
                <BzTraceIcon>
                    <BzIcon Icon="@Tabler.Outline.Book" />
                </BzTraceIcon>
                <BzTraceTitle>
                    Read about Blazor render modes
                    <span class="sr-only"> (opens in a new tab)</span>
                </BzTraceTitle>
                <BzTraceIcon>
                    <BzIcon Icon="@Tabler.Outline.ArrowUpRight" />
                </BzTraceIcon>
            </BzTraceLine>
        </a>
    </BzTrace>
</div>
