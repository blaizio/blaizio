@* In a right-to-left page the icons lead from the right, the rail sits under them, and the chevron
   of a closed row points along the reading direction. *@
<RtlDemo Context="t">
    <BzDirectionProvider Dir="Direction.Rtl">
        <div class="w-full max-w-md">
            <BzTrace>
                <BzTraceLine>
                    <BzTraceStatusIcon />
                    <BzTraceTitle>@t["تم تشغيل dotnet restore", "הורץ dotnet restore"]</BzTraceTitle>
                </BzTraceLine>
                <BzTraceCollapsible DefaultOpen>
                    <BzTraceCollapsibleTrigger>
                        <BzTraceLine>
                            <BzTraceIcon>
                                <BzIcon Icon="@Tabler.Outline.Search" />
                            </BzTraceIcon>
                            <BzTraceTitle>@t["تم البحث عن ملفات الإعداد", "בוצע חיפוש אחר קובצי ההגדרות"]</BzTraceTitle>
                            <BzTraceDescription>@t["3 نتائج", "3 תוצאות"]</BzTraceDescription>
                        </BzTraceLine>
                    </BzTraceCollapsibleTrigger>
                    <BzTraceCollapsibleContent>
                        @t["وُجد appsettings.json وملفان للبيئات.", "נמצאו appsettings.json ושני קובצי סביבה."]
                    </BzTraceCollapsibleContent>
                </BzTraceCollapsible>
                <BzTraceCollapsible>
                    <BzTraceCollapsibleTrigger>
                        <BzTraceLine Status="TraceStatus.Running">
                            <BzTraceStatusIcon />
                            <BzTraceTitle>@t["جارٍ تشغيل الاختبارات", "מריץ את הבדיקות"]</BzTraceTitle>
                        </BzTraceLine>
                    </BzTraceCollapsibleTrigger>
                    <BzTraceCollapsibleContent>
                        <BzCodeBlock Size="CodeBlockSize.Sm">
                            <BzCodeBlockContent Code="dotnet test --no-build" Language="bash" />
                        </BzCodeBlock>
                    </BzTraceCollapsibleContent>
                </BzTraceCollapsible>
            </BzTrace>
        </div>
    </BzDirectionProvider>
</RtlDemo>
