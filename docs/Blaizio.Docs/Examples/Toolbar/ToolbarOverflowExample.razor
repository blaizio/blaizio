@* The same overloaded bar under each policy, one tab per policy. Wrap flows onto more rows;
   Scroll pages one row with chevrons (flip their placement below); Expand clips to one row
   behind a toggle. Neither the chevrons nor the toggle show until the controls overflow - the
   bar is deliberately overloaded so they do. The Insert menu up front shows Expand staying put
   for the pointer: opening it does not unfold the bar. Keyboard never needs the extra buttons: arrow travel scrolls or
   opens as it goes. *@
<BzTabs DefaultValue="scroll" Class="w-full">
    <BzTabsList AriaLabel="Overflow policy">
        <BzTabsTrigger Value="wrap">Wrap</BzTabsTrigger>
        <BzTabsTrigger Value="scroll">Scroll</BzTabsTrigger>
        <BzTabsTrigger Value="expand">Expand</BzTabsTrigger>
    </BzTabsList>

    @* Panels render only while selected, so each switch mounts a fresh bar: the scroller
       attaches on first render, and Wrap/Expand need it gone again. *@
    <BzTabsContent Value="wrap" Class="pt-4">
        @Bar(ToolbarOverflow.Wrap)
    </BzTabsContent>
    <BzTabsContent Value="scroll" Class="space-y-4 pt-4">
        <BzToggleGroup Value="@_buttons" ValueChanged="OnButtonsChanged" Variant="ToggleVariant.Outline" Size="ToggleSize.Sm">
            <BzToggleGroupItem Value="split">Split chevrons</BzToggleGroupItem>
            <BzToggleGroupItem Value="end">Chevrons at the end</BzToggleGroupItem>
        </BzToggleGroup>
        @Bar(ToolbarOverflow.Scroll)
    </BzTabsContent>
    <BzTabsContent Value="expand" Class="space-y-4 pt-4">
        @* The expanded state is bindable, so anything outside the bar can open it: here a plain
           button, and the bar's own toggle keeps the field in step. *@
        <div class="flex flex-wrap items-center gap-2">
            <BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="@(() => _expanded = !_expanded)">
                @(_expanded ? "Collapse" : "Expand") from code
            </BzButton>
            @* Contextual controls that appear mid-session: Pin jumps to the visible row, Expand
               holds the bar open for as long as the control renders on a clipped row. *@
            <BzButton Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="@(() => _contextual = !_contextual)">
                @(_contextual ? "Hide" : "Show") contextual buttons
            </BzButton>
        </div>
        @Bar(ToolbarOverflow.Expand)
    </BzTabsContent>
</BzTabs>

@code {
    private string _buttons = "split";
    private bool _expanded;
    private bool _contextual;

    private ToolbarScrollButtons SelectedButtons =>
        _buttons == "end" ? ToolbarScrollButtons.End : ToolbarScrollButtons.Split;

    // Single-select toggle groups can deselect; keep the last pick rather than showing nothing.
    private void OnButtonsChanged(string? value)
    {
        if (value is not null) _buttons = value;
    }

    // Keyed on the chevron placement so flipping it remounts the bar and re-attaches the scroller.
    private RenderFragment Bar(ToolbarOverflow overflow) =>
        @<BzToolbar @key="@_buttons"
                    Overflow="@overflow"
                    @bind-Expanded="_expanded"
                    ScrollButtons="@SelectedButtons"
                    Class="w-full max-w-lg"
                    aria-label="Formatting">
            <BzDropdownMenu>
                <BzDropdownMenuTrigger>
                    <RenderAs Context="p">
                        <BzButton data-bz-roving-item Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost"
                                  Class="shrink-0 px-2" @attributes="p.Attributes">
                            Insert
                            <BzIcon Icon="@Icons.Outline.ChevronDown" Class="size-4" />
                        </BzButton>
                    </RenderAs>
                </BzDropdownMenuTrigger>
                <BzDropdownMenuContent>
                    <BzDropdownMenuItem>Image</BzDropdownMenuItem>
                    <BzDropdownMenuItem>Table</BzDropdownMenuItem>
                    <BzDropdownMenuItem>Link</BzDropdownMenuItem>
                </BzDropdownMenuContent>
            </BzDropdownMenu>
            <BzToolbarSeparator />
            @* A select keeps its CLOSED content in the bar as a display:none fixed child - the
               overflow measurement must ignore out-of-flow children or a fitting bar reads as
               wrapped (the regression this select guards). *@
            <BzSelect DefaultValue="paragraph">
                <BzSelectTrigger AriaLabel="Block format" Class="h-8 w-32 shrink-0">
                    <BzSelectValue />
                </BzSelectTrigger>
                <BzSelectContent>
                    <BzSelectItem Value="paragraph">Paragraph</BzSelectItem>
                    <BzSelectItem Value="heading">Heading</BzSelectItem>
                    <BzSelectItem Value="quote">Quote</BzSelectItem>
                </BzSelectContent>
            </BzSelect>
            <BzToolbarSeparator />
            <BzToggleGroup SelectionMode="SelectionMode.Multiple" Spacing="1">
                <BzToggleGroupItem Value="bold" aria-label="Toggle bold"><BzIcon Icon="@Icons.Outline.Bold" /></BzToggleGroupItem>
                <BzToggleGroupItem Value="italic" aria-label="Toggle italic"><BzIcon Icon="@Icons.Outline.Italic" /></BzToggleGroupItem>
                <BzToggleGroupItem Value="underline" aria-label="Toggle underline"><BzIcon Icon="@Icons.Outline.Underline" /></BzToggleGroupItem>
                <BzToggleGroupItem Value="strike" aria-label="Toggle strikethrough"><BzIcon Icon="@Icons.Outline.Strikethrough" /></BzToggleGroupItem>
            </BzToggleGroup>
            <BzToolbarSeparator />
            <BzToggleGroup DefaultValue="left" Spacing="1">
                <BzToggleGroupItem Value="left" aria-label="Align left"><BzIcon Icon="@Icons.Outline.AlignLeft" /></BzToggleGroupItem>
                <BzToggleGroupItem Value="center" aria-label="Align center"><BzIcon Icon="@Icons.Outline.AlignCenter" /></BzToggleGroupItem>
                <BzToggleGroupItem Value="right" aria-label="Align right"><BzIcon Icon="@Icons.Outline.AlignRight" /></BzToggleGroupItem>
            </BzToggleGroup>
            <BzToolbarSeparator />
            <BzToolbarButton aria-label="Undo"><BzIcon Icon="@Icons.Outline.ArrowBackUp" /></BzToolbarButton>
            <BzToolbarButton aria-label="Redo"><BzIcon Icon="@Icons.Outline.ArrowForwardUp" /></BzToolbarButton>
            <BzToolbarButton aria-label="Copy"><BzIcon Icon="@Icons.Outline.Copy" /></BzToolbarButton>
            <BzToolbarButton aria-label="Paste"><BzIcon Icon="@Icons.Outline.Clipboard" /></BzToolbarButton>
            <BzToolbarSeparator />
            <BzToolbarButton Class="px-2">Comment</BzToolbarButton>
            <BzToolbarButton Class="px-2">Share</BzToolbarButton>
            @if (_contextual && overflow == ToolbarOverflow.Expand)
            {
                <BzToolbarButton Reveal="ToolbarReveal.Pin" Variant="ToggleVariant.Outline" Class="px-2">
                    <BzIcon Icon="@Icons.Outline.Sparkles" /> Suggest
                </BzToolbarButton>
                <BzToolbarButton Reveal="ToolbarReveal.Expand" Variant="ToggleVariant.Outline" Class="px-2">
                    <BzIcon Icon="@Icons.Outline.Check" /> Resolve
                </BzToolbarButton>
            }
        </BzToolbar>;
}
