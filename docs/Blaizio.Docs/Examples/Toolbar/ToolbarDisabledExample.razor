@* Disabled at three scopes: one control, one group, or the whole bar. The default is the native
   attribute - no hover, no focus, skipped by the arrows, exactly what disabled means everywhere
   else. Redo opts into FocusableWhenDisabled: it keeps its place in the arrow order and announces
   aria-disabled, so a keyboard or screen-reader user can still discover WHY it is off - but takes
   no hover and swallows clicks. *@
<div class="space-y-3">
    <BzToolbar Disabled="@_all" aria-label="Editing">
        <BzToolbarButton aria-label="Undo"><BzIcon Icon="@Tabler.Outline.ArrowBackUp" /></BzToolbarButton>
        <BzToolbarButton Disabled FocusableWhenDisabled aria-label="Redo (nothing to redo)"><BzIcon Icon="@Tabler.Outline.ArrowForwardUp" /></BzToolbarButton>
        <BzToolbarSeparator />
        <BzToolbarGroup Disabled="@_clipboard" aria-label="Clipboard">
            <BzToolbarButton aria-label="Copy"><BzIcon Icon="@Tabler.Outline.Copy" /></BzToolbarButton>
            <BzToolbarButton aria-label="Paste"><BzIcon Icon="@Tabler.Outline.Clipboard" /></BzToolbarButton>
        </BzToolbarGroup>
        <BzToolbarSeparator />
        <BzToolbarButton Disabled aria-label="Delete"><BzIcon Icon="@Tabler.Outline.Trash" /></BzToolbarButton>
    </BzToolbar>

    <div class="flex items-center gap-6">
        <BzLabel Class="flex items-center gap-2 text-sm">
            <BzSwitch @bind-Checked="_clipboard" /> Disable the clipboard group
        </BzLabel>
        <BzLabel Class="flex items-center gap-2 text-sm">
            <BzSwitch @bind-Checked="_all" /> Disable the whole bar
        </BzLabel>
    </div>
</div>

@code {
    private bool _clipboard = true;
    private bool _all;
}
