@* Orientation flips the layout AND the arrow axis: Up/Down travel the bar, separators run across
   it automatically. *@
<BzToolbar Orientation="Orientation.Vertical" aria-label="Canvas tools">
    <BzToggleGroup Orientation="Orientation.Vertical" DefaultValue="draw" Spacing="1">
        <BzToggleGroupItem Value="draw" aria-label="Draw"><BzIcon Icon="@Tabler.Outline.Pencil" /></BzToggleGroupItem>
        <BzToggleGroupItem Value="erase" aria-label="Erase"><BzIcon Icon="@Tabler.Outline.Eraser" /></BzToggleGroupItem>
    </BzToggleGroup>
    <BzToolbarSeparator />
    <BzToolbarButton aria-label="Copy"><BzIcon Icon="@Tabler.Outline.Copy" /></BzToolbarButton>
    <BzToolbarButton aria-label="Delete"><BzIcon Icon="@Tabler.Outline.Trash" /></BzToolbarButton>
</BzToolbar>
