<RtlDemo Context="t">
    <BzDirectionProvider Dir="Direction.Rtl">
        <BzToolbar aria-label='@t["تنسيق النص", "עיצוב טקסט"]'>
            <BzToggleGroup DefaultValue="right" Spacing="1">
                <BzToggleGroupItem Value="right" aria-label='@t["محاذاة لليمين", "יישור לימין"]'><BzIcon Icon="@Tabler.Outline.AlignRight" /></BzToggleGroupItem>
                <BzToggleGroupItem Value="center" aria-label='@t["محاذاة للوسط", "יישור למרכז"]'><BzIcon Icon="@Tabler.Outline.AlignCenter" /></BzToggleGroupItem>
                <BzToggleGroupItem Value="left" aria-label='@t["محاذاة لليسار", "יישור לשמאל"]'><BzIcon Icon="@Tabler.Outline.AlignLeft" /></BzToggleGroupItem>
            </BzToggleGroup>
            <BzToolbarSeparator />
            <BzToolbarButton aria-label='@t["تراجع", "ביטול"]'><BzIcon Icon="@Tabler.Outline.ArrowForwardUp" /></BzToolbarButton>
            <BzToolbarButton aria-label='@t["إعادة", "ביצוע מחדש"]'><BzIcon Icon="@Tabler.Outline.ArrowBackUp" /></BzToolbarButton>
        </BzToolbar>
    </BzDirectionProvider>
</RtlDemo>
