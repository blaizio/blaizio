@* The bar is one surface and every part takes Class: here a pill - rounded-full frame on the
   muted background, matching round buttons, an outline variant for the call-to-action, and a
   taller separator to anchor the cluster. *@
<BzToolbar aria-label="Player" Class="rounded-full bg-muted/50 px-2 py-1.5 shadow-md">
    <BzToolbarButton aria-label="Previous" Class="rounded-full"><BzIcon Icon="@Tabler.Outline.PlayerSkipBack" /></BzToolbarButton>
    <BzToolbarButton aria-label="@(_playing ? "Pause" : "Play")"
                     OnClick="@(() => _playing = !_playing)"
                     Class="rounded-full bg-primary text-primary-foreground hover:bg-primary/90 hover:text-primary-foreground">
        <BzIcon Icon="@(_playing ? Tabler.Outline.PlayerPause : Tabler.Outline.PlayerPlay)" />
    </BzToolbarButton>
    <BzToolbarButton aria-label="Next" Class="rounded-full"><BzIcon Icon="@Tabler.Outline.PlayerSkipForward" /></BzToolbarButton>
    <BzToolbarSeparator Class="data-vertical:h-6" />
    <BzToolbarButton Variant="ToggleVariant.Outline" Class="rounded-full px-3 text-xs">1.5x</BzToolbarButton>
</BzToolbar>

@code {
    private bool _playing;
}
