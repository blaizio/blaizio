<RtlDemo Context="t">
    <div class="w-full max-w-sm">
        <BzTree TItem="TreeItem"
                Items="_items"
                ValueSelector="@(n => n.Id)"
                TextSelector="@(n => t[n.Ar, n.He])"
                ChildrenSelector="@(n => n.Children)"
                Dir="Direction.Rtl"
                Guides="TreeGuides.Connectors"
                DefaultExpandedValues="@(new[] { "docs-ar", "reports-ar", "pics-ar" })"
                AriaLabel='@t["شجرة الملفات", "עץ הקבצים"]'>
            <NodeContent Context="state">
                <BzIcon Icon="@ItemIcon(state)" Class="text-muted-foreground size-4 shrink-0" />
                <span class="truncate">@state.Text</span>
            </NodeContent>
        </BzTree>
    </div>
</RtlDemo>

@code {
    private sealed class TreeItem
    {
        public required string Id { get; init; }
        public required string Ar { get; set; }
        public required string He { get; set; }
        public List<TreeItem>? Children { get; set; } // null = leaf
    }

    private static TreeItem File(string id, string ar, string he) => new() { Id = id, Ar = ar, He = he };

    private static TreeItem Folder(string id, string ar, string he, params TreeItem[] children) =>
        new() { Id = id, Ar = ar, He = he, Children = [.. children] };

    private readonly List<TreeItem> _items =
    [
        Folder("docs-ar", "المستندات", "מסמכים",
            Folder("reports-ar", "التقارير", "דוחות",
                File("annual-ar", "التقرير السنوي.pdf", "הדוח השנתי.pdf"),
                File("q1-ar", "تقرير الربع الأول.xlsx", "דוח הרבעון הראשון.xlsx")),
            File("budget-ar", "الميزانية.xlsx", "התקציב.xlsx"),
            File("contract-ar", "العقد.docx", "החוזה.docx")),
        Folder("pics-ar", "الصور", "תמונות",
            File("trip-ar", "الرحلة.png", "הטיול.png"),
            File("family-ar", "العائلة.jpg", "המשפחה.jpg")),
        Folder("music-ar", "الموسيقى", "מוזיקה", File("oud-ar", "عزف عود.mp3", "נגינת עוד.mp3")),
        File("notes-ar", "ملاحظات.md", "הערות.md"),
    ];

    private static Icon ItemIcon(TreeNodeState<TreeItem> state) =>
        state.IsBranch ? (state.Expanded ? Tabler.Outline.FolderOpen : Tabler.Outline.Folder)
        : state.Text.EndsWith(".pdf") || state.Text.EndsWith(".docx") ? Tabler.Outline.FileText
        : state.Text.EndsWith(".xlsx") ? Tabler.Outline.FileSpreadsheet
        : state.Text.EndsWith(".png") || state.Text.EndsWith(".jpg") ? Tabler.Outline.Photo
        : state.Text.EndsWith(".mp3") ? Tabler.Outline.FileMusic
        : Tabler.Outline.File;
}
