@* Checked state (like selection/expansion) is data, not DOM - it persists through filtering. *@
<div class="w-full max-w-sm space-y-3">
    <BzTree TItem="TreeItem"
            Items="_explorer"
            ValueSelector="@(n => n.Id)"
            TextSelector="@(n => n.Name)"
            ChildrenSelector="@(n => n.Children)"
            Searchable="true"
            SearchPlaceholder="Search files…"
            Checkable="true"
            DefaultExpandedValues="@(new[] { "src" })"
            @bind-CheckedValues="_checked" />
    <p class="text-muted-foreground text-xs">Checked: @(_checked.Count == 0 ? "nothing" : string.Join(", ", _checked.Order()))</p>
</div>

@code {
    private sealed class TreeItem
    {
        public required string Id { get; init; }
        public required string Name { get; set; }
        public List<TreeItem>? Children { get; set; } // null = leaf
    }

    private static TreeItem File(string id, string name) => new() { Id = id, Name = name };

    private static TreeItem Folder(string id, string name, params TreeItem[] children) =>
        new() { Id = id, Name = name, Children = [.. children] };

    private readonly List<TreeItem> _explorer =
    [
        Folder("src", "src",
            Folder("components", "components", File("button", "Button.razor"), File("tree", "Tree.razor")),
            File("app", "App.razor"),
            File("program", "Program.cs")),
        Folder("docs", "docs", File("readme", "README.md"), File("changelog", "CHANGELOG.md")),
        File("license", "LICENSE"),
    ];

    private IReadOnlyList<string> _checked = ["program", "readme"];

    // Or drive the term yourself: @bind-SearchTerm="_query", and a custom matcher:
    // SearchMatch="@((node, term) => node.Name.Contains(term, StringComparison.OrdinalIgnoreCase))"
}
