<div class="flex min-h-[320px] justify-center">
    <BzNavigationMenu>
        <BzNavigationMenuList>
            <BzNavigationMenuItem>
                <BzNavigationMenuTrigger>Getting started</BzNavigationMenuTrigger>
                <BzNavigationMenuContent>
                    <ul class="grid gap-2 md:w-[420px] lg:w-[520px] lg:grid-cols-[.75fr_1fr]">
                        <li class="row-span-3">
                            <BzNavigationMenuLink href="#" Class="from-muted/50 to-muted flex h-full w-full flex-col justify-end rounded-md bg-gradient-to-b p-6 no-underline select-none">
                                <div class="mt-4 mb-2 text-lg font-medium">Blaizio</div>
                                <p class="text-muted-foreground text-sm leading-tight">Components you copy into your Blazor app and own from then on.</p>
                            </BzNavigationMenuLink>
                        </li>
                        @ListItem("Introduction", "What Blaizio is and how the pieces fit together.")
                        @ListItem("Installation", "Install the CLI, then set up a new or existing app.")
                        @ListItem("Theming", "Color, radius and font tokens, plus light and dark mode.")
                    </ul>
                </BzNavigationMenuContent>
            </BzNavigationMenuItem>
            <BzNavigationMenuItem>
                <BzNavigationMenuTrigger>Components</BzNavigationMenuTrigger>
                <BzNavigationMenuContent>
                    <ul class="grid gap-2 sm:w-[400px] md:w-[500px] md:grid-cols-2 lg:w-[600px]">
                        @ListItem("Alert Dialog", "Asks for a decision before a destructive action goes through.")
                        @ListItem("Hover Card", "Shows a preview of a linked item while the pointer rests on it.")
                        @ListItem("Progress", "Tells people how far along a task is.")
                        @ListItem("Scroll Area", "A scroll container whose scrollbar matches your theme.")
                        @ListItem("Tabs", "Switches between related views without leaving the page.")
                        @ListItem("Tooltip", "Names an icon button or adds a short hint on hover or focus.")
                    </ul>
                </BzNavigationMenuContent>
            </BzNavigationMenuItem>
            <BzNavigationMenuItem>
                <BzNavigationMenuLink Class="@NavigationMenuTriggerStyle.Classes" href="#">Docs</BzNavigationMenuLink>
            </BzNavigationMenuItem>
            <BzNavigationMenuItem>
                <BzNavigationMenuTrigger>List</BzNavigationMenuTrigger>
                <BzNavigationMenuContent>
                    <ul class="grid w-[300px] gap-2">
                        @ListItem("Components", "Every component, each with live demos.")
                        @ListItem("Documentation", "Guides for setup, theming and the CLI.")
                        @ListItem("Changelog", "What changed in each release.")
                    </ul>
                </BzNavigationMenuContent>
            </BzNavigationMenuItem>
        </BzNavigationMenuList>
    </BzNavigationMenu>
</div>

@code {
    private RenderFragment ListItem(string title, string description) => @<li>
        <BzNavigationMenuLink href="#">
            <div class="text-sm font-medium leading-none">@title</div>
            <p class="text-muted-foreground line-clamp-2 text-sm leading-snug">@description</p>
        </BzNavigationMenuLink>
    </li>;
}
