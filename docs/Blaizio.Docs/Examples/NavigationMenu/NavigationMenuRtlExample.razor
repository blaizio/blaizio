<RtlDemo Context="t">
    <BzDirectionProvider Direction="Direction.Rtl">
        <div class="flex min-h-[320px] justify-center">
            <BzNavigationMenu>
                <BzNavigationMenuList>
                    <BzNavigationMenuItem>
                        <BzNavigationMenuTrigger>@t["البدء", "תחילת העבודה"]</BzNavigationMenuTrigger>
                        <BzNavigationMenuContent>
                            <ul class="grid gap-2 md:w-[420px] lg:w-[520px] lg:grid-cols-[.75fr_1fr]">
                                <li class="row-span-3">
                                    <BzNavigationMenuLink href="#" Class="from-muted/50 to-muted flex h-full w-full flex-col justify-end rounded-md bg-gradient-to-b p-6 no-underline select-none">
                                        <div class="mt-4 mb-2 text-lg font-medium">@t["بليزو", "בלייזו"]</div>
                                        <p class="text-muted-foreground text-sm leading-tight">@t["مكوّنات مصمّمة بعناية لتطبيقات Blazor.", "רכיבים מעוצבים בקפידה לאפליקציות Blazor."]</p>
                                    </BzNavigationMenuLink>
                                </li>
                                @ListItem(t["مقدمة", "מבוא"], t["مكوّنات قابلة لإعادة الاستخدام مبنية بـ Blazor وTailwind.", "רכיבים לשימוש חוזר שנבנו עם Blazor ו-Tailwind."])
                                @ListItem(t["التثبيت", "התקנה"], t["كيفية تثبيت التبعيات وهيكلة تطبيقك.", "כיצד להתקין את התלויות ולבנות את מבנה האפליקציה."])
                                @ListItem(t["الطباعة", "טיפוגרפיה"], t["أنماط للعناوين والفقرات والقوائم.", "סגנונות לכותרות, פסקאות ורשימות."])
                            </ul>
                        </BzNavigationMenuContent>
                    </BzNavigationMenuItem>
                    <BzNavigationMenuItem>
                        <BzNavigationMenuTrigger>@t["المكوّنات", "רכיבים"]</BzNavigationMenuTrigger>
                        <BzNavigationMenuContent>
                            <ul class="grid gap-2 sm:w-[400px] md:w-[500px] md:grid-cols-2">
                                @ListItem(t["نافذة تنبيه", "חלון התראה"], t["نافذة حوارية تقاطع المستخدم بمحتوى مهم وتنتظر رده.", "חלון דו-שיח שקוטע את המשתמש בתוכן חשוב וממתין לתגובתו."])
                                @ListItem(t["بطاقة تمرير", "כרטיס ריחוף"], t["لمعاينة المحتوى المتاح خلف الرابط.", "לתצוגה מקדימה של התוכן שמאחורי הקישור."])
                                @ListItem(t["شريط التقدّم", "סרגל התקדמות"], t["يعرض مؤشرًا لمدى اكتمال مهمة ما.", "מציג מחוון למידת ההשלמה של משימה."])
                                @ListItem(t["علامات تبويب", "כרטיסיות"], t["أقسام محتوى متراكبة تُعرض واحدة في كل مرة.", "מקטעי תוכן בשכבות המוצגים אחד בכל פעם."])
                            </ul>
                        </BzNavigationMenuContent>
                    </BzNavigationMenuItem>
                    <BzNavigationMenuItem>
                        <BzNavigationMenuLink Class="@NavigationMenuTriggerStyle.Classes" href="#">@t["الوثائق", "תיעוד"]</BzNavigationMenuLink>
                    </BzNavigationMenuItem>
                </BzNavigationMenuList>
            </BzNavigationMenu>
        </div>
    </BzDirectionProvider>
</RtlDemo>

@code {
    private RenderFragment ListItem(string title, string description) => @<li>
        <BzNavigationMenuLink href="#">
            <div class="text-sm font-medium leading-none">@title</div>
            <p class="text-muted-foreground line-clamp-2 text-sm leading-snug">@description</p>
        </BzNavigationMenuLink>
    </li>;
}
