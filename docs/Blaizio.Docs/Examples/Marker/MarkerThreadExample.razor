@* Markers between bubbles: a date separator, then a live status at the end of the thread. *@
<div class="flex w-full max-w-md flex-col gap-4">
    <BzMarker Variant="MarkerVariant.Separator">
        <BzMarkerContent>Today</BzMarkerContent>
    </BzMarker>
    <BzBubble Align="BubbleAlign.End" Tail="true">
        <BzBubbleContent>Can you summarize the review findings?</BzBubbleContent>
    </BzBubble>
    <BzBubble Variant="BubbleVariant.Ghost">
        <BzBubbleContent>Two focus states were too subtle in dark mode; both now use the shared ring treatment.</BzBubbleContent>
    </BzBubble>
    <BzMarker role="status">
        <BzMarkerIcon>
            <BzSpinner />
        </BzMarkerIcon>
        <BzMarkerContent>Drafting the follow-up</BzMarkerContent>
    </BzMarker>
</div>
