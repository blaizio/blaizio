@* role="status" makes assistive technology announce the update; the pulse hints at streaming. *@
<div class="flex w-full max-w-md flex-col gap-3">
    <BzMarker role="status">
        <BzMarkerIcon>
            <BzSpinner />
        </BzMarkerIcon>
        <BzMarkerContent>Compacting conversation</BzMarkerContent>
    </BzMarker>
    <BzMarker role="status">
        <BzMarkerContent Class="motion-safe:animate-pulse">Thinking...</BzMarkerContent>
    </BzMarker>
</div>
