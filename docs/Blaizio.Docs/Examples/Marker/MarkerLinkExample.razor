@* The whole row renders as an anchor via RenderAs; it underlines and brightens on hover. *@
<div class="w-full max-w-md">
    <BzMarker>
        <RenderAs Context="p">
            <a href="docs/components" @attributes="p.Attributes">
                <BzMarkerIcon>
                    <BzIcon Icon="@Tabler.Outline.FolderOpen" />
                </BzMarkerIcon>
                <BzMarkerContent>Explored 4 files</BzMarkerContent>
            </a>
        </RenderAs>
    </BzMarker>
</div>
