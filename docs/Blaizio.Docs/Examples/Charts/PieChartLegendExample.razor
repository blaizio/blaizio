<BzCard Class="w-full">
    <BzCardHeader Class="items-center">
        <BzCardTitle>Pie Chart - Legend</BzCardTitle>
        <BzCardDescription>Slices named below the chart</BzCardDescription>
    </BzCardHeader>
    <BzCardContent>
        <BzPieChart Data="Browsers" Label="d => d.Name" Value="d => d.Users" Size="220">
            <BzChartTooltip />
            <BzChartLegend />
        </BzPieChart>
    </BzCardContent>
</BzCard>

@code {
    private sealed record Slice(string Name, double Users);

    private static readonly Slice[] Browsers =
    [
        new("Chrome", 275), new("Safari", 200), new("Firefox", 187),
        new("Edge", 173), new("Other", 90),
    ];
}
