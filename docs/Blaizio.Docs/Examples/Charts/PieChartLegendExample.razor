<BzCard Class="w-full">
    <BzCardHeader Class="items-center">
        <BzCardTitle>Pie chart - legend</BzCardTitle>
        <BzCardDescription>Slices named below the chart</BzCardDescription>
    </BzCardHeader>
    <BzCardContent>
        <BzPieChart Data="Devices" Label="d => d.Name" Value="d => d.Users" Size="220">
            <BzChartTooltip />
            <BzChartLegend />
        </BzPieChart>
    </BzCardContent>
</BzCard>

@code {
    private sealed record Slice(string Name, double Users);

    private static readonly Slice[] Devices =
    [
        new("Desktop", 275), new("Mobile", 200), new("Tablet", 187),
        new("Smart TV", 173), new("Other", 90),
    ];
}
