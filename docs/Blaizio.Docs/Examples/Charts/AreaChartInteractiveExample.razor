<BzCard Class="w-full">
    <BzCardHeader>
        <BzCardTitle>Area Chart - Interactive</BzCardTitle>
        <BzCardDescription>Showing total visitors for the last @RangeLabel.ToLowerInvariant()</BzCardDescription>
        <BzCardAction>
            <BzSelect @bind-Value="_range">
                <BzSelectTrigger Class="w-40" aria-label="Time range">
                    <BzSelectValue Placeholder="Range" />
                </BzSelectTrigger>
                <BzSelectContent Position="SelectPosition.ItemAligned">
                    <BzSelectItem Value="90">Last 3 months</BzSelectItem>
                    <BzSelectItem Value="30">Last 30 days</BzSelectItem>
                    <BzSelectItem Value="7">Last 7 days</BzSelectItem>
                </BzSelectContent>
            </BzSelect>
        </BzCardAction>
    </BzCardHeader>
    <BzCardContent>
        @* @key remounts the SVG when the range flips, so the draw-in animation plays the transition. *@
        <BzChart Data="Filtered" Label='d => d.Date.ToString("MMM d")' Stacked Height="300" @key="_range">
            <BzChartGrid />
            <BzChartXAxis />
            <BzChartTooltip />
            <BzChartLegend />
            <BzChartAreaSeries Name="Desktop" Value="d => d.Desktop" Curved Gradient />
            <BzChartAreaSeries Name="Mobile" Value="d => d.Mobile" Curved Gradient />
        </BzChart>
    </BzCardContent>
</BzCard>

@code {
    private sealed record Point(DateOnly Date, double Desktop, double Mobile);

    private string? _range = "90";

    private int Days => int.TryParse(_range, out var d) ? d : 90;

    private string RangeLabel => Days switch { 7 => "7 days", 30 => "30 days", _ => "3 months" };

    private IReadOnlyList<Point> Filtered => All[^Days..];

    // Deterministic daily "traffic" for the 91 days ending June 30, 2026 - two overlaid waves.
    private static readonly Point[] All = Enumerable.Range(0, 91)
        .Select(i => new Point(
            new DateOnly(2026, 4, 1).AddDays(i),
            Math.Round(230 + 130 * Math.Sin(i / 3.1) + 70 * Math.Sin(i / 1.3) + i * 0.9),
            Math.Round(120 + 70 * Math.Sin(i / 2.7 + 1) + 40 * Math.Sin(i / 1.1) + i * 0.5)))
        .ToArray();
}
