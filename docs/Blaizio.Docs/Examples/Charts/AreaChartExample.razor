<BzCard Class="w-full">
    <BzCardHeader>
        <BzCardTitle>Area Chart</BzCardTitle>
        <BzCardDescription>Showing total visitors for the last 6 months</BzCardDescription>
    </BzCardHeader>
    <BzCardContent>
        <BzChart Data="Visitors" Label="d => d.Month" Height="280">
            <BzChartGrid />
            <BzChartXAxis />
            <BzChartTooltip />
            <BzChartAreaSeries Name="Desktop" Value="d => d.Desktop" Curved />
        </BzChart>
    </BzCardContent>
    <BzCardFooter Class="flex-col items-start gap-1 text-sm">
        <div class="flex items-center gap-2 font-medium"><BzIcon Icon="@Tabler.Outline.TrendingUp" Class="size-4" /> Trending up by 5.2% this month</div>
        <div class="text-muted-foreground">January - June 2026</div>
    </BzCardFooter>
</BzCard>

@code {
    private sealed record Point(string Month, double Desktop);

    private static readonly Point[] Visitors =
    [
        new("Jan", 186), new("Feb", 305), new("Mar", 237),
        new("Apr", 73), new("May", 209), new("Jun", 214),
    ];
}
