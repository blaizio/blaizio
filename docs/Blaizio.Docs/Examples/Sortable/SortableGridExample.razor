@* Columns lets Up/Down keyboard moves jump a whole row. *@
<div class="w-full max-w-md">
    <BzSortable Orientation="SortableOrientation.Grid" Columns="3" OnReorder="@(c => Reorder(_gallery, c))">
        @for (var i = 0; i < _gallery.Count; i++)
        {
            var index = i;
            <BzSortableItem @key="_gallery[index]" Index="index" Class="aspect-square items-center justify-center text-lg font-semibold">@_gallery[index]</BzSortableItem>
        }
    </BzSortable>
</div>

@code {
    private List<string> _gallery = new() { "1", "2", "3", "4", "5", "6", "7", "8", "9" };

    private void Reorder(List<string> list, SortableChange change)
    {
        change.Apply(list);
        StateHasChanged();
    }
}
