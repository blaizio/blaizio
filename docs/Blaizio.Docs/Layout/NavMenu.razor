@implements IDisposable
@inject NavigationManager Nav
@inject IDocsJs Js
@*
    Docs navigation: the "Getting started" guides, then the "Components" section - two plain
    labelled groups, no tab switcher (the per-page "API Reference" action reaches the generated
    API pages). The WHOLE panel scrolls as one (soft top/bottom fade, scrollbar only while
    scrolling) - nothing is pinned.

    Each row carries its own faint static line on the inline-start; one accent indicator per group
    SLIDES between the active rows (positioned by docs.js navPosition() after each render).
    Hovering a row nudges its label to the inline-end.

    Rows are BzSidebarMenuButtons rendered AS NavLinks so routing + the active highlight come from the
    router; DocsNav is the single source of truth for the entries.
*@
<BzSidebarContent data-scroll-activity="true" Class="scrollbar-activity scroll-fade-y px-4 pb-8 pt-3">
    <div>
        @* The site links, mirrored into the MOBILE sheet only (the desktop rail keeps them in the
           header). md:hidden is safe: the sheet itself only exists below the md breakpoint. *@
        <div class="mb-3 md:hidden">
            <div class="@SectionClass">Site</div>
            <BzSidebarMenu Class="gap-0.5">
                @foreach (var s in DocsNav.SiteNav)
                {
                    <BzSidebarMenuItem>
                        <BzSidebarMenuButton>
                            @* "Docs" is exact-match: as a prefix it would light up on every /docs/* page. *@
                            <RenderAs Context="p"><NavLink @attributes="p.Attributes" class="@RowClass" ActiveClass="@ActiveClass" href="@s.Href" Match="@(s.Href == "docs" ? NavLinkMatch.All : NavLinkMatch.Prefix)"><span class="@LabelClass">@s.Label</span></NavLink></RenderAs>
                        </BzSidebarMenuButton>
                    </BzSidebarMenuItem>
                }
            </BzSidebarMenu>
        </div>

        <div class="@SectionClass">Getting Started</div>
        <div class="relative" data-nav-list>
            <span data-nav-indicator></span>
            <BzSidebarMenu Class="gap-0.5">
                @foreach (var g in DocsNav.Guides)
                {
                    <BzSidebarMenuItem>
                        <BzSidebarMenuButton>
                            <RenderAs Context="p"><NavLink @attributes="p.Attributes" class="@RowClass" ActiveClass="@ActiveClass" href="@g.Href" Match="@(g.Match == "All" ? NavLinkMatch.All : NavLinkMatch.Prefix)"><span class="@LabelClass">@g.Label</span></NavLink></RenderAs>
                        </BzSidebarMenuButton>
                    </BzSidebarMenuItem>
                }
            </BzSidebarMenu>
        </div>

        <div class="@($"mt-6 {SectionClass}")">Components</div>
    </div>

    @* Component list. Rows link to the doc pages; on an /api route the same row stays highlighted
       (manual aria-current - NavLink can't match the api URL), and the page's "API Reference"
       action is how you get to the generated API. *@
    <div class="relative" data-nav-list>
        <span data-nav-indicator></span>
        <BzSidebarMenu Class="gap-0.5">
            @foreach (var c in DocsNav.Components)
            {
                <BzSidebarMenuItem>
                    <BzSidebarMenuButton>
                        <RenderAs Context="p"><NavLink @attributes="p.Attributes" class="@($"{RowClass} {(IsApi && c.Slug == _slug ? ActiveClass : "")}")" ActiveClass="@ActiveClass" href="@c.DocHref" Match="NavLinkMatch.All" aria-current="@(IsApi && c.Slug == _slug ? "page" : null)"><span class="@LabelClass">@c.Label</span></NavLink></RenderAs>
                    </BzSidebarMenuButton>
                </BzSidebarMenuItem>
            }
        </BzSidebarMenu>
    </div>
</BzSidebarContent>

@code {
    private string? _slug;
    private bool IsApi;

    /// <summary>The surrounding sidebar - used to close the mobile sheet after navigating.</summary>
    [CascadingParameter] private SidebarContext? Sidebar { get; set; }

    // A row: indented past the line, quiet at rest. The single continuous guide line behind the group
    // is drawn once on [data-nav-list] (see app.css); each row overlays a transparent segment at the
    // SAME gutter (start-[7px]) that brightens on hover - so hovering lights up that stretch of the
    // otherwise-continuous line. The accent on the active row comes from the sliding indicator on top.
    private const string RowClass =
        "group/row relative block w-full overflow-hidden rounded-md ps-4 pe-2 py-1.5 text-[0.8125rem] " +
        "text-sidebar-foreground/60 no-underline outline-hidden transition-colors hover:text-sidebar-foreground " +
        "before:absolute before:inset-y-0 before:start-[7px] before:w-px before:bg-transparent " +
        "before:transition-colors before:content-[''] hover:before:bg-sidebar-foreground/45";

    // The active page: just the accent text + weight (the indicator bar handles the line).
    private const string ActiveClass = "!text-primary font-medium";

    // Section headers: full-contrast foreground + weight against the muted rows - the size stays
    // in step with the rows so the hierarchy comes from color, not shouting caps.
    private const string SectionClass =
        "px-2 pb-1.5 text-[0.8125rem] font-semibold text-sidebar-foreground";

    // The label nudges toward the inline-end on hover (the "shiny text" slide).
    private const string LabelClass = "inline-block transition-transform duration-200 group-hover/row:translate-x-1";

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        Recompute();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        Recompute();
        // On mobile the nav lives in a sheet - close it after picking a page.
        if (Sidebar is { IsMobile: true, OpenMobile: true } s)
            _ = s.SetOpenMobile.InvokeAsync(false);
        StateHasChanged();
    }

    // After every render (initial, navigation, tab switch) re-place the sliding indicators - by then
    // NavLink has set aria-current on the active row, so the bar lands on it and animates the move.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await Js.NavPositionAsync();
            // Deep links land with the active row scrolled into view (first load only - later
            // navigation comes from clicking a visible row, and yanking the list would be rude).
            if (firstRender) await Js.NavRevealAsync();
            // Re-measure the scroll edges so the top/bottom fade only masks an edge with content
            // beyond it (the first row stays crisp at the top, even before the first scroll).
            await Js.ScrollFadeRefreshAsync();
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }

    // Pull the component slug + whether we're on an API route out of the current path so the tabs and
    // the row highlight track the URL (including deep links and the browser back/forward buttons).
    private void Recompute()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        var cut = path.IndexOfAny(['?', '#']); // fragment too, or a TOC-anchored refresh breaks the slug
        if (cut >= 0) path = path[..cut];
        var parts = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 3 && parts[0] == "docs" && parts[1] == "components")
        {
            _slug = parts[2];
            IsApi = parts.Length >= 4 && parts[3] == "api";
        }
        else
        {
            _slug = null;
            IsApi = false;
        }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
