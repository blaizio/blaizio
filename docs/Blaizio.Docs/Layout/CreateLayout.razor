@inherits LayoutComponentBase

@*
    Full-page layout for /create - the site header on top, no sidebar, no table of contents. The
    page body owns the whole viewport below the header (the preview canvas scrolls inside itself).
    Dialog + toast providers are mounted here because MainLayout's don't exist on this route.
*@
<BzDirectionProvider Dir="_dir">
    @* Same sidebar provider as MainLayout so the mobile hamburger opens the SAME full docs menu
       (NavMenu) on /create. Desktop never shows it: Open="false" + offcanvas keeps the rail
       collapsed off screen, and the trigger only renders below md. *@
    <BzSidebarProvider Open="false" PersistState="false" Class="min-h-svh flex-col">
        <SiteHeader DirectionChanged="OnDirectionChanged" />
        <div class="flex min-h-0 w-full flex-1 items-start">
            <BzSidebar Collapsible="SidebarCollapsible.Offcanvas" Class="top-14 h-[calc(100svh-3.5rem)] border-e-0">
                <NavMenu />
            </BzSidebar>
            <main class="min-h-0 min-w-0 flex-1">
                <CascadingValue Value="this" IsFixed="true">
                    @Body
                </CascadingValue>
            </main>
        </div>
    </BzSidebarProvider>

    @* display:contents wrapper = a CSS-only ancestor: every imperative dialog / toast on /create is
       part of the control surface, so pin it to the default look (pin-base.css + tokens.css) while
       the canvas re-skins. No layout impact - the wrapper generates no box. data-bz-portal-frame
       makes the pin survive the body portal: surfaces declared in here re-home into a body-level
       .bz-theme-base frame instead of bare <body>, where the skin would reach them again. *@
    <div class="bz-theme-base contents" data-bz-portal-frame="bz-theme-base">
        <BzDialogProvider />
        <BzToastProvider />
    </div>
</BzDirectionProvider>

@code {
    private Direction _dir = Direction.Ltr;

    /// <summary>Raised whenever the direction cascade flips - the page listens so its preset code tracks the header knob.</summary>
    public event Action<Direction>? DirectionUpdated;

    /// <summary>
    /// Flips the direction cascade. Both direction knobs converge here: the header's ThemeToggle
    /// (via <see cref="OnDirectionChanged"/>) and the create page (Open Preset / ?preset= codes,
    /// which persist through IDocsJs and then call this) - so the cascade always tracks the dir
    /// attribute on &lt;html&gt;.
    /// </summary>
    public void SetDirection(Direction dir)
    {
        if (_dir == dir) return;
        _dir = dir;
        DirectionUpdated?.Invoke(dir);
        StateHasChanged();
    }

    private void OnDirectionChanged(Direction dir) => SetDirection(dir);
}
