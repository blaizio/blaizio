    [Fact]
    public void A_label_names_its_group_and_separator_and_shortcut_keep_their_parts()
    {
        var cut = Render(@<BzMenubar AriaLabel="Main menu" DefaultValue="file">
            <BzMenubarMenu Value="file">
                <BzMenubarTrigger>File</BzMenubarTrigger>
                <BzMenubarContent>
                    <BzMenubarGroup>
                        <BzMenubarLabel Inset="true" Class="uppercase">Recent</BzMenubarLabel>
                        <BzMenubarItem>Report<BzMenubarShortcut Class="opacity-60">Ctrl+R</BzMenubarShortcut></BzMenubarItem>
                    </BzMenubarGroup>
                    <BzMenubarSeparator Class="my-2" />
                </BzMenubarContent>
            </BzMenubarMenu>
        </BzMenubar>);

        var label = cut.Find("[data-slot=menubar-label]");
        Assert.True(label.HasAttribute("data-inset"));
        Assert.Contains("uppercase", label.ClassList);
        var group = cut.Find("[data-slot=menubar-group]");
        Assert.Equal("group", group.GetAttribute("role"));
        Assert.Equal(label.Id, group.GetAttribute("aria-labelledby"));
        var separator = cut.Find("[data-slot=menubar-separator]");
        Assert.Equal("separator", separator.GetAttribute("role"));
        Assert.Contains("my-2", separator.ClassList);
        var shortcut = cut.Find("span[data-slot=menubar-shortcut]");
        Assert.Equal("Ctrl+R", shortcut.TextContent);
        Assert.Contains("opacity-60", shortcut.ClassList);
    }

    [Fact]
    public void A_submenu_opens_from_its_item_and_selecting_inside_closes_the_bar()
    {
        var changes = new List<bool>();
        var cut = Render(@<BzMenubar AriaLabel="Main menu" DefaultValue="file">
            <BzMenubarMenu Value="file">
                <BzMenubarTrigger>File</BzMenubarTrigger>
                <BzMenubarContent>
                    <BzMenubarSub OpenChanged="@((bool open) => changes.Add(open))">
                        <BzMenubarSubTrigger Inset="true">Share</BzMenubarSubTrigger>
                        <BzMenubarSubContent Class="w-44" data-testid="share">
                            <BzMenubarItem id="email">Email link</BzMenubarItem>
                        </BzMenubarSubContent>
                    </BzMenubarSub>
                    <BzMenubarSub>
                        <BzMenubarSubTrigger id="off" Disabled="true">Export</BzMenubarSubTrigger>
                        <BzMenubarSubContent><BzMenubarItem>PDF</BzMenubarItem></BzMenubarSubContent>
                    </BzMenubarSub>
                </BzMenubarContent>
            </BzMenubarMenu>
        </BzMenubar>);
        var subTrigger = cut.Find("[data-slot=menubar-sub-trigger]");
        Assert.Equal("menu", subTrigger.GetAttribute("aria-haspopup"));
        Assert.True(subTrigger.HasAttribute("data-inset"));
        Assert.NotNull(subTrigger.QuerySelector("svg"));

        cut.Find("#off").Click();
        Assert.Empty(cut.FindAll("[data-slot=menubar-sub-content]"));

        subTrigger.Click();
        Assert.Equal([true], changes);
        var sub = cut.Find("[data-testid=share][data-slot=menubar-sub-content]");
        Assert.Equal("menu", sub.GetAttribute("role"));
        Assert.Contains("w-44", sub.ClassList);

        cut.Find("#email").Click();
        Assert.Equal("closed", Triggers(cut));
    }

    [Fact]
    public void Inside_a_raised_dialog_the_menu_lifts_itself_above_the_window()
    {
        var cut = Render(@<BzDialog DefaultOpen="true">
            <BzDialogContent ZIndex="60">
                <BzDialogTitle>Edit</BzDialogTitle>
                <BzMenubar AriaLabel="Main menu" DefaultValue="file">@Menus</BzMenubar>
            </BzDialogContent>
        </BzDialog>);

        Assert.Contains("z-index:65", cut.Find("[data-slot=menubar-content]").GetAttribute("style"));
    }
