@using Bunit
@using Xunit
@using Microsoft.Extensions.DependencyInjection
@inherits BunitContext
@code {
    // BzPopover: a non-modal panel anchored to its trigger. Placement is asked for in markup and
    // confirmed by the positioning script; the panel is a dialog named by its title.

    private const string PositioningModule = "./_content/blaizio.base/dist/positioning.js";

    public PopoverTests()
    {
        JSInterop.Mode = JSRuntimeMode.Loose;
        Services.AddBlaizio();
    }

    private static readonly RenderFragment Body =
        @<text>
            <BzPopoverHeader>
                <BzPopoverTitle>Dimensions</BzPopoverTitle>
                <BzPopoverDescription>Set the width.</BzPopoverDescription>
            </BzPopoverHeader>
        </text>;

    private static object? Option(object options, string name) => options.GetType().GetProperty(name)!.GetValue(options);

    private static string? State(IRenderedComponent<IComponent> cut) =>
        cut.Find("[data-slot=popover-content]").GetAttribute("data-state");

    [Fact]
    public void The_trigger_opens_a_panel_named_by_its_title_and_description()
    {
        var cut = Render(@<BzPopover>
            <BzPopoverTrigger Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-1">Open</BzPopoverTrigger>
            <BzPopoverContent>@Body</BzPopoverContent>
        </BzPopover>);
        var trigger = cut.Find("button[data-slot=popover-trigger]");
        Assert.Equal("outline", trigger.GetAttribute("data-variant"));
        Assert.Equal("sm", trigger.GetAttribute("data-size"));
        Assert.Equal("button", trigger.GetAttribute("type"));
        Assert.Contains("gap-1", trigger.ClassList);
        Assert.Equal("false", trigger.GetAttribute("aria-expanded"));
        Assert.Empty(cut.FindAll("[data-slot=popover-content]"));

        trigger.Click();

        var panel = cut.Find("[data-slot=popover-content]");
        Assert.Equal("dialog", panel.GetAttribute("role"));
        // Not modal: the page behind stays usable.
        Assert.False(panel.HasAttribute("aria-modal"));
        var title = cut.Find("[data-slot=popover-title]");
        Assert.Equal("H4", title.TagName);
        Assert.Equal(title.Id, panel.GetAttribute("aria-labelledby"));
        Assert.Equal(cut.Find("[data-slot=popover-description]").Id, panel.GetAttribute("aria-describedby"));
        trigger = cut.Find("button[data-slot=popover-trigger]");
        Assert.Equal("true", trigger.GetAttribute("aria-expanded"));
        Assert.Equal(panel.Id, trigger.GetAttribute("aria-controls"));
    }

    [Fact]
    public void A_second_press_on_the_trigger_closes_the_panel()
    {
        var changes = new List<bool>();
        var cut = Render(@<BzPopover OpenChanged="@((bool open) => changes.Add(open))">
            <BzPopoverTrigger>Open</BzPopoverTrigger>
            <BzPopoverContent>@Body</BzPopoverContent>
        </BzPopover>);

        cut.Find("[data-slot=popover-trigger]").Click();
        cut.Find("[data-slot=popover-trigger]").Click();

        Assert.Equal([true, false], changes);
        Assert.Equal("closed", State(cut));
    }

    [Fact]
    public void The_panel_starts_on_the_side_and_alignment_it_was_asked_for()
    {
        var plain = Render(@<BzPopover DefaultOpen="true"><BzPopoverContent>@Body</BzPopoverContent></BzPopover>);
        Assert.Equal("bottom", plain.Find("[data-slot=popover-content]").GetAttribute("data-side"));
        Assert.Equal("center", plain.Find("[data-slot=popover-content]").GetAttribute("data-align"));

        var placed = Render(@<BzPopover DefaultOpen="true">
            <BzPopoverContent Side="Side.Right" Align="Align.Start">@Body</BzPopoverContent>
        </BzPopover>);
        Assert.Equal("right", placed.Find("[data-slot=popover-content]").GetAttribute("data-side"));
        Assert.Equal("start", placed.Find("[data-slot=popover-content]").GetAttribute("data-align"));
    }

    [Fact]
    public async Task A_flip_reported_by_the_script_moves_the_side_the_styles_read()
    {
        var cut = Render(@<BzPopover DefaultOpen="true"><BzPopoverContent>@Body</BzPopoverContent></BzPopover>);

        // No room below the trigger: the script placed the panel above it.
        await cut.InvokeAsync(() => cut.FindComponent<BasePopoverContent>().Instance.OnPlaced("top", "end"));

        var panel = cut.Find("[data-slot=popover-content]");
        Assert.Equal("top", panel.GetAttribute("data-side"));
        Assert.Equal("end", panel.GetAttribute("data-align"));
    }

    [Fact]
    public void Placement_reaches_the_positioning_script_with_a_gap_of_four_by_default()
    {
        var module = JSInterop.SetupModule(PositioningModule);
        module.Mode = JSRuntimeMode.Loose;

        var cut = Render(@<BzPopover DefaultOpen="true">
            <BzPopoverTrigger>Open</BzPopoverTrigger>
            <BzPopoverContent>@Body</BzPopoverContent>
        </BzPopover>);

        // createPositioning(anchorSelector, element, options, ref)
        var created = Assert.Single(module.Invocations, i => i.Identifier == "createPositioning");
        var anchor = cut.Find("[data-slot=popover-trigger]").GetAttribute("data-bz-popover-anchor");
        Assert.Equal($"[data-bz-popover-anchor='{anchor}']", created.Arguments[0]);
        var options = created.Arguments[2]!;
        Assert.Equal("bottom", Option(options, "side"));
        Assert.Equal("center", Option(options, "align"));
        Assert.Equal(4d, Option(options, "sideOffset"));
        Assert.Equal(0d, Option(options, "alignOffset"));
        Assert.Equal(false, Option(options, "inline"));
    }

    [Fact]
    public void Offsets_side_alignment_and_inline_reach_the_positioning_script()
    {
        var module = JSInterop.SetupModule(PositioningModule);
        module.Mode = JSRuntimeMode.Loose;

        Render(@<BzPopover DefaultOpen="true">
            <BzPopoverContent Side="Side.Left" Align="Align.End" SideOffset="12" AlignOffset="-6" Inline="true">@Body</BzPopoverContent>
        </BzPopover>);

        var options = Assert.Single(module.Invocations, i => i.Identifier == "createPositioning").Arguments[2]!;
        Assert.Equal("left", Option(options, "side"));
        Assert.Equal("end", Option(options, "align"));
        Assert.Equal(12d, Option(options, "sideOffset"));
        Assert.Equal(-6d, Option(options, "alignOffset"));
        Assert.Equal(true, Option(options, "inline"));
    }

    [Fact]
    public void Tab_loops_inside_the_panel_unless_it_is_told_to_let_go()
    {
        var looping = Render(@<BzPopover DefaultOpen="true"><BzPopoverContent>@Body</BzPopoverContent></BzPopover>);
        Assert.True(looping.FindComponent<BaseFocusScope>().Instance.Loop);
        Assert.False(looping.FindComponent<BaseFocusScope>().Instance.Trapped);

        var open = Render(@<BzPopover DefaultOpen="true"><BzPopoverContent Loop="false">@Body</BzPopoverContent></BzPopover>);
        Assert.False(open.FindComponent<BaseFocusScope>().Instance.Loop);
    }

    [Fact]
    public async Task Escape_or_a_press_outside_closes_the_panel()
    {
        var changes = new List<bool>();
        var cut = Render(@<BzPopover DefaultOpen="true" OpenChanged="@((bool open) => changes.Add(open))">
            <BzPopoverContent>@Body</BzPopoverContent>
        </BzPopover>);

        // Both arrive through the dismissable layer.
        await cut.InvokeAsync(() => cut.FindComponent<BasePopoverContent>().Instance.OnDismissRequested());

        Assert.Equal([false], changes);
        Assert.Equal("closed", State(cut));
    }

    [Fact]
    public async Task The_panel_is_removed_once_its_exit_animation_reports_back()
    {
        var cut = Render(@<BzPopover DefaultOpen="true">
            <BzPopoverContent>@Body<BzPopoverClose>Done</BzPopoverClose></BzPopoverContent>
        </BzPopover>);

        cut.Find("[data-slot=popover-close]").Click();
        Assert.Equal("closed", State(cut));

        await cut.InvokeAsync(() => cut.FindComponent<BasePopoverContent>().Instance.OnCloseFinished());
        Assert.Empty(cut.FindAll("[data-slot=popover-content]"));
    }

    [Fact]
    public void The_close_part_is_an_outlined_button_that_can_be_restyled_or_rendered_onto_another_element()
    {
        var cut = Render(@<BzPopover DefaultOpen="true">
            <BzPopoverContent>
                @Body
                <BzPopoverClose id="plain">Done</BzPopoverClose>
                <BzPopoverClose id="styled" Variant="ButtonVariant.Default" Size="ButtonSize.Sm" Class="w-full">Apply</BzPopoverClose>
                <BzPopoverClose>
                    <RenderAs Context="p"><a id="custom" href="#" @attributes="p.Attributes">Back</a></RenderAs>
                </BzPopoverClose>
            </BzPopoverContent>
        </BzPopover>);

        var plain = cut.Find("button#plain");
        Assert.Equal("outline", plain.GetAttribute("data-variant"));
        Assert.Equal("button", plain.GetAttribute("type"));
        var styled = cut.Find("button#styled");
        Assert.Equal("default", styled.GetAttribute("data-variant"));
        Assert.Equal("sm", styled.GetAttribute("data-size"));
        Assert.Contains("w-full", styled.ClassList);

        cut.Find("a#custom[data-slot=popover-close]").Click();
        Assert.Equal("closed", State(cut));
    }

    [Fact]
    public void A_controlled_popover_asks_to_close_and_follows_the_parent()
    {
        var requests = new List<bool>();
        var cut = Render<BzPopover>(p => p
            .Add(x => x.Open, true)
            .Add(x => x.OpenChanged, (bool open) => requests.Add(open))
            .AddChildContent<BzPopoverContent>(c => c.AddChildContent<BzPopoverClose>(b => b.AddChildContent("Done"))));

        cut.Find("[data-slot=popover-close]").Click();
        Assert.Equal([false], requests);
        Assert.Equal("open", cut.Find("[data-slot=popover-content]").GetAttribute("data-state"));

        cut.Render(p => p.Add(x => x.Open, false));
        Assert.Equal("closed", cut.Find("[data-slot=popover-content]").GetAttribute("data-state"));
    }

    [Fact]
    public void Classes_and_extra_attributes_reach_the_panel()
    {
        var cut = Render(@<BzPopover DefaultOpen="true">
            <BzPopoverContent Class="w-80" aria-label="Dimensions" data-testid="dims">Body</BzPopoverContent>
        </BzPopover>);

        var panel = cut.Find("[data-slot=popover-content]");
        Assert.Contains("w-80", panel.ClassList);
        Assert.Contains("bz-popover-content", panel.ClassList);
        Assert.Equal("Dimensions", panel.GetAttribute("aria-label"));
        Assert.Equal("dims", panel.GetAttribute("data-testid"));
        // Nothing titles it, so nothing is referenced.
        Assert.False(panel.HasAttribute("aria-labelledby"));
    }

    [Fact]
    public void The_panel_is_out_of_flow_and_hidden_until_the_script_has_placed_it()
    {
        var cut = Render(@<BzPopover DefaultOpen="true"><BzPopoverContent>@Body</BzPopoverContent></BzPopover>);

        var style = cut.Find("[data-slot=popover-content]").GetAttribute("style");
        Assert.Equal("position:fixed;top:0;left:0;visibility:hidden", style);
    }

    [Fact]
    public void Inside_a_raised_dialog_the_panel_lifts_itself_above_the_window_and_keeps_its_first_paint_style()
    {
        var cut = Render(@<BzDialog DefaultOpen="true">
            <BzDialogContent ZIndex="70">
                <BzDialogTitle>Edit</BzDialogTitle>
                <BzPopover DefaultOpen="true"><BzPopoverContent>@Body</BzPopoverContent></BzPopover>
            </BzDialogContent>
        </BzDialog>);

        var style = cut.Find("[data-slot=popover-content]").GetAttribute("style")!;
        // The window sits at 71: the popup, a sibling of it under the body, has to be above.
        Assert.Contains("z-index:75", style);
        Assert.Contains("visibility:hidden", style);
        Assert.Contains("position:fixed", style);
    }

    [Fact]
    public void Inside_a_dialog_on_the_default_layer_the_panel_sets_no_stacking_of_its_own()
    {
        var cut = Render(@<BzDialog DefaultOpen="true">
            <BzDialogContent>
                <BzDialogTitle>Edit</BzDialogTitle>
                <BzPopover DefaultOpen="true"><BzPopoverContent>@Body</BzPopoverContent></BzPopover>
            </BzDialogContent>
        </BzDialog>);

        Assert.DoesNotContain("z-index", cut.Find("[data-slot=popover-content]").GetAttribute("style"));
    }

    [Fact]
    public void The_arrow_is_decorative_carries_the_hook_the_script_positions_and_takes_classes()
    {
        var cut = Render(@<BzPopover DefaultOpen="true">
            <BzPopoverContent>@Body<BzPopoverArrow Class="size-4" data-testid="tail" /></BzPopoverContent>
        </BzPopover>);

        var arrow = cut.Find("[data-slot=popover-content] [data-slot=popover-arrow]");
        Assert.True(arrow.HasAttribute("data-bz-arrow"));
        Assert.Equal("true", arrow.GetAttribute("aria-hidden"));
        Assert.Equal("tail", arrow.GetAttribute("data-testid"));
        Assert.Contains("size-4", arrow.ClassList);
        Assert.DoesNotContain("size-3", arrow.ClassList);
        Assert.NotNull(arrow.QuerySelector("svg"));
    }

    [Fact]
    public void Header_title_and_description_merge_classes_and_forward_attributes()
    {
        var cut = Render(@<BzPopover DefaultOpen="true">
            <BzPopoverContent>
                <BzPopoverHeader Class="gap-3" lang="en">
                    <BzPopoverTitle Class="text-base">Dimensions</BzPopoverTitle>
                    <BzPopoverDescription Class="italic">Set the width.</BzPopoverDescription>
                </BzPopoverHeader>
            </BzPopoverContent>
        </BzPopover>);

        var header = cut.Find("[data-slot=popover-header]");
        Assert.Contains("gap-3", header.ClassList);
        Assert.Equal("en", header.GetAttribute("lang"));
        var title = cut.Find("[data-slot=popover-title]");
        Assert.Contains("text-base", title.ClassList);
        // The larger size replaces the default one.
        Assert.DoesNotContain("text-sm", title.ClassList);
        Assert.Contains("italic", cut.Find("[data-slot=popover-description]").ClassList);
    }

    [Fact]
    public void The_trigger_renders_onto_another_element_and_stays_the_anchor()
    {
        var cut = Render(@<BzPopover>
            <BzPopoverTrigger>
                <RenderAs Context="p"><input id="field" @attributes="p.Attributes" /></RenderAs>
            </BzPopoverTrigger>
            <BzPopoverContent>@Body</BzPopoverContent>
        </BzPopover>);

        var field = cut.Find("input#field[data-slot=popover-trigger]");
        Assert.True(field.HasAttribute("data-bz-popover-anchor"));
        Assert.Equal("dialog", field.GetAttribute("aria-haspopup"));
        // The button type belongs to the default button only.
        Assert.False(field.HasAttribute("type"));

        field.Click();
        Assert.Equal("open", State(cut));
    }
}
