    [Fact]
    public void The_search_field_reports_what_is_typed()
    {
        string? typed = null;
        var cut = Render(@<BzSidebarInput Value="in" ValueChanged="@((string? v) => typed = v)" Placeholder="Search" Class="h-9" />);

        var input = cut.Find("input[data-slot=sidebar-input]");
        Assert.Equal("in", input.GetAttribute("value"));
        Assert.Equal("Search", input.GetAttribute("placeholder"));
        Assert.Contains("h-9", input.ClassList);
        Assert.DoesNotContain("h-8", input.ClassList);

        input.Input("inbox");
        Assert.Equal("inbox", typed);
    }

    [Fact]
    public void A_loading_row_keeps_one_width_between_half_and_nine_tenths_and_can_lead_with_an_icon()
    {
        var cut = Render<BzSidebarMenuSkeleton>(p => p.Add(x => x.ShowIcon, true));

        var bar = cut.Find("[data-sidebar=menu-skeleton-text]");
        var style = bar.GetAttribute("style")!;
        var percent = int.Parse(style.Replace("--skeleton-width:", "").TrimEnd('%'));
        Assert.InRange(percent, 50, 90);
        Assert.Single(cut.FindAll("[data-sidebar=menu-skeleton-icon]"));

        // The same bar on the next render: a width picked again would make the rows jitter.
        cut.Render(p => p.Add(x => x.ShowIcon, false));
        Assert.Equal(style, cut.Find("[data-sidebar=menu-skeleton-text]").GetAttribute("style"));
        Assert.Empty(cut.FindAll("[data-sidebar=menu-skeleton-icon]"));
    }

    [Fact]
    public void Header_content_footer_and_separator_keep_their_slots_and_merge_classes()
    {
        var cut = Render(@<BzSidebar>
            <BzSidebarHeader Class="p-4" id="head">Logo</BzSidebarHeader>
            <BzSidebarSeparator Class="my-2" id="rule" />
            <BzSidebarContent Class="gap-0" id="body">Links</BzSidebarContent>
            <BzSidebarFooter Class="p-4" id="foot">User</BzSidebarFooter>
        </BzSidebar>);

        Assert.Contains("p-4", cut.Find("#head[data-slot=sidebar-header]").ClassList);
        var rule = cut.Find("#rule[data-slot=sidebar-separator]");
        Assert.Contains("my-2", rule.ClassList);
        Assert.Contains("bg-sidebar-border", rule.ClassList);
        Assert.Contains("gap-0", cut.Find("#body[data-slot=sidebar-content]").ClassList);
        Assert.Contains("p-4", cut.Find("#foot[data-slot=sidebar-footer]").ClassList);
    }
