        cut.Find("[data-slot=dropdown-menu-checkbox-item]").Click();

        Assert.Equal("closed", State(cut));
        Assert.Equal("false", cut.Find("[data-slot=dropdown-menu-checkbox-item]").GetAttribute("aria-checked"));
    }

