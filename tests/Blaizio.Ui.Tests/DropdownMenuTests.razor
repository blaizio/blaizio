@using Bunit
@using Xunit
@using Microsoft.Extensions.DependencyInjection
@inherits BunitContext
@code {
    // BzDropdownMenu: a menu opened from a trigger. Items report their selection and close the
    // menu unless told otherwise; checkbox and radio items carry state; submenus open from an item.

    private const string PositioningModule = "./_content/blaizio.base/dist/positioning.js";
    private const string MenuModule = "./_content/blaizio.base/dist/menu.js";

    public DropdownMenuTests()
    {
        JSInterop.Mode = JSRuntimeMode.Loose;
        Services.AddBlaizio();
    }

    private static object? Option(object options, string name) => options.GetType().GetProperty(name)!.GetValue(options);

    private static string? State(IRenderedComponent<IComponent> cut) =>
        cut.Find("[data-slot=dropdown-menu-content]").GetAttribute("data-state");

    [Fact]
    public void The_trigger_opens_a_menu_that_is_named_by_it()
    {
        var cut = Render(@<BzDropdownMenu>
            <BzDropdownMenuTrigger Class="px-2">Options</BzDropdownMenuTrigger>
            <BzDropdownMenuContent><BzDropdownMenuItem>Rename</BzDropdownMenuItem></BzDropdownMenuContent>
        </BzDropdownMenu>);
        var trigger = cut.Find("button[data-slot=dropdown-menu-trigger]");
        Assert.Equal("menu", trigger.GetAttribute("aria-haspopup"));
        Assert.Equal("false", trigger.GetAttribute("aria-expanded"));
        Assert.Contains("px-2", trigger.ClassList);
        Assert.Empty(cut.FindAll("[role=menu]"));

        trigger.Click();

        var menu = cut.Find("[role=menu]");
        Assert.Equal("dropdown-menu-content", menu.GetAttribute("data-slot"));
        trigger = cut.Find("button[data-slot=dropdown-menu-trigger]");
        Assert.Equal(trigger.Id, menu.GetAttribute("aria-labelledby"));
        Assert.Equal(menu.Id, trigger.GetAttribute("aria-controls"));
        Assert.Equal("true", trigger.GetAttribute("aria-expanded"));
        Assert.Equal("vertical", menu.GetAttribute("aria-orientation"));
    }

    [Fact]
    public void The_trigger_renders_onto_a_styled_button()
    {
        var cut = Render(@<BzDropdownMenu>
            <BzDropdownMenuTrigger>
                <RenderAs Context="p"><BzButton Variant="ButtonVariant.Outline" @attributes="p.Attributes">Open</BzButton></RenderAs>
            </BzDropdownMenuTrigger>
            <BzDropdownMenuContent><BzDropdownMenuItem>Rename</BzDropdownMenuItem></BzDropdownMenuContent>
        </BzDropdownMenu>);

        var button = cut.Find("button[data-slot=dropdown-menu-trigger]");
        Assert.Equal("outline", button.GetAttribute("data-variant"));
        Assert.Contains("bz-button", button.ClassList);

        button.Click();
        Assert.Equal("open", State(cut));
    }

    [Theory]
    [InlineData("ArrowDown", "first")]
    [InlineData("ArrowUp", "last")]
    public void An_arrow_key_on_the_trigger_opens_the_menu_with_focus_on_that_end(string key, string focus)
    {
        var script = JSInterop.SetupModule(MenuModule);
        script.Mode = JSRuntimeMode.Loose;
        var cut = Render(@<BzDropdownMenu>
            <BzDropdownMenuTrigger>Options</BzDropdownMenuTrigger>
            <BzDropdownMenuContent><BzDropdownMenuItem>Rename</BzDropdownMenuItem></BzDropdownMenuContent>
        </BzDropdownMenu>);

        cut.Find("[data-slot=dropdown-menu-trigger]").KeyDown(new KeyboardEventArgs { Key = key });

        Assert.Equal("open", State(cut));
        var options = Assert.Single(script.Invocations, i => i.Identifier == "createMenu").Arguments[1]!;
        Assert.Equal(focus, Option(options, "initialFocus"));
    }

    [Fact]
    public void A_pointer_click_opens_the_menu_with_nothing_highlighted_and_a_key_press_with_the_first_item()
    {
        var script = JSInterop.SetupModule(MenuModule);
        script.Mode = JSRuntimeMode.Loose;
        RenderFragment menu = @<BzDropdownMenu>
            <BzDropdownMenuTrigger>Options</BzDropdownMenuTrigger>
            <BzDropdownMenuContent><BzDropdownMenuItem>Rename</BzDropdownMenuItem></BzDropdownMenuContent>
        </BzDropdownMenu>;

        // A real press reports a click count; Enter and Space on a button report none.
        Render(menu).Find("[data-slot=dropdown-menu-trigger]").Click(new MouseEventArgs { Detail = 1 });
        Render(menu).Find("[data-slot=dropdown-menu-trigger]").Click(new MouseEventArgs { Detail = 0 });

        var created = script.Invocations.Where(i => i.Identifier == "createMenu").ToList();
        Assert.Equal(["none", "first"], created.Select(i => Option(i.Arguments[1]!, "initialFocus")));
    }

    [Fact]
    public void The_menu_opens_below_its_trigger_aligned_to_the_start_with_a_gap_of_four()
    {
        var positioning = JSInterop.SetupModule(PositioningModule);
        positioning.Mode = JSRuntimeMode.Loose;

        var cut = Render(@<BzDropdownMenu DefaultOpen="true">
            <BzDropdownMenuTrigger>Options</BzDropdownMenuTrigger>
            <BzDropdownMenuContent><BzDropdownMenuItem>Rename</BzDropdownMenuItem></BzDropdownMenuContent>
        </BzDropdownMenu>);

        var created = Assert.Single(positioning.Invocations, i => i.Identifier == "createPositioning");
        var anchor = cut.Find("[data-slot=dropdown-menu-trigger]").GetAttribute("data-bz-dropdown-menu-anchor");
        Assert.Equal($"[data-bz-dropdown-menu-anchor='{anchor}']", created.Arguments[0]);
        var options = created.Arguments[2]!;
        Assert.Equal("bottom", Option(options, "side"));
        Assert.Equal("start", Option(options, "align"));
        Assert.Equal(4d, Option(options, "sideOffset"));
        Assert.Equal(0d, Option(options, "alignOffset"));
        Assert.Equal(false, Option(options, "inline"));
    }

    [Fact]
    public void Placement_parameters_reach_the_positioning_script()
    {
        var positioning = JSInterop.SetupModule(PositioningModule);
        positioning.Mode = JSRuntimeMode.Loose;

        Render(@<BzDropdownMenu DefaultOpen="true">
            <BzDropdownMenuContent Side="Side.Top" Align="Align.End" SideOffset="10" AlignOffset="3" Inline="true">
                <BzDropdownMenuItem>Rename</BzDropdownMenuItem>
            </BzDropdownMenuContent>
        </BzDropdownMenu>);

        var options = Assert.Single(positioning.Invocations, i => i.Identifier == "createPositioning").Arguments[2]!;
        Assert.Equal("top", Option(options, "side"));
        Assert.Equal("end", Option(options, "align"));
        Assert.Equal(10d, Option(options, "sideOffset"));
        Assert.Equal(3d, Option(options, "alignOffset"));
        Assert.Equal(true, Option(options, "inline"));
    }

    [Theory]
    [InlineData(true)]
    [InlineData(false)]
    public void Loop_tells_the_menu_script_whether_the_arrows_wrap(bool loop)
    {
        var script = JSInterop.SetupModule(MenuModule);
        script.Mode = JSRuntimeMode.Loose;

        Render(@<BzDropdownMenu DefaultOpen="true">
            <BzDropdownMenuContent Loop="loop"><BzDropdownMenuItem>Rename</BzDropdownMenuItem></BzDropdownMenuContent>
        </BzDropdownMenu>);

        var options = Assert.Single(script.Invocations, i => i.Identifier == "createMenu").Arguments[1]!;
        Assert.Equal(loop, Option(options, "loop"));
        Assert.Equal(false, Option(options, "isSubmenu"));
    }

    [Fact]
    public async Task A_flip_reported_by_the_script_moves_the_side_the_styles_read()
    {
        var cut = Render(@<BzDropdownMenu DefaultOpen="true">
            <BzDropdownMenuContent><BzDropdownMenuItem>Rename</BzDropdownMenuItem></BzDropdownMenuContent>
        </BzDropdownMenu>);
        Assert.Equal("bottom", cut.Find("[role=menu]").GetAttribute("data-side"));

        await cut.InvokeAsync(() => cut.FindComponent<BaseDropdownMenuContent>().Instance.OnPlaced("top", "end"));

        Assert.Equal("top", cut.Find("[role=menu]").GetAttribute("data-side"));
        Assert.Equal("end", cut.Find("[role=menu]").GetAttribute("data-align"));
    }

    [Fact]
    public void Selecting_an_item_reports_it_and_closes_the_menu()
    {
        var events = new List<string>();
        var cut = Render(@<BzDropdownMenu DefaultOpen="true" OpenChanged="@((bool open) => events.Add($"open {open}"))">
            <BzDropdownMenuContent>
                <BzDropdownMenuItem OnSelect="@((MenuSelectEventArgs _) => events.Add("rename"))">Rename</BzDropdownMenuItem>
            </BzDropdownMenuContent>
        </BzDropdownMenu>);

        cut.Find("[data-slot=dropdown-menu-item]").Click();

        Assert.Equal(["rename", "open False"], events);
        Assert.Equal("closed", State(cut));
    }

    [Fact]
    public void An_item_that_prevents_the_default_keeps_the_menu_open()
    {
        var cut = Render(@<BzDropdownMenu DefaultOpen="true">
            <BzDropdownMenuContent>
                <BzDropdownMenuItem OnSelect="@((MenuSelectEventArgs e) => e.PreventDefault())">Copy link</BzDropdownMenuItem>
            </BzDropdownMenuContent>
        </BzDropdownMenu>);

        cut.Find("[data-slot=dropdown-menu-item]").Click();

        Assert.Equal("open", State(cut));
    }

    [Fact]
    public void A_disabled_item_says_so_and_ignores_the_press()
    {
        var selected = 0;
        var cut = Render(@<BzDropdownMenu DefaultOpen="true">
            <BzDropdownMenuContent>
                <BzDropdownMenuItem Disabled="true" OnSelect="@((MenuSelectEventArgs _) => selected++)">Delete</BzDropdownMenuItem>
            </BzDropdownMenuContent>
        </BzDropdownMenu>);

        var item = cut.Find("[data-slot=dropdown-menu-item]");
        Assert.Equal("true", item.GetAttribute("aria-disabled"));
        Assert.True(item.HasAttribute("data-disabled"));

        item.Click();
        Assert.Equal(0, selected);
        Assert.Equal("open", State(cut));
    }

    [Fact]
    public void Inset_variant_classes_and_extra_attributes_reach_the_item()
    {
        var cut = Render(@<BzDropdownMenu DefaultOpen="true">
            <BzDropdownMenuContent>
                <BzDropdownMenuItem id="plain">Rename</BzDropdownMenuItem>
                <BzDropdownMenuItem id="styled" Inset="true" Variant="DropdownMenuItemVariant.Destructive" Class="font-medium">Delete</BzDropdownMenuItem>
            </BzDropdownMenuContent>
        </BzDropdownMenu>);

        var plain = cut.Find("#plain");
        Assert.Equal("menuitem", plain.GetAttribute("role"));
        Assert.Equal("-1", plain.GetAttribute("tabindex"));
        Assert.False(plain.HasAttribute("data-inset"));
        Assert.False(plain.HasAttribute("data-variant"));
        var styled = cut.Find("#styled");
        Assert.True(styled.HasAttribute("data-inset"));
        Assert.Equal("destructive", styled.GetAttribute("data-variant"));
        Assert.Contains("font-medium", styled.ClassList);
        Assert.Contains("bz-dropdown-menu-item", styled.ClassList);
    }

    [Fact]
    public void An_item_rendered_as_a_link_is_still_a_menu_item_that_closes_the_menu()
    {
        var cut = Render(@<BzDropdownMenu DefaultOpen="true">
            <BzDropdownMenuContent>
                <BzDropdownMenuItem>
                    <RenderAs Context="p"><a href="/settings" @attributes="p.Attributes">Settings</a></RenderAs>
                </BzDropdownMenuItem>
            </BzDropdownMenuContent>
        </BzDropdownMenu>);

        var link = cut.Find("a[data-slot=dropdown-menu-item]");
        Assert.Equal("menuitem", link.GetAttribute("role"));
        Assert.Equal("/settings", link.GetAttribute("href"));

        link.Click();
        Assert.Equal("closed", State(cut));
    }

    [Fact]
    public void A_checkbox_item_toggles_reports_and_shows_its_check_only_while_checked()
    {
        var changes = new List<bool>();
        var cut = Render(@<BzDropdownMenu DefaultOpen="true">
            <BzDropdownMenuContent>
                <BzDropdownMenuCheckboxItem CheckedChanged="@((bool c) => changes.Add(c))"
                                            OnSelect="@((MenuSelectEventArgs e) => e.PreventDefault())">Status bar</BzDropdownMenuCheckboxItem>
            </BzDropdownMenuContent>
        </BzDropdownMenu>);
        var box = cut.Find("[data-slot=dropdown-menu-checkbox-item]");
        Assert.Equal("menuitemcheckbox", box.GetAttribute("role"));
        Assert.Equal("false", box.GetAttribute("aria-checked"));
        Assert.Null(box.QuerySelector("svg"));

        box.Click();

        box = cut.Find("[data-slot=dropdown-menu-checkbox-item]");
        Assert.Equal([true], changes);
        Assert.Equal("true", box.GetAttribute("aria-checked"));
        Assert.Equal("checked", box.GetAttribute("data-state"));
        Assert.NotNull(box.QuerySelector("svg"));

        box.Click();
        Assert.Equal([true, false], changes);
        Assert.Null(cut.Find("[data-slot=dropdown-menu-checkbox-item]").QuerySelector("svg"));
    }

    [Fact]
    public void A_checkbox_item_closes_the_menu_when_nothing_prevents_it()
    {
        var cut = Render(@<BzDropdownMenu DefaultOpen="true">
            <BzDropdownMenuContent>
                <BzDropdownMenuCheckboxItem DefaultChecked="true">Status bar</BzDropdownMenuCheckboxItem>
