    [Fact]
    public void A_disabled_checkbox_item_does_not_toggle()
    {
        var changes = new List<bool>();
        var cut = Render(@<BzDropdownMenu DefaultOpen="true">
            <BzDropdownMenuContent>
                <BzDropdownMenuCheckboxItem Disabled="true" CheckedChanged="@((bool c) => changes.Add(c))">Status bar</BzDropdownMenuCheckboxItem>
