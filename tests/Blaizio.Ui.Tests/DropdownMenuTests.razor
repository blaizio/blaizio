    [Fact]
    public void A_radio_group_marks_its_default_value_and_moves_it_on_selection()
    {
        var cut = Render(@<BzDropdownMenu DefaultOpen="true">
            <BzDropdownMenuContent>
                <BzDropdownMenuRadioGroup DefaultValue="top" id="position">
                    <BzDropdownMenuRadioItem Value="top">Top</BzDropdownMenuRadioItem>
                    <BzDropdownMenuRadioItem Value="bottom" OnSelect="@((MenuSelectEventArgs e) => e.PreventDefault())">Bottom</BzDropdownMenuRadioItem>
                    <BzDropdownMenuRadioItem Value="right" Disabled="true">Right</BzDropdownMenuRadioItem>
                </BzDropdownMenuRadioGroup>
            </BzDropdownMenuContent>
        </BzDropdownMenu>);
        var group = cut.Find("#position[data-slot=dropdown-menu-radio-group]");
        Assert.Equal("group", group.GetAttribute("role"));
        var items = cut.FindAll("[data-slot=dropdown-menu-radio-item]");
        Assert.All(items, i => Assert.Equal("menuitemradio", i.GetAttribute("role")));
        Assert.Equal(["true", "false", "false"], items.Select(i => i.GetAttribute("aria-checked")));
        // The check is drawn on the selected option only.
        Assert.Equal([true, false, false], items.Select(i => i.QuerySelector("svg") is not null));

        // A disabled option cannot be picked.
        items[2].Click();
        Assert.Equal("true", cut.FindAll("[data-slot=dropdown-menu-radio-item]")[0].GetAttribute("aria-checked"));

        cut.FindAll("[data-slot=dropdown-menu-radio-item]")[1].Click();
        items = cut.FindAll("[data-slot=dropdown-menu-radio-item]");
        Assert.Equal(["false", "true", "false"], items.Select(i => i.GetAttribute("aria-checked")));
        Assert.Equal([false, true, false], items.Select(i => i.QuerySelector("svg") is not null));
    }

    [Fact(Skip = "bug: BaseDropdownMenuRadioGroup reads a ValueChanged listener as controlled, so DefaultValue with ValueChanged selects nothing and no pick sticks")]
    public void A_radio_group_that_is_only_listened_to_still_starts_from_its_default_value()
    {
        var changes = new List<string>();
        var cut = Render(@<BzDropdownMenu DefaultOpen="true">
            <BzDropdownMenuContent>
                <BzDropdownMenuRadioGroup DefaultValue="top" ValueChanged="@((string v) => changes.Add(v))">
                    <BzDropdownMenuRadioItem Value="top">Top</BzDropdownMenuRadioItem>
                    <BzDropdownMenuRadioItem Value="bottom" OnSelect="@((MenuSelectEventArgs e) => e.PreventDefault())">Bottom</BzDropdownMenuRadioItem>
                </BzDropdownMenuRadioGroup>
            </BzDropdownMenuContent>
        </BzDropdownMenu>);
        Assert.Equal(["true", "false"],
            cut.FindAll("[data-slot=dropdown-menu-radio-item]").Select(i => i.GetAttribute("aria-checked")));

        cut.FindAll("[data-slot=dropdown-menu-radio-item]")[1].Click();

        Assert.Equal(["bottom"], changes);
        Assert.Equal(["false", "true"],
            cut.FindAll("[data-slot=dropdown-menu-radio-item]").Select(i => i.GetAttribute("aria-checked")));
    }

