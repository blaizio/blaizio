    [Fact]
    public void Selecting_inside_a_submenu_closes_the_whole_menu()
    {
        var cut = Render(@<BzDropdownMenu DefaultOpen="true">
            <BzDropdownMenuContent>
                <BzDropdownMenuSub DefaultOpen="true">
                    <BzDropdownMenuSubTrigger>Share</BzDropdownMenuSubTrigger>
                    <BzDropdownMenuSubContent><BzDropdownMenuItem id="email">Email</BzDropdownMenuItem></BzDropdownMenuSubContent>
                </BzDropdownMenuSub>
            </BzDropdownMenuContent>
        </BzDropdownMenu>);

        cut.Find("#email").Click();

        Assert.Equal("closed", State(cut));
    }

    [Theory]
    [InlineData("Escape", "closed")]
    [InlineData("Tab", "closed")]
    [InlineData("a", "open")]
    public void Escape_and_Tab_close_the_menu_and_other_keys_are_the_scripts(string key, string state)
    {
        var cut = Render(@<BzDropdownMenu DefaultOpen="true">
            <BzDropdownMenuContent><BzDropdownMenuItem>Rename</BzDropdownMenuItem></BzDropdownMenuContent>
        </BzDropdownMenu>);

        cut.Find("[role=menu]").KeyDown(new KeyboardEventArgs { Key = key });

        Assert.Equal(state, State(cut));
    }

    [Fact]
    public async Task A_press_outside_closes_the_menu_and_it_is_removed_after_its_exit_animation()
    {
        var cut = Render(@<BzDropdownMenu DefaultOpen="true">
            <BzDropdownMenuContent><BzDropdownMenuItem>Rename</BzDropdownMenuItem></BzDropdownMenuContent>
        </BzDropdownMenu>);
        var content = cut.FindComponent<BaseDropdownMenuContent>();

        await cut.InvokeAsync(() => content.Instance.OnDismissRequested());
        Assert.Equal("closed", State(cut));

        await cut.InvokeAsync(() => content.Instance.OnCloseFinished());
        Assert.Empty(cut.FindAll("[data-slot=dropdown-menu-content]"));
    }

    [Fact]
    public void A_controlled_menu_asks_to_close_and_follows_the_parent()
    {
        var requests = new List<bool>();
        var cut = Render<BzDropdownMenu>(p => p
            .Add(x => x.Open, true)
            .Add(x => x.OpenChanged, (bool open) => requests.Add(open))
            .AddChildContent<BzDropdownMenuContent>(c => c.AddChildContent<BzDropdownMenuItem>(i => i.AddChildContent("Rename"))));

        cut.Find("[data-slot=dropdown-menu-item]").Click();
        Assert.Equal([false], requests);
        Assert.Equal("open", cut.Find("[role=menu]").GetAttribute("data-state"));

        cut.Render(p => p.Add(x => x.Open, false));
        Assert.Equal("closed", cut.Find("[role=menu]").GetAttribute("data-state"));
    }

    [Fact]
    public void Classes_and_extra_attributes_reach_the_menu_surface()
    {
        var cut = Render(@<BzDropdownMenu DefaultOpen="true">
            <BzDropdownMenuContent Class="w-56 scrollbar-none" data-testid="options"><BzDropdownMenuItem>Rename</BzDropdownMenuItem></BzDropdownMenuContent>
        </BzDropdownMenu>);

        var menu = cut.Find("[data-testid=options]");
        Assert.Contains("w-56", menu.ClassList);
        Assert.Contains("bz-dropdown-menu-content", menu.ClassList);
        // A scrollbar class of the consumer replaces the default thin one.
        Assert.Contains("scrollbar-none", menu.ClassList);
        Assert.DoesNotContain("scrollbar-thin", menu.ClassList);
        Assert.Equal("position:fixed;top:0;left:0;visibility:hidden", menu.GetAttribute("style"));
    }

    [Fact]
    public void Inside_a_raised_dialog_the_menu_and_its_submenu_lift_themselves_above_the_window()
    {
        var cut = Render(@<BzDialog DefaultOpen="true">
            <BzDialogContent ZIndex="60">
                <BzDialogTitle>Edit</BzDialogTitle>
                <BzDropdownMenu DefaultOpen="true">
                    <BzDropdownMenuContent>
                        <BzDropdownMenuSub DefaultOpen="true">
                            <BzDropdownMenuSubTrigger>Share</BzDropdownMenuSubTrigger>
                            <BzDropdownMenuSubContent><BzDropdownMenuItem>Email</BzDropdownMenuItem></BzDropdownMenuSubContent>
                        </BzDropdownMenuSub>
                    </BzDropdownMenuContent>
                </BzDropdownMenu>
            </BzDialogContent>
        </BzDialog>);

        Assert.Contains("z-index:65", cut.Find("[data-slot=dropdown-menu-content]").GetAttribute("style"));
        Assert.Contains("z-index:65", cut.Find("[data-slot=dropdown-menu-sub-content]").GetAttribute("style"));
    }
