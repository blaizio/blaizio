    [Fact]
    public void A_label_names_the_group_it_sits_in()
    {
        var cut = Render(@<BzDropdownMenu DefaultOpen="true">
            <BzDropdownMenuContent>
                <BzDropdownMenuGroup>
                    <BzDropdownMenuLabel Inset="true" Class="uppercase">Account</BzDropdownMenuLabel>
                    <BzDropdownMenuItem>Profile</BzDropdownMenuItem>
                </BzDropdownMenuGroup>
                <BzDropdownMenuSeparator Class="my-2" />
                <BzDropdownMenuItem>Sign out<BzDropdownMenuShortcut Class="opacity-60">Ctrl+Q</BzDropdownMenuShortcut></BzDropdownMenuItem>
            </BzDropdownMenuContent>
        </BzDropdownMenu>);

        var label = cut.Find("[data-slot=dropdown-menu-label]");
        Assert.True(label.HasAttribute("data-inset"));
        Assert.Contains("uppercase", label.ClassList);
        var group = cut.Find("[data-slot=dropdown-menu-group]");
        Assert.Equal("group", group.GetAttribute("role"));
        Assert.Equal(label.Id, group.GetAttribute("aria-labelledby"));
        var separator = cut.Find("[data-slot=dropdown-menu-separator]");
        Assert.Equal("separator", separator.GetAttribute("role"));
        Assert.Contains("my-2", separator.ClassList);
        Assert.DoesNotContain("my-1", separator.ClassList);
        var shortcut = cut.Find("span[data-slot=dropdown-menu-shortcut]");
        Assert.Equal("Ctrl+Q", shortcut.TextContent);
        Assert.Contains("opacity-60", shortcut.ClassList);
        Assert.Contains("ms-auto", shortcut.ClassList);
    }

    [Fact]
    public void A_submenu_opens_from_its_item_and_reports_it()
    {
        var changes = new List<bool>();
        var cut = Render(@<BzDropdownMenu DefaultOpen="true">
            <BzDropdownMenuContent>
                <BzDropdownMenuSub OpenChanged="@((bool open) => changes.Add(open))">
                    <BzDropdownMenuSubTrigger Inset="true" Class="font-medium">Share</BzDropdownMenuSubTrigger>
                    <BzDropdownMenuSubContent Class="w-48" data-testid="share">
                        <BzDropdownMenuItem>Email</BzDropdownMenuItem>
                    </BzDropdownMenuSubContent>
                </BzDropdownMenuSub>
            </BzDropdownMenuContent>
        </BzDropdownMenu>);
        var subTrigger = cut.Find("[data-slot=dropdown-menu-sub-trigger]");
        Assert.Equal("menuitem", subTrigger.GetAttribute("role"));
        Assert.Equal("menu", subTrigger.GetAttribute("aria-haspopup"));
        Assert.Equal("false", subTrigger.GetAttribute("aria-expanded"));
        Assert.True(subTrigger.HasAttribute("data-inset"));
        Assert.Contains("font-medium", subTrigger.ClassList);
        // The chevron that says "more this way".
        Assert.NotNull(subTrigger.QuerySelector("svg"));
        Assert.Empty(cut.FindAll("[data-slot=dropdown-menu-sub-content]"));

        subTrigger.Click();

        Assert.Equal([true], changes);
        var sub = cut.Find("[data-testid=share][data-slot=dropdown-menu-sub-content]");
        Assert.Equal("menu", sub.GetAttribute("role"));
        Assert.Contains("w-48", sub.ClassList);
        subTrigger = cut.Find("[data-slot=dropdown-menu-sub-trigger]");
        Assert.Equal("true", subTrigger.GetAttribute("aria-expanded"));
        Assert.Equal(sub.Id, subTrigger.GetAttribute("aria-controls"));
        Assert.Equal(subTrigger.Id, sub.GetAttribute("aria-labelledby"));
    }

    [Fact]
    public void The_inline_end_arrow_opens_a_submenu_and_the_other_arrow_does_not()
    {
        var cut = Render(@<BzDropdownMenu DefaultOpen="true">
            <BzDropdownMenuContent>
                <BzDropdownMenuSub>
                    <BzDropdownMenuSubTrigger>Share</BzDropdownMenuSubTrigger>
                    <BzDropdownMenuSubContent><BzDropdownMenuItem>Email</BzDropdownMenuItem></BzDropdownMenuSubContent>
                </BzDropdownMenuSub>
            </BzDropdownMenuContent>
        </BzDropdownMenu>);

        cut.Find("[data-slot=dropdown-menu-sub-trigger]").KeyDown(new KeyboardEventArgs { Key = "ArrowLeft" });
        Assert.Empty(cut.FindAll("[data-slot=dropdown-menu-sub-content]"));

        cut.Find("[data-slot=dropdown-menu-sub-trigger]").KeyDown(new KeyboardEventArgs { Key = "ArrowRight" });
        Assert.NotEmpty(cut.FindAll("[data-slot=dropdown-menu-sub-content]"));
    }

    [Fact]
    public void In_a_right_to_left_menu_the_arrows_that_open_a_submenu_swap()
    {
        var cut = Render(@<BzDirectionProvider Dir="Direction.Rtl">
            <BzDropdownMenu DefaultOpen="true">
                <BzDropdownMenuContent>
                    <BzDropdownMenuSub>
                        <BzDropdownMenuSubTrigger>Share</BzDropdownMenuSubTrigger>
                        <BzDropdownMenuSubContent><BzDropdownMenuItem>Email</BzDropdownMenuItem></BzDropdownMenuSubContent>
                    </BzDropdownMenuSub>
                </BzDropdownMenuContent>
            </BzDropdownMenu>
        </BzDirectionProvider>);

        cut.Find("[data-slot=dropdown-menu-sub-trigger]").KeyDown(new KeyboardEventArgs { Key = "ArrowRight" });
        Assert.Empty(cut.FindAll("[data-slot=dropdown-menu-sub-content]"));

        cut.Find("[data-slot=dropdown-menu-sub-trigger]").KeyDown(new KeyboardEventArgs { Key = "ArrowLeft" });
        Assert.NotEmpty(cut.FindAll("[data-slot=dropdown-menu-sub-content]"));
        // The menu left the provider's subtree for the body, so it states its direction itself.
        Assert.Equal("rtl", cut.Find("[data-slot=dropdown-menu-content]").GetAttribute("dir"));
    }

