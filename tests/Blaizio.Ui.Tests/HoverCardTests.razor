@using System.Reflection
@using Bunit
@using Xunit
@using Microsoft.Extensions.DependencyInjection
@inherits BunitContext
@code {
    // BzHoverCard: a card that opens while its trigger is hovered, after a delay, and can be
    // moved into (it is interactive). Placement follows the popover.

    private const string PositioningModule = "./_content/blaizio.base/dist/positioning.js";

    public HoverCardTests()
    {
        JSInterop.Mode = JSRuntimeMode.Loose;
        Services.AddBlaizio();
    }

    // The property is found whatever its case: a named options type spells it in Pascal case,
    // a payload built in place in camel case, and the script receives camel case from both.
    private static object? Option(object options, string name) => options.GetType()
        .GetProperty(name, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase)!
        .GetValue(options);

    [Fact]
    public void Hovering_the_trigger_opens_the_card_and_leaving_it_closes_the_card()
    {
        var changes = new List<bool>();
        var cut = Render(@<BzHoverCard OpenDelay="0" CloseDelay="0" OpenChanged="@((bool open) => changes.Add(open))">
            <BzHoverCardTrigger Class="underline" href="/ada" id="ada">@@ada</BzHoverCardTrigger>
            <BzHoverCardContent>Ada Lovelace</BzHoverCardContent>
        </BzHoverCard>);
        var trigger = cut.Find("#ada[data-slot=hover-card-trigger]");
        Assert.Contains("underline", trigger.ClassList);
        Assert.Equal("/ada", trigger.GetAttribute("href"));
        Assert.Equal("closed", trigger.GetAttribute("data-state"));
        Assert.Empty(cut.FindAll("[data-slot=hover-card-content]"));

        trigger.PointerEnter();
        cut.WaitForAssertion(() => Assert.Equal("open", cut.Find("[data-slot=hover-card-content]").GetAttribute("data-state")));
        Assert.Equal("Ada Lovelace", cut.Find("[data-slot=hover-card-content]").TextContent);
        Assert.Equal("open", cut.Find("#ada").GetAttribute("data-state"));

        cut.Find("#ada").PointerLeave();
        cut.WaitForAssertion(() => Assert.Equal("closed", cut.Find("[data-slot=hover-card-content]").GetAttribute("data-state")));
        Assert.Equal([true, false], changes);
    }

    [Fact]
    public void A_pointer_that_only_brushes_past_does_not_open_the_card()
    {
        var cut = Render(@<BzHoverCard OpenDelay="200">
            <BzHoverCardTrigger id="ada">@@ada</BzHoverCardTrigger>
            <BzHoverCardContent>Ada Lovelace</BzHoverCardContent>
        </BzHoverCard>);

        cut.Find("#ada").PointerEnter();
        cut.Find("#ada").PointerLeave();

        Thread.Sleep(350);
        Assert.Empty(cut.FindAll("[data-slot=hover-card-content]"));
    }

    [Fact]
    public void The_card_starts_on_the_side_and_alignment_it_was_asked_for_and_takes_classes_and_attributes()
    {
        var plain = Render(@<BzHoverCard DefaultOpen="true"><BzHoverCardContent>Card</BzHoverCardContent></BzHoverCard>);
        var card = plain.Find("[data-slot=hover-card-content]");
        Assert.Equal("bottom", card.GetAttribute("data-side"));
        Assert.Equal("center", card.GetAttribute("data-align"));

        var placed = Render(@<BzHoverCard DefaultOpen="true">
            <BzHoverCardContent Side="Side.Right" Align="Align.Start" Class="w-80" data-testid="card">Card</BzHoverCardContent>
        </BzHoverCard>);
        card = placed.Find("[data-testid=card]");
        Assert.Equal("right", card.GetAttribute("data-side"));
        Assert.Equal("start", card.GetAttribute("data-align"));
        Assert.Contains("w-80", card.ClassList);
        Assert.Contains("bz-hover-card-content", card.ClassList);
    }

    [Fact]
    public void Placement_reaches_the_positioning_script_with_a_gap_of_four_by_default()
    {
        var positioning = JSInterop.SetupModule(PositioningModule);
        positioning.Mode = JSRuntimeMode.Loose;

        var cut = Render(@<div>
            <BzHoverCard DefaultOpen="true">
                <BzHoverCardTrigger id="first">First</BzHoverCardTrigger>
                <BzHoverCardContent>Card</BzHoverCardContent>
            </BzHoverCard>
            <BzHoverCard DefaultOpen="true">
                <BzHoverCardContent Side="Side.Top" Align="Align.End" SideOffset="10" AlignOffset="-2" Inline="true">Card</BzHoverCardContent>
            </BzHoverCard>
        </div>);

        var created = positioning.Invocations.Where(i => i.Identifier == "createPositioning").ToList();
        Assert.Equal(2, created.Count);
        var anchor = cut.Find("#first").GetAttribute("data-bz-hover-card-anchor");
        Assert.Contains(anchor!, (string)created[0].Arguments[0]!);
        Assert.Equal("bottom", Option(created[0].Arguments[2]!, "side"));
        Assert.Equal("center", Option(created[0].Arguments[2]!, "align"));
        Assert.Equal(4d, Option(created[0].Arguments[2]!, "sideOffset"));
        Assert.Equal(false, Option(created[0].Arguments[2]!, "inline"));
        Assert.Equal("top", Option(created[1].Arguments[2]!, "side"));
        Assert.Equal("end", Option(created[1].Arguments[2]!, "align"));
        Assert.Equal(10d, Option(created[1].Arguments[2]!, "sideOffset"));
        Assert.Equal(-2d, Option(created[1].Arguments[2]!, "alignOffset"));
        Assert.Equal(true, Option(created[1].Arguments[2]!, "inline"));
    }

    [Fact]
    public async Task A_controlled_card_follows_the_parent_and_is_removed_after_its_exit_animation()
    {
        var cut = Render<BzHoverCard>(p => p
            .Add(x => x.Open, true)
            .AddChildContent<BzHoverCardContent>(c => c.AddChildContent("Card")));
        Assert.Equal("open", cut.Find("[data-slot=hover-card-content]").GetAttribute("data-state"));

        cut.Render(p => p.Add(x => x.Open, false));
        Assert.Equal("closed", cut.Find("[data-slot=hover-card-content]").GetAttribute("data-state"));

        await cut.InvokeAsync(() => cut.FindComponent<BaseHoverCardContent>().Instance.OnCloseFinished());
        Assert.Empty(cut.FindAll("[data-slot=hover-card-content]"));
    }

    [Fact]
    public void The_trigger_renders_onto_another_element_and_stays_the_anchor()
    {
        var cut = Render(@<BzHoverCard OpenDelay="0">
            <BzHoverCardTrigger>
                <RenderAs Context="p"><button id="who" type="button" @attributes="p.Attributes">Who?</button></RenderAs>
            </BzHoverCardTrigger>
            <BzHoverCardContent>Ada Lovelace</BzHoverCardContent>
        </BzHoverCard>);

        var trigger = cut.Find("button#who[data-slot=hover-card-trigger]");
        Assert.True(trigger.HasAttribute("data-bz-hover-card-anchor"));

        trigger.PointerEnter();
        cut.WaitForAssertion(() => Assert.NotEmpty(cut.FindAll("[data-slot=hover-card-content]")));
    }

    [Fact]
    public void The_arrow_is_decorative_and_takes_classes()
    {
        var cut = Render(@<BzHoverCard DefaultOpen="true">
            <BzHoverCardContent>Card<BzHoverCardArrow Class="size-4" data-testid="tail" /></BzHoverCardContent>
        </BzHoverCard>);

        var arrow = cut.Find("[data-slot=hover-card-content] [data-testid=tail][data-slot=hover-card-arrow]");
        Assert.Equal("true", arrow.GetAttribute("aria-hidden"));
        Assert.True(arrow.HasAttribute("data-bz-arrow"));
        Assert.Contains("size-4", arrow.ClassList);
        Assert.DoesNotContain("size-3", arrow.ClassList);
        Assert.NotNull(arrow.QuerySelector("svg"));
    }

    [Fact]
    public void Inside_a_raised_dialog_the_card_lifts_itself_above_the_window()
    {
        var cut = Render(@<BzDialog DefaultOpen="true">
            <BzDialogContent ZIndex="60">
                <BzDialogTitle>Edit</BzDialogTitle>
                <BzHoverCard DefaultOpen="true"><BzHoverCardContent>Card</BzHoverCardContent></BzHoverCard>
            </BzDialogContent>
        </BzDialog>);

        Assert.Contains("z-index:65", cut.Find("[data-slot=hover-card-content]").GetAttribute("style"));
    }
}
