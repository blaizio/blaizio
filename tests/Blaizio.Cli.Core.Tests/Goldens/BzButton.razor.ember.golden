@namespace Blaizio.Ui
@*
    Styled Button. Pure styling over a native <button> - there's no headless "button" behaviour to
    factor out, so it renders directly through BasePrimitive (which also gives it `RenderAs`).

    The component carries only STRUCTURAL utilities plus
    the bz-button/-variant-*/-size-* hooks and data-variant/data-size attributes; the active style
    sheet (Styles/style-*.css) supplies the look per style.

    Polymorphism via RenderAs - render the button styling onto your own element instead of a <button>:

        <BzButton Variant="ButtonVariant.Link">
            <RenderAs Context="p"><a href="/docs" @attributes="p.Attributes">Docs</a></RenderAs>
        </BzButton>
*@

<BasePrimitive Element="button"
                Attributes="BuildAttributes()"
                ChildContent="@Content"
                RenderAs="@RenderAs" />

@code {
    /// <summary>Visual style. Defaults to <see cref="ButtonVariant.Default"/>.</summary>
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Default;

    /// <summary>Size. Defaults to <see cref="ButtonSize.Default"/>.</summary>
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Default;

    /// <summary>Disables the button (greys it out, blocks pointer events).</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Shows a leading <see cref="BzSpinner"/> and disables the button while an async action runs.
    /// Sets <c>aria-busy</c> and <c>data-loading</c>; the label stays visible next to the spinner.
    /// </summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>The <c>type</c> attribute. Emitted only when set; ignored in RenderAs mode.</summary>
    [Parameter] public ButtonType? Type { get; set; }

    /// <summary>
    /// Raised on click. Deliberately not named <c>OnClick</c>: a parameter of that name would
    /// swallow the plain <c>onclick</c> attribute (component attribute matching is
    /// case-insensitive), so a raw <c>onclick="…"</c> would be compiled as C#. Here it splats to
    /// the element and runs alongside this. Not raised while <see cref="Disabled"/> or
    /// <see cref="Loading"/>.
    /// </summary>
    [Parameter] public EventCallback<MouseEventArgs> Click { get; set; }

    /// <summary>Extra classes, merged over the variant/size defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Button content (label, icons).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the button styling onto your own element instead of a <c>&lt;button&gt;</c>.</summary>
    [Parameter] public RenderFragment<BzRenderProps>? RenderAs { get; set; }

    /// <summary>Any other attributes (e.g. <c>@onclick</c>, <c>id</c>), forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    // Loading prefixes the content with the spinner; the two never render exclusively - the
    // label staying put keeps the button's width stable while the action runs.
    private RenderFragment? Content => Loading
        ? @<text><BzSpinner data-icon="inline-start" />@ChildContent</text>
        : ChildContent;

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder(this)
            .Data("slot", "button")
            .Data("variant", Variant.GetDescription())
            .Data("size", Size.GetDescription());

        if (Loading) props.Data("loading", "").Aria("busy", true);
        if (!Disabled && !Loading) props.On("onclick", Click);

        if (RenderAs is null)
        {
            props.Set("type", Type?.GetDescription()).Flag("disabled", Disabled || Loading);
        }
        else if (Disabled || Loading)
        {
            // Arbitrary elements can't take `disabled`; convey state for AT + styling instead.
            props.Aria("disabled", true).Data("disabled", "");
        }

        var classes = Tw.Merge(
            BaseClasses,
            VariantClasses(Variant),
            SizeClasses(Size),
            Class);
        return props.Merge(Attributes, classes);
    }

    private const string BaseClasses =
        "focus-visible:border-ring dark:focus-visible:border-ring aria-invalid:border-destructive dark:aria-invalid:border-destructive/50 border border-transparent bg-clip-padding active:not-aria-[haspopup]:translate-y-px focus-visible:ring-ring/50 rounded-md text-sm font-medium focus-visible:ring-2 aria-invalid:ring-2 [&_svg:not([class*='size-'])]:size-4 aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap " +
        "transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 " +
        "[&_svg]:pointer-events-none [&_svg]:shrink-0";

    // One literal per value - the registry inliner substitutes each token with the skin's
    // utilities, which an interpolated class string would defeat.
    private static string VariantClasses(ButtonVariant variant) => variant switch
    {
        ButtonVariant.Destructive => "bg-destructive/10 hover:bg-destructive/20 focus-visible:ring-destructive/20 dark:focus-visible:ring-destructive/40 dark:bg-destructive/20 focus-visible:border-destructive/40 text-[color-mix(in_oklab,var(--destructive),black_20%)] dark:text-destructive dark:hover:bg-destructive/30",
        ButtonVariant.Success => "bg-success/10 hover:bg-success/20 focus-visible:ring-success/20 dark:focus-visible:ring-success/40 dark:bg-success/20 focus-visible:border-success/40 text-[color-mix(in_oklab,var(--success),black_20%)] dark:text-success dark:hover:bg-success/30",
        ButtonVariant.Warning => "bg-warning/10 hover:bg-warning/20 focus-visible:ring-warning/20 dark:focus-visible:ring-warning/40 dark:bg-warning/20 focus-visible:border-warning/40 text-[color-mix(in_oklab,var(--warning),black_20%)] dark:text-warning dark:hover:bg-warning/30",
        ButtonVariant.Info => "bg-info/10 hover:bg-info/20 focus-visible:ring-info/20 dark:focus-visible:ring-info/40 dark:bg-info/20 focus-visible:border-info/40 text-[color-mix(in_oklab,var(--info),black_20%)] dark:text-info dark:hover:bg-info/30",
        ButtonVariant.Outline => "border-border hover:text-foreground aria-expanded:text-foreground bg-background hover:bg-muted dark:bg-input/30 dark:border-input dark:hover:bg-input/50 shadow-xs aria-expanded:bg-muted",
        ButtonVariant.Secondary => "bg-secondary text-secondary-foreground hover:bg-[color-mix(in_oklch,var(--secondary),var(--foreground)_5%)] aria-expanded:bg-secondary aria-expanded:text-secondary-foreground",
        ButtonVariant.Accent => "bg-accent text-accent-foreground hover:bg-[color-mix(in_oklch,var(--accent),var(--foreground)_5%)] aria-expanded:bg-accent aria-expanded:text-accent-foreground",
        ButtonVariant.Ghost => "hover:bg-accent hover:text-accent-foreground aria-expanded:bg-accent aria-expanded:text-accent-foreground",
        ButtonVariant.Link => "text-primary underline-offset-4 hover:underline",
        _ => "bg-primary text-primary-foreground hover:bg-primary/80 dark:bg-[color-mix(in_oklab,var(--primary)_85%,black)] dark:hover:bg-[color-mix(in_oklab,var(--primary)_85%,black)]/80",
    };

    private static string SizeClasses(ButtonSize size) => size switch
    {
        ButtonSize.Xs => "gap-1 h-6 rounded-[min(var(--radius-md),8px)] px-2 text-xs in-data-[slot=button-group]:rounded-md has-data-[icon=inline-end]:pe-1.5 has-data-[icon=inline-start]:ps-1.5 [&_svg:not([class*='size-'])]:size-3",
        ButtonSize.Sm => "gap-1 h-8 rounded-[min(var(--radius-md),10px)] px-2.5 in-data-[slot=button-group]:rounded-md has-data-[icon=inline-end]:pe-1.5 has-data-[icon=inline-start]:ps-1.5",
        ButtonSize.Lg => "h-10 gap-1.5 px-2.5 has-data-[icon=inline-end]:pe-2 has-data-[icon=inline-start]:ps-2",
        ButtonSize.Icon => "size-9",
        ButtonSize.IconXs => "size-6 rounded-[min(var(--radius-md),8px)] in-data-[slot=button-group]:rounded-md [&_svg:not([class*='size-'])]:size-3",
        ButtonSize.IconSm => "size-8 rounded-[min(var(--radius-md),10px)] in-data-[slot=button-group]:rounded-md",
        ButtonSize.IconLg => "size-10",
        _ => "h-9 gap-1.5 px-2.5 in-data-[slot=button-group]:rounded-md has-data-[icon=inline-end]:pe-2 has-data-[icon=inline-start]:ps-2",
    };
}
