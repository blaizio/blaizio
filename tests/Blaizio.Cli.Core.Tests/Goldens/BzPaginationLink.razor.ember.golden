@namespace Blaizio.Ui
@*
    A page control. Two modes by intent: pass Href to navigate (renders an <a>), or OnClick to change
    the page in place (renders a <button>). Active marks the current page (aria-current="page"); use
    RenderAs to render the styling onto your own routed element (e.g. a NavLink).
*@

<BasePrimitive As="@ResolvedAs" Attributes="BuildAttributes()" ChildContent="@ChildContent" RenderAs="@RenderAs" />

@code {
    /// <summary>Destination URL. When set the control is a link (<c>&lt;a&gt;</c>); otherwise it is an action <c>&lt;button&gt;</c>.</summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>Marks this as the current page - sets <c>aria-current="page"</c> and the active treatment.</summary>
    [Parameter] public bool Active { get; set; }

    /// <summary>Disables the control (dims it, blocks interaction).</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Raised on click - the in-place paging hook (no navigation). Wires both link and button modes.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    /// <summary>Accessible label, e.g. "Go to page 3". Optional - page-number links read their own text.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Extra classes, merged over the defaults.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The control's content (a page number, an icon + label).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the link styling onto your own element instead of the default <c>&lt;a&gt;</c>/<c>&lt;button&gt;</c>.</summary>
    [Parameter] public RenderFragment<BzRenderProps>? RenderAs { get; set; }

    /// <summary>Any other attributes, forwarded to the element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private string ResolvedAs => Href is not null ? "a" : "button";

    private IReadOnlyDictionary<string, object> BuildAttributes()
    {
        var props = new PropBuilder(this).Data("slot", "pagination-link");

        if (Active) props.Data("active", "true").Aria("current", "page");
        if (!string.IsNullOrEmpty(AriaLabel)) props.Set("aria-label", AriaLabel);

        if (RenderAs is null)
        {
            if (Href is not null)
            {
                // A link can't be natively disabled - drop the href and convey state for AT + styling.
                props.Set("href", Disabled ? null : Href);
                if (Disabled) props.Aria("disabled", true).Data("disabled", "").Set("tabindex", "-1");
            }
            else
            {
                props.Set("type", "button").Flag("disabled", Disabled);
            }

            if (!Disabled) props.On("onclick", OnClick);
        }
        else if (Disabled)
        {
            props.Aria("disabled", true).Data("disabled", "");
        }

        return props.Merge(Attributes, Tw.Merge("hover:bg-accent hover:text-accent-foreground inline-flex items-center justify-center gap-1 px-2 outline-none transition-all select-none disabled:pointer-events-none disabled:opacity-50 aria-disabled:pointer-events-none aria-disabled:opacity-50 focus-visible:ring-ring/50 focus-visible:border-ring dark:focus-visible:border-ring h-9 min-w-9 rounded-md border border-transparent text-sm font-medium focus-visible:ring-2 [&_svg:not([class*='size-'])]:size-4 data-[active=true]:border-input data-[active=true]:bg-input/30 data-[active=true]:shadow-xs", Class));
    }
}
